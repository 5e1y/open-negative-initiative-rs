// The presets: the deck on the canvas's bottom edge, the save sheet, the editor, and their notices.
import { Space, Depth, PresetStyle, AskSheet, AskRole, AskKey, Label, TextRole, Tone, Button, TextField, Toggle, Picker, Divider, Scroller, Sheet, MenuLine, Field, Row, RowForm, SheetFooter, SectionStyle, SheetStyle, Engraved, Section } from "ds/ds.slint";

// A card as the deck and the editor's list draw it: the name on the tint, in its own ink; the
// list's badge wears the monogram.
export struct PresetCard { abbreviation: string, name: string, help: string, carries: string, fill: color, ink: color }

// One line of the Carries picker: a block's title or a box, the column it stands in, and whether
// it leads that column.
export struct CarriesLine { title: bool, text: string, on: bool, column: int, lead: bool }

export global Presets {
    in property <[PresetCard]> cards;
    in property <bool> can-apply;
    in property <bool> can-update;
    in property <string> hint;
    in property <int> hovered: -1;
    callback hover(int);
    callback apply(int);
    callback create();
    // A right click on a card: Rust lays `menu-lines` and answers whether the menu opens.
    callback card-menu(int) -> bool;
    in property <[MenuLine]> menu-lines;
    callback menu-chosen(int);
    // Where the first card stands in the window, for a hand that aims at it.
    in-out property <length> first-x;
    in-out property <length> first-y;

    // The form both sheets show: the draft being saved, or the preset selected in the editor.
    in property <bool> saving;
    // The save sheet as Copy Settings: the boxes a copy carries, no name and no colour.
    in property <bool> copying;
    in property <bool> editing;
    in property <bool> form-shown;
    in property <[int]> form-instance;
    in property <string> form-name;
    in property <string> form-note;
    in property <int> form-tint;
    in property <[color]> tints;
    in property <[string]> tint-names;
    // Each tint's own ink, which rings the picked swatch.
    in property <[color]> tint-inks;
    in property <[CarriesLine]> form-carries;
    in property <bool> form-empty;
    // A name with more than blanks, the only one Save takes.
    in property <bool> form-valid;
    in property <int> form-balance;
    in property <string> carries-help;
    in property <string> balance-help;
    in property <string> carries-nothing;
    in property <[string]> balance-names;
    callback form-named(string);
    callback form-noted(string);
    callback form-tinted(int);
    callback form-ticked(int, bool);
    callback form-balanced(int);
    // Copy Settings' "Don't ask again this session", which its commit takes.
    in property <bool> copy-at-once;
    callback copy-at-once-toggled(bool);
    callback save-cancelled();
    callback save-confirmed();

    // The editor's list and footer.
    in property <[PresetCard]> rows;
    in property <int> selected: -1;
    callback picked(int);
    callback duplicate();
    callback share();
    callback copy-code();
    callback delete();
    callback done();
}

// `DSNotice`: what a gesture tells once it is over, closed by its one key.
export global Advice {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    callback closed();
}

// `DSDialogRequest` with option keys: Cancel, then one key per way of going ahead.
export global Choice {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    // Every key an option.
    in property <[AskKey]> keys;
    // The key's index, -1 for Cancel.
    callback chosen(int);
}

// Option keys stay neutral and deaf to Return, so no choice is made by reflex.
export component ChoiceSheet inherits AskSheet {
    title: Choice.title;
    message: Choice.message;
    wide: true;
    cancel: @tr("Cancel");
    keys: Choice.keys;
    answered(i) => { Choice.chosen(i); }
}

export component AdviceSheet inherits AskSheet {
    title: Advice.title;
    message: Advice.message;
    keys: [{ text: @tr("OK"), role: AskRole.confirm }];
    answered => { Advice.closed(); }
}

component TintPicker inherits HorizontalLayout {
    spacing: Space.xs;
    alignment: start;
    for tint[i] in Presets.tints: Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch;
        fill: tint;
        on: i == Presets.form-tint;
        help: Presets.tint-names[i];
        glyph-ink: Presets.tint-inks[i];
        clicked => { Presets.form-tinted(i); }
    }
}

// `DSPicker` for the white balance: its menu drops under the field, the current choice ticked.
component BalancePicker inherits Picker {
    entries: Presets.balance-names;
    current: Presets.form-balance;
    chosen(i) => { Presets.form-balanced(i); }
}

// One column of the Carries picker: every line passes, its own laid; a block's title stands a step
// further from the rows before it than they stand apart.
component CarriesColumn inherits VerticalLayout {
    in property <int> column;
    alignment: start;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    for line[i] in Presets.form-carries: VerticalLayout {
        if line.column == root.column: VerticalLayout {
            padding-top: line.lead ? 0px : line.title ? Space.m : Space.xs;
            // A step under Carries, as the form's other labels: the boxes under it carry the ink.
            if line.title: Label { text: line.text; tone: Tone.secondary; }
            if !line.title: Toggle {
                on: line.on;
                label: line.text;
                wrap: true;
                toggled(on) => { Presets.form-ticked(i, on); }
            }
        }
    }
}

// `PresetCarriesPicker`: the white balance, a choice of three over the blocks, a copy's alone without
// it; the blocks' boxes in two columns, so the sheet holds them whole; the note when none is ticked.
component CarriesPicker inherits VerticalLayout {
    in property <bool> copying;
    spacing: Space.m;
    if !root.copying: Field {
        label: @tr("White balance");
        help: Presets.balance-help;
        BalancePicker { value: Presets.balance-names[Presets.form-balance]; }
    }
    HorizontalLayout {
        spacing: Space.l;
        CarriesColumn { column: 0; }
        CarriesColumn { column: 1; }
    }
    if Presets.form-empty: Label { role: TextRole.note; text: Presets.carries-nothing; }
}

// The fields of both sheets, then what the preset carries under its own heading; the description is
// the editor's alone, the boxes alone a copy's, which may stop asking.
component PresetForm inherits VerticalLayout {
    in property <bool> noted;
    in property <bool> copying;
    // The name takes the keyboard as the form opens, the proposed one selected so typing replaces it.
    in property <bool> focused;
    callback named(string);
    spacing: Space.l;
    // The name and the colour side by side, over the two columns of what the preset carries.
    if !root.copying: HorizontalLayout {
        spacing: Space.l;
        Field {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            label: @tr("Name");
            TextField {
                text: Presets.form-name;
                placeholder: @tr("Preset name");
                edited(t) => { Presets.form-named(t); }
                accepted(t) => { root.named(t); }
                init => {
                    if (root.focused) {
                        self.take-focus-selecting();
                    }
                }
            }
        }
        Field {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            label: @tr("Colour");
            TintPicker { }
        }
    }
    // Three lines, wrapped, as `lineLimit(3, reservesSpace: true)`.
    if root.noted: Field {
        label: @tr("Description");
        TextField {
            multiline: true;
            name: @tr("Description");
            lines-height: PresetStyle.note-height;
            text: Presets.form-note;
            placeholder: @tr("What this look is for");
            edited(t) => { Presets.form-noted(t); }
        }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        separated: !root.copying;
        before: root.copying ? SectionStyle.flush : SectionStyle.sheet-before;
        title: @tr("Carries");
        help: Presets.carries-help;
        CarriesPicker { copying: root.copying; }
    }
    if root.copying: Toggle {
        label: @tr("Don’t ask again this session");
        on: Presets.copy-at-once;
        toggled(on) => { Presets.copy-at-once-toggled(on); }
    }
}

// `PresetSaveSheet`: a name, a colour, the rows it carries, or a copy's boxes alone, its commit dark
// while blank or bare; as tall as its content, the form scrolling over the footer once room runs short.
export component PresetSaveSheet inherits Sheet {
    wide: true;
    bleed: true;
    card-height: body.preferred-height;
    dismissed => { Presets.save-cancelled(); }
    body := VerticalLayout {
        padding: SheetStyle.padding;
        spacing: SheetStyle.gap;
        Engraved {
            role: TextRole.title;
            text: Presets.copying ? @tr("Copy Settings") : @tr("Save a Preset");
            wrap: word-wrap;
        }
        Scroller {
            vertical-stretch: 1;
            preferred-height: form.preferred-height;
            content-height: form.preferred-height;
            form := PresetForm {
                width: parent.width;
                copying: Presets.copying;
                focused: true;
                // A toggle's or a picker's lip ends the form, kept at the scroll's end.
                padding-bottom: Depth.lip-reach;
                named => { if (Presets.form-valid) { Presets.save-confirmed(); } }
            }
        }
        Divider { }
        SheetFooter {
            cancel: @tr("Cancel");
            commit: Presets.copying ? @tr("Copy") : @tr("Save");
            commit-enabled: Presets.form-valid;
            cancelled => { Presets.save-cancelled(); }
            committed => { Presets.save-confirmed(); }
        }
    }
}

// `PresetEditor`: the list, the selected preset's form, the footer's keys, an edit written once the
// hand rests or another row or Done takes over; as tall as the form, which scrolls once room runs short.
export component PresetEditorSheet inherits Sheet {
    card-width: PresetStyle.editor-width;
    card-height: body.preferred-height;
    bleed: true;
    dismissed => { Presets.done(); }
    body := VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            Scroller {
                width: PresetStyle.editor-list;
                preferred-height: 0px;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    padding: Space.s;
                    spacing: Space.xxs;
                    alignment: start;
                    for card[i] in Presets.rows: Row {
                        form: RowForm.sidebar;
                        badge: card.abbreviation;
                        title: card.name;
                        detail: card.carries;
                        badge-fill: card.fill;
                        badge-ink: card.ink;
                        selected: i == Presets.selected;
                        clicked => { Presets.picked(i); }
                    }
                }
            }
            Divider { vertical: true; hairline: true; }
            // One instance per selected preset: its fields start from that preset's values. The form fills
            // the scroll's content, so the content is the form's own height, its margin inside it.
            for instance in Presets.form-instance: Scroller {
                horizontal-stretch: 1;
                preferred-height: form.preferred-height;
                content-height: form.preferred-height;
                form := PresetForm {
                    width: parent.width;
                    padding: Space.l;
                    noted: true;
                    named => { Presets.done(); }
                }
            }
            if !Presets.form-shown: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                padding: Space.l;
                Label { text: @tr("No preset selected"); role: TextRole.section; centred: true; }
                Label { role: TextRole.note; text: @tr("Save a photo's settings to create your first preset."); horizontal-alignment: center; }
            }
        }
        Divider { }
        // Delete alone at the left end, the keys that keep the preset beside DONE.
        SheetFooter {
            padding: Space.m;
            remove: @tr("Delete");
            remove-enabled: Presets.form-shown;
            removed => { Presets.delete(); }
            commit: @tr("Done");
            committed => { Presets.done(); }
            Button { text: @tr("Duplicate"); enabled: Presets.form-shown; clicked => { Presets.duplicate(); } }
            Button { text: @tr("Share…"); enabled: Presets.form-shown; clicked => { Presets.share(); } }
            Button { text: @tr("Copy Preset Code"); enabled: Presets.form-shown; help: @tr("Copies the preset as one line of text, to paste in a message."); clicked => { Presets.copy-code(); } }
        }
    }
}
