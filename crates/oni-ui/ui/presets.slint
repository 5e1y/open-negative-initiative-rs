// The presets: the deck on the canvas's bottom edge, the save sheet, the editor, and their notices.
import { Space, Depth, PresetStyle, AskSheet, AskRole, AskKey, Label, TextRole, Tone, Button, ButtonKind, TextField, Toggle, Picker, Menu, Divider, Scroller, Sheet, MenuLine, Field, ButtonGroup, GroupAlign, Row, RowForm } from "ds/ds.slint";

// A card as the deck and the editor's list draw it: the monogram on the tint, in its own ink.
export struct PresetCard { abbreviation: string, name: string, help: string, carries: string, fill: color, ink: color }

// One line of the Carries picker: 0 a block's title, 1 the white balance choice, 2 a box.
export struct CarriesLine { kind: int, text: string, on: bool }

export global Presets {
    in property <[PresetCard]> cards;
    in property <bool> can-apply;
    in property <bool> can-update;
    in property <string> hint;
    in property <int> hovered: -1;
    callback hover(int);
    callback apply(int);
    callback create();
    // A right click on a card: Rust lays `menu-lines` and answers whether the menu opens.
    callback card-menu(int) -> bool;
    in property <[MenuLine]> menu-lines;
    callback menu-chosen(int);
    // Where the first card stands in the window, for a hand that aims at it.
    in-out property <length> first-x;
    in-out property <length> first-y;

    // The form both sheets show: the draft being saved, or the preset selected in the editor.
    in property <bool> saving;
    in property <bool> editing;
    in property <bool> form-shown;
    in property <[int]> form-instance;
    in property <string> form-name;
    in property <string> form-note;
    in property <int> form-tint;
    in property <[color]> tints;
    in property <[string]> tint-names;
    // Each tint's own ink, which rings the picked swatch.
    in property <[color]> tint-inks;
    in property <[CarriesLine]> form-carries;
    in property <bool> form-empty;
    // A name with more than blanks, the only one Save takes.
    in property <bool> form-valid;
    in property <int> form-balance;
    in property <string> carries-help;
    in property <string> balance-help;
    in property <string> carries-nothing;
    in property <[string]> balance-names;
    callback form-named(string);
    callback form-noted(string);
    callback form-tinted(int);
    callback form-ticked(int, bool);
    callback form-balanced(int);
    callback save-cancelled();
    callback save-confirmed();

    // The editor's list and footer.
    in property <[PresetCard]> rows;
    in property <int> selected: -1;
    callback picked(int);
    callback duplicate();
    callback share();
    callback copy-code();
    callback delete();
    callback done();
}

// `DSNotice`: what a gesture tells once it is over, closed by its one key.
export global Advice {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    callback closed();
}

// `DSDialogRequest` with option keys: Cancel, then one key per way of going ahead.
export global Choice {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    // Every key an option.
    in property <[AskKey]> keys;
    // The key's index, -1 for Cancel.
    callback chosen(int);
}

// Option keys stay neutral and deaf to Return, so no choice is made by reflex.
export component ChoiceSheet inherits AskSheet {
    title: Choice.title;
    message: Choice.message;
    wide: true;
    cancel: @tr("Cancel");
    keys: Choice.keys;
    answered(i) => { Choice.chosen(i); }
}

export component AdviceSheet inherits AskSheet {
    title: Advice.title;
    message: Advice.message;
    keys: [{ text: @tr("OK"), role: AskRole.confirm }];
    answered => { Advice.closed(); }
}

component TintPicker inherits HorizontalLayout {
    spacing: Space.xs;
    alignment: start;
    for tint[i] in Presets.tints: Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch;
        fill: tint;
        on: i == Presets.form-tint;
        help: Presets.tint-names[i];
        glyph-ink: Presets.tint-inks[i];
        clicked => { Presets.form-tinted(i); }
    }
}

// `PresetCarriesPicker`: the blocks' boxes, the white balance a choice of three, and the note
// when nothing is ticked.
// `DSPicker` for the white balance: its menu drops under the field, the current choice ticked.
component BalancePicker inherits Picker {
    entries: Presets.balance-names;
    current: Presets.form-balance;
    chosen(i) => { Presets.form-balanced(i); }
}

component CarriesPicker inherits VerticalLayout {
    spacing: Space.xs;
    for line[i] in Presets.form-carries: VerticalLayout {
        spacing: Space.xs;
        // The blocks stand a step further apart than their rows.
        if line.kind == 0 && i > 0: Rectangle { height: Space.m - 2 * Space.xs; }
        if line.kind == 0: Label { text: line.text; role: TextRole.section; }
        if line.kind == 1: Field {
            label: @tr("White balance");
            help: Presets.balance-help;
            BalancePicker { value: line.text; }
        }
        if line.kind == 2: Toggle {
            on: line.on;
            label: line.text;
            toggled(on) => { Presets.form-ticked(i, on); }
        }
    }
    if Presets.form-empty: Label { role: TextRole.note; text: Presets.carries-nothing; }
}

// The fields of both sheets; the description is the editor's alone.
component PresetForm inherits VerticalLayout {
    in property <bool> noted;
    callback named(string);
    spacing: Space.l;
    Field {
        label: @tr("Name");
        name := TextField {
            text: Presets.form-name;
            placeholder: @tr("Preset name");
            edited(t) => { Presets.form-named(t); }
            accepted(t) => { root.named(t); }
        }
    }
    // Three lines, wrapped, as `lineLimit(3, reservesSpace: true)`.
    if root.noted: Field {
        label: @tr("Description");
        TextField {
            multiline: true;
            lines-height: PresetStyle.note-height;
            text: Presets.form-note;
            placeholder: @tr("What this look is for");
            edited(t) => { Presets.form-noted(t); }
        }
    }
    Field {
        label: @tr("Color");
        TintPicker { }
    }
    Field {
        label: @tr("Carries");
        help: Presets.carries-help;
        CarriesPicker { }
    }
    // The proposed name selected, so typing replaces it.
    public function take-focus() { name.take-focus-selecting(); }
}

// `PresetSaveSheet`: a name, a colour, the rows it carries; Save stays dark on a blank name.
export component PresetSaveSheet inherits Sheet {
    title: @tr("Save a Preset");
    card-width: PresetStyle.save-width;
    card-height: PresetStyle.save-height;
    dismissed => { Presets.save-cancelled(); }
    Scroller {
        vertical-stretch: 1;
        content-height: form.preferred-height;
        form := PresetForm {
            width: parent.width;
            // A toggle's or a picker's lip ends the form, kept at the scroll's end.
            padding-bottom: Depth.lip-reach;
            named => { if (Presets.form-valid) { Presets.save-confirmed(); } }
        }
    }
    Divider { }
    HorizontalLayout {
        alignment: end;
        spacing: Space.s;
        Button { text: @tr("Cancel"); clicked => { Presets.save-cancelled(); } }
        Button { text: @tr("Save"); enabled: Presets.form-valid; clicked => { Presets.save-confirmed(); } }
    }
    init => { form.take-focus(); }
}

// `PresetEditor`: the presets in a list, the selected one's form, and the footer's keys; an edit
// is written once the hand rests, and at once when another row or Done takes over.
export component PresetEditorSheet inherits Sheet {
    card-width: PresetStyle.editor-width;
    card-height: PresetStyle.editor-height;
    bleed: true;
    dismissed => { Presets.done(); }
    HorizontalLayout {
        vertical-stretch: 1;
        Scroller {
            width: PresetStyle.editor-list;
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding: Space.s;
                spacing: Space.xxs;
                alignment: start;
                for card[i] in Presets.rows: Row {
                    form: RowForm.sidebar;
                    badge: card.abbreviation;
                    title: card.name;
                    detail: card.carries;
                    badge-fill: card.fill;
                    badge-ink: card.ink;
                    selected: i == Presets.selected;
                    clicked => { Presets.picked(i); }
                }
            }
        }
        Divider { vertical: true; hairline: true; }
        // One instance per selected preset: its fields start from that preset's values.
        for instance in Presets.form-instance: Scroller {
            horizontal-stretch: 1;
            content-height: form.preferred-height + 2 * Space.l;
            form := PresetForm {
                x: Space.l;
                y: Space.l;
                width: parent.width - 2 * Space.l;
                noted: true;
                named => { Presets.done(); }
            }
        }
        if !Presets.form-shown: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Label { text: @tr("No preset selected"); role: TextRole.section; centred: true; }
            Label { role: TextRole.note; text: @tr("Save a photo's settings to create your first preset."); horizontal-alignment: center; }
        }
    }
    Divider { }
    HorizontalLayout {
        padding: Space.m;
        spacing: Space.s;
        Button { text: @tr("Duplicate"); enabled: Presets.form-shown; clicked => { Presets.duplicate(); } }
        Button { text: @tr("Share…"); enabled: Presets.form-shown; clicked => { Presets.share(); } }
        Button { text: @tr("Copy Preset Code"); enabled: Presets.form-shown; help: @tr("Copies the preset as one line of text, to paste in a message."); clicked => { Presets.copy-code(); } }
        Button { text: @tr("Delete"); kind: ButtonKind.destructive; enabled: Presets.form-shown; clicked => { Presets.delete(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Done"); clicked => { Presets.done(); } }
    }
}
