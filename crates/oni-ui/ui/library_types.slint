// What the library's state hands the grid and the Info column: a tile, a band's heading, a stock's count.
import { Reach } from "ds/ds.slint";

export struct Tile {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    picture: image,
    caption: string,
    selected: bool,
    medal: int,
    missing: bool,
    // Why its original is out of reach, and where it was, said under the pointer.
    away: Reach,
    note: string,
    rgb: bool,
    // A triplet's pass gone, the seal's words.
    gone-pass: string,
    // A RAW+JPEG pair's mark, `+JPG`, its JPEG behind the RAW.
    companion: string,
    // The photo the keys act on, ringed while the grid holds the keyboard.
    cursor: bool,
}

export struct Heading {
    y: length,
    title: string,
    caption: string,
    renaming: bool,
}

export struct StockCount {
    name: string,
    count: string,
    artwork: image,
    has-artwork: bool,
}

// What the Info column stands on: nothing, a roll, a project, the trash or the collection.
export enum InfoKind { none, roll, project, trash, collection }
