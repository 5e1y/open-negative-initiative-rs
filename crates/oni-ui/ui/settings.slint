// The Settings sheet the header's gear opens: the app's own choices by section, each kept in the
// preferences file, the sections listed on the left as macOS and Windows settings windows list theirs.
import { Act } from "act.slint";
import { Pairing } from "pairing.slint";
import { Sheet, SheetStyle, SectionStyle, Button, ButtonGroup, Section, Tabs, Label, TextRole, Row, Toggle, Divider, RowForm, LcdReadout, SheetFooter, Tone, Field, FieldLayout } from "ds/ds.slint";

export global AppSettings {
    in property <bool> shown;
    // The section shown, kept while the app runs so the sheet opens where it was left.
    in-out property <int> section;
    in property <bool> clicks;
    // 0 the system's language, then English, French and Spanish, each named in its own language.
    in property <int> language;
    callback language-picked(int);
    in property <bool> keep-zoom;
    in property <bool> full-decode;
    in property <bool> screen-gamut;
    in property <bool> whole-roll-after-prepare;
    // The name of the hand's Frontier look file, empty while the measured table is in use.
    in property <string> frontier-file;
    // The phones connected or paired, empty with none, and whether any can be forgotten.
    in property <string> phones;
    in property <bool> can-forget;
    in property <string> version;
    callback flip(Act);
    callback close();
}

// A gesture that opens a sheet of its own closes this one first, so the two never stack.
component SheetKey inherits Button {
    in property <Act> act;
    clicked => {
        AppSettings.close();
        AppSettings.flip(root.act);
    }
}

// A section's page. Every page shares one cell and only the chosen one shows, so the sheet stands at
// the tallest page's height whichever is open and its DONE key never moves.
component Page inherits Rectangle {
    in property <int> section;
    visible: AppSettings.section == root.section;
    // The card's width is fixed: a hidden page's widest row never widens the page shown.
    min-width: 0px;
    VerticalLayout {
        alignment: start;
        @children
    }
}

component GeneralPage inherits Page {
    section: 0;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Language");
        Tabs {
            tabs: [@tr("Automatic"), "English", "Français", "Español"];
            selected: AppSettings.language;
            picked(i) => { AppSettings.language-picked(i); }
        }
        Label { role: TextRole.note; text: @tr("Automatic follows the system's language when the app speaks it, English otherwise."); }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Sound");
        Toggle {
            label: @tr("Key clicks");
            on: AppSettings.clicks;
            toggled => { AppSettings.flip(Act.toggle-sound); }
        }
        Label { role: TextRole.note; text: @tr("A click as each key is pressed and released."); }
    }
}

component EditorPage inherits Page {
    section: 1;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Viewing");
        Toggle {
            label: @tr("Keep the zoom from one photo to the next");
            on: AppSettings.keep-zoom;
            toggled => { AppSettings.flip(Act.keep-zoom); }
        }
        Label { role: TextRole.note; text: @tr("Off, each photo opens fitted to the canvas. On, it opens at the zoom of the last one, centred, to compare grain across a roll."); }
        Toggle {
            label: @tr("After Prepare, open the whole roll");
            on: AppSettings.whole-roll-after-prepare;
            toggled => { AppSettings.flip(Act.whole-roll-after-prepare); }
        }
        Label { role: TextRole.note; text: @tr("Off, a prepared roll opens on its first frame alone. On, it opens with every frame together, each edit reaching them all."); }
        Toggle {
            label: @tr("Show what this screen cannot show");
            on: AppSettings.screen-gamut;
            toggled => { AppSettings.flip(Act.screen-gamut); }
        }
        Label { role: TextRole.note; text: @tr("Stripes over the colours this screen cannot show."); }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("RAW Files");
        Toggle {
            label: @tr("Decode RAW files at full resolution");
            on: AppSettings.full-decode;
            toggled => { AppSettings.flip(Act.full-decode); }
        }
        Label { role: TextRole.note; text: @tr("Off, a RAW is read at half its size, 3 to 5 times faster, and every zoom shows it. On, it is read whole, for the finest grain past 50%. Details, De-dust and every export always read the whole RAW. Takes effect on the next photo opened."); }
    }
}

component FrontierPage inherits Page {
    section: 2;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Frontier Look");
        // The way back to the measured table is the title row's Reset, apart from the keys that keep a file.
        block: 0;
        modified: AppSettings.frontier-file != "";
        reset(b) => { AppSettings.flip(Act.frontier-measured); }
        Field {
            layout: FieldLayout.spread;
            label: @tr("Table in use");
            Label { tone: Tone.secondary; overflow: elide; text: AppSettings.frontier-file != "" ? AppSettings.frontier-file : @tr("Measured"); }
        }
        Label { role: TextRole.note; text: @tr("A colour table laid over ONI's conversion, in sRGB. Export it as a .cube file, edit it in any app that opens one, then use the file: each save shows at once, until Reset returns to the measured table."); }
        ButtonGroup {
            Button { text: @tr("Export…"); clicked => { AppSettings.flip(Act.frontier-export); } }
            Button { text: @tr("Use a File…"); clicked => { AppSettings.flip(Act.frontier-choose); } }
        }
    }
}

component PhonePage inherits Page {
    section: 3;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Phone Remote");
        Label { role: TextRole.note; text: @tr("The ONI app on a phone on the same network edits the photo open here, once paired by scanning a code."); }
        if AppSettings.phones != "": Label { role: TextRole.note; text: AppSettings.phones; }
        ButtonGroup {
            SheetKey { text: @tr("Pair Phone…"); act: Act.pair-phone; }
            Button { text: @tr("Forget Phones"); enabled: AppSettings.can-forget; clicked => { AppSettings.flip(Act.forget-phones); } }
        }
    }
}

component AboutPage inherits Page {
    section: 4;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Open Negative Initiative");
        // The figure the app reports of itself, on the glass every reported figure reads on.
        HorizontalLayout {
            alignment: start;
            LcdReadout { text: AppSettings.version; }
        }
        ButtonGroup {
            SheetKey { text: @tr("Check for Updates"); act: Act.check-updates; }
            SheetKey { text: @tr("What's New"); act: Act.whats-new; }
        }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Help");
        ButtonGroup {
            SheetKey { text: @tr("Welcome"); act: Act.welcome; }
            SheetKey { text: @tr("Report a Problem…"); act: Act.report; }
            SheetKey { text: @tr("Diagnostic Log"); act: Act.console; }
        }
    }
}

export component SettingsSheet inherits Sheet {
    title: @tr("Settings");
    card-width: SheetStyle.settings-width;
    dismissed => { AppSettings.close(); }
    property <[{ name: string, section: int }]> pages: [
        { name: @tr("General"), section: 0 }, { name: @tr("Editor"), section: 1 }, { name: @tr("Frontier Look"), section: 2 },
        { name: @tr("Phone"), section: 3 }, { name: @tr("About"), section: 4 }];
    property <[{ name: string, section: int }]> pages-without-phone: [
        { name: @tr("General"), section: 0 }, { name: @tr("Editor"), section: 1 }, { name: @tr("Frontier Look"), section: 2 },
        { name: @tr("About"), section: 4 }];
    HorizontalLayout {
        spacing: SheetStyle.gap;
        VerticalLayout {
            width: SheetStyle.settings-rail;
            alignment: start;
            // Each page keeps its section number, so About stays 4 while the Phone page is hidden.
            for page in Pairing.available ? root.pages : root.pages-without-phone: Row {
                form: RowForm.sidebar;
                title: page.name;
                selected: AppSettings.section == page.section;
                clicked => { AppSettings.section = page.section; }
            }
        }
        Divider { vertical: true; }
        GridLayout {
            horizontal-stretch: 1;
            GeneralPage { row: 0; col: 0; }
            EditorPage { row: 0; col: 0; }
            FrontierPage { row: 0; col: 0; }
            if Pairing.available: PhonePage { row: 0; col: 0; }
            AboutPage { row: 0; col: 0; }
        }
    }
    SheetFooter {
        commit: @tr("DONE");
        committed => { AppSettings.close(); }
    }
}
