// The Settings sheet the header's gear opens: the app's own choices, kept in the preferences file.
import { Sheet, SheetKeys, Button, ButtonGroup, ToggleRow, Note, Section } from "ds/ds.slint";

export global AppSettings {
    in property <bool> shown;
    in property <bool> half-size;
    in property <bool> clicks;
    // The Frontier look in use, and whether it is the hand's file rather than the measured table.
    in property <string> frontier-look;
    in property <bool> frontier-hand;
    // A choice by its preference's action: "half-size" or "toggle-sound".
    callback flip(string);
    callback close();
}

export component SettingsSheet inherits Sheet {
    title: "Settings";
    dismissed => { AppSettings.close(); }
    Section {
        title: "Rendering";
        separated: false;
        ToggleRow {
            label: "Read RAW previews at half size";
            on: AppSettings.half-size;
            toggled => { AppSettings.flip("half-size"); }
        }
        Note { text: "Opens faster, with less fine grain on screen. A zoom to full size and every export read the whole RAW."; }
    }
    Section {
        title: "Frontier look";
        Note { text: AppSettings.frontier-look; }
        Note { text: "A LUT on ONI's inversion, display sRGB in and out. Export it, edit it in any LUT tool, use the file: each save shows at once."; }
        ButtonGroup {
            Button { text: "EXPORT…"; clicked => { AppSettings.flip("frontier-export"); } }
            Button { text: "USE A FILE…"; clicked => { AppSettings.flip("frontier-choose"); } }
            Button { text: "MEASURED"; enabled: AppSettings.frontier-hand; clicked => { AppSettings.flip("frontier-measured"); } }
        }
    }
    Section {
        title: "Sound";
        ToggleRow {
            label: "Key clicks";
            on: AppSettings.clicks;
            toggled => { AppSettings.flip("toggle-sound"); }
        }
    }
    SheetKeys {
        Button {
            text: "DONE";
            clicked => { AppSettings.close(); }
        }
    }
}
