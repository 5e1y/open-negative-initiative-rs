// The Settings sheet the header's gear opens: the app's own choices by section, each kept in the
// preferences file, the sections listed on the left as macOS and Windows settings windows list theirs.
import { Act } from "act.slint";
import { Pairing } from "pairing.slint";
import { Sheet, SheetHeader, SheetStyle, SectionStyle, ButtonRows, Section, Tabs, Label, TextRole, Row, Toggle, Divider, RowForm, LcdReadout, Tone, Field, FieldLayout, Button, TldbMark, Space } from "ds/ds.slint";
import { Kit, KitLink } from "gear_state.slint";

export global AppSettings {
    in property <bool> shown;
    // The section shown, kept while the app runs so the sheet opens where it was left.
    in-out property <int> section;
    in property <bool> clicks;
    // 0 the system's language, then English, French and Spanish, each named in its own language.
    in property <int> language;
    callback language-picked(int);
    in property <bool> keep-zoom;
    in property <bool> full-decode;
    in property <bool> screen-gamut;
    in property <bool> whole-roll-after-prepare;
    // Colour's filters read as an enlarger's C, M and Y in place of Temperature and Tint.
    in property <bool> filtration-cmy;
    // The phones connected or paired, empty with none, and whether any can be forgotten.
    in property <string> phones;
    in property <bool> can-forget;
    in property <string> version;
    callback flip(Act);
    callback close();
    // The page of a project ONI's conversion draws on, named by its credit's place.
    callback open-credit(int);
}

// Keys whose gesture opens a sheet of its own close this one first, so the two never stack.
component SheetKeys inherits ButtonRows {
    in property <[Act]> acts;
    pressed(i) => {
        AppSettings.close();
        AppSettings.flip(root.acts[i]);
    }
}

// A section's page. Every page shares one cell and only the chosen one shows, so the sheet stands at
// the tallest page's height whichever is open.
component Page inherits Rectangle {
    in property <int> section;
    visible: AppSettings.section == root.section;
    // The card's width is fixed: a hidden page's widest row never widens the page shown.
    min-width: 0px;
    VerticalLayout {
        alignment: start;
        @children
    }
}

component GeneralPage inherits Page {
    section: 0;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Language");
        Tabs {
            tabs: [@tr("Automatic"), "English", "Français", "Español"];
            selected: AppSettings.language;
            picked(i) => { AppSettings.language-picked(i); }
        }
        Label { role: TextRole.note; text: @tr("Automatic follows the system's language when the app speaks it, English otherwise."); }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Sound");
        Toggle {
            label: @tr("Key clicks");
            on: AppSettings.clicks;
            toggled => { AppSettings.flip(Act.toggle-sound); }
        }
        Label { role: TextRole.note; text: @tr("A click as each key is pressed and released."); }
    }
}

component EditorPage inherits Page {
    section: 1;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Viewing");
        Toggle {
            label: @tr("Keep the zoom from one photo to the next");
            on: AppSettings.keep-zoom;
            toggled => { AppSettings.flip(Act.keep-zoom); }
        }
        Label { role: TextRole.note; text: @tr("Off, each photo opens fitted to the canvas. On, it opens at the zoom of the last one, centred, to compare grain across a roll."); }
        Toggle {
            label: @tr("After Prepare, open the whole roll");
            on: AppSettings.whole-roll-after-prepare;
            toggled => { AppSettings.flip(Act.whole-roll-after-prepare); }
        }
        Label { role: TextRole.note; text: @tr("Off, a prepared roll opens on its first frame alone. On, it opens with every frame together, each edit reaching them all."); }
        Toggle {
            label: @tr("Show what this screen cannot show");
            on: AppSettings.screen-gamut;
            toggled => { AppSettings.flip(Act.screen-gamut); }
        }
        Label { role: TextRole.note; text: @tr("Stripes over the colours this screen cannot show."); }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Colour Filtration");
        Tabs {
            tabs: [@tr("Temperature and Tint"), @tr("C, M and Y")];
            selected: AppSettings.filtration-cmy ? 1 : 0;
            picked(i) => { if ((i == 1) != AppSettings.filtration-cmy) { AppSettings.flip(Act.filtration-cmy); } }
        }
        Label { role: TextRole.note; text: @tr("How the Colour block shows each photo's filters: as Temperature and Tint, or as an enlarger's cyan, magenta and yellow in CC, a stop thirty CC, the least at none. Either writes the same values: switching moves no photo."); }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("RAW Files");
        Toggle {
            label: @tr("Decode RAW files at full resolution");
            on: AppSettings.full-decode;
            toggled => { AppSettings.flip(Act.full-decode); }
        }
        Label { role: TextRole.note; text: @tr("Off, a RAW is read at half its size, 3 to 5 times faster, and every zoom shows it. On, it is read whole, for the finest grain past 50%. Details, De-dust and every export always read the whole RAW. Takes effect on the next photo opened."); }
    }
}

component PhonePage inherits Page {
    section: 3;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Phone Remote");
        Label { role: TextRole.note; text: @tr("The ONI app on a phone on the same network edits the photo open here, once paired by scanning a code."); }
        if AppSettings.phones != "": Label { role: TextRole.note; text: AppSettings.phones; }
        ButtonRows {
            keys: [@tr("Pair Phone…"), @tr("Forget Phones")];
            enabled: [true, AppSettings.can-forget];
            // Pairing opens a sheet of its own, so Settings closes first; forgetting opens none.
            pressed(i) => {
                if (i == 0) { AppSettings.close(); }
                AppSettings.flip([Act.pair-phone, Act.forget-phones][i]);
            }
        }
    }
}

// The services ONI is connected to: The Lens DB, whose Kit fills the gear of exports.
component AppsPage inherits Page {
    section: 5;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("The Lens DB");
        TldbMark { credited: true; clicked => { Kit.open-site(); } }
        Label {
            role: TextRole.note;
            text: Kit.link == KitLink.in ? @tr("Connected as {}: your Kit fills the camera and the lens of your exports.", Kit.account)
                : Kit.link == KitLink.waiting ? @tr("Waiting for your browser to finish signing in.")
                : @tr("Not connected: your Kit shows where nothing is picked in the archive.");
        }
        HorizontalLayout {
            alignment: start;
            spacing: Space.s;
            if Kit.link == KitLink.in: Button {
                text: @tr("Disconnect");
                help: @tr("Signs ONI out of The Lens DB; your Kit stays there");
                clicked => { Kit.disconnect(); }
            }
            if Kit.link == KitLink.out: Button {
                text: @tr("Connect The Lens DB");
                clicked => {
                    AppSettings.close();
                    Kit.connect(false);
                }
            }
        }
    }
}

component AboutPage inherits Page {
    section: 4;
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.flush;
        separated: false;
        title: @tr("Open Negative Initiative");
        // The figure the app reports of itself, on the glass every reported figure reads on.
        HorizontalLayout {
            alignment: start;
            LcdReadout { text: AppSettings.version; }
        }
        SheetKeys {
            keys: [@tr("Check for Updates"), @tr("What's New")];
            acts: [Act.check-updates, Act.whats-new];
        }
    }
    // The data and the model the virtual films are shot on, credited as their licences ask.
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Credits");
        Label {
            role: TextRole.note;
            wrap: word-wrap;
            text: @tr("The virtual films and the papers are made from each film's and paper's data sheet, which ONI develops and prints its own way after spektrafilm's model by Andrea Volpato, and from the spectra of Wenzel Jakob and Johannes Hanika's spectral upsampling, under the BSD 2-clause licence, shipped unchanged with its licence.");
        }
        ButtonRows {
            keys: [@tr("spektrafilm"), @tr("vkdt")];
            pressed(i) => { AppSettings.open-credit(i); }
        }
    }
    Section {
        inset: SectionStyle.flush;
        foldable: false;
        before: SectionStyle.sheet-before;
        title: @tr("Help");
        SheetKeys {
            keys: [@tr("Welcome"), @tr("Report a Problem…"), @tr("Diagnostic Log")];
            acts: [Act.welcome, Act.report, Act.console];
        }
    }
}

// The board's header as every sheet of choices: the title beside its DONE key over a rule, then the rail of
// pages and the page shown, the rule between them running from that rule to the sheet's foot.
export component SettingsSheet inherits Sheet {
    title: @tr("Settings");
    header: SheetHeader.bar;
    card-width: SheetStyle.settings-width;
    dismissed => { AppSettings.close(); }
    property <[{ name: string, section: int }]> pages: [
        { name: @tr("General"), section: 0 }, { name: @tr("Editor"), section: 1 },
        { name: @tr("Phone"), section: 3 }, { name: @tr("Connected Apps"), section: 5 }, { name: @tr("About"), section: 4 }];
    property <[{ name: string, section: int }]> pages-without-phone: [
        { name: @tr("General"), section: 0 }, { name: @tr("Editor"), section: 1 },
        { name: @tr("Connected Apps"), section: 5 }, { name: @tr("About"), section: 4 }];
    HorizontalLayout {
        VerticalLayout {
            width: SheetStyle.settings-rail + SheetStyle.padding + SheetStyle.gap;
            padding: SheetStyle.padding;
            padding-right: SheetStyle.gap;
            alignment: start;
            // Each page keeps its section number, so About stays 4 while the Phone page is hidden.
            for page in Pairing.available ? root.pages : root.pages-without-phone: Row {
                form: RowForm.sidebar;
                title: page.name;
                selected: AppSettings.section == page.section;
                clicked => { AppSettings.section = page.section; }
            }
        }
        Divider { vertical: true; }
        GridLayout {
            horizontal-stretch: 1;
            padding: SheetStyle.padding;
            padding-left: SheetStyle.gap;
            GeneralPage { row: 0; col: 0; }
            EditorPage { row: 0; col: 0; }
            if Pairing.available: PhonePage { row: 0; col: 0; }
            AppsPage { row: 0; col: 0; }
            AboutPage { row: 0; col: 0; }
        }
    }
}
