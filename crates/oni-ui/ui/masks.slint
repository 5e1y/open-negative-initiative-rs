// The flat-field mask library's dialog: `DSDialogRequest` with a cancel of its own name and, for a
// rename, a field opened on the current name.
import { AskSheet, AskRole } from "ds/ds.slint";

export global MaskDialog {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    in property <bool> field;
    // The field's text, which the hand edits in place.
    in-out property <string> text;
    in property <string> cancel;
    in property <string> key;
    callback answered(bool, string);
}

export component MaskDialogSheet inherits AskSheet {
    title: MaskDialog.title;
    message: MaskDialog.message;
    field: MaskDialog.field;
    text <=> MaskDialog.text;
    cancel: MaskDialog.cancel;
    keys: [{ text: MaskDialog.key, role: AskRole.confirm }];
    default-key: 0;
    answered(i, typed) => { MaskDialog.answered(i == 0, i == 0 ? typed : ""); }
}
