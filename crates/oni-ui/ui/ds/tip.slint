// The notes a control gives: a hovered control's tooltip, the layer that holds it, and a help mark's card.
import { Colour, Space, Motion, TipStyle } from "theme.slint";
import { Outward } from "depth.slint";
import { Tip, Tips, TipBox, Label, TextRole, Tone, Picture, Ground, Raised, Lift, Gap } from "base.slint";

// What a hovered control says: a line of text. `natural-width` and `-height`: its unheld size.
export component TipCard inherits Outward {
    in property <string> text;
    out property <length> natural-width: tip-text.width + 2 * TipStyle.padding;
    out property <length> natural-height: tip-text.preferred-height + 2 * TipStyle.padding-y;
    width: root.natural-width;
    height: root.natural-height;
    fill: Colour.tip;
    radius: TipStyle.radius;
    tip-text := Label {
        role: TextRole.caption;
        text: root.text;
        wrap: word-wrap;
        width: min(self.preferred-width, TipStyle.max-width);
    }
}

// The tooltip, drawn above everything by the window that holds it, held inside it by `Tips.place`.
export component TipLayer inherits TipCard {
    in property <length> room;
    in property <length> room-height;
    text: Tip.text;
    out property <TipBox> box: Tips.place(Tip.x, Tip.above ? Tip.y - TipStyle.offset - root.natural-height : Tip.y + TipStyle.offset,
        root.natural-width, root.natural-height, root.room, root.room-height);
    x: root.box.x;
    y: root.box.y;
    width: root.box.width;
    height: root.box.height;
    // Shown after the delay by a timer: an animated opacity redraws the window for the whole delay.
    property <bool> shown: Tip.shown;
    property <bool> ready;
    changed shown => { root.ready = false; }
    visible: Tip.text != "" && Tip.shown && root.ready;
    Timer {
        interval: Motion.tip-delay;
        running: Tip.shown && !root.ready;
        triggered => { root.ready = true; }
    }
}

// A help mark's card: the topic's demo, square, over the note, one padding all round. It asks the demo
// for its frames while it stands, so a closed card costs nothing.
export component HelpCard inherits Raised {
    in property <string> note;
    // Named as its mark, for assistive tools: the region the mark opened.
    in property <string> subject;
    lift: Lift.float;
    pad: Gap.m;
    gap: Gap.m;
    accessible-role: groupbox;
    accessible-label: @tr("Help on {}", root.subject);
    Timer {
        interval: Tip.delay;
        running: Tip.has-clip;
        triggered => { Tip.advance(); }
    }
    // Its ground shows until the first frame lands.
    if Tip.has-clip: Picture {
        height: self.width;
        ground: Ground.skeleton;
        rounded: true;
        source: Tip.clip;
    }
    Label {
        role: TextRole.note;
        tone: Tone.primary;
        text: root.note;
    }
}

// The card open, left of the column holding its mark, its top at `top`, held inside the window by
// `Tips.place`: never over the block it explains. A press on it closes it and reaches nothing under it.
export component HelpLayer {
    in property <length> column-x;
    in property <length> top;
    property <TipBox> box: Tips.place(root.column-x - TipStyle.card-gap - TipStyle.card-width, root.top, TipStyle.card-width, card.height, root.width, root.height);
    TouchArea {
        x: root.box.x;
        y: root.box.y;
        width: card.width;
        height: card.height;
        clicked => { Tips.close(); }
    }
    card := HelpCard {
        x: root.box.x;
        y: root.box.y;
        width: TipStyle.card-width;
        note: Tip.open;
        subject: Tip.subject;
    }
}
