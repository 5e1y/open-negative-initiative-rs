// A wrapped gift, the welcome's one real-world reminder: a box in paper, its ribbon and bow, its tag under
// it. The hand lifts it; a click unties it, the lid flies off and light comes out of the box.
import { Colour, Motion, Space, Type } from "theme.slint";
import { WelcomeStyle, Curves } from "welcome.slint";

export global GiftStyle {
    out property <length> small: 132px;
    out property <length> huge: 236px;
    // Each part of the box, a share of its side: the bow, the lid, the body under it.
    out property <float> bow: 0.24;
    out property <float> lid: 0.2;
    out property <float> body: 0.74;
    out property <float> lid-over: 0.05;
    out property <float> band: 0.13;
    out property <length> lift: 10px;
    out property <duration> untie: 900ms;
    // The papers and ribbons, each gift its own; a mystery's ink its gold.
    out property <color> kraft: #c49a6c;
    out property <color> blue: #2e4a6e;
    out property <color> orange: #d4772c;
    out property <color> night: #1b1b20;
    out property <color> cream: #f1e6d0;
    out property <color> black-ribbon: #1a1a1a;
    out property <color> gold: Colour.medal[3];
    out property <color> shadow: #00000066;
    out property <color> light: #fff4d6;
}

export component Gift inherits Rectangle {
    in property <length> side: GiftStyle.small;
    in property <color> paper: GiftStyle.kraft;
    in property <color> ribbon: GiftStyle.cream;
    // The size it says on its tag before it is opened, what it held after.
    in property <string> tag;
    in property <string> name;
    in property <bool> opened;
    in property <bool> mystery;
    // The untying's progress, 0 wrapped to 1 open; the hall drives it from the click.
    in property <float> untie;
    callback chosen();
    property <length> bow-h: root.side * GiftStyle.bow;
    property <length> lid-h: root.side * GiftStyle.lid;
    property <length> body-h: root.side * GiftStyle.body;
    property <length> band: root.side * GiftStyle.band;
    property <float> open: root.opened ? 1 : root.untie;
    property <float> fly: Curves.glide(min(1, root.open * 1.4));
    property <float> glow: Curves.settle(max(0, root.open * 1.6 - 0.6));
    property <length> lifted: touch.has-hover && !root.opened ? GiftStyle.lift : 0px;
    // A mystery shivers now and then, as a box with something alive in it.
    property <float> beat: Math.mod(animation-tick() / 1ms, 2600) / 2600;
    property <angle> shiver: root.mystery && root.open == 0 && root.beat > 0.82 ? 4deg * Math.sin((root.beat - 0.82) * 6000deg) : 0deg;
    width: max(root.side * (1 + 2 * GiftStyle.lid-over), tag.preferred-width);
    height: root.bow-h + root.lid-h + root.body-h + Space.m + tag.preferred-height;
    animate lifted { duration: Motion.settle; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.opened ? root.name : root.tag;
    accessible-action-default => { root.chosen(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }
    property <length> left: (root.width - root.side) / 2;
    property <length> floor: root.bow-h + root.lid-h + root.body-h;
    // The shadow on the floor, smaller as the box rises off it.
    Rectangle {
        x: root.left + root.lifted;
        y: root.floor - root.side * 0.04;
        width: root.side - 2 * root.lifted;
        height: root.side * 0.08;
        border-radius: self.height / 2;
        background: GiftStyle.shadow;
    }
    box := Rectangle {
        y: -root.lifted;
        transform-rotation: root.shiver;
        transform-origin: { x: root.width / 2, y: root.floor };
        // The light out of the opened box, behind its lid's flight.
        Rectangle {
            x: root.left - root.side * 0.4;
            y: root.bow-h + root.lid-h - root.side * 0.9;
            width: root.side * 1.8;
            height: root.side * 1.8;
            opacity: root.glow;
            background: @radial-gradient(circle, GiftStyle.light.with-alpha(0.7) 0%, GiftStyle.light.with-alpha(0.2) 30%, GiftStyle.light.with-alpha(0) 50%);
        }
        // The body, its paper lit from the upper left, the ribbon down its middle; open, its inside shows dark.
        Rectangle {
            x: root.left;
            y: root.bow-h + root.lid-h;
            width: root.side;
            height: root.body-h;
            border-radius: 3px;
            clip: true;
            background: @linear-gradient(135deg, root.paper.brighter(0.18) 0%, root.paper 45%, root.paper.darker(0.25) 100%);
            // A mystery's front keeps its question mark clear: its ribbon ties the lid alone.
            if !root.mystery: Rectangle { x: (parent.width - root.band) / 2; width: root.band; background: root.ribbon; opacity: 1 - root.glow; }
            if !root.mystery: Rectangle { y: parent.height * 0.45; height: root.band * 0.8; background: root.ribbon; opacity: 1 - root.glow; }
            if root.mystery: Text {
                text: "?";
                font-family: WelcomeStyle.headline-family;
                font-size: root.side * 0.42;
                color: root.ribbon;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: 1 - root.glow;
            }
            Rectangle { y: 0; height: root.side * 0.06; background: @linear-gradient(180deg, #00000066 0%, #00000000 100%); opacity: root.glow; }
        }
        // The lid and its bow, which fly off together as the ribbon gives.
        Rectangle {
            x: root.left - root.side * GiftStyle.lid-over;
            y: root.bow-h - root.side * 0.9 * root.fly;
            width: root.side * (1 + 2 * GiftStyle.lid-over);
            height: root.lid-h + root.bow-h;
            transform-rotation: -28deg * root.fly;
            transform-origin: { x: self.width / 2, y: self.height };
            opacity: 1 - Curves.settle(max(0, root.open * 2 - 1));
            visible: self.opacity > 0;
            Rectangle {
                y: root.bow-h;
                height: root.lid-h;
                border-radius: 3px;
                drop-shadow-color: #00000055;
                drop-shadow-blur: 6px;
                drop-shadow-offset-y: 3px;
                background: @linear-gradient(135deg, root.paper.brighter(0.25) 0%, root.paper.brighter(0.05) 55%, root.paper.darker(0.1) 100%);
                Rectangle { x: (parent.width - root.band) / 2; width: root.band; background: root.ribbon; }
                Rectangle { y: parent.height - 2px; height: 2px; background: root.paper.darker(0.4); }
            }
            for wing in [-1, 1]: Rectangle {
                x: parent.width / 2 - self.width / 2 + wing * self.width * 0.42;
                y: root.bow-h * 0.25;
                width: root.side * 0.26;
                height: root.bow-h * 0.72;
                border-radius: self.height / 2;
                border-width: root.band * 0.32;
                border-color: root.ribbon;
                transform-rotation: wing * 24deg;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.bow-h * 0.62;
                width: root.band * 1.2;
                height: root.bow-h * 0.45;
                border-radius: root.band * 0.3;
                background: root.ribbon.darker(0.08);
            }
        }
    }
    tag := Text {
        x: (root.width - self.width) / 2;
        y: root.floor + Space.m;
        width: self.preferred-width;
        text: root.opened ? root.name : root.tag;
        font-family: Type.family;
        font-size: Type.label;
        font-weight: root.opened ? Type.strong : Type.regular;
        color: root.opened || touch.has-hover ? Colour.ink : Colour.ink-secondary;
        horizontal-alignment: center;
    }
}
