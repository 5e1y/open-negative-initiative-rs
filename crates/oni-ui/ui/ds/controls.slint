// The controls: buttons, the toggle and the field; the slider is `slider.slint`, the tabs `tabs.slint`.
import { Space, State, ButtonStyle, TabsStyle, ToggleStyle, SliderStyle } from "theme.slint";
import { Label, Tone, Clicks } from "base.slint";
import { KeyScope } from "keyboard.slint";

import { ButtonKind, ButtonSize, Look, KeyInk, Button } from "button.slint";
import { SliderFill, Knob, Rail, Slider } from "slider.slint";
export { ButtonKind, ButtonSize, Look, KeyInk, Button, SliderFill, Knob, Slider }
import { TextField, RenameField } from "fields.slint";
export { TextField, RenameField }

// Where a group of keys sits in its row; `fill` spans it, its worded keys sharing the width.
export enum GroupAlign { start, end, center, fill }

// Keys side by side as one family: `plate` sets them flush on one face, a segmented row whose key under
// the hand or on lights alone, else a spaced row `Space.s` apart, as Swift's `HStack(spacing: DS.Space.sm)`.
export component ButtonGroup inherits HorizontalLayout {
    in property <bool> plate;
    in property <GroupAlign> align: GroupAlign.start;
    // A plate of mini keys, rounded as they are.
    in property <bool> mini;
    out property <length> radius: !root.plate ? 0px : root.mini ? ButtonStyle.small-radius : ButtonStyle.radius;
    out property <length> gap: root.plate ? 0px : ButtonStyle.group-gap;
    property <bool> fills: root.align == GroupAlign.fill;
    alignment: root.align == GroupAlign.end ? end : root.align == GroupAlign.center ? center : root.fills ? stretch : start;
    // A flat key beside a keycap stands on the plate's middle.
    cross-axis-alignment: center;
    socket := Rectangle {
        horizontal-stretch: root.fills ? 1 : 0;
        min-width: row.min-width;
        preferred-width: row.preferred-width;
        min-height: row.min-height;
        max-height: row.max-height;
        background: root.plate ? ButtonStyle.face : transparent;
        border-radius: root.radius;
        row := HorizontalLayout {
            spacing: root.gap;
            alignment: root.fills ? stretch : start;
            cross-axis-alignment: center;
            @children
        }
    }
}

// Where a switch's words sit: `after` it as `DSToggle`, `before` it across the row's room, `none` the
// switch named for accessibility alone.
export enum LabelSide { none, after, before }

// A switch, a camera's slide lever: the slider's knob on a short rail of its own, slid to the far end
// and the rail lit up to it while on. Its owner holds the state: a click only asks, so an undo or
// another photo moves the knob as much as the hand does. Its words flip it too.
export component Toggle inherits HorizontalLayout {
    in property <bool> on;
    in property <string> label;
    in property <LabelSide> label-side: LabelSide.after;
    // Words that wrap, the switch kept on their first line.
    in property <bool> wrap;
    in property <bool> enabled: true;
    callback toggled(bool);
    property <bool> worded: root.label != "" && root.label-side != LabelSide.none;
    // Where the knob stands along its travel, sliding on the grab spring as a tab's pill.
    property <float> shown: root.on ? 1 : 0;
    animate shown { duration: TabsStyle.slide; easing: spring(0.38); }
    function flip() {
        Clicks.press();
        root.toggled(!root.on);
    }
    alignment: start;
    spacing: Space.s;
    // Alone, the switch keeps its own width, so a row's label pushes it to the end.
    horizontal-stretch: root.worded ? 1 : 0;
    if root.worded && root.label-side == LabelSide.before: Label {
        text: root.label;
        tone: root.enabled ? Tone.primary : Tone.secondary;
        wrap: root.wrap ? word-wrap : no-wrap;
        horizontal-stretch: 1;
        TouchArea { enabled: root.enabled; clicked => { root.flip(); } }
    }
    VerticalLayout {
        alignment: root.wrap ? start : center;
        Rectangle {
            height: SliderStyle.row;
            width: SliderStyle.knob-width + ToggleStyle.travel;
            opacity: root.enabled ? 1 : State.disabled;
            accessible-role: checkbox;
            accessible-checked: root.on;
            accessible-label: root.label;
            Rail {
                y: (parent.height - self.height) / 2;
                overhang: SliderStyle.knob-width / 2;
                fill: SliderFill.level;
                at: root.shown;
            }
            // The knob grows under the hand, as a slider's.
            Knob {
                centre: SliderStyle.knob-width / 2 + root.shown * ToggleStyle.travel;
                grown: root.enabled && area.has-hover;
            }
            area := TouchArea {
                enabled: root.enabled;
                clicked => { root.flip(); }
            }
            // Space or Return flips it while it holds the keyboard.
            KeyScope {
                enabled: root.enabled;
                radius: self.height / 2;
                key-pressed(event) => {
                    if ((event.text != " " && event.text != Key.Return) || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                        return reject;
                    }
                    if (!event.repeat) { root.flip(); }
                    accept
                }
            }
        }
    }
    if root.worded && root.label-side == LabelSide.after: Label {
        text: root.label;
        tone: root.enabled ? Tone.primary : Tone.secondary;
        wrap: root.wrap ? word-wrap : no-wrap;
        horizontal-stretch: root.wrap ? 1 : 0;
        TouchArea { enabled: root.enabled; clicked => { root.flip(); } }
    }
}
