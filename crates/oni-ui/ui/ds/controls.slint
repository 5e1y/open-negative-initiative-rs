// The controls: buttons, the toggle, the slider, the field and the picker; the tabs are `tabs.slint`.
import { DS } from "tokens.slint";
import { Colour, Space, Stroke, Type, State, Motion, ButtonStyle, SliderStyle, TabsStyle, ToggleStyle, FieldStyle, ScannerStyle } from "theme.slint";
import { Label, Icon, TextRole, Tone, Tones, Tips, Clicks } from "base.slint";
import { Icons } from "icons.slint";
import { ButtonKind, ButtonSize, Look, SliderFill, Knob, KeyInk, ButtonInk, Button } from "button.slint";
export { ButtonKind, ButtonSize, Look, SliderFill, Knob, KeyInk, ButtonInk, Button }

// `KeycapPlate`: keys side by side as one family, on a socket when `plate`, flush a hairline apart;
// `fills` spans the row, its worded keys sharing the width; `trailing` sits it at the row's end.
export component ButtonGroup inherits HorizontalLayout {
    in property <bool> plate;
    in property <bool> fills;
    // `.mini`: the radius of the small keys it holds.
    in property <bool> mini;
    in property <bool> trailing;
    alignment: root.trailing ? end : root.fills ? stretch : start;
    socket := Rectangle {
        horizontal-stretch: root.fills ? 1 : 0;
        min-width: row.min-width;
        preferred-width: row.preferred-width;
        min-height: row.min-height;
        max-height: row.max-height;
        background: root.plate ? ButtonStyle.socket : transparent;
        border-radius: root.plate ? (root.mini ? ButtonStyle.small-radius : ButtonStyle.radius) + ButtonStyle.plate-inset : 0px;
        row := HorizontalLayout {
            padding: root.plate ? ButtonStyle.plate-inset : 0px;
            spacing: root.plate ? ButtonStyle.plate-inset : ButtonStyle.group-gap;
            alignment: root.fills ? stretch : start;
            @children
        }
    }
}

// A switch: a thumb that slides to the lit side. Its owner holds the state: a click only asks,
// so an undo or another photo moves the thumb as much as the hand does.
export component Toggle inherits HorizontalLayout {
    in property <bool> on;
    in property <string> label;
    // `DSToggle`: the label shown at the switch's right, both flipping it; else it names the switch alone.
    in property <bool> labelled;
    in property <bool> enabled: true;
    callback toggled(bool);
    alignment: start;
    spacing: Space.s;
    // Alone, the switch keeps its own width, so a row's label pushes it to the end.
    horizontal-stretch: root.labelled ? 1 : 0;
    VerticalLayout {
        alignment: center;
        Rectangle {
            height: ToggleStyle.height;
            width: ToggleStyle.width;
            border-radius: self.height / 2;
            background: root.on ? Colour.confirm : Colour.track;
            opacity: root.enabled ? 1 : State.disabled;
            accessible-role: checkbox;
            accessible-checked: root.on;
            accessible-label: root.label;
            animate background { duration: Motion.quick; }
            Rectangle {
                y: ToggleStyle.inset;
                height: parent.height - 2 * ToggleStyle.inset;
                width: self.height;
                x: root.on ? parent.width - self.width - ToggleStyle.inset : ToggleStyle.inset;
                border-radius: self.height / 2;
                background: Colour.white;
                animate x { duration: Motion.quick; }
            }
            TouchArea {
                enabled: root.enabled;
                clicked => {
                    Clicks.press();
                    root.toggled(!root.on);
                }
            }
        }
    }
    if root.labelled: Label {
        text: root.label;
        tone: root.enabled ? Tone.primary : Tone.secondary;
        TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.on); } }
    }
}

// `DSSlider`: the readout, then a track whose whole row grabs; Rust holds the value and its timing.
export component Slider inherits VerticalLayout {
    in property <int> field;
    in property <string> label;
    in property <string> readout;
    // The settings' value, which accessibility reads where the readout shows the hand's.
    in property <string> value-text;
    in property <float> fraction;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    in property <Knob> knob: Knob.grey;
    in property <bool> enabled: true;
    in property <Look> look: Look.live;
    // Rust answers whether this press is the second of a double click.
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    // Rust answers whether the scroll runs along the track; one across it is left to the panel.
    callback scroll(int, length, length, length, bool) -> bool;
    callback step(int, int);
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.step(root.field, 1); }
    accessible-action-decrement => { root.step(root.field, -1); }
    property <float> at: clamp(root.fraction, 0, 1);
    HorizontalLayout {
        spacing: Space.s;
        opacity: root.enabled ? 1 : State.disabled;
        Label { text: root.label; overflow: elide; horizontal-stretch: 1; }
        Label { text: root.readout; role: TextRole.value; tone: Tone.secondary; horizontal-alignment: right; }
    }
    HorizontalLayout {
        padding-left: SliderStyle.knob-width / 2;
        padding-right: SliderStyle.knob-width / 2;
        track := Rectangle {
            height: SliderStyle.row;
            opacity: root.enabled ? 1 : State.disabled;
            // Drawn past the travel by the knob's half-width at both ends, filled up to the value.
            rail := Rectangle {
                x: -SliderStyle.knob-width / 2;
                width: parent.width + SliderStyle.knob-width;
                y: (parent.height - self.height) / 2;
                height: SliderStyle.track;
                border-radius: SliderStyle.track-radius;
                background: root.fill == SliderFill.bipolar ? @linear-gradient(90deg, root.low 0%, root.high 100%) : Colour.track;
                if root.fill != SliderFill.bipolar: Rectangle {
                    x: 0;
                    border-radius: SliderStyle.track-radius; // its own round: a rail clipping it renders each slider apart
                    width: SliderStyle.knob-width / 2 + root.at * track.width;
                    background: root.fill == SliderFill.metal
                        ? @linear-gradient(180deg, Colour.metal-dark 0%, Colour.metal-light 35%, Colour.metal-light 65%, Colour.metal-dark 100%)
                        : root.fill == SliderFill.ramp
                        ? @linear-gradient(90deg, root.tint.with-alpha(SliderStyle.ramp-start) 0%, root.tint.with-alpha(SliderStyle.ramp-end) 100%)
                        : root.tint;
                }
            }
            Rectangle {
                property <float> grow: (area.over-knob || area.held || root.look != Look.live) ? SliderStyle.knob-grow : 1;
                width: SliderStyle.knob-width * self.grow;
                height: SliderStyle.knob-height * self.grow;
                x: parent.width * root.at - self.width / 2;
                y: (parent.height - self.height) / 2;
                border-radius: SliderStyle.knob-radius;
                background: root.knob == Knob.white ? Colour.white : root.knob == Knob.black ? Colour.black : SliderStyle.knob;
                border-width: Stroke.line;
                border-color: SliderStyle.knob-edge;
                animate grow { duration: Motion.quick; easing: ease-out-back; }
                HorizontalLayout {
                    alignment: center;
                    spacing: SliderStyle.grip-gap - Stroke.line;
                    padding-top: (parent.height - SliderStyle.grip) / 2;
                    padding-bottom: (parent.height - SliderStyle.grip) / 2;
                    for _ in 2: Rectangle {
                        width: Stroke.line;
                        background: root.knob == Knob.white ? Colour.ink-on-light : SliderStyle.grip-ink;
                    }
                }
            }
            area := TouchArea {
                enabled: root.enabled;
                in-out property <bool> held;
                property <bool> fine;
                out property <bool> over-knob: self.has-hover && abs(self.mouse-x - parent.width * root.at) <= SliderStyle.knob-width / 2;
                mouse-cursor: self.held ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.fine = event.modifiers.alt;
                        self.held = !root.press(root.field, self.fine);
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        if (event.button == PointerEventButton.left || event.kind == PointerEventKind.cancel) {
                            self.held = false;
                            root.release(root.field);
                        }
                    } else if (event.kind == PointerEventKind.move) {
                        self.fine = event.modifiers.alt;
                    }
                }
                moved => {
                    if (self.held) {
                        root.drag(root.field, self.mouse-x - self.pressed-x, track.width, self.fine);
                    }
                }
                scroll-event(event) => {
                    if (root.scroll(root.field, event.delta-x, event.delta-y, track.width, event.modifiers.alt)) {
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }
        }
    }
}

// The serial of the last field entered, so a window's return to its field keeps its selection.
global FieldFocus {
    in-out property <int> serial;
}

// `DSTextField`: the field on the canvas's dark, its edge lit while it holds the focus. Entered by a
// click, Tab or its owner, it selects its whole value, as AppKit's field does; once in, a click
// places the caret, a double click selects a word and a triple click the line.
export component TextField inherits HorizontalLayout {
    in-out property <string> text <=> input.text;
    // The owner's text, pushed in at each change: a binding on `text` dies at the first key typed.
    in property <string> value;
    in property <string> placeholder;
    // A unit after the box, as "px" beside a size.
    in property <string> suffix;
    // Lines that wrap in a box `lines-height` tall, as a report's message or a photo's note.
    in property <bool> multiline;
    in property <length> lines-height: DS.control-report-message-height;
    in property <bool> focused-look;
    in property <bool> enabled: true;
    out property <bool> editing: input.has-focus;
    callback edited(string);
    // Return; and the focus leaving the field, which a typed value also commits on.
    callback accepted(string);
    callback left(string);
    public function take-focus() { input.focus(); }
    public function take-focus-selecting() { input.focus(); input.select-all(); }
    // The `FieldFocus` serial this field took when last entered; -1 before it ever was.
    property <int> held: -1;
    init => { if (root.value != "") { input.text = root.value; } }
    changed value => { input.text = root.value; }
    spacing: Space.xxs;
    opacity: root.suffix != "" && !root.enabled ? State.disabled : 1;
    box := Rectangle {
        horizontal-stretch: 1;
        height: root.multiline ? root.lines-height : FieldStyle.height;
        border-radius: FieldStyle.radius;
        background: Colour.canvas;
        border-width: (input.has-focus || root.focused-look) ? Stroke.line : Stroke.hairline;
        border-color: (input.has-focus || root.focused-look) ? Colour.focus : Colour.separator;
        clip: root.multiline;
        input := TextInput {
            x: FieldStyle.padding;
            y: root.multiline ? FieldStyle.padding : 0px;
            width: parent.width - 2 * FieldStyle.padding;
            height: root.multiline ? parent.height - 2 * FieldStyle.padding : parent.height;
            single-line: !root.multiline;
            wrap: root.multiline ? word-wrap : no-wrap;
            vertical-alignment: root.multiline ? top : center;
            font-family: Type.family;
            font-size: Type.label;
            color: Colour.ink;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            changed has-focus => {
                if (self.has-focus) {
                    // A return with no other field entered meanwhile is the window's coming back.
                    if (root.held != FieldFocus.serial) { self.select-all(); }
                    FieldFocus.serial += 1;
                    root.held = FieldFocus.serial;
                } else {
                    root.left(self.text);
                }
            }
        }
        if !root.multiline && input.text == "" && !input.has-focus: Label {
            x: FieldStyle.padding;
            height: parent.height;
            text: root.placeholder;
            tone: Tone.tertiary;
        }
        // Over the field until it holds the focus: the press enters it, then the input takes the clicks.
        TouchArea {
            enabled: root.enabled && !input.has-focus;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    input.focus();
                    input.select-all();
                }
            }
        }
    }
    if root.suffix != "": Label { text: root.suffix; tone: Tone.secondary; }
}
