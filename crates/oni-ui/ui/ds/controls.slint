// The controls: buttons, the toggle and the field; the slider is `slider.slint`, the tabs `tabs.slint`.
import { DS } from "tokens.slint";
import { Colour, Space, Stroke, Type, State, Motion, ButtonStyle, ToggleStyle, FieldStyle } from "theme.slint";
import { Label, TextRole, Tone, Clicks } from "base.slint";

import { Dot } from "marks.slint";
import { ButtonKind, ButtonSize, Look, KeyInk, ButtonInk, Button } from "button.slint";
import { SliderFill, Knob, Slider } from "slider.slint";
export { ButtonKind, ButtonSize, Look, KeyInk, ButtonInk, Button, SliderFill, Knob, Slider }

// Where a group of keys sits in its row; `fill` spans it, its worded keys sharing the width.
export enum GroupAlign { start, end, center, fill }

// `KeycapPlate`: keys side by side as one family, on a socket when `plate`, flush a hairline apart.
export component ButtonGroup inherits HorizontalLayout {
    in property <bool> plate;
    in property <GroupAlign> align: GroupAlign.start;
    // The radius of the small keys it holds.
    in property <bool> small;
    property <bool> fills: root.align == GroupAlign.fill;
    alignment: root.align == GroupAlign.end ? end : root.align == GroupAlign.center ? center : root.fills ? stretch : start;
    socket := Rectangle {
        horizontal-stretch: root.fills ? 1 : 0;
        min-width: row.min-width;
        preferred-width: row.preferred-width;
        min-height: row.min-height;
        max-height: row.max-height;
        background: root.plate ? Colour.well : transparent;
        border-radius: root.plate ? (root.small ? ButtonStyle.small-radius : ButtonStyle.radius) + ButtonStyle.plate-inset : 0px;
        row := HorizontalLayout {
            padding: root.plate ? ButtonStyle.plate-inset : 0px;
            spacing: root.plate ? ButtonStyle.plate-inset : ButtonStyle.group-gap;
            alignment: root.fills ? stretch : start;
            @children
        }
    }
}

// Where a switch's words sit: `after` it as `DSToggle`, `before` it across the row's room, `none` the
// switch named for accessibility alone.
export enum LabelSide { none, after, before }

// A switch: a thumb that slides to the lit side. Its owner holds the state: a click only asks,
// so an undo or another photo moves the thumb as much as the hand does. Its words flip it too.
export component Toggle inherits HorizontalLayout {
    in property <bool> on;
    in property <string> label;
    in property <LabelSide> label-side: LabelSide.after;
    // Words that wrap, the switch kept on their first line.
    in property <bool> wrap;
    in property <bool> enabled: true;
    callback toggled(bool);
    property <bool> worded: root.label != "" && root.label-side != LabelSide.none;
    alignment: start;
    spacing: Space.s;
    // Alone, the switch keeps its own width, so a row's label pushes it to the end.
    horizontal-stretch: root.worded ? 1 : 0;
    if root.worded && root.label-side == LabelSide.before: Label {
        text: root.label;
        tone: root.enabled ? Tone.primary : Tone.secondary;
        wrap: root.wrap ? word-wrap : no-wrap;
        horizontal-stretch: 1;
        TouchArea { enabled: root.enabled; clicked => { Clicks.press(); root.toggled(!root.on); } }
    }
    VerticalLayout {
        alignment: root.wrap ? start : center;
        Rectangle {
            height: ToggleStyle.height;
            width: ToggleStyle.width;
            border-radius: self.height / 2;
            background: root.on ? Colour.confirm : Colour.track;
            opacity: root.enabled ? 1 : State.disabled;
            accessible-role: checkbox;
            accessible-checked: root.on;
            accessible-label: root.label;
            animate background { duration: Motion.quick; }
            Dot {
                y: ToggleStyle.inset;
                size: parent.height - 2 * ToggleStyle.inset;
                x: root.on ? parent.width - self.width - ToggleStyle.inset : ToggleStyle.inset;
                ink: Colour.white;
                animate x { duration: Motion.quick; }
            }
            TouchArea {
                enabled: root.enabled;
                clicked => {
                    Clicks.press();
                    root.toggled(!root.on);
                }
            }
        }
    }
    if root.worded && root.label-side == LabelSide.after: Label {
        text: root.label;
        tone: root.enabled ? Tone.primary : Tone.secondary;
        wrap: root.wrap ? word-wrap : no-wrap;
        horizontal-stretch: root.wrap ? 1 : 0;
        TouchArea { enabled: root.enabled; clicked => { Clicks.press(); root.toggled(!root.on); } }
    }
}

// The serial of the last field entered, so a window's return to its field keeps its selection.
global FieldFocus {
    in-out property <int> serial;
}

// `DSTextField`: the field on the canvas's dark, its edge lit while it holds the focus. Entered by a
// click, Tab or its owner, it selects its whole value, as AppKit's field does; once in, a click
// places the caret, a double click selects a word and a triple click the line.
export component TextField inherits HorizontalLayout {
    in-out property <string> text <=> input.text;
    // The owner's text, pushed in at each change: a binding on `text` dies at the first key typed.
    in property <string> value;
    in property <string> placeholder;
    // A unit after the box, as "px" beside a size.
    in property <string> suffix;
    // Lines that wrap in a box `lines-height` tall, as a report's message or a photo's note.
    in property <bool> multiline;
    in property <length> lines-height: DS.control-report-message-height;
    // The words centred in the box, as a date's digits.
    in property <bool> centred;
    // The face of the words typed: a label's, or a title's as a date's digits.
    in property <TextRole> role: TextRole.label;
    in property <bool> focused-look;
    in property <bool> enabled: true;
    out property <bool> editing: input.has-focus;
    callback edited(string);
    // Return; and the focus leaving the field, which a typed value also commits on.
    callback accepted(string);
    callback left(string);
    public function take-focus() { input.focus(); }
    public function take-focus-selecting() { input.focus(); input.select-all(); }
    // The `FieldFocus` serial this field took when last entered; -1 before it ever was.
    property <int> held: -1;
    init => { if (root.value != "") { input.text = root.value; } }
    changed value => { input.text = root.value; }
    spacing: Space.xxs;
    opacity: root.enabled ? 1 : State.disabled;
    box := Rectangle {
        horizontal-stretch: 1;
        height: root.multiline ? root.lines-height : ButtonStyle.height;
        border-radius: ButtonStyle.radius;
        background: Colour.canvas;
        border-width: (input.has-focus || root.focused-look) ? Stroke.line : Stroke.hairline;
        border-color: (input.has-focus || root.focused-look) ? Colour.accent : Colour.separator;
        clip: root.multiline;
        // A centred box spans its whole width, so a date's digits never meet its padding.
        input := TextInput {
            x: root.centred ? 0px : FieldStyle.padding;
            y: root.multiline ? FieldStyle.padding : 0px;
            width: parent.width - 2 * self.x;
            height: root.multiline ? parent.height - 2 * FieldStyle.padding : parent.height;
            single-line: !root.multiline;
            wrap: root.multiline ? word-wrap : no-wrap;
            vertical-alignment: root.multiline ? top : center;
            horizontal-alignment: root.centred ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
            font-family: Type.family;
            font-size: root.role == TextRole.title ? Type.title : Type.label;
            color: Colour.ink;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            changed has-focus => {
                if (self.has-focus) {
                    // A return with no other field entered meanwhile is the window's coming back.
                    if (root.held != FieldFocus.serial) { self.select-all(); }
                    FieldFocus.serial += 1;
                    root.held = FieldFocus.serial;
                } else {
                    root.left(self.text);
                }
            }
        }
        if input.text == "" && !input.has-focus && !root.focused-look: Label {
            x: input.x;
            y: input.y;
            width: input.width;
            height: root.multiline ? self.preferred-height : input.height;
            text: root.placeholder;
            tone: Tone.tertiary;
            centred: root.centred;
        }
        // Over the field until it holds the focus: the press enters it, then the input takes the clicks.
        TouchArea {
            enabled: root.enabled && !input.has-focus;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    input.focus();
                    input.select-all();
                }
            }
        }
    }
    if root.suffix != "": Label { text: root.suffix; tone: Tone.secondary; }
}

// `RenameField`: a name typed over in place, entered at once with its value selected; Return or the
// focus leaving commits it, Escape gives the old one back.
export component RenameField inherits FocusScope {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback committed(string);
    callback cancelled();
    property <bool> done;
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.done = true;
            root.cancelled();
            return accept;
        }
        reject
    }
    VerticalLayout {
        alignment: center;
        TextField {
            text: root.text;
            placeholder: root.placeholder;
            init => { self.take-focus(); }
            edited(t) => { root.edited(t); }
            accepted(t) => { if (!root.done) { root.done = true; root.committed(t); } }
            left(t) => { if (!root.done) { root.done = true; root.committed(t); } }
        }
    }
}
