// `FrameOverlay`: a frame over the shown image, the crop's or the measuring window's style, its
// corners, edges and body held by the hand; Rust holds the rectangle and constrains every move.
import { DS } from "tokens.slint";
import { Colour, CropStyle, Space, Stroke, Type, PlotStyle } from "theme.slint";
import { Badge } from "badge.slint";
import { TextRole, Label } from "base.slint";
import { GuideLine } from "guides.slint";
import { RingTone, Ring } from "marks.slint";

export enum FrameStyle { crop, window }

// A sheet of frames on the canvas, the black they lie on, and a frame's number under its picture,
// centred in the band below it, at the size the sheet's zoom gives it.
export struct SheetBox {
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct EdgeNumber {
    x: length,
    y: length,
    text: string,
}

// A sheet's ground, its numbers' ink and its logo's.
export struct SheetInks {
    ground: color,
    number: color,
    logo: color,
}

export component EdgePrint inherits Label {
    in property <length> size;
    ink: Colour.edge-print;
    font-size: root.size;
    font-weight: Type.bold;
}

// One handle's grab: the press and the travel since it, in window coordinates, so the frame moving
// under the hand never changes what the drag reads.
component Grab inherits TouchArea {
    in property <int> handle;
    callback grabbed(int);
    callback dragged(int, length, length);
    callback released();
    property <length> from-x;
    property <length> from-y;
    pointer-event(event) => {
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            self.from-x = self.absolute-position.x + self.mouse-x;
            self.from-y = self.absolute-position.y + self.mouse-y;
            root.grabbed(root.handle);
        }
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
            root.released();
        }
    }
    moved => {
        if (self.pressed) {
            root.dragged(root.handle, self.absolute-position.x + self.mouse-x - self.from-x, self.absolute-position.y + self.mouse-y - self.from-y);
        }
    }
}

// A corner's bracket: two strokes from the corner's own point, a dark strip under each.
component Bracket inherits Rectangle {
    in property <bool> right;
    in property <bool> bottom;
    in property <bool> active;
    // Its line at rest: the guide's on a crop, `unalignedBalance` on the measuring window.
    in property <color> rest: Colour.guide;
    property <length> line: root.active ? CropStyle.stroke + 1px : CropStyle.stroke;
    Rectangle {
        x: root.right ? parent.width - root.line - CropStyle.halo : 0;
        y: 0;
        width: root.line + CropStyle.halo;
        height: parent.height;
        background: root.active ? Colour.contrast-edge : Colour.contrast-edge-idle;
    }
    Rectangle {
        x: 0;
        y: root.bottom ? parent.height - root.line - CropStyle.halo : 0;
        width: parent.width;
        height: root.line + CropStyle.halo;
        background: root.active ? Colour.contrast-edge : Colour.contrast-edge-idle;
    }
    Rectangle {
        x: root.right ? parent.width - root.line : 0;
        y: 0;
        width: root.line;
        height: parent.height;
        background: root.active ? Colour.handle-active : root.rest;
    }
    Rectangle {
        x: 0;
        y: root.bottom ? parent.height - root.line : 0;
        width: parent.width;
        height: root.line;
        background: root.active ? Colour.handle-active : root.rest;
    }
}

// Handles: 0 the body, 1 to 4 the corners top-left, top-right, bottom-left, bottom-right, 5 to 8
// the edges left, right, top, bottom.
export component FrameOverlay inherits Rectangle {
    in property <length> frame-x;
    in property <length> frame-y;
    in property <length> frame-width;
    in property <length> frame-height;
    in property <FrameStyle> look: FrameStyle.crop;
    in property <bool> body-moves: true;
    callback grabbed(int);
    callback dragged(int, length, length);
    callback released();
    property <bool> crop: root.look == FrameStyle.crop;
    property <color> rest: root.crop ? Colour.guide : Colour.unaligned-balance;
    property <color> edge-rest: root.crop ? Colour.handle-idle : Colour.unaligned-balance;
    // Clamped by the frame shown, so corners never cover a small frame's edges and body.
    property <length> corner: min(CropStyle.corner, min(root.frame-width, root.frame-height) / 3);
    property <length> edge: min(CropStyle.edge, max(min(root.frame-width, root.frame-height) - 2 * root.corner, CropStyle.stroke * 4));
    // A grab's reach across its line, the hand's least target, its drawn handle kept slim; never deeper
    // into the frame than a corner, so a small frame's middle third stays the body's.
    property <length> grip: min(DS.control-grab-size, 2 * root.corner);
    property <int> held: -1;
    if root.crop: Rectangle {
        y: 0;
        width: parent.width;
        height: max(0px, root.frame-y);
        background: Colour.scrim;
    }
    if root.crop: Rectangle {
        y: root.frame-y + root.frame-height;
        width: parent.width;
        height: max(0px, parent.height - self.y);
        background: Colour.scrim;
    }
    if root.crop: Rectangle {
        x: 0;
        y: root.frame-y;
        width: max(0px, root.frame-x);
        height: root.frame-height;
        background: Colour.scrim;
    }
    if root.crop: Rectangle {
        x: root.frame-x + root.frame-width;
        y: root.frame-y;
        width: max(0px, parent.width - self.x);
        height: root.frame-height;
        background: Colour.scrim;
    }
    // The thirds: a whole point in the edge bars' rest ink, edged by the contrast shade, so it reads on a
    // shadow as on a sky and stays quieter than the frame; half a point falls between a 1x screen's pixels.
    for i in (root.crop ? 2 : 0): GuideLine {
        vertical: true;
        ink: Colour.handle-idle;
        x: root.frame-x + root.frame-width * (i + 1) / 3 - self.width / 2;
        y: root.frame-y;
        width: self.band;
        height: root.frame-height;
    }
    for i in (root.crop ? 2 : 0): GuideLine {
        ink: Colour.handle-idle;
        x: root.frame-x;
        y: root.frame-y + root.frame-height * (i + 1) / 3 - self.height / 2;
        width: root.frame-width;
        height: self.band;
    }
    Rectangle {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        border-width: body.has-hover || root.held == 0 ? Stroke.hairline + 1px : Stroke.hairline;
        border-color: body.has-hover || root.held == 0 ? Colour.handle-active : root.rest;
    }
    body := Grab {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        enabled: root.body-moves;
        handle: 0;
        mouse-cursor: root.body-moves ? grab : default;
        grabbed(h) => { root.held = h; root.grabbed(h); }
        dragged(h, dx, dy) => { root.dragged(h, dx, dy); }
        released => { root.held = -1; root.released(); }
    }
    // An edge's grab, its slim bar at its middle. The list holds no geometry: one that moved with the
    // frame would rebuild the grabs at every step of a drag and drop the hand's hold.
    for e[i] in [
        { handle: 5, across: true, far: false },
        { handle: 6, across: true, far: true },
        { handle: 7, across: false, far: false },
        { handle: 8, across: false, far: true },
    ]: Rectangle {
        x: e.across ? root.frame-x + (e.far ? root.frame-width : 0px) - root.grip / 2 : root.frame-x + (root.frame-width - root.edge) / 2;
        y: e.across ? root.frame-y + (root.frame-height - root.edge) / 2 : root.frame-y + (e.far ? root.frame-height : 0px) - root.grip / 2;
        width: e.across ? root.grip : root.edge;
        height: e.across ? root.edge : root.grip;
        Rectangle {
            width: e.across ? CropStyle.stroke + CropStyle.halo : parent.width;
            height: e.across ? parent.height : CropStyle.stroke + CropStyle.halo;
            background: grab.has-hover || root.held == e.handle ? Colour.contrast-edge : Colour.contrast-edge-idle;
        }
        Rectangle {
            width: e.across ? CropStyle.stroke : parent.width;
            height: e.across ? parent.height : CropStyle.stroke;
            background: grab.has-hover || root.held == e.handle ? Colour.handle-active : root.edge-rest;
        }
        grab := Grab {
            handle: e.handle;
            mouse-cursor: e.across ? ew-resize : ns-resize;
            grabbed(h) => { root.held = h; root.grabbed(h); }
            dragged(h, dx, dy) => { root.dragged(h, dx, dy); }
            released => { root.held = -1; root.released(); }
        }
    }
    // A corner's grab: its bracket inside the frame, and outside the edges' reach past the line.
    for c[i] in [
        { handle: 1, right: false, bottom: false },
        { handle: 2, right: true, bottom: false },
        { handle: 3, right: false, bottom: true },
        { handle: 4, right: true, bottom: true },
    ]: Rectangle {
        x: c.right ? root.frame-x + root.frame-width - root.corner : root.frame-x - root.grip / 2;
        y: c.bottom ? root.frame-y + root.frame-height - root.corner : root.frame-y - root.grip / 2;
        width: root.corner + root.grip / 2;
        height: root.corner + root.grip / 2;
        Bracket {
            x: c.right ? 0 : root.grip / 2;
            y: c.bottom ? 0 : root.grip / 2;
            width: root.corner;
            height: root.corner;
            right: c.right;
            bottom: c.bottom;
            rest: root.rest;
            active: corner-grab.has-hover || root.held == c.handle;
        }
        corner-grab := Grab {
            handle: c.handle;
            mouse-cursor: (c.right == c.bottom) ? nwse-resize : nesw-resize;
            grabbed(h) => { root.held = h; root.grabbed(h); }
            dragged(h, dx, dy) => { root.dragged(h, dx, dy); }
            released => { root.held = -1; root.released(); }
        }
    }
}

// A De-dust reminder: the dust a patch covers, as the frame shows it unpatched.
export component DustOriginal inherits Rectangle {
    in property <image> source;
    width: CropStyle.dust-original;
    height: CropStyle.dust-original;
    border-radius: CropStyle.well-radius;
    background: Colour.contrast-edge;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
}

// A correction on the canvas, over the box its stroke spans: `Circle()`'s ring at the box's shorter
// side and, off the box's top-right corner, its number.
export component CorrectionMark inherits Rectangle {
    in property <int> number;
    Ring {
        tone: RingTone.sharpen;
        centre-x: parent.width / 2;
        centre-y: parent.height / 2;
        diameter: min(parent.width, parent.height);
    }
    // Half an `xxs` clear of the ring, as Swift's alignment guides set it.
    if root.number > 0: Badge {
        x: parent.width + Space.xxs / 2;
        y: -self.height - Space.xxs / 2;
        text: root.number;
        role: TextRole.label;
    }
}

// Auto De-dust's reading over the picture: the veil the kernel writes where the reading does not reach.
export component DustVeil inherits Rectangle {
    in property <image> source;
    // `Picture.revision`: a notch rewrites the texture behind `source`, which changes no property.
    in property <int> revision;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: root.revision < 0 ? ImageFit.contain : ImageFit.fill;
        image-rendering: pixelated;
    }
}

// `Loupe`: the Details readout, the render at its own ratio in the middle of the canvas's dark, the
// ratio's badge in the corner, which swaps rest for close; rounded as the plots.
export component LoupeBand inherits Rectangle {
    in property <image> source;
    // Bumped when the texture behind `source` is rewritten in place, as `Picture.revision`.
    in property <int> revision;
    in property <length> shown-width;
    in property <length> shown-height;
    in property <string> ratio;
    in property <bool> ratio-shown;
    callback toggled();
    background: Colour.canvas;
    border-radius: PlotStyle.radius;
    clip: true;
    Image {
        x: (parent.width - root.shown-width) / 2;
        y: (parent.height - root.shown-height) / 2;
        width: root.shown-width;
        height: root.shown-height;
        source: root.source;
        // Read so a rewrite in place, which changes no other property, redraws the band.
        image-fit: root.revision < 0 ? ImageFit.contain : ImageFit.fill;
    }
    if root.ratio-shown: Badge {
        x: parent.width - self.width - Space.s;
        y: Space.s;
        text: root.ratio;
        pressable: true;
        clicked => { root.toggled(); }
    }
}
