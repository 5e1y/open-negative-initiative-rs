// The selection controls' gauges: the tab bar, the switch and the medals. The 2.5D lab tunes the
// `in-out` ones live, as it tunes `Depth`.
import { DS } from "tokens.slint";

// `DSTabBar`: a 40 pt hollow, tabs a line apart, one raised pill sliding under the selection.
export global TabsStyle {
    // `DS.Motion.grab`: SwiftUI's spring, response 0.22 s, damping 0.62, as Slint's spring(0.38) over 220 ms.
    in-out property <float> slide-ms: 220;
    out property <duration> slide: TabsStyle.slide-ms * 1ms;
    out property <length> height: DS.control-tab-bar-height;
    out property <length> inset: DS.space-xs;
    out property <length> gap: DS.stroke-line;
    // The room either side of every label: `room` where the bar holds it, never under `margin`; a tab is its
    // label and an equal share of the rest, so the gaps between labels match however long each is.
    out property <length> margin: DS.space-sm;
    out property <length> room: DS.space-sm + DS.space-xs;
    out property <length> mark: DS.space-xs;
    out property <length> mark-inset: DS.space-xxs;
    // An ordered bar's step disc, an icon's size, lighter than both the hollow and the pill it sits on.
    out property <length> step: DS.control-icon-size;
    out property <length> step-gap: DS.space-xs;
    out property <length> step-check: DS.space-sm + DS.space-xs;
    out property <color> step-disc: DS.palette-track;
    out property <length> swatch: DS.control-handle-size;
    // The pill: `DS.Palette.track` (white 15 %) laid on the canvas, opaque so its shadow stays under it.
    in-out property <float> pill-tone: 0.153;
    out property <color> pill: DS.palette-canvas.mix(#ffffff, 1 - TabsStyle.pill-tone);
    // The bar's hollow, lighter at its rim than a plot's.
    in-out property <float> track-shade: 0.14;
    // An unselected tab's label: 5.6:1 on the hollow, AA's 4.5:1 with a margin.
    in-out property <float> idle: 0.62;
}

// The switch, a slide lever: the slider's knob travels one of `DSToggle`'s cells along a slot whose
// gauge is its own, so a slider's rail made thinner never makes a switch read as one.
export global ToggleStyle {
    out property <length> travel: DS.control-toggle-cell-width;
    out property <length> slot: DS.control-track-height;
    // The stretch the knob uncovers while on, in a lit lamp's phosphor.
    out property <color> lit: DS.palette-lcd-ink;
}

// `DSMedal`: a foil disc, its podium place struck at `figure` of its side; `press` is the scale a pressed one shrinks to.
export global MedalStyle {
    // An icon's size on a tile, in the filter and in the status bar: its figure reads, inside the bar's row.
    out property <length> size: DS.control-icon-size;
    out property <float> figure: 0.6;
    in-out property <float> press: DS.control-medal-press;
    // DSFoil's spun lobes lighting the grain along the lamp's radius, over the flat face's 0.70.
    in-out property <float> foil-spin: 0.7;
    // `DSFoil.Metal.ramp`: deep, body and bright, by podium place: none, gold, silver, bronze.
    out property <[color]> deeps: [#000000, rgb(92, 56, 13), rgb(61, 64, 69), rgb(69, 31, 10)];
    out property <[color]> bodies: [#000000, rgb(219, 166, 64), rgb(179, 184, 191), rgb(179, 102, 48)];
    out property <[color]> brights: [#000000, rgb(255, 230, 153), rgb(247, 250, 255), rgb(255, 194, 133)];
    // What is struck, the ruled ring and the place, in DSFoil's ink: opaque, so a figure holds 3:1 on bronze.
    out property <color> struck: #1a1206;
    // `DSMedal`'s two shadows (0.5 at 0.5 pt, 0.25 at 1.5 pt).
    out property <color> near-shadow: #00000080;
    out property <color> far-shadow: #00000040;
    out property <length> near-blur: 0.5px;
    out property <length> far-blur: 1.5px;
    out property <length> far-y: 1px;
}
