// The selection controls' gauges: the tab bar, the switch, the picker's field and the medals. The
// 2.5D lab tunes the `in-out` ones live, as it tunes `Depth`.
import { DS } from "tokens.slint";

// `DSTabBar`: a 40 pt hollow, tabs a line apart, one raised pill sliding under the selection.
export global TabsStyle {
    // `DS.Motion.grab`: SwiftUI's spring, response 0.22 s, damping 0.62, as Slint's spring(0.38) over 220 ms.
    in-out property <float> slide-ms: 220;
    out property <duration> slide: TabsStyle.slide-ms * 1ms;
    out property <length> height: DS.control-tab-bar-height;
    out property <length> inset: DS.space-xs;
    out property <length> gap: DS.stroke-line;
    // Room kept on each side of a label: a long one takes it from its neighbours rather than touching them.
    out property <length> margin: DS.space-sm;
    // Every tab asks for the whole bar, as SwiftUI's `maxWidth: .infinity`, so the bar shares out evenly while all fit.
    out property <length> reach: 100000px;
    out property <length> mark: DS.space-xs;
    out property <length> mark-inset: DS.space-xxs;
    out property <length> swatch: DS.control-handle-size;
    // The pill: `DS.Palette.track` (white 15 %) laid on the canvas, opaque so its shadow stays under it.
    in-out property <float> pill-tone: 0.153;
    out property <color> pill: DS.palette-canvas.mix(#ffffff, 1 - TabsStyle.pill-tone);
    // The bar's hollow, lighter at its rim than a field's.
    in-out property <float> track-shade: 0.14;
    // `DS.State.idleLabel`: an unselected tab's label, a dimmed tab, a medal not chosen.
    in-out property <float> idle: DS.state-idle-label;
}

// `DSToggle`: a 20 pt hollow holding a cross and a check, a white pill on the state that holds.
export global ToggleStyle {
    out property <length> height: DS.control-toggle-height;
    out property <length> cell: DS.control-toggle-cell-width;
    out property <length> inset: DS.space-xxs;
    out property <length> width: 2 * ToggleStyle.cell + 2 * ToggleStyle.inset;
    out property <length> glyph: DS.control-toggle-glyph;
    out property <length> glyph-stroke: DS.stroke-emphasis;
    out property <color> thumb: DS.palette-selected;
    out property <color> glyph-lit: DS.palette-canvas;
    out property <color> glyph-idle: DS.palette-text-secondary;
}

// `DSPicker`'s field face: the value in a hollow, a chevron at its end.
export global PickerStyle {
    out property <length> radius: DS.radius-card;
    out property <length> padding: DS.space-md;
}

// `DSMedal`: a flat disc; `press` is the scale a pressed one shrinks to.
export global MedalStyle {
    out property <length> size: DS.control-medal-size;
    in-out property <float> press: DS.control-medal-press;
}
