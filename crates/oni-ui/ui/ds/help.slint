// The Help menu's pieces: the gold seal a heading carries while its note is news, a text area for
// a written message, the console's monospaced log, and the notices' bullets and step numbers.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, FieldStyle } from "theme.slint";
import { Tips, Tones, Tone, Label } from "base.slint";

// `DSGoldSealView`: the word in capitals on the medal's gold; hovered, the note shows and is read.
export component NewsSeal inherits Rectangle {
    in property <string> word;
    in property <string> note;
    callback read();
    height: DS.control-seal-height * 1px;
    width: label.preferred-width + 2 * DS.control-seal-padding * 1px;
    border-radius: self.height / 2;
    background: Colour.medal[3];
    label := Text {
        text: root.word;
        font-family: Type.family;
        font-size: DS.typo-seal-size;
        font-weight: Type.strong;
        letter-spacing: DS.control-seal-tracking * 1px;
        color: Colour.ink-on-light;
    }
    TouchArea {
        changed has-hover => {
            Tips.hover(self.has-hover, root.note, root.absolute-position.x, root.absolute-position.y + root.height);
            if (self.has-hover) { root.read(); }
        }
    }
}

// `TextEditor` in `dsTextField(multiline:)`: several lines, wrapped, the edge lit while it is typed in.
export component TextArea inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <length> lines-height: DS.control-report-message-height;
    // The focus's edge without the focus, as `TextField.focused-look`.
    in property <bool> focused-look;
    callback edited(string);
    // The focus leaving the box, which a typed text commits on.
    callback left(string);
    public function take-focus() { input.focus(); }
    height: root.lines-height;
    border-radius: FieldStyle.radius;
    background: Colour.canvas;
    border-width: input.has-focus || root.focused-look ? Stroke.line : Stroke.hairline;
    border-color: input.has-focus || root.focused-look ? Colour.focus : Colour.separator;
    clip: true;
    input := TextInput {
        x: FieldStyle.padding;
        y: FieldStyle.padding;
        width: parent.width - 2 * FieldStyle.padding;
        height: parent.height - 2 * FieldStyle.padding;
        single-line: false;
        wrap: word-wrap;
        font-family: Type.family;
        font-size: Type.label;
        color: Colour.ink;
        edited => { root.edited(self.text); }
        changed has-focus => { if (!self.has-focus) { root.left(self.text); } }
    }
}

// The console's log: monospaced so aligned figures stay in column, selectable, on the panel's ground.
export component LogText inherits Rectangle {
    in property <string> text;
    background: Colour.ground;
    border-radius: Radius.card;
    TextInput {
        x: Space.s;
        y: Space.s;
        width: parent.width - 2 * Space.s;
        text: root.text;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        font-family: "Menlo";
        font-size: Type.chip;
        color: Colour.ink-secondary;
    }
}

// `notice(_:)`'s line: a small dot level with the first line, the text wrapping beside it.
export component BulletLine inherits HorizontalLayout {
    in property <string> text;
    spacing: Space.s;
    Rectangle {
        width: Space.xs;
        Rectangle {
            y: Space.xs + Space.xxs;
            width: Space.xs;
            height: Space.xs;
            border-radius: self.width / 2;
            background: Tones.ink(Tone.primary);
        }
    }
    Label { text: root.text; wrap: word-wrap; horizontal-stretch: 1; }
}

// `RootsCatchUp`'s step number: the digit on a keycap-grey disc.
export component StepNumber inherits Rectangle {
    in property <int> number;
    width: DS.control-keycap-mini-height;
    height: self.width;
    border-radius: self.width / 2;
    background: Colour.raised;
    Label { text: root.number; centred: true; }
}
