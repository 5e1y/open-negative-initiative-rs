// A combobox: a field typed as any, whose list of the gear ONI knows drops under it once it is clicked into,
// or from the chevron at its end: the Kit's pieces as their cards, the names typed before, then a line that
// opens The Lens DB's search.
import { Space, FieldStyle } from "theme.slint";
import { Icons } from "icons.slint";
import { Divider, Icon, Tips } from "base.slint";
import { FieldFace, Entry } from "fields.slint";
import { FormStyle } from "forms.slint";
import { Outside } from "outside.slint";
import { MenuEntry, PopupPanel, PopupKind } from "menu.slint";
import { GearCard, GearCardBody, PickedGround } from "gear_card.slint";
import { Label } from "base.slint";
import { TldbDisc } from "tldb.slint";

export component KnownField inherits HorizontalLayout {
    in property <string> name;
    in property <string> value;
    in-out property <string> text <=> entry.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <[GearCard]> cards;
    in property <[string]> known;
    in property <string> known-help;
    // The list's one line while no name is known, and the words under it.
    in property <string> none-known;
    in property <string> none-known-note;
    callback edited(string);
    callback accepted(string);
    callback left(string);
    callback picked(string);
    // The list's last line, which opens the search over the window; its list closes for it and drops again,
    // with what the search added, once `searching` ends.
    // The words name a piece The Lens DB gives: its disc stands before them in the field, as in the list.
    in property <bool> served;
    in property <string> search-line;
    in property <bool> searching;
    callback search();
    property <bool> asked;
    changed searching => {
        if (!root.searching && root.asked) {
            root.asked = false;
            root.drop();
        }
    }
    init => { if (root.value != "") { entry.text = root.value; } }
    changed value => { entry.text = root.value; }
    // A Slint popup takes the keyboard as it opens (`WindowInner::show_popup`): the field takes it back, so
    // the words are still typed in the field while the list stands under it.
    function drop() {
        if (list.is-open) { return; }
        list.show();
        entry.take-focus();
    }
    // The search asked before the list closes: closing it ends the line's own handler.
    function open-search() {
        root.asked = true;
        root.search();
        list.close();
    }
    // A name picked, or typed and given by Return, ends the typing: the list closes, the keyboard goes back.
    function pick(name: string) {
        entry.text = name;
        root.picked(name);
        list.close();
        Outside.released += 1;
    }
    FieldFace {
        horizontal-stretch: 1;
        height: FieldStyle.height;
        lit: entry.editing;
        // The face's padding enters the field as its words do.
        rim := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            pointer-event(event) => {
                if (!entry.editing && event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { entry.enter(); }
            }
        }
        HorizontalLayout {
            padding-left: FieldStyle.across;
            padding-right: FieldStyle.across;
            spacing: Space.xs;
            if root.served: VerticalLayout { alignment: center; TldbDisc { } }
            entry := Entry {
                name: root.name;
                placeholder: root.placeholder;
                enabled: root.enabled;
                // The press that dropped the list is the field's own; one beside it closes the list first.
                rim: rim.has-hover || chevron.has-hover || list.is-open;
                changed editing => { if (self.editing) { root.drop(); } }
                // Typing drops the list again where Escape closed it.
                edited(t) => { root.drop(); root.edited(t); }
                accepted(t) => {
                    list.close();
                    Outside.released += 1;
                    root.accepted(t);
                }
                left(t) => { if (!list.is-open) { root.left(t); } }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: FormStyle.chip-icon;
                    height: self.width;
                    Icon { width: parent.width; height: parent.height; source: Icons.chevron-down; }
                    chevron := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { root.drop(); }
                        changed has-hover => { Tips.hover(self.has-hover, root.known-help, self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                }
            }
        }
    }
    list := PopupPanel {
        kind: PopupKind.menu;
        x: 0;
        y: root.height + Space.xxs;
        span: root.width;
        VerticalLayout {
            spacing: Space.xxs;
            for card in root.cards: Rectangle {
                height: body.preferred-height;
                accessible-role: button;
                accessible-label: card.name;
                accessible-action-default => { root.pick(card.name); }
                touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(card.name); } }
                PickedGround { hovered: touch.has-hover; picked: card.name == entry.text; }
                body := GearCardBody {
                    padding-top: Space.xs;
                    padding-bottom: Space.xs;
                    padding-left: Space.s;
                    padding-right: Space.s;
                    card: card;
                    served: true;
                }
            }
            if root.cards.length > 0 && root.known.length > 0: Divider { }
            for name in root.known: MenuEntry { text: name; checked: name == entry.text; activated => { root.pick(name); } }
            if root.cards.length == 0 && root.known.length == 0: MenuEntry { text: root.none-known; note: root.none-known-note; enabled: false; }
            if root.search-line != "": Divider { }
            if root.search-line != "": Rectangle {
                height: line.preferred-height;
                accessible-role: button;
                accessible-label: root.search-line;
                accessible-action-default => { root.open-search(); }
                lit := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-search(); }
                }
                PickedGround { hovered: lit.has-hover; }
                line := HorizontalLayout {
                    padding-top: Space.xs;
                    padding-bottom: Space.xs;
                    padding-left: Space.s;
                    padding-right: Space.s;
                    spacing: Space.xs;
                    VerticalLayout { alignment: center; TldbDisc { } }
                    Label { text: root.search-line; horizontal-stretch: 1; }
                }
            }
        }
    }
}
