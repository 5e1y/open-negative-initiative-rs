// A field typed as any, or filled from the gear ONI knows by its key, which drops their list under it: the Kit's
// pieces as their cards, then the names typed before; a name picked shows in the field and is told as picked.
// With none known, the list says how one comes.
import { Space } from "theme.slint";
import { Icons } from "icons.slint";
import { Divider } from "base.slint";
import { Button, ButtonSize, TextField } from "controls.slint";
import { MenuEntry, PopupPanel, PopupKind } from "menu.slint";
import { GearCard, GearCardBody, PickedGround } from "gear_card.slint";

export component KnownField inherits HorizontalLayout {
    in property <string> name;
    in property <string> value;
    in-out property <string> text <=> field.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <[GearCard]> cards;
    in property <[string]> known;
    in property <string> known-help;
    // The list's one line while no name is known, and the words under it.
    in property <string> none-known;
    in property <string> none-known-note;
    callback edited(string);
    callback accepted(string);
    callback left(string);
    callback picked(string);
    spacing: Space.xs;
    function pick(name: string) {
        field.text = name;
        root.picked(name);
        list.close();
    }
    field := TextField {
        horizontal-stretch: 1;
        name: root.name;
        value: root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        edited(t) => { root.edited(t); }
        accepted(t) => { root.accepted(t); }
        left(t) => { root.left(t); }
    }
    VerticalLayout {
        alignment: center;
        Button { has-icon: true; square: true;
            size: ButtonSize.mini;
            icon: Icons.chevron-down;
            help: root.known-help;
            enabled: root.enabled;
            clicked => { list.show(); }
        }
    }
    list := PopupPanel {
        kind: PopupKind.menu;
        x: 0;
        y: root.height + Space.xxs;
        span: root.width;
        VerticalLayout {
            spacing: Space.xxs;
            for card in root.cards: Rectangle {
                height: body.preferred-height;
                accessible-role: button;
                accessible-label: card.name;
                accessible-action-default => { root.pick(card.name); }
                touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(card.name); } }
                PickedGround { hovered: touch.has-hover; picked: card.name == field.text; }
                body := GearCardBody {
                    padding-top: Space.xs;
                    padding-bottom: Space.xs;
                    padding-left: Space.s;
                    padding-right: Space.s;
                    card: card;
                }
            }
            if root.cards.length > 0 && root.known.length > 0: Divider { }
            for name in root.known: MenuEntry { text: name; checked: name == field.text; activated => { root.pick(name); } }
            if root.cards.length == 0 && root.known.length == 0: MenuEntry { text: root.none-known; note: root.none-known-note; enabled: false; }
        }
    }
}
