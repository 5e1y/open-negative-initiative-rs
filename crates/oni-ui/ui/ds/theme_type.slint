// The type scale: every word on screen takes one of its six steps, each a clear step from the next,
// so a block's title outranks the words under it and a value never outsizes its title.
import { DS } from "tokens.slint";

export global Type {
    out property <string> family: DS.typo-label-family;
    out property <int> regular: DS.typo-label-weight;
    out property <int> medium: 500;
    out property <int> strong: 600;
    out property <int> bold: 700;
    // A seal's stamp and a mini key's legend, in capitals.
    out property <length> micro: DS.typo-seal-size;
    // A caption, a value beside its label, a key's legend, a tooltip.
    out property <length> caption: DS.typo-chip-size;
    // The words read: a label, what a field holds, a note.
    out property <length> label: DS.typo-label-size;
    // A block's title, set semibold: a size and a weight over the labels under it.
    out property <length> section: 15px;
    out property <length> title: DS.typo-title-size;
    out property <length> heading: DS.typo-heading-size;
    // A note's lines, opened from Inter's natural 1.21 em to about 1.4 em, so a paragraph reads.
    out property <float> leading: 1.15;
}
