// `DSRail`, the recessed track a slider's, a level's and the toggle's knob runs on, and its fills.
import { Colour, Stroke, SliderStyle } from "theme.slint";
import { Depth, Inward } from "depth.slint";

// `level` and `ramp` light the rail up to the value and `metal` in brushed silver; `bipolar` is a
// gradient from `low` to `high`; `none` leaves it bare, as under the levels' handles.
export enum SliderFill { level, ramp, bipolar, metal, none }

// `DSRail` in `dsRecessed`: the ground, the lit stretch from `from` to `at` (fractions of the travel),
// then `Inward`'s shade, edge and lit lip; run past the travel by `overhang` at both ends.
export component Rail inherits Rectangle {
    in property <SliderFill> fill: SliderFill.none;
    in property <float> at;
    in property <float> from;
    in property <color> tint: SliderStyle.lit;
    in property <color> low;
    in property <color> high;
    in property <length> overhang;
    // The value a reset brings back, ticked across the rail; none below 0.
    in property <float> rest: -1;
    // The share of the travel past what the value can reach, veiled toward the panel and closed by a tick.
    in property <float> beyond;
    // Levels laid evenly along the rail, each ticked shorter than rest's; none below 2.
    in property <int> notches;
    // The lit stretch's glow, a progress bar's phosphor.
    in property <length> glow;
    // Under the hand, the hollow sinks to a well's whole shade, as the knob's edge darkens.
    in property <bool> deep;
    // Under the hand, dragged or stepped, a bipolar rail of hues shows them whole; else a faint hue at each
    // end over the bare ground, so a panel of them stays neutral beside the photo. A grey one stays whole.
    in property <bool> vivid;
    property <bool> hued: root.fill == SliderFill.bipolar && max(root.low.to-hsv().saturation, root.high.to-hsv().saturation) > SliderStyle.hued;
    property <float> hue: root.vivid ? 1 : 0;
    animate hue { duration: SliderStyle.rise; easing: ease-out; }
    property <float> ends: SliderStyle.hue-rest + (1 - SliderStyle.hue-rest) * root.hue;
    // A ramp lit in a hue rests as faint as a bipolar rail's ends, whole under the hand; a grey one stays whole.
    property <float> lift: root.fill == SliderFill.ramp && root.tint.to-hsv().saturation > SliderStyle.hued ? root.ends : 1;
    property <float> shade: Depth.well-shade * (root.deep ? 1 : SliderStyle.idle-relief);
    animate shade { duration: SliderStyle.rise; easing: ease-out; }
    // The gradient from `low` to `high` at its stops, its middle as clear as `hue` leaves it.
    property <float> near: SliderStyle.hue-reach;
    property <float> far: 1 - SliderStyle.hue-reach;
    pure function hues(angle: angle) -> brush {
        @linear-gradient(angle,
            root.low.with-alpha(root.ends) 0%,
            root.low.mix(root.high, root.far).with-alpha(root.hue) root.near,
            root.low.mix(root.high, root.near).with-alpha(root.hue) root.far,
            root.high.with-alpha(root.ends) 100%)
    }
    property <length> travel: self.width - 2 * root.overhang;
    property <length> lit: root.overhang + root.at * root.travel;
    property <length> start: root.from > 0 ? root.overhang + root.from * root.travel : 0;
    height: SliderStyle.track;
    Rectangle {
        border-radius: SliderStyle.track-radius;
        background: root.fill != SliderFill.bipolar || root.hued ? SliderStyle.ground : @linear-gradient(90deg, root.low 0%, root.high 100%);
    }
    if root.hued: Rectangle {
        border-radius: SliderStyle.track-radius;
        background: root.hues(90deg);
    }
    // Its own round, no clip: a clipping rail renders each slider apart.
    if root.fill != SliderFill.bipolar && root.fill != SliderFill.none: Rectangle {
        x: root.start;
        y: 0;
        width: root.lit - root.start;
        height: parent.height;
        border-radius: SliderStyle.track-radius;
        background: root.fill == SliderFill.metal
            ? @linear-gradient(180deg, Colour.metal-dark 0%, Colour.metal-light 33.33%, Colour.metal-light 66.67%, Colour.metal-dark 100%)
            : root.fill == SliderFill.ramp
            ? @linear-gradient(90deg, root.tint.with-alpha(SliderStyle.ramp-start * root.lift) 0%, root.tint.with-alpha(SliderStyle.ramp-end * root.lift) 100%)
            : root.tint;
        drop-shadow-color: root.glow > 0 ? root.tint : transparent;
        drop-shadow-blur: root.glow;
    }
    Inward {
        ground: transparent;
        radius: SliderStyle.track-radius;
        shade: root.shade;
    }
    if root.beyond > 0: Rectangle {
        x: root.overhang + (1 - root.beyond) * root.travel;
        y: 0;
        width: root.width - self.x;
        height: parent.height;
        border-radius: SliderStyle.track-radius;
        background: SliderStyle.beyond;
    }
    if root.beyond > 0: Rectangle {
        x: root.overhang + (1 - root.beyond) * root.travel - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: Stroke.line;
        height: SliderStyle.notch-height;
        background: SliderStyle.rest-ink;
    }
    for i in root.notches > 1 ? root.notches : 0: Rectangle {
        x: root.overhang + i / (root.notches - 1) * root.travel - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: Stroke.line;
        height: SliderStyle.notch-height;
        background: SliderStyle.notch-ink;
    }
    if root.rest >= 0: Rectangle {
        x: root.overhang + root.rest * root.travel - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: Stroke.line;
        height: SliderStyle.knob-height / 2;
        background: SliderStyle.rest-ink;
    }
}
