// The year on film's parts: what a scene is made of, the measures every piece shares, a photo laid as a
// print, the display and text faces, a summary's line, the film's perforations and the brand's band.
import { DS } from "tokens.slint";
import { Colour, Motion } from "theme.slint";
import { Type } from "theme_type.slint";
import { Icons } from "icons.slint";

export enum WrappedKind { title, hero, print, mosaic, palette, summary }

export struct WrappedLine {
    label: string,
    value: string,
}

export struct WrappedSwatch {
    ink: color,
    share: float,
}

export struct WrappedScene {
    kind: WrappedKind,
    eyebrow: string,
    figure: string,
    // Above zero, the figure is this number counted up as the scene shows, `unit` after it.
    count: int,
    unit: string,
    // The figure's size, in the frame's units.
    size: float,
    headline: string,
    note: string,
    photos: [image],
    // The scene's first photo brought down to a few pixels and blurred: the light it is told in.
    backdrop: image,
    // An ink in that photo's own hue; clear while it is not read, or for a photo with no colour.
    accent: color,
    lines: [WrappedLine],
    swatches: [WrappedSwatch],
}

export global WrappedStyle {
    // `Color.black`, the ground the year is told on, whatever the theme.
    out property <color> ground: Colour.black;
    out property <color> ink: Colour.white;
    out property <color> ink-soft: Colour.white.with-alpha(0.95);
    // The edge of a print.
    out property <color> paper: #f4f1ea;
    // The display face, for every figure, headline and label; the text face for a line read at length.
    out property <string> display-family: Type.display;
    out property <int> display-weight: Type.display-weight;
    out property <string> text-family: Type.family;
    out property <int> text-weight: Type.medium;
    // Capitals set solid: the display face's stand 0.714 em tall.
    out property <float> leading: 0.9;
    // A frame is 360 by 640 units, 9 by 16 as a phone's story takes it.
    out property <float> frame-width: 360;
    out property <float> frame-height: 640;
    // The film between two frames, and the frames' pitch along the strip.
    out property <float> frame-line: 8;
    out property <float> pitch: root.frame-height + root.frame-line;
    // A story's players cover its top and bottom 14 %: a scene and the brand lie between these two.
    out property <float> safe-top: 100;
    out property <float> safe-bottom: 512;
    // The room between a scene's parts: eyebrow, photos, words and the brand's band.
    out property <float> gap: 14;
    // A photo filling its frame is veiled under the words laid on it: from this far above them, this
    // much once this far under their top, where the figure begins, and this much at the frame's foot.
    out property <float> fade: 70;
    out property <float> veiled: 22;
    out property <float> veil: 0.78;
    out property <float> veil-foot: 0.9;
    // Where a print begins, under what a story's player lays over a frame's top.
    out property <float> room-top: 62;
    // The film's edge, each side, outside its image: 5.5 mm of a 135 film, (35 - 24) / 2, which sets the
    // scale of its Kodak Standard perforations. A millimetre of it, in the frame's units.
    out property <float> band: 30;
    out property <float> mm: root.band / 5.5;
    // A perforation: 2.794 mm across the film by 1.981 mm along it, corners of 0.5 mm, one every 4.75 mm,
    // 2 mm in from the film's edge.
    out property <float> hole-across: 2.794 * root.mm;
    out property <float> hole-along: 1.981 * root.mm;
    out property <float> hole-corner: 0.5 * root.mm;
    out property <float> hole-pitch: 4.75 * root.mm;
    out property <float> hole-margin: 2 * root.mm;
    // The perforations a frame shows, the one its foot cuts included.
    out property <int> holes: Math.ceil(root.frame-height / root.hole-pitch) + 1;
    // A perforation's rim, which lets it be read on a dark photo as on a light one.
    out property <float> hole-rim: 0.6;
    out property <color> hole-edge: Colour.white.with-alpha(0.28);
    // A scene's margin each side, clear of the perforations, and the width it leaves.
    out property <float> pad: 34;
    out property <float> inner: root.frame-width - 2 * root.pad;
    out property <float> brand-height: 34;
    out property <float> foot: root.safe-bottom - root.brand-height;
    // How bright the backdrop's light is behind a scene, and on the window around the strip.
    out property <float> glow: 0.62;
    out property <float> ambient: 0.34;
    // The frames beside the one in the gate, dimmed.
    out property <float> beside: 0.4;
    // The film pulled to the next frame: fast, then a hard stop.
    out property <duration> advance: Motion.reduced ? 0ms : 320ms;
    // A scene tells itself over this long once in the gate, then holds until the film is pulled.
    out property <duration> tell: Motion.reduced ? 0ms : 1500ms;
    // A photo developed after its scene was laid comes out of its flash over this long.
    out property <duration> expose: Motion.reduced ? 0ms : 500ms;
    // The film's run through the gate while a year is read, in the frame's units a millisecond.
    out property <float> run: Motion.reduced ? 0 : 0.12;
    out property <duration> hold: 6s;
    out property <duration> tick: 50ms;
    out property <duration> enter: Motion.reduced ? 0ms : 400ms;
    // One frame at 60 Hz: a value set as the view is laid would not animate.
    out property <duration> frame-time: 16ms;
    // The strip shows this much of the frames before and after the one in the gate.
    out property <length> peek: 22px;
    out property <length> progress-height: 3px;
    out property <length> progress-gap: 4px;
    out property <color> progress-idle: Colour.white.with-alpha(0.3);
    out property <color> progress-done: Colour.white;
    // The share screen's cards: the room its words and keys take, and the gap between two cards.
    out property <length> share-words: 150px;
    out property <length> share-keys: 96px;
    out property <float> share-gap: 28;
    out property <color> share-ring: Colour.white;
    out property <length> share-heading: 34px;
    // How far a part has come in: `told` runs 0 to 1 as a scene tells itself, the part over `from` to `to` of it.
    public pure function rise(told: float, from: float, to: float) -> float {
        1 - Math.pow(1 - clamp((told - from) / (to - from), 0, 1), 3)
    }
    // A part that lands with a blow: past its place, then back.
    public pure function slam(told: float, from: float, to: float) -> float {
        1 + 0.45 * Math.pow(1 - clamp((told - from) / (to - from), 0, 1), 3)
    }
}

// Words in the display face, capitals set solid.
export component Display inherits Text {
    in property <length> u;
    in property <float> size: 24;
    font-family: WrappedStyle.display-family;
    font-weight: WrappedStyle.display-weight;
    font-size: root.size * root.u;
    line-height-factor: WrappedStyle.leading;
    color: WrappedStyle.ink;
    wrap: word-wrap;
}

// A line read at length, in the text face.
export component Words inherits Text {
    in property <length> u;
    in property <float> size: 18;
    font-family: WrappedStyle.text-family;
    font-weight: WrappedStyle.text-weight;
    font-size: root.size * root.u;
    color: WrappedStyle.ink-soft;
    wrap: word-wrap;
}

// A photo laid as a print: a thin paper edge, a tilt, its shadow on the film; `drift` moves the eye
// slowly into it while its scene holds. One whose photo is not read yet is not laid.
export component Print inherits Rectangle {
    in property <image> source;
    in property <length> u;
    in property <angle> tilt;
    in property <float> shown: 1;
    in property <float> drift;
    // The whole photo inside its box, or the box filled.
    in property <bool> whole;
    background: WrappedStyle.paper;
    opacity: root.source.width > 0 ? root.shown : 0;
    transform-rotation: root.tilt;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    drop-shadow-color: Colour.black.with-alpha(0.6);
    drop-shadow-blur: 18 * root.u;
    drop-shadow-offset-y: 8 * root.u;
    Rectangle {
        x: 2.5 * root.u;
        y: 2.5 * root.u;
        width: parent.width - 5 * root.u;
        height: parent.height - 5 * root.u;
        clip: true;
        background: WrappedStyle.ground;
        Image {
            width: parent.width * (1 + 0.06 * root.drift);
            height: parent.height * (1 + 0.06 * root.drift);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.source;
            image-fit: root.whole ? contain : cover;
        }
        @children
    }
}

// The film's perforations down one side of a frame, punched through the photo that fills it: they run
// on from frame to frame, `along` being how far down the strip the frame begins.
export component Perforations inherits Rectangle {
    in property <length> u;
    in property <float> along;
    // The film's right edge: the perforations lie toward it.
    in property <bool> right;
    width: WrappedStyle.band * root.u;
    clip: true;
    property <length> pitch: WrappedStyle.hole-pitch * root.u;
    property <length> begun: Math.mod(root.along, WrappedStyle.hole-pitch) * root.u;
    for hole in WrappedStyle.holes: Rectangle {
        x: root.right ? root.width - self.width - WrappedStyle.hole-margin * root.u : WrappedStyle.hole-margin * root.u;
        y: (hole + 0.5) * root.pitch - root.begun - self.height / 2;
        width: WrappedStyle.hole-across * root.u;
        height: WrappedStyle.hole-along * root.u;
        border-radius: WrappedStyle.hole-corner * root.u;
        border-width: WrappedStyle.hole-rim * root.u;
        border-color: WrappedStyle.hole-edge;
        background: WrappedStyle.ground;
    }
}

// Who made the picture, at a frame's foot: ONI's mark, and what to tag when it is posted.
export component Brand inherits Rectangle {
    in property <length> u;
    in property <string> hashtag;
    in property <string> account;
    in property <color> accent: WrappedStyle.ink;
    height: WrappedStyle.brand-height * root.u;
    // The app's name beside its mark, as the app writes it.
    in property <string> name;
    // The mark alone, drawn at the size it is laid: never the whole logo's picture cut and stretched.
    Image {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 30 * root.u;
        width: self.height;
        source: Icons.oni-mark;
        colorize: WrappedStyle.ink;
        image-fit: contain;
    }
    Display {
        u: root.u;
        size: 21;
        x: 35 * root.u;
        y: 0;
        height: parent.height;
        text: root.name;
        vertical-alignment: center;
        wrap: no-wrap;
    }
    Display {
        u: root.u;
        size: 12.5;
        x: 0;
        y: 2 * root.u;
        width: parent.width;
        text: root.hashtag;
        color: root.accent;
        horizontal-alignment: right;
        wrap: no-wrap;
    }
    Words {
        u: root.u;
        size: 11.5;
        x: 0;
        y: 19 * root.u;
        width: parent.width;
        text: root.account;
        color: WrappedStyle.ink;
        horizontal-alignment: right;
        wrap: no-wrap;
    }
}

// A summary's line, set as a poster's: its value in the year's ink, then what it counts.
export component LineRow inherits Rectangle {
    in property <WrappedLine> line;
    in property <length> u;
    in property <float> shown: 1;
    // The value's ink.
    in property <color> accent: WrappedStyle.ink;
    height: 23 * root.u;
    opacity: root.shown;
    property <length> between: 7 * root.u;
    // The line measured at its size: one wider than its room is set that much smaller.
    value := Display { visible: false; width: 0; u: root.u; size: 17; text: root.line.value; wrap: no-wrap; }
    label := Display { visible: false; width: 0; u: root.u; size: 17; text: root.line.label; wrap: no-wrap; }
    property <float> size: 17 * min(1, (root.width - root.between) / max(1px, value.preferred-width + label.preferred-width));
    HorizontalLayout {
        alignment: start;
        spacing: root.between;
        Display {
            u: root.u;
            size: root.size;
            text: root.line.value;
            color: root.accent;
            vertical-alignment: center;
            wrap: no-wrap;
        }
        Display {
            u: root.u;
            size: root.size;
            text: root.line.label;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}
