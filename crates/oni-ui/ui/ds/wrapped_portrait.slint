// The year on film's scenes that draw a portrait: its colours, its character, its summary and its farewell.
import { DS } from "tokens.slint";
import { Colour, Type } from "theme.slint";
import { Badge, BadgeTone } from "badge.slint";
import { WrappedKind, WrappedScene, WrappedStyle, Print, Words, Figure, LineRow } from "wrapped_parts.slint";

// The year's colours as bands, each as wide as its share.
export component PaletteScene inherits Rectangle {
    in property <WrappedScene> scene;
    // The frame's unit: its width over 360.
    in property <length> u;
    in property <float> told: 1;
    property <length> pad: WrappedStyle.pad * root.u;
    property <length> inner: WrappedStyle.inner * root.u;
    property <length> foot: WrappedStyle.foot * root.u;
    property <bool> has-photo: root.scene.photos.length > 0;
    pure function rise(from: float, to: float) -> float {
        WrappedStyle.rise(root.told, from, to)
    }
    property <length> band-height: 190 * root.u;
    Rectangle {
        x: root.pad;
        y: 52 * root.u;
        width: root.inner;
        height: root.band-height;
        border-radius: 4 * root.u;
        clip: true;
        HorizontalLayout {
            for swatch[i] in root.scene.swatches: Rectangle {
                horizontal-stretch: swatch.share;
                min-width: 6 * root.u;
                Rectangle {
                    y: parent.height * (1 - root.rise(0.05 + i * 0.1, 0.5 + i * 0.1));
                    height: parent.height;
                    background: swatch.ink;
                }
            }
        }
    }
    VerticalLayout {
        x: root.pad;
        y: 262 * root.u;
        width: root.inner;
        height: self.preferred-height;
        spacing: 10 * root.u;
        Figure {
            u: root.u;
            size: 32;
            text: root.scene.figure;
            shown: root.rise(0.4, 0.8);
        }
        Words {
            u: root.u;
            size: 12;
            text: root.scene.caption;
            color: Colour.ink-secondary;
            shown: root.rise(0.6, 1);
        }
    }
}

// The character: its name in gold, the line that draws it, and its reason.
export component PersonaScene inherits Rectangle {
    in property <WrappedScene> scene;
    // The frame's unit: its width over 360.
    in property <length> u;
    in property <float> told: 1;
    property <length> pad: WrappedStyle.pad * root.u;
    property <length> inner: WrappedStyle.inner * root.u;
    property <length> foot: WrappedStyle.foot * root.u;
    property <bool> has-photo: root.scene.photos.length > 0;
    pure function rise(from: float, to: float) -> float {
        WrappedStyle.rise(root.told, from, to)
    }
    VerticalLayout {
        x: root.pad;
        y: 66 * root.u + (1 - root.rise(0.15, 0.7)) * 18 * root.u;
        width: root.inner;
        height: self.preferred-height;
        spacing: 10 * root.u;
        Figure {
            u: root.u;
            size: 42;
            color: WrappedStyle.gold;
            text: root.scene.figure;
            shown: root.rise(0.15, 0.6);
        }
        Words {
            u: root.u;
            size: 16;
            text: root.scene.caption;
            shown: root.rise(0.4, 0.8);
        }
        Rectangle { height: 6 * root.u; }
        Words {
            u: root.u;
            size: 12;
            text: root.scene.note;
            color: Colour.ink-secondary;
            shown: root.rise(0.55, 0.95);
        }
        for line[i] in root.scene.lines: Words {
            u: root.u;
            size: 12;
            text: @tr("with a touch of {}", line.label);
            color: Colour.ink-secondary;
            shown: root.rise(0.7, 1);
        }
    }
}

// The year on one frame: its prints, its character, its lines and its colours.
export component SummaryScene inherits Rectangle {
    in property <WrappedScene> scene;
    // The frame's unit: its width over 360.
    in property <length> u;
    in property <float> told: 1;
    property <length> pad: WrappedStyle.pad * root.u;
    property <length> inner: WrappedStyle.inner * root.u;
    property <length> foot: WrappedStyle.foot * root.u;
    property <bool> has-photo: root.scene.photos.length > 0;
    pure function rise(from: float, to: float) -> float {
        WrappedStyle.rise(root.told, from, to)
    }
    property <length> cell: (root.inner - 8 * root.u) / 2;
    property <length> print-height: 78 * root.u;
    property <int> rows: ceil(min(4, root.scene.photos.length) / 2);
    property <length> photos-height: self.rows * (self.print-height + 8 * root.u);
    for photo[i] in root.scene.photos: Print {
        u: root.u;
        source: photo;
        width: root.cell;
        height: root.print-height;
        x: root.pad + mod(i, 2) * (root.cell + 8 * root.u);
        y: 48 * root.u + floor(i / 2) * (self.height + 8 * root.u);
        shown: root.rise(0.05 + i * 0.06, 0.4 + i * 0.06);
    }
    VerticalLayout {
        x: root.pad;
        y: 50 * root.u + root.photos-height;
        width: root.inner;
        height: self.preferred-height;
        spacing: 2 * root.u;
        Figure {
            u: root.u;
            size: 26;
            color: WrappedStyle.gold;
            text: root.scene.figure;
            shown: root.rise(0.3, 0.7);
        }
        Rectangle { height: 4 * root.u; }
        for line[i] in root.scene.lines: LineRow {
            u: root.u;
            line: line;
            shown: root.rise(0.3 + i * 0.4 / max(1, root.scene.lines.length), 0.6 + i * 0.4 / max(1, root.scene.lines.length));
        }
    }
    if root.scene.swatches.length > 0: Rectangle {
        x: root.pad;
        y: root.foot - 12 * root.u;
        width: root.inner * root.rise(0.6, 1);
        height: 8 * root.u;
        border-radius: self.height / 2;
        clip: true;
        HorizontalLayout {
            for swatch in root.scene.swatches: Rectangle {
                horizontal-stretch: swatch.share;
                background: swatch.ink;
            }
        }
    }
}

// The last frame's two lines, centred above the brand's band.
export component FarewellScene inherits VerticalLayout {
    in property <WrappedScene> scene;
    // The frame's unit: its width over 360.
    in property <length> u;
    in property <float> told: 1;
    property <length> pad: WrappedStyle.pad * root.u;
    property <length> inner: WrappedStyle.inner * root.u;
    property <length> foot: WrappedStyle.foot * root.u;
    property <bool> has-photo: root.scene.photos.length > 0;
    pure function rise(from: float, to: float) -> float {
        WrappedStyle.rise(root.told, from, to)
    }
    padding: root.pad;
    padding-bottom: root.height - root.foot;
    spacing: 12 * root.u;
    alignment: center;
    Figure {
        u: root.u;
        size: 38;
        color: WrappedStyle.title-ink;
        text: root.scene.eyebrow;
        shown: root.rise(0.1, 0.6);
    }
    Words {
        u: root.u;
        size: 17;
        text: root.scene.caption;
        shown: root.rise(0.45, 0.9);
    }
}
