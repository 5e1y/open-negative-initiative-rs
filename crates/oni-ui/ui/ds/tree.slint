// The library column's tree over its rows: the parent row pinned under the top while its children
// pass, and the ring round the row a drop would join.
import { Colour, Stroke, Radius, RowStyle } from "theme.slint";
import { Icon } from "base.slint";
import { Icons } from "icons.slint";
import { ListRow, RowKind } from "collections.slint";
import { Look } from "controls.slint";

// The archive's row: indented by depth, a chevron when it opens, then its glyph, a photo's included.
export component TreeItem inherits ListRow {
    in property <int> depth;
    in property <RowKind> kind;
    in property <bool> expandable;
    in property <bool> expanded;
    // `TreeRowChrome.RowIcon.stock`: a roll's stock artwork in place of its glyph.
    in property <image> stock;
    in property <bool> has-stock;
    indent: root.depth * RowStyle.indent;
    fold-zone: root.expandable ? RowStyle.chevron-zone : 0;
    Rectangle {
        width: RowStyle.chevron-zone;
        if root.expandable: Icon {
            source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
            width: RowStyle.chevron;
            height: RowStyle.chevron;
        }
    }
    Rectangle {
        width: RowStyle.slot;
        if root.has-stock: Image {
            source: root.stock;
            width: RowStyle.slot;
            height: RowStyle.slot;
        }
        if !root.has-stock: Icon {
            source: root.kind == RowKind.photo ? Icons.film : root.kind == RowKind.project ? Icons.sticky-note
                : root.kind == RowKind.roll ? Icons.film-roll : root.expanded ? Icons.folder-open : Icons.folder;
            width: RowStyle.icon;
            height: RowStyle.icon;
        }
    }
}

// `PinnedRow`: the open row held at the tree's top on the panel, a hairline under it; a click in
// its chevron's zone folds it, elsewhere it clicks the row.
export component PinnedTreeRow inherits Rectangle {
    in property <int> depth;
    in property <string> title;
    in property <string> caption;
    in property <RowKind> kind;
    in property <bool> selected;
    in property <Look> look: Look.live;
    // ⌘ (or Ctrl) and ⇧ held on the click.
    callback clicked(bool, bool);
    callback double-clicked();
    callback folded();
    height: RowStyle.height;
    background: Colour.ground;
    TreeItem {
        width: parent.width;
        depth: root.depth;
        title: root.title;
        caption: root.caption;
        kind: root.kind;
        expandable: true;
        expanded: true;
        selected: root.selected;
        look: root.look;
        clicked => { root.clicked(self.command, self.shift); }
        double-clicked => { root.double-clicked(); }
        folded => { root.folded(); }
    }
    Rectangle {
        y: parent.height - Stroke.hairline;
        height: Stroke.hairline;
        background: Colour.separator;
    }
}

// `TreeRowChrome.dropRing`: a fine edge inset in the row, the selection's ring over it.
export component DropRing {
    Rectangle {
        x: Stroke.line;
        y: Stroke.line;
        width: parent.width - 2 * Stroke.line;
        height: parent.height - 2 * Stroke.line;
        border-radius: Radius.badge;
        border-width: Stroke.line;
        border-color: Colour.contrast-edge-idle;
    }
    Rectangle {
        border-radius: Radius.badge;
        border-width: Stroke.emphasis;
        border-color: Colour.selected;
    }
}
