// The ring round the library column's row a drop would join.
import { Colour, Stroke, Radius, RowStyle } from "theme.slint";
import { Icon } from "base.slint";
import { Icons } from "icons.slint";

// `TreeRowChrome.dropRing`: a fine edge inset in the row, the selection's ring over it.
export component DropRing {
    Rectangle {
        x: Stroke.line;
        y: Stroke.line;
        width: parent.width - 2 * Stroke.line;
        height: parent.height - 2 * Stroke.line;
        border-radius: Radius.badge;
        border-width: Stroke.line;
        border-color: Colour.contrast-edge-idle;
    }
    Rectangle {
        border-radius: Radius.badge;
        border-width: Stroke.emphasis;
        border-color: Colour.selected;
    }
}
