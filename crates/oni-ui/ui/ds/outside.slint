// What a press beside a field or a menu does: the window's count of each press.

// Each press in the window, counted by the window's pointer hook before any item reads it: a field or
// a control holding the keyboard that it misses gives it back, a picker whose release comes without it opens.
export global Outside {
    in-out property <int> presses;
    // Bumped by a field or a control a press missed, so the window's key monitor takes the keyboard back.
    in-out property <int> released;
}

// The window's size, which the window keeps: a submenu turns back at its edge.
export global Bounds {
    in-out property <length> width;
    in-out property <length> height;
}
