// The gauges of single views: the preset deck, the Help menu's windows, the stock picker.
import { DS } from "tokens.slint";
import { Motion, SheetStyle } from "theme.slint";

// `PresetCarousel`'s gauge: a card at the 35 mm frame's 3:2, wide enough for a name on one line;
// the tab, a 24 pt target; the lift; the sheets, the editor's list beside the save sheet's form.
export global PresetStyle {
    out property <length> card-width: 96px;
    out property <length> card-height: 64px;
    out property <length> peek: DS.space-lg;
    out property <length> lift: 6px;
    out property <length> swatch: 26px;
    out property <length> editor-list: DS.control-preset-editor-list-width;
    out property <length> editor-width: DS.control-preset-editor-list-width + SheetStyle.wide-width;
    out property <length> mark: 22px;
    out property <duration> rise: Motion.quick;
    // The description's three lines at the label's leading, the multiline field's padding around them.
    out property <length> note-height: 3 * DS.typo-label-size * 1.25;
}

// The Help menu's gauges: the console window and the welcome sheet's picture.
export global HelpStyle {
    out property <length> console-width: 620px;
    out property <length> console-height: 420px;
}

// `StockPickerSheet` and `FilmStockIcon`: the sheet's gauge, a cell's artwork and the hero's.
export global StockStyle {
    out property <length> icon: 32px;
    out property <length> hero: 64px;
    // `InfoSidebar`'s count rows: the stock at the icon's size.
    out property <length> row: DS.control-icon-size;
    out property <length> width: 520px;
    out property <length> height: 560px;
    out property <float> grow: 1.12;
    // A menu's line: the canister at a tree row's side, a small gap above and under it.
    out property <length> line-icon: DS.control-film-sidebar-stock-icon-size;
    out property <length> line: DS.control-film-sidebar-stock-icon-size + 2 * DS.space-xs;
}

// The canvas's tools, each its own colour while it holds: a ring a stroke wide around the card and a tab
// under its key in the bar. Sheet orange, Crop verdigris, De-dust violet, Compare pink.
export global ToolStyle {
    out property <color> sheet: #e8873aff;
    out property <color> crop: #3fae96ff;
    out property <color> dust: #9d7ff0ff;
    out property <color> compare: #ec6fa8ff;
    out property <length> marker: 5px;
    out property <length> ring: DS.stroke-line;
}

// The Kit's gauges: The Lens DB's mark beside its words, in the column and large where it is offered; the
// sheet that searches its catalogue, two cards to a row.
export global KitStyle {
    out property <length> mark: 18px;
    out property <length> mark-large: 44px;
    // Facing the column's title, the mark a step larger than the sheet's, its name between label and title.
    out property <length> mark-header: 19px;
    out property <length> word-header: 13px;
    out property <length> tracking: -0.3px;
    // The arrow after a piece's name that opens its page, a step under the name's capitals.
    out property <length> link-arrow: 11px;
    out property <length> bullet: 12px;
    // The disc beside a name from The Lens DB in a list of gear, at the name's capitals.
    out property <length> disc: 12px;
    // The offer's ONI × The Lens DB: both logos at one height, the mark's name between label and title.
    out property <length> pair-height: 28px;
    out property <length> pair-word: 16px;
    // The app's logo over it, its words under its disc needing the taller line to read as wide as the mark.
    out property <length> pair-logo: 40px;
    // The × between them, large and light so it joins without weighing.
    out property <length> times-size: 22px;
    out property <int> times-weight: 200;
    // The offer alone takes wider sides than the column's sections, its few lines held to a narrower measure.
    out property <length> offer-inset: 32px;
    out property <length> sheet-width: 660px;
    out property <length> sheet-height: 620px;
    out property <int> columns: 2;
}
