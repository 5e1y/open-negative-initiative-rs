// The gauges of single views: the preset deck, the Help menu's windows, the stock picker.
import { DS } from "tokens.slint";
import { Motion } from "theme.slint";

// `PresetCarousel`'s gauge: a card, the strip left showing at rest, the fade at each end, the lift.
export global PresetStyle {
    out property <length> card-width: 72px;
    out property <length> card-height: 104px;
    out property <length> peek: DS.space-md;
    out property <length> lift: DS.control-card-lift;
    out property <length> swatch: DS.control-swatch-size;
    out property <length> save-width: DS.control-preset-save-width;
    out property <length> save-height: DS.control-preset-save-height;
    out property <length> editor-width: DS.control-preset-editor-width;
    out property <length> editor-height: DS.control-preset-editor-height;
    out property <length> editor-list: DS.control-preset-editor-list-width;
    out property <length> mark: DS.typo-mark-size;
    out property <duration> rise: Motion.quick;
    // The description's three lines at the label's leading, inside the multiline field's padding.
    out property <length> note-height: 3 * DS.typo-label-size * 1.25 + 2 * DS.space-sm;
}

// The Help menu's gauges: the console window and the welcome sheet's picture.
export global HelpStyle {
    out property <length> console-width: DS.control-console-window-width;
    out property <length> console-height: DS.control-console-window-height;
}

// `StockPickerSheet` and `FilmStockIcon`: the sheet's gauge, a cell's artwork and the hero's.
export global StockStyle {
    out property <length> icon: DS.control-film-stock-icon-size;
    out property <length> hero: DS.control-film-stock-hero-size;
    // `InfoSidebar`'s count rows: the stock at the icon's size.
    out property <length> row: DS.control-icon-size;
    out property <length> width: DS.control-stock-sheet-width;
    out property <length> height: DS.control-stock-sheet-height;
    out property <float> grow: DS.control-thumb-grow;
}
