// The states a check reads off the drawn window, each at a fixed place: a key and a keycap out of reach, an
// idle tab, a destructive glyph, a latching key, a switch, a tile under the hand, readouts, the medals.
import { DS, Colour, State, Stroke, ButtonStyle, SliderStyle, ScannerStyle, ToggleStyle, AppWindow, Tabs, Button, ButtonKind, Look, TileView, Icons, Toggle, LabelSide, Slider, Medal } from "ds.slint";
import { MedalStyle } from "theme.slint";
import { Figure } from "marks.slint";

export component StateProbe inherits AppWindow {
    in property <string> word;
    in property <[string]> readouts;
    out property <length> tabs-height: tabs.height;
    out property <length> off-width: off.width;
    out property <length> was-width: was.width;
    out property <length> dark-width: dark.width;
    out property <length> lit-width: lit.width;
    out property <length> medal: MedalStyle.size;
    out property <length> picker: MedalStyle.picker;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 500px;
    tabs := Tabs {
        x: 16px;
        y: 16px;
        width: 200px;
        tabs: [root.word, root.word];
        selected: 0;
    }
    // Off a layout, each key keeps the width its word asks for.
    off := Button { width: self.preferred-width; x: 16px; y: 72px; text: root.word; enabled: false; }
    // Twin: a key that can act, faded only as a missing photo is, which reads as bright as an idle label.
    was := Button { width: self.preferred-width; x: 200px; y: 72px; text: root.word; opacity: State.missing; }
    Button { width: self.preferred-width; x: 16px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; }
    Button { width: self.preferred-width; x: 64px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; look: Look.hover; }
    Button { width: self.preferred-width; x: 112px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; enabled: false; }
    // Twin: the red worn at rest.
    Button { width: self.preferred-width; x: 160px; y: 120px; has-icon: true; square: true; icon: Icons.remove; glyph-ink: Colour.destructive-ink; }
    // A keycap that can act, one out of reach, and the twin: a keycap faded whole.
    Button { width: self.preferred-width; x: 220px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; }
    Button { width: self.preferred-width; x: 270px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; enabled: false; }
    Button { width: self.preferred-width; x: 320px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; opacity: State.disabled; }
    dark := Button { width: self.preferred-width; x: 16px; y: 168px; text: root.word; latch: true; }
    lit := Button { width: self.preferred-width; x: 200px; y: 168px; text: root.word; latch: true; on: true; }
    // Twin: the lamp at rest as dark glass in a dark groove, alone on a key's face.
    Rectangle {
        x: 310px;
        y: 168px;
        width: 32px;
        height: 32px;
        border-radius: ButtonStyle.radius;
        background: ButtonStyle.face;
        Rectangle {
            width: ButtonStyle.lamp;
            height: ButtonStyle.lamp;
            border-radius: self.width / 2;
            background: ScannerStyle.glass;
            border-width: Stroke.line;
            border-color: DS.palette-groove;
        }
    }
    // Twin: a lit disc with no bloom, on a lit key's face.
    Rectangle {
        x: 350px;
        y: 168px;
        width: 32px;
        height: 32px;
        border-radius: ButtonStyle.radius;
        background: ButtonStyle.on;
        Rectangle {
            width: ButtonStyle.lamp;
            height: ButtonStyle.lamp;
            border-radius: self.width / 2;
            background: ButtonStyle.latch;
        }
    }
    Toggle { x: 240px; y: 20px; width: self.preferred-width; height: self.preferred-height; label-side: LabelSide.none; }
    Toggle { x: 310px; y: 20px; width: self.preferred-width; height: self.preferred-height; label-side: LabelSide.none; on: true; }
    // Twin: the slot lit grey as a slider's stretch, on the hollow's ground.
    Rectangle {
        x: 310px;
        y: 81px;
        width: ToggleStyle.travel;
        height: ToggleStyle.slot;
        border-radius: self.height / 2;
        background: Colour.canvas;
        Rectangle { border-radius: parent.border-radius; background: SliderStyle.lit; }
    }
    Rectangle {
        y: 210px;
        height: 130px;
        background: Colour.canvas;
        TileView { x: 24px; y: 30px; width: 90px; picture-height: 60px; }
        TileView { x: 200px; y: 30px; width: 90px; picture-height: 60px; hovered: true; }
        // Gold, silver and bronze a medal and a half apart, then a second gold: the twin of a place.
        for rank[i] in [1, 2, 3, 1]: Medal { x: 300px + i * 1.5 * MedalStyle.size; y: 50px; rank: rank; }
        // Under the first, a 1 alone on a flat disc: the figure gold must strike.
        Rectangle {
            x: 300px;
            y: 50px + 1.5 * MedalStyle.size;
            width: MedalStyle.size;
            height: self.width;
            border-radius: self.width / 2;
            background: MedalStyle.bodies[2];
            Figure { text: "1"; font-size: MedalStyle.size * MedalStyle.figure; color: MedalStyle.struck; }
        }
        // The status bar's medals on its ground, a key apart: gold given, gold and bronze not, then a 3 in
        // bronze's own body alone, the twin of a disc and of a figure that reads.
        Rectangle {
            x: 300px;
            y: 92px;
            width: 4 * ButtonStyle.small-height;
            height: ButtonStyle.small-height;
            background: Colour.ground;
            for blank[i] in [false, true, true]: Medal {
                x: i * ButtonStyle.small-height;
                y: 0;
                rank: i < 2 ? 1 : 3;
                size: MedalStyle.picker;
                blank: blank;
            }
            Rectangle {
                x: 3 * ButtonStyle.small-height;
                y: 0;
                width: MedalStyle.picker;
                height: self.width;
                Figure { text: "3"; font-size: MedalStyle.picker * MedalStyle.figure; color: MedalStyle.bodies[3]; }
            }
        }
    }
    // The check's readouts, one under the other.
    VerticalLayout {
        x: 16px;
        y: 350px;
        width: 200px;
        height: self.preferred-height;
        for readout in root.readouts: Slider { label: root.word; readout: readout; fraction: 0.5; }
    }
}
