// The states a check reads off the drawn window, each at a fixed place: a key and a keycap out of reach, an
// idle tab, a destructive glyph, a latching key, a switch, a tile under the hand, readouts, the medals, a
// tool's header.
import { DS, Colour, State, Space, Stroke, ButtonStyle, SliderStyle, SliderFill, ScannerStyle, ToggleStyle, AppWindow, Tabs } from "ds.slint";
import { Button, ButtonKind, Look, TileView, Icons, Toggle, LabelSide, Slider, Medal, Section, SectionStyle, ShellStyle, ModeHeader } from "ds.slint";
import { MedalStyle } from "theme.slint";
import { Figure } from "marks.slint";
import { LabScreen } from "keypad.slint";

export component StateProbe inherits AppWindow {
    in property <string> word;
    in property <[string]> readouts;
    out property <length> tabs-height: tabs.height;
    out property <length> off-width: off.width;
    out property <length> was-width: was.width;
    out property <length> faded-x: faded.x;
    out property <length> dark-width: dark.width;
    out property <length> lit-width: lit.width;
    out property <length> medal: MedalStyle.size;
    out property <length> picker: MedalStyle.picker;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 500px;
    tabs := Tabs {
        x: 16px;
        y: 16px;
        width: 200px;
        tabs: [root.word, root.word];
        selected: 0;
    }
    // Off a layout, each key keeps the width its word asks for.
    off := Button { width: self.preferred-width; x: 16px; y: 72px; text: root.word; enabled: false; }
    // Twin: a key out of reach faded whole, its plate sinking into the ground with its legend.
    faded := Button { width: self.preferred-width; x: off.x + off.width + Space.s; y: 72px; text: root.word; enabled: false; opacity: State.disabled; }
    // Twin: a key that can act, faded whole to an idle label's own ink, which reads as bright as that label.
    was := Button { width: self.preferred-width; x: 200px; y: 72px; text: root.word; opacity: State.idle; }
    Button { width: self.preferred-width; x: 16px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; }
    Button { width: self.preferred-width; x: 64px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; look: Look.hover; }
    Button { width: self.preferred-width; x: 112px; y: 120px; has-icon: true; square: true; icon: Icons.remove; kind: ButtonKind.destructive; enabled: false; }
    // Twin: the red worn at rest.
    Button { width: self.preferred-width; x: 160px; y: 120px; has-icon: true; square: true; icon: Icons.remove; glyph-ink: Colour.destructive-ink; }
    // A keycap that can act, one out of reach, and the twin: a keycap faded whole.
    Button { width: self.preferred-width; x: 220px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; }
    Button { width: self.preferred-width; x: 270px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; enabled: false; }
    Button { width: self.preferred-width; x: 320px; y: 120px; keycap: true; has-icon: true; square: true; icon: Icons.remove; opacity: State.disabled; }
    dark := Button { width: self.preferred-width; x: 16px; y: 168px; text: root.word; latch: true; }
    lit := Button { width: self.preferred-width; x: 200px; y: 168px; text: root.word; latch: true; on: true; }
    // Twin: the lamp at rest as dark glass in a dark groove, alone on a key's face.
    Rectangle {
        x: 310px;
        y: 168px;
        width: 32px;
        height: 32px;
        border-radius: ButtonStyle.radius;
        background: ButtonStyle.face;
        Rectangle {
            width: ButtonStyle.lamp;
            height: ButtonStyle.lamp;
            border-radius: self.width / 2;
            background: ScannerStyle.glass;
            border-width: Stroke.line;
            border-color: DS.palette-groove;
        }
    }
    // Twin: a lit disc with no bloom, on a lit key's face.
    Rectangle {
        x: 350px;
        y: 168px;
        width: 32px;
        height: 32px;
        border-radius: ButtonStyle.radius;
        background: ButtonStyle.on;
        Rectangle {
            width: ButtonStyle.lamp;
            height: ButtonStyle.lamp;
            border-radius: self.width / 2;
            background: ButtonStyle.latch;
        }
    }
    Toggle { x: 240px; y: 20px; width: self.preferred-width; height: self.preferred-height; label-side: LabelSide.none; }
    Toggle { x: 310px; y: 20px; width: self.preferred-width; height: self.preferred-height; label-side: LabelSide.none; on: true; }
    // Twin: the slot lit grey as a slider's stretch, on the hollow's ground.
    Rectangle {
        x: 310px;
        y: 81px;
        width: ToggleStyle.travel;
        height: ToggleStyle.slot;
        border-radius: self.height / 2;
        background: Colour.canvas;
        Rectangle { border-radius: parent.border-radius; background: SliderStyle.lit; }
    }
    Rectangle {
        y: 210px;
        height: 130px;
        background: Colour.canvas;
        TileView { x: 24px; y: 30px; width: 90px; picture-height: 60px; }
        TileView { x: 200px; y: 30px; width: 90px; picture-height: 60px; hovered: true; }
        // Gold, silver and bronze a medal and a half apart, then a second gold: the twin of a place.
        for rank[i] in [1, 2, 3, 1]: Medal { x: 300px + i * 1.5 * MedalStyle.size; y: 50px; rank: rank; }
        // Under the first, a 1 alone on a flat disc: the figure gold must strike.
        Rectangle {
            x: 300px;
            y: 50px + 1.5 * MedalStyle.size;
            width: MedalStyle.size;
            height: self.width;
            border-radius: self.width / 2;
            background: MedalStyle.bodies[2];
            Figure { text: "1"; font-size: MedalStyle.size * MedalStyle.figure; color: MedalStyle.struck; }
        }
        // The status bar's medals on its ground, a key apart: gold given, gold and bronze not, then a 3 in
        // bronze's own body alone, the twin of a disc and of a figure that reads.
        Rectangle {
            x: 300px;
            y: 92px;
            width: 4 * ButtonStyle.small-height;
            height: ButtonStyle.small-height;
            background: Colour.ground;
            for blank[i] in [false, true, true]: Medal {
                x: i * ButtonStyle.small-height;
                y: 0;
                rank: i < 2 ? 1 : 3;
                size: MedalStyle.picker;
                blank: blank;
            }
            Rectangle {
                x: 3 * ButtonStyle.small-height;
                y: 0;
                width: MedalStyle.picker;
                height: self.width;
                Figure { text: "3"; font-size: MedalStyle.picker * MedalStyle.figure; color: MedalStyle.bodies[3]; }
            }
        }
    }
    // The check's readouts, one under the other.
    VerticalLayout {
        x: 16px;
        y: 350px;
        width: 200px;
        height: self.preferred-height;
        for readout in root.readouts: Slider { label: root.word; readout: readout; fraction: 0.5; }
    }
}

// Rails of hues and a grey one as the panels lay them: Pro's Temperature, then the Scanner's C and D
// between their keys, and the twin of a key worn in its end's red. A check reads them off the window.
export component HueProbe inherits AppWindow {
    in-out property <int> c;
    // Each rail's middle row and its two ends, a key's middle beside C's and D's, the twin key's middle.
    out property <length> temperature-y: temperature.absolute-position.y + temperature.height - SliderStyle.row / 2;
    out property <length> c-y: cyan.absolute-position.y + cyan.height - SliderStyle.row / 2;
    out property <length> d-y: dark.absolute-position.y + dark.height - SliderStyle.row / 2;
    // The middle of the title of the block C and D lie in, off every rail.
    out property <length> block-y: block.absolute-position.y + SectionStyle.before + ButtonStyle.small-height / 2;
    out property <length> from: temperature.absolute-position.x;
    out property <length> to: temperature.absolute-position.x + temperature.width;
    out property <length> keyed-from: root.from + SliderStyle.step-key + Space.s;
    out property <length> keyed-to: root.to - SliderStyle.step-key - Space.s;
    out property <length> minus-x: root.from + SliderStyle.step-key / 2;
    out property <length> plus-x: root.to - SliderStyle.step-key / 2;
    out property <length> twin-x: twin.absolute-position.x + twin.width / 2;
    out property <length> twin-y: twin.absolute-position.y + twin.height / 2;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 400px;
    VerticalLayout {
        x: 16px;
        y: 16px;
        width: 300px;
        height: self.preferred-height;
        spacing: Space.l;
        temperature := Slider {
            label: "T";
            readout: "0";
            fraction: 0.5;
            rest: 0.5;
            fill: SliderFill.bipolar;
            low: Colour.channel-blue;
            high: Colour.channel-yellow;
        }
        block := Section {
            title: "K";
            separated: false;
            foldable: false;
            inset: 0;
            cyan := Slider {
                near: block.hovered;
                label: "C";
                readout: root.c;
                stepped: true;
                value: root.c;
                lowest: -48;
                highest: 48;
                rest: 0.5;
                fill: SliderFill.bipolar;
                low: ScannerStyle.band-red;
                high: ScannerStyle.band-cyan;
                minus-help: "C −";
                plus-help: "C +";
                step(f, by) => { root.c += by; }
            }
            dark := Slider {
                label: "D";
                readout: "0";
                stepped: true;
                lowest: -48;
                highest: 48;
                rest: 0.5;
                fill: SliderFill.bipolar;
                low: ScannerStyle.band-dark;
                high: ScannerStyle.band-light;
            }
        }
        HorizontalLayout {
            alignment: start;
            twin := Button { keycap: true; square: true; height: SliderStyle.step-key; legend-size: SliderStyle.step-legend; text: "−"; fill: ScannerStyle.band-red; }
        }
    }
}

// The Lab screen, narrow, every count at the widest a letter reaches; its columns' edges for the check.
export component ScreenProbe inherits AppWindow {
    in property <string> widest: "+23.5";
    // Every count shown, signed by its letter's place: a check makes it longer than any font fits.
    in property <string> count: "23.5";
    out property <length> left: screen.x + Space.m;
    out property <length> column: (screen.width - 2 * Space.m) / 5;
    out property <length> top: screen.y;
    out property <length> bottom: screen.y + screen.height;
    min-width: 0;
    min-height: 0;
    preferred-width: 240px;
    preferred-height: 140px;
    screen := LabScreen {
        x: 16px;
        y: 16px;
        width: 200px;
        height: 108px;
        widest: root.widest;
        cells: [{ title: "D", value: "−" + root.count }, { title: "C", value: "+" + root.count }, { title: "M", value: "−" + root.count }, { title: "Y", value: "+" + root.count }, { title: "T", value: "−" + root.count }];
    }
}

// A canvas tool's header across the panel's width, its name the check's.
export component HeaderProbe inherits AppWindow {
    in property <string> name;
    min-width: 0;
    min-height: 0;
    preferred-width: ShellStyle.panel-width;
    VerticalLayout {
        padding-left: Space.m;
        padding-right: Space.m;
        alignment: start;
        ModeHeader { title: root.name; }
    }
}
