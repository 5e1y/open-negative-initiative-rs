// Prepare the Roll's pieces: the pager, the sealed status line, the loupe on the scan's own pixels
// and the passes' order; a frame's cell is a `TileView`.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, State, Type, TileStyle, Motion, StatusStyle } from "theme.slint";
import { Label, Picture, Ground, TextRole, Tone, StatusLine, Clicks } from "base.slint";
import { Badge, BadgeTone, Metal } from "badge.slint";
import { Button } from "controls.slint";
import { Ring } from "marks.slint";

export global RollStyle {
    out property <int> columns: DS.control-roll-columns;
    out property <int> sheet-columns: DS.control-roll-sheet-columns;
    out property <length> loupe: DS.control-base-loupe-side;
    out property <length> panel-width: DS.control-panel-width;
    out property <length> plate: DS.control-keycap-plate-height;
    out property <length> canvas-padding: DS.control-canvas-padding;
    // `GalleryView.tile`'s well: a 3:2 frame on its side.
    out property <float> well-ratio: 2 / 3;
    out property <length> hollow: DS.control-tab-bar-height;
    // The frame's name between Previous and Next, wide enough that the keys never move with it.
    out property <length> name-width: 10 * Space.m;
}

// `RollReferenceSurface`'s pager: Previous, a frame's name, Next. A `name-width` holds the keys still,
// centred; without one the name takes the row's room between them.
export component Pager inherits HorizontalLayout {
    in property <string> name;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <length> name-width;
    callback previous();
    callback next();
    spacing: Space.s;
    alignment: root.name-width > 0 ? LayoutAlignment.center : LayoutAlignment.stretch;
    Button { text: @tr("Previous"); widest: @tr("Previous"); enabled: root.can-previous; clicked => { root.previous(); } }
    if root.name-width > 0: Label { role: TextRole.value; tone: Tone.secondary; text: root.name; width: root.name-width; horizontal-alignment: center; overflow: elide; }
    if root.name-width == 0: Label { role: TextRole.value; tone: Tone.secondary; text: root.name; horizontal-stretch: 1; horizontal-alignment: center; overflow: elide; }
    Button { text: @tr("Next"); widest: @tr("Previous"); enabled: root.can-next; clicked => { root.next(); } }
}

// `DSStatusBar.idle(leading:seal:)`: the status line, the seal of a frame made of passes right after
// it, then the room the trailing picker takes.
export component SealedStatusLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> seal;
    spacing: Space.s;
    StatusLine { horizontal-stretch: 0; text: root.text; }
    // The seal stands out of the row by its own height, as Swift's overlay does, so the bar keeps its height.
    if root.seal != "": Rectangle {
        width: seal.width;
        height: StatusStyle.height;
        seal := Badge { tone: BadgeTone.seal; metal: Metal.holographic; text: root.seal; }
    }
    Rectangle { horizontal-stretch: 1; }
}

// The base's loupe: the scan's pixels under the pointer, nearest neighbour, the canvas past its
// edge; Rust lays the cut, where it lands, and the rings.
export component Loupe inherits Rectangle {
    in property <image> source;
    in property <int> cut-x;
    in property <int> cut-y;
    in property <int> cut-width;
    in property <int> cut-height;
    in property <length> cut-at-x;
    in property <length> cut-at-y;
    in property <length> cut-shown-width;
    in property <length> cut-shown-height;
    in property <length> disc;
    in property <length> disc-x;
    in property <length> disc-y;
    in property <bool> picked-shown;
    in property <length> picked-x;
    in property <length> picked-y;
    in property <length> picked-disc;
    width: RollStyle.loupe;
    height: RollStyle.loupe;
    background: Colour.canvas;
    border-radius: Radius.card;
    clip: true;
    if root.cut-width > 0 && root.cut-height > 0: Image {
        x: root.cut-at-x;
        y: root.cut-at-y;
        width: root.cut-shown-width;
        height: root.cut-shown-height;
        source: root.source;
        source-clip-x: root.cut-x;
        source-clip-y: root.cut-y;
        source-clip-width: root.cut-width;
        source-clip-height: root.cut-height;
        image-fit: fill;
        image-rendering: pixelated;
    }
    if root.picked-shown: Ring { centre-x: root.picked-x; centre-y: root.picked-y; diameter: root.picked-disc; }
    Ring { centre-x: root.disc-x; centre-y: root.disc-y; diameter: root.disc; }
    Rectangle {
        border-radius: Radius.card;
        border-width: Stroke.line;
        border-color: Colour.selected;
    }
}

// `DSReorder` over a frame's three passes: each file's picture and name above its slot stay put, a
// band's chip dragged between two others slides them aside, and the move is said once, on release.
export component PassReorder inherits VerticalLayout {
    in property <[string]> letters;
    // Each slot's band: 0 red, 1 green, 2 blue.
    in property <[int]> bands;
    in property <[image]> pictures;
    in property <[string]> names;
    callback moved(int, int);
    property <int> held: -1;
    property <length> travel;
    property <length> pitch: (self.width - 2 * Space.xs + Stroke.line) / max(1, root.letters.length);
    property <int> target: root.held < 0 ? -1 : max(0, min(root.letters.length - 1, Math.round(root.held + root.travel / root.pitch)));
    // `DSSlots.moved`: where chip `i` stands once the held one is dropped on the target.
    pure function slot(i: int) -> int {
        if (root.held < 0 || i == root.held) { return i; }
        if (root.held < root.target && i > root.held && i <= root.target) { return i - 1; }
        if (root.target < root.held && i >= root.target && i < root.held) { return i + 1; }
        return i;
    }
    spacing: Space.s;
    HorizontalLayout {
        spacing: Stroke.line;
        padding-left: Space.xs;
        padding-right: Space.xs;
        for name[i] in root.names: VerticalLayout {
            spacing: Space.xxs;
            Picture { height: self.width * RollStyle.well-ratio; source: root.pictures[i]; ground: Ground.canvas; rounded: true; }
            Label { role: TextRole.caption; tone: Tone.tertiary; text: name; overflow: elide; centred: true; }
        }
    }
    Rectangle {
        height: RollStyle.hollow;
        border-radius: self.height / 2;
        background: Colour.canvas;
        for letter[i] in root.letters: Rectangle {
            x: Space.xs + (i == root.held ? i * root.pitch + root.travel : root.slot(i) * root.pitch);
            y: Space.xs;
            width: root.pitch - Stroke.line;
            height: parent.height - 2 * Space.xs;
            border-radius: self.height / 2;
            background: i == root.held ? Colour.selected : Colour.track;
            animate x { duration: i == root.held ? 0ms : Motion.slide; easing: ease-out; }
            Label {
                text: letter;
                centred: true;
                ink: i == root.held ? Colour.canvas : [Colour.channel-red, Colour.channel-green, Colour.channel-blue][root.bands[i]];
            }
        }
        // One hand over the whole hollow, so the chip moving under it never moves its reading.
        TouchArea {
            mouse-cursor: grab;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.held = max(0, min(root.letters.length - 1, Math.floor((self.mouse-x - Space.xs) / root.pitch)));
                    root.travel = 0;
                }
                if (e.kind == PointerEventKind.up && root.held >= 0) {
                    if (root.target != root.held) {
                        Clicks.press();
                        root.moved(root.held, root.target);
                    }
                    root.held = -1;
                    root.travel = 0;
                }
            }
            moved => {
                if (self.pressed && root.held >= 0) { root.travel = self.mouse-x - self.pressed-x; }
            }
        }
    }
}
