// The archive's organising controls: the medal keys and picker, an empty grid's state, a context menu with
// rules and submenus, the date fields, the drop line and ghost of a reorder, the ONI Trash's row.
import { DS } from "tokens.slint";
import { Colour, Space, State, TileStyle, ButtonStyle } from "theme.slint";
import { Label, Picture, TextRole, Tone, Clicks, Tips } from "base.slint";
import { KeyScope } from "keyboard.slint";
import { Button } from "controls.slint";
export { DateFields } from "fields.slint";
import { Icons } from "icons.slint";
import { Medal } from "marks.slint";
import { MedalStyle, TabsStyle } from "theme.slint";

// The podium's three keys, gold 1, silver 2 and bronze 3, each figure the key that lays it: the given one
// (-1 none) lit, the others in the shade and lifted under the hand, a pressed one shrunk on the spring.
export component MedalKeys inherits Rectangle {
    in property <int> current: -1;
    // The medal's side, the square catching the hand round it, and the room between two squares.
    in property <length> size: MedalStyle.picker;
    in property <length> key: ButtonStyle.small-height;
    in property <length> gap: Space.xs;
    // Tab stops on each key, which Space or Return lays; a tile's leave the keyboard to its grid.
    in property <bool> keyed: true;
    // Whom the medals are given to (`Medal.holder`).
    in property <string> holder;
    // The medal the lab shows pressed; -1 follows the hand alone.
    in property <int> pressed-rank: -1;
    callback picked(int);
    // As wide as its three keys, as high as its row, which a key's square may overhang.
    width: 3 * root.key + 2 * root.gap;
    for medal[i] in [1, 2, 3]: Rectangle {
        x: i * (root.key + root.gap);
        y: (root.height - self.height) / 2;
        width: root.key;
        height: root.key;
        property <float> scale: touch.pressed || medal == root.pressed-rank ? MedalStyle.press : 1;
        // The medal and the key that lays it; the given one's, the key that takes it off.
        property <string> help: medal == root.current ? @tr("No Medal (0)") : medal == 1 ? @tr("Gold (1)") : medal == 2 ? @tr("Silver (2)") : @tr("Bronze (3)");
        // The help it shows, hidden by that text once it leaves, whatever its help says since.
        property <bool> telling: touch.has-hover || keys.has-focus;
        property <string> told;
        changed telling => {
            if (self.telling) { self.told = self.help; }
            Tips.hover(self.telling, self.told, self.absolute-position.x, self.absolute-position.y + self.height);
        }
        animate scale { duration: TabsStyle.slide; easing: spring(0.38); }
        Medal {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            rank: medal;
            size: root.size * parent.scale;
            blank: root.current != medal;
            reached: touch.has-hover;
            holder: root.holder;
        }
        touch := TouchArea {
            accessible-role: button;
            accessible-label: medal == 1 ? @tr("Gold") : medal == 2 ? @tr("Silver") : @tr("Bronze");
            accessible-description: parent.help;
            accessible-action-default => { root.picked(medal); }
            clicked => { root.picked(medal); }
            changed pressed => { if (self.pressed) { Clicks.press(); } else { Clicks.release(); } }
        }
        keys := KeyScope {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.size;
            height: self.width;
            radius: self.width / 2;
            focus-on-tab-navigation: root.keyed;
            key-pressed(event) => {
                if ((event.text != " " && event.text != Key.Return) || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                    return reject;
                }
                if (!event.repeat) { root.picked(medal); }
                accept
            }
        }
    }
}

// `DSMedalPicker`: the group's name, then the podium's keys at a small key's size, each catching the hand
// over a small key's square, overhanging the status bar.
export component MedalPicker inherits HorizontalLayout {
    in property <int> current: -1;
    in property <string> holder;
    in property <int> pressed-rank: -1;
    callback picked(int);
    alignment: start;
    spacing: Space.xs;
    Label { role: TextRole.value; tone: Tone.secondary; text: @tr("Rating"); }
    MedalKeys {
        current: root.current;
        holder: root.holder;
        pressed-rank: root.pressed-rank;
        picked(m) => { root.picked(m); }
    }
}

// `DSEmptyState`: a title, a line of detail and an optional key, centred in what it fills.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <string> action;
    callback acted();
    alignment: center;
    spacing: Space.s;
    padding: Space.l;
    Label { role: TextRole.title; text: root.title; centred: true; wrap: word-wrap; }
    if root.detail != "": Label { role: TextRole.note; text: root.detail; centred: true; }
    if root.action != "": HorizontalLayout {
        alignment: center;
        Button { text: root.action; clicked => { root.acted(); } }
    }
}

// Where a reorder would land: a line in the selected colour.
export component DropLine inherits Rectangle {
    background: Colour.selected;
}

// `InfoSidebar.cardStack`: a project's first three photos fanned behind one another, the first in front.
export component CardStack inherits Rectangle {
    in property <[image]> pictures;
    height: (self.width - 2 * Space.l) * 2 / 3 + Space.s + Space.l;
    if root.pictures.length > 2: Picture {
        x: Space.l - Space.xs;
        y: Space.s + Space.xs;
        width: root.width - 2 * Space.l;
        height: self.width * 2 / 3;
        rounded: true;
        source: root.pictures[2];
        opacity: TileStyle.stack-back;
    }
    if root.pictures.length > 1: Picture {
        x: Space.l + Space.xs;
        y: Space.s + Space.xs / 2;
        width: root.width - 2 * Space.l;
        height: self.width * 2 / 3;
        rounded: true;
        source: root.pictures[1];
        opacity: TileStyle.stack-middle;
    }
    Picture {
        x: Space.l;
        y: Space.s;
        width: root.width - 2 * Space.l;
        height: self.width * 2 / 3;
        rounded: true;
        source: root.pictures.length > 0 ? root.pictures[0] : Icons.film-roll;
        pixelated: false;
    }
}
