// The year on film's frame: one scene, 9 by 16 as a phone's story takes it and as it is saved. The scene's
// own photo, blurred, is the light it is told in; the film's perforations run down both sides; ONI's mark
// and the tags stand at the foot of a story's safe area. Every size is a share of the frame's width.
import { Colour } from "theme.slint";
import { WrappedKind, WrappedLine, WrappedSwatch, WrappedScene, WrappedStyle, Display, Perforations, Brand } from "wrapped_parts.slint";
import { HeroScene } from "wrapped_scenes.slint";
import { MosaicScene, PaletteScene } from "wrapped_montage.slint";

export { WrappedKind, WrappedLine, WrappedSwatch, WrappedScene, WrappedStyle }

export component WrappedGround inherits Rectangle {
    background: WrappedStyle.ground;
}

// The window around the strip in a scene's light: its backdrop, faint, lit while its scene is in the gate.
export component WrappedAmbient inherits Image {
    in property <bool> lit;
    image-fit: cover;
    opacity: root.lit ? WrappedStyle.ambient : 0;
    animate opacity { duration: WrappedStyle.enter; }
}

// One segment a scene, filled as the story reaches it; the one in the gate fills as it holds.
export component WrappedProgress inherits Rectangle {
    in property <int> count;
    in property <int> at;
    // The shown scene's hold so far, 0 to 1.
    in property <float> held;
    height: WrappedStyle.progress-height;
    property <length> segment: (root.width - (root.count - 1) * WrappedStyle.progress-gap) / max(1, root.count);
    for scene in root.count: Rectangle {
        x: scene * (root.segment + WrappedStyle.progress-gap);
        width: root.segment;
        height: parent.height;
        border-radius: self.height / 2;
        background: WrappedStyle.progress-idle;
        Rectangle {
            x: 0;
            width: parent.width * (scene < root.at ? 1 : scene == root.at ? clamp(root.held, 0, 1) : 0);
            height: parent.height;
            border-radius: self.height / 2;
            background: WrappedStyle.progress-done;
        }
    }
}

// One scene on its frame. `told` runs 0 to 1 as it tells itself; a frame not told yet is dark, as film
// not exposed. `drift` runs 0 to 1 while it holds.
export component WrappedFrame inherits Rectangle {
    in property <WrappedScene> scene;
    // The frame's unit: its width over 360.
    in property <length> u;
    in property <float> told: 1;
    in property <float> drift;
    in property <int> number;
    // What a posted card is tagged with, and whom.
    in property <string> hashtag;
    in property <string> account;
    in property <string> name;
    pure callback counted(int) -> string;
    width: WrappedStyle.frame-width * root.u;
    height: WrappedStyle.frame-height * root.u;
    background: WrappedStyle.ground;
    clip: true;
    property <WrappedKind> kind: root.scene.kind;
    // The scene's ink: its photo's own hue, or white for a photo with no colour.
    property <color> accent: root.scene.accent.alpha > 0 ? root.scene.accent : WrappedStyle.ink;
    property <string> figure-text: root.scene.count > 0 ? root.counted(round(root.scene.count * WrappedStyle.rise(root.told, 0.14, 0.5))) + root.scene.unit : root.scene.figure;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.scene.backdrop;
        image-fit: cover;
        opacity: WrappedStyle.glow * WrappedStyle.rise(root.told, 0, 0.3);
    }
    // The light falls off toward the foot, where the brand is read.
    Rectangle {
        background: @linear-gradient(180deg, Colour.black.with-alpha(0.05) 0%, Colour.black.with-alpha(0.3) 55%, Colour.black.with-alpha(0.62) 100%);
    }
    if root.kind != WrappedKind.mosaic && root.kind != WrappedKind.palette: HeroScene {
        scene: root.scene;
        u: root.u;
        told: root.told;
        drift: root.drift;
        accent: root.accent;
        figure-text: root.figure-text;
        whole: root.kind == WrappedKind.print;
        turned: mod(root.number, 2) == 1;
    }
    if root.kind == WrappedKind.mosaic: MosaicScene { scene: root.scene; u: root.u; told: root.told; drift: root.drift; accent: root.accent; figure-text: root.figure-text; }
    if root.kind == WrappedKind.palette: PaletteScene { scene: root.scene; u: root.u; told: root.told; accent: root.accent; }
    // The film's edges lie over a photo that fills the frame.
    Perforations {
        x: 0;
        height: parent.height;
        u: root.u;
    }
    Perforations {
        x: parent.width - self.width;
        height: parent.height;
        u: root.u;
    }
    Brand {
        x: WrappedStyle.pad * root.u;
        y: WrappedStyle.safe-top * root.u;
        width: WrappedStyle.inner * root.u;
        u: root.u;
        hashtag: root.hashtag;
        account: root.account;
        accent: root.accent;
        name: root.name;
    }
}

// The share screen's heading, in the display face.
export component WrappedHeading inherits Text {
    font-family: WrappedStyle.display-family;
    font-weight: WrappedStyle.display-weight;
    font-size: WrappedStyle.share-heading;
    color: WrappedStyle.ink;
    horizontal-alignment: center;
}

// A card of the share screen: the frame small, ringed under the pointer, saved alone by a click.
export component WrappedPick inherits Rectangle {
    in property <WrappedScene> scene;
    in property <length> u;
    in property <int> number;
    in property <string> hashtag;
    in property <string> account;
    in property <string> name;
    pure callback counted(int) -> string;
    callback picked();
    width: card.width;
    height: card.height;
    card := WrappedFrame {
        u: root.u;
        scene: root.scene;
        number: root.number;
        hashtag: root.hashtag;
        account: root.account;
        name: root.name;
        counted(n) => { root.counted(n) }
    }
    Rectangle {
        border-width: touch.has-hover ? max(2px, 6 * root.u) : 0px;
        border-color: WrappedStyle.share-ring;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("Save card {}", root.number);
        accessible-action-default => { root.picked(); }
        clicked => { root.picked(); }
    }
}
