// The welcome's interface scene, its bar: coloured keycaps on black plates pressed flat, three clusters
// rippling left to right, then the flat glyph-over-word keys, the two keycaps that stay rising back.
import { Colour } from "theme.slint";
import { Icons } from "icons.slint";
import { InterfaceSceneStyle, InterfaceBeats, Pouf, Breath, OldKey, OldPlate, NewKey } from "welcome_interface_parts.slint";

export component Bar inherits Rectangle {
    in property <float> t;
    in property <float> zoom: 1;
    left := Pouf { t: root.t; at: InterfaceBeats.header; }
    centre := Pouf { t: root.t; at: InterfaceBeats.header + InterfaceBeats.cluster-step; }
    right := Pouf { t: root.t; at: InterfaceBeats.header + 2 * InterfaceBeats.cluster-step; }
    property <length> lights-end: (2 * InterfaceSceneStyle.pad + 3 * InterfaceSceneStyle.lights + 2 * InterfaceSceneStyle.lights-gap) * root.zoom;
    height: InterfaceSceneStyle.bar * root.zoom;

    for i in 3: Rectangle {
        x: (InterfaceSceneStyle.pad + i * (InterfaceSceneStyle.lights + InterfaceSceneStyle.lights-gap)) * root.zoom;
        y: (root.height - self.height) / 2;
        width: InterfaceSceneStyle.lights * root.zoom;
        height: self.width;
        border-radius: self.width / 2;
        background: Colour.hover;
    }

    // Before: words alone or glyphs alone, colour on every kind of key, the filter among them.
    HorizontalLayout {
        x: root.lights-end;
        y: 0;
        width: root.width - root.lights-end;
        height: root.height;
        padding-right: InterfaceSceneStyle.pad * root.zoom;
        spacing: InterfaceSceneStyle.group-gap * root.zoom;
        OldKey { zoom: root.zoom; press: left.press; gone: left.gone; word: @tr("Gallery").to-uppercase(); }
        OldPlate {
            zoom: root.zoom;
            press: left.press;
            gone: left.gone;
            OldKey { zoom: root.zoom; press: left.press; gone: left.gone; glyphed: true; glyph: Icons.undo; }
            OldKey { zoom: root.zoom; press: left.press; gone: left.gone; glyphed: true; glyph: Icons.redo; }
        }
        Rectangle { horizontal-stretch: 1; }
        OldPlate {
            zoom: root.zoom;
            press: centre.press;
            gone: centre.gone;
            OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; glyphed: true; glyph: Icons.framing; }
            OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; glyphed: true; glyph: Icons.compare; }
            OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; glyphed: true; glyph: Icons.gallery; face: InterfaceSceneStyle.sheet; }
        }
        OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; word: @tr("All").to-uppercase(); }
        OldPlate {
            zoom: root.zoom;
            press: centre.press;
            gone: centre.gone;
            OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; glyphed: true; glyph: Icons.reset; face: Colour.caution; }
            OldKey { zoom: root.zoom; press: centre.press; gone: centre.gone; glyphed: true; glyph: Icons.remove; face: Colour.destructive; }
        }
        Rectangle { horizontal-stretch: 1; }
        OldKey { zoom: root.zoom; press: right.press; gone: right.gone; glyphed: true; glyph: Icons.settings; }
        OldKey { zoom: root.zoom; press: right.press; gone: right.gone; word: @tr("EXPORT"); face: Colour.accent; }
    }

    // Now: bare keys, a glyph over each word; a keycap for the mode and for EXPORT alone.
    HorizontalLayout {
        x: root.lights-end;
        y: 0;
        width: root.width - root.lights-end;
        height: root.height;
        padding-right: InterfaceSceneStyle.pad * root.zoom;
        spacing: InterfaceSceneStyle.cluster-gap * root.zoom;
        NewKey { zoom: root.zoom; come: left.come; rise: left.rise; cap: true; glyph: Icons.back; word: @tr("Back"); }
        HorizontalLayout {
            NewKey { zoom: root.zoom; come: left.come; glyph: Icons.undo; word: @tr("Undo"); }
            NewKey { zoom: root.zoom; come: left.come; glyph: Icons.redo; word: @tr("Redo"); }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            NewKey { zoom: root.zoom; come: centre.come; glyph: Icons.contact-sheet; word: @tr("Sheet"); }
            NewKey { zoom: root.zoom; come: centre.come; glyph: Icons.framing; word: @tr("Crop"); }
            NewKey { zoom: root.zoom; come: centre.come; glyph: Icons.compare; word: @tr("Compare"); }
        }
        VerticalLayout {
            alignment: center;
            Rectangle { width: 1px; height: InterfaceSceneStyle.divider * root.zoom; background: Colour.separator; opacity: centre.come; }
        }
        NewKey { zoom: root.zoom; come: centre.come; glyph: Icons.reset; word: @tr("Reset"); }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            NewKey { zoom: root.zoom; come: right.come; glyph: Icons.feedback; word: @tr("Feedback"); }
            NewKey { zoom: root.zoom; come: right.come; glyph: Icons.settings; word: @tr("Settings"); }
        }
        NewKey { zoom: root.zoom; come: right.come; rise: right.rise; cap: true; face: Colour.accent; glyph: Icons.export; word: @tr("EXPORT"); wide: InterfaceSceneStyle.export-width; }
    }

    // One breath for the whole bar, on its middle cluster's clock.
    Breath {
        t: root.t;
        at: InterfaceBeats.header + InterfaceBeats.cluster-step;
        zoom: root.zoom;
        x: root.lights-end - InterfaceSceneStyle.group-gap * root.zoom;
        y: 3px * root.zoom;
        width: root.width - self.x - InterfaceSceneStyle.group-gap * root.zoom;
        height: root.height - 6px * root.zoom;
    }
}
