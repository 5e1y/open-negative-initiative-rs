// A photo's flight between the screens: its picture lifts off where it stood, the gallery's tile, the editor's
// canvas or the export's preview, and grows or shrinks into its place on the next, which shows around it.
import { Motion, Ease } from "theme.slint";

// Where a flight goes: the tile into the canvas, the canvas into its tile, the canvas into the export's
// preview, the preview back onto the canvas.
export enum FlightRoute { into-editor, into-gallery, into-export, out-of-export }

export struct Place {
    x: length,
    y: length,
    width: length,
    height: length,
}

export global Flight {
    // The flight Rust starts: each one a serial, its picture, its way and the place it leaves from in the
    // window; the place it lands on follows the next screen as it lays out.
    in-out property <bool> flying;
    in property <int> serial;
    in property <image> picture;
    in property <FlightRoute> route;
    in property <Place> from;
    // The gallery's tile the photo lands in and its place, which Rust lays as the grid shows; a place of no
    // width is not laid yet, the photo then holding where it is bound.
    in property <int> tile: -1;
    in property <Place> tile-place;
    // The canvas's corner in the window, and the lone export preview's place and whether it has landed, as
    // their screens lay them.
    in-out property <length> canvas-x;
    in-out property <length> canvas-y;
    in-out property <Place> slot;
    in-out property <bool> slot-ready;
    // Landed, the picture fades over the place it reached, which shows again under it.
    in-out property <bool> landing;
    out property <bool> covering: Flight.flying && !Flight.landing;
    // The canvas's photo and a tile's picture stand back while the flying one covers them.
    out property <bool> canvas-covered: Flight.covering && (Flight.route == FlightRoute.into-editor || Flight.route == FlightRoute.out-of-export);
    out property <bool> tile-covered: Flight.covering && Flight.route == FlightRoute.into-gallery;
    out property <image> blank;
}

// Laid in the window's space over the screens, taking no press: every gesture reaches what lies under it.
export component FlightView {
    // Where the canvas lays the photo, and the canvas's room for a photo it has not placed yet.
    in property <Place> frame;
    in property <Place> room;
    property <float> aspect: Flight.picture.height > 0 ? Flight.picture.width / Flight.picture.height : 1;
    property <length> fit-width: min(root.room.width, root.room.height * root.aspect);
    property <Place> canvas: root.frame.width > 0 && root.frame.height > 0 ? root.frame : {
        x: root.room.x + (root.room.width - root.fit-width) / 2,
        y: root.room.y + (root.room.height - root.fit-width / root.aspect) / 2,
        width: root.fit-width,
        height: root.fit-width / root.aspect,
    };
    // The photo as its tile lays it, whole in the cell.
    property <Place> cell: Flight.tile-place;
    property <length> cell-width: min(root.cell.width, root.cell.height * root.aspect);
    property <Place> tile: { x: root.cell.x + (root.cell.width - root.cell-width) / 2, y: root.cell.y + (root.cell.height - root.cell-width / root.aspect) / 2, width: root.cell-width, height: root.cell-width / root.aspect };
    property <Place> to: Flight.route == FlightRoute.into-gallery ? (root.cell.width > 0 ? root.tile : root.canvas)
        : Flight.route == FlightRoute.into-export ? (Flight.slot.width > 0 ? Flight.slot : root.canvas)
        : root.canvas;
    // Laid where it leaves, then off: from then each place it aims at springs it there, turned back midway
    // when a gesture reverses the flight.
    // Off once the window has drawn it where it leaves: a value set as the view is laid would not move.
    property <bool> off;
    Timer { interval: Motion.next-frame; running: !root.off; triggered => { root.off = true; } }
    property <Place> at: root.off ? root.to : Flight.from;
    property <int> serial: Flight.serial;
    changed serial => { Flight.landing = false; root.arrived = false; travel.restart(); }
    // On the export's preview it holds until the preview has landed under it.
    property <bool> arrived;
    changed arrived => { if (root.arrived && (Flight.route != FlightRoute.into-export || Flight.slot-ready)) { Flight.landing = true; } }
    property <bool> slot-ready: Flight.slot-ready;
    changed slot-ready => { if (root.arrived && root.slot-ready) { Flight.landing = true; } }
    Image {
        x: root.at.x;
        y: root.at.y;
        width: root.at.width;
        height: root.at.height;
        animate x, y, width, height { duration: Motion.travel; easing: Ease.weighted; }
        source: Flight.picture;
        image-fit: contain;
        opacity: Flight.landing ? 0 : 1;
        animate opacity { duration: root.handing; easing: ease-out; }
    }
    // Landed on the same picture, the canvas's or the tile's, it hands over at once, never two pictures
    // seen together; on the export's preview, another render, it fades over it.
    property <duration> handing: Flight.route == FlightRoute.into-export ? Motion.quick : 0ms;
    travel := Timer { interval: Motion.travel; running: Flight.flying && !root.arrived; triggered => { root.arrived = true; } }
    Timer { interval: max(Motion.next-frame, root.handing); running: Flight.landing; triggered => { Flight.flying = false; Flight.landing = false; } }
}

// The editor walking to the next or the previous photo: the one left, its picture where the canvas showed
// it, steps aside the way the walk goes and fades as the next one comes in from the other side.
export global Walk {
    in-out property <bool> walking;
    in property <int> serial;
    // What the canvas showed, its texels from the corner as the canvas clips them (0 whole).
    in property <image> picture;
    in property <int> clip-width;
    in property <int> clip-height;
    in property <Place> from;
    // 1 walking forward, -1 back.
    in property <int> way: 1;
}

// Laid in the window's space over the canvas, taking no press.
export component WalkView {
    property <bool> off;
    Timer { interval: Motion.next-frame; running: !root.off; triggered => { root.off = true; } }
    property <int> serial: Walk.serial;
    changed serial => { root.off = false; }
    Image {
        x: Walk.from.x - (root.off ? Walk.way * Motion.walk-step : 0px);
        y: Walk.from.y;
        width: Walk.from.width;
        height: Walk.from.height;
        source: Walk.picture;
        source-clip-width: Walk.clip-width > 0 ? Walk.clip-width : Walk.picture.width;
        source-clip-height: Walk.clip-height > 0 ? Walk.clip-height : Walk.picture.height;
        image-fit: fill;
        opacity: root.off ? 0 : 1;
        animate x, opacity { duration: root.off ? Motion.travel : 0ms; easing: Ease.firm; }
    }
    Timer { interval: Motion.travel; running: root.off; triggered => { Walk.walking = false; } }
}

// Every photo travelling over the screens, laid in the window's space: the flight, and the walk beside a photo.
export component Travels {
    in property <bool> walk;
    in property <Place> frame;
    in property <Place> room;
    if Flight.flying: FlightView { x: 0; y: 0; width: root.width; height: root.height; frame: root.frame; room: root.room; }
    if Walk.walking && root.walk: WalkView { x: 0; y: 0; width: root.width; height: root.height; }
}

// The canvas's side of a walk: the photo walked to comes in from the side the walk goes, faded in.
export component WalkIn {
    property <int> walked: Walk.serial;
    property <bool> walked-in: true;
    changed walked => { root.walked-in = false; arrive.start(); }
    arrive := Timer { interval: Motion.next-frame; running: false; triggered => { self.stop(); root.walked-in = true; } }
    out property <length> shift: root.walked-in ? 0px : Walk.way * Motion.walk-step;
    animate shift { duration: root.walked-in ? Motion.travel : 0ms; easing: Ease.firm; }
    out property <float> fade: root.walked-in ? 1 : 0;
    animate fade { duration: root.walked-in ? Motion.travel : 0ms; easing: Ease.firm; }
}
