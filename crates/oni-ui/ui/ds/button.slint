// The key every screen presses: flat, or a `Keycap` of the Swift app where `keycap` asks for one; its
// kinds and sizes, a glyph, a word or both, a swatch.
import { Colour, Space, Stroke, State, ButtonStyle, ScannerStyle } from "theme.slint";
import { Label, Icon, Tone, Tones, Tip, Tips, Clicks } from "base.slint";

import { Keycap, KeycapVariant, Depth } from "depth.slint";
import { Lamp } from "surfaces.slint";

// `accent` the one primary of a view; `destructive` a plain key whose glyph says the danger; `ghost` a
// glyph alone on no face, its tone lifting under the hand, as a help mark or a star.
export enum ButtonKind { plain, accent, destructive, ghost }
// `regular` the standard key, `plate` a panel's or a footer's at the same height, `mini` the small key
// of a section's header, a row or the canvas's header.
export enum ButtonSize { regular, plate, mini }
// What a check forces a control to look like; `live` follows the pointer.
export enum Look { live, hover, pressed }

export global KeyInk {
    // `LabKeyboard.band`: the ink a fill takes, dark on a light colour, light on a dark one.
    public pure function light(fill: color) -> bool {
        (0.2126 * fill.red + 0.7152 * fill.green + 0.0722 * fill.blue) / 255 > ScannerStyle.light-luma
    }
}

// The legend and the glyph, centred, the lamp at the right: on the key's face, or alone for a ghost.
component Face inherits Rectangle {
    in property <string> word;
    in property <bool> worded;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> turned;
    in property <length> glyph;
    in property <color> ink;
    in property <length> legend;
    in property <length> word-room;
    in property <bool> lamp-shown;
    in property <bool> lamp-lit;
    property <length> lamp-room: root.lamp-shown ? ButtonStyle.lamp + Space.xs : 0px;
    HorizontalLayout {
        alignment: center;
        padding-right: root.lamp-room;
        // No gap beside an empty word, which would push a lone icon off the key's centre.
        spacing: root.worded && root.has-icon ? Space.xs : 0;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: root.glyph;
                height: root.glyph;
                transform-rotation: root.turned ? 90deg : 0deg;
                ink: root.ink;
            }
        }
        legend := Label {
            visible: root.worded;
            // A fixed key elides a word longer than its room rather than spill past its edge.
            width: !root.worded ? 0px : root.word-room > 0 ? min(self.preferred-width, root.word-room) : self.preferred-width;
            overflow: elide;
            ink: root.ink;
            text: root.word;
            font-size: root.legend;
            font-weight: ButtonStyle.legend-weight;
            letter-spacing: ButtonStyle.legend-tracking;
        }
    }
    // `keycapOrnament`: the lamp at the legend's top right, a step past its last letter, on the face.
    if root.lamp-shown: Lamp {
        x: legend.x + legend.width + Space.s - self.width;
        y: (parent.height - root.legend) / 2;
        lit: root.lamp-lit;
    }
}

// A key: a word, a glyph, or both. Flat unless `keycap`, which the few keys that switch the mode, commit
// a screen or run an automatic action ask for: the hand sinks that cap a quarter, a press the whole way.
// A press holds the key down `Depth.min-hold` however short the tap; `on` lights its face.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <ButtonKind> kind: ButtonKind.plain;
    in property <ButtonSize> size: ButtonSize.regular;
    in property <bool> keycap;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> help;
    // A help mark's note, shown at once as a card where `help` waits the tooltip's delay, and the
    // help topic whose demo the card plays above it.
    in property <string> note;
    in property <string> demo;
    // `DSPanelButton`'s capitals, posed here; an AppKit key, as the console's, keeps its word as written.
    in property <bool> capitals: true;
    // The widest word the key ever shows, so it keeps that width as its word changes.
    in property <string> widest;
    in property <length> fixed-width: 0px;
    in property <bool> lamp-shown;
    in property <bool> lamp-lit;
    in property <Look> look: Look.live;
    // `DSPanelButton.fills`: the key takes its share of the room; else it keeps its own width, though
    // a row of keys none of which fills still shares its room out, as a filling plate does.
    in property <bool> fills;
    // `DSPanelButton.rotated`: the glyph turned a quarter for a gesture whose twin the icon bank lacks.
    in property <bool> turned;
    // A face of its own colour instead of its kind's, as a tint's swatch, which `on` rings.
    in property <color> fill: transparent;
    // As wide as tall, a glyph alone.
    in property <bool> square;
    // The glyph's own ink in place of the kind's, as the favourite star's.
    in property <color> glyph-ink: transparent;
    // A glyph drawn at this size instead of the key's, as a help mark's or a row's star.
    in property <length> glyph-size: 0px;
    // A legend at this size instead of the key's, as a step key's larger sign.
    in property <length> legend-size: 0px;
    // Whether ⇧ held the last press, which a stepper reads as three steps.
    out property <bool> shift;
    // `KeycapPress`: the key is down from the press until the release, and `Depth.min-hold` at least.
    out property <bool> down;
    callback clicked();
    property <bool> mini: root.size == ButtonSize.mini;
    property <bool> ghost: root.kind == ButtonKind.ghost;
    property <bool> swatch: root.fill.alpha > 0;
    property <color> tint: root.swatch ? root.fill : root.kind == ButtonKind.accent ? Colour.accent : transparent;
    // The tint, the lit face while on, else the plain one: the keycap's grey or a flat key's.
    property <color> face: root.tint.alpha > 0 ? root.tint : root.on ? ButtonStyle.on : root.keycap ? ButtonStyle.cap : ButtonStyle.face;
    // Lifted before the hold was over: the timer lifts it.
    property <bool> waiting;
    // Lifted while still hovered: going back up to the hover depth is a release, not a press.
    property <bool> lifted;
    property <bool> hovered: root.enabled && (touch.has-hover || root.look == Look.hover);
    property <bool> pressed: root.enabled && (root.look == Look.pressed || root.down);
    property <float> target: root.pressed ? 1 : root.hovered ? Depth.hover-press : 0;
    property <bool> sinking: root.down || (touch.has-hover && !root.lifted);
    property <float> depth: root.keycap ? root.target : 0;
    animate depth {
        duration: root.sinking ? Depth.press-time : Depth.release-time;
        easing: root.sinking ? cubic-bezier(0, 0, 0, 1) : cubic-bezier(0.79, 0.03, 0.43, 1);
    }
    property <length> radius: root.mini ? ButtonStyle.small-radius : ButtonStyle.radius;
    property <length> pad: root.mini ? ButtonStyle.small-padding : ButtonStyle.padding;
    property <length> glyph: root.glyph-size > 0 ? root.glyph-size : root.mini ? ButtonStyle.mini-glyph : ButtonStyle.icon;
    property <length> legend: root.legend-size > 0 ? root.legend-size : root.mini ? ButtonStyle.mini-legend : ButtonStyle.legend;
    property <bool> worded: root.text != "";
    property <string> word: root.capitals ? root.text.to-uppercase() : root.text;
    property <length> lamp-room: root.lamp-shown ? ButtonStyle.lamp + Space.xs : 0px;
    // The glyph's ink: its own, the danger's red on a destructive key, else dark on a light face and
    // light on a dark one; a ghost's lifts under the hand.
    property <color> ink: root.glyph-ink.alpha > 0 ? root.glyph-ink
        : root.ghost ? Tones.ink(root.hovered || touch.pressed ? Tone.primary : Tone.tertiary)
        : root.kind == ButtonKind.destructive ? Colour.destructive-ink
        : Tones.ink(KeyInk.light(root.face) ? Tone.on-light : Tone.on-fill);
    height: root.mini ? ButtonStyle.small-height : root.keycap ? ButtonStyle.cap-height : ButtonStyle.height;
    // Never narrower than tall, so a sign's key stays a square the hand can find.
    min-width: root.square ? self.height
        : root.fixed-width > 0 ? root.fixed-width
        : root.worded ? max(self.height, max(word-measure.preferred-width, measure.preferred-width) + 2 * root.pad + (root.has-icon ? root.glyph + Space.xs : 0px) + root.lamp-room)
        : self.height;
    preferred-width: self.min-width;
    horizontal-stretch: root.fills ? 1 : 0;
    // Out of reach, the whole key fades, its face with its glyph.
    opacity: root.enabled ? 1 : State.disabled;
    accessible-role: button;
    accessible-label: root.worded ? root.text : root.help;
    accessible-enabled: root.enabled;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }

    word-measure := Label {
        visible: false;
        text: root.word;
        font-size: root.legend;
        font-weight: ButtonStyle.legend-weight;
        letter-spacing: ButtonStyle.legend-tracking;
    }
    measure := Label {
        visible: false;
        text: root.capitals ? root.widest.to-uppercase() : root.widest;
        font-size: root.legend;
        font-weight: ButtonStyle.legend-weight;
        letter-spacing: ButtonStyle.legend-tracking;
    }
    if !root.keycap && !root.ghost: Rectangle {
        border-radius: root.radius;
        background: root.face;
    }
    // A flat key and a ghost lie bare, their glyph on the whole key, unmoved.
    Keycap {
        bare: !root.keycap;
        albedo: root.face;
        variant: root.mini ? KeycapVariant.mini : KeycapVariant.small;
        radius: root.keycap ? Depth.corner * self.factor : root.radius;
        depth: root.depth;
        edge-width: root.swatch && root.on ? Stroke.emphasis : 0px;
        edge-color: Colour.accent;
        // The hand's light on the face, the same on a flat key as on a cap, stronger while it presses.
        if !root.ghost: Rectangle {
            border-radius: root.keycap ? Depth.face-corner * parent.factor : root.radius;
            background: root.pressed ? ButtonStyle.veil-pressed : root.hovered ? ButtonStyle.veil : transparent;
        }
        Face {
            word: root.word;
            worded: root.worded;
            icon: root.icon;
            has-icon: root.has-icon;
            turned: root.turned;
            glyph: root.glyph;
            ink: root.ink;
            legend: root.legend;
            word-room: root.fixed-width > 0 ? root.fixed-width - 2 * root.pad - root.lamp-room - (root.has-icon ? root.glyph + Space.xs : 0px) : 0px;
            lamp-shown: root.lamp-shown;
            lamp-lit: root.lamp-lit;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.shift = event.modifiers.shift;
            }
            // A ghost is a mark, not a key: it neither presses nor sounds.
            if (root.ghost || event.button != PointerEventButton.left) { return; }
            if (event.kind == PointerEventKind.down) {
                root.down = true;
                root.waiting = false;
                root.lifted = false;
                hold.running = false;
                hold.running = true;
                Clicks.press();
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (hold.running) { root.waiting = true; } else { root.lift(); }
            }
        }
        changed has-hover => {
            if (!self.has-hover) { root.lifted = false; }
            if (root.note != "") {
                if (self.has-hover) { Tip.demo = root.demo; }
                Tips.note(self.has-hover, root.note, root.absolute-position.x, root.absolute-position.y + root.height, root.absolute-position.y);
            } else {
                // Left, it hides the tooltip it showed, whatever its help says since.
                if (self.has-hover) { root.told = root.help; }
                Tips.hover(self.has-hover, root.told, root.absolute-position.x, root.absolute-position.y + root.height);
            }
        }
    }
    // The help shown under the hand, hidden once it no longer says what the key does.
    property <string> told;
    changed help => { if (touch.has-hover) { Tips.hover(false, root.told, 0px, 0px); } }
    // Disabled under the hand, the key hears no release: it rises at once.
    changed enabled => {
        if (!root.enabled && root.down) {
            hold.running = false;
            root.waiting = false;
            root.lift();
        }
    }
    function lift() {
        root.down = false;
        root.lifted = true;
        // The rise's click follows the cap, not the finger.
        Clicks.release();
    }
    hold := Timer {
        interval: Depth.min-hold;
        running: false;
        triggered => {
            self.running = false;
            if (root.waiting) {
                root.waiting = false;
                root.lift();
            }
        }
    }
}
