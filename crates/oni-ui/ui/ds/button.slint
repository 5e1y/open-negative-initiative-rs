// The key every screen presses: its kinds and sizes, a glyph, a word or both, a keycap's band or a swatch.
import { Colour, Space, Stroke, Type, State, Motion, ButtonStyle, ScannerStyle } from "theme.slint";
import { Label, Icon, TextRole, Tone, Tones, Tips, Clicks } from "base.slint";

import { Dot } from "marks.slint";

// `ghost` is a glyph alone on no ground, its tone lifting under the hand, as a help mark or a star.
export enum ButtonKind { plain, accent, caution, destructive, update, confirm, ghost }
// `key` is a slider's step keycap: square, held down a beat, in the keypad's legend.
export enum ButtonSize { regular, small, key }
// What the board forces a control to look like; `live` follows the pointer.
export enum Look { live, hover, pressed }

export global KeyInk {
    // `LabKeyboard.band`: the ink a fill takes, dark on a light colour, light on a dark one.
    public pure function light(fill: color) -> bool {
        (0.2126 * fill.red + 0.7152 * fill.green + 0.0722 * fill.blue) / 255 > ScannerStyle.light-luma
    }
}

export global ButtonInk {
    // `DSActionButton(tint:)`: the colour a kind lays on its key; none for the plain grey and the ghost.
    public pure function tint(kind: ButtonKind) -> color {
        if (kind == ButtonKind.accent) { return Colour.accent; }
        if (kind == ButtonKind.caution) { return Colour.caution; }
        if (kind == ButtonKind.destructive) { return Colour.destructive; }
        if (kind == ButtonKind.update) { return Colour.update; }
        if (kind == ButtonKind.confirm) { return Colour.confirm; }
        transparent
    }
}

// A flat rounded key: a word, a glyph, or both; `on` lights it as a held toggle, or rings a tinted one.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <ButtonKind> kind: ButtonKind.plain;
    in property <ButtonSize> size: ButtonSize.regular;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> help;
    // A help mark's note, shown at once as a card where `help` waits the tooltip's delay.
    in property <string> note;
    // `DSPanelButton`'s capitals, posed here; an AppKit key, as the console's, keeps its word as written.
    in property <bool> capitals: true;
    // The widest word the key ever shows, so it keeps that width as its word changes.
    in property <string> widest;
    in property <length> fixed-width: 0px;
    in property <bool> lamp-shown;
    in property <bool> lamp-lit;
    in property <Look> look: Look.live;
    // `DSPanelButton.fills`: the key takes its share of the room; else it keeps its own width, though
    // a row of keys none of which fills still shares its room out, as a filling `KeycapPlate` does.
    in property <bool> fills;
    // `DSPanelButton.rotated`: the glyph turned a quarter for a gesture whose twin the icon bank lacks.
    in property <bool> turned;
    // A tint of its own instead of its kind's: a keycap's band, a tint's swatch, which `on` rings.
    in property <color> fill: transparent;
    // As wide as tall, a glyph alone.
    in property <bool> square;
    // The glyph's own ink in place of the kind's, as the favourite star's, and a swatch's ring.
    in property <color> glyph-ink: transparent;
    // A glyph drawn at this size instead of the key's, as a help mark's or a row's star.
    in property <length> glyph-size: 0px;
    // Whether ⇧ held the last press, which a stepper reads as three steps.
    out property <bool> shift;
    callback clicked();
    property <bool> small: root.size == ButtonSize.small;
    property <bool> keycap: root.size == ButtonSize.key;
    property <bool> ghost: root.kind == ButtonKind.ghost;
    property <color> tint: root.fill.alpha > 0 ? root.fill : ButtonInk.tint(root.kind);
    property <bool> tinted: root.tint.alpha > 0;
    property <bool> hovered: root.enabled && (touch.has-hover || root.look == Look.hover);
    // `KeycapPress`: a keycap stays down from the press until `key-hold` has passed, however short the tap.
    out property <bool> down;
    property <duration> pressed-at;
    property <duration> left;
    property <bool> pressed: root.enabled && ((root.keycap ? root.down : touch.pressed) || root.look == Look.pressed);
    property <length> pad: root.keycap ? ScannerStyle.key-padding : root.small ? ButtonStyle.small-padding : ButtonStyle.padding;
    property <length> glyph: root.glyph-size > 0 ? root.glyph-size : root.small ? ButtonStyle.small-icon : ButtonStyle.icon;
    property <bool> worded: root.text != "";
    property <string> word: root.capitals && !root.keycap ? root.text.to-uppercase() : root.text;
    property <length> lamp-room: root.lamp-shown ? ButtonStyle.lamp + Space.xs : 0px;
    // A key's own fill takes its ink by its lightness, as the keypad's bands; a kind's tint keeps
    // `DSActionButton`'s on-fill ink, caution's yellow aside.
    property <Tone> ink: root.ghost ? (root.hovered || root.pressed ? Tone.secondary : Tone.tertiary)
        : root.fill.alpha > 0 ? (KeyInk.light(root.fill) ? Tone.on-light : Tone.on-fill)
        : root.kind == ButtonKind.caution ? Tone.on-light
        : root.tinted ? Tone.on-fill
        : root.on ? Tone.on-light : Tone.primary;
    height: root.keycap || root.small ? ButtonStyle.small-height : ButtonStyle.height;
    min-width: root.square || root.keycap ? self.height
        : root.fixed-width > 0 ? root.fixed-width
        : root.worded ? max(word-label.preferred-width, measure.preferred-width) + 2 * root.pad + (root.has-icon ? root.glyph + Space.xs : 0px) + root.lamp-room
        : self.height;
    preferred-width: self.min-width;
    horizontal-stretch: root.fills ? 1 : 0;
    border-radius: root.keycap ? ScannerStyle.key-radius : root.small ? ButtonStyle.small-radius : ButtonStyle.radius;
    // `KeycapPress`: the cap sinks, a quarter under the hand and whole pressed, its face never changing
    // colour; shrunk, it shows its socket round it.
    property <float> depth: root.ghost ? 0 : root.pressed ? 1 : root.hovered ? ButtonStyle.hover-depth : 0;
    property <float> scale: 1 - (1 - ButtonStyle.pressed-scale) * root.depth;
    background: root.depth > 0 ? ButtonStyle.bezel : transparent;
    opacity: root.enabled ? 1 : State.disabled;
    accessible-role: button;
    accessible-label: root.worded ? root.text : root.help;
    accessible-enabled: root.enabled;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    animate depth { duration: Motion.quick; easing: ease-out; }

    Rectangle {
        width: parent.width * root.scale;
        height: parent.height * root.scale;
        border-radius: parent.border-radius * root.scale;
        background: root.ghost ? transparent : root.tinted ? root.tint : root.on ? Colour.on : Colour.raised;
        border-width: root.tinted && root.on ? Stroke.emphasis : 0px;
        border-color: root.glyph-ink.alpha > 0 ? root.glyph-ink : Colour.ink;
    }
    measure := Label {
        visible: false;
        role: TextRole.button;
        text: root.capitals ? root.widest.to-uppercase() : root.widest;
    }
    HorizontalLayout {
        y: ButtonStyle.travel * root.depth;
        alignment: center;
        padding-right: root.lamp-room;
        // No gap beside an empty word, which would push a lone icon off the key's centre.
        spacing: root.worded && root.has-icon ? Space.xs : 0;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: root.glyph;
                height: root.glyph;
                transform-rotation: root.turned ? 90deg : 0deg;
                tone: root.ink;
                ink: root.glyph-ink.alpha > 0 ? root.glyph-ink : Tones.ink(root.ink);
            }
        }
        word-label := Label {
            visible: root.worded;
            // A fixed key elides a word longer than its room rather than spill past its edge.
            width: !root.worded ? 0px : root.fixed-width > 0 ? min(self.preferred-width, root.fixed-width - 2 * root.pad - root.lamp-room - (root.has-icon ? root.glyph + Space.xs : 0px)) : self.preferred-width;
            overflow: elide;
            // The legend's face on a keycap, which the button role's tracking would spread.
            role: root.keycap ? TextRole.label : TextRole.button;
            tone: root.ink;
            text: root.word;
            font-size: root.keycap ? ScannerStyle.legend : Type.chip;
            font-weight: root.keycap ? Type.medium : Type.strong;
        }
    }
    if root.lamp-shown: Dot {
        size: ButtonStyle.lamp;
        x: parent.width - root.pad - self.width;
        y: (parent.height - self.height) / 2 + ButtonStyle.travel * root.depth;
        ink: root.lamp-lit ? Colour.confirm : Colour.track;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.shift = event.modifiers.shift;
            }
        }
        changed has-hover => {
            if (root.note != "") {
                Tips.note(self.has-hover, root.note, root.absolute-position.x, root.absolute-position.y + root.height);
            } else {
                Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height);
            }
        }
        changed pressed => {
            // A ghost is a mark, not a key: it makes no sound.
            if (!root.keycap) {
                if (root.ghost) {
                } else if (self.pressed) { Clicks.press(); } else { Clicks.release(); }
            } else if (self.pressed) {
                lift.running = false;
                root.down = true;
                root.pressed-at = animation-tick();
                Clicks.press();
            } else {
                root.left = ScannerStyle.key-hold - (animation-tick() - root.pressed-at);
                if (root.left <= 0ms) {
                    root.down = false;
                    Clicks.release();
                } else {
                    lift.running = true;
                }
            }
        }
    }
    lift := Timer {
        interval: root.left;
        running: false;
        triggered => {
            self.running = false;
            root.down = false;
            // The rise's click follows the cap, not the finger.
            Clicks.release();
        }
    }
}
