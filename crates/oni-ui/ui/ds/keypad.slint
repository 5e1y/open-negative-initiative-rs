// The Scanner face's keypad and screen: `LabKeyboard`, `LabStepKeys`, `LabStack` and `LabScreen`.
import { Colour, Space, Stroke, State, Motion, ScannerStyle, SliderStyle } from "theme.slint";
import { Label, Tone, Tips, Clicks, TextRole } from "base.slint";
import { Look } from "controls.slint";

export global KeyInk {
    // `LabKeyboard.band`: the ink a fill takes, dark on a light colour, light on a dark one.
    public pure function light(fill: color) -> bool {
        (0.2126 * fill.red + 0.7152 * fill.green + 0.0722 * fill.blue) / 255 > ScannerStyle.light-luma
    }
}

// One key of the keypad, coloured whole by its fill; `wide` pins it beside keys of free width.
export component Key inherits Rectangle {
    in property <string> legend;
    in property <color> fill: ScannerStyle.cap-light;
    in property <bool> wide;
    in property <string> help;
    in property <Look> look: Look.live;
    callback clicked();
    property <bool> hovered: touch.has-hover || root.look == Look.hover;
    // `KeycapPress`: the cap drawn down from the press until `key-hold` has passed, however short the tap.
    out property <bool> down;
    property <duration> pressed-at;
    property <duration> left;
    property <bool> pressed: root.down || root.look == Look.pressed;
    // Whether ⇧ held the last press, which a stepper reads as three steps.
    out property <bool> shift;
    height: ScannerStyle.key-height;
    min-width: root.wide ? ScannerStyle.wide-key : word.preferred-width + 2 * ScannerStyle.key-padding;
    // Narrow keys start from one width, so a longer legend does not widen its own key.
    preferred-width: root.wide ? ScannerStyle.wide-key : ScannerStyle.key-height;
    horizontal-stretch: root.wide ? 0 : 1;
    border-radius: ScannerStyle.key-radius;
    background: root.pressed ? root.fill.darker(0.2) : root.hovered ? root.fill.brighter(0.1) : root.fill;
    accessible-role: button;
    accessible-label: root.help != "" ? root.help : root.legend;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Motion.quick; }
    word := Label {
        width: parent.width;
        height: parent.height;
        text: root.legend;
        centred: true;
        font-size: ScannerStyle.legend;
        font-weight: ScannerStyle.label-weight;
        tone: KeyInk.light(root.fill) ? Tone.on-light : Tone.on-fill;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.shift = event.modifiers.shift;
            }
        }
        changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
        changed pressed => {
            if (self.pressed) {
                lift.running = false;
                root.down = true;
                root.pressed-at = animation-tick();
                Clicks.press();
            } else {
                root.left = ScannerStyle.key-hold - (animation-tick() - root.pressed-at);
                if (root.left <= 0ms) {
                    root.down = false;
                    Clicks.release();
                } else {
                    lift.running = true;
                }
            }
        }
    }
    lift := Timer {
        interval: root.left;
        running: false;
        triggered => {
            self.running = false;
            root.down = false;
            // The rise's click follows the cap, not the finger.
            Clicks.release();
        }
    }
}

// A letter's or a finish's five keys: three and one toward `minus`, the title back to rest, one and
// three toward `plus`. `helps` holds the five tooltips in that order.
export component KeyRow inherits HorizontalLayout {
    in property <string> title;
    in property <[string]> legends: ["−3", "−", "+", "+3"];
    in property <color> minus;
    in property <color> plus;
    in property <[string]> helps;
    callback stepped(int);
    callback reset();
    spacing: ScannerStyle.key-gap;
    Key { legend: root.legends[0]; fill: root.minus; help: root.helps[0]; clicked => { root.stepped(-3); } }
    Key { legend: root.legends[1]; fill: root.minus; help: root.helps[1]; clicked => { root.stepped(-1); } }
    Key { legend: root.title; wide: true; help: root.helps[2]; clicked => { root.reset(); } }
    Key { legend: root.legends[2]; fill: root.plus; help: root.helps[3]; clicked => { root.stepped(1); } }
    Key { legend: root.legends[3]; fill: root.plus; help: root.helps[4]; clicked => { root.stepped(3); } }
}

// `LabStack`: the keypad's rows on one socket.
export component Keypad inherits Rectangle {
    border-radius: ScannerStyle.socket-radius;
    background: ScannerStyle.socket;
    height: rows.preferred-height;
    rows := VerticalLayout {
        padding: ScannerStyle.key-gap;
        spacing: ScannerStyle.key-gap;
        @children
    }
}

export struct LabCell { title: string, value: string }

component Lcd inherits Label {
    in property <bool> large;
    font-family: ScannerStyle.mono;
    font-size: root.large ? ScannerStyle.screen-value : ScannerStyle.screen-label;
    font-weight: root.large ? ScannerStyle.value-weight : ScannerStyle.label-weight;
    color: ScannerStyle.lcd-ink;
}

// `LabScreen`: the scanner's screen in the plot band, its frame, its machine, every letter's count
// and the finishing's values, behind scanlines.
export component LabScreen inherits Rectangle {
    in property <string> frame;
    in property <string> machine;
    in property <bool> remeasure;
    in property <string> remeasure-help;
    in property <[LabCell]> cells;
    in property <[string]> finish;
    background: ScannerStyle.glass;
    clip: true;
    VerticalLayout {
        padding: Space.m;
        HorizontalLayout {
            Lcd { text: root.frame; }
            Rectangle { horizontal-stretch: 1; }
            if root.remeasure: Lcd {
                text: @tr("REMEASURE ROLL");
                TouchArea {
                    changed has-hover => { Tips.hover(self.has-hover, root.remeasure-help, self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
            if root.remeasure: Rectangle { horizontal-stretch: 1; }
            Lcd { text: root.machine; }
        }
        Rectangle { min-height: Space.xs; vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Space.s;
            // Equal columns, so a value growing a digit never moves the others.
            for cell in root.cells: VerticalLayout {
                width: (parent.width - (root.cells.length - 1) * Space.s) / max(1, root.cells.length);
                spacing: Space.xxs;
                Lcd { text: cell.title; horizontal-alignment: center; }
                Lcd { text: cell.value; large: true; horizontal-alignment: center; }
            }
        }
        Rectangle { min-height: Space.xs; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: space-between;
            for line in root.finish: Lcd { text: line; }
        }
    }
    for i in floor(root.height / ScannerStyle.scanline-pitch): Rectangle {
        y: i * ScannerStyle.scanline-pitch;
        height: Stroke.line;
        background: ScannerStyle.scanline;
    }
}

// A letter's or a finish's slider on the Scanner face: whole steps between `low` and `high`, the rail
// running from `minus` to `plus`, a key either side for one step (three with ⇧); a double click rests it.
export component StepSlider inherits VerticalLayout {
    in property <string> title;
    in property <string> readout;
    in property <int> value;
    in property <int> low;
    in property <int> high;
    in property <color> minus;
    in property <color> plus;
    // The tooltips of the minus key, the title and the plus key.
    in property <string> minus-help;
    in property <string> title-help;
    in property <string> plus-help;
    in property <bool> enabled: true;
    in property <Look> look: Look.live;
    callback stepped(int);
    callback reset();
    // A press on the rail holds the edit, so a whole slide is one step to undo.
    callback held(bool);
    // The step under the hand while it slides, ahead of the value the store answers.
    property <int> hand;
    property <bool> sliding;
    property <int> shown: root.sliding ? root.hand : root.value;
    property <float> at: (root.shown - root.low) / max(1, root.high - root.low);
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.title;
    accessible-value: root.readout;
    accessible-action-increment => { root.stepped(1); }
    accessible-action-decrement => { root.stepped(-1); }
    pure function step-at(x: length, width: length) -> int {
        root.low + round(clamp(x / max(1px, width), 0, 1) * (root.high - root.low))
    }
    HorizontalLayout {
        spacing: Space.s;
        opacity: root.enabled ? 1 : State.disabled;
        Label {
            text: root.title;
            overflow: elide;
            horizontal-stretch: 1;
            TouchArea {
                double-clicked => { root.reset(); }
                changed has-hover => { Tips.hover(self.has-hover, root.title-help, self.absolute-position.x, self.absolute-position.y + self.height); }
            }
        }
        Label { text: root.readout; role: TextRole.value; tone: Tone.secondary; horizontal-alignment: right; }
    }
    HorizontalLayout {
        spacing: Space.s;
        Key {
            y: (SliderStyle.row - ScannerStyle.step-key) / 2;
            legend: "−";
            fill: root.minus;
            help: root.minus-help;
            horizontal-stretch: 0;
            width: ScannerStyle.step-key;
            height: ScannerStyle.step-key;
            clicked => { root.stepped(self.shift ? -3 : -1); }
        }
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            horizontal-stretch: 1;
            track := Rectangle {
                height: SliderStyle.row;
                opacity: root.enabled ? 1 : State.disabled;
                Rectangle {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    height: SliderStyle.track;
                    border-radius: SliderStyle.track-radius;
                    background: @linear-gradient(90deg, root.minus 0%, root.plus 100%);
                }
                // Rest, where the title's double click brings it back.
                Rectangle {
                    x: parent.width * (0 - root.low) / max(1, root.high - root.low) - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: Stroke.line;
                    height: SliderStyle.knob-height / 2;
                    background: SliderStyle.grip-ink;
                }
                Rectangle {
                    property <float> grow: (area.has-hover || root.sliding || root.look != Look.live) ? SliderStyle.knob-grow : 1;
                    width: SliderStyle.knob-width * self.grow;
                    height: SliderStyle.knob-height * self.grow;
                    x: parent.width * root.at - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: SliderStyle.knob-radius;
                    background: SliderStyle.knob;
                    border-width: Stroke.line;
                    border-color: SliderStyle.knob-edge;
                    animate grow { duration: Motion.quick; easing: ease-out-back; }
                    animate x { duration: Motion.quick; }
                }
                area := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.sliding ? MouseCursor.grabbing : MouseCursor.grab;
                    double-clicked => { root.reset(); }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.hand = root.step-at(self.mouse-x, track.width);
                            root.sliding = true;
                            root.held(true);
                            if (root.hand != root.value) {
                                root.stepped(root.hand - root.value);
                            }
                        } else if (root.sliding && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                            root.sliding = false;
                            root.held(false);
                        }
                    }
                    moved => {
                        if (root.sliding) {
                            let next = root.step-at(self.mouse-x, track.width);
                            if (next != root.hand) {
                                root.stepped(next - root.hand);
                                root.hand = next;
                            }
                        }
                    }
                }
            }
        }
        Key {
            y: (SliderStyle.row - ScannerStyle.step-key) / 2;
            legend: "+";
            fill: root.plus;
            help: root.plus-help;
            horizontal-stretch: 0;
            width: ScannerStyle.step-key;
            height: ScannerStyle.step-key;
            clicked => { root.stepped(self.shift ? 3 : 1); }
        }
    }
}
