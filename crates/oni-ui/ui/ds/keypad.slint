// The Scanner face's keypad and screen: `LabKeyboard`, `LabStepKeys`, `LabStack` and `LabScreen`.
import { Colour, Space, Stroke, State, Motion, ScannerStyle, SliderStyle } from "theme.slint";
import { Label, Tone, Tips, Clicks, TextRole } from "base.slint";
import { Look, Button, ButtonSize } from "controls.slint";
import { SliderFill, Knob, Rail, ValueHeader } from "slider.slint";

export struct LabCell { title: string, value: string }

component Lcd inherits Label {
    in property <bool> large;
    font-family: ScannerStyle.mono;
    font-size: root.large ? ScannerStyle.screen-value : ScannerStyle.screen-label;
    font-weight: root.large ? ScannerStyle.value-weight : ScannerStyle.label-weight;
    color: ScannerStyle.lcd-ink;
}

// `LabScreen`: the scanner's screen in the plot band, its frame, its machine, every letter's count
// and the finishing's values, behind scanlines.
export component LabScreen inherits Rectangle {
    in property <string> frame;
    in property <string> machine;
    in property <bool> remeasure;
    in property <string> remeasure-help;
    in property <[LabCell]> cells;
    in property <[string]> finish;
    background: ScannerStyle.glass;
    clip: true;
    VerticalLayout {
        padding: Space.m;
        HorizontalLayout {
            Lcd { text: root.frame; }
            Rectangle { horizontal-stretch: 1; }
            if root.remeasure: Lcd {
                text: @tr("REMEASURE ROLL");
                TouchArea {
                    changed has-hover => { Tips.hover(self.has-hover, root.remeasure-help, self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
            if root.remeasure: Rectangle { horizontal-stretch: 1; }
            Lcd { text: root.machine; }
        }
        Rectangle { min-height: Space.xs; vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Space.s;
            // Equal columns, so a value growing a digit never moves the others.
            for cell in root.cells: VerticalLayout {
                width: (parent.width - (root.cells.length - 1) * Space.s) / max(1, root.cells.length);
                spacing: Space.xxs;
                Lcd { text: cell.title; horizontal-alignment: center; }
                Lcd { text: cell.value; large: true; horizontal-alignment: center; }
            }
        }
        Rectangle { min-height: Space.xs; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: space-between;
            for line in root.finish: Lcd { text: line; }
        }
    }
    for i in floor(root.height / ScannerStyle.scanline-pitch): Rectangle {
        y: i * ScannerStyle.scanline-pitch;
        height: Stroke.line;
        background: ScannerStyle.scanline;
    }
}

// A letter's or a finish's slider on the Scanner face: whole steps between `low` and `high`, the rail
// running from `minus` to `plus`, a key either side for one step (three with ⇧); a double click rests it.
export component StepSlider inherits VerticalLayout {
    in property <string> title;
    in property <string> readout;
    in property <int> value;
    in property <int> low;
    in property <int> high;
    in property <color> minus;
    in property <color> plus;
    // The tooltips of the minus key, the title and the plus key.
    in property <string> minus-help;
    in property <string> title-help;
    in property <string> plus-help;
    in property <bool> enabled: true;
    in property <Look> look: Look.live;
    callback stepped(int);
    callback reset();
    // A press on the rail holds the edit, so a whole slide is one step to undo.
    callback held(bool);
    // The step under the hand while it slides, ahead of the value the store answers.
    property <int> hand;
    property <bool> sliding;
    property <int> shown: root.sliding ? root.hand : root.value;
    property <float> at: (root.shown - root.low) / max(1, root.high - root.low);
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.title;
    accessible-value: root.readout;
    accessible-action-increment => { root.stepped(1); }
    accessible-action-decrement => { root.stepped(-1); }
    pure function step-at(x: length, width: length) -> int {
        root.low + round(clamp(x / max(1px, width), 0, 1) * (root.high - root.low))
    }
    ValueHeader {
        label: root.title;
        value: root.readout;
        enabled: root.enabled;
        resets: true;
        help: root.title-help;
        reset => { root.reset(); }
    }
    HorizontalLayout {
        spacing: Space.s;
        Button {
            size: ButtonSize.key;
            y: (SliderStyle.row - ScannerStyle.step-key) / 2;
            text: "−";
            fill: root.minus;
            help: root.minus-help;
            horizontal-stretch: 0;
            width: ScannerStyle.step-key;
            height: ScannerStyle.step-key;
            clicked => { root.stepped(self.shift ? -3 : -1); }
        }
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            horizontal-stretch: 1;
            track := Rectangle {
                height: SliderStyle.row;
                opacity: root.enabled ? 1 : State.disabled;
                Rail {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    overhang: SliderStyle.knob-width / 2;
                    fill: SliderFill.bipolar;
                    low: root.minus;
                    high: root.plus;
                    // Rest, where the title's double click brings it back.
                    rest: (0 - root.low) / max(1, root.high - root.low);
                }
                Knob {
                    centre: parent.width * root.at;
                    grip: false;
                    grown: area.has-hover || root.sliding || root.look != Look.live;
                    slide: true;
                }
                area := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.sliding ? MouseCursor.grabbing : MouseCursor.grab;
                    double-clicked => { root.reset(); }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.hand = root.step-at(self.mouse-x, track.width);
                            root.sliding = true;
                            root.held(true);
                            if (root.hand != root.value) {
                                root.stepped(root.hand - root.value);
                            }
                        } else if (root.sliding && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                            root.sliding = false;
                            root.held(false);
                        }
                    }
                    moved => {
                        if (root.sliding) {
                            let next = root.step-at(self.mouse-x, track.width);
                            if (next != root.hand) {
                                root.stepped(next - root.hand);
                                root.hand = next;
                            }
                        }
                    }
                }
            }
        }
        Button {
            size: ButtonSize.key;
            y: (SliderStyle.row - ScannerStyle.step-key) / 2;
            text: "+";
            fill: root.plus;
            help: root.plus-help;
            horizontal-stretch: 0;
            width: ScannerStyle.step-key;
            height: ScannerStyle.step-key;
            clicked => { root.stepped(self.shift ? 3 : 1); }
        }
    }
}
