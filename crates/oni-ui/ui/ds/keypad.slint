// The Scanner face's keypad and screen: `LabKeyboard`, `LabStepKeys`, `LabStack` and `LabScreen`.
import { Space, ScannerStyle, PlotStyle } from "theme.slint";
import { Tips } from "base.slint";
import { CrtScreen, CrtLine as Lcd } from "crt.slint";

export struct LabCell { title: string, value: string }

// `LabScreen`: the scanner's screen in the readout, its frame, its machine and every letter's count,
// glowing behind scanlines.
export component LabScreen inherits Rectangle {
    in property <string> frame;
    in property <string> machine;
    in property <bool> remeasure;
    in property <string> remeasure-help;
    in property <[LabCell]> cells;
    // The widest count a letter reaches: every count takes the size that holds it whole in its column.
    in property <string> widest;
    in property <length> radius: PlotStyle.radius;
    property <length> column: (root.width - 2 * Space.m) / max(1, root.cells.length);
    property <float> fit: min(1, (root.column - Space.xs) / max(1px, measure.preferred-width));
    measure := Lcd { text: root.widest; large: true; visible: false; }
    CrtScreen {
        radius: root.radius;
        VerticalLayout {
            padding: Space.m;
            HorizontalLayout {
                Lcd { text: root.frame; }
                Rectangle { horizontal-stretch: 1; }
                if root.remeasure: Lcd {
                    text: @tr("REMEASURE ROLL");
                    TouchArea {
                        changed has-hover => { Tips.hover(self.has-hover, root.remeasure-help, self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                }
                if root.remeasure: Rectangle { horizontal-stretch: 1; }
                Lcd { text: root.machine; }
            }
            Rectangle { min-height: Space.xs; vertical-stretch: 1; }
            HorizontalLayout {
                // Equal columns, so a value growing a digit never moves the others; centred, they need no gap.
                for cell in root.cells: VerticalLayout {
                    width: parent.width / max(1, root.cells.length);
                    spacing: Space.xxs;
                    Lcd { text: cell.title; horizontal-alignment: center; }
                    Lcd { text: cell.value; large: true; font-size: ScannerStyle.screen-value * root.fit; horizontal-alignment: center; }
                }
            }
            Rectangle { min-height: Space.xs; vertical-stretch: 1; }
        }
    }
}
