// `DSTabBar`, the segmented tabs.
import { Colour, Space, State, Motion, TabsStyle, ButtonStyle } from "theme.slint";
import { Label, Tips, Clicks } from "base.slint";
import { Dot } from "marks.slint";

// `DSTabBar` as a segmented control: one raised pill under the selection. Its owner holds the choice:
// a click only asks, so a binding on `selected` keeps following the owner's value.
export component Tabs inherits Rectangle {
    in property <[string]> tabs;
    in property <int> selected;
    in property <[bool]> marked;
    // A colour per tab drawn in place of its name, which stays the tab's accessible label.
    in property <[color]> swatches;
    // The tab the state board shows hovered; -1 follows the pointer alone.
    in property <int> hover-tab: -1;
    callback picked(int);
    height: ButtonStyle.height;
    clip: true;
    border-radius: ButtonStyle.radius;
    background: Colour.canvas;
    property <length> pitch: (self.width - 2 * TabsStyle.inset) / max(1, root.tabs.length);
    Rectangle {
        x: TabsStyle.inset + root.selected * root.pitch;
        y: TabsStyle.inset;
        width: root.pitch;
        height: parent.height - 2 * TabsStyle.inset;
        border-radius: TabsStyle.pill-radius;
        background: Colour.raised;
        animate x { duration: Motion.slide; easing: ease-out; }
    }
    for name[i] in root.tabs: Rectangle {
        x: TabsStyle.inset + i * root.pitch;
        y: TabsStyle.inset;
        width: root.pitch;
        height: parent.height - 2 * TabsStyle.inset;
        accessible-role: tab;
        accessible-label: name;
        if root.swatches.length == 0: Label {
            text: name;
            centred: true;
            opacity: (i == root.selected || touch.has-hover || i == root.hover-tab) ? 1 : State.idle;
        }
        if root.swatches.length > 0: Dot {
            size: TabsStyle.swatch;
            ink: root.swatches[i];
        }
        if root.marked[i]: Dot {
            x: parent.width - self.width - Space.xs;
            y: Space.xs;
            size: TabsStyle.mark;
            ink: Colour.accent;
        }
        touch := TouchArea {
            clicked => {
                if (i != root.selected) { Clicks.press(); }
                root.picked(i);
            }
            // A swatch shows no name, so its tab gives it in the tooltip.
            changed has-hover => {
                if root.swatches.length > 0 {
                    Tips.hover(self.has-hover, name, self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
        }
    }
}
