// `DSTabBar`, the segmented tabs.
import { Colour, State, TabsStyle } from "theme.slint";
import { Label, Tips, Clicks } from "base.slint";
import { Dot } from "marks.slint";
import { Inward, Outward } from "depth.slint";
import { KeyScope } from "keyboard.slint";

// `DSTabBar`: a hollow cut down to the canvas, one raised pill sliding under the selection on the grab
// spring; a tab answers hover with its label alone. Its owner holds the choice: a click only asks, so a
// binding on `selected` keeps following the owner's value.
export component Tabs inherits Rectangle {
    in property <[string]> tabs;
    in property <int> selected;
    in property <[bool]> marked;
    // A colour per tab drawn in place of its name, which stays the tab's accessible label.
    in property <[color]> swatches;
    // Tabs drawn fainter, still pressable: choosing one changes something else.
    in property <[bool]> dimmed;
    // Tabs out of reach: drawn at the disabled state's opacity, deaf to the pointer.
    in property <[bool]> disabled;
    // The tab a check or the lab shows hovered; -1 follows the pointer alone.
    in property <int> hover-tab: -1;
    callback picked(int);
    // A selection outside the tabs, as De-dust's, shows no pill; it waits where it stood, so it never slides out.
    out property <bool> pill-shown: root.selected >= 0 && root.selected < root.tabs.length;
    // The held tab's place, written by that tab once laid: tabs share the bar evenly unless a label needs more.
    out property <length> pill-x;
    out property <length> pill-width;
    property <int> held;
    // A change of tab slides the pill; a change of layout moves it at once, so a resize never trails it.
    property <bool> sliding;
    function hold(x: length, width: length, slide: bool) {
        root.sliding = slide;
        root.pill-x = x;
        root.pill-width = width;
    }
    // The tab `by` from the one picked, the first or the last while none is, passing over one out of reach.
    function pick-beside(by: int) {
        let from = root.pill-shown ? root.selected : by > 0 ? -1 : root.tabs.length;
        let next = root.disabled[from + by] ? from + 2 * by : from + by;
        if (next >= 0 && next < root.tabs.length && !root.disabled[next]) { root.picked(next); }
    }
    init => { if (self.pill-shown) { root.held = root.selected; } }
    changed pill-shown => { if (self.pill-shown) { root.held = root.selected; } }
    changed selected => { if (self.pill-shown) { root.held = root.selected; } }
    height: TabsStyle.height;
    Inward {
        hollow: true;
        ground: Colour.canvas;
        radius: root.height / 2;
        shade: TabsStyle.track-shade;
        Outward {
            visible: root.pill-shown;
            x: root.pill-x;
            y: TabsStyle.inset;
            width: root.pill-width;
            height: root.height - 2 * TabsStyle.inset;
            radius: self.height / 2;
            fill: TabsStyle.pill;
            animate x, width { duration: root.sliding ? TabsStyle.slide : 0ms; easing: spring(0.38); }
        }
        HorizontalLayout {
            padding: TabsStyle.inset;
            spacing: TabsStyle.gap;
            for name[i] in root.tabs: Rectangle {
                property <bool> holds: i == root.held;
                min-width: (root.swatches.length > 0 ? TabsStyle.swatch : label.preferred-width) + 2 * TabsStyle.margin;
                preferred-width: TabsStyle.reach;
                horizontal-stretch: 1;
                init => { if (self.holds) { root.hold(self.x, self.width, false); } }
                changed holds => { if (self.holds) { root.hold(self.x, self.width, true); } }
                changed x => { if (self.holds) { root.hold(self.x, self.width, false); } }
                changed width => { if (self.holds) { root.hold(self.x, self.width, false); } }
                accessible-role: tab;
                accessible-label: name;
                opacity: root.disabled[i] ? State.disabled
                    : (i == root.selected || touch.has-hover || i == root.hover-tab ? 1 : TabsStyle.idle)
                    * (root.dimmed[i] && i != root.selected ? TabsStyle.idle : 1);
                label := Label {
                    visible: root.swatches.length == 0;
                    text: name;
                    centred: true;
                }
                if root.swatches.length > 0: Dot {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: TabsStyle.swatch;
                    ink: root.swatches[i];
                }
                if root.marked[i]: Dot {
                    x: parent.width - self.width - TabsStyle.mark-inset;
                    y: TabsStyle.mark-inset;
                    size: TabsStyle.mark;
                    ink: Colour.accent;
                }
                touch := TouchArea {
                    enabled: !root.disabled[i];
                    clicked => {
                        if (i != root.selected) { Clicks.press(); }
                        root.picked(i);
                    }
                    // A swatch shows no name, so its tab gives it in the tooltip.
                    changed has-hover => {
                        if root.swatches.length > 0 {
                            Tips.hover(self.has-hover, name, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }
                }
            }
        }
    }
    // The bar takes Tab as one control, the arrows picking the tab beside, as a radio group does.
    KeyScope {
        radius: root.height / 2;
        key-pressed(event) => {
            let by = event.text == Key.RightArrow ? 1 : event.text == Key.LeftArrow ? -1 : 0;
            if (by == 0 || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                return reject;
            }
            root.pick-beside(by);
            accept
        }
    }
}
