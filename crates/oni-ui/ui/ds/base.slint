// The primitives every screen composes: text, glyphs, pictures, surfaces, rules and stacks.
// Inter's digits and its + − × are mapped to their tabular forms, so a value keeps its width as it changes.
import "../../fonts/Inter.ttf";
import "../../fonts/Enriqueta-Regular.ttf";
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, Motion, ButtonStyle, CardStyle, ScannerStyle } from "theme.slint";
import { Outward } from "depth.slint";

// `note` is a block's wrapped line in the secondary ink, a label's size, its lines opened; `section` a
// block's title, a step larger and heavier than the words under it; `title` a mode's or a sheet's, a step over that.
export enum TextRole { label, value, caption, title, section, heading, button, note }
// `lcd` reads on the scanner's glass.
export enum Tone { primary, secondary, tertiary, on-fill, on-light, warning, caution, lcd }
export enum Gap { none, xxs, xs, s, m, l }
export enum Ground { ground, canvas, canvas-cropping, sheet, well, paper, skeleton }
// How a picture meets its box: whole inside it, filling it cropped, or stretched to it.
export enum Fit { contain, cover, fill }

// Where a note lands: its corner and its size, in the window's points.
export struct TipBox {
    x: length,
    y: length,
    width: length,
    height: length,
}

// What a hovered control says after the system's tooltip delay, drawn by `TipLayer`; and the help card
// open in its block, one at a time.
export global Tip {
    in-out property <string> text;
    // The control's corner the note hangs from: its foot, or its head when the note stands `above` it.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> above;
    in-out property <bool> shown;
    // The note of the help card open, none for no card; `demo` its help topic, Rust's key to its clip;
    // `subject` what it explains, as its mark's title says it.
    in-out property <string> open;
    in-out property <string> demo;
    in-out property <string> subject;
    // Starts the topic's clip, a topic without one or none stopping it; `advance` lays its next frame.
    callback play(string);
    callback advance();
    // The clip's frame, how long until the next, and whether the topic has one: none, no picture.
    in-out property <image> clip;
    in-out property <duration> delay;
    in-out property <bool> has-clip;
}

export global Tones {
    public pure function ink(tone: Tone) -> color {
        if (tone == Tone.secondary) { return Colour.ink-secondary; }
        if (tone == Tone.tertiary) { return Colour.ink-tertiary; }
        if (tone == Tone.on-fill) { return Colour.ink-on-fill; }
        if (tone == Tone.on-light) { return Colour.ink-on-light; }
        if (tone == Tone.warning) { return Colour.warning; }
        if (tone == Tone.caution) { return Colour.caution; }
        if (tone == Tone.lcd) { return ScannerStyle.lcd-ink; }
        Colour.ink
    }
    public pure function gap(gap: Gap) -> length {
        if (gap == Gap.xxs) { return Space.xxs; }
        if (gap == Gap.xs) { return Space.xs; }
        if (gap == Gap.s) { return Space.s; }
        if (gap == Gap.m) { return Space.m; }
        if (gap == Gap.l) { return Space.l; }
        0px
    }
    public pure function ground(ground: Ground) -> color {
        if (ground == Ground.canvas) { return Colour.canvas; }
        if (ground == Ground.canvas-cropping) { return Colour.canvas-cropping; }
        if (ground == Ground.sheet) { return Colour.black; }
        if (ground == Ground.well) { return Colour.well; }
        if (ground == Ground.paper) { return Colour.white; }
        if (ground == Ground.skeleton) { return Colour.skeleton; }
        Colour.ground
    }
}

// A role's size and weight, which a label and a field typed over it share.
export global Roles {
    public pure function size(role: TextRole) -> length {
        if (role == TextRole.value || role == TextRole.caption || role == TextRole.button) { return Type.caption; }
        if (role == TextRole.title) { return Type.title; }
        if (role == TextRole.section) { return Type.section; }
        if (role == TextRole.heading) { return Type.heading; }
        Type.label
    }
    public pure function weight(role: TextRole) -> int {
        if (role == TextRole.title) { return Type.bold; }
        if (role == TextRole.button || role == TextRole.section) { return Type.strong; }
        Type.regular
    }
}

// Every word on screen: its role sets the face and size, its tone the ink, unless it has an ink of its own.
export component Label inherits Text {
    in property <TextRole> role: TextRole.label;
    in property <Tone> tone: root.role == TextRole.note ? Tone.secondary : Tone.primary;
    in property <color> ink: Tones.ink(root.tone);
    in property <bool> centred;
    font-family: Type.family;
    font-size: Roles.size(root.role);
    font-weight: Roles.weight(root.role);
    line-height-factor: root.role == TextRole.note ? Type.leading : 1;
    letter-spacing: root.role == TextRole.button ? ButtonStyle.tracking : 0px;
    color: root.ink;
    vertical-alignment: center;
    horizontal-alignment: root.centred ? center : left;
    wrap: root.role == TextRole.note ? word-wrap : no-wrap;
}

// A glyph tinted by a tone, square at the size it is given.
export component Icon inherits Image {
    in property <Tone> tone: Tone.secondary;
    in property <color> ink: Tones.ink(root.tone);
    colorize: root.ink;
    image-fit: contain;
}

// A photograph or a plot on its ground, never stretched unless asked.
export component Picture inherits Rectangle {
    in property <image> source;
    in property <Ground> ground: Ground.well;
    in property <bool> rounded;
    in property <length> radius: Radius.badge;
    in property <bool> pixelated;
    in property <Fit> fit: Fit.contain;
    // Bumped when the texture behind `source` is rewritten in place, which changes no property: a
    // rounded clip above caches its children as a layer and would keep drawing the old texels.
    in property <int> revision;
    // The texels of `source` shown from its corner, a texture larger than its picture; 0 shows it whole.
    in property <int> clip-width;
    in property <int> clip-height;
    // The picture's own opacity, its ground and what lies over it left whole.
    in property <float> picture-opacity: 1;
    background: Tones.ground(root.ground);
    border-radius: root.rounded ? root.radius : 0px;
    clip: root.rounded;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        source-clip-width: root.clip-width > 0 ? root.clip-width : root.source.width;
        source-clip-height: root.clip-height > 0 ? root.clip-height : root.source.height;
        image-fit: root.revision < 0 || root.fit == Fit.fill ? ImageFit.fill : root.fit == Fit.cover ? ImageFit.cover : ImageFit.contain;
        image-rendering: root.pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.picture-opacity;
    }
}

// A rule across a layout, or `vertical` between two columns: one flat line a point thick in the app's one
// separator tint. Bounded across alone, so a layout stretches it; laid outside one, it is given its thickness.
export component Divider inherits Rectangle {
    in property <bool> vertical;
    property <length> unbounded: 100000px;
    min-width: root.vertical ? Stroke.line : 0px;
    max-width: root.vertical ? Stroke.line : root.unbounded;
    min-height: root.vertical ? 0px : Stroke.line;
    max-height: root.vertical ? root.unbounded : Stroke.line;
    background: Colour.separator;
}

// A title engraved as the rule above it, a camera's marking: the groove's shade a line above its letters,
// the lit edge a line below. The root lays the words out unseen; its three copies draw them.
export component Engraved inherits Label {
    color: transparent;
    Label {
        y: -Stroke.line;
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.role;
        wrap: root.wrap;
        overflow: root.overflow;
        horizontal-alignment: root.horizontal-alignment;
        ink: DS.palette-groove;
        accessible-role: none;
    }
    Label {
        y: Stroke.line;
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.role;
        wrap: root.wrap;
        overflow: root.overflow;
        horizontal-alignment: root.horizontal-alignment;
        ink: DS.palette-groove-light;
        accessible-role: none;
    }
    Label {
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.role;
        wrap: root.wrap;
        overflow: root.overflow;
        horizontal-alignment: root.horizontal-alignment;
        ink: root.ink;
        accessible-role: none;
    }
}

export component Spacer inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
}

export component HStack inherits HorizontalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

export component VStack inherits VerticalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

// A plain surface: the window's ground, the canvas's dark or a photo's well; `rounded` as a card, a
// flat block of the panel's ground set on the canvas.
export component Surface inherits Rectangle {
    in property <Ground> ground: Ground.ground;
    in property <bool> rounded;
    background: Tones.ground(root.ground);
    border-radius: root.rounded ? Radius.card : 0px;
}

// The canvas card: rounded, darker while a frame is cropped. Its content is not clipped to the round:
// a rounded clip renders the whole card into a texture of its own, so `CardCorners` covers it instead.
export component Card inherits Rectangle {
    in property <bool> dimmed;
    // Corners left square against a square neighbour: the top right one, or both of a side.
    in property <bool> square-top-right;
    in property <bool> square-left;
    in property <bool> square-right;
    // The screen's pixels to a point, which a move to a screen of another density changes.
    out property <float> density: 1px / 1phx;
    background: root.dimmed ? Colour.canvas-cropping : Colour.canvas;
    border-top-left-radius: root.square-left ? 0px : CardStyle.radius;
    border-top-right-radius: root.square-right || root.square-top-right ? 0px : CardStyle.radius;
    border-bottom-right-radius: root.square-right ? 0px : CardStyle.radius;
    border-bottom-left-radius: root.square-left ? 0px : CardStyle.radius;
}

// The four corners outside a round, in the ground beneath, laid last over a content left unclipped,
// as a rounded clip draws it to a layer: the card's, a gallery tile's.
export component CardCorners {
    in property <length> r: CardStyle.radius;
    in property <color> ground: Colour.ground;
    // The card's square corners, which keep their content.
    in property <bool> square-top-right;
    in property <bool> square-left;
    in property <bool> square-right;
    if !root.square-left: Path { x: 0; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z"; }
    if !root.square-right && !root.square-top-right: Path { x: root.width - root.r; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 1 0 L 1 1 A 1 1 0 0 0 0 0 Z"; }
    if !root.square-right: Path { x: root.width - root.r; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 1 1 L 0 1 A 1 1 0 0 0 1 0 Z"; }
    if !root.square-left: Path { x: 0; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 0 1 L 0 0 A 1 1 0 0 0 1 1 Z"; }
}

// How a raised surface stands off what it sits on: a popover's or a menu's cast shade, a column slid
// over the card, or a sheet lifted the whole way, its shadow lengthened (`Outward.lift`).
export enum Lift { none, float, sheet }

// `dsFloating` on the panel's ground rounded as a card, its content in a column; `menu` takes the
// raised grey and the menus' round, as Swift keeps them. A press on it stays on it, but for a slid column's.
export component Raised inherits Rectangle {
    in property <Lift> lift: Lift.none;
    in property <bool> menu;
    in property <Gap> pad: Gap.none;
    in property <Gap> gap: Gap.none;
    in property <length> radius: root.menu ? Radius.badge : Radius.card;
    height: column.preferred-height;
    Outward {
        fill: root.menu ? Colour.raised : Colour.ground;
        radius: root.radius;
        lift: root.lift == Lift.sheet ? 1 : 0;
        clip: root.lift != Lift.none;
        if root.lift != Lift.float: TouchArea { }
        column := VerticalLayout {
            padding: Tones.gap(root.pad);
            spacing: Tones.gap(root.gap);
            @children
        }
    }
}

// A box on the panel (`dsRecessed` laid flat): the canvas's dark, rounded, its lines in a column.
export component Inset inherits Rectangle {
    in property <Gap> pad: Gap.m;
    in property <Gap> gap: Gap.xxs;
    in property <length> radius: Radius.card;
    background: Colour.canvas;
    border-radius: root.radius;
    VerticalLayout {
        padding: Tones.gap(root.pad);
        spacing: Tones.gap(root.gap);
        alignment: start;
        @children
    }
}

// `KeycapSound`: a key's click as it goes down and as it rises; the app decides if it sounds.
export global Clicks {
    callback press();
    callback release();
}

// Shows `text` under its control while it is hovered, or over it (`rise`), and hides it when the pointer
// leaves; opens a help card.
export global Tips {
    // `DSHelpPlacement.place`: the note at its anchor, held a margin in from each of the room's four
    // edges; larger than that room it is cut down to it rather than allowed to leave.
    public pure function place(x: length, y: length, width: length, height: length, room-width: length, room-height: length) -> TipBox {
        {
            x: min(max(x, min(Space.s, room-width / 2)), room-width - min(Space.s, room-width / 2) - min(width, room-width - 2 * min(Space.s, room-width / 2))),
            y: min(max(y, min(Space.s, room-height / 2)), room-height - min(Space.s, room-height / 2) - min(height, room-height - 2 * min(Space.s, room-height / 2))),
            width: min(width, room-width - 2 * min(Space.s, room-width / 2)),
            height: min(height, room-height - 2 * min(Space.s, room-height / 2)),
        }
    }
    // `y` the control's foot.
    public function hover(over: bool, text: string, x: length, y: length) {
        if (over && text != "") {
            Tip.text = text;
            Tip.x = x;
            Tip.y = y;
            Tip.above = false;
            Tip.shown = true;
        } else if (Tip.text == text) {
            Tip.shown = false;
        }
    }
    // `y` the control's head: a slider's note stands over its own name, never over the next slider's.
    public function rise(over: bool, text: string, x: length, y: length) {
        Tips.hover(over, text, x, y);
        if (over && text != "") { Tip.above = true; }
    }
    // A help mark under the hand, or pressed from the keyboard: its note's card opens in place of the one open.
    public function help(note: string, demo: string, subject: string) {
        if (note != Tip.open) {
            Tip.open = note;
            Tip.demo = demo;
            Tip.subject = subject;
            Tip.play(demo);
        }
    }
    // The hand leaving a help mark: its own card goes, another's stays.
    public function unhelp(note: string) {
        if (note == Tip.open) { Tips.close(); }
    }
    // The card down and its demo stopped, whatever stood open.
    public function close() {
        if (Tip.open != "") {
            Tip.open = "";
            Tip.demo = "";
            Tip.subject = "";
            Tip.play("");
        }
    }
}
