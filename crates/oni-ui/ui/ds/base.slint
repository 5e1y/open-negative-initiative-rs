// The primitives every screen composes: text, glyphs, pictures, surfaces, rules and stacks.
import "../../fonts/Inter.ttf";
import "../../fonts/Enriqueta-Regular.ttf";
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, State, Motion, TileStyle, TipStyle, PlotStyle, CardStyle, SplitStyle, StatusStyle, ShellStyle } from "theme.slint";

// `note` is a block's wrapped line in the tertiary ink, the size of a value.
export enum TextRole { label, value, caption, title, section, heading, button, note }
export enum Tone { primary, secondary, tertiary, on-fill, on-light, warning, caution }
export enum Gap { none, xxs, xs, s, m, l }
export enum Ground { ground, canvas, canvas-cropping, well, paper, skeleton }
export enum PlotSize { main, block }

// Where a note lands: its corner and its size, in the window's points.
export struct TipBox {
    x: length,
    y: length,
    width: length,
    height: length,
}

// What a hovered control says after the system's tooltip delay, drawn by `TipLayer`.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> shown;
    // A help mark's note shows at once, as `dsHelpBubble` does; a tooltip waits the system's delay.
    in-out property <bool> at-once;
    // A help mark's note is a card: its clip above, 4:3, then the note; a tooltip is a line of text.
    in-out property <bool> card;
    in-out property <image> clip;
}

export global Tones {
    public pure function ink(tone: Tone) -> color {
        if (tone == Tone.secondary) { return Colour.ink-secondary; }
        if (tone == Tone.tertiary) { return Colour.ink-tertiary; }
        if (tone == Tone.on-fill) { return Colour.ink-on-fill; }
        if (tone == Tone.on-light) { return Colour.ink-on-light; }
        if (tone == Tone.warning) { return Colour.warning; }
        if (tone == Tone.caution) { return Colour.caution; }
        Colour.ink
    }
    public pure function gap(gap: Gap) -> length {
        if (gap == Gap.xxs) { return Space.xxs; }
        if (gap == Gap.xs) { return Space.xs; }
        if (gap == Gap.s) { return Space.s; }
        if (gap == Gap.m) { return Space.m; }
        if (gap == Gap.l) { return Space.l; }
        0px
    }
    public pure function ground(ground: Ground) -> color {
        if (ground == Ground.canvas) { return Colour.canvas; }
        if (ground == Ground.canvas-cropping) { return Colour.canvas-cropping; }
        if (ground == Ground.well) { return Colour.well; }
        if (ground == Ground.paper) { return Colour.paper; }
        if (ground == Ground.skeleton) { return Colour.skeleton; }
        Colour.ground
    }
}

// Every word on screen: its role sets the face and size, its tone the ink.
export component Label inherits Text {
    in property <TextRole> role: TextRole.label;
    in property <Tone> tone: root.role == TextRole.note ? Tone.tertiary : Tone.primary;
    in property <bool> centred;
    font-family: root.role == TextRole.heading ? Type.brand-family : Type.family;
    font-size: root.role == TextRole.value || root.role == TextRole.note ? Type.value
        : root.role == TextRole.caption ? Type.chip
        : root.role == TextRole.button ? Type.chip
        : root.role == TextRole.title ? Type.title
        : root.role == TextRole.section ? Type.section
        : root.role == TextRole.heading ? Type.heading
        : Type.label;
    font-weight: root.role == TextRole.button ? Type.strong : Type.regular;
    color: Tones.ink(root.tone);
    vertical-alignment: center;
    horizontal-alignment: root.centred ? center : left;
    wrap: root.role == TextRole.note ? word-wrap : no-wrap;
}

// What a badge says by its colour: a caution on the canvas, a value over the photo, a tile's seal and
// its red alert, a block's news, a step's number in its disc.
export enum BadgeTone { warning, dark, seal, alert, news, step }

// A short word on a capsule, a tag or a disc; a news badge's note shows on hover and marks it read.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeTone> tone: BadgeTone.dark;
    in property <string> note;
    callback read();
    property <bool> sealed: root.tone == BadgeTone.seal || root.tone == BadgeTone.alert;
    width: root.tone == BadgeTone.step ? DS.control-keycap-mini-height
        : root.tone == BadgeTone.warning ? label.preferred-width + 2 * Space.s
        : root.tone == BadgeTone.news ? label.preferred-width + 2 * DS.control-seal-padding * 1px
        : root.sealed ? label.preferred-width + 2 * Space.xs
        : label.preferred-width + 10px;
    height: root.tone == BadgeTone.step ? self.width
        : root.tone == BadgeTone.warning ? label.preferred-height + 2 * Space.xs
        : root.tone == BadgeTone.news ? DS.control-seal-height * 1px
        : root.sealed ? TileStyle.caption
        : label.preferred-height + 4px;
    border-radius: root.tone == BadgeTone.step || root.tone == BadgeTone.warning || root.tone == BadgeTone.news ? self.height / 2
        : root.sealed ? Space.xxs : 4px;
    background: root.tone == BadgeTone.warning ? Colour.warning-surface
        : root.tone == BadgeTone.news ? Colour.medal[3]
        : root.tone == BadgeTone.alert ? Colour.destructive
        : root.tone == BadgeTone.seal || root.tone == BadgeTone.step ? Colour.raised
        : Colour.contrast-edge;
    label := Text {
        width: root.sealed || root.tone == BadgeTone.step ? parent.width : self.preferred-width;
        height: root.sealed || root.tone == BadgeTone.step ? parent.height : self.preferred-height;
        text: root.text;
        font-family: Type.family;
        font-size: root.tone == BadgeTone.warning ? Type.value : root.tone == BadgeTone.news ? DS.typo-seal-size
            : root.sealed ? Type.chip : root.tone == BadgeTone.step ? Type.label : 11px;
        font-weight: root.tone == BadgeTone.news ? Type.strong : Type.regular;
        letter-spacing: root.tone == BadgeTone.news ? DS.control-seal-tracking * 1px : 0px;
        color: root.tone == BadgeTone.warning ? Colour.ink-on-warning : root.tone == BadgeTone.news ? Colour.ink-on-light
            : root.tone == BadgeTone.alert ? Colour.ink-on-fill : root.sealed || root.tone == BadgeTone.step ? Colour.ink : Colour.handle-active;
        horizontal-alignment: root.sealed || root.tone == BadgeTone.step ? center : left;
        vertical-alignment: root.sealed || root.tone == BadgeTone.step ? center : top;
    }
    if root.note != "": TouchArea {
        changed has-hover => {
            Tips.hover(self.has-hover, root.note, root.absolute-position.x, root.absolute-position.y + root.height);
            if (self.has-hover) { root.read(); }
        }
    }
}

// A glyph tinted by a tone, square at the size it is given.
export component Icon inherits Image {
    in property <Tone> tone: Tone.secondary;
    in property <color> ink: Tones.ink(root.tone);
    colorize: root.ink;
    image-fit: contain;
}

// A photograph or a plot on its ground, never stretched unless asked.
export component Picture inherits Rectangle {
    in property <image> source;
    in property <Ground> ground: Ground.well;
    in property <bool> rounded;
    in property <bool> pixelated;
    in property <bool> stretched;
    // Bumped when the texture behind `source` is rewritten in place, which changes no property: a
    // rounded clip above caches its children as a layer and would keep drawing the old texels.
    in property <int> revision;
    // The texels of `source` shown from its corner, a texture larger than its picture; 0 shows it whole.
    in property <int> clip-width;
    in property <int> clip-height;
    background: Tones.ground(root.ground);
    border-radius: root.rounded ? Radius.badge : 0px;
    clip: root.rounded;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        source-clip-width: root.clip-width > 0 ? root.clip-width : root.source.width;
        source-clip-height: root.clip-height > 0 ? root.clip-height : root.source.height;
        image-fit: root.revision < 0 || root.stretched ? ImageFit.fill : ImageFit.contain;
        image-rendering: root.pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
    }
}

// `DSHistogram`'s frame: the plot Rust rasterises, edge to edge at one of two heights.
export component HistogramFrame inherits Picture {
    in property <PlotSize> size: PlotSize.main;
    ground: Ground.ground;
    stretched: true;
    height: root.size == PlotSize.main ? PlotStyle.main : PlotStyle.block;
}

export component Divider inherits Rectangle {
    height: Stroke.line;
    background: Colour.separator;
}

// `NegativeView.splitDivider`: the compare split's guide, its before and after labels, a grab the
// width of a handle; moving it only recomposites.
export component SplitGuide inherits Rectangle {
    callback dragged(length);
    width: SplitStyle.grab;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: grab.has-hover || grab.pressed ? Stroke.line + SplitStyle.grow : Stroke.line;
        height: parent.height;
        background: grab.has-hover || grab.pressed ? Colour.handle-active : Colour.guide;
        drop-shadow-color: Colour.contrast-edge;
        drop-shadow-blur: SplitStyle.shadow;
    }
    Label {
        text: @tr("before");
        role: TextRole.value;
        x: (parent.width - self.width) / 2 - SplitStyle.label-inset;
        y: Space.s;
    }
    Label {
        text: @tr("after");
        role: TextRole.value;
        x: (parent.width - self.width) / 2 + SplitStyle.label-inset;
        y: Space.s;
    }
    grab := TouchArea {
        mouse-cursor: ew-resize;
        moved => { if (self.pressed) { root.dragged(self.mouse-x); } }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragged(self.mouse-x);
            }
        }
    }
}

export component Spacer inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
}

export component HStack inherits HorizontalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

export component VStack inherits VerticalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

// A plain surface: the window's ground, the canvas's dark or a photo's well.
export component Surface inherits Rectangle {
    in property <Ground> ground: Ground.ground;
    background: Tones.ground(root.ground);
}

// The canvas card: rounded, darker while a frame is cropped. Its content is not clipped to the round:
// a rounded clip renders the whole card into a texture of its own, so `CardCorners` covers it instead.
export component Card inherits Rectangle {
    in property <bool> dimmed;
    background: root.dimmed ? Colour.canvas-cropping : Colour.canvas;
    border-radius: CardStyle.radius;
}

// The card's four corners outside its round, in the ground it sits on, laid last over its content.
export component CardCorners {
    property <length> r: CardStyle.radius;
    Path { x: 0; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: Colour.ground; commands: "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z"; }
    Path { x: root.width - root.r; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: Colour.ground; commands: "M 1 0 L 1 1 A 1 1 0 0 0 0 0 Z"; }
    Path { x: root.width - root.r; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: Colour.ground; commands: "M 1 1 L 0 1 A 1 1 0 0 0 1 0 Z"; }
    Path { x: 0; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: Colour.ground; commands: "M 0 1 L 0 0 A 1 1 0 0 0 1 1 Z"; }
}

// `floating(_:)`: a hidden column slid over the card, rounded and raised by its shade.
export component FloatingColumn inherits Rectangle {
    background: Colour.ground;
    border-radius: CardStyle.radius;
    clip: true;
    drop-shadow-color: DS.scanner-raise-shade;
    drop-shadow-blur: DS.control-hollow-blur * 1px;
    drop-shadow-offset-y: DS.control-hollow-drop * 1px;
}

// `DSStatusBar`: one line under the viewer.
export component StatusLine inherits Rectangle {
    in property <string> text;
    height: StatusStyle.height;
    // As wide as its words, eliding once the row is short of room.
    min-width: 0;
    preferred-width: line.preferred-width + 2 * Space.s;
    line := Label {
        x: Space.s;
        width: parent.width - 2 * Space.s;
        height: parent.height;
        role: TextRole.value;
        tone: Tone.secondary;
        text: root.text;
        overflow: elide;
    }
}

// The window: the ground, the font, the floor the Swift app sets.
export component AppWindow inherits Window {
    min-width: ShellStyle.min-width;
    min-height: ShellStyle.min-height;
    preferred-width: ShellStyle.min-width;
    preferred-height: ShellStyle.min-height;
    background: Colour.ground;
    default-font-family: Type.family;
}

// The tooltip, drawn above everything by the window that holds it, held inside it by `Tips.place`.
export component TipLayer inherits Rectangle {
    in property <length> room;
    in property <length> room-height;
    property <TipBox> box: Tip.card
        ? Tips.place(Tip.x, Tip.y, TipStyle.card-width, card.preferred-height, root.room, root.room-height)
        : Tips.place(Tip.x, Tip.y, tip-text.width + 2 * TipStyle.padding-x, tip-text.preferred-height + 2 * TipStyle.padding-y, root.room, root.room-height);
    x: root.box.x;
    y: root.box.y;
    width: root.box.width;
    height: root.box.height;
    background: Colour.tip;
    border-radius: Tip.card ? TipStyle.card-radius : TipStyle.radius;
    clip: Tip.card;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    // Shown after the delay by a timer: an animated opacity redraws the window for the whole delay.
    property <bool> shown: Tip.shown;
    property <bool> ready;
    changed shown => { root.ready = false; }
    visible: Tip.text != "" && Tip.shown && (Tip.at-once || root.ready);
    Timer {
        interval: Motion.tip-delay;
        running: Tip.shown && !Tip.at-once && !root.ready;
        triggered => { root.ready = true; }
    }
    tip-text := Label {
        visible: !Tip.card;
        role: TextRole.caption;
        text: Tip.text;
        wrap: word-wrap;
        width: min(self.preferred-width, TipStyle.max-width);
    }
    card := VerticalLayout {
        visible: Tip.card;
        width: TipStyle.card-width;
        padding: TipStyle.card-padding;
        spacing: TipStyle.card-padding;
        // The clip's place, empty until its GIF is made.
        Picture {
            height: (TipStyle.card-width - 2 * TipStyle.card-padding) * 3 / 4;
            ground: Ground.skeleton;
            rounded: true;
            source: Tip.clip;
        }
        Label {
            role: TextRole.caption;
            font-weight: Type.medium;
            tone: Tone.primary;
            text: Tip.card ? Tip.text : "";
            wrap: word-wrap;
        }
    }
}

// `KeycapSound`: a key's click as it goes down and as it rises; the app decides if it sounds.
export global Clicks {
    callback press();
    callback release();
}

// Shows `text` under `anchor` while it is hovered, and hides it when the pointer leaves.
export global Tips {
    // `DSHelpPlacement.place`: the note at its anchor, held a margin in from each of the room's four
    // edges; larger than that room it is cut down to it rather than allowed to leave.
    public pure function place(x: length, y: length, width: length, height: length, room-width: length, room-height: length) -> TipBox {
        {
            x: min(max(x, min(Space.s, room-width / 2)), room-width - min(Space.s, room-width / 2) - min(width, room-width - 2 * min(Space.s, room-width / 2))),
            y: min(max(y, min(Space.s, room-height / 2)), room-height - min(Space.s, room-height / 2) - min(height, room-height - 2 * min(Space.s, room-height / 2))),
            width: min(width, room-width - 2 * min(Space.s, room-width / 2)),
            height: min(height, room-height - 2 * min(Space.s, room-height / 2)),
        }
    }
    public function hover(over: bool, text: string, x: length, y: length) {
        if (over && text != "") {
            Tip.at-once = false;
            Tip.card = false;
            Tip.text = text;
            Tip.x = x;
            Tip.y = y + TipStyle.offset;
            Tip.shown = true;
        } else if (Tip.text == text) {
            Tip.shown = false;
        }
    }
    // `dsHelpBubble`: the note under its mark at once.
    public function note(over: bool, text: string, x: length, y: length) {
        self.hover(over, text, x, y);
        Tip.at-once = over;
        Tip.card = over;
    }
}
