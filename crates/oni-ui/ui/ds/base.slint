// The primitives every screen composes: text, glyphs, pictures, surfaces, rules and stacks.
import "../../fonts/Inter.ttf";
import "../../fonts/Enriqueta-Regular.ttf";
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, Motion, ButtonStyle, TipStyle, CardStyle, SplitStyle, ScannerStyle } from "theme.slint";
import { Outward, Inward } from "depth.slint";

// `note` is a block's wrapped line in the tertiary ink, the size of a value.
export enum TextRole { label, value, caption, title, section, heading, button, note }
// `on-warning` reads on the warning's band, `lcd` on the scanner's glass.
export enum Tone { primary, secondary, tertiary, on-fill, on-light, warning, caution, on-warning, lcd }
export enum Gap { none, xxs, xs, s, m, l }
export enum Ground { ground, canvas, canvas-cropping, well, paper, skeleton }
// How a picture meets its box: whole inside it, filling it cropped, or stretched to it.
export enum Fit { contain, cover, fill }

// Where a note lands: its corner and its size, in the window's points.
export struct TipBox {
    x: length,
    y: length,
    width: length,
    height: length,
}

// What a hovered control says after the system's tooltip delay, drawn by `TipLayer`.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> shown;
    // A help mark's note shows at once, as `dsHelpBubble` does; a tooltip waits the system's delay.
    in-out property <bool> at-once;
    // A help mark's note is a card: its demo above, square, then the note; a tooltip is a line of text.
    in-out property <bool> card;
    // The help topic the card shows, Rust's key to its demo; `play` says it opened or closed ("").
    in-out property <string> demo;
    callback play(string);
    // The demo's frame, and whether the topic has one: none, and the card shows no box.
    in-out property <image> clip;
    in-out property <bool> has-clip;
}

export global Tones {
    public pure function ink(tone: Tone) -> color {
        if (tone == Tone.secondary) { return Colour.ink-secondary; }
        if (tone == Tone.tertiary) { return Colour.ink-tertiary; }
        if (tone == Tone.on-fill) { return Colour.ink-on-fill; }
        if (tone == Tone.on-light) { return Colour.ink-on-light; }
        if (tone == Tone.warning) { return Colour.warning; }
        if (tone == Tone.caution) { return Colour.caution; }
        if (tone == Tone.on-warning) { return Colour.ink-on-warning; }
        if (tone == Tone.lcd) { return ScannerStyle.lcd-ink; }
        Colour.ink
    }
    public pure function gap(gap: Gap) -> length {
        if (gap == Gap.xxs) { return Space.xxs; }
        if (gap == Gap.xs) { return Space.xs; }
        if (gap == Gap.s) { return Space.s; }
        if (gap == Gap.m) { return Space.m; }
        if (gap == Gap.l) { return Space.l; }
        0px
    }
    public pure function ground(ground: Ground) -> color {
        if (ground == Ground.canvas) { return Colour.canvas; }
        if (ground == Ground.canvas-cropping) { return Colour.canvas-cropping; }
        if (ground == Ground.well) { return Colour.well; }
        if (ground == Ground.paper) { return Colour.white; }
        if (ground == Ground.skeleton) { return Colour.skeleton; }
        Colour.ground
    }
}

// Every word on screen: its role sets the face and size, its tone the ink, unless it has an ink of its own.
export component Label inherits Text {
    in property <TextRole> role: TextRole.label;
    in property <Tone> tone: root.role == TextRole.note ? Tone.tertiary : Tone.primary;
    in property <color> ink: Tones.ink(root.tone);
    in property <bool> centred;
    // Letters set apart by the seal's tracking, as a stamp in capitals reads.
    in property <bool> spaced;
    font-family: Type.family;
    font-size: root.role == TextRole.value || root.role == TextRole.note ? Type.value
        : root.role == TextRole.caption ? Type.chip
        : root.role == TextRole.button ? Type.chip
        : root.role == TextRole.title ? Type.title
        : root.role == TextRole.section ? Type.section
        : root.role == TextRole.heading ? Type.heading
        : Type.label;
    font-weight: root.role == TextRole.button ? Type.strong : Type.regular;
    letter-spacing: root.spaced ? DS.control-seal-tracking * 1px : root.role == TextRole.button ? ButtonStyle.tracking : 0px;
    color: root.ink;
    vertical-alignment: center;
    horizontal-alignment: root.centred ? center : left;
    wrap: root.role == TextRole.note ? word-wrap : no-wrap;
}

// A glyph tinted by a tone, square at the size it is given.
export component Icon inherits Image {
    in property <Tone> tone: Tone.secondary;
    in property <color> ink: Tones.ink(root.tone);
    colorize: root.ink;
    image-fit: contain;
}

// A photograph or a plot on its ground, never stretched unless asked.
export component Picture inherits Rectangle {
    in property <image> source;
    in property <Ground> ground: Ground.well;
    in property <bool> rounded;
    in property <length> radius: Radius.badge;
    in property <bool> pixelated;
    in property <Fit> fit: Fit.contain;
    // Bumped when the texture behind `source` is rewritten in place, which changes no property: a
    // rounded clip above caches its children as a layer and would keep drawing the old texels.
    in property <int> revision;
    // The texels of `source` shown from its corner, a texture larger than its picture; 0 shows it whole.
    in property <int> clip-width;
    in property <int> clip-height;
    // The picture's own opacity, its ground and what lies over it left whole.
    in property <float> picture-opacity: 1;
    background: Tones.ground(root.ground);
    border-radius: root.rounded ? root.radius : 0px;
    clip: root.rounded;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        source-clip-width: root.clip-width > 0 ? root.clip-width : root.source.width;
        source-clip-height: root.clip-height > 0 ? root.clip-height : root.source.height;
        image-fit: root.revision < 0 || root.fit == Fit.fill ? ImageFit.fill : root.fit == Fit.cover ? ImageFit.cover : ImageFit.contain;
        image-rendering: root.pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
        opacity: root.picture-opacity;
    }
}

// A rule across a layout, or `vertical` between two columns: `DSSeparator`'s engraved groove and its
// lit edge, or flat (`hairline` the half-point one). Bounded across alone, so a layout stretches it.
export component Divider inherits Rectangle {
    in property <bool> vertical;
    in property <bool> hairline;
    in property <bool> engraved: !root.hairline;
    property <length> thickness: root.hairline ? Stroke.hairline : root.engraved ? 2 * Stroke.line : Stroke.line;
    property <length> unbounded: 100000px;
    min-width: root.vertical ? root.thickness : 0px;
    max-width: root.vertical ? root.thickness : root.unbounded;
    min-height: root.vertical ? 0px : root.thickness;
    max-height: root.vertical ? root.unbounded : root.thickness;
    background: root.engraved ? DS.palette-groove : Colour.separator;
    if root.engraved: Rectangle {
        x: root.vertical ? Stroke.line : 0px;
        y: root.vertical ? 0px : Stroke.line;
        width: root.vertical ? Stroke.line : parent.width;
        height: root.vertical ? parent.height : Stroke.line;
        background: DS.palette-groove-light;
    }
}

// `NegativeView.splitDivider`: the compare split's guide, its before and after labels, a grab the
// width of a handle; moving it only recomposites.
export component SplitGuide inherits Rectangle {
    callback dragged(length);
    width: SplitStyle.grab;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: grab.has-hover || grab.pressed ? Stroke.line + SplitStyle.grow : Stroke.line;
        height: parent.height;
        background: grab.has-hover || grab.pressed ? Colour.handle-active : Colour.guide;
        drop-shadow-color: Colour.contrast-edge;
        drop-shadow-blur: Stroke.emphasis;
    }
    Label {
        text: @tr("before");
        role: TextRole.value;
        x: (parent.width - self.width) / 2 - SplitStyle.label-inset;
        y: Space.s;
    }
    Label {
        text: @tr("after");
        role: TextRole.value;
        x: (parent.width - self.width) / 2 + SplitStyle.label-inset;
        y: Space.s;
    }
    grab := TouchArea {
        mouse-cursor: ew-resize;
        moved => { if (self.pressed) { root.dragged(self.mouse-x); } }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragged(self.mouse-x);
            }
        }
    }
}

export component Spacer inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
}

export component HStack inherits HorizontalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

export component VStack inherits VerticalLayout {
    in property <Gap> gap: Gap.s;
    in property <Gap> inset: Gap.none;
    spacing: Tones.gap(root.gap);
    padding: Tones.gap(root.inset);
}

// A plain surface: the window's ground, the canvas's dark or a photo's well.
export component Surface inherits Rectangle {
    in property <Ground> ground: Ground.ground;
    background: Tones.ground(root.ground);
}

// The canvas card: rounded, darker while a frame is cropped. Its content is not clipped to the round:
// a rounded clip renders the whole card into a texture of its own, so `CardCorners` covers it instead.
export component Card inherits Rectangle {
    in property <bool> dimmed;
    // The screen's pixels to a point, which a move to a screen of another density changes.
    out property <float> density: 1px / 1phx;
    background: root.dimmed ? Colour.canvas-cropping : Colour.canvas;
    border-radius: CardStyle.radius;
}

// The four corners outside a round, in the ground beneath, laid last over a content left unclipped,
// as a rounded clip draws it to a layer: the card's, a gallery tile's.
export component CardCorners {
    in property <length> r: CardStyle.radius;
    in property <color> ground: Colour.ground;
    Path { x: 0; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z"; }
    Path { x: root.width - root.r; y: 0; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 1 0 L 1 1 A 1 1 0 0 0 0 0 Z"; }
    Path { x: root.width - root.r; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 1 1 L 0 1 A 1 1 0 0 0 1 0 Z"; }
    Path { x: 0; y: root.height - root.r; width: root.r; height: root.r; viewbox-width: 1; viewbox-height: 1; fill: root.ground; commands: "M 0 1 L 0 0 A 1 1 0 0 0 1 1 Z"; }
}

// How a raised surface stands off what it sits on: a popover's or a menu's cast shade, a column slid
// over the card, or a sheet lifted the whole way, its shadow lengthened (`Outward.lift`).
export enum Lift { none, float, sheet }

// `dsFloating` on the panel's ground rounded as a card, its content in a column; `menu` takes the
// raised grey and the menus' round, as Swift keeps them. A press on it stays on it, but for a slid column's.
export component Raised inherits Rectangle {
    in property <Lift> lift: Lift.none;
    in property <bool> menu;
    in property <Gap> pad: Gap.none;
    in property <Gap> gap: Gap.none;
    in property <length> radius: root.menu ? Radius.badge : Radius.card;
    height: column.preferred-height;
    Outward {
        fill: root.menu ? Colour.raised : Colour.ground;
        radius: root.radius;
        lift: root.lift == Lift.sheet ? 1 : 0;
        clip: root.lift != Lift.none;
        if root.lift != Lift.float: TouchArea { }
        column := VerticalLayout {
            padding: Tones.gap(root.pad);
            spacing: Tones.gap(root.gap);
            @children
        }
    }
}

// A box sunk in the panel (`dsRecessed`): the canvas's dark, rounded, its lines in a column; the
// export's summary, the paper profiles' card and the corrections' list (`Radius.control`).
export component Inset inherits Inward {
    in property <Gap> pad: Gap.m;
    in property <Gap> gap: Gap.xxs;
    ground: Colour.canvas;
    radius: Radius.card;
    VerticalLayout {
        padding: Tones.gap(root.pad);
        spacing: Tones.gap(root.gap);
        alignment: start;
        @children
    }
}

// `KeycapSound`: a key's click as it goes down and as it rises; the app decides if it sounds.
export global Clicks {
    callback press();
    callback release();
}

// Shows `text` under `anchor` while it is hovered, and hides it when the pointer leaves.
export global Tips {
    // `DSHelpPlacement.place`: the note at its anchor, held a margin in from each of the room's four
    // edges; larger than that room it is cut down to it rather than allowed to leave.
    public pure function place(x: length, y: length, width: length, height: length, room-width: length, room-height: length) -> TipBox {
        {
            x: min(max(x, min(Space.s, room-width / 2)), room-width - min(Space.s, room-width / 2) - min(width, room-width - 2 * min(Space.s, room-width / 2))),
            y: min(max(y, min(Space.s, room-height / 2)), room-height - min(Space.s, room-height / 2) - min(height, room-height - 2 * min(Space.s, room-height / 2))),
            width: min(width, room-width - 2 * min(Space.s, room-width / 2)),
            height: min(height, room-height - 2 * min(Space.s, room-height / 2)),
        }
    }
    public function hover(over: bool, text: string, x: length, y: length) {
        if (over && text != "") {
            Tip.at-once = false;
            Tip.card = false;
            Tip.text = text;
            Tip.x = x;
            Tip.y = y + TipStyle.offset;
            Tip.shown = true;
        } else if (Tip.text == text) {
            Tip.shown = false;
        }
    }
    // `dsHelpBubble`: the note under its mark at once.
    public function note(over: bool, text: string, x: length, y: length) {
        self.hover(over, text, x, y);
        Tip.at-once = over;
        Tip.card = over;
    }
}
