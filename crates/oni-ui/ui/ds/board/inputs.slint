// The board's inputs: the tabs and the switches, then every field, picker and typed box.
import { Colour, PlotInkStyle, Look, Tabs, Toggle, ToggleRow, LabelledRow, TextField, Picker, MenuPicker, LinesPicker, NumberField, SuffixField, DateFields, EditableTitle, TextArea, Field, FormRow } from "../ds.slint";
import { BoardStyle, Page, Group, Row, Cell, Fill, Absent } from "kit.slint";

// One set of tabs at rest, with another tab hovered, and with a tab marked.
component TabsRow inherits Row {
    in property <[string]> tabs;
    in property <int> selected;
    in property <[color]> swatches;
    in property <[bool]> marked;
    in property <int> hovered;
    Fill { span: BoardStyle.wide; Tabs { tabs: root.tabs; selected: root.selected; swatches: root.swatches; } }
    Fill { span: BoardStyle.wide; Tabs { tabs: root.tabs; selected: root.selected; swatches: root.swatches; hover-tab: root.hovered; } }
    Fill { span: BoardStyle.wide; Tabs { tabs: root.tabs; selected: root.selected; swatches: root.swatches; marked: root.marked; } }
}

export component TabsPage inherits Page {
    title: "Tabs and toggles";
    note: "Tabs (the selected pill, a hovered tab, a marked tab), then Toggle and ToggleRow.";
    Group {
        title: "Tabs";
        states: ["Rest", "Another tab hovered", "A tab marked"];
        span: BoardStyle.wide;
        TabsRow { label: "two tabs"; tabs: ["Negative", "Positive"]; hovered: 1; marked: [false, true]; }
        TabsRow { label: "four tabs, third selected"; tabs: ["Roll", "Crop", "Color", "Details"]; selected: 2; hovered: 0; marked: [true, false, false, false]; }
        TabsRow { label: "four tabs, last selected"; tabs: ["Roll", "Crop", "Color", "Details"]; selected: 3; hovered: 1; marked: [false, false, true, false]; }
        TabsRow {
            label: "eight swatch tabs";
            tabs: ["Red", "Orange", "Yellow", "Green", "Aqua", "Blue", "Purple", "Magenta"];
            swatches: PlotInkStyle.bands;
            selected: 1;
            hovered: 4;
            marked: [false, false, false, true, false, false, false, false];
        }
    }
    Group {
        title: "Toggle";
        states: ["Off", "On", "Disabled, off", "Disabled, on", "Hover"];
        Row {
            label: "Toggle";
            Cell { Toggle { } }
            Cell { Toggle { on: true; } }
            Cell { Toggle { enabled: false; } }
            Cell { Toggle { on: true; enabled: false; } }
            Absent { }
        }
        Row {
            label: "ToggleRow";
            Cell { ToggleRow { label: "Clipping"; } }
            Cell { ToggleRow { label: "Clipping"; on: true; } }
            Cell { ToggleRow { label: "Clipping"; enabled: false; } }
            Cell { ToggleRow { label: "Clipping"; on: true; enabled: false; } }
            Absent { }
        }
        Row {
            label: "LabelledRow";
            Fill { span: BoardStyle.wide; LabelledRow { label: "Show the grain"; Toggle { on: true; } } }
        }
    }
}

export component FieldsPage inherits Page {
    title: "Fields";
    note: "Every typed box and picker: TextField, NumberField, SuffixField, TextArea, Picker and its menus, DateFields, EditableTitle, Field and FormRow.";
    property <[string]> states: ["Placeholder", "Text", "Hover", "Focus", "Disabled"];
    Group {
        title: "Typed boxes";
        states: root.states;
        span: BoardStyle.field;
        Row {
            label: "TextField";
            Fill { span: BoardStyle.field; TextField { placeholder: "Description"; } }
            Fill { span: BoardStyle.field; TextField { value: "Kodak Portra 400, box speed"; } }
            Absent { span: BoardStyle.field; }
            Fill { span: BoardStyle.field; TextField { value: "Kodak Portra 400"; focused-look: true; } }
            Fill { span: BoardStyle.field; TextField { value: "Kodak Portra 400"; enabled: false; } }
        }
        Row {
            label: "NumberField";
            Cell { span: BoardStyle.field; NumberField { placeholder: "Width"; } }
            Cell { span: BoardStyle.field; NumberField { value: "3000"; } }
            Absent { span: BoardStyle.field; }
            Cell { span: BoardStyle.field; NumberField { value: "3000"; focused-look: true; } }
            Cell { span: BoardStyle.field; NumberField { value: "3000"; enabled: false; } }
        }
        Row {
            label: "SuffixField";
            Fill { span: BoardStyle.field; SuffixField { placeholder: "File name"; suffix: ".tif"; } }
            Fill { span: BoardStyle.field; SuffixField { value: "DSC_6432"; suffix: ".tif"; } }
            Absent { span: BoardStyle.field; }
            Absent { span: BoardStyle.field; }
            Fill { span: BoardStyle.field; SuffixField { value: "DSC_6432"; suffix: ".tif"; enabled: false; } }
        }
        Row {
            label: "TextArea";
            Fill { span: BoardStyle.field; TextArea { lines-height: 4 * BoardStyle.gap; } }
            Fill { span: BoardStyle.field; TextArea { lines-height: 4 * BoardStyle.gap; text: "The scan shows banding in the sky after the Color tab's curve."; } }
            Absent { span: BoardStyle.field; }
            Fill { span: BoardStyle.field; TextArea { lines-height: 4 * BoardStyle.gap; text: "The scan shows banding."; focused-look: true; } }
            Absent { span: BoardStyle.field; }
        }
    }
    Group {
        title: "Pickers";
        states: ["Rest", "Hover", "With a label", "With a label, hover"];
        span: BoardStyle.field;
        Row {
            label: "Picker";
            Fill { span: BoardStyle.field; Picker { value: "Generic C-41"; } }
            Fill { span: BoardStyle.field; Picker { value: "Generic C-41"; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { label: "Dyes"; value: "Generic C-41"; } }
            Fill { span: BoardStyle.field; Picker { label: "Dyes"; value: "Generic C-41"; look: Look.hover; } }
        }
        Row {
            label: "MenuPicker, closed";
            Fill { span: BoardStyle.field; MenuPicker { value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; } }
            Fill { span: BoardStyle.field; MenuPicker { value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; look: Look.hover; } }
            Fill { span: BoardStyle.field; MenuPicker { label: "Space"; value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; } }
            Fill { span: BoardStyle.field; MenuPicker { label: "Space"; value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; look: Look.hover; } }
        }
        Row {
            label: "LinesPicker, closed";
            Fill { span: BoardStyle.field; LinesPicker { value: "Negs / Roll #8"; } }
            Fill { span: BoardStyle.field; LinesPicker { value: "Negs / Roll #8"; look: Look.hover; } }
            Fill { span: BoardStyle.field; LinesPicker { label: "Into"; value: "Negs / Roll #8"; } }
            Fill { span: BoardStyle.field; LinesPicker { label: "Into"; value: "Negs / Roll #8"; look: Look.hover; } }
        }
    }
    Group {
        title: "Dates and titles";
        states: ["Empty", "Filled"];
        span: BoardStyle.wide;
        Row {
            label: "DateFields";
            Cell { span: BoardStyle.wide; DateFields { } }
            Cell { span: BoardStyle.wide; DateFields { month: "4"; day: "15"; year: "2026"; } }
        }
        Row {
            label: "EditableTitle at rest (empty draws nothing)";
            Cell { span: BoardStyle.wide; EditableTitle { placeholder: "Roll name"; } }
            Cell { span: BoardStyle.wide; EditableTitle { text: "Roll #8"; placeholder: "Roll name"; } }
        }
    }
    Group {
        title: "Field wrappers";
        states: ["Field with a note", "Field", "FormRow"];
        span: BoardStyle.wide;
        Row {
            label: "a label over a box";
            Fill { span: BoardStyle.wide; Field { label: "Long edge"; help: "The exported picture's longest side, in pixels."; TextField { value: "3000"; } } }
            Fill { span: BoardStyle.wide; Field { label: "Long edge"; TextField { value: "3000"; } } }
            Fill { span: BoardStyle.wide; FormRow { label: "Camera"; TextField { value: "Nikon Z f"; horizontal-stretch: 1; } } }
        }
    }
}
