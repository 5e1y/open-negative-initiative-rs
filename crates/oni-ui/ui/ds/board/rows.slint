// The board's rows: Row as a list's line, a tree's every kind, the navigator's folder, the trash's
// line, the preset's line, pinned and renamed; the live column selects, folds and stars on a click.
import { ScannerStyle, Colour, State, Icons, Look, RowKind, Row, NavigatorStyle } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Fill, Absent, Samples } from "kit.slint";

// One row live, hovered, selected, picked.
component RowStates inherits Line {
    in property <string> title;
    in property <string> caption;
    in property <string> trail;
    in property <string> detail;
    in property <int> depth;
    in property <RowKind> kind: RowKind.none;
    in property <bool> expandable;
    in property <bool> expanded;
    in property <bool> has-stock;
    in property <bool> has-glyph;
    in property <bool> pinned;
    in property <bool> present: true;
    in property <bool> favourite;
    in property <string> action;
    in property <string> badge;
    // The navigator's and the trash's form: rounded, quiet, its chevron a click, its glyph shut.
    in property <bool> navigator;
    in property <bool> starrable;
    for state in 4: cell := Fill {
        span: BoardStyle.library;
        property <bool> selected;
        property <bool> expanded: root.expanded;
        property <bool> favourite: root.favourite;
        Row {
            title: root.title;
            caption: root.caption;
            trail: root.trail;
            detail: root.detail;
            depth: root.depth;
            kind: root.kind;
            expandable: root.expandable;
            expanded: cell.expanded;
            open: root.navigator ? root.kind == RowKind.opened : cell.expanded;
            folds: root.navigator ? false : root.expandable;
            stock: Samples.stock;
            has-stock: root.has-stock;
            glyph: Icons.arrow-right;
            has-glyph: root.has-glyph;
            pinned: root.pinned;
            present: root.present;
            absent: root.navigator ? NavigatorStyle.absent : State.disabled;
            rounded: root.navigator || root.badge != "";
            quiet: root.navigator;
            starrable: root.starrable;
            favourite: cell.favourite;
            action: root.action;
            action-help: "Restore";
            badge: root.badge;
            badge-fill: ScannerStyle.band-warm;
            badge-ink: Colour.ink-on-light;
            help: root.title;
            look: state == 1 ? Look.hover : Look.live;
            selected: state == 2 || cell.selected;
            picked: state == 3;
            clicked => { if (state == 0) { cell.selected = !cell.selected; } }
            folded => { if (state == 0) { cell.expanded = !cell.expanded; } }
            starred => { if (state == 0) { cell.favourite = !cell.favourite; } }
        }
    }
}

export component RowPage inherits Page {
    title: "Row";
    note: "Row: kind, depth, expandable, expanded, open, folds, stock, glyph, caption, trail, detail, badge, quiet, rounded, pinned, present, starrable, favourite, action, renaming.";
    property <[string]> states: ["Live (click, chevron, star)", "Hover", "Selected", "Picked"];
    Group {
        title: "List and tree lines";
        states: root.states;
        span: BoardStyle.library;
        RowStates { label: "list line"; title: "Gold photos"; caption: "12"; }
        RowStates { label: "list line with a glyph"; title: "Photo Rag 308"; has-glyph: true; }
        RowStates { label: "folder, collapsed"; title: "Negs"; caption: "4"; kind: RowKind.folder; expandable: true; }
        RowStates { label: "folder, expanded"; title: "Negs"; caption: "4"; kind: RowKind.folder; expandable: true; expanded: true; }
        RowStates { label: "roll"; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; expandable: true; }
        RowStates { label: "roll with its stock"; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; expandable: true; has-stock: true; }
        RowStates { label: "photo"; title: "DSC_6432"; depth: 2; kind: RowKind.photo; }
        RowStates { label: "project"; title: "Summer prints"; caption: "9"; kind: RowKind.project; }
        RowStates { label: "pinned at its tree's top"; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; expandable: true; expanded: true; pinned: true; }
    }
    Group {
        title: "Navigator folders (quiet, rounded, starrable)";
        states: root.states;
        span: BoardStyle.library;
        RowStates { label: "folder (hover shows the star)"; title: "Negs"; kind: RowKind.folder; expandable: true; navigator: true; starrable: true; }
        RowStates { label: "favourite"; title: "Roll #8"; depth: 1; kind: RowKind.roll; navigator: true; starrable: true; favourite: true; }
        RowStates { label: "opened, unfolded"; title: "Negs"; kind: RowKind.opened; expandable: true; expanded: true; navigator: true; starrable: true; }
        RowStates { label: "absent (volume not mounted)"; title: "Archive disk"; kind: RowKind.folder; expandable: true; navigator: true; starrable: true; present: false; }
    }
    Group {
        title: "Trash and preset lines";
        states: root.states;
        span: BoardStyle.library;
        RowStates { label: "the ONI Trash (hover shows RESTORE)"; title: "ONI Trash"; caption: "3"; kind: RowKind.trash; expandable: true; expanded: true; navigator: true; action: "RESTORE"; }
        RowStates { label: "a trashed folder, its trail"; title: "Roll #8"; trail: "Negs/"; caption: "2"; depth: 1; kind: RowKind.trash; navigator: true; action: "RESTORE"; }
        RowStates { label: "preset (badge and detail)"; title: "Portra warm"; detail: "Color, Curves"; badge: "Pt"; }
    }
    Group {
        title: "Renaming";
        states: ["Live: Return, Escape, double-click"];
        span: BoardStyle.library;
        Line {
            label: "the title typed over";
            renamed := Fill {
                span: BoardStyle.library;
                property <bool> renaming: true;
                property <string> name: "Roll #8";
                // A fresh row each time, as the app lays one: a row keeps its rename's end once reached.
                if renamed.renaming: Row {
                    title: renamed.name;
                    depth: 1;
                    kind: RowKind.roll;
                    renaming: true;
                    committed(t) => { renamed.name = t; renamed.renaming = false; }
                    cancelled => { renamed.renaming = false; }
                }
                if !renamed.renaming: Row {
                    title: renamed.name;
                    depth: 1;
                    kind: RowKind.roll;
                    double-clicked => { renamed.renaming = true; }
                }
            }
        }
    }
}
