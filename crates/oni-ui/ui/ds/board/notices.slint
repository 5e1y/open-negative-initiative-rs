// The containers page's second half: the notices, banners and blocks of text, the preview slot, the
// status bar, the progress bar, and the scroller with its knob, live and forced.
import { Space, SheetStyle, Toast, Banner, Reach, Look, Label, TextRole, Tone, StatusBar, WarningBand, EmptyState, BulletLine, PreviewState, PreviewSlot, Progress, Scroller, ScrollKnob } from "../ds.slint";
import { BoardStyle, Group, Line, Cell, Fill, Absent, Stage, Samples } from "kit.slint";

// The knob over a strip of the canvas, a third of its content shown.
component KnobStage inherits Stage {
    in property <bool> hovered;
    in property <Look> look: Look.live;
    width: BoardStyle.cell / 2;
    height: BoardStyle.cell;
    ScrollKnob {
        width: parent.width;
        height: parent.height;
        page: parent.height;
        whole: 3 * parent.height;
        offset: parent.height / 2;
        hovered: root.hovered;
        across: parent.width;
        look: root.look;
    }
}

export component NoticeGroups inherits VerticalLayout {
    spacing: Space.l;
    Group {
        title: "Notices and blocks of text";
        states: ["Live", "With an action"];
        span: BoardStyle.wide;
        Line { label: "WarningBand"; Fill { span: BoardStyle.wide; WarningBand { text: "The original of this photo cannot be found."; } } }
        Line {
            label: "EmptyState, its key live";
            empty := Fill {
                span: BoardStyle.wide;
                property <int> shown;
                EmptyState { title: "No Gold Photos"; detail: empty.shown == 0 ? "Cycle the filter (⌘L) to see the others." : "SHOW ALL pressed " + empty.shown + " times."; action: "SHOW ALL"; acted => { empty.shown += 1; } }
            }
        }
        Line {
            label: "Toast, alone and with its action";
            Fill { span: BoardStyle.wide; Rectangle {
                height: lone.height + 2 * SheetStyle.margin;
                lone := Toast { room: parent.width; room-height: parent.height; title: "Move to ONI Trash"; message: "2 photos were not moved to the ONI Trash: a newer version of ONI wrote their settings."; }
            } }
            Fill { span: BoardStyle.wide; Rectangle {
                height: acting.height + 2 * SheetStyle.margin;
                acting := Toast { room: parent.width; room-height: parent.height; title: "Undo"; message: "3 of the items could not be put back: their folder moved or a file took their name."; action: "Show in Finder"; }
            } }
        }
        Line {
            label: "Banner, a disk away and a folder gone";
            Fill { span: BoardStyle.wide; Banner { title: "T7 Not Connected"; message: "“Roll 12” is on “T7”, which is not connected. These are the last thumbnails ONI kept; nothing has been changed."; } }
            gone := Fill {
                span: BoardStyle.wide;
                property <int> pressed;
                Banner {
                    reach: Reach.missing;
                    title: "Folder Not Found";
                    message: gone.pressed == 0 ? "“Roll 12” is no longer in “Scans”: moved, renamed or deleted outside ONI. Its settings travel with its files." : "REMOVE FROM FAVOURITES pressed " + gone.pressed + " times.";
                    keys: ["REMOVE FROM FAVOURITES"];
                    acted => { gone.pressed += 1; }
                }
            }
        }
        Line { label: "BulletLine"; Fill { span: BoardStyle.wide; BulletLine { text: "Every frame keeps its own settings, written beside the scan."; } } }
    }
    Group {
        title: "PreviewSlot";
        states: ["Rendering", "Shown", "Failed"];
        Line {
            label: "an export preview";
            Fill { PreviewSlot { height: BoardStyle.cell * 2 / 3; state: PreviewState.rendering; } }
            Fill { PreviewSlot { height: BoardStyle.cell * 2 / 3; state: PreviewState.shown; source: Samples.photo; } }
            Fill { PreviewSlot { height: BoardStyle.cell * 2 / 3; state: PreviewState.failed; } }
        }
    }
    Group {
        title: "StatusBar";
        states: ["Idle", "With its seal", "Busy, counted", "Busy, uncounted (sweeping)"];
        span: BoardStyle.wide;
        Line {
            label: "under the viewer";
            Fill { span: BoardStyle.wide; StatusBar { text: "DSC_6432 · 6048 × 4032 · Nikon Z f"; } }
            Fill { span: BoardStyle.wide; StatusBar { text: "Frame 09 · 3 passes"; seal: "RGB"; } }
            Fill { span: BoardStyle.wide; StatusBar { busy: true; text: "Loading"; count: "14 / 36"; fraction: 0.4; } }
            Fill { span: BoardStyle.wide; StatusBar { busy: true; text: "Reading"; } }
        }
    }
    Group {
        title: "Progress";
        states: ["Empty", "40 %", "Full", "Uncounted (sweeping)"];
        span: BoardStyle.field;
        Line {
            label: "Progress";
            Fill { span: BoardStyle.field; Progress { fraction: 0; } }
            Fill { span: BoardStyle.field; Progress { fraction: 0.4; } }
            Fill { span: BoardStyle.field; Progress { fraction: 1; } }
            Fill { span: BoardStyle.field; Progress { fraction: -1; } }
        }
    }
    Group {
        title: "Scroller and its knob";
        states: ["Live (wheel, knob)", "Rest (hidden)", "Lit (hovered)", "Wide (on its strip)"];
        Line {
            label: "over the canvas";
            Cell {
                Stage {
                    width: BoardStyle.cell;
                    height: BoardStyle.cell;
                    Scroller {
                        content-height: lines.preferred-height;
                        lines := VerticalLayout {
                            padding: Space.s;
                            spacing: Space.xs;
                            for i in 24: Label { text: "Line " + (i + 1); role: TextRole.value; tone: Tone.secondary; }
                        }
                    }
                }
            }
            Cell { KnobStage { } }
            Cell { KnobStage { hovered: true; } }
            Cell { KnobStage { hovered: true; look: Look.hover; } }
        }
        Line {
            label: "content that fits: no knob, the wheel passing to the page";
            Cell {
                Stage {
                    width: BoardStyle.cell;
                    height: BoardStyle.cell;
                    Scroller {
                        content-height: fits.preferred-height;
                        fits := VerticalLayout {
                            padding: Space.s;
                            spacing: Space.xs;
                            for i in 3: Label { text: "Line " + (i + 1); role: TextRole.value; tone: Tone.secondary; }
                        }
                    }
                }
            }
            Absent { text: "— it never shows"; }
        }
    }
}
