// The board's containers: the block's Section in each form, the help mark and a still copy of the
// card and the tooltip `TipLayer` draws, the sheets, the cards and the panels; notices.slint the rest.
import { Colour, Space, Stroke, Type, TipStyle, SheetStyle, FormStyle, Look, Label, TextRole, Tone, Picture, Ground, Surface, Card, FloatingColumn, Button, ButtonKind, Tabs, HelpMark, Section, Dialog, PanelSheet, BoardSheet, BoardCard, PopoverPanel, TextField, Toggle, ButtonGroup, GroupAlign, Field, FieldLayout } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill, Absent, Stage } from "kit.slint";
import { NoticeGroups } from "notices.slint";

// A section on the panel's ground at the panel's width.
component SectionCell inherits Fill {
    span: BoardStyle.panel;
    Surface {
        height: holder.preferred-height;
        holder := VerticalLayout { @children }
    }
}

// The help card as `TipLayer` draws a help mark's note: the clip's 4:3 place, then the note.
component HelpCard inherits Rectangle {
    in property <string> text;
    width: TipStyle.card-width;
    height: column.preferred-height;
    background: Colour.tip;
    border-radius: TipStyle.card-radius;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    clip: true;
    column := VerticalLayout {
        padding: TipStyle.card-padding;
        spacing: TipStyle.card-padding;
        Picture { height: (TipStyle.card-width - 2 * TipStyle.card-padding) * 3 / 4; ground: Ground.skeleton; rounded: true; }
        Label { role: TextRole.caption; font-weight: Type.medium; text: root.text; wrap: word-wrap; }
    }
}

// The tooltip as `TipLayer` draws a hovered control's name.
component TipLine inherits Rectangle {
    in property <string> text;
    width: line.preferred-width + 2 * TipStyle.padding-x;
    height: line.preferred-height + 2 * TipStyle.padding-y;
    background: Colour.tip;
    border-radius: TipStyle.radius;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    line := Label { x: TipStyle.padding-x; y: TipStyle.padding-y; role: TextRole.caption; text: root.text; }
}

// A sheet's card in the room `Sheet` hangs it in.
component Hung inherits Rectangle {
    width: SheetStyle.width + 2 * Space.l;
}

export component ContainersPage inherits Page {
    title: "Containers";
    note: "Section: title, help, news, block + modified, folded, foldable, separated. Sheet (Dialog: question, wide), PanelSheet, BoardSheet, Card, FloatingColumn, PopoverPanel, notices, status, progress.";
    Group {
        title: "Section (on the panel)";
        states: ["Live (fold, RESET, ?)", "Folded"];
        span: BoardStyle.panel;
        Line {
            label: "titled";
            SectionCell { Section { title: "Exposure"; Label { text: "Content"; tone: Tone.secondary; } } }
            SectionCell { Section { title: "Exposure"; folded: true; Label { text: "Content"; } } }
        }
        Line {
            label: "with a help mark";
            SectionCell { Section { title: "Contrast"; help: "Contrast bends the print into an S."; Label { text: "Content"; tone: Tone.secondary; } } }
            SectionCell { Section { title: "Contrast"; help: "Contrast bends the print into an S."; folded: true; Label { text: "Content"; } } }
        }
        Line {
            label: "with news, its note on hover";
            SectionCell { Section { title: "Grain"; news: "NEW"; news-note: "Grain now follows the film's own size."; Label { text: "Content"; tone: Tone.secondary; } } }
            SectionCell { Section { title: "Grain"; news: "NEW"; folded: true; Label { text: "Content"; } } }
        }
        Line {
            label: "modified, RESET shown";
            levels := SectionCell {
                property <bool> modified: true;
                Section { title: "Levels"; block: 0; modified: levels.modified; reset => { levels.modified = false; } Label { text: "RESET clears it"; tone: Tone.secondary; } }
            }
            SectionCell { Section { title: "Levels"; block: 0; modified: true; folded: true; Label { text: "Content"; } } }
        }
        Line {
            label: "resettable, unmodified";
            SectionCell { Section { title: "Levels"; block: 0; Label { text: "Content"; tone: Tone.secondary; } } }
            SectionCell { Section { title: "Levels"; block: 0; folded: true; Label { text: "Content"; } } }
        }
        Line {
            label: "unfoldable (a settings page)";
            SectionCell { Section { title: "Clicks"; foldable: false; Field { layout: FieldLayout.spread; label: "Keys click"; Toggle { on: true; } } } }
            Absent { span: BoardStyle.panel; text: "— it never folds"; }
        }
        Line {
            label: "not separated (a panel's first)";
            SectionCell { Section { title: "First block"; separated: false; Label { text: "Content"; tone: Tone.secondary; } } }
            SectionCell { Section { title: "First block"; separated: false; folded: true; Label { text: "Content"; } } }
        }
    }
    Group {
        title: "HelpMark, its card and the tooltip";
        states: ["Live (hover)", "Hover", "The card it shows", "A control's tooltip"];
        span: TipStyle.card-width;
        Line {
            label: "the \"?\" and what TipLayer draws, held still";
            Cell { span: TipStyle.card-width; HelpMark { note: "A block's note, shown at once as a card."; } }
            Cell { span: TipStyle.card-width; HelpMark { note: "A block's note."; look: Look.hover; } }
            Cell { span: TipStyle.card-width; HelpCard { text: "Contrast bends the print into an S about a middle grey, its ends held."; } }
            Cell { span: TipStyle.card-width; TipLine { text: "Zoom in (⌘+)"; } }
        }
    }
    Group {
        title: "Sheets";
        states: ["As hung from the window's top"];
        span: FormStyle.paper-width + 2 * Space.l;
        Line {
            label: "Sheet: a question";
            Hung {
                height: question.height + 2 * Space.l;
                question := Dialog {
                    title: "Move 3 photos to the ONI Trash?";
                    question: true;
                    Label { text: "They stay there until the trash is emptied."; tone: Tone.secondary; wrap: word-wrap; }
                    ButtonGroup { plate: true; align: GroupAlign.end; Button { text: "CANCEL"; } Button { text: "MOVE"; kind: ButtonKind.destructive; } }
                }
            }
        }
        Line {
            label: "Sheet: a full sheet, wide";
            Hung {
                width: SheetStyle.wide-width + 2 * Space.l;
                height: full.height + 2 * Space.l;
                full := Dialog {
                    title: "Export";
                    wide: true;
                    Label { text: "A sheet's content, hung from the window's top."; tone: Tone.secondary; wrap: word-wrap; }
                    TextField { value: "Roll #8"; }
                    ButtonGroup { plate: true; align: GroupAlign.end; Button { text: "CANCEL"; } Button { text: "EXPORT"; kind: ButtonKind.accent; } }
                }
            }
        }
        Line {
            label: "PanelSheet: its own gauge";
            Hung {
                height: 5 * BoardStyle.gap + 2 * SheetStyle.margin;
                PanelSheet {
                    panel-width: SheetStyle.width;
                    panel-height: 5 * BoardStyle.gap;
                    VerticalLayout {
                        padding: Space.l;
                        spacing: Space.s;
                        Label { role: TextRole.title; text: "Save Preset"; }
                        Label { text: "A sheet at its own gauge."; tone: Tone.secondary; }
                    }
                }
            }
        }
        Line {
            label: "BoardSheet holding a BoardCard";
            Rectangle {
                width: FormStyle.paper-width + 2 * Space.l;
                height: 20 * BoardStyle.gap;
                BoardSheet {
                    title: "Paper";
                    VerticalLayout {
                        width: FormStyle.paper-list;
                        padding: Space.l;
                        spacing: Space.s;
                        Label { tone: Tone.tertiary; text: "MAKERS"; }
                        Label { text: "Hahnemühle"; }
                        Label { text: "Canson"; tone: Tone.secondary; }
                    }
                    VerticalLayout {
                        padding-right: Space.l;
                        padding-bottom: Space.l;
                        BoardCard {
                            Label { role: TextRole.title; text: "Photo Rag 308"; }
                            Label { text: "A card on the canvas's dark."; tone: Tone.secondary; }
                        }
                    }
                }
            }
        }
    }
    Group {
        title: "Cards and panels";
        states: ["Live", "Dimmed (cropping)"];
        span: FormStyle.panel-width;
        Line {
            label: "Card";
            Cell { span: FormStyle.panel-width; Card { width: BoardStyle.wide; height: BoardStyle.cell; } }
            Cell { span: FormStyle.panel-width; Card { width: BoardStyle.wide; height: BoardStyle.cell; dimmed: true; } }
        }
        Line {
            label: "FloatingColumn over the card";
            Cell {
                span: FormStyle.panel-width;
                Stage {
                    width: BoardStyle.wide;
                    height: BoardStyle.cell + 2 * Space.l;
                    FloatingColumn {
                        width: BoardStyle.wide - 2 * Space.l;
                        height: BoardStyle.cell;
                        VerticalLayout { padding: Space.m; Label { text: "A hidden column slid over the card."; tone: Tone.secondary; wrap: word-wrap; } }
                    }
                }
            }
        }
        Line {
            label: "PopoverPanel";
            Cell {
                span: FormStyle.panel-width;
                PopoverPanel {
                    Label { text: "Working Space"; role: TextRole.section; }
                    Tabs { tabs: ["sRGB", "Display P3", "Rec. 2020"]; selected: 1; }
                    Label { text: "What the picture is edited and exported in."; tone: Tone.secondary; wrap: word-wrap; }
                }
            }
        }
        Line {
            label: "Surface on each ground";
            Cell {
                span: FormStyle.panel-width;
                HorizontalLayout {
                    spacing: BoardStyle.gap;
                    for ground[i] in [Ground.ground, Ground.canvas, Ground.well, Ground.paper]: VerticalLayout {
                        spacing: Space.xxs;
                        Surface { width: 4 * BoardStyle.gap; height: self.width; ground: ground; }
                        Label { role: TextRole.caption; tone: Tone.tertiary; text: ["ground", "canvas", "well", "paper"][i]; }
                    }
                }
            }
        }
    }
    NoticeGroups { }
}
