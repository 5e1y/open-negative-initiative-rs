// The board's plots and canvas marks: the histogram's frame, the plot screen, the track's knobs in
// each ink and state, every ink, the crop and window frames, and the marks drawn over a photo.
import { Colour, Space, Stroke, PlotInkStyle, SplitStyle, PlotSize, Ground, Label, Tone, TextRole, HistogramFrame, Picture, Ink, Inks, PlotKnob, Plot, TrackKnob, LevelsTrack, PlotReadouts, AxisCaptions, FrameOverlay, FrameStyle, Well, BrushDisc, CorrectionMark, Badge, LoupeBand, SplitGuide, LiveStroke, SourceTrace, DustOriginal } from "../ds.slint";
import { BoardStyle, Page, Group, Row, Cell, Fill, Stage, Samples } from "kit.slint";

struct Named { name: string, ink: Ink }

// A track knob in one ink: at rest, under the pointer, held.
component KnobRow inherits Row {
    in property <Ink> ink;
    for state in 3: Cell {
        Rectangle {
            width: BoardStyle.cell / 2;
            height: PlotInkStyle.knob-height * 1.5;
            TrackKnob {
                y: (parent.height - PlotInkStyle.knob-height) / 2;
                knob: { x: BoardStyle.cell / 4, ink: root.ink, held: state == 2, label: "" };
                over: state == 1;
            }
        }
    }
}

// A photo on the canvas with something drawn over it.
component OverPhoto inherits Stage {
    width: BoardStyle.wide;
    height: BoardStyle.wide * 2 / 3;
    Picture { source: Samples.photo; ground: Ground.canvas; }
}

export component PlotsPage inherits Page {
    title: "Plots";
    note: "HistogramFrame, Plot, TrackKnob in each ink, LevelsTrack, AxisCaptions, PlotReadouts, every Ink, FrameOverlay, and the marks the canvas draws.";
    property <[Named]> inks: [
        { name: "guide", ink: Ink.guide }, { name: "guide-faint", ink: Ink.guide-faint }, { name: "marker", ink: Ink.marker },
        { name: "separator", ink: Ink.separator }, { name: "active", ink: Ink.active }, { name: "idle", ink: Ink.idle },
        { name: "track", ink: Ink.track }, { name: "primary", ink: Ink.primary }, { name: "canvas", ink: Ink.canvas },
        { name: "black", ink: Ink.black }, { name: "white", ink: Ink.white }, { name: "red", ink: Ink.red },
        { name: "green", ink: Ink.green }, { name: "blue", ink: Ink.blue }, { name: "grey-quarter", ink: Ink.grey-quarter },
        { name: "grey-half", ink: Ink.grey-half }, { name: "grey-three-quarters", ink: Ink.grey-three-quarters }, { name: "band-red", ink: Ink.band-red },
        { name: "band-orange", ink: Ink.band-orange }, { name: "band-yellow", ink: Ink.band-yellow }, { name: "band-green", ink: Ink.band-green },
        { name: "band-aqua", ink: Ink.band-aqua }, { name: "band-blue", ink: Ink.band-blue }, { name: "band-purple", ink: Ink.band-purple },
        { name: "band-magenta", ink: Ink.band-magenta },
    ];
    Group {
        title: "Plot screens";
        states: ["HistogramFrame, main", "HistogramFrame, block", "Plot: grid, curve, dots"];
        span: BoardStyle.panel;
        Row {
            label: "frames (Rust paints the histogram)";
            Fill { span: BoardStyle.panel; HistogramFrame { size: PlotSize.main; ground: Ground.canvas; } }
            Fill { span: BoardStyle.panel; HistogramFrame { size: PlotSize.block; ground: Ground.canvas; } }
            Fill {
                span: BoardStyle.panel;
                VerticalLayout {
                    spacing: Space.xs;
                    AxisCaptions { start: "Black point"; end: "White point"; }
                    Plot {
                        height: PlotInkStyle.histogram;
                        lines: [
                            { commands: "M 0 96 L 340 0", ink: Ink.separator, width: Stroke.hairline, opacity: 1 },
                            { commands: "M 0 90 L 85 72 L 170 44 L 255 22 L 340 6", ink: Ink.active, width: Stroke.trace, opacity: 1 },
                        ];
                        dots: [
                            { x: 170px, y: 44px, size: 9px, fill: Ink.canvas, edge: Ink.active, edge-width: Stroke.trace, halo: 0px },
                            { x: 255px, y: 22px, size: 9px, fill: Ink.band-orange, edge: Ink.band-orange, edge-width: 0px, halo: 17px },
                        ];
                    }
                    PlotReadouts { readouts: [{ name: "Black", value: "0.000" }, { name: "Mid", value: "0.500" }, { name: "White", value: "2.700" }]; }
                }
            }
        }
    }
    Group {
        title: "TrackKnob";
        states: ["Rest", "Under the pointer", "Held"];
        KnobRow { label: "grey-quarter"; ink: Ink.grey-quarter; }
        KnobRow { label: "grey-half"; ink: Ink.grey-half; }
        KnobRow { label: "grey-three-quarters"; ink: Ink.grey-three-quarters; }
        KnobRow { label: "black"; ink: Ink.black; }
        KnobRow { label: "white"; ink: Ink.white; }
        KnobRow { label: "red"; ink: Ink.red; }
        KnobRow { label: "green"; ink: Ink.green; }
        KnobRow { label: "blue"; ink: Ink.blue; }
    }
    Group {
        title: "LevelsTrack";
        Row {
            label: "five handles, the middle held";
            Fill {
                span: BoardStyle.panel;
                VerticalLayout {
                    padding-left: PlotInkStyle.knob-width / 2;
                    padding-right: PlotInkStyle.knob-width / 2;
                    LevelsTrack {
                        knobs: [
                            { x: 70px, ink: Ink.grey-quarter, held: false, label: "Shadows" },
                            { x: 145px, ink: Ink.grey-half, held: true, label: "Midpoint" },
                            { x: 220px, ink: Ink.grey-three-quarters, held: false, label: "Highlights" },
                            { x: 0px, ink: Ink.black, held: false, label: "Black" },
                            { x: 290px, ink: Ink.white, held: false, label: "White" },
                        ];
                    }
                }
            }
        }
    }
    Group {
        title: "Ink";
        Rectangle {
            height: ceil(root.inks.length / 5) * BoardStyle.gap * 2;
            for named[i] in root.inks: HorizontalLayout {
                x: Math.mod(i, 5) * (BoardStyle.label + BoardStyle.gap);
                y: floor(i / 5) * BoardStyle.gap * 2;
                width: BoardStyle.label;
                height: BoardStyle.gap * 2 - Space.xs;
                spacing: Space.s;
                Rectangle {
                    width: BoardStyle.gap * 2;
                    background: Inks.of(named.ink);
                    border-width: Stroke.hairline;
                    border-color: Colour.separator;
                }
                Label { text: named.name; role: TextRole.caption; tone: Tone.secondary; }
            }
        }
    }
    Group {
        title: "Frames over a photo";
        states: ["FrameOverlay, crop", "FrameOverlay, measuring window", "SplitGuide (compare)"];
        span: BoardStyle.wide;
        Row {
            label: "at rest";
            Cell {
                span: BoardStyle.wide;
                OverPhoto {
                    FrameOverlay { frame-x: BoardStyle.wide / 6; frame-y: BoardStyle.wide / 10; frame-width: BoardStyle.wide * 2 / 3; frame-height: BoardStyle.wide * 7 / 15; }
                }
            }
            Cell {
                span: BoardStyle.wide;
                OverPhoto {
                    FrameOverlay { look: FrameStyle.window; frame-x: BoardStyle.wide / 3; frame-y: BoardStyle.wide / 6; frame-width: BoardStyle.wide / 3; frame-height: BoardStyle.wide / 3; }
                }
            }
            Cell {
                span: BoardStyle.wide;
                OverPhoto {
                    SplitGuide { x: (parent.width - self.width) / 2; height: parent.height; }
                }
            }
        }
    }
    Group {
        title: "Canvas marks";
        states: ["Well", "BrushDisc", "CorrectionMark", "Strokes", "DustOriginal", "Badge"];
        Row {
            label: "as the canvas draws them";
            Cell { Well { width: BoardStyle.cell - Space.l; height: BoardStyle.cell / 2; } }
            Cell { Stage { width: BoardStyle.cell / 2; height: BoardStyle.cell / 2; BrushDisc { width: parent.width * 2 / 3; height: self.width; } } }
            Cell {
                Stage {
                    width: BoardStyle.cell / 2 + Space.l;
                    height: BoardStyle.cell / 2;
                    CorrectionMark { x: Space.s; y: Space.l; width: BoardStyle.cell / 4; height: self.width; number: 3; }
                }
            }
            Cell {
                Stage {
                    width: BoardStyle.cell - Space.l;
                    height: BoardStyle.cell / 2;
                    LiveStroke { width: parent.width; height: parent.height; thickness: Space.s; commands: "M 12 50 L 40 20 L 70 45 L 110 15"; }
                    SourceTrace { width: parent.width; height: parent.height; thickness: Stroke.line; commands: "M 12 64 L 110 64"; }
                }
            }
            Cell { DustOriginal { source: Samples.photo; } }
            Cell { Stage { width: BoardStyle.cell / 2; height: BoardStyle.cell / 4; Badge { text: "1:1"; } } }
        }
    }
    Group {
        title: "LoupeBand";
        Row {
            label: "the Details band, its ratio badge";
            Fill {
                span: BoardStyle.panel;
                LoupeBand {
                    height: BoardStyle.cell;
                    source: Samples.photo;
                    shown-width: BoardStyle.cell * 3 / 2;
                    shown-height: BoardStyle.cell;
                    ratio: "2:1";
                    ratio-shown: true;
                }
            }
        }
    }
}
