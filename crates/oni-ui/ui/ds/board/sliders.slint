// The board's sliders: Slider in each fill and knob, then the Scanner face's StepSlider in each band's
// colours; the live column holds its own value, as Rust does in the app.
import { Colour, ScannerStyle, SliderFill, Knob, Slider, StepSlider } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Fill, Looks } from "kit.slint";

// One slider live (dragged, Option for a tenth of the travel), hovered, pressed, disabled.
component SliderStates inherits Line {
    in property <string> name;
    in property <float> at: 0.62;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    in property <Knob> knob: Knob.grey;
    live := Fill {
        span: BoardStyle.wide;
        property <float> at: root.at;
        property <float> from;
        Slider {
            label: root.name;
            readout: round(live.at * 100) + " %";
            fraction: live.at;
            fill: root.fill;
            tint: root.tint;
            low: root.low;
            high: root.high;
            knob: root.knob;
            press(f, fine) => {
                live.from = live.at;
                false
            }
            drag(f, dx, w, fine) => { live.at = clamp(live.from + dx / w * (fine ? 0.1 : 1), 0, 1); }
            step(f, by) => { live.at = clamp(live.at + by / 100, 0, 1); }
        }
    }
    for state in 3: Fill {
        span: BoardStyle.wide;
        Slider {
            label: root.name;
            readout: round(root.at * 100) + " %";
            fraction: root.at;
            fill: root.fill;
            tint: root.tint;
            low: root.low;
            high: root.high;
            knob: root.knob;
            look: Looks.of(state + 1);
            enabled: state != 2;
        }
    }
}

// A step slider live (slid, its keys stepping, three with ⇧, the title's double click resting it),
// hovered, pressed, disabled.
component StepStates inherits Line {
    in property <string> title;
    in property <int> value;
    in property <int> low: -10;
    in property <int> high: 10;
    in property <color> minus;
    in property <color> plus;
    live := Fill {
        span: BoardStyle.wide;
        property <int> value: root.value;
        StepSlider {
            title: root.title;
            readout: (live.value > 0 ? "+" : "") + live.value;
            value: live.value;
            low: root.low;
            high: root.high;
            minus: root.minus;
            plus: root.plus;
            minus-help: "One step down";
            plus-help: "One step up";
            stepped(by) => { live.value = clamp(live.value + by, root.low, root.high); }
            reset => { live.value = 0; }
        }
    }
    for state in 3: Fill {
        span: BoardStyle.wide;
        StepSlider {
            title: root.title;
            readout: (root.value > 0 ? "+" : "") + root.value;
            value: root.value;
            low: root.low;
            high: root.high;
            minus: root.minus;
            plus: root.plus;
            look: Looks.of(state + 1);
            enabled: state != 2;
        }
    }
}

export component SliderPage inherits Page {
    title: "Slider and StepSlider";
    note: "Slider: fill (level, ramp, bipolar, metal) × knob (grey, white, black), tint, low, high. StepSlider: low, high, minus, plus.";
    property <[string]> states: ["Live", "Hover", "Pressed (held)", "Disabled"];
    Group {
        title: "Slider";
        states: root.states;
        span: BoardStyle.wide;
        SliderStates { label: "level, grey knob"; name: "Exposure"; }
        SliderStates { label: "level, white knob"; name: "White point"; at: 0.85; knob: Knob.white; }
        SliderStates { label: "level, black knob"; name: "Black point"; at: 0.15; knob: Knob.black; }
        SliderStates { label: "ramp, white"; name: "Highlights"; at: 0.8; fill: SliderFill.ramp; tint: Colour.white; knob: Knob.white; }
        SliderStates { label: "ramp, black"; name: "Shadows"; at: 0.2; fill: SliderFill.ramp; tint: Colour.black; knob: Knob.black; }
        SliderStates { label: "bipolar"; name: "Temperature"; at: 0.5; fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow; }
        SliderStates { label: "metal"; name: "Grain"; at: 0.4; fill: SliderFill.metal; }
    }
    Group {
        title: "StepSlider";
        states: root.states;
        span: BoardStyle.wide;
        StepStates { label: "D, dark to light"; title: "D"; value: 3; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; }
        StepStates { label: "C, red to cyan"; title: "C"; value: -2; minus: ScannerStyle.band-red; plus: ScannerStyle.band-cyan; }
        StepStates { label: "M, green to magenta"; title: "M"; value: 0; minus: ScannerStyle.band-green; plus: ScannerStyle.band-magenta; }
        StepStates { label: "Y, blue to yellow"; title: "Y"; value: 1; minus: ScannerStyle.band-blue; plus: ScannerStyle.band-yellow; }
        StepStates { label: "TEMP, cool to warm"; title: "TEMP"; value: 5; minus: ScannerStyle.band-cool; plus: ScannerStyle.band-warm; }
    }
}
