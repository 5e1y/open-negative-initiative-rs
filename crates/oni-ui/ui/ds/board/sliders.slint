// The board's sliders: the knob and the rail they are built of, Slider in each fill and knob, then
// stepped in each Scanner band's colours; the live column holds its own value, as Rust does in the app.
import { Colour, ScannerStyle, SliderStyle, SliderFill, Slider, Knob, Rail, Inks, Ink } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill, Looks } from "kit.slint";

// A knob in one fill: live (grown under the pointer and held), hovered, pressed.
component KnobRow inherits Line {
    in property <color> fill: SliderStyle.knob;
    in property <bool> grip: true;
    for state in 3: Cell {
        Rectangle {
            width: BoardStyle.cell / 2;
            height: SliderStyle.row * 1.5;
            Knob {
                centre: BoardStyle.cell / 4;
                across: parent.height;
                fill: root.fill;
                grip: root.grip;
                grown: state != 0 || hand.has-hover || hand.pressed;
            }
            hand := TouchArea { enabled: state == 0; }
        }
    }
}

// A rail in one fill, lit to a fifth, three fifths and the end.
component RailRow inherits Line {
    in property <SliderFill> fill;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    in property <float> rest: -1;
    for at in [0.2, 0.6, 1]: Fill {
        span: BoardStyle.field;
        // Inset by the knob's half-width, as a slider's travel is, so the overhang stays in the cell.
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            Rectangle {
                height: SliderStyle.row;
                Rail {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    overhang: SliderStyle.knob-width / 2;
                    fill: root.fill;
                    at: at;
                    tint: root.tint;
                    low: root.low;
                    high: root.high;
                    rest: root.rest;
                }
            }
        }
    }
}

// One slider live (dragged, Option for a tenth of the travel), hovered, pressed, disabled.
component SliderStates inherits Line {
    in property <string> name;
    in property <float> at: 0.62;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    in property <color> knob: SliderStyle.knob;
    live := Fill {
        span: BoardStyle.wide;
        property <float> at: root.at;
        property <float> from;
        Slider {
            label: root.name;
            readout: round(live.at * 100) + " %";
            fraction: live.at;
            fill: root.fill;
            tint: root.tint;
            low: root.low;
            high: root.high;
            knob: root.knob;
            press(f, fine) => {
                live.from = live.at;
                false
            }
            drag(f, dx, w, fine) => { live.at = clamp(live.from + dx / w * (fine ? 0.1 : 1), 0, 1); }
            step(f, by) => { live.at = clamp(live.at + by / 100, 0, 1); }
        }
    }
    for state in 3: Fill {
        span: BoardStyle.wide;
        Slider {
            label: root.name;
            readout: round(root.at * 100) + " %";
            fraction: root.at;
            fill: root.fill;
            tint: root.tint;
            low: root.low;
            high: root.high;
            knob: root.knob;
            look: Looks.of(state + 1);
            enabled: state != 2;
        }
    }
}

// A stepped slider live (slid, its keys stepping, three with ⇧, the name's double click resting it),
// hovered, pressed, disabled.
component StepStates inherits Line {
    in property <string> name;
    in property <int> value;
    in property <int> lowest: -10;
    in property <int> highest: 10;
    in property <color> low;
    in property <color> high;
    live := Fill {
        span: BoardStyle.wide;
        property <int> value: root.value;
        Slider {
            stepped: true;
            fill: SliderFill.bipolar;
            label: root.name;
            readout: (live.value > 0 ? "+" : "") + live.value;
            value: live.value;
            lowest: root.lowest;
            highest: root.highest;
            low: root.low;
            high: root.high;
            minus-help: "One step down";
            help: "Double-click to bring it back to rest";
            plus-help: "One step up";
            step(f, by) => { live.value = clamp(live.value + by, root.lowest, root.highest); }
            reset => { live.value = 0; }
        }
    }
    for state in 3: Fill {
        span: BoardStyle.wide;
        Slider {
            stepped: true;
            fill: SliderFill.bipolar;
            label: root.name;
            readout: (root.value > 0 ? "+" : "") + root.value;
            value: root.value;
            lowest: root.lowest;
            highest: root.highest;
            low: root.low;
            high: root.high;
            look: Looks.of(state + 1);
            enabled: state != 2;
        }
    }
}

export component SliderPage inherits Page {
    title: "Slider, Knob and Rail";
    note: "Knob: centre, fill, grip, grip-ink, grown, slide. Rail: fill (level, ramp, bipolar, metal, none), at, from, tint, low, high, overhang, rest, glow. Slider: fill × knob, tint, low, high; stepped: value, lowest, highest, the keys' and the name's helps.";
    property <[string]> states: ["Live", "Hover", "Pressed", "Disabled"];
    Group {
        title: "Knob";
        states: ["Live", "Hover", "Pressed"];
        KnobRow { label: "grey, grip"; }
        KnobRow { label: "white"; fill: Colour.white; }
        KnobRow { label: "black"; fill: Colour.black; }
        KnobRow { label: "a levels grey"; fill: Inks.of(Ink.grey-half); }
        KnobRow { label: "red"; fill: Inks.of(Ink.red); }
        KnobRow { label: "grey, no grip (stepped)"; grip: false; }
    }
    Group {
        title: "Rail";
        states: ["at 0.2", "at 0.6", "at 1"];
        span: BoardStyle.field;
        RailRow { label: "level"; fill: SliderFill.level; }
        RailRow { label: "ramp, white"; fill: SliderFill.ramp; tint: Colour.white; }
        RailRow { label: "bipolar, rest at the middle"; fill: SliderFill.bipolar; low: ScannerStyle.band-red; high: ScannerStyle.band-cyan; rest: 0.5; }
        RailRow { label: "metal"; fill: SliderFill.metal; }
        RailRow { label: "none (the levels track)"; fill: SliderFill.none; }
    }
    Group {
        title: "Slider";
        states: root.states;
        span: BoardStyle.wide;
        SliderStates { label: "level, grey knob"; name: "Exposure"; }
        SliderStates { label: "level, white knob"; name: "White point"; at: 0.85; knob: Colour.white; }
        SliderStates { label: "level, black knob"; name: "Black point"; at: 0.15; knob: Colour.black; }
        SliderStates { label: "ramp, white"; name: "Highlights"; at: 0.8; fill: SliderFill.ramp; tint: Colour.white; knob: Colour.white; }
        SliderStates { label: "ramp, black"; name: "Shadows"; at: 0.2; fill: SliderFill.ramp; tint: Colour.black; knob: Colour.black; }
        SliderStates { label: "bipolar"; name: "Temperature"; at: 0.5; fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow; }
        SliderStates { label: "metal"; name: "Grain"; at: 0.4; fill: SliderFill.metal; }
    }
    Group {
        title: "Slider, stepped";
        states: root.states;
        span: BoardStyle.wide;
        StepStates { label: "D, dark to light"; name: "D"; value: 3; low: ScannerStyle.band-dark; high: ScannerStyle.band-light; }
        StepStates { label: "C, red to cyan"; name: "C"; value: -2; low: ScannerStyle.band-red; high: ScannerStyle.band-cyan; }
        StepStates { label: "M, green to magenta"; name: "M"; value: 0; low: ScannerStyle.band-green; high: ScannerStyle.band-magenta; }
        StepStates { label: "Y, blue to yellow"; name: "Y"; value: 1; low: ScannerStyle.band-blue; high: ScannerStyle.band-yellow; }
        StepStates { label: "TEMP, cool to warm"; name: "TEMP"; value: 5; low: ScannerStyle.band-cool; high: ScannerStyle.band-warm; }
    }
}
