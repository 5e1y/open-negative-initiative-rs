// The board's lists and trees: the archive's rows of every kind, the navigator's and the trash's,
// the headings, the rename field, the drop marks and the scroll knob.
import { Colour, Space, Stroke, Look, RowKind, DropRing, DropLine, ScrollKnob, Row, TileHeading, NavigatorStyle } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill, Stage, Samples } from "kit.slint";

// A tree row of one kind at rest, hovered and selected.
component TreeRow inherits Line {
    in property <string> title;
    in property <string> caption;
    in property <int> depth;
    in property <RowKind> kind;
    in property <bool> expandable;
    in property <bool> expanded;
    in property <bool> has-stock;
    Fill { span: BoardStyle.library; Row { title: root.title; caption: root.caption; depth: root.depth; kind: root.kind; expandable: root.expandable; expanded: root.expanded; has-stock: root.has-stock; stock: Samples.stock; } }
    Fill { span: BoardStyle.library; Row { title: root.title; caption: root.caption; depth: root.depth; kind: root.kind; expandable: root.expandable; expanded: root.expanded; has-stock: root.has-stock; stock: Samples.stock; look: Look.hover; } }
    Fill { span: BoardStyle.library; Row { title: root.title; caption: root.caption; depth: root.depth; kind: root.kind; expandable: root.expandable; expanded: root.expanded; has-stock: root.has-stock; stock: Samples.stock; selected: true; } }
}

// A navigator row: rest, hovered (its star shown), picked, opened, on an absent volume.
component NavigatorRow inherits Line {
    in property <string> title;
    in property <RowKind> kind;
    in property <bool> chevron;
    in property <bool> unfolded;
    in property <bool> favourite;
    in property <int> depth;
    Fill { span: BoardStyle.library; Row { rounded: true; quiet: true; starrable: true; folds: false; open: false; absent: NavigatorStyle.absent; title: root.title; kind: root.kind; expandable: root.chevron; expanded: root.unfolded; favourite: root.favourite; depth: root.depth; } }
    Fill { span: BoardStyle.library; Row { rounded: true; quiet: true; starrable: true; folds: false; open: false; absent: NavigatorStyle.absent; title: root.title; kind: root.kind; expandable: root.chevron; expanded: root.unfolded; favourite: root.favourite; depth: root.depth; look: Look.hover; } }
    Fill { span: BoardStyle.library; Row { rounded: true; quiet: true; starrable: true; folds: false; open: false; absent: NavigatorStyle.absent; title: root.title; kind: root.kind; expandable: root.chevron; expanded: root.unfolded; favourite: root.favourite; depth: root.depth; picked: true; } }
    Fill { span: BoardStyle.library; Row { rounded: true; quiet: true; starrable: true; folds: false; open: false; absent: NavigatorStyle.absent; title: root.title; kind: root.kind; expandable: root.chevron; expanded: root.unfolded; favourite: root.favourite; depth: root.depth; selected: true; } }
    Fill { span: BoardStyle.library; Row { rounded: true; quiet: true; starrable: true; folds: false; open: false; absent: NavigatorStyle.absent; title: root.title; kind: root.kind; expandable: root.chevron; expanded: root.unfolded; favourite: root.favourite; depth: root.depth; present: false; } }
}

// A trash row: rest, hovered (its Restore key shown), picked, opened, its folder gone.
component BinRow inherits Line {
    in property <string> title;
    in property <string> trail;
    in property <string> count;
    in property <int> depth;
    in property <bool> foldable;
    Fill { span: BoardStyle.library; Row { kind: RowKind.trash; rounded: true; quiet: true; folds: false; title: root.title; trail: root.trail; caption: root.count; depth: root.depth; expandable: root.foldable; expanded: true; action: "RESTORE"; action-help: "Restore"; } }
    Fill { span: BoardStyle.library; Row { kind: RowKind.trash; rounded: true; quiet: true; folds: false; title: root.title; trail: root.trail; caption: root.count; depth: root.depth; expandable: root.foldable; expanded: true; action: "RESTORE"; action-help: "Restore"; look: Look.hover; } }
    Fill { span: BoardStyle.library; Row { kind: RowKind.trash; rounded: true; quiet: true; folds: false; title: root.title; trail: root.trail; caption: root.count; depth: root.depth; expandable: root.foldable; expanded: true; action: "RESTORE"; action-help: "Restore"; picked: true; } }
    Fill { span: BoardStyle.library; Row { kind: RowKind.trash; rounded: true; quiet: true; folds: false; title: root.title; trail: root.trail; caption: root.count; depth: root.depth; expandable: root.foldable; expanded: true; action: "RESTORE"; action-help: "Restore"; selected: true; } }
    Fill { span: BoardStyle.library; Row { kind: RowKind.trash; rounded: true; quiet: true; folds: false; title: root.title; trail: root.trail; caption: root.count; depth: root.depth; expandable: root.foldable; expanded: true; action: "RESTORE"; action-help: "Restore"; present: false; } }
}

// The knob over a strip of the canvas, a third of its content shown.
component KnobStage inherits Stage {
    in property <bool> hovered;
    in property <Look> look: Look.live;
    width: BoardStyle.cell / 2;
    height: BoardStyle.cell;
    ScrollKnob {
        width: parent.width;
        height: parent.height;
        page: parent.height;
        whole: 3 * parent.height;
        offset: parent.height / 2;
        hovered: root.hovered;
        across: parent.width;
        look: root.look;
    }
}

export component ListsPage inherits Page {
    title: "Lists and trees";
    note: "ListRow, TreeItem of every kind, PinnedTreeRow, FolderRow, TrashRow, RenameRow, the headings, the drop marks and ScrollKnob.";
    Group {
        title: "ListRow, TreeItem, PinnedTreeRow";
        states: ["Rest", "Hover", "Selected"];
        span: BoardStyle.library;
        Line {
            label: "ListRow";
            Fill { span: BoardStyle.library; Row { title: "Gold photos"; caption: "12"; } }
            Fill { span: BoardStyle.library; Row { title: "Gold photos"; caption: "12"; look: Look.hover; } }
            Fill { span: BoardStyle.library; Row { title: "Gold photos"; caption: "12"; selected: true; } }
        }
        TreeRow { label: "folder, folded"; title: "Negs"; caption: "4"; kind: RowKind.folder; expandable: true; }
        TreeRow { label: "folder, open"; title: "Negs"; caption: "4"; kind: RowKind.folder; expandable: true; expanded: true; }
        TreeRow { label: "roll"; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; expandable: true; }
        TreeRow { label: "roll with its stock"; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; expandable: true; has-stock: true; }
        TreeRow { label: "photo"; title: "DSC_6432"; depth: 2; kind: RowKind.photo; }
        TreeRow { label: "project"; title: "Summer prints"; caption: "9"; kind: RowKind.project; }
        Line {
            label: "PinnedTreeRow";
            Fill { span: BoardStyle.library; Row { pinned: true; expandable: true; expanded: true; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; } }
            Fill { span: BoardStyle.library; Row { pinned: true; expandable: true; expanded: true; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; look: Look.hover; } }
            Fill { span: BoardStyle.library; Row { pinned: true; expandable: true; expanded: true; title: "Roll #8"; caption: "36"; depth: 1; kind: RowKind.roll; selected: true; } }
        }
    }
    Group {
        title: "FolderRow (navigator) and TrashRow";
        states: ["Rest", "Hover", "Picked", "Opened", "Absent"];
        span: BoardStyle.library;
        NavigatorRow { label: "folder, folded"; title: "Negs"; chevron: true; }
        NavigatorRow { label: "folder, open"; title: "Negs"; chevron: true; unfolded: true; kind: RowKind.opened; }
        NavigatorRow { label: "roll, favourite"; title: "Roll #8"; depth: 1; kind: RowKind.roll; favourite: true; }
        BinRow { label: "the ONI Trash"; title: "ONI Trash"; count: "3"; foldable: true; }
        BinRow { label: "a trashed folder"; title: "Roll #8"; trail: "Negs/"; count: "2"; depth: 1; }
    }
    Group {
        title: "Headings, renaming and drops";
        states: ["As drawn"];
        span: BoardStyle.wide;
        Line { label: "TileHeading"; Fill { span: BoardStyle.wide; TileHeading { title: "Roll #8"; caption: "Negs"; } } }
        Line { label: "PinnedHeading"; Fill { span: BoardStyle.wide; TileHeading { pinned: true; title: "Roll #8"; caption: "Negs"; } } }
        Line { label: "RenameRow (focused)"; Fill { span: BoardStyle.wide; Row { renaming: true; title: "Roll #8"; depth: 1; } } }
        Line {
            label: "DropRing over a row";
            Fill {
                span: BoardStyle.wide;
                Rectangle {
                    height: ring.height;
                    ring := Row { title: "Negs"; caption: "4"; kind: RowKind.folder; expandable: true; }
                    DropRing { width: parent.width; height: parent.height; }
                }
            }
        }
        Line {
            label: "DropLine between rows";
            Fill {
                span: BoardStyle.wide;
                VerticalLayout {
                    Row { title: "DSC_6431"; depth: 2; kind: RowKind.photo; }
                    DropLine { height: Stroke.emphasis; }
                    Row { title: "DSC_6432"; depth: 2; kind: RowKind.photo; }
                }
            }
        }
    }
    Group {
        title: "ScrollKnob";
        states: ["Rest (hidden)", "Lit (scrolled, hovered)", "Wide (on its strip)"];
        Line {
            label: "over the canvas";
            Cell { KnobStage { } }
            Cell { KnobStage { hovered: true; } }
            Cell { KnobStage { hovered: true; look: Look.hover; } }
        }
    }
}
