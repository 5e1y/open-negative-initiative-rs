// The board's menus: a menu's line in each state, the panel, the context menu's and the folder pill's
// lines drawn as their popups lay them, the pickers that drop them, and the medal picker.
import { Colour, Space, Stroke, ButtonStyle, MenuStyle, RowStyle, Icons, Look, Label, Icon, Tone, Divider, MenuEntry, MenuPanel, MedalPicker, NavigatorStyle, Menu, Picker } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill } from "kit.slint";

// One menu line in its six states.
component EntryRow inherits Line {
    in property <string> text;
    in property <string> shortcut;
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; look: Look.hover; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; enabled: false; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; checked: true; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; checked: true; look: Look.hover; } }
}

// `FolderMenu`'s line as its popup draws it: a folder's glyph, its name, a check on the current one.
component FolderLine inherits Rectangle {
    in property <string> title;
    in property <bool> current;
    in property <bool> hovered;
    height: MenuStyle.row;
    border-radius: ButtonStyle.small-radius;
    background: root.hovered ? Colour.hover : transparent;
    HorizontalLayout {
        padding-left: Space.xs;
        padding-right: Space.xs;
        spacing: Space.s;
        VerticalLayout { alignment: center; Icon { source: Icons.folder; width: RowStyle.icon; height: RowStyle.icon; } }
        Label { text: root.title; overflow: elide; horizontal-stretch: 1; }
        if root.current: VerticalLayout {
            alignment: center;
            Icon { source: Icons.done; width: NavigatorStyle.star; height: NavigatorStyle.star; tone: Tone.primary; }
        }
    }
}

export component MenusPage inherits Page {
    title: "Menus";
    note: "MenuEntry in each state, MenuPanel, ContextMenu's and FolderMenu's lines as their popups draw them, MenuPicker, LinesPicker and MedalPicker.";
    Group {
        title: "MenuEntry";
        states: ["Rest", "Hover", "Disabled", "Checked", "Checked, hover"];
        span: MenuStyle.width;
        EntryRow { label: "a word"; text: "Reveal in Finder"; }
        EntryRow { label: "with a shortcut"; text: "Copy Settings"; shortcut: "⌘⇧C"; }
        EntryRow { label: "opening a submenu"; text: "Move to"; shortcut: "›"; }
    }
    Group {
        title: "Panels";
        states: ["MenuPanel (a Menu)", "ContextMenu's lines", "FolderMenu's lines"];
        span: MenuStyle.width;
        Line {
            label: "as their popups draw them";
            Cell {
                span: MenuStyle.width;
                MenuPanel {
                    MenuEntry { text: "sRGB"; }
                    MenuEntry { text: "Display P3"; checked: true; look: Look.hover; }
                    MenuEntry { text: "Rec. 2020"; }
                }
            }
            Cell {
                span: MenuStyle.width;
                MenuPanel {
                    MenuEntry { text: "Open"; }
                    MenuEntry { text: "Reveal in Finder"; look: Look.hover; }
                    Divider { }
                    MenuEntry { text: "Move to"; shortcut: "›"; }
                    MenuEntry { text: "Paste Settings"; enabled: false; }
                    Divider { }
                    MenuEntry { text: "Move to the ONI Trash"; }
                }
            }
            Cell {
                span: MenuStyle.width;
                MenuPanel {
                    FolderLine { title: "Negs"; current: true; }
                    FolderLine { title: "Pictures"; hovered: true; }
                    FolderLine { title: "Computer"; }
                }
            }
        }
    }
    Group {
        title: "Pickers that drop a menu";
        states: ["Rest", "Hover"];
        span: BoardStyle.field;
        Line {
            label: "MenuPicker";
            Fill { span: BoardStyle.field; Picker { value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; } }
            Fill { span: BoardStyle.field; Picker { value: "Display P3"; entries: ["sRGB", "Display P3"]; current: 1; look: Look.hover; } }
        }
        Line {
            label: "LinesPicker";
            Fill { span: BoardStyle.field; Picker { value: "Negs / Roll #8"; } }
            Fill { span: BoardStyle.field; Picker { value: "Negs / Roll #8"; look: Look.hover; } }
        }
    }
    Group {
        title: "MedalPicker";
        states: ["None", "Bronze", "Silver", "Gold"];
        Line {
            label: "the three foils";
            Cell { MedalPicker { } }
            Cell { MedalPicker { current: 1; } }
            Cell { MedalPicker { current: 2; } }
            Cell { MedalPicker { current: 3; } }
        }
    }
}
