// The board's pickers and menus: Picker in each face and form, its menu dropping in the live column,
// MenuEntry in each state, MenuPanel holding them, then MedalPicker.
import { MenuStyle, Look, Divider, MenuLine, FolderChoice, MenuEntry, MenuPanel, PickerFace, Picker, MedalPicker } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill } from "kit.slint";

// A menu line live (a click checks it), hovered, disabled, checked.
component EntryStates inherits Line {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> folder;
    live := Fill {
        span: MenuStyle.width;
        property <bool> checked;
        MenuEntry { text: root.text; shortcut: root.shortcut; folder: root.folder; checked: live.checked; activated => { live.checked = !live.checked; } }
    }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; folder: root.folder; look: Look.hover; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; folder: root.folder; enabled: false; } }
    Fill { span: MenuStyle.width; MenuEntry { text: root.text; shortcut: root.shortcut; folder: root.folder; checked: true; } }
}

export component MenuPage inherits Page {
    title: "Picker and Menu";
    note: "Picker: face (field, pill, chip), label, prefix, value, entries + current, lines, choices, enabled, pressable, help, look; open and chosen; one hover ground for every face. MenuEntry: text, shortcut, checked, folder, enabled, look.";
    property <[MenuLine]> lines: [
        { text: "Negs", enabled: true, rule: false, opens: false },
        { text: "Pictures", enabled: true, rule: false, opens: false },
        { text: "Roll #8", enabled: false, rule: false, opens: false },
        { text: "Elsewhere", enabled: true, rule: true, opens: true },
    ];
    property <[FolderChoice]> ancestors: [{ title: "Negs", current: true }, { title: "Pictures", current: false }, { title: "Computer", current: false }];
    Group {
        title: "Picker";
        states: ["Live (click it)", "Hover", "Disabled"];
        span: BoardStyle.field;
        Line {
            label: "plain, its open callback counted";
            opened := Fill {
                span: BoardStyle.field;
                property <int> count;
                Picker { value: opened.count == 0 ? "Generic C-41" : "Opened " + opened.count + " times"; open => { opened.count += 1; } }
            }
            Fill { span: BoardStyle.field; Picker { value: "Generic C-41"; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { value: "Generic C-41"; enabled: false; } }
        }
        Line {
            label: "entries, the current one checked";
            words := Fill {
                span: BoardStyle.field;
                property <[string]> entries: ["sRGB", "Display P3", "Rec. 2020"];
                property <int> current: 1;
                Picker { value: words.entries[words.current]; entries: words.entries; current: words.current; chosen(i) => { words.current = i; } }
            }
            Fill { span: BoardStyle.field; Picker { value: "Display P3"; entries: ["sRGB", "Display P3", "Rec. 2020"]; current: 1; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { value: "Display P3"; entries: ["sRGB", "Display P3", "Rec. 2020"]; current: 1; enabled: false; } }
        }
        Line {
            label: "lines (a rule, one out of reach)";
            folders := Fill {
                span: BoardStyle.field;
                property <string> value: "Negs";
                Picker { value: folders.value; lines: root.lines; chosen(i) => { folders.value = root.lines[i].text; } }
            }
            Fill { span: BoardStyle.field; Picker { value: "Negs"; lines: root.lines; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { value: "Negs"; lines: root.lines; enabled: false; } }
        }
        Line {
            label: "with a label";
            dyes := Fill {
                span: BoardStyle.field;
                property <int> current;
                Picker { label: "Dyes"; value: ["Generic C-41", "Portra"][dyes.current]; entries: ["Generic C-41", "Portra"]; current: dyes.current; chosen(i) => { dyes.current = i; } }
            }
            Fill { span: BoardStyle.field; Picker { label: "Dyes"; value: "Generic C-41"; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { label: "Dyes"; value: "Generic C-41"; enabled: false; } }
        }
        Line {
            label: "pill: a column's folders";
            pill := Fill {
                span: BoardStyle.field;
                property <string> value: "Negs";
                Picker { face: PickerFace.pill; value: pill.value; help: "~/Pictures/Negs"; choices: root.ancestors; chosen(i) => { pill.value = root.ancestors[i].title; } }
            }
            Fill { span: BoardStyle.field; Picker { face: PickerFace.pill; value: "Negs"; choices: root.ancestors; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { face: PickerFace.pill; value: "Negs"; choices: root.ancestors; enabled: false; } }
        }
        Line {
            label: "pill, a name alone (pressable off)";
            Fill { span: BoardStyle.field; Picker { face: PickerFace.pill; pressable: false; value: "ONI Projects"; help: "Names what the column lists"; } }
            Fill { span: BoardStyle.field; Picker { face: PickerFace.pill; pressable: false; value: "ONI Projects"; look: Look.hover; } }
            Fill { span: BoardStyle.field; Picker { face: PickerFace.pill; pressable: false; value: "ONI Projects"; enabled: false; } }
        }
        Line {
            label: "chip, a prefix";
            Cell { span: BoardStyle.field; Picker { face: PickerFace.chip; prefix: "Space"; value: "Display P3"; help: "Working Space"; } }
            Cell { span: BoardStyle.field; Picker { face: PickerFace.chip; prefix: "Space"; value: "Display P3"; look: Look.hover; } }
            Cell { span: BoardStyle.field; Picker { face: PickerFace.chip; prefix: "Space"; value: "Display P3"; enabled: false; } }
        }
    }
    Group {
        title: "MenuEntry";
        states: ["Live (click checks)", "Hover", "Disabled", "Checked"];
        span: MenuStyle.width;
        EntryStates { label: "a word"; text: "Reveal in Finder"; }
        EntryStates { label: "with a shortcut"; text: "Copy Settings"; shortcut: "⌘⇧C"; }
        EntryStates { label: "opening a submenu"; text: "Move to"; shortcut: "›"; }
        EntryStates { label: "folder"; text: "Negs"; folder: true; }
    }
    Group {
        title: "MenuPanel";
        states: ["Live", "Each state, a rule", "Folder lines"];
        span: MenuStyle.width;
        Line {
            label: "as a Menu draws it";
            panel := Cell {
                span: MenuStyle.width;
                property <int> current: 1;
                MenuPanel {
                    for word[i] in ["sRGB", "Display P3", "Rec. 2020"]: MenuEntry { text: word; checked: i == panel.current; activated => { panel.current = i; } }
                }
            }
            Cell {
                span: MenuStyle.width;
                MenuPanel {
                    MenuEntry { text: "Open"; }
                    MenuEntry { text: "Reveal in Finder"; look: Look.hover; }
                    Divider { }
                    MenuEntry { text: "Move to"; shortcut: "›"; }
                    MenuEntry { text: "Paste Settings"; enabled: false; }
                    MenuEntry { text: "Clipping"; checked: true; }
                }
            }
            Cell {
                span: MenuStyle.width;
                MenuPanel {
                    MenuEntry { folder: true; text: "Negs"; checked: true; }
                    MenuEntry { folder: true; text: "Pictures"; look: Look.hover; }
                    MenuEntry { folder: true; text: "Computer"; }
                }
            }
        }
    }
    Group {
        title: "MedalPicker";
        states: ["Live (click picks)", "None", "Bronze", "Silver", "Gold"];
        Line {
            label: "the three foils";
            medals := Cell {
                property <int> current: -1;
                MedalPicker { current: medals.current; picked(m) => { medals.current = medals.current == m ? -1 : m; } }
            }
            Cell { MedalPicker { } }
            Cell { MedalPicker { current: 1; } }
            Cell { MedalPicker { current: 2; } }
            Cell { MedalPicker { current: 3; } }
        }
    }
}
