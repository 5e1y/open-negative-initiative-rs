// The board's key groups: ButtonGroup bare, on its plate, of small keys, at each place in its row,
// its first key in each state.
import { Icons, ButtonKind, ButtonSize, Button, ButtonGroup, GroupAlign } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Fill, Looks } from "kit.slint";

// A glyph key and two words, the glyph key live, hovered, pressed and on.
component GroupStates inherits Line {
    in property <bool> plate;
    in property <bool> small;
    in property <GroupAlign> align;
    property <ButtonSize> size: root.small ? ButtonSize.small : ButtonSize.regular;
    property <bool> fills: root.align == GroupAlign.fill;
    for state in 4: Fill {
        span: BoardStyle.wide;
        ButtonGroup {
            plate: root.plate;
            small: root.small;
            align: root.align;
            Button { has-icon: true; square: true; icon: Icons.undo; size: root.size; help: "Undo"; look: Looks.of(state); on: state == 3; }
            Button { text: "COPY"; size: root.size; fills: root.fills; }
            Button { text: "PASTE"; size: root.size; fills: root.fills; }
        }
    }
}

// A sheet's keys at the row's end, its Cancel key in each state.
component SheetKeysStates inherits Line {
    for state in 4: Fill {
        span: BoardStyle.wide;
        ButtonGroup {
            plate: true;
            align: GroupAlign.end;
            Button { text: "CANCEL"; look: Looks.of(state); on: state == 3; }
            Button { text: "DELETE"; kind: ButtonKind.destructive; }
        }
    }
}

export component ButtonGroupPage inherits Page {
    title: "ButtonGroup";
    note: "ButtonGroup: plate, small, align (start, end, center, fill); holding Buttons (a key's fills shares the row).";
    Group {
        title: "ButtonGroup";
        states: ["Live", "First key hovered", "First key pressed", "First key on"];
        span: BoardStyle.wide;
        GroupStates { label: "bare (keys a hairline apart)"; }
        GroupStates { label: "plate"; plate: true; }
        GroupStates { label: "plate, small keys"; plate: true; small: true; }
        GroupStates { label: "plate, align fill"; plate: true; align: GroupAlign.fill; }
        GroupStates { label: "bare, align fill"; align: GroupAlign.fill; }
        GroupStates { label: "plate, align end"; plate: true; align: GroupAlign.end; }
        GroupStates { label: "plate, align center"; plate: true; align: GroupAlign.center; }
        SheetKeysStates { label: "a sheet's keys: plate, align end"; }
    }
}
