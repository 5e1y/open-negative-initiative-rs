// The board's tiles and pictures: the gallery's tile in each state, a picture on every ground, the
// roll's cells, the presets' cards and rows, the swatches, the stocks and the fanned stack.
import { Colour, Space, ScannerStyle, Look, Picture, Ground, TileView, TileGhost, CardStack, RollCellView, PresetFace, PresetNewFace, PresetRow, StockCellView, StockIcon, Button, PresetStyle } from "../ds.slint";
import { BoardStyle, Page, Group, Row, Cell, Fill, Samples } from "kit.slint";

// A tile in its seven looks, all on one picture.
component TileRow inherits Row {
    in property <image> picture;
    in property <bool> captioned;
    property <length> high: BoardStyle.cell * 2 / 3;
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; selected: true; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; medal: 1; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; medal: 2; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; medal: 3; selected: true; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; missing: true; } }
    Fill { TileView { picture: root.picture; picture-height: root.high; caption: root.captioned ? "DSC_6432" : ""; rgb: true; medal: 2; } }
}

// A picture on each of the six grounds.
component GroundRow inherits Row {
    in property <image> source;
    in property <bool> rounded;
    property <length> high: BoardStyle.cell * 2 / 3;
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.ground; } }
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.canvas; } }
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.canvas-cropping; } }
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.well; } }
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.paper; } }
    Fill { Picture { height: root.high; source: root.source; rounded: root.rounded; ground: Ground.skeleton; } }
}

export component TilesPage inherits Page {
    title: "Tiles and pictures";
    note: "TileView, Picture's grounds, RollCellView, the presets' faces and rows, Swatch, the stocks, TileGhost and CardStack.";
    Group {
        title: "TileView";
        states: ["Rest", "Selected", "Bronze", "Silver", "Gold, selected", "Missing original", "RGB seal, silver"];
        TileRow { label: "photo, captioned"; picture: Samples.photo; captioned: true; }
        TileRow { label: "photo, no caption"; picture: Samples.other; }
        TileRow { label: "empty well"; captioned: true; }
    }
    Group {
        title: "Picture";
        states: ["ground", "canvas", "canvas-cropping", "well", "paper", "skeleton"];
        GroundRow { label: "empty"; }
        GroundRow { label: "empty, rounded"; rounded: true; }
        GroundRow { label: "photo, rounded"; source: Samples.photo; rounded: true; }
    }
    Group {
        title: "RollCellView";
        states: ["Rest", "Marked", "Marked, flagged", "Apart (dot)", "RGB seal", "Sheet: marked", "Sheet: flagged", "Unticked"];
        span: BoardStyle.cell - Space.l;
        Row {
            label: "a frame of the roll";
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; marked: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; marked: true; flagged: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; apart: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; rgb: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; outset: true; marked: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; outset: true; flagged: true; } }
            Fill { span: BoardStyle.cell - Space.l; RollCellView { picture: Samples.photo; dimmed: true; } }
        }
    }
    Group {
        title: "Presets";
        states: ["Dark tint", "Light tint", "Warm tint", "New: rest", "New: lit", "New: disabled"];
        Row {
            label: "PresetFace, PresetNewFace";
            Cell { PresetFace { abbreviation: "Pt"; name: "Portra warm"; fill: ScannerStyle.band-dark; ink: Colour.ink; } }
            Cell { PresetFace { abbreviation: "Hp"; name: "HP5 crisp"; fill: Colour.paper; ink: Colour.ink-on-light; } }
            Cell { PresetFace { abbreviation: "Fr"; name: "Frontier"; fill: ScannerStyle.band-warm; ink: Colour.ink-on-light; } }
            Cell { PresetNewFace { } }
            Cell { PresetNewFace { lit: true; } }
            Cell { PresetNewFace { enabled: false; } }
        }
    }
    Group {
        title: "PresetRow";
        states: ["Rest", "Hover", "Selected"];
        span: BoardStyle.library;
        Row {
            label: "the editor's list";
            Fill { span: BoardStyle.library; PresetRow { abbreviation: "Pt"; name: "Portra warm"; carries: "Color, Curves"; fill: ScannerStyle.band-warm; ink: Colour.ink-on-light; } }
            Fill { span: BoardStyle.library; PresetRow { abbreviation: "Pt"; name: "Portra warm"; carries: "Color, Curves"; fill: ScannerStyle.band-warm; ink: Colour.ink-on-light; look: Look.hover; } }
            Fill { span: BoardStyle.library; PresetRow { abbreviation: "Pt"; name: "Portra warm"; carries: "Color, Curves"; fill: ScannerStyle.band-warm; ink: Colour.ink-on-light; selected: true; } }
        }
    }
    Group {
        title: "Swatch and stocks";
        states: ["Rest", "Picked", "Rest, light", "Picked, light"];
        Row {
            label: "Swatch";
            Cell { Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch; fill: ScannerStyle.band-red; help: "Red"; } }
            Cell { Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch; fill: ScannerStyle.band-red; help: "Red"; on: true; } }
            Cell { Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch; fill: Colour.paper; help: "White"; glyph-ink: Colour.ink-on-light; } }
            Cell { Button { square: true; width: PresetStyle.swatch; height: PresetStyle.swatch; fill: Colour.paper; help: "White"; glyph-ink: Colour.ink-on-light; on: true; } }
        }
        Row {
            label: "StockCellView";
            Fill { StockCellView { artwork: Samples.stock; has-artwork: true; name: "Kodak Portra 400"; } }
            Fill { StockCellView { artwork: Samples.stock; has-artwork: true; name: "Kodak Portra 400"; picked: true; } }
            Fill { StockCellView { name: "Generic C-41"; } }
            Fill { StockCellView { name: "Generic C-41"; picked: true; } }
        }
        Row {
            label: "StockIcon";
            Cell { StockIcon { artwork: Samples.stock; has-artwork: true; } }
            Cell { StockIcon { } }
        }
    }
    Group {
        title: "Carried and stacked";
        states: ["TileGhost", "CardStack"];
        span: BoardStyle.wide;
        Row {
            label: "a reorder's ghost, a project's stack";
            Cell { span: BoardStyle.wide; TileGhost { width: BoardStyle.cell; height: BoardStyle.cell * 2 / 3; source: Samples.photo; } }
            Fill { span: BoardStyle.wide; CardStack { pictures: [Samples.photo, Samples.other, Samples.photo]; } }
        }
    }
}
