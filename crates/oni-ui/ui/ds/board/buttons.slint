// The board's keys: Button in every kind at every size, then its variants, each in the five states a
// key shows, the first one live under the hand.
import { ShellStyle, ScannerStyle, SectionStyle, Colour, Icons, ButtonKind, ButtonSize, Button } from "../ds.slint";
import { PresetStyle, NavigatorStyle } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Looks } from "kit.slint";

// One key live, hovered, pressed, held on and disabled.
component KeyStates inherits Line {
    in property <length> span: BoardStyle.cell;
    in property <ButtonKind> kind;
    in property <ButtonSize> size;
    in property <string> text: "EXPORT";
    in property <bool> has-icon;
    in property <image> icon;
    in property <bool> square;
    in property <bool> turned;
    in property <bool> lamp-shown;
    in property <bool> lamp-lit;
    in property <length> fixed-width;
    in property <color> fill: transparent;
    in property <color> glyph-ink: transparent;
    in property <length> glyph-size;
    in property <bool> capitals: true;
    for state in 5: Cell {
        span: root.span;
        Button {
            kind: root.kind;
            size: root.size;
            text: root.text;
            has-icon: root.has-icon;
            icon: root.icon;
            square: root.square;
            turned: root.turned;
            lamp-shown: root.lamp-shown;
            lamp-lit: root.lamp-lit;
            fixed-width: root.fixed-width;
            fill: root.fill;
            glyph-ink: root.glyph-ink;
            glyph-size: root.glyph-size;
            capitals: root.capitals;
            help: "The key's tooltip";
            look: Looks.of(state);
            on: state == 3;
            enabled: state != 4;
        }
    }
}

// A tint's swatch in the same five states; `on` rings it.
component SwatchStates inherits Line {
    in property <color> fill;
    in property <color> glyph-ink: transparent;
    for state in 5: Cell {
        Button {
            square: true;
            width: PresetStyle.swatch;
            height: PresetStyle.swatch;
            fill: root.fill;
            glyph-ink: root.glyph-ink;
            help: "The tint's name";
            look: Looks.of(state);
            on: state == 3;
            enabled: state != 4;
        }
    }
}

export component ButtonPage inherits Page {
    title: "Button";
    note: "Button: kind (plain, the tints, ghost) × size (regular, small, key); text in capitals unless capitals is off, icon, square, turned, lamp, fixed-width, fill (a tint of its own), glyph-ink, glyph-size, note; on, enabled, look. No face changes colour: hovered the cap sinks a quarter, pressed it shrinks to 0.95 over its black socket, its word a step lower; a tint takes its ink by its lightness; on rings it.";
    property <[string]> states: ["Live", "Hover", "Pressed", "On", "Disabled"];
    Group {
        title: "Regular";
        states: root.states;
        KeyStates { label: "plain"; }
        KeyStates { label: "accent"; kind: ButtonKind.accent; }
        KeyStates { label: "caution"; kind: ButtonKind.caution; }
        KeyStates { label: "destructive"; kind: ButtonKind.destructive; text: "DELETE"; }
        KeyStates { label: "update"; kind: ButtonKind.update; text: "UPDATE"; }
        KeyStates { label: "confirm"; kind: ButtonKind.confirm; text: "DONE"; }
    }
    Group {
        title: "Small";
        states: root.states;
        KeyStates { label: "plain"; size: ButtonSize.small; text: "RESET"; }
        KeyStates { label: "accent"; size: ButtonSize.small; kind: ButtonKind.accent; text: "RESET"; }
        KeyStates { label: "caution"; size: ButtonSize.small; kind: ButtonKind.caution; text: "RESET"; }
        KeyStates { label: "destructive"; size: ButtonSize.small; kind: ButtonKind.destructive; text: "DELETE"; }
        KeyStates { label: "update"; size: ButtonSize.small; kind: ButtonKind.update; text: "UPDATE"; }
        KeyStates { label: "confirm"; size: ButtonSize.small; kind: ButtonKind.confirm; text: "DONE"; }
    }
    Group {
        title: "Small glyph keys (a column header's)";
        states: root.states;
        KeyStates { label: "glyph"; size: ButtonSize.small; text: ""; has-icon: true; square: true; icon: Icons.list; }
        KeyStates { label: "glyph in its own ink (the star)"; size: ButtonSize.small; text: ""; has-icon: true; square: true; icon: Icons.favourite; glyph-ink: NavigatorStyle.favourite; }
        KeyStates { label: "destructive glyph"; size: ButtonSize.small; kind: ButtonKind.destructive; text: ""; has-icon: true; square: true; icon: Icons.remove; }
    }
    Group {
        title: "Ghost (a glyph alone, its tone lifting under the hand)";
        states: root.states;
        KeyStates { label: "help mark (note)"; kind: ButtonKind.ghost; text: ""; has-icon: true; square: true; icon: Icons.question; glyph-size: SectionStyle.help-mark; }
        KeyStates { label: "row star, in its ink"; kind: ButtonKind.ghost; text: ""; has-icon: true; square: true; icon: Icons.favourite; glyph-size: NavigatorStyle.star; glyph-ink: NavigatorStyle.favourite; }
    }
    Group {
        title: "Key (a step slider's keycap; live, a press holds it down a beat)";
        states: root.states;
        KeyStates { label: "no fill (its kind's)"; size: ButtonSize.key; text: "+"; }
        KeyStates { label: "fill cap-light"; size: ButtonSize.key; text: "−"; fill: ScannerStyle.cap-light; }
        KeyStates { label: "fill cap-dark"; size: ButtonSize.key; text: "−"; fill: ScannerStyle.cap-dark; }
        KeyStates { label: "fill band-dark"; size: ButtonSize.key; text: "+"; fill: ScannerStyle.band-dark; }
        KeyStates { label: "fill band-light"; size: ButtonSize.key; text: "+"; fill: ScannerStyle.band-light; }
        KeyStates { label: "fill band-red"; size: ButtonSize.key; text: "−"; fill: ScannerStyle.band-red; }
        KeyStates { label: "fill band-cyan"; size: ButtonSize.key; text: "+"; fill: ScannerStyle.band-cyan; }
        KeyStates { label: "fill band-yellow"; size: ButtonSize.key; text: "+"; fill: ScannerStyle.band-yellow; }
        KeyStates { label: "fill band-warm"; size: ButtonSize.key; text: "+"; fill: ScannerStyle.band-warm; }
    }
    Group {
        title: "Variants";
        states: root.states;
        KeyStates { label: "glyph and word"; text: "OPEN"; has-icon: true; icon: Icons.folder-open; }
        KeyStates { label: "glyph and word, small"; size: ButtonSize.small; text: "OPEN"; has-icon: true; icon: Icons.folder-open; }
        KeyStates { label: "accent, glyph and word"; kind: ButtonKind.accent; text: "PASTE"; has-icon: true; icon: Icons.paste; }
        KeyStates { label: "glyph alone, square"; text: ""; has-icon: true; square: true; icon: Icons.undo; }
        KeyStates { label: "glyph alone, square, small"; size: ButtonSize.small; text: ""; has-icon: true; square: true; icon: Icons.chevron-down; }
        KeyStates { label: "glyph turned a quarter"; text: ""; has-icon: true; square: true; icon: Icons.compare; turned: true; }
        KeyStates { label: "lamp shown, off"; text: "AUTO"; lamp-shown: true; }
        KeyStates { label: "lamp shown, lit"; text: "AUTO"; lamp-shown: true; lamp-lit: true; }
        KeyStates { label: "fixed width, eliding"; text: "ALL PHOTOS SHOWN"; fixed-width: ShellStyle.filter-width; }
        KeyStates { label: "a word put in capitals"; text: "Cancel"; }
        KeyStates { label: "capitals off (an AppKit key)"; text: "Reveal in Finder"; capitals: false; }
    }
    Group {
        title: "Fill: a tint's swatch (on rings it)";
        states: root.states;
        SwatchStates { label: "a dark tint"; fill: ScannerStyle.band-red; }
        SwatchStates { label: "a light tint, ringed in its ink"; fill: Colour.white; glyph-ink: Colour.ink-on-light; }
    }
}
