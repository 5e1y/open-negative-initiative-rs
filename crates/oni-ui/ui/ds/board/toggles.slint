// The board's switches: Toggle bare and with its words at each side, then Tabs of two, four and eight swatches, each
// live under the hand beside its forced states.
import { PlotStyle, Toggle, LabelSide, Tabs } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill } from "kit.slint";

// A switch live, off, on, and disabled off and on.
component ToggleStates inherits Line {
    in property <LabelSide> side: LabelSide.after;
    in property <string> words: "Clipping";
    in property <bool> wrap;
    in property <length> span: BoardStyle.cell;
    live := Cell {
        span: root.span;
        property <bool> lit;
        Toggle { label-side: root.side; label: root.words; wrap: root.wrap; on: live.lit; toggled(v) => { live.lit = v; } }
    }
    Cell { span: root.span; Toggle { label-side: root.side; label: root.words; wrap: root.wrap; } }
    Cell { span: root.span; Toggle { label-side: root.side; label: root.words; wrap: root.wrap; on: true; } }
    Cell { span: root.span; Toggle { label-side: root.side; label: root.words; wrap: root.wrap; enabled: false; } }
    Cell { span: root.span; Toggle { label-side: root.side; label: root.words; wrap: root.wrap; on: true; enabled: false; } }
}

// A set of tabs live, another tab selected, a tab hovered, a tab marked.
component TabsStates inherits Line {
    in property <[string]> tabs;
    in property <int> selected;
    in property <int> other;
    in property <int> hovered;
    in property <[bool]> marked;
    in property <[color]> swatches;
    // The owner writes the choice, as every screen's store does: a click only asks.
    live := Fill { span: BoardStyle.field; property <int> at: root.selected; Tabs { tabs: root.tabs; selected: live.at; swatches: root.swatches; picked(i) => { live.at = i; } } }
    Fill { span: BoardStyle.field; Tabs { tabs: root.tabs; selected: root.other; swatches: root.swatches; } }
    Fill { span: BoardStyle.field; Tabs { tabs: root.tabs; selected: root.selected; swatches: root.swatches; hover-tab: root.hovered; } }
    Fill { span: BoardStyle.field; Tabs { tabs: root.tabs; selected: root.selected; swatches: root.swatches; marked: root.marked; } }
}

export component TogglePage inherits Page {
    title: "Toggle and Tabs";
    note: "Toggle: on, label, label-side (after as DSToggle, before, none), wrap, enabled; its words flip it too. Tabs: tabs, selected (the owner's: a click only emits picked), swatches, marked, hover-tab.";
    Group {
        title: "Toggle";
        states: ["Live", "Off", "On", "Disabled, off", "Disabled, on"];
        ToggleStates { label: "label-side none"; side: LabelSide.none; }
        ToggleStates { label: "label-side after (default)"; }
        ToggleStates { label: "label-side before"; side: LabelSide.before; }
    }
    Group {
        title: "Toggle, words that wrap";
        states: ["Live", "Off", "On", "Disabled, off", "Disabled, on"];
        span: BoardStyle.wide;
        ToggleStates { label: "wrap"; words: "Encrypted console log, readable by ONI's maintainers only"; wrap: true; span: BoardStyle.wide; }
    }
    Group {
        title: "Tabs";
        states: ["Live", "Another selected", "A tab hovered", "A tab marked"];
        span: BoardStyle.field;
        TabsStates { label: "two tabs"; tabs: ["Negative", "Positive"]; other: 1; hovered: 1; marked: [false, true]; }
        TabsStates { label: "four tabs"; tabs: ["Roll", "Crop", "Color", "Details"]; selected: 2; other: 3; hovered: 0; marked: [true, false, false, false]; }
        TabsStates {
            label: "eight swatches (their names as tooltips)";
            tabs: ["Red", "Orange", "Yellow", "Green", "Aqua", "Blue", "Purple", "Magenta"];
            swatches: PlotStyle.bands;
            selected: 1;
            other: 6;
            hovered: 4;
            marked: [false, false, false, true, false, false, false, false];
        }
    }
}
