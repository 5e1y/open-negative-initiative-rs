// The board's Scanner face: its screen reading the letters' step sliders live, the LCD count, and
// the Prepare the Roll pieces; overlays.slint holds the marks drawn over the canvas.
import { Space, PlotStyle, ScannerStyle, LabScreen, LcdReadout, StepSlider, PassReorder, Loupe, RollStyle } from "../ds.slint";
import { BoardStyle, Page, Group, Line, Cell, Fill, Samples } from "kit.slint";
import { OverlayGroups } from "overlays.slint";

// A letter's slider on the face, its value the screen reads.
component Letter inherits StepSlider {
    in-out property <int> at;
    value: root.at;
    readout: (root.at > 0 ? "+" : "") + root.at;
    low: -10;
    high: 10;
    stepped(by) => { root.at = clamp(root.at + by, root.low, root.high); }
    reset => { root.at = 0; }
}

export component ScannerPage inherits Page {
    title: "Scanner and canvas overlays";
    note: "LabScreen: frame, machine, remeasure, cells, finish. LcdReadout: text. StepSlider in its face. FrameOverlay, SplitGuide, the canvas's marks and the Prepare pieces.";
    Group {
        title: "The Scanner face (live: the screen reads the sliders)";
        states: ["Live"];
        span: BoardStyle.panel;
        Line {
            label: "LabScreen over its StepSliders";
            Fill {
                span: BoardStyle.panel;
                spacing: Space.m;
                LabScreen {
                    height: PlotStyle.main;
                    frame: "FRAME 09/38";
                    machine: "FRONTIER · NEGA";
                    remeasure: true;
                    remeasure-help: "Measure the roll again";
                    cells: [
                        { title: "D", value: (d.at > 0 ? "+" : "") + d.at }, { title: "C", value: (c.at > 0 ? "+" : "") + c.at },
                        { title: "M", value: (m.at > 0 ? "+" : "") + m.at }, { title: "Y", value: (y.at > 0 ? "+" : "") + y.at },
                    ];
                    finish: ["CT +20 %", "VIG 0 EV", "CHR 0 %"];
                }
                d := Letter { title: "D"; at: 3; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; }
                c := Letter { title: "C"; at: -2; minus: ScannerStyle.band-red; plus: ScannerStyle.band-cyan; }
                m := Letter { title: "M"; minus: ScannerStyle.band-green; plus: ScannerStyle.band-magenta; }
                y := Letter { title: "Y"; at: 1; minus: ScannerStyle.band-blue; plus: ScannerStyle.band-yellow; }
            }
        }
    }
    Group {
        title: "LcdReadout";
        states: ["A count", "A digit"];
        Line {
            label: "on the scanner's glass";
            Cell { LcdReadout { text: "12 / 36"; } }
            Cell { LcdReadout { text: "1"; } }
        }
    }
    Group {
        title: "Prepare the Roll: PassReorder and Loupe";
        states: ["Live (drag a chip)", "Loupe on the scan's pixels"];
        span: BoardStyle.panel;
        Line {
            label: "a frame's three passes";
            Fill {
                span: BoardStyle.panel;
                PassReorder {
                    letters: ["R", "G", "B"];
                    bands: [0, 1, 2];
                    pictures: [Samples.photo, Samples.other, Samples.photo];
                    names: ["DSC_6431", "DSC_6432", "DSC_6433"];
                }
            }
            Cell {
                span: BoardStyle.panel;
                Loupe {
                    source: Samples.photo;
                    cut-x: 400;
                    cut-y: 300;
                    cut-width: 24;
                    cut-height: 24;
                    cut-shown-width: RollStyle.loupe;
                    cut-shown-height: RollStyle.loupe;
                    disc: RollStyle.loupe / 3;
                    disc-x: RollStyle.loupe / 2;
                    disc-y: RollStyle.loupe / 2;
                    picked-shown: true;
                    picked-x: RollStyle.loupe / 3;
                    picked-y: RollStyle.loupe / 3;
                    picked-disc: RollStyle.loupe / 4;
                }
            }
        }
    }
    OverlayGroups { }
}
