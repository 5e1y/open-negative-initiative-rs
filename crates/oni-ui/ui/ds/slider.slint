// `DSSlider`: the readout above a rail and its knob.
import { Space, Motion, ButtonStyle, SliderStyle, DialStyle } from "theme.slint";
import { Look, Button } from "button.slint";
import { KeyScope, Keyboard } from "keyboard.slint";
import { Knob } from "knob.slint";
import { SliderFill, Rail } from "rail.slint";
import { ValueHeader, Readouts } from "readout.slint";
import { Outside } from "outside.slint";
import { Dial } from "dial.slint";
import { Icons } from "icons.slint";

// A slider's keycap beside its rail, the interface's grey: `SliderStyle.press` steps a press. Its glyph,
// Trinil's minus or plus, names no slider, so assistive tools read its help, which names the way and the step.
component StepKey inherits Button {
    keycap: true;
    rises: true;
    square: true;
    // The hand's: the slider's arrows already step it under the keyboard.
    tabbed: false;
    height: SliderStyle.step-key;
    width: self.height;
    // A mini key's glyph: the sign stays small on its key, as the typed one stood.
    glyph-size: ButtonStyle.mini-glyph;
    horizontal-stretch: 0;
    accessible-label: self.help;
}

// `DSSlider`: the readout, then a track between a − and a + keycap, whose row grabs and to which Tab alone
// gives the keyboard; Rust holds the value and its timing.
export component Slider inherits VerticalLayout {
    in property <int> field;
    in property <string> label;
    in property <string> readout;
    // The settings' value, which accessibility reads where the readout shows the hand's.
    in property <string> value-text;
    in property <float> fraction;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: SliderStyle.lit;
    in property <color> low;
    in property <color> high;
    // `DSSlider.knob`: a cap in the colour the value carries, the chrome's grey otherwise.
    in property <color> knob: SliderStyle.knob;
    in property <bool> enabled: true;
    // The readout above the track; a help card's demo shows the track alone, as it shows no words.
    in property <bool> header: true;
    in property <Look> look: Look.live;
    in property <int> lowest;
    in property <int> highest;
    // A turn: a ring's scale from `lowest` to `highest` in the readout's unit, moving with the hand, so
    // a drag right brings the lower figures under its index; a press never jumps it.
    in property <bool> dial;
    // Rest as a fraction of the travel, none below 0: the rail ticks it, a drag holds on it, and a double
    // click on the rail or on the name, whose tooltip `help` is, brings the slider back to it.
    in property <float> rest: -1;
    in property <string> help: @tr("Double-click to bring it back to rest");
    // Levels laid evenly along the track, ticked on the rail, which every step walks one by one; none below 2.
    in property <int> notches;
    // What a key's press moves, in the readout's unit: `SliderStyle.press` of the value editor's steps.
    out property <string> press-reads: root.notches > 1 ? "" : Readouts.pressed(root.readout, SliderStyle.press);
    // The minus and plus keys' tooltips: the slider, the way and the step.
    in property <string> minus-help: root.notches > 1 ? @tr("{} −: one level lower", root.label) : root.press-reads == "" ? @tr("{} −: lower", root.label) : @tr("{} −: lower by {}", root.label, root.press-reads);
    in property <string> plus-help: root.notches > 1 ? @tr("{} +: one level higher", root.label) : root.press-reads == "" ? @tr("{} +: higher", root.label) : @tr("{} +: higher by {}", root.label, root.press-reads);
    // Rust answers whether this press is the second of a double click.
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    // Rust answers whether the scroll runs along the track; one across it is left to the panel.
    callback scroll(int, length, length, length, bool) -> bool;
    // An arrow's or accessibility's steps: the readout's last shown digit, or a notch where the track is
    // not even in that digit.
    callback step(int, int);
    // A number typed over the readout: units of its last shown digit.
    callback typed(int, int);
    callback reset();
    // The hand on the rail or holding the knob, as a demo shows it: the knob grows, the rail deepens; on
    // the slider's whole line, its keys and the room between them, its hues show whole.
    property <bool> handled: root.enabled && (area.has-hover || area.held || root.look != Look.live);
    property <bool> on-line: root.enabled && line.has-hover;
    // The hand on the block the slider is laid in, which the block's `hovered` gives: its hues show whole.
    in property <bool> near;
    // A step key held, or a step a moment ago: with the hand's, these show a rail of hues whole.
    property <bool> keyed;
    property <bool> stepping;
    // Every step but a drag's, the hand's own: each keeps the rail's hues whole for `Motion.settle`.
    function nudge(by: int) {
        root.stepping = true;
        lull.restart();
        root.step(root.field, by);
    }
    // ⇧'s step with an arrow.
    property <int> big: 10;
    property <int> span: max(1, root.highest - root.lowest);
    // The travel a drag or a scroll measures against, and its sense: the ring's scale moves one for one
    // under the hand at its index.
    property <length> reach: root.dial ? (track.width + SliderStyle.knob-width) / 2 * (DialStyle.turn / 1rad) * root.span : track.width;
    property <float> sense: root.dial ? -1 : 1;
    // The detent: a drag reaching rest on a rail holds there for `SliderStyle.detent` of the hand's travel,
    // then goes on, so leaving never jumps; a dial's scale stays under the hand. Fractions of the travel.
    pure function detented(from: float, to: float) -> float {
        let width = SliderStyle.detent / max(1px, root.reach);
        let before = abs(from - root.rest) < 0.0001 ? 0 : from - root.rest;
        let after = to - root.rest;
        if (root.rest < 0 || root.dial || (before < 0 && after < 0) || (before > 0 && after > 0)) {
            return to;
        }
        if (abs(after) <= width) {
            return root.rest;
        }
        return after > 0 ? to - width : to + width;
    }
    // A continuous drag's travel from the press, held at rest unless ⌥ asks for the finest move.
    function travel(dx: length) -> length {
        if (area.fine) {
            return dx * root.sense;
        }
        (root.detented(area.start-at, area.start-at + dx * root.sense / max(1px, root.reach)) - area.start-at) * root.reach
    }
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }
    property <float> at: clamp(root.fraction, 0, 1);
    // What the rail and the knob show: sprung on `settle` for a value from elsewhere, never under the hand nor
    // between two notches, which it goes from one to the next at once.
    property <float> shown: root.at;
    animate shown { duration: area.held || area.scrolling || root.notches > 1 ? 0ms : SliderStyle.settle; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    // The steps from the readout to a number typed over it; Return gives the photos the keyboard back,
    // a press elsewhere has given it on already.
    function type-in(text: string) {
        let by = Readouts.steps(root.readout, text);
        if (by != 0) {
            root.stepping = true;
            lull.restart();
            root.typed(root.field, by);
        }
        if (!Keyboard.held) {
            Outside.released += 1;
        }
    }
    if root.header: ValueHeader {
        label: root.label;
        value: root.readout;
        enabled: root.enabled;
        resets: root.rest >= 0;
        help: root.help;
        typeable: true;
        lit: area.has-hover || area.held || root.on-line;
        reset => { root.reset(); }
        typed(t) => { root.type-in(t); }
        stepped(by) => { root.nudge(by); }
    }
    line := TouchArea {
      HorizontalLayout {
        spacing: Space.s;
        StepKey {
            has-icon: true;
            icon: Icons.zoom-out;
            help: root.minus-help;
            enabled: root.enabled;
            changed down => { root.keyed = self.down; }
            clicked => { root.nudge(-SliderStyle.press); }
        }
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            horizontal-stretch: 1;
            // Off limits, the words fade and the rail stays opaque, as `DSSlider`'s.
            track := Rectangle {
                height: root.dial ? DialStyle.height : SliderStyle.row;
                if root.dial: Dial {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    value: root.lowest + root.shown * (root.highest - root.lowest);
                    lowest: root.lowest;
                    highest: root.highest;
                    lit: root.enabled && (area.has-hover || area.held);
                }
                if !root.dial: Rail {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    overhang: SliderStyle.knob-width / 2;
                    fill: root.fill;
                    at: root.shown;
                    tint: root.tint;
                    low: root.low;
                    high: root.high;
                    rest: root.rest;
                    notches: root.notches;
                    deep: root.handled;
                    vivid: root.handled || root.on-line || (root.enabled && root.near) || root.keyed || root.stepping || area.scrolling;
                }
                if !root.dial: Knob {
                    centre: parent.width * root.shown;
                    fill: root.knob;
                    grown: root.handled;
                }
                area := TouchArea {
                    enabled: root.enabled;
                    in-out property <bool> held;
                    property <bool> fine;
                    // AppKit's press: the knob grabbed where it stands, the rail landing it
                    // under the pointer, ⌥ keeping it put; the drag measures from `origin`, the value was at `start`.
                    property <length> start;
                    property <float> start-at;
                    property <length> origin;
                    // A scroll's events, and `settle` after the last, which the knob follows unsprung.
                    in-out property <bool> scrolling;
                    out property <bool> over-knob: self.has-hover && (root.dial || abs(self.mouse-x - parent.width * root.shown) <= SliderStyle.knob-width / 2);
                    mouse-cursor: self.held ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            self.fine = event.modifiers.alt;
                            self.start = parent.width * root.at;
                            self.start-at = root.at;
                            self.origin = self.fine || self.over-knob ? self.mouse-x : self.start;
                            self.held = !root.press(root.field, self.fine);
                            if (self.held && self.origin != self.mouse-x) {
                                root.drag(root.field, root.travel(self.mouse-x - self.origin), root.reach, self.fine);
                            }
                        } else if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                            self.held = false;
                            root.release(root.field);
                        } else if (event.kind == PointerEventKind.move) {
                            self.fine = event.modifiers.alt;
                        }
                    }
                    moved => {
                        if (self.held) {
                            root.drag(root.field, root.travel(self.mouse-x - self.origin), root.reach, self.fine);
                        }
                    }
                    scroll-event(event) => {
                        if (root.scroll(root.field, event.delta-x * root.sense, event.delta-y, root.reach, event.modifiers.alt)) {
                            self.scrolling = true;
                            still.restart();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                still := Timer {
                    interval: Motion.settle;
                    running: area.scrolling;
                    triggered => { area.scrolling = false; }
                }
                lull := Timer {
                    interval: Motion.settle;
                    running: root.stepping;
                    triggered => { root.stepping = false; }
                }
                // Over the rail's whole length, past the knob's travel as the rail runs. Tab alone gives it the
                // keyboard, ringed: after the hand's work the arrows walk the photos and the digits rate them.
                KeyScope {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    enabled: root.enabled;
                    radius: root.dial ? DialStyle.radius : self.height / 2;
                    key-pressed(event) => {
                        let by = event.text == Key.RightArrow || event.text == Key.UpArrow ? 1 : event.text == Key.LeftArrow || event.text == Key.DownArrow ? -1 : 0;
                        if (by == 0 || event.modifiers.control || event.modifiers.meta || event.modifiers.alt || !root.enabled) {
                            return reject;
                        }
                        root.nudge(event.modifiers.shift ? by * root.big : by);
                        accept
                    }
                }
            }
        }
        StepKey {
            has-icon: true;
            icon: Icons.zoom-in;
            help: root.plus-help;
            enabled: root.enabled;
            changed down => { root.keyed = self.down; }
            clicked => { root.nudge(SliderStyle.press); }
        }
      }
    }
}
