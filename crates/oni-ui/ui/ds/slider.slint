// `DSSlider`, continuous or in whole steps: the readout above a rail and its knob.
import { Space, Motion, SliderStyle, DialStyle } from "theme.slint";
import { Look, Button } from "button.slint";
import { KeyScope, Keyboard } from "keyboard.slint";
import { Knob } from "knob.slint";
import { SliderFill, Rail } from "rail.slint";
import { ValueHeader, Readouts } from "readout.slint";
import { Tips } from "base.slint";
import { Dial } from "dial.slint";

// A number typed over a slider's readout, which Rust reads: the steps that reach it from the readout,
// `per` readout units a step or, at 0, one unit of its last digit; 0 when either holds no number.
export global Typing {
    pure callback steps(readout: string, typed: string, per: float) -> int;
}

// A stepped slider's keycap beside its rail, in its end's colour: one step a press, three with ⇧. Its
// sign names no slider, so assistive tools read its help, which names the slider and the way.
component StepKey inherits Button {
    keycap: true;
    square: true;
    height: SliderStyle.step-key;
    width: self.height;
    legend-size: SliderStyle.step-legend;
    horizontal-stretch: 0;
    accessible-label: self.help;
}

// `DSSlider`: the readout, then a track whose row grabs and, pressed, takes the keyboard; Rust holds the
// value and its timing. `stepped`: whole steps from `lowest` to `highest`, a keycap either side.
export component Slider inherits VerticalLayout {
    in property <int> field;
    in property <string> label;
    in property <string> readout;
    // The settings' value, which accessibility reads where the readout shows the hand's.
    in property <string> value-text;
    in property <float> fraction;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: SliderStyle.lit;
    in property <color> low;
    in property <color> high;
    // `DSSlider.knob`: a cap in the colour the value carries, the chrome's grey otherwise.
    in property <color> knob: SliderStyle.knob;
    in property <bool> enabled: true;
    // The readout above the track; a help card's demo shows the track alone, as it shows no words.
    in property <bool> header: true;
    in property <Look> look: Look.live;
    in property <bool> stepped;
    in property <int> value;
    in property <int> lowest;
    in property <int> highest;
    // What one whole step reads in the readout's unit, so a number typed over it finds its steps.
    in property <float> step-reads;
    // A turn: a ring's scale from `lowest` to `highest` in the readout's unit, moving with the hand, so
    // a drag right brings the lower figures under its index; a press never jumps it.
    in property <bool> dial;
    // Rest as a fraction of the travel, none below 0: the rail ticks it, a drag holds on it, and a double
    // click on the rail or on the name, whose tooltip `help` is, brings the slider back to it.
    in property <float> rest: -1;
    in property <string> help: @tr("Double-click to bring it back to rest");
    // A stepped slider's minus and plus keys' tooltips.
    in property <string> minus-help;
    in property <string> plus-help;
    // Rust answers whether this press is the second of a double click.
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    // Rust answers whether the scroll runs along the track; one across it is left to the panel.
    callback scroll(int, length, length, length, bool) -> bool;
    // An arrow's or accessibility's steps, a stepped slider's every move: whole steps, or the readout's
    // last shown digit on a continuous one.
    callback step(int, int);
    callback reset();
    // A press on a stepped rail holds the edit, so a whole slide is one step to undo.
    callback held(bool);
    // The step under the hand while it slides, ahead of the value the store answers.
    property <int> hand;
    // ⇧'s step with an arrow: three on a stepped slider, as its keys take, ten on a continuous one.
    property <int> big: root.stepped ? 3 : 10;
    property <int> span: max(1, root.highest - root.lowest);
    // The travel a drag or a scroll measures against, and its sense: the ring's scale moves one for one
    // under the hand at its index.
    property <length> reach: root.dial ? (track.width + SliderStyle.knob-width) / 2 * (DialStyle.turn / 1rad) * root.span : track.width;
    property <float> sense: root.dial ? -1 : 1;
    // The detent: a drag reaching rest on a rail holds there for `SliderStyle.detent` of the hand's travel,
    // then goes on, so leaving never jumps; a dial's scale stays under the hand. Fractions of the travel.
    pure function detented(from: float, to: float) -> float {
        let width = SliderStyle.detent / max(1px, root.reach);
        let before = abs(from - root.rest) < 0.0001 ? 0 : from - root.rest;
        let after = to - root.rest;
        if (root.rest < 0 || root.dial || (before < 0 && after < 0) || (before > 0 && after > 0)) {
            return to;
        }
        if (abs(after) <= width) {
            return root.rest;
        }
        return after > 0 ? to - width : to + width;
    }
    // A continuous drag's travel from the press, held at rest unless ⌥ asks for the finest move.
    function travel(dx: length) -> length {
        if (area.fine) {
            return dx * root.sense;
        }
        (root.detented(area.start-at, area.start-at + dx * root.sense / max(1px, root.reach)) - area.start-at) * root.reach
    }
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.step(root.field, 1); }
    accessible-action-decrement => { root.step(root.field, -1); }
    property <float> at: root.stepped ? ((area.held ? root.hand : root.value) - root.lowest) / root.span : clamp(root.fraction, 0, 1);
    // What the rail and the knob show: sprung on `settle` for a value from elsewhere, never under the hand.
    property <float> shown: root.at;
    animate shown { duration: area.held || area.scrolling ? 0ms : SliderStyle.settle; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    pure function step-at(x: length) -> int {
        root.lowest + round(clamp(x / max(1px, track.width), 0, 1) * (root.highest - root.lowest))
    }
    // The step under a stepped drag, `dx` from the press, held at rest as a continuous drag is.
    pure function step-held(dx: length) -> int {
        root.step-at(root.detented(area.start-at, (area.start + dx) / max(1px, track.width)) * track.width)
    }
    // The steps from the readout to a number typed over it, held on a stepped slider's range; Return
    // leaves the keyboard to the slider, a press elsewhere has given it on already.
    function type-in(text: string) {
        let by = Readouts.steps(root.readout, text, root.stepped ? root.step-reads : 0);
        let reach = root.stepped ? clamp(root.value + by, root.lowest, root.highest) - root.value : by;
        if (reach != 0) {
            root.step(root.field, reach);
        }
        if (!Keyboard.held) {
            keys.focus();
        }
    }
    if root.header: ValueHeader {
        label: root.label;
        value: root.readout;
        enabled: root.enabled;
        resets: root.rest >= 0;
        help: root.help;
        typeable: true;
        lit: area.has-hover || area.held;
        reset => { root.reset(); }
        typed(t) => { root.type-in(t); }
    }
    HorizontalLayout {
        spacing: Space.s;
        if root.stepped: StepKey {
            text: "−";
            fill: root.low;
            help: root.minus-help;
            enabled: root.enabled;
            clicked => { root.step(root.field, self.shift ? -3 : -1); }
        }
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            horizontal-stretch: 1;
            // Off limits, the words fade and the rail stays opaque, as `DSSlider`'s.
            track := Rectangle {
                height: root.dial ? DialStyle.height : SliderStyle.row;
                if root.dial: Dial {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    value: root.lowest + root.shown * (root.highest - root.lowest);
                    lowest: root.lowest;
                    highest: root.highest;
                    lit: root.enabled && (area.has-hover || area.held);
                }
                if !root.dial: Rail {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    overhang: SliderStyle.knob-width / 2;
                    fill: root.fill;
                    at: root.shown;
                    tint: root.tint;
                    low: root.low;
                    high: root.high;
                    rest: root.rest;
                }
                if !root.dial: Knob {
                    centre: parent.width * root.shown;
                    fill: root.knob;
                    grown: root.enabled && (area.has-hover || area.held || root.look != Look.live);
                }
                area := TouchArea {
                    enabled: root.enabled;
                    in-out property <bool> held;
                    property <bool> fine;
                    // AppKit's press, continuous or stepped: the knob grabbed where it stands, the rail landing it
                    // under the pointer, ⌥ keeping it put; the drag measures from `origin`, the value was at `start`.
                    property <length> start;
                    property <float> start-at;
                    property <length> origin;
                    // A scroll's events, and `settle` after the last, which the knob follows unsprung.
                    in-out property <bool> scrolling;
                    out property <bool> over-knob: self.has-hover && (root.dial || abs(self.mouse-x - parent.width * root.shown) <= SliderStyle.knob-width / 2);
                    mouse-cursor: self.held ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    changed has-hover => { Tips.hover(self.has-hover, root.help, track.absolute-position.x, track.absolute-position.y + track.height); }
                    double-clicked => {
                        if (root.stepped) { root.reset(); }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            keys.pressed = true;
                            keys.focus();
                            self.fine = event.modifiers.alt;
                            self.start = parent.width * root.at;
                            self.start-at = root.at;
                            self.origin = self.fine || self.over-knob ? self.mouse-x : self.start;
                            if (root.stepped) {
                                root.hand = root.step-held(self.mouse-x - self.origin);
                                self.held = true;
                                root.held(true);
                                if (root.hand != root.value) {
                                    root.step(root.field, root.hand - root.value);
                                }
                            } else {
                                self.held = !root.press(root.field, self.fine);
                                if (self.held && self.origin != self.mouse-x) {
                                    root.drag(root.field, root.travel(self.mouse-x - self.origin), root.reach, self.fine);
                                }
                            }
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            if (root.stepped) {
                                if (self.held) {
                                    self.held = false;
                                    root.held(false);
                                }
                            } else if (event.button == PointerEventButton.left || event.kind == PointerEventKind.cancel) {
                                self.held = false;
                                root.release(root.field);
                            }
                        } else if (event.kind == PointerEventKind.move) {
                            self.fine = event.modifiers.alt;
                        }
                    }
                    moved => {
                        if (self.held && root.stepped) {
                            let next = root.step-held(self.mouse-x - self.origin);
                            if (next != root.hand) {
                                root.step(root.field, next - root.hand);
                                root.hand = next;
                            }
                        } else if (self.held) {
                            root.drag(root.field, root.travel(self.mouse-x - self.origin), root.reach, self.fine);
                        }
                    }
                    scroll-event(event) => {
                        if (!root.stepped && root.scroll(root.field, event.delta-x * root.sense, event.delta-y, root.reach, event.modifiers.alt)) {
                            self.scrolling = true;
                            still.restart();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                still := Timer {
                    interval: Motion.settle;
                    running: area.scrolling;
                    triggered => { area.scrolling = false; }
                }
                // Over the rail's whole length, past the knob's travel as the rail runs. A hand's press gives it
                // the keyboard with no ring beside the photo; Tab, or an arrow acting here, rings it.
                keys := KeyScope {
                    in-out property <bool> pressed;
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    enabled: root.enabled;
                    radius: root.dial ? DialStyle.radius : self.height / 2;
                    ring: !self.pressed;
                    changed has-focus => {
                        if (!self.has-focus) { self.pressed = false; }
                    }
                    key-pressed(event) => {
                        let by = event.text == Key.RightArrow || event.text == Key.UpArrow ? 1 : event.text == Key.LeftArrow || event.text == Key.DownArrow ? -1 : 0;
                        if (by == 0 || event.modifiers.control || event.modifiers.meta || event.modifiers.alt || !root.enabled) {
                            return reject;
                        }
                        self.pressed = false;
                        root.step(root.field, event.modifiers.shift ? by * root.big : by);
                        accept
                    }
                }
            }
        }
        if root.stepped: StepKey {
            text: "+";
            fill: root.high;
            help: root.plus-help;
            enabled: root.enabled;
            clicked => { root.step(root.field, self.shift ? 3 : 1); }
        }
    }
}
