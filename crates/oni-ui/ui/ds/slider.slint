// The sliders: one knob, one rail, the readout above them, and `Slider`, continuous or in whole steps.
import { Colour, Space, Stroke, State, Motion, SliderStyle } from "theme.slint";
import { Keycap, Inward } from "depth.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { Look, Button, ButtonSize } from "button.slint";

// `level` and `ramp` light the rail up to the value and `metal` in brushed silver; `bipolar` is a
// gradient from `low` to `high`; `none` leaves it bare, as under the levels' handles.
export enum SliderFill { level, ramp, bipolar, metal, none }

// `DSBarHandle`: a small keycap set across the track, level walls, no shadow, edged in black, two grip
// lines on its face; it grows under the hand on the rise spring, a scale so its raster is drawn once.
export component Knob inherits Rectangle {
    // Its centre along the travel, and the breadth of the row whose middle it sits on.
    in property <length> centre;
    in property <length> across: SliderStyle.row;
    in property <color> fill: SliderStyle.knob;
    in property <bool> grip: true;
    in property <color> grip-ink: SliderStyle.grip-ink;
    in property <bool> grown;
    // With `slide`, it settles on a value arriving from elsewhere, never under the hand.
    in property <bool> slide;
    // On a vertical track `centre` runs down and the grip lines turn a quarter.
    in property <bool> vertical;
    property <float> grow: root.grown ? SliderStyle.knob-grow : 1;
    animate grow { duration: SliderStyle.rise; easing: ease-out-back; }
    width: root.vertical ? SliderStyle.knob-height : SliderStyle.knob-width;
    height: root.vertical ? SliderStyle.knob-width : SliderStyle.knob-height;
    x: root.vertical ? (root.across - self.width) / 2 : root.centre - self.width / 2;
    y: root.vertical ? root.centre - self.height / 2 : (root.across - self.height) / 2;
    animate x, y { duration: root.slide ? SliderStyle.settle : 0ms; easing: ease-out; }
    Keycap {
        albedo: root.fill;
        factor: SliderStyle.knob-factor;
        level: true;
        shadow: false;
        rim: false;
        edge-width: Stroke.line;
        edge-color: SliderStyle.knob-edge.with-alpha(SliderStyle.edge);
        transform-scale-x: root.grow;
        transform-scale-y: root.grow;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // The face's own size: a child's `parent` names the cap, not the face it lies on.
        Rectangle {
            for i in root.grip ? 2 : 0: Rectangle {
                x: root.vertical ? (parent.width - SliderStyle.grip) / 2 : parent.width / 2 + (i == 0 ? -SliderStyle.grip-gap / 2 - Stroke.line : SliderStyle.grip-gap / 2);
                y: root.vertical ? parent.height / 2 + (i == 0 ? -SliderStyle.grip-gap / 2 - Stroke.line : SliderStyle.grip-gap / 2) : (parent.height - SliderStyle.grip) / 2;
                width: root.vertical ? SliderStyle.grip : Stroke.line;
                height: root.vertical ? Stroke.line : SliderStyle.grip;
                background: root.grip-ink;
            }
        }
    }
}

// `DSRail` in `dsRecessed`: the ground, the lit stretch from `from` to `at` (fractions of the travel),
// the hollow's shade, the edge, the lit rim below; run past the travel by `overhang` at both ends.
export component Rail inherits Rectangle {
    in property <SliderFill> fill: SliderFill.none;
    in property <float> at;
    in property <float> from;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    in property <length> overhang;
    // The value a reset brings back, ticked across the rail; none below 0.
    in property <float> rest: -1;
    // The lit stretch's glow, a progress bar's phosphor.
    in property <length> glow;
    // Low at the bottom; a vertical rail sets its own width and height.
    in property <bool> vertical;
    // The surface the rail is milled into: the rim's light needs an opaque body under a translucent ground.
    in property <color> under: Colour.ground;
    property <length> along: root.vertical ? self.height : self.width;
    property <length> travel: root.along - 2 * root.overhang;
    property <length> lit: root.overhang + root.at * root.travel;
    property <length> start: root.from > 0 ? root.overhang + root.from * root.travel : 0;
    height: SliderStyle.track;
    Rectangle {
        border-radius: SliderStyle.track-radius;
        background: root.under;
        drop-shadow-color: Colour.white.with-alpha(SliderStyle.rim);
        drop-shadow-blur: SliderStyle.rim-blur;
        drop-shadow-offset-y: SliderStyle.rim-drop;
    }
    Rectangle {
        border-radius: SliderStyle.track-radius;
        background: root.fill != SliderFill.bipolar ? Colour.track
            : root.vertical ? @linear-gradient(0deg, root.low 0%, root.high 100%)
            : @linear-gradient(90deg, root.low 0%, root.high 100%);
    }
    // Its own round, no clip: a clipping rail renders each slider apart.
    if root.fill != SliderFill.bipolar && root.fill != SliderFill.none: Rectangle {
        x: root.vertical ? 0 : root.start;
        y: root.vertical ? parent.height - root.lit : 0;
        width: root.vertical ? parent.width : root.lit - root.start;
        height: root.vertical ? root.lit : parent.height;
        border-radius: SliderStyle.track-radius;
        background: root.fill == SliderFill.metal
            ? @linear-gradient(180deg, Colour.metal-dark 0%, Colour.metal-light 33.33%, Colour.metal-light 66.67%, Colour.metal-dark 100%)
            : root.fill == SliderFill.ramp
            ? (root.vertical ? @linear-gradient(0deg, root.tint.with-alpha(SliderStyle.ramp-start) 0%, root.tint.with-alpha(SliderStyle.ramp-end) 100%)
                : @linear-gradient(90deg, root.tint.with-alpha(SliderStyle.ramp-start) 0%, root.tint.with-alpha(SliderStyle.ramp-end) 100%))
            : root.tint;
        drop-shadow-color: root.glow > 0 ? root.tint : transparent;
        drop-shadow-blur: root.glow;
    }
    Inward {
        ground: transparent;
        radius: SliderStyle.track-radius;
    }
    Rectangle {
        border-radius: SliderStyle.track-radius;
        border-width: Stroke.line;
        border-color: SliderStyle.knob-edge.with-alpha(SliderStyle.edge);
    }
    if root.rest >= 0: Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : root.overhang + root.rest * root.travel - self.width / 2;
        y: root.vertical ? parent.height - root.overhang - root.rest * root.travel - self.height / 2 : (parent.height - self.height) / 2;
        width: root.vertical ? SliderStyle.knob-height / 2 : Stroke.line;
        height: root.vertical ? Stroke.line : SliderStyle.knob-height / 2;
        background: SliderStyle.rest-ink;
    }
}

// `DSReadout`: a slider's name, its value at the right in the secondary ink, both faded when off;
// with `resets`, a double click on the name brings the value back to rest and `help` is its tooltip.
export component ValueHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> resets;
    in property <string> help;
    callback reset();
    spacing: Space.s;
    opacity: root.enabled ? 1 : State.disabled;
    Label {
        text: root.label;
        overflow: elide;
        horizontal-stretch: 1;
        if root.resets: TouchArea {
            enabled: root.enabled;
            double-clicked => { root.reset(); }
            changed has-hover => { Tips.hover(self.has-hover, root.help, self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    Label { text: root.value; role: TextRole.value; tone: Tone.secondary; horizontal-alignment: right; }
}

// A stepped slider's key beside its rail, in its end's colour: one step a click, three with ⇧.
component StepKey inherits Button {
    size: ButtonSize.key;
    height: SliderStyle.step-key;
    width: self.height;
    legend-size: SliderStyle.step-legend;
    horizontal-stretch: 0;
}

// `DSSlider`: the readout, then a track whose whole row grabs; Rust holds the value and its timing.
// `stepped`: whole steps from `lowest` to `highest`, a key either side, the name's double click resting it.
export component Slider inherits VerticalLayout {
    in property <int> field;
    in property <string> label;
    in property <string> readout;
    // The settings' value, which accessibility reads where the readout shows the hand's.
    in property <string> value-text;
    in property <float> fraction;
    in property <SliderFill> fill: SliderFill.level;
    in property <color> tint: Colour.track-fill;
    in property <color> low;
    in property <color> high;
    // `DSSlider.knob`: a cap in the colour the value carries, the chrome's grey otherwise.
    in property <color> knob: SliderStyle.knob;
    in property <bool> enabled: true;
    in property <Look> look: Look.live;
    in property <bool> stepped;
    in property <int> value;
    in property <int> lowest;
    in property <int> highest;
    // The tooltips of the minus key, the name and the plus key.
    in property <string> minus-help;
    in property <string> help;
    in property <string> plus-help;
    // Rust answers whether this press is the second of a double click.
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    // Rust answers whether the scroll runs along the track; one across it is left to the panel.
    callback scroll(int, length, length, length, bool) -> bool;
    // Accessibility's increments; a stepped slider's every move, by whole steps.
    callback step(int, int);
    callback reset();
    // A press on a stepped rail holds the edit, so a whole slide is one step to undo.
    callback held(bool);
    // The step under the hand while it slides, ahead of the value the store answers.
    property <int> hand;
    property <int> span: max(1, root.highest - root.lowest);
    spacing: SliderStyle.label-gap;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.step(root.field, 1); }
    accessible-action-decrement => { root.step(root.field, -1); }
    property <float> at: root.stepped ? ((area.held ? root.hand : root.value) - root.lowest) / root.span : clamp(root.fraction, 0, 1);
    // What the rail and the knob show: sprung on `settle` for a value from elsewhere, never under the hand.
    property <float> shown: root.at;
    animate shown { duration: area.held || area.scrolling ? 0ms : SliderStyle.settle; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    pure function step-at(x: length) -> int {
        root.lowest + round(clamp(x / max(1px, track.width), 0, 1) * (root.highest - root.lowest))
    }
    ValueHeader {
        label: root.label;
        value: root.readout;
        enabled: root.enabled;
        resets: root.stepped;
        help: root.help;
        reset => { root.reset(); }
    }
    HorizontalLayout {
        spacing: Space.s;
        if root.stepped: StepKey {
            text: "−";
            fill: root.low;
            help: root.minus-help;
            enabled: root.enabled;
            clicked => { root.step(root.field, self.shift ? -3 : -1); }
        }
        HorizontalLayout {
            padding-left: SliderStyle.knob-width / 2;
            padding-right: SliderStyle.knob-width / 2;
            horizontal-stretch: 1;
            // Off limits, the words fade and the rail stays opaque, as `DSSlider`'s.
            track := Rectangle {
                height: SliderStyle.row;
                Rail {
                    x: -SliderStyle.knob-width / 2;
                    width: parent.width + SliderStyle.knob-width;
                    y: (parent.height - self.height) / 2;
                    overhang: SliderStyle.knob-width / 2;
                    fill: root.fill;
                    at: root.shown;
                    tint: root.tint;
                    low: root.low;
                    high: root.high;
                    // Rest, where the name's double click brings it back.
                    rest: root.stepped ? (0 - root.lowest) / root.span : -1;
                }
                Knob {
                    centre: parent.width * root.shown;
                    fill: root.knob;
                    grown: root.enabled && (area.over-knob || area.held || root.look != Look.live);
                }
                area := TouchArea {
                    enabled: root.enabled;
                    in-out property <bool> held;
                    property <bool> fine;
                    // A scroll's events, and `settle` after the last, which the knob follows unsprung.
                    in-out property <bool> scrolling;
                    out property <bool> over-knob: self.has-hover && abs(self.mouse-x - parent.width * root.shown) <= SliderStyle.knob-width / 2;
                    mouse-cursor: self.held ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    double-clicked => {
                        if (root.stepped) { root.reset(); }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            if (root.stepped) {
                                root.hand = root.step-at(self.mouse-x);
                                self.held = true;
                                root.held(true);
                                if (root.hand != root.value) {
                                    root.step(root.field, root.hand - root.value);
                                }
                            } else {
                                self.fine = event.modifiers.alt;
                                self.held = !root.press(root.field, self.fine);
                            }
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            if (root.stepped) {
                                if (self.held) {
                                    self.held = false;
                                    root.held(false);
                                }
                            } else if (event.button == PointerEventButton.left || event.kind == PointerEventKind.cancel) {
                                self.held = false;
                                root.release(root.field);
                            }
                        } else if (event.kind == PointerEventKind.move) {
                            self.fine = event.modifiers.alt;
                        }
                    }
                    moved => {
                        if (self.held && root.stepped) {
                            let next = root.step-at(self.mouse-x);
                            if (next != root.hand) {
                                root.step(root.field, next - root.hand);
                                root.hand = next;
                            }
                        } else if (self.held) {
                            root.drag(root.field, self.mouse-x - self.pressed-x, track.width, self.fine);
                        }
                    }
                    scroll-event(event) => {
                        if (!root.stepped && root.scroll(root.field, event.delta-x, event.delta-y, track.width, event.modifiers.alt)) {
                            self.scrolling = true;
                            still.restart();
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                still := Timer {
                    interval: Motion.settle;
                    running: area.scrolling;
                    triggered => { area.scrolling = false; }
                }
            }
        }
        if root.stepped: StepKey {
            text: "+";
            fill: root.high;
            help: root.plus-help;
            enabled: root.enabled;
            clicked => { root.step(root.field, self.shift ? 3 : 1); }
        }
    }
}
