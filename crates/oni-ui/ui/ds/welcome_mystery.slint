// The mystery gift's scene: the year's title in the Wrapped's serif over its gold, then a deck of the year's
// photos dealt and fanned under it, one after the other, as the Wrapped deals its cards.
import { DS } from "tokens.slint";
import { Colour, Space, Radius } from "theme.slint";
import { Outward } from "depth.slint";
import { Badge, BadgeTone } from "badge.slint";
import { Curves, WelcomeStyle } from "welcome.slint";

export global MysteryBeats {
    out property <float> title-for: 0.9;
    out property <float> deal-from: 1.0;
    out property <float> every: 0.35;
    out property <float> deal-for: 0.6;
    out property <float> hold: 3.0;
    out property <length> card: 150px;
    out property <angle> fan: 9deg;
}

export component MysteryScene inherits Rectangle {
    in property <string> year: "2026";
    // A moment of the loop held still, in seconds, for a check's shot; negative, the scene plays.
    in property <float> held: -1;
    clip: true;
    background: Colour.black;
    property <[image]> photos: [@image-url("../splash/1.0.0.jpg"), @image-url("../welcome/film-print.jpg"), @image-url("../splash/1.5.0.jpg"), @image-url("../splash/1.3.0.jpg")];
    property <float> loop: MysteryBeats.deal-from + root.photos.length * MysteryBeats.every + MysteryBeats.deal-for + MysteryBeats.hold;
    property <duration> began;
    init => { root.began = animation-tick(); }
    property <float> t: root.held >= 0 ? root.held : Math.mod((animation-tick() - root.began) / 1s, root.loop);
    property <float> titled: Curves.settle(max(0, min(1, root.t / MysteryBeats.title-for)));
    function dealt(i: int) -> float { Curves.settle(max(0, min(1, (root.t - MysteryBeats.deal-from - i * MysteryBeats.every) / MysteryBeats.deal-for))) }
    title := VerticalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.height * 0.12;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: Space.s;
        opacity: root.titled;
        for line in [@tr("Your Year"), @tr("On Film")]: Text {
            text: line;
            font-family: DS.typo-wrapped-title-family;
            font-size: WelcomeStyle.headline * (0.8 + 0.2 * root.titled);
            color: Colour.selected;
            horizontal-alignment: center;
        }
        HorizontalLayout { alignment: center; Badge { tone: BadgeTone.seal; text: root.year; } }
    }
    for photo[i] in root.photos: Outward {
        property <float> d: root.dealt(i);
        property <float> place: i - (root.photos.length - 1) / 2;
        width: MysteryBeats.card;
        height: MysteryBeats.card * 1.25;
        x: (root.width - self.width) / 2 + self.place * MysteryBeats.card * 0.62 * self.d;
        y: root.height * 0.52 + (1 - self.d) * root.height * 0.5 + abs(self.place) * Space.m * self.d;
        transform-rotation: MysteryBeats.fan * self.place * self.d;
        transform-origin: { x: self.width / 2, y: self.height };
        fill: Colour.ground;
        radius: Radius.card;
        Image {
            x: Space.s;
            y: Space.s;
            width: parent.width - 2 * Space.s;
            height: parent.width - 2 * Space.s;
            source: photo;
            image-fit: cover;
        }
    }
}
