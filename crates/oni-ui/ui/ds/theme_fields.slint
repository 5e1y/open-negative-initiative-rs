// The text fields' gauges, Swift's `dsTextField` (DSTextField.swift) laid flat: a card-cornered face in
// the canvas's dark, `DS.Space.md` across, `DS.Space.sm` down a multiline one, its edge lit while focused.
import { DS } from "tokens.slint";

export global FieldStyle {
    out property <length> radius: DS.radius-card;
    out property <length> height: DS.control-field-height;
    out property <length> across: DS.space-md;
    out property <length> down: DS.space-sm;
    out property <color> ground: DS.palette-canvas;
    // Focus lights the face's own edge, where a system field draws a blue ring.
    out property <color> rim: #ffffff66;
    // A multiline field's lines unless told, a report's message.
    out property <length> lines: 160px;
    // AppKit's dark label alpha, 0.85; the placeholder and a disabled field's words take the tertiary ink.
    out property <color> ink: DS.system-primary;
    // AppKit's selected-text background in the dark appearance, which no Swift token names.
    out property <color> selection: #3f638bff;
    out property <length> size-box: 64px;
    out property <length> date-box: 28px;
    out property <length> year-box: 46px;
}
