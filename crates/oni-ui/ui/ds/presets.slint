// The presets' pieces: a card on its tint, the card that makes one, a swatch, the editor's row, the
// sheet's panel and the rule that splits it.
import { Colour, Space, Radius, Stroke, State, SheetStyle } from "theme.slint";
import { PresetStyle } from "theme_views.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { Look } from "controls.slint";

// `PresetCarousel.card`: the monogram on the tint, the name under it, both in the tint's own ink.
export component PresetFace inherits Rectangle {
    in property <string> abbreviation;
    in property <string> name;
    in property <color> fill;
    in property <color> ink;
    // The deck's last card, a "+" in an outline, lit under the pointer, that saves a new preset.
    in property <bool> new;
    in property <bool> lit;
    in property <bool> enabled: true;
    width: PresetStyle.card-width;
    height: PresetStyle.card-height;
    border-radius: Radius.card;
    background: root.new ? Colour.ground.transparentize(1) : root.fill;
    border-width: !root.new ? 0px : root.lit ? Stroke.line : Stroke.hairline;
    border-color: root.lit ? Colour.ink : Colour.handle-idle;
    opacity: root.enabled ? 1 : State.disabled;
    if root.new: Label {
        text: "+";
        font-size: PresetStyle.mark;
        ink: root.lit ? Colour.ink : Colour.handle-idle;
        centred: true;
    }
    if !root.new: VerticalLayout {
        padding: Space.s;
        spacing: Space.xxs;
        Label {
            text: root.abbreviation;
            font-size: PresetStyle.mark;
            ink: root.ink;
            overflow: elide;
            vertical-alignment: top;
        }
        Rectangle { vertical-stretch: 1; }
        Label {
            text: root.name;
            ink: root.ink;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }
}

// A sheet at its own gauge hung from the window's top, modal as `Sheet`: no scrim, a click beside
// it reaches nothing; Escape dismisses it.
export component PanelSheet inherits Rectangle {
    in property <length> panel-width;
    in property <length> panel-height;
    callback dismissed();
    TouchArea { }
    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }
        Rectangle {
            y: SheetStyle.margin;
            width: root.panel-width;
            height: min(root.panel-height, root.height - 2 * SheetStyle.margin);
            background: Colour.ground;
            border-radius: SheetStyle.radius;
            border-width: Stroke.hairline;
            border-color: Colour.separator;
            drop-shadow-blur: SheetStyle.shadow;
            drop-shadow-color: Colour.scrim;
            clip: true;
            TouchArea { }
            @children
        }
    }
}

// The rule between two columns.
export component VerticalRule inherits Rectangle {
    width: Stroke.hairline;
    background: Colour.separator;
}
