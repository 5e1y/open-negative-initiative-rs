// The presets' pieces: a card on its tint, the card that makes one, the deck's tab, a swatch, the
// editor's row and the sheet's panel.
import { Colour, Space, Radius, Stroke, State, SheetStyle } from "theme.slint";
import { PresetStyle } from "theme_views.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { Look } from "controls.slint";
import { Outward } from "depth.slint";

// `PresetCarousel.card`: the tint, the name on one line at its foot in the tint's own ink, the card
// standing out of the deck (`dsFloating`), its shadow lengthened while it is `lifted`.
export component PresetFace inherits Rectangle {
    in property <string> name;
    in property <color> fill;
    in property <color> ink;
    // The deck's first card, a "+" in an outline, lit under the pointer, that saves a new preset.
    in property <bool> new;
    in property <bool> lit;
    in property <bool> enabled: true;
    in property <bool> lifted;
    width: PresetStyle.card-width;
    height: PresetStyle.card-height;
    opacity: root.enabled ? 1 : State.disabled;
    if root.new: Rectangle {
        border-radius: Radius.card;
        border-width: root.lit ? Stroke.line : Stroke.hairline;
        border-color: root.lit ? Colour.ink : Colour.handle-idle;
        Label {
            text: "+";
            font-size: PresetStyle.mark;
            ink: root.lit ? Colour.ink : Colour.handle-idle;
            centred: true;
        }
    }
    if !root.new: Outward {
        fill: root.fill;
        radius: Radius.card;
        lift: root.lifted ? 1 : 0;
        VerticalLayout {
            padding: Space.s;
            alignment: end;
            Label {
                text: root.name;
                ink: root.ink;
                overflow: elide;
            }
        }
    }
}

// The deck's tab on the canvas's bottom edge: an outline the edge cuts open, the deck's name inside,
// lit under the pointer and while the deck is open.
export component PresetTab inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    width: PresetStyle.card-width;
    height: PresetStyle.peek;
    Rectangle {
        y: 0;
        height: parent.height + Radius.card;
        border-radius: Radius.card;
        border-width: root.lit ? Stroke.line : Stroke.hairline;
        border-color: root.lit ? Colour.ink : Colour.handle-idle;
    }
    Label {
        x: Space.xs;
        width: parent.width - 2 * Space.xs;
        text: root.text;
        role: TextRole.caption;
        centred: true;
        overflow: elide;
        ink: root.lit ? Colour.ink : Colour.handle-idle;
    }
}
