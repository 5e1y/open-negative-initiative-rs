// The holographic face of a keycap: the welcome gifts' foil. A silver mirror whose gratings split the light
// into the seal's seven inks, the wordmark embossed across it in rows; the inks slide and a sheen follows
// as the hand crosses the key, so it is alive under the hand and still at rest.
import { Type, Motion, SealStyle, Foil } from "theme.slint";

// The wordmark every holographic face is embossed with, one phrase, set once by the app.
export global Holo {
    in property <string> wordmark;
}

export global HoloStyle {
    // The key's body under its face, and the ink that stands on the foil.
    out property <color> body: Foil.body(1);
    out property <color> ink: SealStyle.ink;
    // The foil laid as an ink, on a glyph and a word: the seal's seven inks across them.
    out property <brush> foil-ink: @linear-gradient(100deg, #f0aa78 0%, #dada6b 14%, #90ff90 29%, #6bdada 43%, #9090ff 57%, #da6bda 71%,
        #ff9090 86%, #f0aa78 100%);
    // The wordmark's rows: their height, the letters' size in them, and how far the inks travel under the hand.
    out property <length> row: 7px;
    out property <length> letters: 5px;
    out property <int> rows: 8;
    // The embossing stops this far from the face's edge.
    out property <length> inset: 2px;
    out property <float> travel: 0.1;
    // How far the gratings lean when the hand reaches an end of the key.
    out property <angle> lean: 14deg;
    // The light the face's top edge takes, and the shade its foot falls into.
    out property <float> top: 0.35;
    out property <float> foot: 0.5;
    // How much of the facets' second grating shows over the first, and of the embossed letters.
    out property <float> facet: 0.25;
    out property <float> emboss: 0.16;
    // The sheen that crosses the face with the hand, at rest and under it.
    out property <float> sheen: 0.7;
}

export component HoloFace inherits Rectangle {
    in property <length> radius;
    // Where the hand is across the key, 0 to 1, its middle at rest; and whether it is on the key.
    in property <float> hand: 0.5;
    in property <bool> hovered;
    property <float> at: root.hand;
    animate at { duration: Motion.quick; easing: ease-out; }
    border-radius: root.radius;
    background: Foil.deep(1);
    // How far the hand has turned the key, -1 to 1: the gratings lean and their inks slide with it.
    property <float> turn: 2 * (root.at - 0.5);
    property <float> slide: root.turn * HoloStyle.travel;
    // The gratings' inks, the seal's seven, across the face.
    Rectangle {
        border-radius: root.radius;
        property <float> a: 0.14 + root.slide;
        property <float> b: 0.29 + root.slide;
        property <float> c: 0.43 + root.slide;
        property <float> d: 0.57 + root.slide;
        property <float> e: 0.71 + root.slide;
        property <float> f: 0.86 + root.slide;
        background: @linear-gradient(100deg + root.turn * HoloStyle.lean, #f0aa78 0%, #dada6b self.a, #90ff90 self.b, #6bdada self.c, #9090ff self.d,
            #da6bda self.e, #ff9090 self.f, #f0aa78 100%);
    }
    // The facets' own grating, askew, leaning the other way, mixed over the first.
    Rectangle {
        border-radius: root.radius;
        property <color> first: #9090ff;
        property <color> second: #ff9090;
        property <color> third: #90ff90;
        property <color> last: #6bdada;
        background: @linear-gradient(35deg - root.turn * HoloStyle.lean, self.first.with-alpha(HoloStyle.facet) 0%, self.second.with-alpha(HoloStyle.facet) 33%,
            self.third.with-alpha(HoloStyle.facet) 66%, self.last.with-alpha(HoloStyle.facet) 100%);
    }
    // The light down the face: a lit top edge, the body left to its inks, a foot in the foil's own shade.
    Rectangle {
        border-radius: root.radius;
        property <color> shade: Foil.deep(1);
        background: @linear-gradient(180deg, Foil.bright(1).with-alpha(HoloStyle.top) 0%, Foil.bright(1).with-alpha(0) 30%, self.shade.with-alpha(0) 50%,
            self.shade.with-alpha(HoloStyle.foot) 100%);
    }
    // The wordmark embossed in rows, each half a phrase from the last, kept inside the face's edge.
    Rectangle {
        x: HoloStyle.inset;
        y: HoloStyle.inset;
        width: parent.width - 2 * HoloStyle.inset;
        height: parent.height - 2 * HoloStyle.inset;
        clip: true;
        for row in HoloStyle.rows: HorizontalLayout {
            x: -(mod(row, 2) == 0 ? 0px : self.preferred-width / 6) - root.width * 0.3 * (root.at - 0.5) - HoloStyle.row;
            y: row * HoloStyle.row - HoloStyle.row / 2;
            width: self.preferred-width;
            height: HoloStyle.row;
            spacing: HoloStyle.row;
            for copy in 3: Text {
                text: Holo.wordmark;
                font-family: Type.display;
                font-weight: Type.display-weight;
                font-size: HoloStyle.letters;
                color: Foil.bright(1).with-alpha(HoloStyle.emboss);
                vertical-alignment: center;
            }
        }
    }
    // The sheen: a band of the studio's light that crosses with the hand.
    Rectangle {
        border-radius: root.radius;
        property <float> middle: clamp(root.at, 0.24, 0.76);
        property <float> before: self.middle - 0.22;
        property <float> after: self.middle + 0.22;
        property <color> clear: Foil.bright(1).with-alpha(0);
        property <float> strength: root.hovered ? HoloStyle.sheen : HoloStyle.sheen / 2;
        background: @linear-gradient(90deg, self.clear 0%, self.clear self.before, Foil.bright(1).with-alpha(self.strength) self.middle, self.clear self.after, self.clear 100%);
        animate strength { duration: Motion.quick; }
    }
}
