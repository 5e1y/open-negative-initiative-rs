// The welcome's interface scene, its left column: the folders' header and tree before; the rating
// filter and the folding Favourites and Computer sections now. Every length is times `z`.
import { Colour, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { InterfaceSceneStyle, InterfaceBeats, Pouf, Breath, CapBody } from "welcome_interface_parts.slint";

export global SideStyle {
    out property <length> tabs-y: 6px;
    out property <length> tabs-height: 18px;
    out property <length> head-y: 32px;
    out property <length> old-pill-x: 41px;
    out property <length> old-pill-height: 14px;
    out property <length> pill-height: 16px;
    out property <length> row: 19px;
    out property <length> rows-y: 54px;
    out property <length> mini: 14px;
    out property <length> mini-rim: 1.5px;
    out property <length> old-inset: 5px;
    out property <length> new-inset: 10px;
    out property <length> chevron-zone: 10px;
    out property <length> line: 4px;
    out property <color> line-ink: #ffffff45;
    out property <color> line-lit: #ffffffb0;
    out property <color> count-ink: #ffffff30;
    out property <length> pill-radius: 7px;
    // Computer's heading, from the column's top: where the hand clicks to fold it.
    out property <length> computer-y: 115px;
}

// Archive and Projects, the same tabs in both looks.
export component SideTabs inherits Rectangle {
    in property <float> zoom: 1;
    height: SideStyle.tabs-height * root.zoom;
    border-radius: self.height / 2;
    background: Colour.canvas;
    Rectangle {
        x: 2px * root.zoom;
        y: 2px * root.zoom;
        width: root.width / 2 - 2px * root.zoom;
        height: root.height - 4px * root.zoom;
        border-radius: self.height / 2;
        background: #3e3e3e;
    }
    HorizontalLayout {
        for word[i] in [@tr("Archive"), @tr("Projects")]: Text {
            text: word;
            font-family: Type.family;
            font-size: InterfaceSceneStyle.word * root.zoom;
            font-weight: Type.strong;
            color: Colour.ink.with-alpha(i == 0 ? 1 : 0.62);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A row: a folder's name drawn as a line, so the column says how it reads and never whose it is.
component SideRow inherits Rectangle {
    in property <float> zoom: 1;
    in property <float> k: 1;
    in property <length> lead;
    in property <length> name;
    in property <length> count;
    in property <image> glyph: Icons.folder;
    in property <int> chevron;
    in property <bool> selected;
    in property <bool> star;
    in property <bool> warning;
    height: SideStyle.row * root.zoom;
    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.width * root.k / root.zoom;
        height: root.height * root.k / root.zoom;
        border-radius: InterfaceSceneStyle.old-radius * root.k;
        background: root.selected ? Colour.row-selected : transparent;
        if root.chevron > 0: Image {
            x: root.lead * root.k;
            y: (parent.height - self.height) / 2;
            source: root.chevron == 1 ? Icons.chevron-down : Icons.chevron-right;
            colorize: Colour.ink-secondary;
            width: InterfaceSceneStyle.glyph-small * root.k;
            height: self.width;
        }
        Image {
            x: (root.lead + SideStyle.chevron-zone) * root.k;
            y: (parent.height - self.height) / 2;
            source: root.glyph;
            colorize: root.selected ? Colour.ink : Colour.ink-secondary;
            width: InterfaceSceneStyle.glyph * root.k;
            height: self.width;
        }
        Rectangle {
            x: (root.lead + SideStyle.chevron-zone + InterfaceSceneStyle.glyph + 5px) * root.k;
            y: (parent.height - self.height) / 2;
            width: root.name * root.k;
            height: SideStyle.line * root.k;
            border-radius: self.height / 2;
            background: root.selected ? SideStyle.line-lit : SideStyle.line-ink;
        }
        if root.warning: Image {
            x: (root.lead + SideStyle.chevron-zone + InterfaceSceneStyle.glyph + 8px + root.name) * root.k;
            y: (parent.height - self.height) / 2;
            source: Icons.warning;
            colorize: Colour.warning;
            width: InterfaceSceneStyle.glyph-small * root.k;
            height: self.width;
        }
        if root.star: Image {
            x: parent.width - (root.count + 2 * InterfaceSceneStyle.glyph) * root.k;
            y: (parent.height - self.height) / 2;
            source: Icons.favourite-on;
            colorize: Colour.medal[3];
            width: InterfaceSceneStyle.glyph-small * root.k;
            height: self.width;
        }
        Rectangle {
            x: parent.width - (root.count + 6px) * root.k;
            y: (parent.height - self.height) / 2;
            width: root.count * root.k;
            height: SideStyle.line * root.k;
            border-radius: self.height / 2;
            background: SideStyle.count-ink;
        }
    }
}

// The column in both looks: the old header and tree pressed flat and gone, the path pill widened into
// the rating filter, the sections fading in as the group settles; `fold` closes Computer upward.
export component Side inherits Rectangle {
    in property <float> t;
    in property <float> zoom: 1;
    in property <float> fold;
    // Computer's heading under the hand, then pressed.
    in property <float> hover;
    in property <float> pressed;
    pouf := Pouf { t: root.t; at: InterfaceBeats.sidebar; }
    property <float> k: root.zoom * (1 - (1 - InterfaceSceneStyle.pressed) * pouf.press);
    property <float> grow: root.zoom * (InterfaceSceneStyle.grown + (1 - InterfaceSceneStyle.grown) * pouf.come);
    SideTabs { x: InterfaceSceneStyle.pad * root.zoom; y: SideStyle.tabs-y * root.zoom; width: root.width - 2 * InterfaceSceneStyle.pad * root.zoom; zoom: root.zoom; }

    // Before: a parent and a favourites key on a black plate.
    Rectangle {
        x: SideStyle.old-inset * root.zoom;
        y: SideStyle.head-y * root.zoom + (SideStyle.pill-height * root.zoom - self.height) / 2;
        width: (2 * SideStyle.mini + 2 * SideStyle.mini-rim) * root.k;
        height: (SideStyle.mini + 2 * SideStyle.mini-rim) * root.k;
        border-radius: InterfaceSceneStyle.old-radius * root.k;
        background: InterfaceSceneStyle.plate;
        opacity: 1 - pouf.gone;
        visible: pouf.gone < 1;
        HorizontalLayout {
            padding: SideStyle.mini-rim * root.k;
            for glyph in [Icons.parent, Icons.favourite]: CapBody {
                old: true;
                k: root.k * 0.6;
                sink: pouf.press;
                Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: glyph; colorize: Colour.white; width: InterfaceSceneStyle.glyph-small * root.k; height: self.width; }
            }
        }
    }
    // The path pill, widening into the rating filter's as the group settles.
    Rectangle {
        x: (SideStyle.old-pill-x + (SideStyle.new-inset - SideStyle.old-pill-x) * pouf.settle) * root.zoom;
        y: SideStyle.head-y * root.zoom + (SideStyle.pill-height * root.zoom - self.height) / 2;
        width: root.width - self.x - (SideStyle.old-inset + (SideStyle.new-inset - SideStyle.old-inset) * pouf.settle) * root.zoom;
        height: (SideStyle.old-pill-height + (SideStyle.pill-height - SideStyle.old-pill-height) * pouf.settle) * root.zoom;
        border-radius: (InterfaceSceneStyle.old-radius + (SideStyle.pill-radius - InterfaceSceneStyle.old-radius) * pouf.settle) * root.zoom;
        background: Colour.canvas;
        for word[i] in ["2024", @tr("All Photos")]: Text {
            x: 7px * root.zoom;
            height: parent.height;
            text: word;
            opacity: i == 0 ? 1 - pouf.gone : pouf.come;
            font-family: Type.family;
            font-size: InterfaceSceneStyle.word * root.zoom;
            font-weight: i == 0 ? Type.regular : Type.medium;
            color: Colour.ink;
            vertical-alignment: center;
        }
        Image { x: parent.width - 12px * root.zoom; y: (parent.height - self.height) / 2; source: Icons.chevron-down; colorize: Colour.ink-secondary; width: InterfaceSceneStyle.glyph-small * root.zoom; height: self.width; }
    }
    // Before: a year open on its rolls, two more closed.
    for row[i] in [
        { lead: 0px, name: 34px, count: 0px, chevron: 1, selected: false },
        { lead: 10px, name: 52px, count: 8px, chevron: 0, selected: false },
        { lead: 10px, name: 44px, count: 8px, chevron: 0, selected: true },
        { lead: 10px, name: 58px, count: 8px, chevron: 0, selected: false },
        { lead: 10px, name: 40px, count: 6px, chevron: 0, selected: false },
        { lead: 0px, name: 34px, count: 0px, chevron: 2, selected: false },
        { lead: 0px, name: 34px, count: 0px, chevron: 2, selected: false },
    ]: SideRow {
        zoom: root.zoom;
        k: root.k;
        x: SideStyle.old-inset * root.zoom;
        y: (SideStyle.rows-y + i * SideStyle.row) * root.zoom;
        width: root.width - 2 * SideStyle.old-inset * root.zoom;
        lead: row.lead + 3px;
        name: row.name;
        count: row.count;
        chevron: row.chevron;
        selected: row.selected;
        opacity: 1 - pouf.gone;
        visible: pouf.gone < 1;
    }

    // Now: the two sections' headings, fading in as the group settles; Computer takes the hand.
    for heading[i] in [
        { word: @tr("Favourites"), y: SideStyle.rows-y, folds: false },
        { word: @tr("Computer"), y: SideStyle.computer-y, folds: true },
    ]: Rectangle {
        property <float> folded: heading.folds ? root.fold : 0;
        x: SideStyle.new-inset * root.zoom;
        y: heading.y * root.zoom;
        width: root.width - 2 * SideStyle.new-inset * root.zoom;
        height: SideStyle.row * root.zoom;
        border-radius: InterfaceSceneStyle.old-radius * root.zoom;
        opacity: pouf.settle;
        visible: pouf.settle > 0;
        background: Colour.white.with-alpha(heading.folds ? max(InterfaceSceneStyle.hover * root.hover, InterfaceSceneStyle.press * root.pressed) : 0);
        for open in [true, false]: Image {
            x: 3px * root.zoom;
            y: (parent.height - self.height) / 2;
            source: open ? Icons.chevron-down : Icons.chevron-right;
            colorize: Colour.ink;
            opacity: open ? 1 - parent.folded : parent.folded;
            width: InterfaceSceneStyle.glyph-small * root.zoom;
            height: self.width;
        }
        Text {
            x: (3px + SideStyle.chevron-zone) * root.zoom;
            height: parent.height;
            text: heading.word;
            font-family: Type.family;
            font-size: InterfaceSceneStyle.word * root.zoom;
            font-weight: Type.strong;
            color: Colour.ink-tertiary;
            vertical-alignment: center;
        }
    }
    for row[i] in [
        { name: 46px, star: true },
        { name: 38px, star: true },
    ]: SideRow {
        zoom: root.zoom;
        k: root.grow;
        x: SideStyle.new-inset * root.zoom;
        y: (SideStyle.rows-y + (i + 1) * SideStyle.row) * root.zoom;
        width: root.width - 2 * SideStyle.new-inset * root.zoom;
        name: row.name;
        count: 6px;
        glyph: Icons.film-roll;
        star: row.star;
        opacity: pouf.come;
        visible: pouf.come > 0;
    }
    // Computer's rows close upward under their heading, cut at its foot.
    Rectangle {
        x: SideStyle.new-inset * root.zoom;
        y: (SideStyle.computer-y + SideStyle.row) * root.zoom;
        width: root.width - 2 * SideStyle.new-inset * root.zoom;
        height: 4 * SideStyle.row * root.zoom;
        clip: true;
        for row[i] in [
            { name: 30px, warning: false, selected: false, roll: false },
            { name: 52px, warning: false, selected: true, roll: true },
            { name: 44px, warning: true, selected: false, roll: true },
            { name: 36px, warning: false, selected: false, roll: true },
        ]: SideRow {
            zoom: root.zoom;
            k: root.grow;
            x: 0;
            y: (i - 4 * root.fold) * SideStyle.row * root.zoom;
            width: parent.width;
            name: row.name;
            count: 6px;
            glyph: row.roll ? Icons.film-roll : Icons.folder;
            selected: row.selected;
            warning: row.warning;
            opacity: pouf.come;
            visible: pouf.come > 0 && root.fold < 1;
        }
    }
    Breath {
        t: root.t;
        at: InterfaceBeats.sidebar;
        zoom: root.zoom;
        x: SideStyle.old-inset * root.zoom;
        y: SideStyle.head-y * root.zoom;
        width: root.width - 2 * SideStyle.old-inset * root.zoom;
        height: (SideStyle.rows-y + 7 * SideStyle.row - SideStyle.head-y) * root.zoom;
    }
}
