// `Splash`: a picture per version, the logo, the version line and the photo's credit along its
// foot; the app's window opens on it, and the welcome sheet shows it.
import { DS } from "tokens.slint";
import { Colour, Space, Type } from "theme.slint";
import { Picture, Ground, Fit } from "base.slint";
import { Progress } from "forms.slint";
import { Starter } from "starting.slint";

export global SplashStyle {
    out property <length> width: DS.control-splash-width;
    out property <length> height: DS.control-splash-height;
    out property <length> radius: DS.radius-control;
    out property <length> logo-width: DS.control-splash-logo-width;
    out property <length> logo-height: DS.control-splash-logo-height;
    out property <length> inset-leading: DS.space-lg + DS.space-xs;
    out property <length> inset-trailing: DS.space-lg + DS.space-sm;
    out property <length> inset-bottom: DS.space-lg + DS.space-xs;
    out property <length> lines: DS.space-sm + DS.space-xs;
    out property <length> line-indent: DS.space-xs;
    // `welcomeCaptionScale`: the welcome's photo carries a smaller caption.
    out property <float> welcome-scale: DS.control-welcome-caption-scale / 1px;
}

// `SplashCaption`: the logo over the version line at the foot's leading corner, "Photo" over the
// credit at its trailing one, every inset and size times `scale`.
export component SplashCaption inherits Rectangle {
    in property <string> line;
    in property <string> credit;
    in property <float> scale: 1;
    Image {
        x: SplashStyle.inset-leading * root.scale;
        y: root.height - SplashStyle.inset-bottom * root.scale - version.preferred-height - SplashStyle.lines * root.scale - self.height;
        width: SplashStyle.logo-width * root.scale;
        height: SplashStyle.logo-height * root.scale;
        source: @image-url("../icons/oni-logo.svg");
        colorize: DS.palette-selected;
    }
    version := Text {
        x: (SplashStyle.inset-leading + SplashStyle.line-indent) * root.scale;
        y: root.height - SplashStyle.inset-bottom * root.scale - self.preferred-height;
        text: root.line;
        color: DS.palette-selected;
        font-family: DS.typo-splash-line-family;
        font-size: DS.typo-splash-line-size * root.scale;
        font-weight: DS.typo-splash-line-weight;
    }
    if root.credit != "": Text {
        x: root.width - SplashStyle.inset-trailing * root.scale - self.preferred-width;
        y: root.height - SplashStyle.inset-bottom * root.scale - credit.preferred-height - DS.space-xxs * root.scale - self.preferred-height;
        text: @tr("Photo");
        color: DS.palette-selected;
        font-family: DS.typo-splash-caption-family;
        font-size: DS.typo-splash-caption-size * root.scale;
        font-weight: DS.typo-splash-caption-weight;
    }
    credit := Text {
        x: root.width - SplashStyle.inset-trailing * root.scale - self.preferred-width;
        y: root.height - SplashStyle.inset-bottom * root.scale - self.preferred-height;
        text: root.credit;
        color: DS.palette-selected;
        font-family: DS.typo-splash-line-family;
        font-size: DS.typo-splash-line-size * root.scale;
        font-weight: DS.typo-splash-line-weight;
    }
}

// A version's photo cropped to fill, the splash's caption over its foot; on the welcome's stage at
// the welcome's scale.
export component WelcomePhoto inherits Picture {
    // The version's picture, oldest first.
    in property <int> picture;
    in property <string> line;
    in property <string> credit;
    in property <float> scale: SplashStyle.welcome-scale;
    clip: true;
    ground: Ground.canvas;
    fit: Fit.cover;
    source: root.picture == 0 ? @image-url("../splash/1.0.0.jpg") : root.picture == 1 ? @image-url("../splash/1.3.0.jpg") : @image-url("../splash/1.5.0.jpg");
    SplashCaption {
        width: parent.width;
        height: parent.height;
        line: root.line;
        credit: root.credit;
        scale: root.scale;
    }
}

// The app's window while it starts: the version's picture over a band in the app's grey that says
// the step under way, the launch's time, its bar and the steps done; the app beneath takes no press.
// The band keeps its height; the picture takes what a menu bar drawn in the window leaves.
export component StarterView inherits Rectangle {
    background: Colour.ground;
    TouchArea { }
    WelcomePhoto {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - Starter.band-height;
        picture: Starter.picture;
        line: Starter.line;
        credit: Starter.credit;
        scale: 1;
    }
    VerticalLayout {
        x: 0;
        y: parent.height - Starter.band-height;
        width: parent.width;
        height: Starter.band-height;
        padding-left: Space.m;
        padding-right: Space.m;
        alignment: center;
        spacing: Space.s;
        HorizontalLayout {
            spacing: Space.s;
            Text {
                text: Starter.stage;
                color: Colour.ink;
                font-size: Type.label;
                font-weight: Type.medium;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: Starter.elapsed;
                color: Colour.ink-secondary;
                font-size: Type.label;
            }
        }
        Progress { fraction: Starter.fraction; }
        Text {
            text: Starter.done;
            color: Colour.ink-tertiary;
            font-size: Type.caption;
            overflow: elide;
        }
    }
}
