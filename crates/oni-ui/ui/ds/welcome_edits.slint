// The welcome's scene of the edits brought up to date: eight pictures that never change, each with a
// settings card turned flat from 1.5 to 1.6, and a count of the cards done. Times are ms of a 7 s loop.
import { Colour, Space, Radius, Stroke } from "theme.slint";
import { Label, Icon, Tone, TextRole } from "base.slint";
import { Icons } from "icons.slint";
import { SceneFrame, Cycle, Phase, WelcomeStyle } from "welcome.slint";

export global EditsStyle {
    out property <duration> period: 7000ms;
    out property <int> columns: 4;
    out property <int> count: 8;
    out property <length> thumb-width: 96px;
    out property <length> thumb-height: 60px;
    out property <length> card-height: 28px;
    out property <length> card-gap: 6px;
    out property <length> gap-x: 32px;
    out property <length> gap-y: 30px;
    out property <length> check: 12px;
    out property <length> cell: 14px;
    out property <length> status-gap: 26px;
    out property <length> cell-height: EditsStyle.thumb-height + EditsStyle.card-gap + EditsStyle.card-height;
    out property <length> left: (WelcomeStyle.scene-width - EditsStyle.columns * EditsStyle.thumb-width - (EditsStyle.columns - 1) * EditsStyle.gap-x) / 2;
    out property <length> top: (WelcomeStyle.scene-height - 2 * EditsStyle.cell-height - EditsStyle.gap-y - EditsStyle.status-gap - 20px) / 2;
    // The card of cell i closes from 1300 + 400 i, opens 140 later, its check lands at 300 and its count at 320.
    out property <float> first: 1300 / 7000;
    out property <float> step: 400 / 7000;
    out property <float> close: 140 / 7000;
    out property <float> open: 180 / 7000;
    out property <float> mark-from: 300 / 7000;
    out property <float> mark-to: 480 / 7000;
    out property <float> counted: 320 / 7000;
    // The card's face is lit as it opens and falls back to rest over 300 ms.
    out property <float> lit-to: 440 / 7000;
    out property <float> rest: 0.07;
    out property <float> lit: 0.07;
    out property <length> glyph: 12px;
    // The status line settles once the last card is done.
    out property <float> settle-from: 4580 / 7000;
    out property <float> settle-to: 4820 / 7000;
}

// A picture drawn as a sky over a ground, its horizon a share of the height down.
struct Picture { sky: color, ground: color, horizon: float }

// One cell: a drawn picture, still for the whole loop, and under it the settings card of its photo.
component Cell inherits Rectangle {
    in property <int> index;
    in property <float> t;
    in property <float> rewind;
    in property <Picture> picture;
    property <float> start: EditsStyle.first + root.index * EditsStyle.step;
    closing := Phase { t: root.t; from: root.start; to: root.start + EditsStyle.close; }
    opening := Phase { t: root.t; from: root.start + EditsStyle.close; to: root.start + EditsStyle.close + EditsStyle.open; }
    lit := Phase { t: root.t; from: root.start + EditsStyle.close; to: root.start + EditsStyle.lit-to; }
    mark := Phase { t: root.t; from: root.start + EditsStyle.mark-from; to: root.start + EditsStyle.mark-to; }
    // The new face shows from the half of the turn, and under the rewind it dissolves back to the old.
    property <float> fresh: max(closing.p >= 1 ? 1.0 : 0.0, root.rewind);
    width: EditsStyle.thumb-width;
    height: EditsStyle.cell-height;
    Rectangle {
        y: 0px;
        width: EditsStyle.thumb-width;
        height: EditsStyle.thumb-height;
        border-radius: Radius.picture;
        clip: true;
        background: @linear-gradient(180deg, root.picture.sky.brighter(0.15) 0%, root.picture.sky 100%);
        Rectangle {
            y: parent.height * root.picture.horizon;
            height: parent.height - self.y;
            background: root.picture.ground;
        }
    }
    Rectangle {
        y: EditsStyle.thumb-height + EditsStyle.card-gap;
        width: EditsStyle.thumb-width;
        height: EditsStyle.card-height;
        transform-scale-y: max(0.001, closing.p < 1 ? 1 - closing.leave : (root.rewind > 0 ? 1.0 : opening.arrive));
        border-radius: Radius.badge;
        border-width: Stroke.line;
        border-color: Colour.separator;
        background: Colour.white.with-alpha(closing.p >= 1 && root.rewind == 0 ? EditsStyle.rest + EditsStyle.lit * (1 - lit.arrive) : EditsStyle.rest);
        Icon {
            x: Space.s;
            y: (parent.height - EditsStyle.glyph) / 2;
            width: EditsStyle.glyph;
            height: EditsStyle.glyph;
            source: Icons.options;
            tone: root.fresh > 0.5 ? Tone.primary : Tone.tertiary;
        }
        Label {
            x: Space.s + EditsStyle.glyph + 6px;
            width: 40px;
            height: parent.height;
            text: "1.5";
            tone: Tone.tertiary;
            opacity: 1 - root.fresh;
        }
        Label {
            x: Space.s + EditsStyle.glyph + 6px;
            width: 40px;
            height: parent.height;
            text: "1.6";
            opacity: root.fresh;
        }
        Icon {
            x: parent.width - Space.s - EditsStyle.check / 2 - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: EditsStyle.check * (0.6 + 0.4 * max(mark.land, root.rewind));
            height: self.width;
            source: Icons.done;
            tone: Tone.primary;
            opacity: max(mark.arrive, root.rewind);
        }
    }
}

export component EditsScene inherits SceneFrame {
    cycle := Cycle { period: EditsStyle.period; }
    property <float> t: cycle.t;
    property <float> rewind: cycle.rewind;
    property <[Picture]> pictures: [
        { sky: #7d97ab, ground: #4c5a52, horizon: 0.62 },
        { sky: #a8a093, ground: #5d5348, horizon: 0.55 },
        { sky: #c2a47c, ground: #6e5a40, horizon: 0.70 },
        { sky: #8ea08a, ground: #46553f, horizon: 0.48 },
        { sky: #b58d80, ground: #5a4440, horizon: 0.66 },
        { sky: #8c8aa6, ground: #3f3d52, horizon: 0.58 },
        { sky: #9fb0b5, ground: #57666a, horizon: 0.74 },
        { sky: #b9ad8f, ground: #4e4a3a, horizon: 0.52 },
    ];
    // Cards done so far: one per step once its count is due.
    property <int> done: Math.round(max(0, min(EditsStyle.count, Math.floor((root.t - EditsStyle.first - EditsStyle.counted) / EditsStyle.step) + 1)));
    settled := Phase { t: root.t; from: EditsStyle.settle-from; to: EditsStyle.settle-to; }
    for picture[i] in root.pictures: Cell {
        x: EditsStyle.left + mod(i, EditsStyle.columns) * (EditsStyle.thumb-width + EditsStyle.gap-x);
        y: EditsStyle.top + floor(i / EditsStyle.columns) * (EditsStyle.cell-height + EditsStyle.gap-y);
        index: i;
        t: root.t;
        rewind: root.rewind;
        picture: picture;
    }
    // The count in fixed cells, its check before it; the last state is drawn under the rewind as a second layer.
    Rectangle {
        property <length> base: (parent.width - 64px) / 2;
        y: EditsStyle.top + 2 * EditsStyle.cell-height + EditsStyle.gap-y + EditsStyle.status-gap;
        height: 20px;
        Icon {
            x: parent.base + EditsStyle.check / 2 - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: EditsStyle.check * (0.6 + 0.4 * max(settled.land, root.rewind));
            height: self.width;
            source: Icons.done;
            tone: Tone.primary;
            opacity: max(settled.arrive, root.rewind);
        }
        Label {
            x: parent.base + 20px;
            width: EditsStyle.cell;
            height: parent.height;
            text: EditsStyle.count;
            horizontal-alignment: right;
            ink: Colour.ink.mix(Colour.ink-secondary, max(settled.ease, root.rewind));
            opacity: root.rewind;
        }
        Label {
            x: parent.base + 20px;
            width: EditsStyle.cell;
            height: parent.height;
            text: root.done;
            horizontal-alignment: right;
            ink: Colour.ink.mix(Colour.ink-secondary, max(settled.ease, root.rewind));
            opacity: 1 - root.rewind;
        }
        Label {
            x: parent.base + 20px + EditsStyle.cell + Space.xs;
            width: 40px;
            height: parent.height;
            text: "/ 8";
            ink: Colour.ink.mix(Colour.ink-secondary, max(settled.ease, root.rewind));
        }
    }
}
