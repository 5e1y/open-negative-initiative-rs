// The navigator's controls: a folder's row and its rename field, the header's keys and pill, the
// pill's list of folders above, and the line dragged to size the rows beside a photograph.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, State, ButtonStyle, RowStyle, MenuStyle, FieldStyle } from "theme.slint";
import { Label, Icon, Tone, Tips } from "base.slint";
import { TextField, Look } from "controls.slint";
import { MenuPanel } from "containers.slint";
import { Icons } from "icons.slint";

export global NavigatorStyle {
    // `DS.Control.navigatorEditorRest` and `navigatorMaxHeight`: the rows beside a photograph.
    out property <length> rest: DS.control-navigator-editor-rest;
    out property <length> max: DS.control-navigator-max-height;
    out property <length> star: DS.control-icon-size * 0.8;
    out property <length> key: DS.control-keycap-mini-height;
    out property <color> favourite: DS.tint-favourite;
    // `NavigatorRow`'s 0.4 on a folder of a volume not mounted.
    out property <float> absent: 0.4;
}

// `ColumnPill`: the name a column's header gives what it lists, a key when it opens something.
export component ColumnPill inherits Rectangle {
    in property <string> text;
    in property <string> help;
    in property <bool> enabled: true;
    in property <bool> pressable;
    in property <Look> look: Look.live;
    callback clicked();
    // As tall as the key plate beside it, keys and inset alike.
    height: NavigatorStyle.key + 2 * ButtonStyle.plate-inset;
    border-radius: Radius.badge;
    background: root.pressable && root.enabled && (touch.has-hover || root.look != Look.live) ? Colour.hover : Colour.canvas;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        Label { text: root.text; overflow: elide; horizontal-stretch: 1; }
    }
    // Hovered even when it opens nothing, so the path it names still shows as its note.
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.pressable) { root.clicked(); } }
        changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
    }
}

// One folder of the pill's list: its glyph, its name, a check on the folder the column stands on.
export struct FolderChoice { title: string, current: bool }

// The pill's popover: the base and each folder above it, Computer last.
export component FolderMenu inherits PopupWindow {
    in property <[FolderChoice]> choices;
    callback chosen(int);
    close-policy: close-on-click-outside;
    MenuPanel {
        for choice[i] in root.choices: Rectangle {
            height: MenuStyle.row;
            border-radius: ButtonStyle.small-radius;
            background: area.has-hover ? Colour.hover : transparent;
            accessible-role: button;
            accessible-label: choice.title;
            HorizontalLayout {
                padding-left: Space.xs;
                padding-right: Space.xs;
                spacing: Space.s;
                VerticalLayout { alignment: center; Icon { source: Icons.folder; width: RowStyle.icon; height: RowStyle.icon; } }
                Label { text: choice.title; overflow: elide; horizontal-stretch: 1; }
                if choice.current: VerticalLayout {
                    alignment: center;
                    Icon { source: Icons.done; width: NavigatorStyle.star; height: NavigatorStyle.star; tone: Tone.primary; }
                }
            }
            area := TouchArea { clicked => { root.chosen(i); } }
        }
    }
}

// `NavigatorDivider`: the line under the rows, dragged to size them from nothing to the ceiling;
// read in window space, since the line moves with the rows it sizes.
export component RowsDivider inherits Rectangle {
    in-out property <length> rows;
    callback released(length);
    property <length> start;
    height: Stroke.line + 2 * Space.xs;
    Rectangle {
        height: Stroke.line;
        background: Colour.separator;
    }
    grab := TouchArea {
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.start = root.rows - self.absolute-position.y - self.mouse-y;
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(root.rows);
            }
        }
        moved => {
            if (self.pressed) {
                root.rows = max(0px, min(NavigatorStyle.max, root.start + self.absolute-position.y + self.mouse-y));
            }
        }
    }
}
