// The Lens DB's mark: its aperture, its disc and blades each in an ink of the theme, beside its name set as
// its site sets it, bold and tight; credited, the contract's mention leads to it. A click opens its site.
import { Colour, Type, Space } from "theme.slint";
import { Icon, Label, TextRole, Tone } from "base.slint";
import { Icons } from "icons.slint";
import { KitStyle } from "theme_views.slint";

export component TldbMark inherits Rectangle {
    in property <length> size: KitStyle.mark;
    in property <bool> large;
    in property <length> word-size: root.large ? Type.title : Type.label;
    // The words before the mark: the contract's mention, shorter where a title beside it names the Kit.
    in property <string> lead: @tr("Catalogue provided by");
    // "Catalogue provided by" before the mark, which names the service so the words need not; beside it on
    // one line, or over it where a narrow column leaves no room.
    in property <bool> credited;
    in property <bool> under;
    callback clicked();
    property <bool> beside: root.credited && !root.under;
    accessible-role: button;
    accessible-label: root.credited ? @tr("Catalogue provided by The Lens DB") : @tr("The Lens DB");
    accessible-action-default => { root.clicked(); }
    // Centred in a row taller than the disc, as beside a key, so the words and the mark share one middle.
    VerticalLayout {
        spacing: Space.xxs;
        alignment: center;
        if root.credited && root.under: Label {
            role: TextRole.caption;
            tone: Tone.secondary;
            text: root.lead;
        }
        HorizontalLayout {
            spacing: root.size / 3;
            alignment: LayoutAlignment.start;
            if root.beside: Label {
                horizontal-stretch: 0;
                role: TextRole.caption;
                tone: Tone.secondary;
                vertical-alignment: center;
                text: root.lead;
            }
            Rectangle {
                width: root.size;
                height: root.size;
                Icon { width: parent.width; height: parent.height; source: Icons.tldb-disc; ink: Colour.ink; }
                Icon { width: parent.width; height: parent.height; source: Icons.tldb-blades; ink: Colour.ground; }
            }
            // As tall as the disc, so the capitals sit on its middle whatever the size.
            Text {
                height: root.size;
                horizontal-stretch: 0;
                text: @tr("THE LENS DB");
                vertical-alignment: center;
                font-family: Type.family;
                font-weight: Type.bold;
                font-size: root.word-size;
                letter-spacing: KitStyle.tracking;
                color: Colour.ink;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The app's logo over the mark, a light × between them, each centred: the two projects as equals; a click on
// the mark opens its site.
export component TldbPair inherits VerticalLayout {
    callback clicked();
    spacing: Space.xs;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Image {
            height: KitStyle.pair-logo;
            source: Icons.oni-logo;
            colorize: Colour.ink;
            accessible-role: image;
            accessible-label: @tr("ONI");
        }
    }
    Text {
        text: "×";
        horizontal-alignment: center;
        font-family: Type.family;
        font-size: KitStyle.times-size;
        font-weight: KitStyle.times-weight;
        color: Colour.ink-tertiary;
    }
    HorizontalLayout {
        alignment: center;
        TldbMark { size: KitStyle.pair-height; word-size: KitStyle.pair-word; clicked => { root.clicked(); } }
    }
}

// The mark's disc alone, beside a name The Lens DB gives, so it reads apart from a name typed by hand.
export component TldbDisc inherits Rectangle {
    in property <length> size: KitStyle.disc;
    width: root.size;
    height: root.size;
    accessible-role: image;
    accessible-label: @tr("From The Lens DB");
    Icon { width: parent.width; height: parent.height; source: Icons.tldb-disc; ink: Colour.ink-secondary; }
    Icon { width: parent.width; height: parent.height; source: Icons.tldb-blades; ink: Colour.ground; }
}
