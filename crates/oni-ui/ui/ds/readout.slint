// `DSReadout`, a slider's name and value above its rail.
import { Space, State, SliderStyle, FieldStyle } from "theme.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { FieldFace, RenameField } from "fields.slint";

// A readout as Rust reads it. `steps`: from the readout to a number typed over it, `per` readout units
// a step or, at 0, one unit of its last digit, 0 when either holds no number; `unit`: what follows its last digit.
export global Readouts {
    pure callback steps(readout: string, typed: string, per: float) -> int;
    pure callback unit(readout: string) -> string;
}

// `DSReadout`: the name, the value right in the secondary ink, both faded when off; a double click on the
// name rests it (`resets`, `help` its tip), a click on the value types a number over it (`typeable`).
export component ValueHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> resets;
    in property <string> help;
    in property <bool> typeable;
    // The hand on the slider: the value in the primary ink.
    in property <bool> lit;
    property <bool> typing;
    property <bool> hovered: entry.has-hover && entry.enabled;
    callback reset();
    callback typed(string);
    spacing: Space.s;
    opacity: root.enabled ? 1 : State.disabled;
    Label {
        text: root.label;
        overflow: elide;
        horizontal-stretch: 1;
        if root.resets: TouchArea {
            enabled: root.enabled;
            double-clicked => { root.reset(); }
            changed has-hover => { Tips.hover(self.has-hover, root.help, self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    // The value is a field: the box the number is typed in, run a padding past it, is the target, a field
    // tall, and shows its face and a text cursor under the hand; out of the row, so the slider never moves.
    Rectangle {
        // The unit stands in a column of its own, so the digits end at one edge from row to row; Slint
        // measures an empty text a few pixels wide, so no unit is no width.
        property <length> unit: suffix.text == "" ? 0px : suffix.preferred-width;
        horizontal-stretch: 0;
        min-width: self.preferred-width;
        preferred-width: shown.preferred-width - self.unit + SliderStyle.unit;
        suffix := Label {
            visible: false;
            text: Readouts.unit(root.value);
            role: TextRole.value;
            accessible-role: none;
        }
        face := FieldFace {
            x: parent.width + Space.s - self.width;
            y: (parent.height - self.height) / 2;
            width: SliderStyle.entry;
            height: FieldStyle.height;
            visible: root.hovered;
        }
        shown := Label {
            x: parent.width - SliderStyle.unit + parent.unit - self.width;
            width: self.preferred-width;
            height: parent.height;
            text: root.value;
            role: TextRole.value;
            tone: root.lit || root.typing || root.hovered ? Tone.primary : Tone.secondary;
        }
        entry := TouchArea {
            x: face.x;
            y: face.y;
            width: face.width;
            height: face.height;
            enabled: root.typeable && root.enabled && !root.typing;
            mouse-cursor: MouseCursor.text;
            clicked => { root.typing = true; }
            changed has-hover => { Tips.hover(self.has-hover && self.enabled, @tr("Click to type a value"), self.absolute-position.x, self.absolute-position.y + self.height); }
        }
        // Escape gives the value back.
        if root.typing: RenameField {
            x: face.x;
            y: face.y;
            width: face.width;
            height: face.height;
            text: root.value;
            committed(t) => { root.typing = false; root.typed(t); }
            cancelled => { root.typing = false; root.typed(root.value); }
        }
    }
}
