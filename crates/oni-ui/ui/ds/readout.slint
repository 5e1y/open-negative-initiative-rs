// `DSReadout`, a slider's name and value above its rail.
import { Space, State, SliderStyle, FieldStyle } from "theme.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { RenameField } from "fields.slint";

// `DSReadout`: the name, the value right in the secondary ink, both faded when off; a double click on the
// name rests it (`resets`, `help` its tip), on the value opens a number typed over it (`typeable`).
export component ValueHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> resets;
    in property <string> help;
    in property <bool> typeable;
    // The hand on the slider: the value in the primary ink.
    in property <bool> lit;
    property <bool> typing;
    callback reset();
    callback typed(string);
    spacing: Space.s;
    opacity: root.enabled ? 1 : State.disabled;
    Label {
        text: root.label;
        overflow: elide;
        horizontal-stretch: 1;
        if root.resets: TouchArea {
            enabled: root.enabled;
            double-clicked => { root.reset(); }
            changed has-hover => { Tips.hover(self.has-hover, root.help, self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    Label {
        text: root.value;
        role: TextRole.value;
        tone: root.lit || root.typing ? Tone.primary : Tone.secondary;
        horizontal-alignment: right;
        if root.typeable: TouchArea {
            enabled: root.enabled && !root.typing;
            double-clicked => { root.typing = true; }
            changed has-hover => { Tips.hover(self.has-hover, @tr("Double-click to type a value"), self.absolute-position.x, self.absolute-position.y + self.height); }
        }
        // Over the value, out of the row's layout so the slider never moves; Escape gives the value back.
        if root.typing: RenameField {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: SliderStyle.entry;
            height: FieldStyle.height;
            text: root.value;
            committed(t) => { root.typing = false; root.typed(t); }
            cancelled => { root.typing = false; root.typed(root.value); }
        }
    }
}
