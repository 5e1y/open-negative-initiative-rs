// `DSReadout`, a slider's name and value above its rail.
import { Space, State, SliderStyle, FieldStyle, ButtonStyle } from "theme.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { FieldFace, RenameField } from "fields.slint";
import { Button, ButtonSize } from "button.slint";
import { Icons } from "icons.slint";

// A readout as Rust reads it. `steps`: from the readout to a number typed over it, `per` readout units
// a step or, at 0, one unit of its last digit, 0 when either holds no number; `number`: the figure alone.
export global Readouts {
    pure callback steps(readout: string, typed: string, per: float) -> int;
    pure callback number(readout: string) -> string;
}

// `DSReadout`: the name, the value right in the secondary ink, both faded when off; a double click on the
// name rests it (`resets`, `help` its tip). The value is a field (`typeable`): a click types its figure
// alone over it, a minus and a plus beside it stepping one shown unit a press while the hand stays.
export component ValueHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> resets;
    in property <string> help;
    in property <bool> typeable;
    // The hand on the slider: the value in the primary ink.
    in property <bool> lit;
    property <bool> typing;
    // Typed over once, the keys stay beside the field until the hand leaves it.
    property <bool> engaged;
    property <bool> live: root.typeable && root.enabled;
    property <bool> hovered: zone.has-hover && root.live;
    property <bool> stepping: root.live && (root.typing || (root.engaged && zone.has-hover));
    callback reset();
    callback typed(string);
    // One shown unit up or down.
    callback stepped(int);
    spacing: Space.s;
    opacity: root.enabled ? 1 : State.disabled;
    Label {
        text: root.label;
        overflow: elide;
        horizontal-stretch: 1;
        if root.resets: TouchArea {
            enabled: root.enabled;
            double-clicked => { root.reset(); }
            changed has-hover => { Tips.hover(self.has-hover, root.help, self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    // Every readout ends on one edge, its unit with it, in Inter's tabular figures; its field and keys
    // stand out of the row, run a padding past that edge, so the slider never moves.
    Rectangle {
        horizontal-stretch: 0;
        min-width: self.preferred-width;
        preferred-width: shown.preferred-width;
        shown := Label {
            x: parent.width - self.width;
            width: self.preferred-width;
            height: parent.height;
            visible: !root.typing;
            text: root.value;
            role: TextRole.value;
            tone: root.lit || root.hovered ? Tone.primary : Tone.secondary;
        }
        zone := TouchArea {
            x: parent.width + Space.s - self.width;
            y: (parent.height - self.height) / 2;
            width: line.preferred-width;
            height: ButtonStyle.small-height;
            enabled: root.live;
            changed has-hover => { if (!self.has-hover && !root.typing) { root.engaged = false; } }
            line := HorizontalLayout {
                spacing: Space.xs;
                if root.stepping: HorizontalLayout {
                    // The hand's: the slider's arrows already step it under the keyboard.
                    Button { size: ButtonSize.mini; square: true; tabbed: false; has-icon: true; icon: Icons.zoom-out; help: @tr("One step lower"); clicked => { root.stepped(-1); } }
                    Button { size: ButtonSize.mini; square: true; tabbed: false; has-icon: true; icon: Icons.zoom-in; help: @tr("One step higher"); clicked => { root.stepped(1); } }
                }
                // The target: the words run a padding either side, a small key tall.
                Rectangle {
                    width: shown.preferred-width + 2 * FieldStyle.across;
                    if root.hovered || root.typing: FieldFace { width: parent.width; height: parent.height; }
                    entry := TouchArea {
                        enabled: !root.typing;
                        mouse-cursor: MouseCursor.text;
                        clicked => { root.typing = true; root.engaged = true; }
                        changed has-hover => { Tips.hover(self.has-hover && self.enabled, @tr("Click to type a value"), self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                    // The figure alone, its sign kept; Escape gives the value back.
                    if root.typing: RenameField {
                        width: parent.width;
                        height: parent.height;
                        line-height: ButtonStyle.small-height;
                        text: Readouts.number(root.value);
                        committed(t) => { root.typing = false; root.typed(t); }
                        cancelled => { root.typing = false; root.typed(root.value); }
                    }
                }
            }
        }
    }
}
