// `DSReadout`, a slider's name and value above its rail.
import { Space, State, SliderStyle, ButtonStyle } from "theme.slint";
import { Label, TextRole, Tone, Tips } from "base.slint";
import { FieldFace, Entry } from "fields.slint";
import { Button, ButtonKind, ButtonSize } from "button.slint";
import { Icons } from "icons.slint";
import { Outside } from "outside.slint";

// A readout as Rust reads it. `steps`: from the readout to a number typed over it, `per` readout units
// a step or, at 0, one unit of its last digit, 0 when either holds no number; `number`: the figure alone.
export global Readouts {
    pure callback steps(readout: string, typed: string, per: float) -> int;
    pure callback number(readout: string) -> string;
}

// The value edited on one face: its figure alone between a minus and a plus, each a step of one shown
// unit; a click on the figure types over it, Return or a press elsewhere handing it over, Escape nothing.
component StepField inherits FieldFace {
    in property <string> text;
    in property <string> name;
    callback committed(string);
    callback stepped(int);
    callback editing(bool);
    // The entry stands only while typed in, so Tab never stops on a face the hand merely passes.
    property <bool> entering;
    changed entering => { root.editing(self.entering); }
    function hand(t: string) {
        if (root.entering) {
            root.entering = false;
            root.committed(t);
        }
    }
    width: 2 * ButtonStyle.small-height + SliderStyle.figure;
    height: ButtonStyle.small-height;
    lit: root.entering;
    HorizontalLayout {
        // The hand's: the slider's arrows already step it under the keyboard.
        Button { kind: ButtonKind.ghost; size: ButtonSize.mini; square: true; tabbed: false; has-icon: true; icon: Icons.zoom-out; help: @tr("One step lower"); clicked => { root.stepped(-1); } }
        Rectangle {
            horizontal-stretch: 1;
            if !root.entering: Label { width: parent.width; height: parent.height; text: root.text; role: TextRole.value; tone: Tone.primary; centred: true; }
            if !root.entering: TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { root.entering = true; }
                changed has-hover => { Tips.hover(self.has-hover, @tr("Click to type a value"), self.absolute-position.x, self.absolute-position.y + self.height); }
            }
            if root.entering: FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.entering = false;
                        Outside.released += 1;
                        return accept;
                    }
                    reject
                }
                Entry {
                    text: root.text;
                    centred: true;
                    role: TextRole.value;
                    name: root.name;
                    init => { self.enter(); }
                    accepted(t) => { root.hand(t); }
                    left(t) => { root.hand(t); }
                }
            }
        }
        Button { kind: ButtonKind.ghost; size: ButtonSize.mini; square: true; tabbed: false; has-icon: true; icon: Icons.zoom-in; help: @tr("One step higher"); clicked => { root.stepped(1); } }
    }
}

// `DSReadout`: the name, the value right in the secondary ink, both faded when off; a double click on the
// name rests it (`resets`, `help` its tip). Under the hand the value opens on one face (`typeable`).
export component ValueHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> resets;
    in property <string> help;
    in property <bool> typeable;
    // The hand on the slider: the value in the primary ink.
    in property <bool> lit;
    property <bool> typing;
    property <bool> live: root.typeable && root.enabled;
    property <bool> open: root.live && (zone.has-hover || root.typing);
    callback reset();
    callback typed(string);
    // One shown unit up or down.
    callback stepped(int);
    spacing: Space.s;
    opacity: root.enabled ? 1 : State.disabled;
    Label {
        text: root.label;
        overflow: elide;
        horizontal-stretch: 1;
        if root.resets: TouchArea {
            enabled: root.enabled;
            double-clicked => { root.reset(); }
            changed has-hover => { Tips.hover(self.has-hover, root.help, self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    // Every readout ends on one edge, its unit with it, in Inter's tabular figures; its face, a small key
    // tall, ends on that edge too, laid over the row so the slider never moves.
    Rectangle {
        horizontal-stretch: 0;
        min-width: self.preferred-width;
        preferred-width: shown.preferred-width;
        shown := Label {
            x: parent.width - self.width;
            width: self.preferred-width;
            height: parent.height;
            visible: !root.open;
            text: root.value;
            role: TextRole.value;
            tone: root.lit ? Tone.primary : Tone.secondary;
        }
        zone := TouchArea {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 2 * ButtonStyle.small-height + SliderStyle.figure;
            height: ButtonStyle.small-height;
            enabled: root.live;
            if root.open: StepField {
                text: Readouts.number(root.value);
                name: root.label;
                editing(on) => { root.typing = on; }
                committed(t) => { root.typed(t); }
                stepped(by) => { root.stepped(by); }
            }
        }
    }
}
