// The year on film's way in from the gallery, through December and January: the year struck on a
// holographic seal, a line beside it, the whole a flat key under the hand. A click shows the year.
import { Space, Radius, ButtonStyle, RowStyle } from "theme.slint";
import { Label, TextRole, Icon, Tone } from "base.slint";
import { Icons } from "icons.slint";
import { Badge, BadgeTone, Metal } from "badge.slint";

export component YearEntry inherits Rectangle {
    in property <string> year;
    in property <string> text;
    callback clicked();
    height: RowStyle.height;
    border-radius: Radius.control;
    background: touch.pressed ? ButtonStyle.veil-pressed : touch.has-hover ? ButtonStyle.veil : transparent;
    HorizontalLayout {
        padding-left: RowStyle.padding;
        padding-right: RowStyle.padding;
        spacing: Space.s;
        VerticalLayout {
            alignment: center;
            Badge {
                tone: BadgeTone.seal;
                metal: Metal.holographic;
                text: root.year;
                glinting: touch.has-hover;
            }
        }
        Label {
            horizontal-stretch: 1;
            role: TextRole.section;
            text: root.text;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: RowStyle.chevron;
                height: RowStyle.chevron;
                source: Icons.chevron-right;
                tone: Tone.secondary;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}
