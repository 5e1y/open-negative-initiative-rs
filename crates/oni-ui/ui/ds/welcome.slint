// The welcome's card: a stage on the left for the page's photo or film, the words on the right, and
// the dots that say which page shows and take a click to another.
import { DS } from "tokens.slint";
import { Colour, Motion, Space } from "theme.slint";

export global WelcomeStyle {
    // The stage beside a column of words as tall as it, so the card fits the smallest window whole; 502
    // tall, a film's crop holds the bar and ends in the free band under Tint's knob.
    out property <length> stage-width: DS.control-dialog-wide-width;
    out property <length> stage-height: DS.control-welcome-stage-height;
    out property <length> words-width: DS.control-welcome-words-width;
    out property <length> card-width: root.stage-width + root.words-width;
    out property <length> card-height: root.stage-height;
    // Narrower than this, the stage would show too little of its picture: the words take the card.
    out property <length> stage-least: 160px;
    out property <length> dot: 6px;
    out property <length> dot-shown: 16px;
    out property <color> dot-idle: Colour.ink.with-alpha(0.3);
    out property <color> dot-hover: Colour.ink.with-alpha(0.7);
    // A dot's touch, the hand's least target around a dot drawn small.
    out property <length> dot-reach: DS.control-grab-size;
}

// The stage: the picture on the canvas's ground, cropped to the room the card gives it.
export component SceneFrame inherits Rectangle {
    background: Colour.canvas;
    clip: true;
}

// One dot a page, the shown one lit; a click on a dot shows its page. Each is named by its place among
// the sheet's `count`, the shown one selected, so assistive technology reads where the reader stands.
export component PageDots inherits HorizontalLayout {
    in property <int> count;
    in property <int> at;
    callback picked(int);
    alignment: center;
    for page in root.count: TouchArea {
        width: WelcomeStyle.dot-reach;
        height: WelcomeStyle.dot-reach;
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: @tr("Page {} of {}", page + 1, root.count);
        accessible-item-selectable: true;
        accessible-item-selected: page == root.at;
        accessible-item-index: page;
        accessible-item-count: root.count;
        accessible-action-default => { root.picked(page); }
        clicked => { root.picked(page); }
        // The shown page's dot runs long and whole; the others stay faint until the hand comes on one.
        Rectangle {
            width: page == root.at ? WelcomeStyle.dot-shown : WelcomeStyle.dot;
            height: WelcomeStyle.dot;
            border-radius: self.height / 2;
            background: page == root.at ? Colour.ink : parent.has-hover ? WelcomeStyle.dot-hover : WelcomeStyle.dot-idle;
            animate width { duration: Motion.quick; easing: ease-out; }
            animate background { duration: Motion.quick; }
        }
    }
}

// The dots laid on the stage, centred at its foot on a veil that keeps them read over any picture.
export component StageDots inherits Rectangle {
    in property <int> count;
    in property <int> at;
    callback picked(int);
    width: dots.preferred-width + 2 * Space.xs;
    height: WelcomeStyle.dot-reach;
    border-radius: self.height / 2;
    background: Colour.overlay;
    dots := PageDots {
        x: Space.xs;
        width: self.preferred-width;
        count: root.count;
        at: root.at;
        picked(page) => { root.picked(page); }
    }
}
