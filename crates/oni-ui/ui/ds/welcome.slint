// The welcome's pages: the stage every page's picture or scene fills, the clock its scenes loop on,
// and the dots that say which page shows and take a click to another.
import { DS } from "tokens.slint";
import { Colour, Space, Motion, Type } from "theme.slint";
import { SplashStyle } from "splash.slint";
import { Dot } from "marks.slint";

export global WelcomeStyle {
    // The scene fills the wide sheet edge to edge at the version photo's 3:2, so no page moves the card.
    out property <length> scene-width: DS.control-dialog-wide-width;
    out property <length> scene-height: DS.control-dialog-wide-width / SplashStyle.welcome-aspect;
    // The words under the scene; a page longer than this scrolls inside it, the card never grows.
    out property <length> words-height: 340px;
    out property <length> dot: 6px;
    out property <length> dot-reach: 16px;
}

// A moment every scene holds while `held` is 0 to 1, so a check or the lab looks at one step of it.
export global SceneClock {
    in-out property <float> held: -1;
}

// A scene's clock: `t` runs from 0 to 1 over `period` from the moment the scene shows, then again;
// under Reduce Motion it rests at `rest`, the scene's last state, so the page still says it all.
export component Cycle {
    in property <duration> period;
    in property <float> rest: 1;
    // The still dissolve from the last state back to the first that opens every turn but the first.
    in property <duration> rewind-time: 450ms;
    property <duration> start;
    init => { root.start = animation-tick(); }
    property <bool> held: SceneClock.held >= 0;
    out property <float> t: root.held ? SceneClock.held : Motion.reduced ? root.rest : Math.mod((animation-tick() - root.start) / root.period, 1);
    // The first turn opens on the first state, so a page never shows its ending before its story.
    out property <bool> first: !root.held && !Motion.reduced && animation-tick() - root.start < root.period;
    // 1 on the last state, falling to 0 over the rewind; a step's progress is max(its own, rewind).
    property <float> r: max(0, min(1, root.t * root.period / root.rewind-time));
    out property <float> rewind: root.first ? 0 : 1 - root.r * root.r * (3 - 2 * root.r);
    width: 0px;
    height: 0px;
}

// The scenes' curves on a progress `p` 0 to 1: `ease` starts and ends at rest, `arrive` lands (ease-out),
// `leave` departs (ease-in), `land` lands a small mark with a 3.7 % overshoot, never text or layout.
export global Easing {
    public pure function ease(p: float) -> float { p * p * (3 - 2 * p) }
    public pure function arrive(p: float) -> float { 1 - (1 - p) * (1 - p) * (1 - p) }
    public pure function leave(p: float) -> float { p * p * p }
    public pure function land(p: float) -> float { 1 + 2 * (p - 1) * (p - 1) * (p - 1) + (p - 1) * (p - 1) }
}

// A stretch of a cycle, `t` from `from` to `to` as `p`, 0 before and 1 after, under `Easing`'s curves.
export component Phase {
    in property <float> t;
    in property <float> from;
    in property <float> to;
    out property <float> p: max(0, min(1, (root.t - root.from) / (root.to - root.from)));
    out property <float> ease: Easing.ease(root.p);
    out property <float> v: root.ease;
    out property <float> arrive: Easing.arrive(root.p);
    out property <float> leave: Easing.leave(root.p);
    out property <float> land: Easing.land(root.p);
    width: 0px;
    height: 0px;
}

// A count in two fixed cells, right-aligned, so a step never shifts it; `centred` moves a lone figure
// half a cell left so it keeps its label's axis, `blank-zero` shows nothing before the first.
export component Figures inherits Rectangle {
    in property <int> n;
    in property <length> cell;
    in property <length> size;
    in property <int> weight: Type.strong;
    in property <color> ink: Colour.ink;
    in property <bool> centred;
    in property <bool> blank-zero;
    in property <float> scale: 1;
    width: 2 * root.cell;
    for k in 2: Text {
        x: k * root.cell - (root.centred && root.n < 10 ? root.cell / 2 : 0px);
        width: root.cell;
        height: root.height;
        transform-scale-x: root.scale;
        transform-scale-y: root.scale;
        transform-origin: { x: root.width / 2 - self.x, y: self.height / 2 };
        horizontal-alignment: right;
        vertical-alignment: center;
        font-family: Type.family;
        font-size: root.size;
        font-weight: root.weight;
        color: root.ink;
        text: k == 0 ? (root.n >= 10 ? Math.floor(root.n / 10) : "") : (root.blank-zero && root.n == 0 ? "" : mod(root.n, 10));
    }
}

// The stage under every page's words: the scene drawn on the canvas's ground, cut at its edge.
export component SceneFrame inherits Rectangle {
    width: WelcomeStyle.scene-width;
    height: WelcomeStyle.scene-height;
    background: Colour.canvas;
    clip: true;
}

// One dot a page, the shown one lit; a click on a dot shows its page.
export component PageDots inherits HorizontalLayout {
    in property <int> count;
    in property <int> at;
    callback picked(int);
    alignment: center;
    for page in root.count: TouchArea {
        width: WelcomeStyle.dot-reach;
        height: WelcomeStyle.dot-reach;
        mouse-cursor: pointer;
        clicked => { root.picked(page); }
        Dot {
            size: WelcomeStyle.dot;
            ink: page == root.at ? Colour.ink : Colour.ink-tertiary;
            animate background { duration: Motion.quick; }
        }
    }
}
