// The semantic tokens: what each value is for, bound to the generated Swift tokens wherever one exists.
// One edit here restyles every component that reads the group; screens never read `DS` directly.
import { DS } from "tokens.slint";
export { DS }

// Surfaces from back to front, then inks, then the meaning colours.
export global Colour {
    out property <color> ground: DS.palette-panel;
    out property <color> canvas: DS.palette-canvas;
    out property <color> well: DS.palette-tile;
    out property <color> raised: DS.palette-keycap;
    out property <color> raised-hover: DS.palette-keycap.brighter(0.25);
    out property <color> raised-pressed: DS.palette-keycap.darker(0.25);
    out property <color> ink: DS.system-primary;
    out property <color> ink-secondary: DS.palette-text-secondary;
    out property <color> ink-tertiary: DS.palette-text-tertiary;
    out property <color> ink-on-fill: DS.palette-text-on-fill;
    out property <color> ink-on-light: DS.palette-text-on-light;
    out property <color> warning: DS.palette-warning;
    out property <color> warning-surface: DS.palette-warning-surface;
    out property <color> ink-on-warning: DS.palette-text-on-warning;
    // `DSWarning`'s band, under the on-warning ink.
    out property <color> warning-soft: DS.palette-warning-soft;
    out property <color> accent: DS.palette-accent;
    out property <color> accent-hover: DS.palette-accent.brighter(0.15);
    out property <color> accent-pressed: DS.palette-accent.darker(0.2);
    out property <color> on: DS.system-primary;
    out property <color> on-hover: DS.system-white;
    out property <color> caution: DS.tint-undoable;
    out property <color> caution-hover: DS.tint-undoable.brighter(0.15);
    out property <color> caution-pressed: DS.tint-undoable.darker(0.2);
    out property <color> destructive: DS.tint-destructive;
    out property <color> destructive-hover: DS.tint-destructive.brighter(0.15);
    out property <color> destructive-pressed: DS.tint-destructive.darker(0.2);
    out property <color> confirm: DS.tint-confirm;
    out property <color> confirm-hover: DS.tint-confirm.brighter(0.15);
    out property <color> confirm-pressed: DS.tint-confirm.darker(0.2);
    // `DS.Tint.update`: the export slot's face while an update waits.
    out property <color> update: DS.tint-update;
    out property <color> update-hover: DS.tint-update.brighter(0.15);
    out property <color> update-pressed: DS.tint-update.darker(0.2);
    out property <color> separator: DS.palette-separator;
    out property <color> guide: DS.palette-guide;
    out property <color> guide-faint: DS.palette-guide-faint;
    out property <color> handle-idle: DS.palette-handle-idle;
    out property <color> scrim: DS.palette-scrim;
    out property <color> canvas-cropping: DS.palette-canvas-cropping;
    out property <color> unaligned-balance: DS.tint-unaligned-balance;
    out property <color> contrast-edge-idle: DS.palette-contrast-edge-idle;
    out property <color> sharpen: DS.tint-sharpen;
    // `NegativeView`'s live stroke: red at 55 %, the one colour the canvas paints with.
    out property <color> stroke-live: #ff00008c;
    out property <color> handle-active: DS.palette-handle-active;
    out property <color> contrast-edge: DS.palette-contrast-edge;
    out property <color> hover: DS.palette-hover;
    out property <color> row-selected: DS.palette-track;
    out property <color> selected: DS.palette-selected;
    out property <color> focus: DS.palette-accent;
    out property <color> track: DS.palette-track;
    out property <color> track-fill: DS.palette-track-fill;
    out property <color> skeleton: DS.palette-skeleton;
    out property <color> paper: DS.system-white;
    out property <color> white: DS.system-white;
    out property <color> black: DS.system-black;
    out property <color> metal-dark: DS.scanner-metal-dark;
    out property <color> metal-light: DS.scanner-metal-light;
    // `GainChannel`'s hues and complements: the sensor's own channels, no Swift token holds them.
    out property <color> channel-red: #ff453a;
    out property <color> channel-cyan: #64d2ff;
    out property <color> channel-blue: #0a84ff;
    out property <color> channel-yellow: #ffd60a;
    out property <color> channel-green: #30d158;
    out property <color> channel-magenta: #ff00ff;
    // `DSMedalPicker`'s three foils as flat colours, index 0 being no medal.
    out property <[color]> medal: [transparent, #b08d57, #c0c0c0, #e6c200];
    // The system tooltip's ground, opaque enough to read over a photo.
    out property <color> tip: #2c2c2cf2;
    // AppKit's overlay scroller knob on a dark panel.
    out property <color> knob: DS.palette-marker;
}

export global Space {
    out property <length> xxs: DS.space-xxs;
    out property <length> xs: DS.space-xs;
    out property <length> s: DS.space-sm;
    out property <length> m: DS.space-md;
    out property <length> l: DS.space-lg;
}

// The four radius tokens `DSShape.rounded` allows, by what they round.
export global Radius {
    out property <length> track: DS.radius-track;
    out property <length> badge: DS.radius-badge;
    out property <length> card: DS.radius-card;
    out property <length> control: DS.radius-control;
}

export global Stroke {
    out property <length> hairline: DS.stroke-hairline;
    out property <length> line: DS.stroke-line;
    out property <length> emphasis: DS.stroke-emphasis;
    out property <length> trace: DS.stroke-trace;
}

export global Type {
    out property <string> family: DS.typo-label-family;
    out property <string> brand-family: DS.typo-box-title-family;
    out property <int> regular: DS.typo-label-weight;
    out property <int> medium: 500;
    out property <int> strong: 600;
    out property <length> label: DS.typo-label-size;
    out property <length> value: DS.typo-value-size;
    out property <length> chip: DS.typo-chip-size;
    out property <length> title: DS.typo-title-size;
    out property <length> section: DS.typo-section-size;
    out property <length> heading: DS.typo-box-title-size;
}

// Opacities of a state, never of a colour.
export global State {
    out property <float> disabled: DS.state-missing;
    out property <float> idle: DS.state-idle-label;
}

export global Motion {
    out property <duration> quick: DS.motion-curtain-duration;
    out property <duration> slide: DS.motion-reveal-response * 1s;
    // The system tooltip's delay before it shows.
    out property <duration> tip-delay: 1000ms;
}

// The overlay scroller AppKit draws for every Swift scroll view: a knob over the edge, no gutter.
export global ScrollStyle {
    out property <length> knob: 6px;
    out property <length> inset: 3px;
    out property <length> knob-min: 24px;
    // The knob under the pointer or held, over its track, as AppKit's expanded overlay scroller.
    out property <length> knob-wide: 10px;
    out property <color> track: Colour.hover;
    // The edge strip that lights the knob and takes its press: `NSScroller.scrollerWidth`, 17 pt.
    out property <length> reach: 17px;
    // `NSScrollView.verticalPageScroll`: what a page jump keeps of the page it leaves.
    out property <length> page-keep: 10px;
    // `NSCell.getPeriodicDelay`: a press held on the track pages again after 0.4 s, then every 75 ms.
    out property <duration> repeat-delay: 400ms;
    out property <duration> repeat: 75ms;
    // Layout rounding leaves a fraction of a pixel of travel: below one, nothing overflows.
    out property <length> slack: 1px;
    out property <duration> linger: 800ms;
    out property <duration> fade: 250ms;
}

export global ButtonStyle {
    out property <length> height: DS.control-field-height;
    out property <length> small-height: DS.control-icon-button-size;
    out property <length> mini-height: DS.control-keycap-mini-height;
    out property <length> radius: Radius.badge;
    out property <length> small-radius: Radius.track;
    out property <length> padding: Space.m;
    out property <length> small-padding: Space.s;
    out property <length> group-gap: Space.xxs;
    // `KeycapPlate`'s socket: the base keys sit flush on, a hairline showing between them.
    out property <color> socket: DS.palette-tile;
    out property <length> plate-inset: Stroke.hairline;
    out property <length> icon: DS.control-icon-size;
    out property <length> small-icon: DS.control-toggle-glyph;
    out property <length> label: Type.chip;
    out property <int> weight: Type.strong;
    out property <length> tracking: Stroke.hairline;
    out property <length> lamp: DS.control-lamp-size;
}

export global SliderStyle {
    out property <length> row: DS.control-handle-length;
    out property <length> track: DS.control-track-height;
    out property <length> track-radius: Radius.track;
    out property <length> knob-width: DS.control-handle-thickness;
    out property <length> knob-height: DS.control-handle-length;
    out property <length> knob-radius: Radius.badge;
    out property <float> knob-grow: DS.control-knob-grow;
    out property <length> grip: DS.control-knob-line * 1px;
    out property <length> grip-gap: DS.control-knob-line-gap * 1px;
    out property <color> knob: Colour.raised-hover;
    out property <color> knob-edge: DS.palette-track-line;
    out property <color> grip-ink: Colour.ink-secondary;
    out property <float> ramp-start: 0.45;
    out property <float> ramp-end: 0.9;
    out property <length> label-gap: Space.xs;
}

export global SectionStyle {
    out property <length> inset: Space.m;
    // In a sheet, flush with its title and keys, closer under the title.
    out property <length> flush: 0px;
    out property <length> sheet-before: Space.m;
    out property <length> before: Space.l;
    out property <length> after: Space.l;
    out property <length> gap: Space.s;
    out property <length> help-mark: DS.control-help-mark-size;
}

export global TabsStyle {
    out property <length> height: ButtonStyle.height;
    out property <length> radius: ButtonStyle.radius;
    out property <length> inset: Space.xxs;
    out property <length> pill-radius: Radius.track;
    out property <length> mark: Space.xs;
    out property <length> swatch: DS.control-handle-size;
}

export global ToggleStyle {
    out property <length> height: DS.control-toggle-height;
    out property <length> width: 2 * DS.control-toggle-cell-width - Space.s;
    out property <length> inset: Space.xxs;
}

export global FieldStyle {
    out property <length> height: DS.control-field-height;
    out property <length> radius: ButtonStyle.radius;
    out property <length> padding: Space.s;
}

export global RowStyle {
    out property <length> height: DS.control-film-sidebar-row-height;
    out property <length> padding: Space.s;
    out property <length> indent: Space.m;
    out property <length> gap: Space.xs;
    out property <length> chevron-zone: DS.control-film-sidebar-chevron-zone-width;
    out property <length> chevron: DS.control-toggle-glyph;
    out property <length> icon: DS.control-icon-size;
    // One slot sized to the stock's mini canister, so a glyph and a canister share a starting edge.
    out property <length> slot: DS.control-film-sidebar-stock-icon-size;
}

export global TileStyle {
    out property <length> caption: DS.control-caption-height;
    out property <length> caption-gap: Space.xxs;
    out property <length> medal: DS.control-medal-size;
    // `Space.sm` in from the corners, as `TileLayers` sets the medal and the seal.
    out property <length> badge-inset: Space.s;
    out property <length> selection: Stroke.emphasis;
    out property <length> heading: DS.control-roll-header-height;
}

export global SheetStyle {
    out property <length> width: DS.control-dialog-width;
    out property <length> wide-width: DS.control-dialog-wide-width;
    out property <length> radius: Radius.card;
    out property <length> padding: Space.l;
    out property <length> gap: Space.m;
    // Room a sheet leaves above and below it in the window.
    out property <length> margin: Space.l;
    // `noticeWidth` and `exportPanelWidth`: the notices' and the catch-up's gauges.
    out property <length> notice-width: DS.control-notice-width;
    out property <length> panel-width: DS.control-export-panel-width;
    // The card's lift off the window, with no scrim under it.
    out property <length> shadow: Space.l;
    // The pairing code's side, wide enough for a phone's camera across a desk.
    out property <length> code: 240px;
    // The Settings sheet: its sections' rail beside the page, the page tall enough for the longest.
    out property <length> settings-width: 640px;
    out property <length> settings-rail: 160px;
    out property <length> settings-height: 320px;
}

export global MenuStyle {
    out property <length> width: DS.control-export-fields-width;
    out property <length> row: ButtonStyle.height;
    out property <length> radius: Radius.badge;
    out property <length> padding: Space.xs;
}

export global TipStyle {
    out property <length> radius: Radius.badge / 2;
    out property <length> padding-x: Space.s;
    out property <length> padding-y: Space.xs;
    out property <length> offset: Space.xs;
    out property <length> max-width: 320px;
    // A help mark's card: a 4:3 clip over its note.
    out property <length> card-width: 260px;
    out property <length> card-padding: Space.s;
    out property <length> card-radius: Radius.badge;
}

export global PlotStyle {
    out property <length> main: DS.control-main-histogram-height;
    out property <length> block: DS.control-histogram-height;
}

export global CardStyle {
    out property <length> inset: DS.control-card-inset;
    out property <length> radius: Radius.card;
    out property <length> padding: DS.control-canvas-padding;
}

// `FrameOverlay`'s brackets, edge bars and the halo under them, clamped by the frame shown.
export global CropStyle {
    out property <length> corner: DS.control-crop-corner;
    out property <length> edge: DS.control-crop-edge;
    out property <length> stroke: DS.control-crop-stroke;
    out property <length> halo: DS.control-crop-halo;
    out property <length> hairline: Stroke.hairline;
    out property <length> well-radius: Radius.control;
    // A De-dust reminder's side in the tab.
    out property <length> dust-original: 56px;
}

// Compare's split guide: a grab the width of a handle, a line that grows under the hand.
export global SplitStyle {
    out property <length> grab: DS.control-grab-size;
    out property <length> grow: DS.control-guide-grow;
    out property <length> label-inset: DS.control-split-label-inset;
    out property <length> shadow: 2px;
}

export global StatusStyle {
    out property <length> height: DS.control-status-row-height;
}

// The window's frame: its floor, the bar and the three columns.
export global ShellStyle {
    out property <length> min-width: DS.control-min-window-width;
    out property <length> min-height: DS.control-min-window-height;
    out property <length> bar-padding: Space.s;
    out property <length> bar-gap: Space.m;
    out property <length> compact-gap: Space.s;
    out property <length> bar-height: ButtonStyle.height + 2 * Space.s;
    out property <length> export-width: DS.control-app-bar-export-width;
    out property <length> filter-width: DS.control-app-bar-filter-width;
    out property <length> library-width: DS.control-film-sidebar-width;
    out property <length> panel-width: DS.control-panel-width;
    out property <length> info-width: DS.control-info-sidebar-width;
    out property <length> info-description: DS.control-project-description-height;
}

// The editors' plots: their inks and the sizes they draw handles at.
export global PlotInkStyle {
    // `LevelsChannel.tint`'s red: the system red on the dark appearance, which no token holds.
    out property <color> channel-red: #ff453a;
    // `LevelsView.Grip.tint`: the three inner handles' greys, `Color(white:)` in the Swift view.
    out property <color> grey-quarter: #404040;
    out property <color> grey-half: #808080;
    out property <color> grey-three-quarters: #bfbfbf;
    // `SpectrogramPanel.tint`: each band's centre at saturation 0.85 and full brightness.
    out property <[color]> bands: [#ff2626, #ff9326, #ffff26, #26ff26, #26ffff, #2626ff, #9326ff, #ff26ff];
    out property <length> histogram: DS.control-histogram-height;
    out property <length> track: DS.control-track-height;
    out property <length> knob-width: DS.control-handle-thickness;
    out property <length> knob-height: DS.control-handle-length;
    out property <length> grab: DS.control-grab-size;
    out property <length> radius: Radius.card;
    out property <color> guide: DS.palette-guide;
    out property <color> guide-faint: DS.palette-guide-faint;
    out property <color> marker: DS.palette-marker;
    out property <color> handle-active: DS.palette-handle-active;
    out property <color> handle-idle: DS.palette-handle-idle;
}

// `DS.Scanner`: the Lab keypad's keys and bands, the face bar, the scanner's screen.
export global ScannerStyle {
    out property <length> face-bar: DS.control-mode-bar-width;
    out property <length> key-height: DS.scanner-key-height;
    out property <length> wide-key: DS.scanner-wide-key-width;
    out property <length> legend: DS.scanner-key-legend-size;
    out property <length> key-padding: DS.scanner-key-padding-h;
    out property <length> key-radius: Radius.track;
    out property <length> key-gap: Space.xxs;
    // `KeycapStyle.minHold`: the shortest time a cap stays down, or a tap plays a tenth of the press.
    out property <duration> key-hold: 140ms;
    out property <length> socket-radius: Radius.badge;
    out property <color> socket: DS.palette-tile;
    // `LabKeyboard.cap`'s two tones: the keycap's grey, and the canvas's dark.
    out property <color> cap-light: DS.palette-keycap;
    out property <color> cap-dark: DS.palette-canvas;
    out property <color> band-dark: DS.scanner-band-dark;
    out property <color> band-light: DS.scanner-band-light;
    out property <color> band-red: DS.scanner-band-red;
    out property <color> band-cyan: DS.scanner-band-cyan;
    out property <color> band-green: DS.scanner-band-green;
    out property <color> band-magenta: DS.scanner-band-magenta;
    out property <color> band-blue: DS.scanner-band-blue;
    out property <color> band-yellow: DS.scanner-band-yellow;
    out property <color> band-cool: DS.scanner-band-cool;
    out property <color> band-warm: DS.scanner-band-warm;
    // `LabKeyboard.band`: a fill this light in Rec. 709 luma takes the dark ink.
    out property <float> light-luma: 0.55;
    out property <color> glass: DS.palette-lcd-glass;
    out property <color> lcd-ink: DS.palette-lcd-ink;
    out property <length> screen-label: DS.scanner-screen-label-size;
    out property <length> screen-value: DS.scanner-screen-value-size;
    out property <length> scanline-pitch: DS.scanner-scanline-pitch;
    // `LabScreen`'s scanlines: black at 35 %.
    out property <color> scanline: #00000059;
    // The screen's face, the system's monospaced design.
    out property <string> mono: "monospace";
    out property <int> value-weight: 700;
    out property <int> label-weight: 500;
    // A slider's step keys, square beside its rail.
    out property <length> step-key: 24px;
}
