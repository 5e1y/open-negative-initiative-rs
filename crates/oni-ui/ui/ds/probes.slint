// Pieces at fixed places for the window checks that click or read them: fields and a tab bar, a scrolled
// page, a step keycap, a well's lip three ways, a plate, fields and pickers to press beside, a submenu,
// the keyboard's controls.
import { Space, FieldStyle, RowStyle, ShellStyle, SectionStyle, AppWindow, TextField, Tabs, Scroller, Row, Section, Label, TextRole, Tone, Button, ButtonSize, ButtonGroup, ButtonStyle, RenameField, KeyMonitor, Keyboard, Picker, DateFields, Menu, MenuLine, MenuState, MenuStyle, Slider, SliderStyle, Toggle, Sheet, Inset } from "ds.slint";

export component FieldProbe inherits AppWindow {
    in-out property <string> first <=> one.text;
    in-out property <string> second <=> two.text;
    in-out property <string> lines <=> three.text;
    // Where each field's box lies, so the check aims its clicks.
    out property <length> left: Space.l;
    // Where the words start, past the hollow's padding.
    out property <length> text-left: Space.l + FieldStyle.across;
    out property <length> one-y: one.y;
    out property <length> two-y: two.y;
    out property <length> three-y: three.y;
    out property <length> field-height: one.height;
    // The owner's choice, bound one way as the language's; what the bar shows; the picks it asked for.
    in-out property <int> choice;
    out property <int> shown: bar.selected;
    out property <int> picked: -1;
    out property <length> bar-y: bar.y;
    out property <length> bar-width: bar.width;
    out property <bool> pill-shown: bar.pill-shown;
    out property <length> pill-x: bar.pill-x;
    out property <length> pill-width: bar.pill-width;
    // Export's spaces, one label longer than an even share of the bar: what each tab is given.
    in-out property <int> space;
    out property <length> space-width: spaces.width;
    out property <length> space-pill-width: spaces.pill-width;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 360px;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        alignment: start;
        one := TextField { }
        two := TextField { }
        three := TextField { multiline: true; }
        bar := Tabs {
            tabs: ["One", "Two", "Three"];
            selected: root.choice;
            picked(i) => { root.picked = i; }
        }
        spaces := Tabs {
            tabs: ["sRGB", "DP3", "Adobe RGB", "ProPhoto", "Custom"];
            selected: root.space;
        }
    }
}

// The same well three times, where a check reads the lit lip under each: alone on the ground, in a
// box clipped at its bounds, and ending a section that folds.
export component DepthProbe inherits AppWindow {
    in-out property <bool> folded <=> section.folded;
    out property <length> left: Space.l;
    out property <length> well-width: free.width;
    out property <length> well-height: free.height;
    out property <length> free-y: free.absolute-position.y;
    out property <length> cut-y: cut.absolute-position.y;
    out property <length> ending-y: ending.absolute-position.y;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 400px;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        alignment: start;
        free := Inset { height: ButtonStyle.height; }
        Rectangle {
            height: ButtonStyle.height;
            clip: true;
            cut := Inset { }
        }
        section := Section {
            title: "Section";
            separated: false;
            inset: SectionStyle.flush;
            ending := Inset { height: ButtonStyle.height; }
        }
    }
}

// A page far taller than the window, its knob on the window's edge, over a scroller whose content fits.
export component ScrollProbe inherits AppWindow {
    title: "ONI Scroll Probe";
    preferred-width: ShellStyle.min-width;
    in-out property <length> scroll <=> page.content-y;
    out property <bool> page-overflows: page.overflows;
    out property <bool> page-lit: page.lit;
    out property <length> page-x: page.content-x;
    out property <length> page-whole: page.content-height;
    out property <length> page-shown: page.visible-height;
    out property <bool> short-overflows: short.overflows;
    out property <bool> short-lit: short.lit;
    out property <length> short-x: short.absolute-position.x + short.width / 2;
    out property <length> short-y: short.absolute-position.y + short.height / 2;
    out property <length> short-right: short.absolute-position.x + short.width;
    page := Scroller {
        content-height: lines.preferred-height;
        lines := VerticalLayout {
            width: page.width;
            padding: Space.l;
            spacing: Space.s;
            short := Scroller {
                width: ShellStyle.library-width;
                height: 3 * RowStyle.height;
                content-height: fits.preferred-height;
                fits := VerticalLayout {
                    width: parent.width;
                    Row { title: "Content that fits: no knob"; }
                }
            }
            for i in 120: Label { text: "Line " + (i + 1); role: TextRole.value; tone: Tone.secondary; }
        }
    }
}

// A keycap alone, where a check presses it and reads whether its cap is down.
export component KeyProbe inherits AppWindow {
    title: "ONI Key Probe";
    out property <length> key-x: key.absolute-position.x + key.width / 2;
    out property <length> key-y: key.absolute-position.y + key.height / 2;
    out property <bool> key-down: key.down;
    min-width: 0;
    min-height: 0;
    preferred-width: 200px;
    preferred-height: 120px;
    VerticalLayout {
        padding: Space.l;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            key := Button { keycap: true; text: "−"; }
        }
    }
}

// Two keys on a plate, two on a mini plate and two on a spaced row, where a check reads their walls.
export component GroupProbe inherits AppWindow {
    title: "ONI Group Probe";
    out property <length> plate-gap: plate-b.absolute-position.x - plate-a.absolute-position.x - plate-a.width;
    out property <length> plate-height: plate.height;
    out property <length> plate-key-height: plate-a.height;
    out property <length> plate-radius: plate.radius;
    out property <length> mini-gap: mini-b.absolute-position.x - mini-a.absolute-position.x - mini-a.width;
    out property <length> mini-radius: mini.radius;
    out property <length> row-gap: row-b.absolute-position.x - row-a.absolute-position.x - row-a.width;
    out property <length> row-radius: row.radius;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 260px;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        alignment: start;
        plate := ButtonGroup { plate: true;
            plate-a := Button { size: ButtonSize.plate; text: "Copy"; }
            plate-b := Button { size: ButtonSize.plate; text: "Paste"; }
        }
        mini := ButtonGroup { plate: true; mini: true;
            mini-a := Button { size: ButtonSize.mini; text: "−"; }
            mini-b := Button { size: ButtonSize.mini; text: "+"; }
        }
        row := ButtonGroup {
            row-a := Button { text: "Website"; }
            row-b := Button { text: "Feedback"; }
        }
    }
}

// A key monitor around a field, a name typed over, a key, two pickers side by side and a date, where
// the checks press beside a field or a menu, or from one date box to the next.
export component OutsideProbe inherits AppWindow {
    title: "ONI Outside Probe";
    in-out property <string> text <=> field.text;
    in-out property <bool> renaming;
    in property <string> name;
    out property <string> committed;
    out property <bool> cancelled;
    out property <bool> editing: field.editing;
    out property <bool> monitor-focused: keys.has-focus;
    // The last key the monitor heard, and the key's clicks.
    out property <string> heard;
    out property <int> clicks;
    out property <int> first-chosen: -1;
    out property <bool> first-open: first.dropped;
    out property <bool> second-open: second.dropped;
    out property <length> text-x: field.absolute-position.x + FieldStyle.across;
    out property <length> field-y: field.absolute-position.y + field.height / 2;
    out property <length> rename-y: slot.absolute-position.y + slot.height / 2;
    // The date's boxes, the middle of the first two, the last date committed and how many were.
    out property <length> date-y: date.absolute-position.y + date.height / 2;
    out property <length> month-x: date.month-x;
    out property <length> day-x: date.day-x;
    out property <bool> date-editing: date.editing;
    out property <string> date-committed;
    out property <int> commits;
    out property <length> key-x: key.absolute-position.x + key.width / 2;
    out property <length> key-y: key.absolute-position.y + key.height / 2;
    out property <length> first-x: first.absolute-position.x + first.width / 2;
    out property <length> second-x: second.absolute-position.x + second.width / 2;
    out property <length> pickers-y: first.absolute-position.y + first.height / 2;
    // The second line of the first picker's menu, dropped under its field.
    out property <length> line-x: first.absolute-position.x + Space.l;
    out property <length> line-y: first.absolute-position.y + first.height + Space.xs + 1.5 * ButtonStyle.small-height;
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 400px;
    keys := KeyMonitor {
        key-pressed(event) => {
            root.heard = event.text;
            accept
        }
        VerticalLayout {
            padding: Space.l;
            spacing: Space.l;
            alignment: start;
            field := TextField { }
            slot := Rectangle {
                height: FieldStyle.height;
                if root.renaming: RenameField {
                    width: parent.width;
                    height: parent.height;
                    text: root.name;
                    committed(t) => { root.committed = t; root.renaming = false; }
                    cancelled => { root.cancelled = true; root.renaming = false; }
                }
            }
            HorizontalLayout {
                alignment: start;
                key := Button { text: "Key"; clicked => { root.clicks += 1; } }
            }
            HorizontalLayout {
                spacing: Space.l;
                first := Picker { value: "One"; entries: ["One", "Two", "Three"]; chosen(i) => { root.first-chosen = i; } }
                second := Picker { value: "Red"; entries: ["Red", "Green"]; }
            }
            date := DateFields {
                month: "2";
                day: "31";
                year: "1999";
                committed(m, d, y) => { root.date-committed = m + "/" + d + "/" + y; root.commits += 1; }
            }
        }
    }
    init => { keys.focus(); }
}

// A context menu dropped where the check asks: an opener of three lines between plain lines, then an
// opener of one, whose submenus it lays as Rust does.
export component SubmenuProbe inherits AppWindow {
    title: "ONI Submenu Probe";
    out property <int> open: root.state.open;
    out property <int> lit: root.state.lit;
    out property <int> sub-lit: root.state.sub-lit;
    out property <bool> turned: root.state.turned;
    out property <bool> sub-shown: root.state.open >= 0;
    out property <bool> menu-open: menu.is-open;
    out property <int> asked;
    out property <int> chosen: -1;
    out property <int> sub-chosen: -1;
    // Where the lines and the submenu lie in the window, so the check aims its pointer.
    out property <length> line-x: root.at-x + Space.l;
    out property <length> line-top: root.at-y + Space.xs;
    out property <length> line-height: ButtonStyle.small-height;
    out property <length> span: MenuStyle.width;
    out property <length> sub-left: root.at-x - root.state.lead-x + root.state.sub-x;
    out property <length> sub-top: root.at-y + root.state.sub-y;
    property <MenuState> state: { lit: -1, open: -1, sub-lit: -1 };
    property <length> at-x;
    property <length> at-y;
    property <[MenuLine]> subs;
    public function drop(x: length, y: length) {
        root.at-x = x;
        root.at-y = y;
        root.asked = 0;
        root.chosen = -1;
        root.sub-chosen = -1;
        root.state = { lit: -1, open: -1, sub-lit: -1 };
        menu.show();
    }
    min-width: 0;
    min-height: 0;
    preferred-width: 800px;
    preferred-height: 500px;
    menu := Menu {
        anchor-x: root.at-x;
        y: root.at-y;
        window-x: root.at-x;
        window-y: root.at-y;
        lines: [
            { text: "Plain", enabled: true },
            { text: "Add to", enabled: true, opens: true },
            { text: "Middle", enabled: true },
            { text: "Last", enabled: true },
            { text: "Remove from", enabled: true, opens: true },
        ];
        sub-lines: root.subs;
        chosen(i) => { root.chosen = i; self.close(); }
        opened(i) => {
            root.asked += 1;
            root.subs = i == 1 ? [{ text: "One", enabled: true }, { text: "Two", enabled: true }, { text: "Three", enabled: true }] : i == 4 ? [{ text: "Only", enabled: true }] : [];
        }
        sub-chosen(j) => { root.sub-chosen = j; self.close(); }
        state-changed(state) => { root.state = state; }
    }
}

// A key, the tabs, a slider, a switch and a field in reading order, which Tab walks under a key monitor,
// and a sheet of two keys over them whose walls keep Tab inside it while it covers them.
export component KeyboardProbe inherits AppWindow {
    title: "ONI Keyboard Probe";
    // The key shown; taken away, as a press may take away the key holding the keyboard.
    in-out property <bool> keyed: true;
    in-out property <bool> covered;
    changed covered => { Keyboard.covered = self.covered; }
    in-out property <string> text <=> field.text;
    out property <bool> monitor-focused: keys.has-focus;
    out property <bool> held: keys.held;
    out property <bool> editing: field.editing;
    // The last key the monitor heard, the key's presses, the tab picked, the slider's steps, the switch,
    // and the sheet key pressed last: 1 its first, 2 its last.
    out property <string> heard;
    out property <int> clicks;
    out property <int> tab;
    out property <int> steps;
    out property <bool> on;
    out property <int> answered;
    // Where the tabs' first tab lies, which a press lands on.
    out property <length> tabs-x: tabs.absolute-position.x + Space.l;
    out property <length> tabs-y: tabs.absolute-position.y + tabs.height / 2;
    // The slider's knob at rest in the middle, its value at the readout's right end, and a spot of the
    // window where no control lies.
    out property <length> knob-x: slider.absolute-position.x + slider.width / 2;
    out property <length> knob-y: slider.absolute-position.y + slider.height - SliderStyle.row / 2;
    out property <length> value-x: slider.absolute-position.x + slider.width - Space.xs;
    out property <length> value-y: slider.absolute-position.y + Space.s;
    out property <length> bare-y: root.height - Space.s;
    // A number being typed over the slider's value, which holds the keyboard as a field does.
    out property <bool> entering: TextInputInterface.text-input-focused && !field.editing;
    public function refocus() { keys.focus(); }
    min-width: 0;
    min-height: 0;
    preferred-width: 400px;
    preferred-height: 400px;
    keys := KeyMonitor {
        // Tab goes on to Slint's walk, as the app's monitor leaves it.
        key-pressed(event) => {
            if (event.text == Key.Tab || event.text == Key.Backtab) { return reject; }
            root.heard = event.text;
            accept
        }
        VerticalLayout {
            padding: Space.l;
            spacing: Space.l;
            alignment: start;
            HorizontalLayout {
                alignment: start;
                height: ButtonStyle.height;
                if root.keyed: Button { text: "Key"; clicked => { root.clicks += 1; } }
            }
            tabs := Tabs { tabs: ["One", "Two", "Three"]; selected: root.tab; picked(i) => { root.tab = i; } }
            slider := Slider { label: "Value"; readout: root.steps; fraction: 0.5; step(f, by) => { root.steps += by; } }
            Toggle { label: "Switch"; on: root.on; toggled(on) => { root.on = on; } }
            field := TextField { name: "Field"; }
        }
    }
    if root.covered: Sheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: "Sheet";
        dismissed => { root.covered = false; }
        HorizontalLayout {
            spacing: Space.s;
            Button { text: "First"; clicked => { root.answered = 1; } }
            Button { text: "Last"; clicked => { root.answered = 2; } }
        }
    }
    init => { keys.focus(); }
}
