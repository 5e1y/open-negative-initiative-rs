// A film stock: its artwork in its own colours, or the film-roll glyph for a stock without any, and
// the picker's cell with the name under it, grown under the pointer and filled when picked.
import { Colour, Space, Radius, Motion } from "theme.slint";
import { StockStyle } from "theme_views.slint";
import { Label, TextRole, Tone, Icon } from "base.slint";
import { Icons } from "icons.slint";

// `FilmStockIcon`: the artwork in its own colours where the stock itself is shown, a picker's cell or a
// roll's hero; at a row's size, among the line glyphs, the film-roll glyph, as for a stock without any.
export component StockIcon inherits Rectangle {
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <length> side: StockStyle.icon;
    property <bool> shown: root.has-artwork && root.side >= StockStyle.icon;
    width: root.side;
    height: root.side;
    if root.shown: Image { width: root.side; height: root.side; source: root.artwork; }
    if !root.shown: Icon {
        width: root.side >= StockStyle.icon ? root.side : StockStyle.row;
        height: self.width;
        source: Icons.film-roll;
        tone: Tone.secondary;
    }
}

export component StockCellView inherits Rectangle {
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <string> name;
    in property <bool> picked;
    callback clicked();
    border-radius: Radius.badge;
    background: root.picked ? Colour.hover : Colour.ground.transparentize(1);
    VerticalLayout {
        padding: Space.xs;
        spacing: Space.xs;
        alignment: start;
        // The grown icon's room is kept at rest, so a hover never moves the names.
        Rectangle {
            height: StockStyle.icon * StockStyle.grow;
            StockIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                artwork: root.artwork;
                has-artwork: root.has-artwork;
                side: touch.has-hover ? StockStyle.icon * StockStyle.grow : StockStyle.icon;
                animate side { duration: Motion.quick; }
            }
        }
        Label {
            text: root.name;
            role: TextRole.value;
            tone: root.picked ? Tone.primary : Tone.secondary;
            centred: true;
            wrap: word-wrap;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}
