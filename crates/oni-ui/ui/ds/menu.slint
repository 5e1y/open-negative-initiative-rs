// The menus: one popup for every list a key or a click opens, a context menu's submenu beside it.
import { Colour, Space, State, ButtonStyle, MenuStyle, MedalStyle } from "theme.slint";
import { Label, Icon, Tone, TextRole, Divider, Gap } from "base.slint";
import { Bounds } from "outside.slint";
import { Popover } from "surfaces.slint";
import { Look } from "button.slint";
import { Icons, MenuGlyph } from "icons.slint";
import { RowKind, RowForm, Row } from "row.slint";
import { FormStyle } from "forms.slint";
import { Medal } from "marks.slint";

// A line of a menu: a rule above it, out of reach, a submenu beside it, the chord the menu bar answers
// for it as AppKit's menus print it, a medal or a glyph before its words, or a picker's note under them.
export struct MenuLine { text: string, enabled: bool, rule: bool, opens: bool, keys: string, medal: int, note: string, glyph: MenuGlyph }

export struct FolderChoice { title: string, current: bool }

// What a menu shows its owner, which cannot read into a popup: the lines lit, the opener whose submenu
// shows, the submenu turned left and where it lies, and how far left of its anchor the popup starts.
export struct MenuState { lit: int, open: int, sub-lit: int, turned: bool, lead-x: length, sub-x: length, sub-y: length }

// One line of a menu: its check, glyph or medal, its word, its shortcut, a soft band under the pointer,
// or on the line its menu holds lit (`held`) when it does not follow the pointer alone (`by-hand`).
export component MenuEntry inherits Rectangle {
    in property <string> text;
    // Words under the line's own, in the secondary ink: what a preset writes.
    in property <string> note;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> checked;
    // The medal a line names, 0 none, struck where a check would stand, whose room its menu sets.
    in property <int> medal;
    in property <MenuGlyph> glyph;
    in property <length> lead: ButtonStyle.small-icon;
    in property <Look> look: Look.live;
    in property <bool> held;
    in property <bool> by-hand: true;
    // The pointer moving over it, in its popup's points.
    callback pointed(length, length);
    callback activated();
    property <bool> hovered: root.enabled && ((root.by-hand && area.has-hover) || root.held || root.look != Look.live);
    // A small key's height, AppKit's rhythm for a menu of a dozen lines; a line over its note, two.
    height: root.note != "" ? MenuStyle.noted-height : ButtonStyle.small-height;
    border-radius: ButtonStyle.small-radius;
    background: root.hovered ? MenuStyle.lit : Colour.raised.transparentize(1);
    opacity: root.enabled ? 1 : State.disabled;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        if root.lead > 0: Rectangle {
            width: root.lead;
            if root.checked: Icon { source: Icons.done; tone: Tone.primary; width: ButtonStyle.small-icon; height: ButtonStyle.small-icon; }
            if root.medal > 0: Medal { rank: root.medal; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            if root.glyph != MenuGlyph.none && !root.checked: Icon { source: Icons.line(root.glyph); tone: Tone.secondary; width: MenuStyle.glyph; height: MenuStyle.glyph; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label { text: root.text; overflow: elide; }
            if root.note != "": Label { text: root.note; role: TextRole.caption; tone: Tone.secondary; overflow: elide; }
        }
        if root.shortcut != "": Label { text: root.shortcut; tone: Tone.secondary; }
    }
    // Live on an out-of-reach line too, so resting on it still closes an open submenu.
    area := TouchArea {
        clicked => { if (root.enabled) { root.activated(); } }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.pointed(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// What a popup holds: a menu's lines on the raised grey, or a popover's form on the panel's ground at
// the export panel's width, as Swift keeps them apart.
export enum PopupKind { menu, popover }

// A popup anchored where it opened, closed by a click outside; a popover hangs from its tail's tip. Sized
// as its panel: unsized, its content is hit at another width than drawn, and an edge pushes it wider.
export component PopupPanel inherits PopupWindow {
    in property <PopupKind> kind: PopupKind.popover;
    // A menu dropped under a field is as wide as it.
    in property <length> span: root.kind == PopupKind.menu ? MenuStyle.width : FormStyle.panel-width;
    // Where a popover's tail meets its anchor, from the panel's left; below zero, its middle.
    in property <length> tail-x: -1px;
    close-policy: close-on-click-outside;
    width: panel.width;
    height: panel.height;
    panel := Popover {
        width: root.span;
        menu: root.kind == PopupKind.menu;
        tail: root.kind == PopupKind.popover;
        tail-x: root.tail-x;
        pad: root.kind == PopupKind.menu ? Gap.xs : Gap.m;
        gap: root.kind == PopupKind.menu ? Gap.none : Gap.m;
        @children
    }
}

// Words with the current one checked, a context menu's lines, or the folder pill's choices; a choice
// closes it. An opener's submenu opens beside it as AppKit's, at rest, on a click or on →.
export component Menu inherits PopupWindow {
    // As wide as its widest line, word and chord, so neither elides: `natural`, which a select's menu
    // takes when its field is narrower.
    out property <length> natural: widest.preferred-width + 2 * Space.xs;
    in property <length> span: max(MenuStyle.width, root.natural);
    in property <[string]> entries;
    in property <int> current: -1;
    in property <[MenuLine]> lines;
    in property <[FolderChoice]> choices;
    // The submenu its owner lays on `opened`, and where the menu's corner stands in the window.
    in property <[MenuLine]> sub-lines;
    in property <length> window-x;
    in property <length> window-y;
    callback chosen(int);
    // An opener's submenu asked for, -1 once it closes; a line of the submenu chosen.
    callback opened(int);
    callback sub-chosen(int);
    // Where its owner anchors it: a submenu turned left starts the popup `lead-x` left of it.
    in property <length> anchor-x;
    callback state-changed(MenuState);
    // The width it dropped at, told its owner, which cannot read into a popup.
    callback dropped(length);
    init => { root.dropped(root.span); }
    // The line lit by the pointer or the arrows, the opener whose submenu shows, and its own lit line.
    property <int> lit: -1;
    property <int> open: -1;
    property <int> sub-lit: -1;
    // A submenu turns to the menu's left when the window's edge leaves it no room on the right.
    property <length> sub-span: max(MenuStyle.width, sub-widest.preferred-width + 2 * Space.xs);
    property <bool> turned: Bounds.width > 0 && root.left + root.span + root.sub-span > Bounds.width && root.left >= root.sub-span;
    property <length> lead-x: root.shown && root.turned ? root.sub-span : 0px;
    property <bool> shown: root.open >= 0 && root.sub-lines.length > 0;
    property <MenuState> state: { lit: root.lit, open: root.shown ? root.open : -1, sub-lit: root.sub-lit, turned: root.turned, lead-x: root.lead-x, sub-x: sub.x, sub-y: sub.y };
    changed state => { root.state-changed(self.state); }
    // The line the pointer rests on, the opener's top, and the pointer's last point, in the popup's points.
    property <int> aim: -1;
    property <length> open-y;
    property <length> last-x;
    property <length> last-y;
    // Where the window holds the menu alone, its edges pushing it in.
    property <length> left: Bounds.width > 0 ? max(0px, min(root.window-x, Bounds.width - root.span)) : root.window-x;
    property <length> top: Bounds.height > 0 ? max(0px, min(root.window-y, Bounds.height - panel.height)) : root.window-y;
    close-policy: close-on-click-outside;
    forward-focus: keys;
    x: root.anchor-x - root.lead-x;
    width: root.shown ? root.span + root.sub-span : root.span;
    height: root.shown ? max(panel.height, sub.y + sub.height) : panel.height;

    // A step towards the submenu, inside the cone from the last point to its near corners: the lines it
    // crosses on the way leave the submenu open.
    pure function heading(x: length, y: length) -> bool {
        let edge = (root.turned ? sub.x + sub.width : sub.x) / 1px;
        let dx = (x - root.last-x) / 1px;
        let dy = (y - root.last-y) / 1px;
        let ux = edge - root.last-x / 1px;
        let up = (sub.y - root.last-y) / 1px;
        let down = (sub.y + sub.height - root.last-y) / 1px;
        let toward = root.turned ? dx < 0 : dx > 0;
        return toward && (ux * dy - up * dx) * (ux * dy - down * dx) <= 0;
    }
    function arm() {
        if (wait.running) { wait.restart(); } else { wait.start(); }
    }
    function open-sub(i: int) {
        wait.stop();
        root.aim = i;
        root.lit = i;
        if (root.open != i) {
            root.open = i;
            root.sub-lit = -1;
            root.opened(i);
        }
    }
    function close-sub() {
        if (root.open >= 0) {
            root.open = -1;
            root.sub-lit = -1;
            root.opened(-1);
        }
    }
    // The pointer at rest on a line: its submenu opens, or the open one closes.
    function settle() {
        wait.stop();
        if (root.aim < 0 || root.aim == root.open) { return; }
        root.lit = root.aim;
        if (root.lines[root.aim].opens && root.lines[root.aim].enabled) { root.open-sub(root.aim); } else { root.close-sub(); }
    }
    function pointed(i: int, x: length, y: length) {
        if (root.shown && i != root.open && root.heading(x, y)) {
            root.aim = i;
            root.arm();
        } else {
            if (i != root.aim) { root.arm(); }
            root.aim = i;
            root.lit = i;
            root.sub-lit = -1;
            if (i == root.open) { wait.stop(); }
        }
        root.last-x = x;
        root.last-y = y;
    }
    function sub-pointed(j: int, x: length, y: length) {
        wait.stop();
        root.aim = root.open;
        root.lit = root.open;
        root.sub-lit = j;
        root.last-x = x;
        root.last-y = y;
    }
    // The arrows walk the lines, or the submenu's once it is entered; ← closes it.
    function step(by: int) {
        if (root.shown && root.sub-lit >= 0) {
            root.sub-lit = max(0, min(root.sub-lit + by, root.sub-lines.length - 1));
        } else if (root.lines.length > 0) {
            root.lit = root.lit < 0 ? (by > 0 ? 0 : root.lines.length - 1) : max(0, min(root.lit + by, root.lines.length - 1));
            root.aim = root.lit;
        }
    }
    function enter() {
        if (root.shown && root.sub-lit >= 0) {
            if (root.sub-lines[root.sub-lit].enabled) { root.sub-chosen(root.sub-lit); }
        } else if (root.lit >= 0 && root.lines[root.lit].enabled) {
            if (root.lines[root.lit].opens) { root.open-sub(root.lit); root.sub-lit = 0; } else { root.chosen(root.lit); }
        }
    }
    wait := Timer {
        interval: MenuStyle.sub-delay;
        running: false;
        triggered => { root.settle(); }
    }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) { root.step(1); return accept; }
            if (event.text == Key.UpArrow) { root.step(-1); return accept; }
            if (event.text == Key.RightArrow) {
                if (root.sub-lit < 0 && root.lit >= 0 && root.lines[root.lit].opens && root.lines[root.lit].enabled) {
                    root.open-sub(root.lit);
                    root.sub-lit = 0;
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.close-sub(); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.enter(); return accept; }
            reject
        }
    }
    // The room before the lines' words: a check's while one stands checked, or a medal's or a glyph's once
    // any line names one, so words align; their widths, unseen, give it. None, the words start at the edge.
    property <length> lead: max(root.current >= 0 ? ButtonStyle.small-icon : 0px, struck.preferred-width);
    struck := VerticalLayout {
        visible: false;
        for line in root.lines: Rectangle { width: line.medal > 0 ? MedalStyle.size : line.glyph != MenuGlyph.none ? MenuStyle.glyph : 0px; }
    }
    // The lines at their own widths, unseen, which `natural` and `sub-span` read.
    widest := VerticalLayout {
        visible: false;
        for word in root.entries: MenuEntry { text: word; }
        for line in root.lines: MenuEntry { text: line.text; note: line.note; shortcut: line.opens ? "›" : line.keys; medal: line.medal; glyph: line.glyph; lead: root.lead; }
    }
    sub-widest := VerticalLayout {
        visible: false;
        for line in root.sub-lines: MenuEntry { text: line.text; glyph: line.glyph; lead: MenuStyle.glyph; }
    }
    // A press on the popup's bare ground, beside a short submenu, closes the menu as one outside it does.
    TouchArea {
        pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.close(); } }
    }
    panel := Popover {
        x: root.lead-x;
        y: 0px;
        width: root.span;
        menu: true;
        tail: false;
        pad: Gap.xs;
        gap: Gap.none;
        for word[i] in root.entries: MenuEntry {
            text: word;
            checked: i == root.current;
            activated => { root.chosen(i); root.close(); }
        }
        for line[i] in root.lines: VerticalLayout {
            property <bool> opening: i == root.open;
            changed opening => { if (self.opening) { root.open-y = entry.absolute-position.y; } }
            if line.rule: Divider { }
            entry := MenuEntry {
                text: line.text;
                note: line.note;
                shortcut: line.opens ? "›" : line.keys;
                medal: line.medal;
                glyph: line.glyph;
                lead: root.lead;
                checked: i == root.current;
                enabled: line.enabled;
                by-hand: false;
                held: i == root.lit || i == root.open;
                pointed(x, y) => { root.pointed(i, x, y); }
                activated => { if (line.opens) { root.open-sub(i); } else { root.chosen(i); } }
            }
        }
        for choice[i] in root.choices: Row {
            form: RowForm.menu;
            kind: RowKind.folder;
            title: choice.title;
            checked: choice.current;
            clicked => { root.chosen(i); }
        }
    }
    // Its first line level with its opener's, held inside the window's bottom.
    sub := Popover {
        visible: root.shown;
        x: root.turned ? 0px : root.span;
        y: Bounds.height > 0 ? max(0px, min(root.open-y - Space.xs, Bounds.height - root.top - self.height)) : root.open-y - Space.xs;
        width: root.sub-span;
        menu: true;
        tail: false;
        pad: Gap.xs;
        gap: Gap.none;
        for line[j] in root.sub-lines: VerticalLayout {
            if line.rule: Divider { }
            MenuEntry {
                text: line.text;
                glyph: line.glyph;
                lead: MenuStyle.glyph;
                enabled: line.enabled;
                by-hand: false;
                held: j == root.sub-lit;
                pointed(x, y) => { root.sub-pointed(j, x, y); }
                activated => { root.sub-chosen(j); }
            }
        }
    }
}
