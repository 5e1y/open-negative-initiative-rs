// The menus: one popup for every list a key or a click opens, and the picker that drops it under its field.
import { Colour, Space, Radius, Stroke, State, ButtonStyle, MenuStyle, FieldStyle, CardStyle } from "theme.slint";
import { Label, Icon, Tone, Tips, Divider, Gap } from "base.slint";
import { Outside } from "outside.slint";
import { Popover } from "surfaces.slint";
import { Look } from "button.slint";
import { Icons } from "icons.slint";

import { RowKind, RowForm, Row } from "row.slint";
import { FormStyle } from "forms.slint";
import { PickerStyle, TabsStyle } from "theme.slint";
import { Inward, Keycap, KeycapVariant, Depth } from "depth.slint";

// A line of a context menu: a rule above it, out of reach, or opening a submenu Rust lays in its place.
export struct MenuLine { text: string, enabled: bool, rule: bool, opens: bool }

export struct FolderChoice { title: string, current: bool }

// One line of a menu: its check, its word, its shortcut, the accent's band under the pointer.
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <Look> look: Look.live;
    callback activated();
    property <bool> hovered: root.enabled && (area.has-hover || root.look != Look.live);
    height: ButtonStyle.height;
    border-radius: ButtonStyle.small-radius;
    background: root.hovered ? Colour.accent : Colour.raised.transparentize(1);
    opacity: root.enabled ? 1 : State.disabled;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        Rectangle {
            width: ButtonStyle.small-icon;
            if root.checked: Icon { source: Icons.done; tone: Tone.primary; width: ButtonStyle.small-icon; height: ButtonStyle.small-icon; }
        }
        Label { text: root.text; horizontal-stretch: 1; overflow: elide; }
        Label { text: root.shortcut; tone: Tone.secondary; }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// What a popup holds: a menu's lines on the raised grey, or a popover's form on the panel's ground at
// the export panel's width, as Swift keeps them apart.
export enum PopupKind { menu, popover }

// A popup anchored where it opened, closed by a click outside; a popover hangs from its tail's tip. Sized
// as its panel: unsized, its content is hit at another width than drawn, and an edge pushes it wider.
export component PopupPanel inherits PopupWindow {
    in property <PopupKind> kind: PopupKind.popover;
    // A menu dropped under a field is as wide as it.
    in property <length> span: root.kind == PopupKind.menu ? MenuStyle.width : FormStyle.panel-width;
    // Where a popover's tail meets its anchor, from the panel's left; below zero, its middle.
    in property <length> tail-x: -1px;
    close-policy: close-on-click-outside;
    width: panel.width;
    height: panel.height;
    panel := Popover {
        width: root.span;
        menu: root.kind == PopupKind.menu;
        tail: root.kind == PopupKind.popover;
        tail-x: root.tail-x;
        pad: root.kind == PopupKind.menu ? Gap.xs : Gap.m;
        gap: root.kind == PopupKind.menu ? Gap.none : Gap.m;
        @children
    }
}

// Words with the current one checked; or a context menu's lines; or the folder pill's choices.
// A choice closes it, as a click outside does.
export component Menu inherits PopupPanel {
    in property <[string]> entries;
    in property <int> current: -1;
    in property <[MenuLine]> lines;
    in property <[FolderChoice]> choices;
    callback chosen(int);
    kind: PopupKind.menu;
    for word[i] in root.entries: MenuEntry {
        text: word;
        checked: i == root.current;
        activated => { root.chosen(i); root.close(); }
    }
    for line[i] in root.lines: VerticalLayout {
        if line.rule: Divider { engraved: false; }
        MenuEntry {
            text: line.text;
            shortcut: line.opens ? "›" : "";
            enabled: line.enabled;
            activated => { root.chosen(i); }
        }
    }
    for choice[i] in root.choices: Row {
        form: RowForm.menu;
        kind: RowKind.folder;
        title: choice.title;
        checked: choice.current;
        clicked => { root.chosen(i); }
    }
}

// A picker's face: `field` set in the panel as a text field is, `pill` a column header's name on the
// canvas's dark, `chip` the Working Space's words on no ground.
export enum PickerFace { field, pill, chip }

// A field naming the value chosen, a chevron at its end; its words, lines or folders drop under it as a
// menu. The field is `DSPicker`'s hollow, its chevron on a mini key that sinks under the hand; a pill
// or a chip lights the hover ground. Every face dims when it is out of reach.
export component Picker inherits HorizontalLayout {
    in property <PickerFace> face: PickerFace.field;
    in property <string> label;
    // Words in the secondary ink before the value, a middle dot between, as the chip's space.
    in property <string> prefix;
    in property <string> value;
    in property <[string]> entries;
    in property <int> current: -1;
    in property <[MenuLine]> lines;
    in property <[FolderChoice]> choices;
    in property <bool> enabled: true;
    // A pill that only names what its column lists takes no click, its note still shown.
    in property <bool> pressable: true;
    in property <string> help;
    in property <Look> look: Look.live;
    // Where the field starts, which a menu dropped under it aligns on.
    out property <length> field-x: field.x;
    out property <length> field-width: field.width;
    // A popup the owner drops itself on `open`, as the Working Space chip's, held as its menu.
    in property <bool> own-popup;
    out property <bool> dropped: menu.is-open || root.own-popup;
    callback open();
    callback chosen(int);
    property <bool> pill: root.face == PickerFace.pill;
    property <bool> chip: root.face == PickerFace.chip;
    property <bool> hovered: root.enabled && root.pressable && (area.has-hover || root.look != Look.live);
    property <bool> well: root.face == PickerFace.field;
    // The key's press on the grab spring: a hover sinks it as a keycap's, a press whole.
    property <float> depth: !root.hovered ? 0 : area.pressed || root.look == Look.pressed ? 1 : Depth.hover-press;
    animate depth { duration: TabsStyle.slide; easing: spring(0.38); }
    // The press its field last took, and the one that closed its menu: a release whose press never
    // came is a click a menu swallowed, which opens this picker, as AppKit's does, unless it closed its own.
    property <int> down-at: -1;
    property <int> closed-at: -1;
    changed dropped => { if (!self.dropped) { root.closed-at = Outside.presses; } }
    function drop() {
        if (root.pressable) {
            root.open();
            if (root.entries.length > 0 || root.lines.length > 0 || root.choices.length > 0) {
                menu.show();
            }
        }
    }
    spacing: Space.s;
    // A pill as tall as the key plate beside it, keys and inset alike.
    height: root.pill ? ButtonStyle.small-height + 2 * ButtonStyle.plate-inset : root.chip ? CardStyle.padding : ButtonStyle.height;
    if root.label != "": Label { text: root.label; }
    field := Rectangle {
        horizontal-stretch: 1;
        border-radius: Radius.badge;
        background: root.well || (root.chip && !root.hovered) ? Colour.hover.transparentize(1) : root.hovered ? Colour.hover : Colour.canvas;
        opacity: root.enabled ? 1 : State.disabled;
        accessible-role: button;
        accessible-label: root.prefix != "" ? root.prefix + " · " + root.value : root.value;
        accessible-enabled: root.enabled;
        // As wide as its words on a chip, eliding the value once its room is short.
        preferred-width: row.preferred-width;
        if root.well: Inward { hollow: true; ground: Colour.canvas; radius: PickerStyle.radius; }
        row := HorizontalLayout {
            padding-left: root.well ? PickerStyle.padding : Space.s;
            padding-right: root.well ? (root.height - PickerStyle.key) / 2 : Space.s;
            spacing: root.chip ? Space.xs : Space.s;
            if root.prefix != "": Label { text: root.prefix; tone: Tone.secondary; }
            if root.prefix != "": Label { text: "·"; tone: Tone.secondary; }
            Label { text: root.value; horizontal-stretch: 1; overflow: elide; }
            if root.chip: VerticalLayout {
                alignment: center;
                Icon { source: Icons.chevron-down; width: FormStyle.chip-icon; height: self.width; }
            }
            if root.well: VerticalLayout {
                alignment: center;
                Keycap {
                    width: PickerStyle.key;
                    height: PickerStyle.key;
                    variant: KeycapVariant.mini;
                    depth: root.depth;
                    Icon { source: Icons.chevron-down; ink: PickerStyle.chevron-ink; width: PickerStyle.chevron; height: self.width; }
                }
            }
        }
        // Hovered even when it opens nothing, so the path a pill names still shows as its note.
        area := TouchArea {
            enabled: root.enabled;
            clicked => { root.drop(); }
            pointer-event(event) => {
                if (event.button != PointerEventButton.left) { return; }
                if (event.kind == PointerEventKind.down) { root.down-at = Outside.presses; }
                if (event.kind == PointerEventKind.up && root.down-at != Outside.presses && root.closed-at != Outside.presses) { root.drop(); }
            }
            changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
        }
    }
    menu := Menu {
        x: root.field-x;
        y: root.height;
        // A folder's list as wide as its pill; words at least the menu's own width.
        span: root.choices.length > 0 ? root.field-width : root.lines.length > 0 ? MenuStyle.width : max(MenuStyle.width, root.field-width);
        entries: root.entries;
        current: root.current;
        lines: root.lines;
        choices: root.choices;
        chosen(i) => { root.chosen(i); self.close(); }
    }
}
