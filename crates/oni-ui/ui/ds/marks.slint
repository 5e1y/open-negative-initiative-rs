// The marks laid over a picture, a control or the canvas: a disc, a medal, a selection's ring, a
// guide's ring and a stroke's trace.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, TileStyle } from "theme.slint";
import { MedalStyle } from "theme.slint";

// A disc of one ink: a medal, a lamp, a switch's thumb, a tab's swatch or mark, a bullet.
export component Dot inherits Rectangle {
    in property <length> size;
    in property <color> ink;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.ink;
}

// `DSMedal`: bronze, silver or gold spun in foil, 0 being none; its grain lit along the lamp's radius
// (DSFoil's softbox, upper left) and its opposite, a ruled ring inside the edge, two cast shadows.
export component Medal inherits Rectangle {
    in property <int> rank;
    in property <length> size: MedalStyle.size;
    property <color> deep: MedalStyle.deeps[root.rank];
    property <color> body: MedalStyle.bodies[root.rank];
    property <color> bright: MedalStyle.brights[root.rank];
    // The ramp at `t` (deep to body over 0..1, body to bright over 1..1.6), then DSFoil's 1/1.15 gamma.
    pure function ch(d: float, b: float, l: float, t: float) -> float {
        255 * pow(clamp((t < 1 ? d + (b - d) * t : b + (l - b) * (t - 1) / 0.6) / 255, 0, 1), 1 / 1.15)
    }
    pure function tone(t: float) -> color {
        rgb(root.ch(root.deep.red, root.body.red, root.bright.red, t),
            root.ch(root.deep.green, root.body.green, root.bright.green, t),
            root.ch(root.deep.blue, root.body.blue, root.bright.blue, t))
    }
    // The flat face's light (0.70) plus the spun lobes, |cos(bearing)|^4, brightest at 328.5° and 148.5°.
    pure function at(a: float) -> color {
        root.tone(0.70 + MedalStyle.foil-spin * pow(abs(cos((a - 328.5) * 1deg)), 4))
    }
    width: root.size;
    height: root.size;
    visible: root.rank > 0;
    border-radius: self.width / 2;
    drop-shadow-color: MedalStyle.far-shadow;
    drop-shadow-blur: MedalStyle.far-blur;
    drop-shadow-offset-y: MedalStyle.far-y;
    Rectangle {
        border-radius: self.width / 2;
        drop-shadow-color: MedalStyle.near-shadow;
        drop-shadow-blur: MedalStyle.near-blur;
        drop-shadow-offset-y: MedalStyle.near-blur;
        background: @conic-gradient(
            root.at(0) 0deg, root.at(22.5) 22.5deg, root.at(45) 45deg, root.at(67.5) 67.5deg,
            root.at(90) 90deg, root.at(112.5) 112.5deg, root.at(135) 135deg, root.at(157.5) 157.5deg,
            root.at(180) 180deg, root.at(202.5) 202.5deg, root.at(225) 225deg, root.at(247.5) 247.5deg,
            root.at(270) 270deg, root.at(292.5) 292.5deg, root.at(315) 315deg, root.at(337.5) 337.5deg,
            root.at(360) 360deg);
        // The lobes fade into the centre (`min(ring / radius * 2, 1)`).
        Rectangle {
            border-radius: self.width / 2;
            background: @radial-gradient(circle, root.tone(0.70) 0%, root.tone(0.70).transparentize(1) 35%);
        }
        // The rolled bevel: lit on top, shaded at the foot.
        Rectangle {
            border-radius: self.width / 2;
            border-width: parent.width * 0.6 / 12;
            border-color: @linear-gradient(180deg, root.tone(1.5) 0%, root.tone(0.35) 100%);
        }
        // The ruled ring, 1.5 pt inside the edge at the 12 pt size.
        Rectangle {
            x: parent.width * 1.5 / 12;
            y: self.x;
            width: parent.width - 2 * self.x;
            height: self.width;
            border-radius: self.width / 2;
            border-width: parent.width * 0.4 / 12;
            border-color: MedalStyle.rule-ink;
        }
    }
}

export enum RingPlacement { inset, outset }
export enum SelectionTone { selected, destructive }

// `TileLayers`, `RollFrameCell` and `TreeRowChrome.dropRing` alike: a fine edge inset by a line,
// the selection's ring over it; `outset` rings the bounds an `xs` outside, with no edge.
export component SelectionRing inherits Rectangle {
    in property <RingPlacement> placement: RingPlacement.inset;
    in property <SelectionTone> tone: SelectionTone.selected;
    in property <length> radius: Radius.card;
    property <length> out: root.placement == RingPlacement.outset ? Space.xs : 0px;
    if root.placement == RingPlacement.inset: Rectangle {
        x: Stroke.line;
        y: Stroke.line;
        width: parent.width - 2 * Stroke.line;
        height: parent.height - 2 * Stroke.line;
        border-radius: root.radius;
        border-width: Stroke.line;
        border-color: Colour.contrast-edge-idle;
    }
    Rectangle {
        x: -root.out;
        y: -root.out;
        width: parent.width + 2 * root.out;
        height: parent.height + 2 * root.out;
        border-radius: root.radius + root.out;
        border-width: Stroke.emphasis;
        border-color: root.tone == SelectionTone.destructive ? Colour.destructive : Colour.selected;
    }
}

// `guide` the base pick's and the brush's ring, `DSGuide.width(true)` over its shadow; `sharpen` a
// correction's, `DSGuide.width(false)` in the sharpen tint with none.
export enum RingTone { guide, sharpen }

// A circle's `stroke`, never `strokeBorder`: centred on the disc's edge, so the rim never eats the
// pixels it bounds.
export component Ring inherits Rectangle {
    in property <length> centre-x;
    in property <length> centre-y;
    in property <length> diameter;
    in property <RingTone> tone: RingTone.guide;
    property <bool> guide: root.tone == RingTone.guide;
    property <length> line: root.guide ? Stroke.line + DS.control-guide-grow : Stroke.line;
    x: root.centre-x - (root.diameter + root.line) / 2;
    y: root.centre-y - (root.diameter + root.line) / 2;
    width: root.diameter + root.line;
    height: self.width;
    border-radius: self.width / 2;
    border-width: root.line;
    border-color: root.guide ? Colour.handle-active : Colour.sharpen;
    drop-shadow-color: root.guide ? Colour.contrast-edge : Colour.contrast-edge.transparentize(1);
    drop-shadow-blur: root.guide ? Stroke.emphasis : 0px;
}

// `live` the stroke being painted, `source` a patch's: its copied stroke, and the line to it `dashed`.
export enum TraceTone { live, source }

// A stroke as a polyline in the canvas's points; a dashed one ends flat, its dashes laid by Rust.
export component Trace inherits Path {
    in property <length> thickness;
    in property <TraceTone> tone: TraceTone.live;
    in property <bool> dashed;
    stroke: root.tone == TraceTone.live ? Colour.stroke-live : Colour.sharpen;
    stroke-width: root.thickness;
    stroke-line-cap: root.dashed ? LineCap.butt : LineCap.round;
    stroke-line-join: round;
    fill: transparent;
    // One unit of the commands a point of the canvas: a fitted path shrinks by its stroke's width.
    fit: preserve;
}
