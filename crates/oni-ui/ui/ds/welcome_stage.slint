// The welcome's stage as the window lays it: the gift the GPU draws or its still, the words beside it, the frame
// a screen's demo plays in, and the rail that says which screen shows. Plain type, no colour but the content's.
import { Colour, Space, Radius, Type } from "theme.slint";
import { Label, TextRole, Tone } from "base.slint";
import { WelcomeStyle, Curves } from "welcome.slint";

// A place on the stage, in the window's points.
export struct StageSpot { x: length, y: length, width: length, height: length }

export global StageStyle {
    // The message's two lines, and a screen's title.
    out property <length> title: 64px;
    out property <float> title-share: 0.075;
    out property <length> heading: 40px;
    out property <float> heading-share: 0.052;
    // How far words rise as they arrive.
    out property <length> rise: 18px;
    out property <color> ink: Colour.selected;
    out property <color> ink-soft: Colour.selected.with-alpha(0.72);
    out property <color> ink-faint: Colour.selected.with-alpha(0.45);
    out property <color> ground: Colour.black;
    // The words read over the stage: a size up from the interface's, for a column read from further back.
    out property <length> body: 15px;
    out property <length> lead: 17px;
    // The hook a screen opens on: a sentence in the interface's face, between the lead and the display lines.
    out property <length> hook: 28px;
    // The middle column the gift stands in, as a share of the window's height, and the gap about it.
    out property <float> gift-share: 0.44;
    out property <length> gap: 56px;
    // A demo's frame, its picture's shape, and the edge that holds it on black.
    out property <color> frame-ground: Colour.canvas;
    out property <color> frame-edge: #ffffff1f;
    // A gift's film, its height over its width.
    out property <float> window-shape: 0.625;
    // A film's widest: its own pixels at two a point, never stretched past them on a Retina screen.
    out property <length> film-most: 800px;
    // How far the wheel or the trackpad must move before a screen gives way.
    out property <length> wheel: 4px;
    // The rail of screens at the window's right edge.
    out property <length> rail: 3px;
    out property <length> rail-long: 18px;
    out property <length> rail-short: 8px;
    // Each gift's still, wrapped then opened, where the stage is not drawn (`scripts/welcome-assets`).
    out property <[image]> stills: [
        @image-url("../welcome/gift-0-closed.jpg"), @image-url("../welcome/gift-0-opened.jpg"),
        @image-url("../welcome/gift-1-closed.jpg"), @image-url("../welcome/gift-1-opened.jpg"),
        @image-url("../welcome/gift-2-closed.jpg"), @image-url("../welcome/gift-2-opened.jpg"),
        @image-url("../welcome/gift-3-closed.jpg"), @image-url("../welcome/gift-3-opened.jpg"),
    ];
}

// How far a beat has come: 0 before `from` seconds, 1 once `length` more have passed, landing as a weight.
export global Beat {
    public pure function at(t: float, from: float, length: float) -> float { Curves.settle(max(0, min(1, (t - from) / length))) }
    public pure function glide(t: float, from: float, length: float) -> float { Curves.glide(max(0, min(1, (t - from) / length))) }
}

// The gift on the stage: the GPU's picture, or the gift's still while that is not drawn.
export component StagePicture inherits Rectangle {
    in property <image> source;
    // Bumped when the texture behind `source` is drawn again in place, which changes no property.
    in property <int> revision;
    in property <bool> live;
    // The gift whose still stands in (-1 none), whether it is opened, and how much of it shows.
    in property <int> gift: -1;
    in property <bool> opened;
    in property <float> shown: 1;
    // Where the gift stands across the picture, as a share of its width; the still moves there with it.
    in property <float> middle: 0.5;
    // How far down the picture stands from its place, as it glides with its screen.
    in property <length> offset;
    background: StageStyle.ground;
    if root.live: Image {
        y: root.offset;
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: root.revision < 0 ? ImageFit.contain : ImageFit.fill;
    }
    if !root.live && root.gift >= 0: Image {
        x: (root.middle - 0.5) * parent.width;
        y: root.offset;
        width: parent.width;
        height: parent.height;
        source: StageStyle.stills[root.gift * 2 + (root.opened ? 1 : 0)];
        image-fit: contain;
        opacity: root.shown;
    }
}

// A line of the display face, set as it will stand from the start: it rises into place, nothing else moves.
export component StageLine inherits Rectangle {
    in property <string> text;
    // 0 away to 1 in place.
    in property <float> shown: 1;
    in property <length> size: StageStyle.title;
    in property <bool> centred: true;
    in property <color> tint: StageStyle.ink;
    min-height: line.preferred-height;
    preferred-height: line.preferred-height;
    visible: root.shown > 0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    line := Text {
        accessible-role: none;
        y: (1 - root.shown) * StageStyle.rise;
        width: parent.width;
        text: root.text;
        opacity: root.shown;
        font-family: WelcomeStyle.headline-family;
        font-weight: WelcomeStyle.headline-weight;
        font-size: root.size;
        color: root.tint;
        horizontal-alignment: root.centred ? center : left;
        wrap: word-wrap;
    }
}

// A small line in the interface's face over the stage: an eyebrow, a hint, a gift's tag.
export component StageNote inherits Label {
    in property <float> shown: 1;
    opacity: root.shown;
    visible: root.shown > 0;
    centred: true;
}

// A paragraph read over the stage; `lead` sets it a size up, for the one sentence a screen is told in, `hook` a
// size more and in full ink, for the sentence a screen opens on.
export component StageText inherits Text {
    in property <float> shown: 1;
    in property <bool> centred;
    in property <bool> lead;
    in property <bool> hook;
    opacity: root.shown;
    font-family: Type.family;
    font-size: root.hook ? StageStyle.hook : root.lead ? StageStyle.lead : StageStyle.body;
    font-weight: root.hook ? 600 : 400;
    color: root.hook ? StageStyle.ink : StageStyle.ink-soft;
    wrap: word-wrap;
    horizontal-alignment: root.centred ? center : left;
}

// The frame a screen's demo plays in, cut out of the black.
export component DemoFrame inherits Rectangle {
    in property <float> shown: 1;
    opacity: root.shown;
    visible: root.shown > 0;
    border-radius: Radius.card;
    background: StageStyle.frame-ground;
    clip: true;
    @children
    Rectangle {
        border-radius: Radius.card;
        border-width: 1px;
        border-color: StageStyle.frame-edge;
    }
}

// A film of the real app playing in a demo's frame, a frame at a time.
export component DemoReel inherits Rectangle {
    in property <image> source;
    Image { width: parent.width; height: parent.height; source: root.source; image-fit: cover; }
}

// The screens, one mark each down the window's right edge: the one shown long and lit.
export component StageRail inherits VerticalLayout {
    in property <int> count;
    in property <int> at;
    spacing: Space.xs;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Screen {} of {}", root.at + 1, root.count);
    for screen in root.count: Rectangle {
        width: StageStyle.rail;
        height: screen == root.at ? StageStyle.rail-long : StageStyle.rail-short;
        border-radius: self.width / 2;
        background: screen == root.at ? StageStyle.ink : StageStyle.ink-faint;
    }
}
