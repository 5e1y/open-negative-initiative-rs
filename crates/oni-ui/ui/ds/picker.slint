// The picker: a field naming the value chosen, whose menu drops under it.
import { Colour, Radius, Space, State, ButtonStyle, FieldStyle, MedalStyle } from "theme.slint";
import { Label, Icon, Tone, Tips } from "base.slint";
import { Outside } from "outside.slint";
import { Look } from "button.slint";
import { Icons } from "icons.slint";
import { FormStyle } from "forms.slint";
import { FieldFace } from "fields.slint";
import { MenuLine, Menu } from "menu.slint";
import { KeyScope } from "keyboard.slint";
import { Medal } from "marks.slint";

// A picker's face: `field` set in the panel as a text field is, `pill` a column header's name on the
// canvas's dark, `chip` the Working Space's select among the canvas band's mini keys, in their flat face.
export enum PickerFace { field, pill, chip }

// A field naming the value chosen, a chevron at its end; its words, lines or folders drop under it as a
// menu. The field wears a text field's flat face and the chip a flat key's, edgeless, both lit
// under the hand as a flat key is; a pill lights the hover ground. Every face dims when it is out of reach.
export component Picker inherits HorizontalLayout {
    in property <PickerFace> face: PickerFace.field;
    in property <string> label;
    // Words in the secondary ink after the value, a middle dot between: the chip's gloss on its space.
    in property <string> note;
    in property <string> value;
    // The medal the value names, struck before its words, or alone in their place when `bare`, the words
    // still what assistive tools read; 0 none.
    in property <int> medal;
    in property <bool> bare;
    in property <[string]> entries;
    in property <int> current: -1;
    in property <[MenuLine]> lines;
    in property <bool> enabled: true;
    in property <string> help;
    in property <Look> look: Look.live;
    // Where the field starts, which a menu dropped under it aligns on.
    out property <length> field-x: field.x;
    out property <length> field-width: field.width;
    // The width its menu last dropped at, which the window's checks read.
    out property <length> menu-width;
    // A popup the owner drops itself on `open`, as the Working Space chip's, held as its menu.
    in property <bool> own-popup;
    out property <bool> dropped: menu.is-open || root.own-popup;
    callback open();
    callback chosen(int);
    property <bool> pill: root.face == PickerFace.pill;
    property <bool> chip: root.face == PickerFace.chip;
    property <bool> hovered: root.enabled && (area.has-hover || root.look != Look.live);
    property <bool> as-field: root.face == PickerFace.field;
    // Each face's corner: its face's, its veil's and its focus ring's.
    property <length> corner: root.as-field ? FieldStyle.radius : root.chip ? ButtonStyle.small-radius : Radius.badge;
    // A pill wears the chevron only while it has a menu to drop.
    property <bool> drops: root.entries.length > 0 || root.lines.length > 0;
    // The press its field last took, and the one that closed its menu: a release whose press never
    // came is a click a menu swallowed, which opens this picker, as AppKit's does, unless it closed its own.
    property <int> down-at: -1;
    property <int> closed-at: -1;
    changed dropped => { if (!self.dropped) { root.closed-at = Outside.presses; } }
    function drop() {
        root.open();
        if (root.drops) {
            menu.show();
        }
    }
    spacing: Space.s;
    // A pill or a chip as tall as the mini keys beside it.
    height: root.pill || root.chip ? ButtonStyle.small-height : ButtonStyle.height;
    if root.label != "": Label { text: root.label; }
    field := Rectangle {
        horizontal-stretch: 1;
        border-radius: root.corner;
        // A chip shows its flat key's face only under the hand or while its popup is open, bare at rest.
        background: root.as-field ? Colour.hover.transparentize(1) : root.chip ? (root.hovered || root.dropped ? ButtonStyle.face : ButtonStyle.face.transparentize(1)) : root.hovered ? Colour.hover : Colour.canvas;
        opacity: root.enabled ? 1 : State.disabled;
        accessible-role: button;
        accessible-label: root.note != "" ? root.value + " · " + root.note : root.value;
        accessible-enabled: root.enabled;
        // As wide as its words on a chip, eliding them once its room is short.
        preferred-width: row.preferred-width;
        if root.as-field: FieldFace { }
        if (root.as-field || root.chip) && root.hovered: Rectangle {
            border-radius: root.corner;
            background: area.pressed || root.look == Look.pressed ? ButtonStyle.veil-pressed : ButtonStyle.veil;
        }
        row := HorizontalLayout {
            padding-left: root.as-field ? FieldStyle.across : Space.s;
            padding-right: root.as-field ? FieldStyle.across : Space.s;
            spacing: root.chip ? Space.xs : Space.s;
            // Alone, the medal's room stretches as the words' would, so a pill spanning its row still spans it.
            if root.medal > 0: Rectangle {
                horizontal-stretch: root.bare ? 1 : 0;
                min-width: MedalStyle.size;
                preferred-width: MedalStyle.size;
                Medal { rank: root.medal; x: 0; y: (parent.height - self.height) / 2; }
            }
            // Short of room, the gloss gives way before the value.
            if root.medal == 0 || !root.bare: Label { text: root.value; horizontal-stretch: root.note != "" ? 0 : 1; overflow: elide; }
            if root.note != "": Label { text: "·"; tone: Tone.secondary; }
            if root.note != "": Label { text: root.note; tone: Tone.secondary; horizontal-stretch: 1; overflow: elide; }
            if root.chip || root.as-field || (root.pill && root.drops): VerticalLayout {
                alignment: center;
                Icon { source: Icons.chevron-down; width: FormStyle.chip-icon; height: self.width; }
            }
        }
        // Hovered even when it opens nothing, so the path a pill names still shows as its note.
        area := TouchArea {
            enabled: root.enabled;
            clicked => { root.drop(); }
            pointer-event(event) => {
                if (event.button != PointerEventButton.left) { return; }
                if (event.kind == PointerEventKind.down) { root.down-at = Outside.presses; }
                if (event.kind == PointerEventKind.up && root.down-at != Outside.presses && root.closed-at != Outside.presses) { root.drop(); }
            }
            changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
        }
        // Space, Return or ↓ drops its menu while it holds the keyboard.
        KeyScope {
            enabled: root.enabled;
            radius: root.corner;
            key-pressed(event) => {
                if ((event.text != " " && event.text != Key.Return && event.text != Key.DownArrow) || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                    return reject;
                }
                if (!event.repeat) { root.drop(); }
                accept
            }
        }
    }
    menu := Menu {
        x: root.field-x;
        y: root.height + Space.xxs;
        // As wide as its select; past it only where a word would otherwise be cut.
        span: max(root.field-width, self.natural);
        dropped(width) => { root.menu-width = width; }
        entries: root.entries;
        current: root.current;
        lines: root.lines;
        chosen(i) => { root.chosen(i); self.close(); }
    }
}
