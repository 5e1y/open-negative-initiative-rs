// What a line of a right-click menu does, drawn before its words; a select's lines wear none.
export enum MenuGlyph { none, edit, copy, paste, reset, roll, folder, ungroup, project, add, remove, export, reveal, parent, trash, restore, open, favourite, new-folder, update, code, warning }

// The Trinil glyphs the shell draws (MIT, its LICENSE beside them), named by what they mean here as
// `DSIcon.Name` does; Mirror Vertically turns Trinil's mirror a quarter, the set drawing no vertical one.
export global Icons {
    out property <image> framing: @image-url("../icons/crop.svg");
    out property <image> compare: @image-url("../icons/arrow-expand-vertical.svg");
    out property <image> contact-sheet: @image-url("../icons/orthographic-view.svg");
    out property <image> undo: @image-url("../icons/undo.svg");
    out property <image> redo: @image-url("../icons/redo.svg");
    out property <image> copy: @image-url("../icons/copy.svg");
    out property <image> paste: @image-url("../icons/paste.svg");
    out property <image> correction: @image-url("../icons/bandage.svg");
    out property <image> done: @image-url("../icons/check.svg");
    out property <image> remove: @image-url("../icons/trash.svg");
    out property <image> export: @image-url("../icons/share-ios.svg");
    out property <image> question: @image-url("../icons/question.svg");
    out property <image> offline: @image-url("../icons/offline.svg");
    out property <image> chevron-left: @image-url("../icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("../icons/chevron-right.svg");
    out property <image> back: @image-url("../icons/arrow-left.svg");
    out property <image> edit: @image-url("../icons/pencil.svg");
    out property <image> prepare: @image-url("../icons/speed.svg");
    out property <image> update: @image-url("../icons/download.svg");
    out property <image> chevron-down: @image-url("../icons/chevron-down.svg");
    out property <image> folder: @image-url("../icons/folder.svg");
    out property <image> folder-open: @image-url("../icons/folder-open.svg");
    out property <image> add-folder: @image-url("../icons/folder-plus.svg");
    out property <image> favourite: @image-url("../icons/star.svg");
    out property <image> filter: @image-url("../icons/filter.svg");
    out property <image> parent: @image-url("../icons/arrow-up.svg");
    out property <image> film-roll: @image-url("../icons/film-roll.svg");
    out property <image> film: @image-url("../icons/film.svg");
    out property <image> sticky-note: @image-url("../icons/sticky-note.svg");
    out property <image> rotate: @image-url("../icons/rotate-90.svg");
    out property <image> mirror: @image-url("../icons/mirror.svg");
    out property <image> mirror-vertically: @image-url("../icons/mirror-vertical.svg");
    out property <image> warning: @image-url("../icons/warning.svg");
    out property <image> reset: @image-url("../icons/history.svg");
    out property <image> feedback: @image-url("../icons/bug.svg");
    out property <image> archive: @image-url("../icons/archive.svg");
    out property <image> arrow-right: @image-url("../icons/arrow-right.svg");
    // The app's Settings alone; a block's own options wear `options`.
    out property <image> settings: @image-url("../icons/gear.svg");
    out property <image> options: @image-url("../icons/sliders-horizontal.svg");
    out property <image> phone: @image-url("../icons/phone.svg");
    // The white balance key the help card's demo presses; one meaning, so no other key draws it.
    out property <image> target: @image-url("../icons/target.svg");
    out property <image> reveal: @image-url("../icons/folder-search.svg");
    out property <image> list: @image-url("../icons/list.svg");
    out property <image> gallery: @image-url("../icons/layout-grid.svg");
    out property <image> single: @image-url("../icons/square-rounded.svg");
    out property <image> expand-all: @image-url("../icons/arrow-expand.svg");
    out property <image> collapse-all: @image-url("../icons/arrow-collapse.svg");
    out property <image> menu-left: @image-url("../icons/menu-left.svg");
    out property <image> menu-right: @image-url("../icons/menu-right.svg");
    out property <image> zoom-out: @image-url("../icons/minus.svg");
    out property <image> zoom-in: @image-url("../icons/plus.svg");
    public pure function line(glyph: MenuGlyph) -> image {
        if (glyph == MenuGlyph.edit) { return Icons.edit; }
        if (glyph == MenuGlyph.copy) { return Icons.copy; }
        if (glyph == MenuGlyph.paste) { return Icons.paste; }
        if (glyph == MenuGlyph.reset) { return Icons.reset; }
        if (glyph == MenuGlyph.roll) { return Icons.film-roll; }
        if (glyph == MenuGlyph.folder) { return Icons.folder; }
        if (glyph == MenuGlyph.ungroup) { return Icons.expand-all; }
        if (glyph == MenuGlyph.project) { return Icons.sticky-note; }
        if (glyph == MenuGlyph.add) { return Icons.zoom-in; }
        if (glyph == MenuGlyph.remove) { return Icons.zoom-out; }
        if (glyph == MenuGlyph.export) { return Icons.export; }
        if (glyph == MenuGlyph.reveal) { return Icons.reveal; }
        if (glyph == MenuGlyph.parent) { return Icons.parent; }
        if (glyph == MenuGlyph.trash) { return Icons.remove; }
        if (glyph == MenuGlyph.restore) { return Icons.undo; }
        if (glyph == MenuGlyph.open) { return Icons.folder-open; }
        if (glyph == MenuGlyph.favourite) { return Icons.favourite; }
        if (glyph == MenuGlyph.new-folder) { return Icons.add-folder; }
        if (glyph == MenuGlyph.update) { return Icons.update; }
        if (glyph == MenuGlyph.code) { return Icons.list; }
        Icons.warning
    }
}
