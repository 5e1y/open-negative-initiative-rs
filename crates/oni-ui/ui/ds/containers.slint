// The containers: a block's section, the help mark, the sheet and its footer, the question a sheet
// asks; the notice that passes and the banner that stays are `notices.slint`'s.
import { Colour, Space, Motion, ButtonStyle, SectionStyle, SheetStyle } from "theme.slint";
import { Label, Engraved, Divider, TextRole, Tip, Tips, Raised, Lift, Gap, Tones } from "base.slint";
import { Badge, BadgeTone } from "badge.slint";
import { Button, ButtonKind, ButtonSize, TextField } from "controls.slint";
import { Scroller } from "scroller.slint";
import { Icons } from "icons.slint";
import { Keyboard } from "keyboard.slint";

// The "?" beside a title, always shown: a ghost key whose card stands while the hand rests on it, or the
// keyboard presses it, and goes as the hand leaves; lit while its card stands, named with what it explains.
export component HelpMark inherits Rectangle {
    in property <string> note;
    // The help topic whose demo the card plays, none for a note alone.
    in property <string> demo;
    // What the note explains, as its title says it.
    in property <string> subject;
    property <bool> open: Tip.open == root.note;
    width: SectionStyle.help-mark;
    height: self.width;
    // As large as the key's catch, a small key's square round the glyph.
    hand := TouchArea {
      x: (parent.width - self.width) / 2;
      y: (parent.height - self.height) / 2;
      width: ButtonStyle.small-height;
      height: self.width;
      changed has-hover => {
          if (self.has-hover) { Tips.help(root.note, root.demo, root.subject); } else { Tips.unhelp(root.note); }
      }
      mark := Button {
        width: parent.width;
        height: parent.height;
        size: ButtonSize.mini;
        kind: ButtonKind.ghost;
        has-icon: true;
        icon: Icons.question;
        glyph-size: SectionStyle.help-mark;
        glyph-ink: root.open ? Colour.ink : transparent;
        // Its card says it all: no tip besides, the name kept for assistive tools.
        accessible-label: @tr("Help on {}", root.subject);
        expandable: true;
        expanded: root.open;
        clicked => { Tips.help(root.note, root.demo, root.subject); }
      }
    }
}

// The tree's disclosure before a block's title, the app's one look for folding: a bare chevron, down
// while open, laid at its glyph's width, the hand caught over a small key's square.
component FoldMark inherits Rectangle {
    in property <string> subject;
    in property <bool> folded;
    callback toggled();
    width: SectionStyle.fold;
    Button {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.height;
        size: ButtonSize.mini;
        kind: ButtonKind.ghost;
        has-icon: true;
        icon: root.folded ? Icons.chevron-right : Icons.chevron-down;
        glyph-size: SectionStyle.fold;
        // In the primary ink, as the tree's: its line is a single pixel, which a quieter ink leaves under 3:1.
        glyph-ink: Colour.ink;
        help: root.folded ? @tr("Show {}", root.subject) : @tr("Hide {}", root.subject);
        expandable: true;
        expanded: !root.folded;
        clicked => { root.toggled(); }
    }
}

// `DSSection`: a rule above every block, then a title row, its fold's chevron first and its reset at
// the far end, then the block. Every block of the editor's panel has a note.
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    // The help topic whose demo the note's card plays, none for a note alone.
    in property <string> demo;
    // `DSNewsPill`: the word while the block's note is news, and the note itself.
    in property <string> news;
    in property <string> news-note;
    callback news-read();
    in property <int> block: -1;
    in property <bool> modified;
    in property <bool> separated: true;
    // A page of settings lays its sections open, with no key to fold them.
    in property <bool> foldable: true;
    in property <length> inset: SectionStyle.inset;
    in property <length> before: SectionStyle.before;
    in-out property <bool> folded;
    // What the block opens as before the hand ever folds it, `.folded(byDefault:)`.
    in property <bool> folded-by-default;
    callback reset(int);
    // The hand's fold, which `sectionFold.<title>` remembers.
    callback fold-toggled(bool);
    function fold() {
        root.folded = !root.folded;
        root.fold-toggled(root.folded);
    }
    // The hand anywhere on the block, its title, its controls and the room between: its rails of hues
    // show whole, read by the sliders laid in it.
    out property <bool> hovered: body.has-hover;
    if root.separated: Divider { }
    body := TouchArea {
      VerticalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        padding-top: root.before;
        padding-bottom: SectionStyle.after;
        spacing: 0;
        if root.title != "": HorizontalLayout {
            spacing: Space.s;
            // A key's height whether the reset shows or not, so the block never moves as it comes and goes.
            min-height: root.foldable || root.block >= 0 ? ButtonStyle.small-height : 0px;
            if root.foldable: FoldMark { subject: root.title; folded: root.folded; toggled => { root.fold(); } }
            // On a short row the title yields, so the reset keeps to the column's edge.
            Engraved {
                horizontal-stretch: 0;
                min-width: 0;
                role: TextRole.section;
                text: root.title;
                overflow: elide;
                // A click on the title folds the block where it folds.
                TouchArea { clicked => { if (root.foldable) { root.fold(); } } }
            }
            if root.help != "": VerticalLayout {
                alignment: center;
                HelpMark { note: root.help; demo: root.demo; subject: root.title; }
            }
            if root.news != "": VerticalLayout {
                alignment: center;
                Badge { tone: BadgeTone.seal; text: root.news; note: root.news-note; read => { root.news-read(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            // Only while the block stands off its rest, at the far end, the whole title between it and the fold.
            if root.block >= 0 && root.modified: Button {
                size: ButtonSize.mini;
                horizontal-stretch: 0;
                text: @tr("Reset");
                clicked => { root.reset(root.block); }
            }
        }
        // Folded, the content keeps its place in the tree at zero height, so its state survives. Clipped
        // only then: a well's lit lip and a raised face's shadow lie past the last child's bounds.
        Rectangle {
            height: root.folded && root.title != "" ? 0px : content.preferred-height;
            clip: root.folded && root.title != "";
            content := VerticalLayout {
                width: parent.width;
                spacing: SectionStyle.gap;
                padding-top: root.title != "" ? SectionStyle.gap : 0px;
                @children
            }
        }
      }
    }
}

// How a sheet titles itself: `leading`, its title over the content in the section face for a
// question, the title face else; `bar`, the title beside its exit key above a rule, as a board's.
export enum SheetHeader { leading, bar }

// A window-modal sheet over a scrim that sets the window back, centred across and resting a little above
// the middle, a margin kept above and below; it comes in as one, the scrim darkening as the card rises
// into place. A click beside the card reaches nothing; its default key holds Return, Escape closes it.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <SheetHeader> header: SheetHeader.leading;
    // `DSDialogPanel`'s question: its title in the section face, a full sheet's in the title face.
    in property <bool> question;
    // The bar's key, which dismisses the sheet.
    in property <string> exit: @tr("Done");
    in property <bool> wide;
    // A gauge of its own, as the notices' and the catch-up's; zero takes the plain or wide one.
    in property <length> card-width;
    // Zero fits the card to its content, which scrolls past the window's room (`WelcomeSheet`'s
    // fit); else the card is that tall at most, its content laid in the height it shows.
    in property <length> card-height;
    // Edge to edge: the content carries its own padding, as the welcome's photo touches the card.
    in property <bool> bleed;
    // The step between the content's groups; a notice's are a wider step apart.
    in property <Gap> gap: Gap.m;
    callback dismissed();
    // Return on a sheet whose default key would scroll away or that has none.
    callback returned();
    // A sheet of pages, as the welcome: the arrow keys turn them, `paged` by one forward or back.
    in property <bool> paging;
    callback paged(int);
    // The height the sheet takes, its margins included, in a room that holds it whole.
    out property <length> hung-height: (root.card-height > 0 ? root.card-height : column.preferred-height) + 2 * SheetStyle.margin;
    property <bool> fixed: root.card-height > 0;
    // The card's width as laid: its gauge, or the window's room under it.
    out property <length> shown-width: card.width;
    property <bool> edge: root.bleed || root.header == SheetHeader.bar;
    property <float> come;
    init => { root.come = 1; }
    animate come { duration: Motion.overlay-in; easing: ease-out; }
    Rectangle { width: 100%; height: 100%; background: Colour.scrim; opacity: root.come; }
    TouchArea { }
    // Tab leaving the sheet meets the window's walls, which hand the keyboard back to the sheet: to this
    // scope going forward, so Tab goes on to its first control, to `back` going back, before its last.
    property <int> entered: Keyboard.entered;
    changed entered => { scope.focus(); }
    property <int> entered-back: Keyboard.entered-back;
    changed entered-back => { back.focus(); }
    // A field's Escape bubbles here: the window's key monitor is the sheet's sibling, never its parent.
    scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // Shown, it holds the keyboard, its field or default key taking it next: no key reaches behind it.
        init => {
            if (!TextInputInterface.text-input-focused) { self.focus(); }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (event.text == Key.Return) {
                root.returned();
                return accept;
            }
            if (root.paging && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                root.paged(event.text == Key.RightArrow ? 1 : -1);
                return accept;
            }
            reject
        }
        card := Raised {
            lift: Lift.sheet;
            y: (root.height - self.height) * SheetStyle.rest + (1 - root.come) * SheetStyle.rise;
            opacity: root.come;
            width: min(root.card-width > 0 ? root.card-width : root.wide ? SheetStyle.wide-width : SheetStyle.width, root.width - 2 * SheetStyle.margin);
            height: min(root.fixed ? root.card-height : column.preferred-height, root.height - 2 * SheetStyle.margin);
            Scroller {
                content-height: root.fixed ? self.visible-height : column.preferred-height;
                column := VerticalLayout {
                    width: card.width;
                    height: root.fixed ? card.height : self.preferred-height;
                    padding: root.edge ? 0px : SheetStyle.padding;
                    spacing: root.edge ? 0px : Tones.gap(root.gap);
                    if root.header == SheetHeader.leading && root.title != "": Engraved {
                        role: root.question ? TextRole.section : TextRole.title;
                        text: root.title;
                        wrap: word-wrap;
                    }
                    if root.header == SheetHeader.bar: HorizontalLayout {
                        padding: Space.m;
                        padding-left: SheetStyle.padding;
                        padding-right: SheetStyle.padding;
                        Engraved { text: root.title; role: TextRole.title; horizontal-stretch: 1; }
                        Button { text: root.exit; keycap: true; kind: ButtonKind.accent; default: true; clicked => { root.dismissed(); } }
                    }
                    if root.header == SheetHeader.bar: Divider { }
                    @children
                }
            }
        }
        back := FocusScope { focus-on-click: false; focus-on-tab-navigation: false; }
    }
}

// Every sheet's last row: the key that leaves at the left, what the sheet adds beside it, then apart at
// the right a step back and the commit alone, the accent keycap unless it writes nothing. Too narrow for
// its keys on one line, as a panel's in a longer language, it lays the commit on a line of its own under them.
export component SheetFooter inherits VerticalLayout {
    in property <string> cancel;
    in property <string> back;
    in property <string> commit;
    in property <bool> commit-enabled: true;
    // The commit is its sheet's default key, holding the keyboard as it opens: never a panel's, under the
    // sheets, nor one at the foot of a sheet read from its top, which the keyboard would scroll away.
    in property <bool> default-commit: true;
    // A commit that writes nothing, as a failure's OK: a flat key.
    in property <bool> passes;
    // A key that removes, as a preset's Delete: alone at the left end, what the sheet adds then beside
    // the commit, so it never shares a group with a key that keeps.
    in property <string> remove;
    in property <bool> remove-enabled: true;
    callback cancelled();
    callback backed();
    callback committed();
    callback removed();
    // A choice whose commit is a keycap has every key a keycap, those beside it on the ground's face.
    property <bool> capped: root.commit != "" && !root.passes;
    // The keys on one line, unseen and of no height: whether they fit never follows the lines it lays.
    measure := HorizontalLayout {
        visible: false;
        height: 0px;
        spacing: ButtonStyle.group-gap;
        if root.remove != "": Button { text: root.remove; keycap: root.capped; }
        if root.remove != "": Rectangle { width: 0px; }
        if root.cancel != "": Button { text: root.cancel; keycap: root.capped; }
        Rectangle { width: 0px; }
        if root.back != "": Button { text: root.back; keycap: root.capped; }
        if root.commit != "": Button { text: root.commit; keycap: root.capped; }
    }
    property <bool> stacked: root.width < measure.preferred-width;
    VerticalLayout {
        spacing: ButtonStyle.group-gap;
        HorizontalLayout {
            spacing: ButtonStyle.group-gap;
            cross-axis-alignment: center;
            if root.remove != "": Button { text: root.remove; kind: ButtonKind.destructive; keycap: root.capped; ground: Colour.ground; enabled: root.remove-enabled; clicked => { root.removed(); } }
            if root.remove != "": Rectangle { horizontal-stretch: 1; }
            if root.cancel != "": Button { text: root.cancel; keycap: root.capped; ground: Colour.ground; clicked => { root.cancelled(); } }
            @children
            // Two gaps at the least, so what leaves never reads as one group with what commits.
            Rectangle { horizontal-stretch: root.remove == "" ? 1 : 0; }
            if root.back != "": Button { text: root.back; keycap: root.capped; ground: Colour.ground; clicked => { root.backed(); } }
            if root.commit != "" && !root.stacked: Button {
                text: root.commit;
                keycap: root.capped;
                kind: root.passes ? ButtonKind.plain : ButtonKind.accent;
                enabled: root.commit-enabled;
                default: root.default-commit;
                clicked => { root.committed(); }
            }
        }
        if root.commit != "" && root.stacked: Button {
            text: root.commit;
            keycap: root.capped;
            kind: root.passes ? ButtonKind.plain : ButtonKind.accent;
            fills: true;
            enabled: root.commit-enabled;
            default: root.default-commit;
            clicked => { root.committed(); }
        }
    }
}

// What a key of a question does, as `DSDialogRequest.Role`: `confirm` is the default and tinted,
// `destructive` red and deaf to Return, `option` neutral and deaf to Return, so no choice is a reflex.
export enum AskRole { confirm, destructive, option }

export struct AskKey { text: string, role: AskRole }

// `DSDialogPanel`: a question as a sheet, its message, a field when it asks for a word, then every sheet's
// footer: Cancel at the left, apart at the right its keys, the confirm an accent keycap, a destructive one
// red and apart from those beside it. `answered` gives the key's place, -1 for Cancel and Escape, with the
// field's text; Return in the field presses `default-key`.
export component AskSheet inherits Sheet {
    in property <string> message;
    in property <bool> field;
    in property <string> placeholder;
    in-out property <string> text;
    // Drawn first; empty when a key of `keys` stands in for it.
    in property <string> cancel;
    in property <[AskKey]> keys;
    in property <int> default-key: -1;
    callback answered(int, string);
    // A question whose confirm is a keycap has every key a keycap, the others on the ground's face; it asks
    // four keys at the most.
    property <bool> capped: (root.keys.length > 0 && root.keys[0].role == AskRole.confirm) || (root.keys.length > 1 && root.keys[1].role == AskRole.confirm)
        || (root.keys.length > 2 && root.keys[2].role == AskRole.confirm) || (root.keys.length > 3 && root.keys[3].role == AskRole.confirm);
    question: true;
    dismissed => { root.answered(-1, ""); }
    if root.message != "": Label { role: TextRole.note; text: root.message; }
    if root.field: TextField {
        text <=> root.text;
        placeholder: root.placeholder;
        accepted(typed) => { root.answered(root.default-key, typed); }
        init => { self.take-focus(); }
    }
    HorizontalLayout {
        spacing: ButtonStyle.group-gap;
        cross-axis-alignment: center;
        if root.cancel != "": Button { text: root.cancel; keycap: root.capped; ground: Colour.ground; clicked => { root.answered(-1, ""); } }
        Rectangle { horizontal-stretch: 1; }
        // A key that removes stands apart from the key before it and the key after it.
        for key[i] in root.keys: HorizontalLayout {
            property <bool> beside: key.role == AskRole.destructive || root.keys[max(0, i - 1)].role == AskRole.destructive;
            padding-left: i > 0 && self.beside ? ButtonStyle.apart - ButtonStyle.group-gap : 0px;
            Button {
                text: key.text;
                keycap: root.capped;
                ground: Colour.ground;
                kind: key.role == AskRole.confirm ? ButtonKind.accent : key.role == AskRole.destructive ? ButtonKind.destructive : ButtonKind.plain;
                default: key.role == AskRole.confirm;
                clicked => { root.answered(i, root.text); }
            }
        }
    }
}
