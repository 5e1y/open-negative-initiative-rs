// The containers: a block's section, the help mark, the sheet and the question a sheet asks.
import { Colour, Space, Stroke, State, Motion, ButtonStyle, SectionStyle, SheetStyle, MenuStyle } from "theme.slint";
import { Label, Icon, Divider, TextRole, Tone, Tips, Raised, Lift, Gap, Tones } from "base.slint";
import { Badge, BadgeTone } from "badge.slint";
import { Button, ButtonKind, ButtonSize, Look, ButtonGroup, GroupAlign, TextField } from "controls.slint";
import { Scroller } from "collections.slint";
import { Icons } from "icons.slint";

// The "?" beside a block's title: a ghost key whose note shows as a card.
export component HelpMark inherits Button {
    kind: ButtonKind.ghost;
    has-icon: true;
    icon: Icons.question;
    glyph-size: SectionStyle.help-mark;
    width: SectionStyle.help-mark + 2 * Space.xxs;
    height: self.width;
    accessible-label: @tr("What this block does");
}

// `DSSection`: a rule above every block, then a title row with its note, reset and fold keys.
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    // `DSNewsPill`: the word while the block's note is news, and the note itself.
    in property <string> news;
    in property <string> news-note;
    callback news-read();
    in property <int> block: -1;
    in property <bool> modified;
    in property <bool> separated: true;
    // A page of settings lays its sections open, with no key to fold them.
    in property <bool> foldable: true;
    in property <length> inset: SectionStyle.inset;
    in property <length> before: SectionStyle.before;
    in-out property <bool> folded;
    // What the block opens as before the hand ever folds it, `.folded(byDefault:)`.
    in property <bool> folded-by-default;
    callback reset(int);
    // The hand's fold, which `sectionFold.<title>` remembers.
    callback fold-toggled(bool);
    if root.separated: Divider { }
    VerticalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        padding-top: root.before;
        padding-bottom: SectionStyle.after;
        spacing: 0;
        if root.title != "": HorizontalLayout {
            spacing: Space.s;
            Label {
                role: TextRole.section;
                text: root.title;
                if root.foldable: TouchArea { clicked => { root.folded = !root.folded; root.fold-toggled(root.folded); } }
            }
            if root.help != "": VerticalLayout {
                alignment: center;
                HelpMark { note: root.help; }
            }
            if root.news != "": VerticalLayout {
                alignment: center;
                Badge { tone: BadgeTone.seal; text: root.news; note: root.news-note; read => { root.news-read(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            // Always laid out, only invisible, so the row keeps its height on a slider's first touch.
            if root.block >= 0: Button {
                size: ButtonSize.small;
                horizontal-stretch: 0;
                text: @tr("RESET");
                visible: root.modified;
                enabled: root.modified;
                clicked => { root.reset(root.block); }
            }
            if root.foldable: Button {
                size: ButtonSize.small;
                has-icon: true;
                square: true;
                horizontal-stretch: 0;
                icon: root.folded ? Icons.chevron-right : Icons.chevron-down;
                help: root.folded ? @tr("Show {}", root.title) : @tr("Hide {}", root.title);
                clicked => { root.folded = !root.folded; root.fold-toggled(root.folded); }
            }
        }
        // Folded, the content keeps its place in the tree at zero height, so its state survives.
        Rectangle {
            height: root.folded && root.title != "" ? 0px : content.preferred-height;
            clip: true;
            content := VerticalLayout {
                width: parent.width;
                spacing: SectionStyle.gap;
                padding-top: root.title != "" ? SectionStyle.gap : 0px;
                @children
            }
        }
    }
}

// How a sheet titles itself: `leading`, its title over the content in the section face for a
// question, the title face else; `bar`, the title beside its exit key above a rule, as a board's.
export enum SheetHeader { leading, bar }

// A window-modal sheet hung from the window's top; no scrim is drawn, yet a click beside the card
// reaches nothing, as Swift's sheet ignores it. Escape closes it.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <SheetHeader> header: SheetHeader.leading;
    // `DSDialogPanel`'s question: its title in the section face, a full sheet's in the title face.
    in property <bool> question;
    // The bar's key, which dismisses the sheet.
    in property <string> exit: @tr("Done");
    in property <bool> wide;
    // A gauge of its own, as the notices' and the catch-up's; zero takes the plain or wide one.
    in property <length> card-width;
    // Zero fits the card to its content, which scrolls past the window's room (`WelcomeSheet`'s
    // fit); else the card is that tall at most, its content laid in the height it shows.
    in property <length> card-height;
    // Edge to edge: the content carries its own padding, as the welcome's photo touches the card.
    in property <bool> bleed;
    // The step between the content's groups; a notice's are a wider step apart.
    in property <Gap> gap: Gap.m;
    callback dismissed();
    // The height the sheet takes hung in a room that holds it whole.
    out property <length> hung-height: (root.card-height > 0 ? root.card-height : column.preferred-height) + 2 * SheetStyle.margin;
    property <bool> fixed: root.card-height > 0;
    property <bool> edge: root.bleed || root.header == SheetHeader.bar;
    TouchArea { }
    // A field's Escape bubbles here: the window's key monitor is the sheet's sibling, never its parent.
    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }
        card := Raised {
            lift: Lift.sheet;
            y: SheetStyle.margin;
            width: root.card-width > 0 ? root.card-width : root.wide ? SheetStyle.wide-width : SheetStyle.width;
            height: min(root.fixed ? root.card-height : column.preferred-height, root.height - 2 * SheetStyle.margin);
            Scroller {
                content-height: root.fixed ? self.visible-height : column.preferred-height;
                column := VerticalLayout {
                    width: card.width;
                    height: root.fixed ? card.height : self.preferred-height;
                    padding: root.edge ? 0px : SheetStyle.padding;
                    spacing: root.edge ? 0px : Tones.gap(root.gap);
                    if root.header == SheetHeader.leading && root.title != "": Label {
                        role: root.question ? TextRole.section : TextRole.title;
                        text: root.title;
                        wrap: word-wrap;
                    }
                    if root.header == SheetHeader.bar: HorizontalLayout {
                        padding: Space.m;
                        padding-left: SheetStyle.padding;
                        padding-right: SheetStyle.padding;
                        Label { text: root.title; role: TextRole.title; horizontal-stretch: 1; }
                        Button { text: root.exit; clicked => { root.dismissed(); } }
                    }
                    if root.header == SheetHeader.bar: Divider { }
                    @children
                }
            }
        }
    }
}

// What a key of a question does, as `DSDialogRequest.Role`: `confirm` is the default and tinted,
// `destructive` red and deaf to Return, `option` neutral and deaf to Return, so no choice is a reflex.
export enum AskRole { confirm, destructive, option }

export struct AskKey { text: string, role: AskRole }

// `DSDialogPanel`: a question as a sheet, its message, a field when it asks for a word, then Cancel
// and its keys on one plate at the end. `answered` gives the key's place, -1 for Cancel and Escape,
// with the field's text; Return in the field presses `default-key`.
export component AskSheet inherits Sheet {
    in property <string> message;
    in property <bool> field;
    in property <string> placeholder;
    in-out property <string> text;
    // Drawn first; empty when a key of `keys` stands in for it.
    in property <string> cancel;
    in property <[AskKey]> keys;
    in property <int> default-key: -1;
    callback answered(int, string);
    question: true;
    dismissed => { root.answered(-1, ""); }
    if root.message != "": Label { text: root.message; tone: Tone.secondary; wrap: word-wrap; }
    if root.field: TextField {
        text <=> root.text;
        placeholder: root.placeholder;
        accepted(typed) => { root.answered(root.default-key, typed); }
        init => { self.take-focus(); }
    }
    ButtonGroup { plate: true; align: GroupAlign.end;
        if root.cancel != "": Button { text: root.cancel; clicked => { root.answered(-1, ""); } }
        for key[i] in root.keys: Button {
            text: key.text;
            kind: key.role == AskRole.confirm ? ButtonKind.accent : key.role == AskRole.destructive ? ButtonKind.destructive : ButtonKind.plain;
            clicked => { root.answered(i, root.text); }
        }
    }
}

// A transient notice: what a gesture could not do, laid low over every view without stopping the
// hand; it leaves by its key or after `SheetStyle.linger`, held while the pointer rests on it.
export component Toast inherits Rectangle {
    in property <string> title;
    in property <string> message;
    // A key acting on what the notice names, as Show in Finder; empty for none.
    in property <string> action;
    // Bumped by each notice, so one replacing another stays its whole time.
    in property <int> serial;
    // The window's room, the notice centred low in it.
    in property <length> room;
    in property <length> room-height;
    callback acted();
    callback closed();
    width: min(SheetStyle.notice-width, root.room - 2 * SheetStyle.margin);
    height: card.height;
    x: (root.room - self.width) / 2;
    y: root.room-height - self.height - SheetStyle.margin;
    changed serial => { linger.restart(); }
    linger := Timer {
        interval: SheetStyle.linger;
        running: !hover.has-hover;
        triggered => { root.closed(); }
    }
    hover := TouchArea {
        card := Raised {
            lift: Lift.sheet;
            pad: Gap.m;
            gap: Gap.s;
            width: root.width;
            if root.title != "": Label { role: TextRole.section; text: root.title; wrap: word-wrap; }
            Label { text: root.message; tone: Tone.secondary; wrap: word-wrap; }
            ButtonGroup { plate: true; align: GroupAlign.end;
                if root.action != "": Button { text: root.action; clicked => { root.acted(); } }
                Button { text: @tr("OK"); kind: ButtonKind.accent; clicked => { root.closed(); } }
            }
        }
    }
}
