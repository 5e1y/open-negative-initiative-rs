// The containers: a block's section, the help mark, the sheet and the menu.
import { NewsSeal } from "help.slint";
import { Colour, Space, Stroke, State, Motion, ButtonStyle, SectionStyle, SheetStyle, MenuStyle } from "theme.slint";
import { Label, Icon, Divider, TextRole, Tone, Tips } from "base.slint";
import { Button, ButtonSize, Look, KeyPlate } from "controls.slint";
import { Scroller } from "collections.slint";
import { Icons } from "icons.slint";

// The "?" beside a block's title; its note shows as the tooltip.
export component HelpMark inherits Rectangle {
    in property <string> note;
    in property <Look> look: Look.live;
    width: SectionStyle.help-mark + 2 * Space.xxs;
    height: self.width;
    accessible-role: button;
    accessible-label: @tr("What this block does");
    Icon {
        source: Icons.question;
        tone: area.has-hover || root.look != Look.live ? Tone.secondary : Tone.tertiary;
        width: SectionStyle.help-mark;
        height: SectionStyle.help-mark;
    }
    area := TouchArea {
        changed has-hover => { Tips.note(self.has-hover, root.note, root.absolute-position.x, root.absolute-position.y + root.height); }
    }
}

// `DSSection`: a rule above every block, then a title row with its note, reset and fold keys.
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    // `DSNewsPill`: the word while the block's note is news, and the note itself.
    in property <string> news;
    in property <string> news-note;
    callback news-read();
    in property <int> block: -1;
    in property <bool> modified;
    in property <bool> separated: true;
    // A page of settings lays its sections open, with no key to fold them.
    in property <bool> foldable: true;
    in property <length> inset: SectionStyle.inset;
    in property <length> before: SectionStyle.before;
    in-out property <bool> folded;
    // What the block opens as before the hand ever folds it, `.folded(byDefault:)`.
    in property <bool> folded-by-default;
    callback reset(int);
    // The hand's fold, which `sectionFold.<title>` remembers.
    callback fold-toggled(bool);
    if root.separated: Divider { }
    VerticalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        padding-top: root.before;
        padding-bottom: SectionStyle.after;
        spacing: 0;
        if root.title != "": HorizontalLayout {
            spacing: Space.s;
            Label {
                role: TextRole.section;
                text: root.title;
                if root.foldable: TouchArea { clicked => { root.folded = !root.folded; root.fold-toggled(root.folded); } }
            }
            if root.help != "": VerticalLayout {
                alignment: center;
                HelpMark { note: root.help; }
            }
            if root.news != "": VerticalLayout {
                alignment: center;
                NewsSeal { word: root.news; note: root.news-note; read => { root.news-read(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            // Always laid out, only invisible, so the row keeps its height on a slider's first touch.
            if root.block >= 0: Button {
                size: ButtonSize.small;
                horizontal-stretch: 0;
                text: @tr("RESET");
                visible: root.modified;
                enabled: root.modified;
                clicked => { root.reset(root.block); }
            }
            if root.foldable: Button {
                size: ButtonSize.small;
                has-icon: true;
                width: self.height;
                horizontal-stretch: 0;
                icon: root.folded ? Icons.chevron-right : Icons.chevron-down;
                help: root.folded ? @tr("Show {}", root.title) : @tr("Hide {}", root.title);
                clicked => { root.folded = !root.folded; root.fold-toggled(root.folded); }
            }
        }
        // Folded, the content keeps its place in the tree at zero height, so its state survives.
        Rectangle {
            height: root.folded && root.title != "" ? 0px : content.preferred-height;
            clip: true;
            content := VerticalLayout {
                width: parent.width;
                spacing: SectionStyle.gap;
                padding-top: root.title != "" ? SectionStyle.gap : 0px;
                @children
            }
        }
    }
}

// The sheet's card: a leading title, the content, a rounded panel; `Sheet` hangs it in the window.
// `WelcomeSheet`'s fit: as tall as its content, never past `room`, the content scrolling beyond.
export component Dialog inherits Rectangle {
    in property <string> title;
    // `DSDialogPanel`'s question: its title in the section face, a full sheet's in the title face.
    in property <bool> question;
    in property <bool> wide;
    // A gauge of its own, as the notices' and the catch-up's; zero takes the plain or wide one.
    in property <length> card-width;
    in property <length> room: 1000000px;
    // Edge to edge: the content carries its own padding, as the welcome's photo touches the card.
    in property <bool> bleed;
    width: root.card-width > 0 ? root.card-width : root.wide ? SheetStyle.wide-width : SheetStyle.width;
    height: min(column.preferred-height, root.room);
    background: Colour.ground;
    border-radius: SheetStyle.radius;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    drop-shadow-blur: SheetStyle.shadow;
    drop-shadow-color: Colour.scrim;
    clip: true;
    // A click on the card stays on it.
    TouchArea { }
    Scroller {
        content-height: column.preferred-height;
        column := VerticalLayout {
            width: root.width;
            padding: root.bleed ? 0px : SheetStyle.padding;
            spacing: root.bleed ? 0px : SheetStyle.gap;
            if root.title != "": Label {
                role: root.question ? TextRole.section : TextRole.title;
                text: root.title;
                wrap: word-wrap;
            }
            @children
        }
    }
}

// A window-modal sheet hung from the window's top; no scrim is drawn, yet a click beside the card
// reaches nothing, as Swift's sheet ignores it. Escape closes it.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <bool> question;
    in property <bool> wide;
    in property <length> card-width;
    in property <bool> bleed;
    callback dismissed();
    TouchArea { }
    // A field's Escape bubbles here: the window's key monitor is the sheet's sibling, never its parent.
    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }
        Dialog {
            y: SheetStyle.margin;
            title: root.title;
            question: root.question;
            wide: root.wide;
            card-width: root.card-width;
            bleed: root.bleed;
            room: root.height - 2 * SheetStyle.margin;
            @children
        }
    }
}

// `DSDialogPanel`'s key row: the keys on one plate at the card's trailing edge, the default last.
export component SheetKeys inherits HorizontalLayout {
    alignment: end;
    KeyPlate { @children }
}

// One line of a menu: its word, its shortcut, a hover band.
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <Look> look: Look.live;
    callback activated();
    height: MenuStyle.row;
    border-radius: ButtonStyle.small-radius;
    background: root.enabled && (area.has-hover || root.look != Look.live) ? Colour.accent : transparent;
    opacity: root.enabled ? 1 : State.disabled;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        Rectangle {
            width: ButtonStyle.small-icon;
            if root.checked: Icon { source: Icons.done; tone: Tone.primary; width: ButtonStyle.small-icon; height: ButtonStyle.small-icon; }
        }
        Label { text: root.text; horizontal-stretch: 1; overflow: elide; }
        Label { text: root.shortcut; tone: Tone.secondary; }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// A menu's body: the entries on a raised panel, a rule between groups as a `Divider`.
export component MenuPanel inherits Rectangle {
    in property <length> span: MenuStyle.width;
    width: root.span;
    height: column.preferred-height;
    background: Colour.raised;
    border-radius: MenuStyle.radius;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    column := VerticalLayout {
        padding: MenuStyle.padding;
        spacing: 0;
        @children
    }
}

// A popup menu of words; the chosen index comes back through `chosen`.
export component Menu inherits PopupWindow {
    in property <[string]> entries;
    in property <int> current: -1;
    // A menu dropped under a field is as wide as it.
    in property <length> span: MenuStyle.width;
    callback chosen(int);
    // Sized as its panel, so a window's edge pushes it no further than its own width.
    width: panel.width;
    height: panel.height;
    panel := MenuPanel {
        span: root.span;
        for word[i] in root.entries: MenuEntry {
            text: word;
            checked: i == root.current;
            activated => { root.chosen(i); }
        }
    }
}
