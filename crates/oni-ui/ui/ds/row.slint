// Every line of a list or a tree, its glyph, chevron, caption, badge, star, key and states, its title
// typed over while renamed; and what an empty list says in place of its lines.
import { Colour, Space, Radius, Stroke, State, RowStyle, FieldStyle, ButtonStyle } from "theme.slint";
import { Label, Icon, TextRole, Tone, Tips, Divider } from "base.slint";
import { Badge, BadgeTone } from "badge.slint";
import { Icons } from "icons.slint";
import { Look, Button, ButtonKind, ButtonSize, RenameField } from "controls.slint";
import { NavigatorStyle } from "folders.slint";
import { FormStyle } from "forms.slint";
import { StockIcon } from "stocks.slint";
import { Reach, Reaches } from "reach.slint";
import { KeyScope, FocusRing } from "keyboard.slint";

// `none` is a list's line, with no chevron or glyph; `trash` is the ONI Trash and its folders;
// `heading` names the lines under it, in the tertiary ink, out of reach.
export enum RowKind { none, folder, opened, roll, photo, project, trash, heading }

// `list` a tree's or a list's line; `navigator` a folder's or the trash's above the tree: rounded,
// its title quiet, its chevron a click, its glyph shut; `sidebar` a sheet's side list, rounded;
// `menu` a folder pill's choice: rounded, no chevron, a check at its end.
export enum RowForm { list, navigator, sidebar, menu }

export component Row inherits Rectangle {
    in property <string> title;
    // `truncationMode(.middle)`: the title cut in two, its head eliding while its tail stays whole,
    // so names alike up to their end stay apart; no tail, the title elides at its end.
    in property <string> head;
    in property <string> tail;
    // At the end in the tertiary ink, a count or a size.
    in property <string> caption;
    // Before the title in the tertiary ink: the folder a trashed photo came from, a frame's number.
    in property <string> trail;
    // Under the title, wrapped and read whole, as what a preset carries.
    in property <string> detail;
    // The tooltip, as a folder's whole path.
    in property <string> help;
    in property <int> depth;
    in property <RowKind> kind: RowKind.none;
    in property <RowForm> form: RowForm.list;
    in property <bool> expandable;
    in property <bool> expanded;
    // `TreeRowChrome.RowIcon.stock`: a roll's stock artwork, which a roll's line always shows.
    in property <image> stock;
    in property <bool> has-stock;
    // A list line's mark before its title, as the papers' download or link.
    in property <image> glyph;
    in property <bool> has-glyph;
    in property <bool> selected;
    // The hover band held, as a navigator folder picked or a trash line chosen.
    in property <bool> picked;
    // A menu's choice that is the current one.
    in property <bool> checked;
    // Pinned at the top of its tree: the ground under it, a rule below.
    in property <bool> pinned;
    in property <bool> present: true;
    // A folder out of reach: its title and glyph faded, its state's mark before the caption, which
    // says it in words at full ink.
    in property <Reach> reach: Reach.here;
    // A roll whose photos ask for Prepare Roll: the warning mark its card shows, in the same ink.
    in property <bool> unprepared;
    // The star: lit on a favourite, shown under the pointer on any row that can be starred.
    in property <bool> starrable;
    in property <bool> favourite;
    // A key the hovered row shows, as RESTORE.
    in property <string> action;
    in property <string> action-help;
    // A tint's badge before the title, its abbreviation inked over its fill.
    in property <string> badge;
    in property <color> badge-fill;
    in property <color> badge-ink;
    // The title typed over, Return or a click elsewhere keeping it, Escape dropping it.
    in property <bool> renaming;
    in property <Look> look: Look.live;
    // The keyboard's ring, while its list holds the keyboard on it.
    in property <bool> focused;
    callback clicked();
    callback double-clicked();
    callback folded();
    // A right click, at the pointer in the row's own coordinates.
    callback menu(length, length);
    // A left press moved, from its press to the pointer in the row's coordinates; its release or cancel.
    callback dragged(length, length, length, length);
    callback released(bool);
    callback starred();
    callback acted();
    callback committed(string);
    callback cancelled();
    // Each keystroke's text, so a click elsewhere can commit what the field holds.
    callback edited(string);
    // What the last left press held, ⌘ (or Ctrl) and ⇧, for `clicked` to read.
    out property <bool> command;
    out property <bool> shift;
    property <bool> hovered: !root.heading && (area.has-hover || root.look != Look.live);
    property <bool> heading: root.kind == RowKind.heading;
    property <bool> tree: root.kind != RowKind.none && !root.heading;
    property <bool> navigator: root.form == RowForm.navigator;
    property <bool> choice: root.form == RowForm.menu;
    // A folder's glyph drawn open while its rows show; a navigator's opens only on the opened folder.
    property <bool> open: !root.navigator && root.expanded;
    // A press on the chevron folds the row instead of clicking it; a navigator's row alike.
    property <bool> folds: (root.form == RowForm.list || root.navigator) && root.expandable;
    // The title in the secondary ink unless selected or picked.
    property <bool> quiet: root.navigator;
    property <bool> badged: root.badge != "";
    property <bool> canister: root.has-stock || root.kind == RowKind.roll;
    // The state's mark, a roll to prepare or a folder out of reach; the end's, a star or a check.
    property <bool> stated: root.unprepared || root.away;
    property <bool> ended: root.starrable || root.choice;
    property <length> indent: root.depth * RowStyle.indent;
    property <length> fold-zone: root.folds ? RowStyle.chevron-zone : 0px;
    height: root.choice ? ButtonStyle.small-height : root.detail != "" || root.heading ? row.preferred-height : RowStyle.height;
    border-radius: root.form != RowForm.list ? Radius.badge : 0px;
    // Selected, every form lays a flat band, no relief and no shadow; a list's, square, joins the
    // bands of several selected side by side into one.
    property <brush> band: root.heading ? Colour.ground.transparentize(1) : root.selected ? Colour.row-selected : (root.picked || root.hovered) ? Colour.hover : Colour.ground.transparentize(1);
    // A pinned row covers the rows scrolled under it, its band laid over the ground.
    background: root.pinned ? Colour.ground : root.band;
    property <bool> away: root.reach != Reach.here;
    // A folder not on the disk yet, as an empty ONI Trash, reads in the quietest ink, still legible.
    property <bool> faint: !root.present && !root.away;
    property <Tone> ink: root.heading || root.faint ? Tone.tertiary : root.quiet && !root.selected && !root.picked ? Tone.secondary : Tone.primary;
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-description: root.unprepared ? @tr("Not prepared yet") : "";
    // A title cut short shows whole under the pointer, where the row says nothing else there.
    property <bool> cut;
    property <string> said: root.help != "" ? root.help : root.cut ? root.title : "";
    // Under the pointer, an unprepared roll's state before the row's own words, as its path; the
    // words shown, which leaving or new words take down, as a key's help.
    property <string> tip: root.unprepared && root.said != "" ? @tr("Not prepared yet") + "\n" + root.said : root.unprepared ? @tr("Not prepared yet") : root.said;
    property <string> told;
    changed tip => { if (area.has-hover) { Tips.hover(false, root.told, 0px, 0px); } }
    if root.pinned: Rectangle { background: root.band; }
    area := TouchArea {
        property <bool> folding: root.fold-zone > 0 && self.mouse-x < RowStyle.padding + root.indent + root.fold-zone;
        enabled: !root.renaming && !root.heading;
        clicked => {
            if (self.folding) {
                root.folded();
            } else {
                root.clicked();
            }
        }
        double-clicked => {
            if (!self.folding) {
                root.double-clicked();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.command = event.modifiers.control || event.modifiers.meta;
                root.shift = event.modifiers.shift;
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.menu(self.mouse-x, self.mouse-y);
            }
            if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                root.released(event.kind == PointerEventKind.up);
            }
        }
        moved => { if (self.pressed) { root.dragged(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y); } }
        changed has-hover => {
            if (self.has-hover) { root.told = root.tip; }
            Tips.hover(self.has-hover, root.told, root.absolute-position.x, root.absolute-position.y + root.height);
        }
    }
    if root.focused: FocusRing { radius: Radius.badge; }
    // A sheet's side list is a few choices, each its own place in Tab's order, Space or Return taking it.
    if root.form == RowForm.sidebar: KeyScope {
        radius: Radius.badge;
        key-pressed(event) => {
            if ((event.text != " " && event.text != Key.Return) || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                return reject;
            }
            if (!event.repeat) { root.clicked(); }
            accept
        }
    }
    row := HorizontalLayout {
        // Renamed, the typed name starts where the title stood.
        padding-left: root.badged ? Space.xs
            : root.renaming ? RowStyle.padding + root.indent + RowStyle.chevron-zone + RowStyle.slot + 2 * RowStyle.gap - FieldStyle.across
            : RowStyle.padding + root.indent;
        padding-right: root.badged ? Space.xs : root.renaming ? FieldStyle.across : RowStyle.padding;
        padding-top: root.badged ? Space.xs : 0px;
        // `PaperProfilesSheet.group`: a heading an `xs` above its first line.
        padding-bottom: root.badged || root.heading ? Space.xs : 0px;
        spacing: root.badged ? Space.s : RowStyle.gap;
        if root.badged: VerticalLayout {
            alignment: center;
            Badge { tone: BadgeTone.tint; text: root.badge; fill: root.badge-fill; ink: root.badge-ink; }
        }
        if root.tree && !root.renaming && !root.choice: Rectangle {
            width: RowStyle.chevron-zone;
            // In the primary ink: its line is a single pixel, which a quieter ink leaves under 3:1.
            if root.expandable: Icon {
                source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
                width: RowStyle.chevron;
                height: RowStyle.chevron;
                tone: root.faint ? Tone.tertiary : Tone.primary;
            }
        }
        // A menu holds no stock, so its glyph takes only its own width; a roll shows its stock's canister.
        if root.tree && !root.renaming: Rectangle {
            width: root.choice ? RowStyle.icon : RowStyle.slot;
            opacity: root.away ? State.missing : 1;
            if root.canister: StockIcon {
                artwork: root.stock;
                has-artwork: root.has-stock;
                side: RowStyle.slot;
            }
            if !root.canister: Icon {
                source: root.kind == RowKind.photo ? Icons.film : root.kind == RowKind.project ? Icons.sticky-note
                    : root.kind == RowKind.trash ? (root.depth == 0 ? Icons.remove : Icons.folder)
                    : root.kind == RowKind.opened || (root.kind == RowKind.folder && root.open) ? Icons.folder-open : Icons.folder;
                width: RowStyle.icon;
                height: RowStyle.icon;
                tone: root.faint ? Tone.tertiary : Tone.secondary;
            }
        }
        if !root.tree && root.has-glyph: VerticalLayout {
            alignment: center;
            Icon { source: root.glyph; width: FormStyle.chip-icon; height: FormStyle.chip-icon; }
        }
        if root.trail != "" && !root.renaming: Label { text: root.trail; tone: Tone.tertiary; overflow: elide; }
        if !root.renaming: VerticalLayout {
            horizontal-stretch: 1;
            if root.tail == "": Label {
                opacity: root.away ? State.missing : 1;
                text: root.title;
                tone: root.ink;
                overflow: elide;
                property <bool> short: self.preferred-width > self.width;
                init => { root.cut = self.short; }
                changed short => { root.cut = self.short; }
            }
            // The head shrinks first, so the ellipsis falls before the tail.
            if root.tail != "": HorizontalLayout {
                opacity: root.away ? State.missing : 1;
                alignment: start;
                Label {
                    text: root.head;
                    tone: root.ink;
                    overflow: elide;
                    property <bool> short: self.preferred-width > self.width;
                    init => { root.cut = self.short; }
                    changed short => { root.cut = self.short; }
                }
                Label { text: root.tail; tone: root.ink; horizontal-stretch: 0; }
            }
            // Slint reads the row's height with a wrapped text at its one-line width; the text's own
            // height, read at the width it is laid at, keeps every line inside the row.
            if root.detail != "": Label {
                text: root.detail;
                role: TextRole.value;
                tone: Tone.tertiary;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
        if root.renaming: RenameField {
            horizontal-stretch: 1;
            text: root.title;
            placeholder: @tr("Name");
            edited(t) => { root.edited(t); }
            committed(t) => { root.committed(t); }
            cancelled => { root.cancelled(); }
        }
        // The key the hovered row shows stands before the count, which keeps its edge under the hand.
        if root.action != "" && root.hovered: VerticalLayout {
            alignment: center;
            padding-right: root.caption != "" ? Space.xs : 0px;
            Button {
                text: root.action;
                size: ButtonSize.mini;
                help: root.action-help;
                clicked => { root.acted(); }
            }
        }
        if root.caption != "" && !root.renaming: Label { text: root.caption; role: TextRole.value; tone: Tone.tertiary; }
        // Each end mark in a column a mark wide, on the row's right edge: the state's before the star's
        // or the check's, whose column a row that may show one keeps bare, so no mark moves under the hand.
        if (root.stated || root.ended) && !root.renaming: HorizontalLayout {
            spacing: Space.s;
            if root.stated: Rectangle {
                width: RowStyle.mark;
                accessible-role: image;
                accessible-label: root.unprepared ? @tr("Not prepared yet") : root.caption;
                Icon {
                    source: root.unprepared ? Icons.warning : Reaches.glyph(root.reach);
                    width: RowStyle.mark;
                    height: RowStyle.mark;
                    tone: root.unprepared ? Tone.warning : Tone.tertiary;
                }
            }
            // The star's catch, a small key's square, overhangs its column into the room either side.
            if root.ended: Rectangle {
                width: RowStyle.mark;
                if root.starrable && (root.favourite || root.hovered): Button {
                    kind: ButtonKind.ghost;
                    has-icon: true;
                    square: true;
                    icon: Icons.favourite;
                    width: ButtonStyle.small-height;
                    height: ButtonStyle.small-height;
                    glyph-size: RowStyle.mark;
                    glyph-ink: root.favourite ? NavigatorStyle.favourite : Colour.ink-tertiary;
                    help: root.favourite ? @tr("Remove from the favourites") : @tr("Add to the favourites");
                    clicked => { root.starred(); }
                }
                if root.choice && root.checked: Icon { source: Icons.done; width: RowStyle.mark; height: RowStyle.mark; tone: Tone.primary; }
            }
        }
    }
    if root.pinned: Divider {
        hairline: true;
        y: parent.height - self.height;
        height: Stroke.hairline;
    }
}

// An empty list's words where its lines would stand: at its top, on the lines' inset, in their quiet
// ink, the hint beneath.
export component RowsEmpty inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    padding-left: RowStyle.padding;
    padding-right: RowStyle.padding;
    padding-top: Space.s;
    padding-bottom: Space.s;
    spacing: Space.xxs;
    Label { text: root.title; tone: Tone.secondary; wrap: word-wrap; }
    if root.detail != "": Label { role: TextRole.note; text: root.detail; }
}
