// Every line of a list or a tree: a title, its kind's glyph and chevron, a caption, a path before it,
// a second line, a tint's badge, a star, a key on hover, and the title typed over while renamed.
import { Colour, Space, Radius, Stroke, State, RowStyle, FieldStyle, MenuStyle } from "theme.slint";
import { Label, Icon, TextRole, Tone, Tips, Divider } from "base.slint";
import { Badge, BadgeTone } from "badge.slint";
import { Icons } from "icons.slint";
import { Look, Button, ButtonKind, ButtonSize, RenameField } from "controls.slint";
import { NavigatorStyle } from "folders.slint";
import { FormStyle } from "forms.slint";
import { StockIcon } from "stocks.slint";

// `none` is a list's line, with no chevron or glyph; `trash` is the ONI Trash and its folders;
// `heading` names the lines under it, in the tertiary ink, out of reach.
export enum RowKind { none, folder, opened, roll, photo, project, trash, heading }

// `list` a tree's or a list's line; `navigator` a folder's or the trash's above the tree: rounded,
// its title quiet, its chevron a click, its glyph shut; `sidebar` a sheet's side list, rounded;
// `menu` a folder pill's choice: rounded, no chevron, a check at its end.
export enum RowForm { list, navigator, sidebar, menu }

export component Row inherits Rectangle {
    in property <string> title;
    // At the end in the tertiary ink, a count or a size.
    in property <string> caption;
    // Before the title, the folder a trashed photo came from.
    in property <string> trail;
    // A second line under the title, as what a preset carries.
    in property <string> detail;
    // The tooltip, as a folder's whole path.
    in property <string> help;
    in property <int> depth;
    in property <RowKind> kind: RowKind.none;
    in property <RowForm> form: RowForm.list;
    in property <bool> expandable;
    in property <bool> expanded;
    // `TreeRowChrome.RowIcon.stock`: a roll's stock artwork in place of its glyph.
    in property <image> stock;
    in property <bool> has-stock;
    // A list line's mark before its title, as the papers' download or link.
    in property <image> glyph;
    in property <bool> has-glyph;
    in property <bool> selected;
    // The hover band held, as a navigator folder picked or a trash line chosen.
    in property <bool> picked;
    // A menu's choice that is the current one.
    in property <bool> checked;
    // Pinned at the top of its tree: the ground under it, a rule below.
    in property <bool> pinned;
    in property <bool> present: true;
    // The star: lit on a favourite, shown under the pointer on any row that can be starred.
    in property <bool> starrable;
    in property <bool> favourite;
    // A key the hovered row shows, as RESTORE.
    in property <string> action;
    in property <string> action-help;
    // A tint's badge before the title, its abbreviation inked over its fill.
    in property <string> badge;
    in property <color> badge-fill;
    in property <color> badge-ink;
    // The title typed over, Return or a click elsewhere keeping it, Escape dropping it.
    in property <bool> renaming;
    in property <Look> look: Look.live;
    callback clicked();
    callback double-clicked();
    callback folded();
    // A right click, at the pointer in the row's own coordinates.
    callback menu(length, length);
    // A left press moved, from its press to the pointer in the row's coordinates; its release or cancel.
    callback dragged(length, length, length, length);
    callback released(bool);
    callback starred();
    callback acted();
    callback committed(string);
    callback cancelled();
    // Each keystroke's text, so a click elsewhere can commit what the field holds.
    callback edited(string);
    // What the last left press held, ⌘ (or Ctrl) and ⇧, for `clicked` to read.
    out property <bool> command;
    out property <bool> shift;
    property <bool> hovered: !root.heading && (area.has-hover || root.look != Look.live);
    property <bool> heading: root.kind == RowKind.heading;
    property <bool> tree: root.kind != RowKind.none && !root.heading;
    property <bool> navigator: root.form == RowForm.navigator;
    property <bool> choice: root.form == RowForm.menu;
    // A folder's glyph drawn open while its rows show; a navigator's opens only on the opened folder.
    property <bool> open: !root.navigator && root.expanded;
    // A press on the chevron folds the row instead of clicking it.
    property <bool> folds: root.form == RowForm.list && root.expandable;
    // The title in the secondary ink unless selected or picked.
    property <bool> quiet: root.navigator;
    property <bool> badged: root.badge != "";
    property <length> indent: root.depth * RowStyle.indent;
    property <length> fold-zone: root.folds ? RowStyle.chevron-zone : 0px;
    height: root.choice ? MenuStyle.row : root.detail != "" || root.heading ? row.preferred-height : RowStyle.height;
    border-radius: root.form != RowForm.list ? Radius.badge : 0px;
    property <brush> band: root.heading ? Colour.ground.transparentize(1) : root.selected ? Colour.row-selected : (root.picked || root.hovered) ? Colour.hover : Colour.ground.transparentize(1);
    // A pinned row covers the rows scrolled under it, its band laid over the ground.
    background: root.pinned ? Colour.ground : root.band;
    opacity: root.present ? 1 : State.disabled;
    accessible-role: list-item;
    accessible-label: root.title;
    if root.pinned: Rectangle { background: root.band; }
    area := TouchArea {
        property <bool> folding: root.fold-zone > 0 && self.mouse-x < RowStyle.padding + root.indent + root.fold-zone;
        enabled: !root.renaming && !root.heading;
        clicked => {
            if (self.folding) {
                root.folded();
            } else {
                root.clicked();
            }
        }
        double-clicked => {
            if (!self.folding) {
                root.double-clicked();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.command = event.modifiers.control || event.modifiers.meta;
                root.shift = event.modifiers.shift;
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.menu(self.mouse-x, self.mouse-y);
            }
            if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                root.released(event.kind == PointerEventKind.up);
            }
        }
        moved => { if (self.pressed) { root.dragged(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y); } }
        changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
    }
    row := HorizontalLayout {
        // Renamed, the typed name starts where the title stood.
        padding-left: root.badged ? Space.xs
            : root.renaming ? RowStyle.padding + root.indent + RowStyle.chevron-zone + RowStyle.slot + 2 * RowStyle.gap - FieldStyle.padding
            : RowStyle.padding + root.indent;
        padding-right: root.badged ? Space.xs : RowStyle.padding;
        padding-top: root.badged ? Space.xs : 0px;
        // `PaperProfilesSheet.group`: a heading an `xs` above its first line.
        padding-bottom: root.badged || root.heading ? Space.xs : 0px;
        spacing: root.badged ? Space.s : RowStyle.gap;
        if root.badged: VerticalLayout {
            alignment: center;
            Badge { tone: BadgeTone.tint; text: root.badge; fill: root.badge-fill; ink: root.badge-ink; }
        }
        if root.tree && !root.renaming && !root.choice: Rectangle {
            width: RowStyle.chevron-zone;
            if root.expandable: Icon {
                source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
                width: RowStyle.chevron;
                height: RowStyle.chevron;
            }
        }
        // A menu holds no stock, so its glyph takes only its own width.
        if root.tree && !root.renaming: Rectangle {
            width: root.choice ? RowStyle.icon : RowStyle.slot;
            if root.has-stock: StockIcon {
                artwork: root.stock;
                has-artwork: true;
                side: RowStyle.slot;
            }
            if !root.has-stock: Icon {
                source: root.kind == RowKind.photo ? Icons.film : root.kind == RowKind.project ? Icons.sticky-note
                    : root.kind == RowKind.roll ? Icons.film-roll : root.kind == RowKind.trash ? (root.depth == 0 ? Icons.remove : Icons.folder)
                    : root.kind == RowKind.opened || (root.kind == RowKind.folder && root.open) ? Icons.folder-open : Icons.folder;
                width: RowStyle.icon;
                height: RowStyle.icon;
            }
        }
        if !root.tree && root.has-glyph: VerticalLayout {
            alignment: center;
            Icon { source: root.glyph; width: FormStyle.chip-icon; height: FormStyle.chip-icon; }
        }
        if root.trail != "" && !root.renaming: Label { text: root.trail; tone: Tone.tertiary; overflow: elide; }
        if !root.renaming: VerticalLayout {
            horizontal-stretch: 1;
            Label {
                text: root.title;
                tone: root.heading ? Tone.tertiary : root.quiet && !root.selected && !root.picked ? Tone.secondary : Tone.primary;
                overflow: elide;
            }
            if root.detail != "": Label { text: root.detail; role: TextRole.value; tone: Tone.tertiary; overflow: elide; }
        }
        if root.renaming: RenameField {
            horizontal-stretch: 1;
            text: root.title;
            placeholder: @tr("Name");
            edited(t) => { root.edited(t); }
            committed(t) => { root.committed(t); }
            cancelled => { root.cancelled(); }
        }
        if root.caption != "" && !root.renaming: Label { text: root.caption; role: TextRole.value; tone: Tone.tertiary; }
        if root.starrable && (root.favourite || root.hovered): VerticalLayout {
            alignment: center;
            Button {
                kind: ButtonKind.ghost;
                has-icon: true;
                square: true;
                icon: Icons.favourite;
                width: NavigatorStyle.star;
                height: NavigatorStyle.star;
                glyph-size: NavigatorStyle.star;
                glyph-ink: root.favourite ? NavigatorStyle.favourite : Colour.ink-tertiary;
                help: root.favourite ? @tr("Remove from the favourites") : @tr("Add to the favourites");
                clicked => { root.starred(); }
            }
        }
        // A count an `xs` further off the key, so the two never read as one.
        if root.action != "" && root.hovered: VerticalLayout {
            alignment: center;
            padding-left: root.caption != "" ? Space.xs : 0px;
            Button {
                text: root.action;
                size: ButtonSize.small;
                help: root.action-help;
                clicked => { root.acted(); }
            }
        }
        if root.choice && root.checked: VerticalLayout {
            alignment: center;
            Icon { source: Icons.done; width: NavigatorStyle.star; height: NavigatorStyle.star; tone: Tone.primary; }
        }
    }
    if root.pinned: Divider {
        hairline: true;
        y: parent.height - self.height;
        height: Stroke.hairline;
    }
}
