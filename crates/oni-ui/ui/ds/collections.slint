// The collections' cells and their scrolled surfaces: a list row, a tree row, a gallery tile, a heading.
import { Colour, Space, State, RowStyle, TileStyle, ScrollStyle } from "theme.slint";
import { Label, Icon, Picture, Ground, TextRole, Tone } from "base.slint";
import { Look } from "controls.slint";
import { Icons } from "icons.slint";

// AppKit's overlay knob over a surface's edge: drawn only while the content overflows, lit while it
// moves, `linger` after, or while the pointer is on the edge; it never takes a click or a drag.
export component ScrollKnob {
    in property <bool> horizontal;
    // Along the scrolled axis: the length shown, the content's, and how far it has scrolled.
    in property <length> page;
    in property <length> whole;
    in property <length> offset;
    in property <bool> hovered;
    // The pointer across the scrolled axis, so only the edge strip lights the knob.
    in property <length> across;
    out property <bool> overflows: root.whole - root.page >= ScrollStyle.slack;
    out property <bool> lit: root.overflows && (root.moving || (root.hovered && root.across >= (root.horizontal ? root.height : root.width) - ScrollStyle.reach));
    property <bool> moving;
    // Every user scroll calls it.
    public function stir() {
        root.moving = true;
        linger.restart();
    }
    linger := Timer {
        interval: ScrollStyle.linger;
        running: root.moving;
        triggered => { root.moving = false; }
    }
    if root.overflows: Rectangle {
        property <length> room: root.page - 2 * ScrollStyle.inset;
        property <length> span: min(self.room, max(ScrollStyle.knob-min, self.room * root.page / root.whole));
        property <length> along: ScrollStyle.inset + (self.room - self.span) * clamp(root.offset / (root.whole - root.page), 0, 1);
        x: root.horizontal ? self.along : root.width - ScrollStyle.inset - ScrollStyle.knob;
        y: root.horizontal ? root.height - ScrollStyle.inset - ScrollStyle.knob : self.along;
        width: root.horizontal ? self.span : ScrollStyle.knob;
        height: root.horizontal ? ScrollStyle.knob : self.span;
        border-radius: ScrollStyle.knob / 2;
        background: Colour.knob;
        opacity: root.lit ? 1 : 0;
        animate opacity { duration: ScrollStyle.fade; }
    }
}

// Scrolled by the wheel and the trackpad only, as drag belongs to the parameters and the image.
// `content-height` must be set: aliasing it drops the Flickable's own default.
export component Scroller {
    // Sideways, as the preset deck's roll.
    in property <bool> horizontal;
    // `.scrollIndicators(.never)`: the deck's fade stands in for the knob.
    in property <bool> knob: true;
    in-out property <length> content-x <=> flick.content-x;
    in-out property <length> content-y <=> flick.content-y;
    in-out property <length> content-height <=> flick.content-height;
    // Read only when sideways, so a row wider than a vertical surface never slides it.
    in-out property <length> content-width;
    out property <length> visible-width <=> flick.width;
    out property <length> visible-height <=> flick.height;
    out property <bool> overflows: bar.overflows;
    out property <bool> lit: root.knob && bar.lit;
    // Fills its parent outside a layout, as the Flickable it wraps; in one, the content's size.
    preferred-width: 100%;
    preferred-height: 100%;
    // Its hover only lights the knob: every press and drag reaches the content first.
    hover := TouchArea {
        flick := Flickable {
            mouse-drag-pan-enabled: false;
            content-width: root.horizontal ? root.content-width : self.width;
            flicked => {
                if (root.knob) {
                    bar.stir();
                }
            }
            @children
        }
    }
    bar := ScrollKnob {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: root.knob;
        horizontal: root.horizontal;
        page: root.horizontal ? flick.width : flick.height;
        whole: root.horizontal ? flick.content-width : flick.content-height;
        offset: root.horizontal ? -flick.content-x : -flick.content-y;
        hovered: hover.has-hover;
        across: root.horizontal ? hover.mouse-y : hover.mouse-x;
    }
}

// The same surface whose rows are made only while they show: Slint virtualises a `for` placed
// directly in an element named `ListView` that carries the content and visible lengths.
export component ListView inherits Scroller { }

export enum RowKind { folder, roll, photo, project }

// A line of a list: a title, a caption at the end, the hover and selection bands.
export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <bool> selected;
    in property <Look> look: Look.live;
    in property <length> indent;
    // `chevronZone`: the width after the indent where a click folds instead of clicking.
    in property <length> fold-zone;
    callback clicked();
    callback double-clicked();
    callback folded();
    // A right click, at the pointer in the row's own coordinates.
    callback menu(length, length);
    height: RowStyle.height;
    background: root.selected ? Colour.row-selected : (area.has-hover || root.look != Look.live) ? Colour.hover : transparent;
    HorizontalLayout {
        padding-left: RowStyle.padding + root.indent;
        padding-right: RowStyle.padding;
        spacing: RowStyle.gap;
        @children
        Label { text: root.title; overflow: elide; horizontal-stretch: 1; }
        Label { text: root.caption; role: TextRole.value; tone: Tone.tertiary; }
    }
    area := TouchArea {
        property <bool> folds: root.fold-zone > 0 && self.mouse-x < RowStyle.padding + root.indent + root.fold-zone;
        clicked => {
            if (self.folds) {
                root.folded();
            } else {
                root.clicked();
            }
        }
        double-clicked => {
            if (!self.folds) {
                root.double-clicked();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
    }
}

// The archive's row: indented by depth, a chevron when it opens, then its glyph, a photo's included.
export component TreeItem inherits ListRow {
    in property <int> depth;
    in property <RowKind> kind;
    in property <bool> expandable;
    in property <bool> expanded;
    indent: root.depth * RowStyle.indent;
    fold-zone: root.expandable ? RowStyle.chevron-zone : 0;
    Rectangle {
        width: RowStyle.chevron-zone;
        if root.expandable: Icon {
            source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
            width: RowStyle.chevron;
            height: RowStyle.chevron;
        }
    }
    VerticalLayout {
        alignment: center;
        Icon {
            source: root.kind == RowKind.photo ? Icons.film : root.kind == RowKind.project ? Icons.sticky-note
                : root.kind == RowKind.roll ? Icons.film-roll : root.expanded ? Icons.folder-open : Icons.folder;
            width: RowStyle.icon;
            height: RowStyle.icon;
        }
    }
}

// A gallery cell: the picture in its well, the medal, the RGB seal, the selection ring, and a
// caption under it only when one is given. A missing original shows faded.
export component TileView inherits Rectangle {
    in property <image> picture;
    in property <string> caption;
    in property <bool> selected;
    in property <int> medal;
    in property <bool> missing;
    in property <bool> rgb;
    in property <length> picture-height;
    height: root.caption == "" ? root.picture-height : root.picture-height + TileStyle.caption-gap + TileStyle.caption;
    Picture {
        y: 0;
        height: root.picture-height;
        ground: Ground.well;
        source: root.picture;
        opacity: root.missing ? State.disabled : 1;
        // `TileLayers`: the medal at the bottom-left corner, the RGB seal at the bottom-right.
        if root.medal > 0: Rectangle {
            x: TileStyle.badge-inset;
            y: parent.height - self.height - TileStyle.badge-inset;
            width: TileStyle.medal;
            height: TileStyle.medal;
            border-radius: self.width / 2;
            background: Colour.medal[root.medal];
        }
        if root.rgb: Rectangle {
            x: parent.width - self.width - TileStyle.badge-inset;
            y: parent.height - self.height - TileStyle.badge-inset;
            width: seal.preferred-width + 2 * Space.xs;
            height: TileStyle.caption;
            border-radius: Space.xxs;
            background: Colour.raised;
            seal := Label { role: TextRole.caption; text: "RGB"; centred: true; }
        }
        Rectangle {
            border-width: root.selected ? TileStyle.selection : 0px;
            border-color: Colour.selected;
        }
    }
    if root.caption != "": Label {
        y: root.picture-height + TileStyle.caption-gap;
        height: TileStyle.caption;
        width: parent.width;
        role: TextRole.caption;
        tone: root.selected ? Tone.primary : Tone.secondary;
        text: root.caption;
        centred: true;
        overflow: elide;
    }
}

// `RollHeaderContent`: a band's title over its tiles, the folders above it first, in secondary.
export component TileHeading inherits HorizontalLayout {
    in property <string> title;
    in property <string> caption;
    height: TileStyle.heading;
    if root.caption != "": Label { role: TextRole.title; tone: Tone.secondary; text: root.caption + " / "; }
    Label { role: TextRole.title; text: root.title; overflow: elide; }
    Rectangle { horizontal-stretch: 1; }
}

// `PinnedGalleryHeader`: the band's heading held at the grid's top, on the canvas the tiles pass under.
export component PinnedHeading inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    background: Colour.canvas;
    height: TileStyle.heading;
    TileHeading {
        x: Space.l;
        width: parent.width - 2 * Space.l;
        title: root.title;
        caption: root.caption;
    }
}
