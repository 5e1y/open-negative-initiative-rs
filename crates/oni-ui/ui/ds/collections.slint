// The collections' cells, a gallery tile and a band's heading; their scrolled surfaces are `scroller.slint`.
import { Colour, Space, Radius, State, RowStyle, TileStyle, MedalStyle } from "theme.slint";
import { Label, Icon, Picture, CardCorners, Ground, Tones, TextRole, Tone, Tips } from "base.slint";
import { Badge, BadgeTone, Metal, BadgeStyle } from "badge.slint";
import { RenameField } from "controls.slint";
import { Icons } from "icons.slint";
import { Medal, RingPlacement, SelectionTone, SelectionRing } from "marks.slint";
import { MedalKeys } from "organise.slint";
import { Reach, Reaches } from "reach.slint";
import { FocusRing } from "keyboard.slint";
import { ScrollKnob, Scroller, ListView } from "scroller.slint";
export { ScrollKnob, Scroller, ListView }

// `medal` lays the gallery's marks, its medal bottom-left and its seal a `Space.s` in; `apart` Prepare
// the Roll's, the flag top-left, the apart disc where the medal stands and every seal an `xs` in.
export enum TileMarks { medal, apart }

// A state's disc in a tile's corner, told by its glyph as much as by its ink: an original away, a frame shot apart.
component StateDisc inherits Rectangle {
    in property <image> glyph;
    in property <color> ink;
    width: TileStyle.away;
    height: TileStyle.away;
    border-radius: self.width / 2;
    background: Colour.overlay;
    Icon {
        width: TileStyle.away-glyph;
        height: TileStyle.away-glyph;
        source: root.glyph;
        ink: root.ink;
    }
}

// A gallery cell, or a frame of Prepare the Roll (`RollFrameCell` is built on `GalleryView.tile`):
// the picture in its well, its marks, the RGB seal, the selection's ring, a caption when given.
export component TileView inherits Rectangle {
    in property <image> picture;
    in property <string> caption;
    // Before the caption in the tertiary ink, as a row's: a frame's number on its roll.
    in property <string> trail;
    in property <bool> selected;
    in property <int> medal;
    // A missing original: its picture alone greyed (by the caller) and faded, its ground and
    // marks whole, its state's disc in the corner; `note` says where it was, under the pointer.
    in property <bool> missing;
    in property <Reach> away: Reach.missing;
    in property <string> note;
    in property <bool> hovered;
    // A frame left out of the roll fades whole, its marks with it.
    in property <bool> left-out;
    in property <bool> rgb;
    // A triplet's pass gone: the seal says which, in the destructive foil, in place of RGB.
    in property <string> gone-pass;
    // A RAW+JPEG pair's JPEG behind its RAW, by its extension (`+JPG`), where no seal stands.
    in property <string> companion;
    in property <length> picture-height;
    in property <TileMarks> marks: TileMarks.medal;
    // A frame digitised with other settings than its roll's, its disc in the corner.
    in property <bool> apart;
    // A frame the measure flags, its seal top-left: its ring destructive, outside it ringed unselected too.
    in property <bool> flagged;
    in property <RingPlacement> ring: RingPlacement.inset;
    // A frame's corners round by a clip; the gallery's are painted in `behind`, a rounded clip drawing
    // each tile to a layer.
    in property <bool> rounded;
    in property <Ground> behind: Ground.canvas;
    // Its photo's name, which assistive technology reads where no caption shows it.
    in property <string> name: root.caption;
    // The keyboard's ring, while its grid holds the keyboard on it.
    in property <bool> focused;
    // Its medal keys show under the hand: a photo the archive or a project holds, its original in reach.
    in property <bool> rating;
    callback clicked();
    callback medal-picked(int);
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.note;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    property <bool> frame: root.marks == TileMarks.apart;
    property <bool> keys-shown: !root.frame && root.hovered && root.rating && !root.missing;
    // The photo shown where it stands: its medal changing there was laid on it (`Medal.holder`).
    property <string> holder: root.name + "@" + root.x / 1px + "," + root.y / 1px;
    property <length> inset: root.frame ? Space.xs : TileStyle.badge-inset;
    property <bool> outset: root.ring == RingPlacement.outset;
    height: root.caption == "" ? root.picture-height : root.picture-height + TileStyle.caption-gap + TileStyle.caption;
    changed hovered => { Tips.hover(root.hovered, root.note, root.absolute-position.x, root.absolute-position.y + root.picture-height); }
    Picture {
        y: 0;
        height: root.picture-height;
        ground: Ground.well;
        source: root.picture;
        rounded: root.rounded;
        radius: Radius.card;
        picture-opacity: root.missing ? State.missing : 1;
        opacity: root.left-out ? State.missing : 1;
        // `TileLayers`: the medal's centre level with the seal's; under the hand, the podium's keys there.
        if !root.frame: Medal {
            x: root.inset;
            y: parent.height - root.inset - (BadgeStyle.seal-height + self.height) / 2;
            visible: root.medal > 0 && !root.keys-shown;
            rank: root.medal;
            holder: root.holder;
        }
        if root.keys-shown: MedalKeys {
            x: root.inset - (MedalStyle.tile-key - MedalStyle.size) / 2;
            y: parent.height - root.inset - (BadgeStyle.seal-height + self.height) / 2;
            height: MedalStyle.tile-key;
            size: MedalStyle.size;
            key: MedalStyle.tile-key;
            gap: 0;
            keyed: false;
            current: root.medal > 0 ? root.medal : -1;
            holder: root.holder;
            picked(m) => { root.medal-picked(m); }
        }
        if root.frame && root.apart: StateDisc {
            x: root.inset;
            y: parent.height - root.inset - self.height;
            glyph: Icons.warning;
            ink: Colour.caution;
        }
        if root.rgb || root.gone-pass != "": Badge {
            x: parent.width - self.width - root.inset;
            y: parent.height - self.height - root.inset;
            tone: BadgeTone.seal;
            metal: root.gone-pass != "" ? Metal.red : Metal.holographic;
            text: root.gone-pass != "" ? root.gone-pass : @tr("RGB");
        }
        if root.companion != "" && !root.rgb && root.gone-pass == "": Badge {
            x: parent.width - self.width - root.inset;
            y: parent.height - self.height - root.inset;
            text: root.companion;
        }
        if root.missing: StateDisc {
            x: parent.width - self.width - root.inset;
            y: root.inset;
            glyph: Reaches.glyph(root.away);
            ink: Tones.ink(Tone.on-fill);
        }
        if root.frame && root.flagged: Badge {
            x: root.inset;
            y: root.inset;
            tone: BadgeTone.seal;
            metal: Metal.red;
            text: @tr("Flagged");
        }
        if !root.rounded: CardCorners {
            width: parent.width;
            height: parent.height;
            r: Radius.card;
            ground: Tones.ground(root.behind);
        }
        if root.selected && !root.outset: SelectionRing {
            tone: root.flagged ? SelectionTone.destructive : SelectionTone.selected;
        }
    }
    // Outside the picture's clip: a sheet's selection, and the hand's ring on the ground round any tile,
    // where it reads on a light photo as on a dark one and covers none of it.
    if root.hovered || (root.outset && (root.selected || root.flagged)): SelectionRing {
        y: 0;
        height: root.picture-height;
        placement: RingPlacement.outset;
        tone: !root.outset ? SelectionTone.hovered : root.flagged ? SelectionTone.destructive : root.selected ? SelectionTone.selected : SelectionTone.hovered;
    }
    if root.caption != "": HorizontalLayout {
        y: root.picture-height + TileStyle.caption-gap;
        height: TileStyle.caption;
        width: parent.width;
        alignment: center;
        spacing: RowStyle.gap;
        if root.trail != "": Label { role: TextRole.caption; tone: Tone.tertiary; text: root.trail; }
        Label {
            role: TextRole.caption;
            tone: root.selected ? Tone.primary : Tone.secondary;
            text: root.caption;
            overflow: elide;
        }
    }
    if root.focused: FocusRing { y: 0; height: root.picture-height; radius: Radius.card; }
    if root.frame: TouchArea { clicked => { root.clicked(); } }
}

// A group's heading over its tiles, its roll's folder before its name, typed over while renamed;
// `pinned`, it stays at the top of the gallery on the canvas, inset as the tiles are.
export component TileHeading inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <bool> renaming;
    in property <string> draft;
    in property <bool> pinned;
    // Under the pointer, which the grid's one pointer tells: a heading cut short shows whole.
    in property <bool> hovered;
    callback edited(string);
    callback committed(string);
    callback cancelled();
    property <bool> caption-cut;
    property <bool> title-cut;
    property <string> whole: root.caption == "" ? root.title : root.caption + " / " + root.title;
    // The words shown, which leaving or a new name takes down, as a key's help.
    property <string> told;
    changed whole => { if (root.hovered) { Tips.hover(false, root.told, 0px, 0px); } }
    changed hovered => {
        let shown = root.hovered && !root.renaming && (root.caption-cut || root.title-cut);
        if (shown) { root.told = root.whole; }
        Tips.hover(shown, root.told, root.absolute-position.x, root.absolute-position.y + root.height);
    }
    height: TileStyle.heading;
    background: root.pinned ? Colour.canvas : Colour.canvas.transparentize(1);
    HorizontalLayout {
        x: root.pinned ? Space.l : 0px;
        width: parent.width - (root.pinned ? 2 * Space.l : 0px);
        if !root.renaming && root.caption != "": Label {
            role: TextRole.title;
            tone: Tone.secondary;
            text: root.caption + " / ";
            overflow: elide;
            property <bool> short: self.preferred-width > self.width;
            init => { root.caption-cut = self.short; }
            changed short => { root.caption-cut = self.short; }
        }
        if !root.renaming: Label {
            role: TextRole.title;
            text: root.title;
            overflow: elide;
            property <bool> short: self.preferred-width > self.width;
            init => { root.title-cut = self.short; }
            changed short => { root.title-cut = self.short; }
        }
        if !root.renaming: Rectangle { horizontal-stretch: 1; }
        if root.renaming: RenameField {
            horizontal-stretch: 1;
            role: TextRole.title;
            outdent: true;
            text: root.draft;
            placeholder: @tr("Roll name");
            edited(t) => { root.edited(t); }
            committed(t) => { root.committed(t); }
            cancelled => { root.cancelled(); }
        }
    }
}
