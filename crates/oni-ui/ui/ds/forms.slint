// The forms of export and colour management: a labelled field, a note, a preview slot, progress,
// the status bar and a title typed over.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Motion, ButtonStyle, SectionStyle, StatusStyle, ScannerStyle, PlotStyle } from "theme.slint";
import { Label, Icon, Picture, Ground, TextRole, Tone } from "base.slint";
import { Badge, BadgeTone, Metal } from "badge.slint";
import { HelpMark } from "containers.slint";
import { RenameField, Button, ButtonSize } from "controls.slint";
import { Icons } from "icons.slint";
import { KeyScope } from "keyboard.slint";

export global FormStyle {
    out property <length> panel-width: DS.control-export-panel-width;
    out property <length> label-width: DS.control-exif-label-width;
    // The EXIF's column beside each export preview, its ground's padding in, as wide as the settings':
    // the longest film stock's name shows whole in its picker, a camera's maker and model in its field.
    out property <length> fields-width: DS.control-export-panel-width;
    out property <length> caption: DS.control-export-caption-height;
    out property <length> preview-floor: DS.control-export-preview-floor;
    out property <length> progress: DS.control-inline-progress-width;
    out property <length> progress-height: 3px;
    out property <length> chip-icon: DS.control-icon-size * 0.7;
    out property <length> paper-width: DS.control-paper-sheet-width;
    out property <length> paper-height: DS.control-paper-sheet-height;
    out property <length> paper-list: DS.control-paper-sheet-list-width;
    out property <length> gap: Space.m;
    out property <length> row-gap: Space.xs;
}

// How a field lays its label: `stacked` over the control as `DSField`, `column` at a form's fixed
// width before it as an EXIF line, `spread` in the primary ink taking the room before it.
export enum FieldLayout { stacked, column, spread }

// `DSField`: a label, its "?" when it has a note, then the control.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <FieldLayout> layout: FieldLayout.stacked;
    property <bool> stacked: root.layout == FieldLayout.stacked;
    spacing: FormStyle.row-gap;
    // As tall without its "?" as with it, so every field keeps one rhythm.
    if root.stacked: HorizontalLayout {
        spacing: Space.xs;
        alignment: start;
        min-height: SectionStyle.help-mark;
        Label { text: root.label; tone: Tone.secondary; }
        if root.help != "": VerticalLayout {
            alignment: center;
            HelpMark { note: root.help; subject: root.label; }
        }
    }
    HorizontalLayout {
        spacing: Space.s;
        if root.layout == FieldLayout.column: Label { text: root.label; tone: Tone.secondary; width: FormStyle.label-width; }
        if root.layout == FieldLayout.spread: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label { text: root.label; }
        }
        VerticalLayout {
            horizontal-stretch: root.layout == FieldLayout.spread ? 0 : 1;
            spacing: FormStyle.row-gap;
            @children
        }
    }
}

// A note as tall as the tallest of `notes`, every text it may come to say, so what it says changes
// within its room and never moves what follows; the texts that measure it stay unseen and unread.
export component SteadyNote inherits Rectangle {
    in property <string> text;
    in property <[string]> notes;
    height: max(shown.preferred-height, room.preferred-height);
    room := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: root.width * root.notes.length;
        height: self.preferred-height;
        visible: false;
        for note in root.notes: Label { width: root.width; role: TextRole.note; text: note; accessible-role: none; }
    }
    shown := Label {
        x: 0px;
        y: 0px;
        width: root.width;
        height: self.preferred-height;
        role: TextRole.note;
        text: root.text;
    }
}

// `DSWarning`: the warning's triangle, then its sentence, on the panel's own ground: the orange stays
// in the glyph, as a band of it beside the photo would tint how its colours are judged.
export component WarningBand inherits HorizontalLayout {
    in property <string> text;
    spacing: Space.s;
    VerticalLayout {
        alignment: start;
        Icon { source: Icons.warning; width: ButtonStyle.icon; height: ButtonStyle.icon; tone: Tone.warning; }
    }
    Label { text: root.text; wrap: word-wrap; horizontal-stretch: 1; }
}

// `DSProgress`: a thin flat track lit up to the fraction done; below zero, no total, a lit segment
// sweeps it, so a wait that cannot be counted still reads as moving.
export component Progress inherits Rectangle {
    in property <float> fraction;
    property <bool> counted: root.fraction >= 0;
    // Read only while sweeping, so a counted bar asks no frame of its own.
    property <float> swing: root.counted ? 0 : Math.mod(animation-tick() / DS.motion-sweep-duration, 2);
    property <float> eased: (1 - cos((root.swing < 1 ? root.swing : 2 - root.swing) * 180deg)) / 2;
    background: Colour.track;
    border-radius: self.height / 2;
    clip: true;
    height: FormStyle.progress-height;
    Rectangle {
        x: root.counted ? 0 : (root.width - self.width) * root.eased;
        width: root.counted ? root.width * clamp(root.fraction, 0, 1) : root.width * DS.control-progress-segment;
        // `Motion.settle`, a spring of 0.38 s damped 0.72: a slight overshoot.
        animate width { duration: Motion.settle; easing: ease-out-back; }
        border-radius: self.height / 2;
        background: Colour.selected;
    }
}

// What an export preview shows: a sweep while it renders, the picture, or the word it never will.
export enum PreviewState { rendering, shown, failed }

// An export preview on the canvas's dark: the picture fitted whole, a sweep while it renders (the
// inline progress's width), a word when it never will.
export component PreviewSlot inherits Rectangle {
    in property <image> source;
    in property <PreviewState> state;
    background: Colour.canvas;
    if root.state == PreviewState.shown: Picture {
        width: parent.width;
        height: parent.height;
        source: root.source;
        ground: Ground.canvas;
        rounded: true;
    }
    if root.state == PreviewState.failed: VerticalLayout {
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: center;
            Icon { source: Icons.warning; tone: Tone.tertiary; width: ButtonStyle.icon; height: ButtonStyle.icon; }
        }
        Label { text: @tr("could not be rendered"); role: TextRole.value; tone: Tone.tertiary; centred: true; }
    }
    if root.state == PreviewState.rendering: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Progress { width: FormStyle.progress; fraction: -1; }
        }
    }
}

// `DSLCD`: a figure the app reports, flat on the scanner's glass at the plots' corner.
export component LcdReadout inherits Rectangle {
    in property <string> text;
    background: ScannerStyle.glass;
    border-radius: PlotStyle.radius;
    width: readout.preferred-width + 2 * Space.s;
    height: readout.preferred-height + 2 * Space.xxs;
    readout := Label {
        x: Space.s;
        y: Space.xxs;
        text: root.text;
        role: TextRole.value;
        tone: Tone.lcd;
    }
}

// `DSStatusBar`: the one bar under the viewer. Idle, its line and the seal a frame of passes wears
// right after it; busy, what loads, its count on the glass, its progress across the rest and its key.
export component StatusBar inherits Rectangle {
    in property <string> text;
    in property <string> seal;
    // Idle, a quieter word at the row's far end on what to do next; empty for none.
    in property <string> hint;
    in property <bool> busy;
    in property <string> count;
    // Below zero the work cannot be counted: the progress sweeps.
    in property <float> fraction: -1;
    // A key acting on the work under way, as Stop; empty for none.
    in property <string> key;
    in property <bool> key-enabled: true;
    callback key-clicked();
    height: StatusStyle.height;
    // The line starts the card's content inset in, after its owner's medals when they lead the row.
    HorizontalLayout {
        padding-left: StatusStyle.inset;
        spacing: Space.s;
        if root.busy: Label { text: root.text; role: TextRole.value; tone: Tone.secondary; vertical-alignment: center; overflow: elide; }
        if root.busy && root.count != "": VerticalLayout {
            alignment: center;
            LcdReadout { text: root.count; }
        }
        if root.busy: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Progress { fraction: root.fraction; }
        }
        // Centred on the row it stands taller than, as the seal stands out of it.
        if root.busy && root.key != "": Rectangle {
            width: key.preferred-width;
            key := Button {
                y: (parent.height - self.height) / 2;
                size: ButtonSize.mini;
                text: root.key;
                enabled: root.key-enabled;
                clicked => { root.key-clicked(); }
            }
        }
        // As wide as its words, eliding once the row is short of room.
        if !root.busy: Rectangle {
            horizontal-stretch: 0;
            min-width: 0;
            preferred-width: line.preferred-width;
            line := Label {
                width: parent.width;
                height: parent.height;
                role: TextRole.value;
                tone: Tone.secondary;
                text: root.text;
                overflow: elide;
            }
        }
        // The seal stands out of the row by its own height, as Swift's overlay does, so the bar keeps its height.
        if !root.busy && root.seal != "": Rectangle {
            width: seal.width;
            seal := Badge { tone: BadgeTone.seal; metal: Metal.holographic; text: root.seal; }
        }
        if !root.busy: Rectangle { horizontal-stretch: 1; }
        // As wide as its words, eliding once the row is short of room.
        if !root.busy && root.hint != "": Rectangle {
            horizontal-stretch: 0;
            min-width: 0;
            preferred-width: hint.preferred-width;
            hint := Label {
                width: parent.width;
                height: parent.height;
                role: TextRole.value;
                tone: Tone.tertiary;
                text: root.hint;
                overflow: elide;
            }
        }
    }
}

// A column's name heading it, wrapped whole over as many lines as it takes, typed over in the same face as a
// `RenameField` once clicked.
export component EditableTitle inherits VerticalLayout {
    in property <string> text;
    in property <string> placeholder;
    callback committed(string);
    // What the field holds while it is typed over, empty once it ends.
    callback edited(string);
    property <bool> renaming;
    if !root.renaming: Label {
        role: TextRole.title;
        text: root.text;
        wrap: word-wrap;
        TouchArea { clicked => { root.renaming = true; } }
        // Space or Return types it over while it holds the keyboard.
        KeyScope {
            radius: Radius.badge;
            key-pressed(event) => {
                if ((event.text != " " && event.text != Key.Return) || event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                    return reject;
                }
                root.renaming = true;
                accept
            }
        }
    }
    if root.renaming: RenameField {
        role: TextRole.title;
        outdent: true;
        text: root.text;
        placeholder: root.placeholder;
        edited(t) => { root.edited(t); }
        committed(t) => { root.renaming = false; root.edited(""); root.committed(t); }
        cancelled => { root.renaming = false; root.edited(""); }
    }
}
