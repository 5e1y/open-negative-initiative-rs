// The forms of export and colour management: a labelled field, a note, a summary box, a preview slot,
// a chip that opens a popover, and the panel a popover or a sheet draws on.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, State, Motion, FieldStyle, ButtonStyle, MenuStyle, CardStyle, StatusStyle, ScannerStyle } from "theme.slint";
import { Label, Icon, Picture, Ground, TextRole, Tone, Tips, Divider } from "base.slint";
import { HelpMark } from "containers.slint";
import { TextField, Button } from "controls.slint";
import { Icons } from "icons.slint";

export global FormStyle {
    out property <length> panel-width: DS.control-export-panel-width;
    out property <length> fields-width: DS.control-export-fields-width;
    out property <length> label-width: DS.control-exif-label-width;
    out property <length> caption: DS.control-export-caption-height;
    out property <length> preview-floor: DS.control-export-preview-floor;
    out property <length> size-field: DS.control-export-size-field-width;
    out property <length> progress: DS.control-inline-progress-width;
    out property <length> chip-height: DS.control-canvas-padding;
    out property <length> chip-icon: DS.control-icon-size * 0.7;
    out property <length> paper-width: DS.control-paper-sheet-width;
    out property <length> paper-height: DS.control-paper-sheet-height;
    out property <length> paper-list: DS.control-paper-sheet-list-width;
    out property <length> gap: Space.m;
    out property <length> row-gap: Space.xs;
}

// `DSField`: a secondary label, its "?" when it has a note, then the control under it.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: FormStyle.row-gap;
    HorizontalLayout {
        spacing: Space.s;
        alignment: start;
        Label { text: root.label; tone: Tone.secondary; }
        if root.help != "": VerticalLayout {
            alignment: center;
            HelpMark { note: root.help; }
        }
    }
    @children
}

// `dsNoteStyle`: a quiet line that wraps.
export component Note inherits Label {
    role: TextRole.value;
    tone: Tone.tertiary;
    wrap: word-wrap;
}

// A line in the warning ink, which the summary uses for an 8-bit source.
export component Warning inherits Text {
    font-family: Type.family;
    font-size: Type.value;
    color: DS.palette-warning;
    wrap: word-wrap;
}

// The summary box: the canvas's dark under value lines.
export component SummaryBox inherits Rectangle {
    background: Colour.canvas;
    border-radius: Radius.card;
    VerticalLayout {
        padding: Space.m;
        spacing: Space.xxs;
        @children
    }
}

// One EXIF line: the label at a fixed width, the control stretching after it.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: Space.s;
    Label { text: root.label; tone: Tone.secondary; width: FormStyle.label-width; }
    @children
}

// A text field with a fixed word after the typing, as a file name takes its extension.
export component SuffixField inherits HorizontalLayout {
    in-out property <string> text <=> field.text;
    in property <string> placeholder;
    in property <string> suffix;
    in property <bool> enabled: true;
    callback edited(string);
    spacing: Space.xxs;
    opacity: root.enabled ? 1 : State.disabled;
    field := TextField {
        horizontal-stretch: 1;
        placeholder: root.placeholder;
        enabled: root.enabled;
        edited(t) => { root.edited(t); }
    }
    if root.suffix != "": Label { text: root.suffix; tone: Tone.secondary; }
}

// A digit field centred at the size field's width.
export component NumberField inherits TextField {
    width: FormStyle.size-field;
}

// An export preview: the picture fitted whole, a dash while it renders, a word when it never will.
export component PreviewSlot inherits Rectangle {
    in property <image> source;
    // 0 waits, 1 shows the picture, 2 failed.
    in property <int> state;
    if root.state == 1: Picture {
        width: parent.width;
        height: parent.height;
        source: root.source;
        ground: Ground.canvas;
        rounded: true;
    }
    if root.state == 2: VerticalLayout {
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: center;
            Icon { source: Icons.warning; tone: Tone.tertiary; width: ButtonStyle.icon; height: ButtonStyle.icon; }
        }
        Label { text: "could not be rendered"; role: TextRole.value; tone: Tone.tertiary; centred: true; }
    }
    if root.state == 0: Label { text: "…"; role: TextRole.title; tone: Tone.tertiary; centred: true; width: parent.width; height: parent.height; }
}

// The Working Space chip: the space's name in secondary ink, its use in full, a chevron.
export component Chip inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> help;
    callback clicked();
    width: row.preferred-width;
    height: FormStyle.chip-height;
    border-radius: Radius.badge;
    background: area.has-hover ? Colour.hover : transparent;
    accessible-role: button;
    accessible-label: root.title + " · " + root.hint;
    row := HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.xs;
        Label { text: root.title + " · "; tone: Tone.secondary; }
        Label { text: root.hint; }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.chevron-down; width: FormStyle.chip-icon; height: FormStyle.chip-icon; }
        }
    }
    area := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { Tips.hover(self.has-hover, root.help, root.absolute-position.x, root.absolute-position.y + root.height); }
    }
}

// `dsPopover`'s body: a raised panel at the export panel's width.
export component PopoverPanel inherits Rectangle {
    width: FormStyle.panel-width;
    height: column.preferred-height;
    background: Colour.raised;
    border-radius: Radius.card;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    // A click inside stays inside, so only a click outside closes the popover.
    TouchArea { }
    column := VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        @children
    }
}

// A popover anchored under the control that opened it, closed by a click outside.
export component Popover inherits PopupWindow {
    close-policy: close-on-click-outside;
    PopoverPanel {
        @children
    }
}

// A board on the scrim, laid out as the app is: a title bar with its exit, then a sidebar and a card.
export component BoardSheet inherits Rectangle {
    in property <string> title;
    in property <string> exit: "Done";
    callback dismissed();
    background: Colour.scrim;
    TouchArea { clicked => { root.dismissed(); } }
    Rectangle {
        width: FormStyle.paper-width;
        height: FormStyle.paper-height;
        background: Colour.ground;
        border-radius: Radius.card;
        border-width: Stroke.hairline;
        border-color: Colour.separator;
        clip: true;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding: Space.m;
                Label { text: root.title; role: TextRole.title; horizontal-stretch: 1; }
                Button { text: root.exit; clicked => { root.dismissed(); } }
            }
            Divider { }
            HorizontalLayout {
                vertical-stretch: 1;
                @children
            }
        }
    }
}

// The board's card: the canvas's dark, inset from the sheet's right and bottom edges.
export component BoardCard inherits Rectangle {
    horizontal-stretch: 1;
    background: Colour.canvas;
    border-radius: Radius.card;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        alignment: start;
        @children
    }
}

// A sidebar group's heading, in capitals and the tertiary ink.
export component GroupHeading inherits Label {
    role: TextRole.label;
    tone: Tone.tertiary;
}

// `DSProgress`: a recessed track lit up to the fraction done; below zero, no total, a lit segment
// sweeps it, so a wait that cannot be counted still reads as moving.
export component Progress inherits Rectangle {
    in property <float> fraction;
    property <bool> counted: root.fraction >= 0;
    // Read only while sweeping, so a counted bar asks no frame of its own.
    property <float> swing: root.counted ? 0 : Math.mod(animation-tick() / DS.motion-sweep-duration, 2);
    property <float> eased: (1 - cos((root.swing < 1 ? root.swing : 2 - root.swing) * 180deg)) / 2;
    height: DS.control-track-height;
    border-radius: Radius.track;
    background: Colour.track;
    Rectangle {
        x: root.counted ? 0 : (parent.width - self.width) * root.eased;
        width: root.counted ? parent.width * clamp(root.fraction, 0, 1) : parent.width * DS.control-progress-segment;
        border-radius: Radius.track;
        background: Colour.selected;
        drop-shadow-color: Colour.selected;
        drop-shadow-blur: DS.scanner-phosphor-glow;
        animate width { duration: Motion.quick; }
    }
}

// `DSLCD`: a count on the scanner's glass.
export component LcdReadout inherits Rectangle {
    in property <string> text;
    background: ScannerStyle.glass;
    border-radius: Radius.track;
    width: readout.preferred-width + 2 * Space.s;
    height: readout.preferred-height + 2 * Space.xxs;
    readout := Label {
        text: root.text;
        role: TextRole.value;
        color: ScannerStyle.lcd-ink;
    }
}

// `DSStatusBar`'s busy row: what loads, its count on the glass, its progress across the rest.
export component LoadBar inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <float> fraction: -1;
    height: StatusStyle.height;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        Label { text: root.title; role: TextRole.label; vertical-alignment: center; overflow: elide; }
        if root.count != "": VerticalLayout {
            alignment: center;
            LcdReadout { text: root.count; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Progress { fraction: root.fraction; }
        }
    }
}
