// The forms of export and colour management: a labelled field, a note, a summary box, a preview slot,
// a chip that opens a popover, and the panel a popover or a sheet draws on.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Stroke, Type, State, Motion, FieldStyle, ButtonStyle, SectionStyle, MenuStyle, CardStyle, StatusStyle, ScannerStyle, SheetStyle } from "theme.slint";
import { Label, Icon, Picture, Ground, TextRole, Tone, Tips, Divider } from "base.slint";
import { HelpMark } from "containers.slint";
import { TextField, RenameField, Button, Look } from "controls.slint";
import { Icons } from "icons.slint";

export global FormStyle {
    out property <length> panel-width: DS.control-export-panel-width;
    out property <length> fields-width: DS.control-export-fields-width;
    out property <length> label-width: DS.control-exif-label-width;
    out property <length> caption: DS.control-export-caption-height;
    out property <length> preview-floor: DS.control-export-preview-floor;
    // `SizeFields`: Swift's width is the digits' own, the hollow's padding laid outside it.
    out property <length> size-field: DS.control-export-size-field-width + 2 * FieldStyle.padding;
    out property <length> progress: DS.control-inline-progress-width;
    out property <length> chip-height: DS.control-canvas-padding;
    out property <length> chip-icon: DS.control-icon-size * 0.7;
    out property <length> paper-width: DS.control-paper-sheet-width;
    out property <length> paper-height: DS.control-paper-sheet-height;
    out property <length> paper-list: DS.control-paper-sheet-list-width;
    out property <length> gap: Space.m;
    out property <length> row-gap: Space.xs;
}

// How a field lays its label: `stacked` over the control as `DSField`, `column` at a form's fixed
// width before it as an EXIF line, `spread` in the primary ink taking the room before it.
export enum FieldLayout { stacked, column, spread }

// `DSField`: a label, its "?" when it has a note, then the control.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <FieldLayout> layout: FieldLayout.stacked;
    property <bool> stacked: root.layout == FieldLayout.stacked;
    spacing: FormStyle.row-gap;
    // As tall without its "?" as with it, so every field keeps one rhythm.
    if root.stacked: HorizontalLayout {
        spacing: Space.s;
        alignment: start;
        min-height: SectionStyle.help-mark;
        Label { text: root.label; tone: Tone.secondary; }
        if root.help != "": VerticalLayout {
            alignment: center;
            HelpMark { note: root.help; }
        }
    }
    HorizontalLayout {
        spacing: Space.s;
        if root.layout == FieldLayout.column: Label { text: root.label; tone: Tone.secondary; width: FormStyle.label-width; }
        if root.layout == FieldLayout.spread: Label { text: root.label; horizontal-stretch: 1; }
        VerticalLayout {
            horizontal-stretch: root.layout == FieldLayout.spread ? 0 : 1;
            spacing: FormStyle.row-gap;
            @children
        }
    }
}

// `DSWarning`: a triangle, then the sentence under it, on a pale orange band.
export component WarningBand inherits Rectangle {
    in property <string> text;
    background: Colour.warning-soft;
    border-radius: Radius.badge;
    VerticalLayout {
        padding: Space.s;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: start;
            Icon { source: Icons.warning; width: ButtonStyle.icon; height: ButtonStyle.icon; tone: Tone.on-warning; }
        }
        Label { text: root.text; wrap: word-wrap; tone: Tone.on-warning; }
    }
}

// The summary box: the canvas's dark under value lines.
export component SummaryBox inherits Rectangle {
    background: Colour.canvas;
    border-radius: Radius.card;
    VerticalLayout {
        padding: Space.m;
        spacing: Space.xxs;
        @children
    }
}

// An export preview: the picture fitted whole, a dash while it renders, a word when it never will.
export component PreviewSlot inherits Rectangle {
    in property <image> source;
    // 0 waits, 1 shows the picture, 2 failed.
    in property <int> state;
    if root.state == 1: Picture {
        width: parent.width;
        height: parent.height;
        source: root.source;
        ground: Ground.canvas;
        rounded: true;
    }
    if root.state == 2: VerticalLayout {
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: center;
            Icon { source: Icons.warning; tone: Tone.tertiary; width: ButtonStyle.icon; height: ButtonStyle.icon; }
        }
        Label { text: @tr("could not be rendered"); role: TextRole.value; tone: Tone.tertiary; centred: true; }
    }
    if root.state == 0: Label { text: "…"; role: TextRole.title; tone: Tone.tertiary; centred: true; width: parent.width; height: parent.height; }
}

// `dsPopover`'s body: the panel's ground at the export panel's width, its padding inside it.
export component PopoverPanel inherits Rectangle {
    width: FormStyle.panel-width;
    height: column.preferred-height;
    background: Colour.ground;
    border-radius: Radius.card;
    border-width: Stroke.hairline;
    border-color: Colour.separator;
    // A click inside stays inside, so only a click outside closes the popover.
    TouchArea { }
    column := VerticalLayout {
        padding: Space.m;
        spacing: Space.m;
        @children
    }
}

// A popover anchored under the control that opened it, closed by a click outside. Sized as its
// panel: unsized, its content is hit at another width than drawn and a tab picks its neighbour.
export component Popover inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: panel.width;
    height: panel.height;
    panel := PopoverPanel {
        @children
    }
}

// A board laid out as the app is: a title bar with its exit, then a sidebar and a card; modal as
// `Sheet`, hung from the window's top at most the window's height, Escape its exit.
export component BoardSheet inherits Rectangle {
    in property <string> title;
    in property <string> exit: @tr("Done");
    callback dismissed();
    TouchArea { }
    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }
        Rectangle {
            y: SheetStyle.margin;
            width: FormStyle.paper-width;
            height: min(FormStyle.paper-height, root.height - 2 * SheetStyle.margin);
            background: Colour.ground;
            border-radius: Radius.card;
            border-width: Stroke.hairline;
            border-color: Colour.separator;
            drop-shadow-blur: SheetStyle.shadow;
            drop-shadow-color: Colour.scrim;
            clip: true;
            TouchArea { }
            VerticalLayout {
                HorizontalLayout {
                    padding: Space.m;
                    padding-left: SheetStyle.padding;
                    padding-right: SheetStyle.padding;
                    Label { text: root.title; role: TextRole.title; horizontal-stretch: 1; }
                    Button { text: root.exit; clicked => { root.dismissed(); } }
                }
                Divider { }
                HorizontalLayout {
                    vertical-stretch: 1;
                    @children
                }
            }
        }
    }
}

// The board's card: the canvas's dark, inset from the sheet's right and bottom edges.
export component BoardCard inherits Rectangle {
    horizontal-stretch: 1;
    background: Colour.canvas;
    border-radius: Radius.card;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        alignment: start;
        @children
    }
}

// `DSProgress`: a recessed track lit up to the fraction done; below zero, no total, a lit segment
// sweeps it, so a wait that cannot be counted still reads as moving.
export component Progress inherits Rectangle {
    in property <float> fraction;
    property <bool> counted: root.fraction >= 0;
    // Read only while sweeping, so a counted bar asks no frame of its own.
    property <float> swing: root.counted ? 0 : Math.mod(animation-tick() / DS.motion-sweep-duration, 2);
    property <float> eased: (1 - cos((root.swing < 1 ? root.swing : 2 - root.swing) * 180deg)) / 2;
    height: DS.control-track-height;
    border-radius: Radius.track;
    background: Colour.track;
    Rectangle {
        x: root.counted ? 0 : (parent.width - self.width) * root.eased;
        width: root.counted ? parent.width * clamp(root.fraction, 0, 1) : parent.width * DS.control-progress-segment;
        border-radius: Radius.track;
        background: Colour.selected;
        drop-shadow-color: Colour.selected;
        drop-shadow-blur: DS.scanner-phosphor-glow;
    }
}

// `DSLCD`: a count on the scanner's glass.
export component LcdReadout inherits Rectangle {
    in property <string> text;
    background: ScannerStyle.glass;
    border-radius: Radius.track;
    width: readout.preferred-width + 2 * Space.s;
    height: readout.preferred-height + 2 * Space.xxs;
    readout := Label {
        text: root.text;
        role: TextRole.value;
        tone: Tone.lcd;
    }
}

// `DSStatusBar`'s busy row: what loads, its count on the glass, its progress across the rest.
export component LoadBar inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <float> fraction: -1;
    height: StatusStyle.height;
    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        Label { text: root.title; role: TextRole.value; tone: Tone.secondary; vertical-alignment: center; overflow: elide; }
        if root.count != "": VerticalLayout {
            alignment: center;
            LcdReadout { text: root.count; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Progress { fraction: root.fraction; }
        }
    }
}

// A title that reads as text until clicked, then typed over as a `RenameField`.
export component EditableTitle inherits VerticalLayout {
    in property <string> text;
    in property <string> placeholder;
    callback committed(string);
    property <bool> renaming;
    if !root.renaming: Label {
        role: TextRole.title;
        text: root.text;
        TouchArea { clicked => { root.renaming = true; } }
    }
    if root.renaming: RenameField {
        text: root.text;
        placeholder: root.placeholder;
        committed(t) => { root.renaming = false; root.committed(t); }
        cancelled => { root.renaming = false; }
    }
}
