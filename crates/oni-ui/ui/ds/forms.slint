// The forms of export and colour management: a labelled field, a note, a preview slot, progress, the
// status bar and a title typed over.
import { DS } from "tokens.slint";
import { Colour, Space, Radius, Motion, FieldStyle, ButtonStyle, SectionStyle, StatusStyle, ScannerStyle, SurfaceStyle } from "theme.slint";
import { Label, Icon, Picture, Ground, TextRole, Tone } from "base.slint";
import { Badge, BadgeTone, Metal } from "badge.slint";
import { HelpMark } from "containers.slint";
import { RenameField } from "controls.slint";
import { Icons } from "icons.slint";
import { Inward } from "depth.slint";

export global FormStyle {
    out property <length> panel-width: DS.control-export-panel-width;
    out property <length> fields-width: DS.control-export-fields-width;
    out property <length> label-width: DS.control-exif-label-width;
    out property <length> caption: DS.control-export-caption-height;
    out property <length> preview-floor: DS.control-export-preview-floor;
    // `SizeFields`: Swift's width is the digits' own, the hollow's padding laid outside it.
    out property <length> size-field: DS.control-export-size-field-width + 2 * FieldStyle.padding;
    out property <length> progress: DS.control-inline-progress-width;
    out property <length> chip-icon: DS.control-icon-size * 0.7;
    out property <length> paper-width: DS.control-paper-sheet-width;
    out property <length> paper-height: DS.control-paper-sheet-height;
    out property <length> paper-list: DS.control-paper-sheet-list-width;
    out property <length> gap: Space.m;
    out property <length> row-gap: Space.xs;
}

// How a field lays its label: `stacked` over the control as `DSField`, `column` at a form's fixed
// width before it as an EXIF line, `spread` in the primary ink taking the room before it.
export enum FieldLayout { stacked, column, spread }

// `DSField`: a label, its "?" when it has a note, then the control.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <FieldLayout> layout: FieldLayout.stacked;
    property <bool> stacked: root.layout == FieldLayout.stacked;
    spacing: FormStyle.row-gap;
    // As tall without its "?" as with it, so every field keeps one rhythm.
    if root.stacked: HorizontalLayout {
        spacing: Space.s;
        alignment: start;
        min-height: SectionStyle.help-mark;
        Label { text: root.label; tone: Tone.secondary; }
        if root.help != "": VerticalLayout {
            alignment: center;
            HelpMark { note: root.help; }
        }
    }
    HorizontalLayout {
        spacing: Space.s;
        if root.layout == FieldLayout.column: Label { text: root.label; tone: Tone.secondary; width: FormStyle.label-width; }
        if root.layout == FieldLayout.spread: Label { text: root.label; horizontal-stretch: 1; }
        VerticalLayout {
            horizontal-stretch: root.layout == FieldLayout.spread ? 0 : 1;
            spacing: FormStyle.row-gap;
            @children
        }
    }
}

// `DSWarning`: a triangle, then the sentence under it, on a pale orange band.
export component WarningBand inherits Rectangle {
    in property <string> text;
    background: Colour.warning-soft;
    border-radius: Radius.badge;
    VerticalLayout {
        padding: Space.s;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: start;
            Icon { source: Icons.warning; width: ButtonStyle.icon; height: ButtonStyle.icon; tone: Tone.on-warning; }
        }
        Label { text: root.text; wrap: word-wrap; tone: Tone.on-warning; }
    }
}

// `DSProgress`: a track's recess lit up to the fraction done, glowing; below zero, no total, a lit
// segment sweeps it, so a wait that cannot be counted still reads as moving.
export component Progress inherits Inward {
    in property <float> fraction;
    property <bool> counted: root.fraction >= 0;
    // Read only while sweeping, so a counted bar asks no frame of its own.
    property <float> swing: root.counted ? 0 : Math.mod(animation-tick() / DS.motion-sweep-duration, 2);
    property <float> eased: (1 - cos((root.swing < 1 ? root.swing : 2 - root.swing) * 180deg)) / 2;
    ground: Colour.track;
    radius: Radius.track;
    height: DS.control-track-height;
    Rectangle {
        x: root.counted ? 0 : (root.width - self.width) * root.eased;
        width: root.counted ? root.width * clamp(root.fraction, 0, 1) : root.width * DS.control-progress-segment;
        // `Motion.settle`, a spring of 0.38 s damped 0.72: a slight overshoot.
        animate width { duration: Motion.settle; easing: ease-out-back; }
        background: Colour.selected;
        drop-shadow-color: Colour.selected;
        drop-shadow-blur: SurfaceStyle.progress-glow;
    }
}

// What an export preview shows: a sweep while it renders, the picture, or the word it never will.
export enum PreviewState { rendering, shown, failed }

// An export preview on the canvas's dark: the picture fitted whole, a sweep while it renders (the
// inline progress's width), a word when it never will.
export component PreviewSlot inherits Rectangle {
    in property <image> source;
    in property <PreviewState> state;
    background: Colour.canvas;
    if root.state == PreviewState.shown: Picture {
        width: parent.width;
        height: parent.height;
        source: root.source;
        ground: Ground.canvas;
        rounded: true;
    }
    if root.state == PreviewState.failed: VerticalLayout {
        alignment: center;
        spacing: Space.xs;
        HorizontalLayout {
            alignment: center;
            Icon { source: Icons.warning; tone: Tone.tertiary; width: ButtonStyle.icon; height: ButtonStyle.icon; }
        }
        Label { text: @tr("could not be rendered"); role: TextRole.value; tone: Tone.tertiary; centred: true; }
    }
    if root.state == PreviewState.rendering: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Progress { width: FormStyle.progress; fraction: -1; }
        }
    }
}

// `DSLCD`: a count on the scanner's glass, in a track's recess, its ink glowing.
export component LcdReadout inherits Inward {
    in property <string> text;
    ground: ScannerStyle.glass;
    radius: Radius.track;
    width: readout.preferred-width + 2 * Space.s;
    height: readout.preferred-height + 2 * Space.xxs;
    Label {
        x: readout.x;
        y: readout.y;
        text: root.text;
        role: TextRole.value;
        ink: ScannerStyle.lcd-ink.with-alpha(SurfaceStyle.lcd-glow);
        stroke: ScannerStyle.lcd-ink.with-alpha(SurfaceStyle.lcd-glow * 0.5);
        stroke-width: SurfaceStyle.lcd-glow-width;
        stroke-style: outside;
    }
    readout := Label {
        x: Space.s;
        y: Space.xxs;
        text: root.text;
        role: TextRole.value;
        tone: Tone.lcd;
    }
}

// `DSStatusBar`: the one bar under the viewer. Idle, its line and the seal a frame of passes wears
// right after it; busy, what loads, its count on the glass and its progress across the rest.
export component StatusBar inherits Rectangle {
    in property <string> text;
    in property <string> seal;
    in property <bool> busy;
    in property <string> count;
    // Below zero the work cannot be counted: the progress sweeps.
    in property <float> fraction: -1;
    height: StatusStyle.height;
    HorizontalLayout {
        padding-left: root.busy ? Space.s : 0px;
        padding-right: root.busy ? Space.s : 0px;
        spacing: Space.s;
        if root.busy: Label { text: root.text; role: TextRole.value; tone: Tone.secondary; vertical-alignment: center; overflow: elide; }
        if root.busy && root.count != "": VerticalLayout {
            alignment: center;
            LcdReadout { text: root.count; }
        }
        if root.busy: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Progress { fraction: root.fraction; }
        }
        // As wide as its words, eliding once the row is short of room.
        if !root.busy: Rectangle {
            horizontal-stretch: 0;
            min-width: 0;
            preferred-width: line.preferred-width + 2 * Space.s;
            line := Label {
                x: Space.s;
                width: parent.width - 2 * Space.s;
                height: parent.height;
                role: TextRole.value;
                tone: Tone.secondary;
                text: root.text;
                overflow: elide;
            }
        }
        // The seal stands out of the row by its own height, as Swift's overlay does, so the bar keeps its height.
        if !root.busy && root.seal != "": Rectangle {
            width: seal.width;
            seal := Badge { tone: BadgeTone.seal; metal: Metal.holographic; text: root.seal; }
        }
        if !root.busy: Rectangle { horizontal-stretch: 1; }
    }
}

// A title that reads as text until clicked, then typed over as a `RenameField`.
export component EditableTitle inherits VerticalLayout {
    in property <string> text;
    in property <string> placeholder;
    callback committed(string);
    property <bool> renaming;
    if !root.renaming: Label {
        role: TextRole.title;
        text: root.text;
        TouchArea { clicked => { root.renaming = true; } }
    }
    if root.renaming: RenameField {
        text: root.text;
        placeholder: root.placeholder;
        committed(t) => { root.renaming = false; root.committed(t); }
        cancelled => { root.renaming = false; }
    }
}
