// The presets' deck on the canvas's bottom edge.
import { Space, State, PresetStyle, PresetFace, PresetTab, Badge, Scroller, Tips, Menu } from "ds/ds.slint";
import { Presets } from "presets.slint";

// `PresetCarousel`: its tab on the canvas's bottom edge opens the deck, which closes on the tab or
// once the pointer leaves it; a card previews under the pointer and applies on a click.
export component PresetDeck inherits Rectangle {
    accessible-role: list;
    accessible-label: @tr("Presets");
    // The cards' band over the tab: the lift a card rises by, the card, the gap down to the tab.
    property <length> band: PresetStyle.lift + PresetStyle.card-height + Space.s;
    property <bool> open;
    property <length> menu-x;
    property <length> menu-y;
    height: root.band + PresetStyle.peek + Space.l + Space.m;
    clip: true;
    if root.open: Badge {
        x: (root.width - self.width) / 2;
        y: zone.y - Space.l;
        text: Presets.hint;
    }
    // Deaf while closed, so the canvas's edge beside the tab stays the photo's.
    zone := TouchArea {
        y: root.height - self.height;
        height: root.band + PresetStyle.peek;
        enabled: root.open;
        changed has-hover => {
            if (!self.has-hover) {
                root.open = false;
            }
        }
        // Every wheel is the deck's, or the canvas under it would take it.
        scroll-event(event) => {
            root.roll-by(abs(event.delta-y) > abs(event.delta-x) ? event.delta-y : event.delta-x);
            accept
        }
        // The cards rise out of the tab's top edge and sink back behind it, their band on the tab.
        Rectangle {
            y: 0;
            height: root.band;
            clip: true;
            HorizontalLayout {
                y: root.open ? 0 : root.band;
                height: root.band;
                animate y { duration: PresetStyle.rise; }
                padding-left: Space.l;
                padding-right: Space.l;
                spacing: Space.s;
                alignment: start;
                Rectangle {
                    width: PresetStyle.card-width;
                    PresetFace { new: true;
                        y: PresetStyle.lift - (self.lit ? PresetStyle.lift : 0px);
                        lit: plus.has-hover && Presets.can-update;
                        enabled: Presets.can-update;
                        animate y { duration: PresetStyle.rise; }
                    }
                    // On the cell, not the face: the face rises off the pointer it lifts under.
                    plus := TouchArea {
                        height: PresetStyle.lift + PresetStyle.card-height;
                        enabled: Presets.can-update;
                        accessible-role: button;
                        accessible-label: @tr("New preset");
                        accessible-action-default => { Presets.create(); }
                        clicked => { Presets.create(); }
                        changed has-hover => { Tips.hover(self.has-hover, @tr("Save this photo’s settings as a preset…"), self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                }
                roll-view := Scroller {
                    horizontal: true;
                    knob: false;
                    horizontal-stretch: 1;
                    content-width: roll.preferred-width;
                    roll := HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        for card[i] in Presets.cards: Rectangle {
                            width: PresetStyle.card-width;
                            if i == 0: Rectangle {
                                changed absolute-position => { Presets.first-x = self.absolute-position.x; Presets.first-y = self.absolute-position.y; }
                                init => { Presets.first-x = self.absolute-position.x; Presets.first-y = self.absolute-position.y; }
                            }
                            PresetFace {
                                y: PresetStyle.lift - (Presets.hovered == i ? PresetStyle.lift : 0px);
                                lifted: Presets.hovered == i;
                                name: card.name;
                                fill: card.fill;
                                ink: card.ink;
                                opacity: Presets.can-apply ? 1 : State.disabled;
                                animate y { duration: PresetStyle.rise; }
                            }
                            TouchArea {
                                height: PresetStyle.lift + PresetStyle.card-height;
                                accessible-role: button;
                                accessible-label: card.name;
                                accessible-enabled: Presets.can-apply;
                                accessible-action-default => { if (Presets.can-apply) { Presets.apply(i); } }
                                changed has-hover => {
                                    if (self.has-hover && Presets.can-apply) {
                                        Presets.hover(i);
                                    } else if (Presets.hovered == i) {
                                        Presets.hover(-1);
                                    }
                                    Tips.hover(self.has-hover, card.help, self.absolute-position.x, self.absolute-position.y + self.height);
                                }
                                clicked => { if (Presets.can-apply) { Presets.apply(i); } }
                                // Kept, or the card would lose its hover; a sideways one is the roll's own.
                                scroll-event(event) => {
                                    if (abs(event.delta-y) > abs(event.delta-x)) {
                                        root.roll-by(event.delta-y);
                                        return accept;
                                    }
                                    reject
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                        if (Presets.card-menu(i)) { menu.show(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        PresetTab {
            x: Space.l;
            y: root.band;
            text: @tr("Presets");
            lit: tab.has-hover || root.open;
            tab := TouchArea {
                accessible-role: button;
                accessible-label: @tr("Presets");
                accessible-expandable: true;
                accessible-expanded: root.open;
                accessible-action-default => { root.open = !root.open; }
                clicked => { root.open = !root.open; }
            }
        }
    }
    // `ScrollView(.horizontal)`: a vertical wheel scrolls the roll sideways, held to its ends.
    function roll-by(by: length) {
        roll-view.content-x = max(min(roll-view.content-x + by, 0px), min(0px, roll-view.width - roll-view.content-width));
    }
    menu := Menu {
        x: root.menu-x;
        y: root.menu-y;
        lines: Presets.menu-lines;
        chosen(i) => { Presets.menu-chosen(i); menu.close(); }
    }
}
