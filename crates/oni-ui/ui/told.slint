// What a gesture could not do or did only in part, said wherever the hand is: over the gallery,
// the organiser and the editor alike, never in a status line one of them hides.
import { Toast } from "ds/ds.slint";

export global Told {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    // Its one action's key, as Show in Finder; empty for none.
    in property <string> action;
    in property <int> serial;
    callback acted();
    callback closed();
    // An export written: the notice invites, quietly, to post the photos with ONI's hashtag; its keys copy
    // the hashtag, open ONI's Instagram, or hide the line for good (Settings brings it back).
    in property <bool> invite;
    in property <string> tag;
    in property <bool> copied;
    callback copy-tag();
    callback instagram();
    callback hide-invite();
}

export component ToldNotice inherits Toast {
    title: Told.title;
    message: Told.message;
    action: Told.action;
    serial: Told.serial;
    acted => { Told.acted(); }
    closed => { Told.closed(); }
    aside: Told.invite ? @tr("Post your photos on Instagram with {}, we'd love to see them.", Told.tag) : "";
    aside-keys: [Told.copied ? @tr("Copied") : @tr("Copy {}", Told.tag), @tr("Open Instagram"), @tr("Don't Show Again")];
    aside-acted(i) => {
        if (i == 0) { Told.copy-tag(); } else if (i == 1) { Told.instagram(); } else { Told.hide-invite(); }
    }
}
