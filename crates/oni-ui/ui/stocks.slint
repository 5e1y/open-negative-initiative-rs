// `StockPickerSheet`: Select Film Stock as The Lens DB's sheet is laid, the stocks searched and filtered by brand, each a
// card of the Kit's whose Select picks it and closes; `StockHero`, a stock shown large with its key to the sheet, or to
// the menu that shows each stock on the open photo.
import { Space, StockStyle, SectionStyle, Label, TextRole, Button, StockIcon, StockLine, StockMenu, Bounds } from "ds/ds.slint";
import { Badge, BadgeTone, Metal, KitStyle, ShellStyle, SheetStyle, Sheet, SheetHeader } from "ds/ds.slint";
import { KitMark } from "gear_state.slint";
import { PieceCard } from "kit.slint";
import { SearchPane } from "search_pane.slint";

// A stock as its hero shows it: its name, a line under it, empty for none, and its canister.
export struct Canister { name: string, note: string, artwork: image, has-artwork: bool }

// `detail`: its brand, or what a line, its stock never named, says.
export struct StockCell { index: int, name: string, detail: string, artwork: image, has-artwork: bool, picked: bool }
export struct StockRow { cells: [StockCell] }

export global Stocks {
    in property <bool> shown;
    in property <[StockRow]> rows;
    in property <int> columns: 3;
    // The brand filter beside the search: every brand first, then each with how many stocks it lists.
    in property <[string]> brands;
    in property <int> brand;
    callback search(string);
    callback brand-chosen(int);
    // The stock's place in the catalogue, -1 for Done.
    callback chosen(int);
    // The editor's menu, laid by `dropping` as it opens: its lines and the one in use. The stock lit shows on
    // the photo without a write, -1 its own again; one chosen is written as a pick from the sheet is.
    in property <[StockLine]> lines;
    in property <int> in-use: -1;
    callback dropping();
    callback lit(int);
    callback picked(int);
}

export component StockPickerSheet inherits Sheet {
    title: @tr("Select Film Stock");
    header: SheetHeader.bar;
    card-width: KitStyle.sheet-width + ShellStyle.panel-width;
    card-height: KitStyle.sheet-height;
    dismissed => { Stocks.chosen(-1); }
    SearchPane {
        vertical-stretch: 1;
        name: @tr("Search Film Stocks");
        placeholder: @tr("A brand, a film: Portra 400, HP5…");
        kinds: Stocks.brands;
        kind: Stocks.brand;
        kind-help: @tr("Every brand or one");
        searched(t) => { Stocks.search(t); }
        kind-chosen(i) => { Stocks.brand-chosen(i); }
        if Stocks.rows.length == 0: Label {
            role: TextRole.note;
            wrap: word-wrap;
            text: Stocks.brand == 0 ? @tr("No film stock matches these words.") : @tr("No film stock of this brand matches these words.");
        }
        for row in Stocks.rows: HorizontalLayout {
            spacing: Space.s;
            alignment: start;
            for cell in row.cells: PieceCard {
                width: (root.card-width - 2 * SheetStyle.padding - (Stocks.columns - 1) * Space.s) / Stocks.columns;
                adding: true;
                linked: false;
                take: @tr("Select");
                take-glyph: false;
                picked: cell.picked;
                artwork: cell.artwork;
                has-artwork: cell.has-artwork;
                piece: { name: cell.name, detail: cell.detail, mark: KitMark.free, photos: -1 };
                taken => { Stocks.chosen(cell.index); }
            }
        }
    }
}

// `heroStock`: the canister large, the name and its line under it, what a place adds, then the key to the sheet,
// or, `drops`, to the menu dropped under it, which the canister and the name open too.
export component StockHero inherits VerticalLayout {
    in property <Canister> stock;
    // The light a virtual film is balanced for, named on a holographic seal beside its name: 1 daylight, 2 tungsten.
    in property <int> balance;
    in property <bool> enabled: true;
    in property <bool> drops;
    callback select();
    // The menu's close, by a choice, Escape or a press outside: the photo shows its own stock again.
    property <bool> open: menu.is-open;
    changed open => { if (!self.open) { Stocks.lit(-1); } }
    function drop() {
        Stocks.dropping();
        menu.show();
    }
    spacing: SectionStyle.gap;
    face := Rectangle {
        height: column.preferred-height;
        column := VerticalLayout {
            spacing: SectionStyle.gap;
            HorizontalLayout {
                alignment: center;
                StockIcon { artwork: root.stock.artwork; has-artwork: root.stock.has-artwork; side: StockStyle.hero; }
            }
            if root.stock.name != "" && root.balance == 0: Label { text: root.stock.name; centred: true; wrap: word-wrap; }
            if root.stock.name != "" && root.balance > 0: HorizontalLayout {
                alignment: center;
                spacing: Space.s;
                Label { text: root.stock.name; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Badge {
                        tone: BadgeTone.seal;
                        metal: root.balance == 1 ? Metal.holo-blue : Metal.holo-green;
                        text: root.balance == 1 ? @tr("Daylight") : @tr("Tungsten");
                    }
                }
            }
            if root.stock.note != "": Label { text: root.stock.note; role: TextRole.note; centred: true; }
        }
        TouchArea {
            enabled: root.drops && root.enabled;
            mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => { root.drop(); }
        }
    }
    @children
    key := Button {
        text: @tr("Select Film Stock");
        enabled: root.enabled;
        clicked => {
            if (root.drops) {
                root.drop();
            } else {
                root.select();
            }
        }
    }
    menu := StockMenu {
        x: key.x;
        y: key.y + key.height + Space.xxs;
        span: key.width;
        // The window's height under the key, a few lines at least, so the menu never covers its key.
        room: max(Bounds.height - key.absolute-position.y - key.height - Space.xxs - Space.m, 6 * StockStyle.line);
        lines: Stocks.lines;
        current: Stocks.in-use;
        lit(i) => { Stocks.lit(i); }
        chosen(i) => { Stocks.picked(i); }
    }
}
