// `StockPickerSheet`: Select Film Stock, the stocks grouped by brand, one click picking and closing; `StockHero`,
// a stock shown large with its key to the sheet, or to the menu that shows each stock on the open photo.
import { Space, StockStyle, SectionStyle, Label, TextRole, Tone, Button, Divider, Scroller, Sheet, SheetHeader, StockCellView, StockIcon, StockLine, StockMenu, Bounds, Badge, BadgeTone, Metal } from "ds/ds.slint";

// A stock as its hero shows it: its name, a line under it, empty for none, and its canister.
export struct Canister { name: string, note: string, artwork: image, has-artwork: bool }

// `note`: what a line, its stock never named, says under its name.
export struct StockCell { index: int, name: string, note: string, artwork: image, has-artwork: bool, picked: bool }
export struct StockRow { cells: [StockCell] }
export struct StockBrand { brand: string, rows: [StockRow] }

export global Stocks {
    in property <bool> shown;
    in property <[StockBrand]> brands;
    // Fewer than `GridItem(.adaptive)`'s ten, so a name reads whole until the final look lands.
    in property <int> columns: 6;
    // The stock's place in the catalogue, -1 for Done.
    callback chosen(int);
    // The editor's menu, laid by `dropping` as it opens: its lines and the one in use. The stock lit shows on
    // the photo without a write, -1 its own again; one chosen is written as a pick from the sheet is.
    in property <[StockLine]> lines;
    in property <int> in-use: -1;
    callback dropping();
    callback lit(int);
    callback picked(int);
}

export component StockPickerSheet inherits Sheet {
    title: @tr("Select Film Stock");
    header: SheetHeader.bar;
    card-width: StockStyle.width;
    card-height: StockStyle.height;
    dismissed => { Stocks.chosen(-1); }
    Scroller {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Space.m;
            spacing: Space.l;
            alignment: start;
            for brand in Stocks.brands: VerticalLayout {
                spacing: Space.s;
                Label { text: brand.brand; tone: Tone.secondary; }
                for row in brand.rows: HorizontalLayout {
                    spacing: Space.s;
                    alignment: start;
                    for cell in row.cells: StockCellView {
                        width: (StockStyle.width - 2 * Space.m - (Stocks.columns - 1) * Space.s) / Stocks.columns;
                        artwork: cell.artwork;
                        has-artwork: cell.has-artwork;
                        name: cell.name;
                        note: cell.note;
                        picked: cell.picked;
                        clicked => { Stocks.chosen(cell.index); }
                    }
                }
            }
        }
    }
}

// `heroStock`: the canister large, the name and its line under it, what a place adds, then the key to the sheet,
// or, `drops`, to the menu dropped under it, which the canister and the name open too.
export component StockHero inherits VerticalLayout {
    in property <Canister> stock;
    // The light a virtual film is balanced for, named on a holographic seal beside its name: 1 daylight, 2 tungsten.
    in property <int> balance;
    in property <bool> enabled: true;
    in property <bool> drops;
    callback select();
    // The menu's close, by a choice, Escape or a press outside: the photo shows its own stock again.
    property <bool> open: menu.is-open;
    changed open => { if (!self.open) { Stocks.lit(-1); } }
    function drop() {
        Stocks.dropping();
        menu.show();
    }
    spacing: SectionStyle.gap;
    face := Rectangle {
        height: column.preferred-height;
        column := VerticalLayout {
            spacing: SectionStyle.gap;
            HorizontalLayout {
                alignment: center;
                StockIcon { artwork: root.stock.artwork; has-artwork: root.stock.has-artwork; side: StockStyle.hero; }
            }
            if root.stock.name != "" && root.balance == 0: Label { text: root.stock.name; centred: true; wrap: word-wrap; }
            if root.stock.name != "" && root.balance > 0: HorizontalLayout {
                alignment: center;
                spacing: Space.s;
                Label { text: root.stock.name; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Badge {
                        tone: BadgeTone.seal;
                        metal: root.balance == 1 ? Metal.holo-blue : Metal.holo-green;
                        text: root.balance == 1 ? @tr("Daylight") : @tr("Tungsten");
                    }
                }
            }
            if root.stock.note != "": Label { text: root.stock.note; role: TextRole.note; centred: true; }
        }
        TouchArea {
            enabled: root.drops && root.enabled;
            mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => { root.drop(); }
        }
    }
    @children
    key := Button {
        text: @tr("Select Film Stock");
        enabled: root.enabled;
        clicked => {
            if (root.drops) {
                root.drop();
            } else {
                root.select();
            }
        }
    }
    menu := StockMenu {
        x: key.x;
        y: key.y + key.height + Space.xxs;
        span: key.width;
        // The window's height under the key, a few lines at least, so the menu never covers its key.
        room: max(Bounds.height - key.absolute-position.y - key.height - Space.xxs - Space.m, 6 * StockStyle.line);
        lines: Stocks.lines;
        current: Stocks.in-use;
        lit(i) => { Stocks.lit(i); }
        chosen(i) => { Stocks.picked(i); }
    }
}
