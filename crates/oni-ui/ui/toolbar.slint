// The top bar, one layout in every mode: the mode key and the history at the left, the mode's own keys
// centred, feedback, settings and the screen's commit at the right; every key there is a menu's gesture.
import { Act } from "act.slint";
import { Icons, Button, ButtonGroup, ButtonKind, Surface, ShellStyle, ScannerStyle, Tabs, RollStyle } from "ds/ds.slint";
import { Preparing } from "prepare_state.slint";
import { PanelState } from "panel/state.slint";
import { Canvas } from "canvas_state.slint";
import { KeyWords } from "key_words.slint";
import { Pairing } from "pairing.slint";
import { RatingFilter } from "rating_filter.slint";
import { Menus } from "menus.slint";
import { Library } from "library.slint";

// `rollStepKeys`, the faces' bar for the steps, numbered in their order: the current one held, a check on
// each done, a step the roll does not walk out of reach, and all of them while it measures.
export component RollStepKeys inherits Tabs {
    tabs: [@tr("Film Type"), @tr("Flat-Field"), @tr("Base"), @tr("Flags"), @tr("Window")];
    ordered: true;
    preferred-width: self.tabs.length * RollStyle.step-tab;
    selected: Preparing.step;
    marked: Preparing.done;
    disabled: Preparing.measuring ? [true, true, true, true, true] : Preparing.skipped;
    picked(i) => { Preparing.step-picked(i); }
}

export global Bar {
    in property <bool> editing;
    in property <bool> has-photo;
    // A photo shown alone: the crop and De-dust, each frame's own, wait while frames show together,
    // and their keys say so under the hand.
    in property <bool> single;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-paste;
    in property <bool> can-reset;
    in property <int> targets: 1;
    // The menu's own rule and title for the keys, so the two surfaces cannot disagree.
    in property <bool> can-select-all;
    in property <bool> can-prepare;
    in property <bool> can-toggle-mode;
    // The gallery on the archive's folders, where scans come in: neither the projects nor the ONI Trash.
    in property <bool> archive;
    // The roll the gallery stands on waits for its measurement: Prepare Roll is the screen's one primary.
    out property <bool> prepare-first: !Bar.editing && Library.roll-unmeasured;
    // `ExportButton`'s third face: an update outranks export and import alike, and says to what.
    in property <string> update-title;
    in property <string> update-help;
    in property <bool> updating;
    in property <string> undo-title: @tr("Undo");
    in property <string> redo-title: @tr("Redo");
    // The face the open photo is edited on: 0 Pro, 1 Scanner.
    in-out property <int> face;
    // Room the window's traffic lights take on macOS, read from the window, zero elsewhere.
    in property <length> traffic-lights;
    // The bar's height, which the traffic lights are centred in.
    out property <length> height: ShellStyle.bar-height;
    callback act(Act);
    // A press on the bar's empty room: on macOS it stands for the title bar.
    callback room-pressed();
}

// `AppBar.item`: a glyph key that names its gesture.
component Item inherits Button { has-icon: true; square: true;
    in property <Act> action;
    clicked => { Bar.act(root.action); }
}

// `AppBar.word`: a word key.
component Word inherits Button {
    in property <Act> action;
    clicked => { Bar.act(root.action); }
}

// A key of the centre, named by its word; short of room the word gives way to its glyph, a square key.
component Tool inherits Word {
    in property <bool> compact;
    in property <string> word;
    text: root.compact ? "" : root.word;
    has-icon: root.compact;
}

// ⌘A from the bar: the whole roll selected where the hand is, shown together beside a photo; pressed
// on a roll picked whole, the photo it came from alone again.
component SelectAll inherits Tool {
    action: Act.select-all;
    word: @tr("Whole Roll");
    icon: Icons.contact-sheet;
    help: @tr("Select the Whole Roll ({})", KeyWords.command + "A");
    enabled: Bar.can-select-all;
}

// A glyph on its own plate, apart from the words that keep the work and lighter than them.
component ResetScan inherits Item {
    action: Act.reset;
    icon: Icons.reset;
    help: @tr("Reset Settings ({})", KeyWords.command-shift + "R");
    enabled: Bar.can-reset;
}

// Undo and Redo beside the mode key, in every mode: the history is the app's, never one screen's.
component History inherits ButtonGroup {
    plate: true;
    Item { action: Act.undo; icon: Icons.undo; help: Bar.undo-title + " (" + KeyWords.command + "Z)"; enabled: Bar.can-undo; }
    Item { action: Act.redo; icon: Icons.redo; help: Bar.redo-title + " (" + KeyWords.command-shift + "Z)"; enabled: Bar.can-redo; }
}

component EditorKeys inherits HorizontalLayout {
    in property <bool> compact;
    spacing: root.compact ? ShellStyle.compact-gap : ShellStyle.bar-gap;
    cross-axis-alignment: center;
    // `centreKeys`: each family on its own plate, De-dust alone and never plated; a mode's key latches, lit while it is on.
    ButtonGroup { plate: true;
        Tool {
            compact: root.compact;
            action: Act.framing;
            word: @tr("Crop");
            icon: Icons.framing;
            on: PanelState.tab == 1;
            help: !Bar.single ? @tr("Select one photo to crop it") : self.on ? @tr("Leave Crop") : @tr("Crop and Straighten ({})", KeyWords.command + "K");
            latch: true;
            enabled: Bar.has-photo && Bar.single;
        }
        Tool { compact: root.compact; action: Act.compare; word: @tr("Compare"); icon: Icons.compare; help: Menus.titles.compare; on: Canvas.split >= 0; latch: true; enabled: Bar.has-photo; }
        SelectAll { compact: root.compact; }
    }
    // `faceBinding`: the faces, present only while a photograph is worked, are the first to give room.
    Tabs {
        preferred-width: ScannerStyle.face-bar;
        max-width: ScannerStyle.face-bar;
        tabs: [@tr("Pro"), @tr("Scanner")];
        helps: [@tr("Pro: every setting by hand, the place to start"), @tr("Scanner: a lab scanner's keypad, density and colour in steps on its machine's look")];
        marked: [false, false];
        selected: Bar.face;
        picked(i) => { Bar.face = i; Bar.act(i == 1 ? Act.face-scanner : Act.face-pro); }
    }
    ButtonGroup { plate: true;
        Tool { compact: root.compact; action: Act.copy; word: @tr("Copy"); icon: Icons.copy; help: @tr("Copy Settings ({})", KeyWords.command-shift + "C"); enabled: Bar.has-photo; }
        Tool {
            compact: root.compact;
            action: Act.paste;
            word: @tr("Paste");
            icon: Icons.paste;
            help: Bar.targets > 1 ? @tr("Paste settings to {} photos ({})", Bar.targets, KeyWords.command-shift + "V") : @tr("Paste settings ({})", KeyWords.command-shift + "V");
            enabled: Bar.can-paste;
        }
        // The menu's title, which counts the photos the paste rewrites.
        Tool { compact: root.compact; action: Act.paste-to-roll; word: @tr("Paste to Roll"); icon: Icons.film-roll; help: Menus.titles.paste-to-roll; enabled: Bar.can-paste; }
    }
    Tool {
        compact: root.compact;
        action: Act.correction;
        word: @tr("De-dust");
        icon: Icons.correction;
        on: PanelState.tab == 4;
        latch: true;
        help: !Bar.single ? @tr("Select one photo to de-dust it") : self.on ? @tr("Leave De-dust") : @tr("De-dust");
        enabled: Bar.has-photo && Bar.single;
    }
    ButtonGroup { plate: true;
        ResetScan { }
    }
}

component GalleryKeys inherits HorizontalLayout {
    in property <bool> compact;
    spacing: root.compact ? ShellStyle.compact-gap : ShellStyle.bar-gap;
    cross-axis-alignment: center;
    // The editor's first plate holds the select-all key alone here, as in Swift's `centreKeys`.
    ButtonGroup { plate: true;
        SelectAll { compact: root.compact; }
    }
    RatingFilter { }
    Word {
        action: Act.prepare-roll;
        text: @tr("PREPARE ROLL");
        keycap: true;
        kind: Bar.prepare-first ? ButtonKind.accent : ButtonKind.plain;
        help: @tr("Prepare the Roll");
        enabled: Bar.can-prepare;
    }
    ButtonGroup { plate: true;
        ResetScan { }
    }
    // The trash stands on a plate of its own, never beside a key that keeps the photo.
    ButtonGroup { plate: true;
        Item { action: Act.remove; icon: Icons.remove; help: Bar.targets > 1 ? @tr("Move {} Photos to ONI Trash", Bar.targets) : @tr("Move to ONI Trash"); kind: ButtonKind.destructive; enabled: Bar.targets > 0; }
    }
}

export component Toolbar inherits Surface {
    height: ShellStyle.bar-height;
    // The bar with every word, read off hidden copies, never off the face shown, or the window's width
    // would loop through it; narrower, the centre's words give way to glyphs.
    property <length> full: 2 * ShellStyle.bar-padding + Bar.traffic-lights + mode.preferred-width + history.preferred-width
        + max(sizing.preferred-width, gallery-sizing.preferred-width, steps-sizing.preferred-width)
        + (Pairing.available ? 3 : 2) * glyph-sizing.preferred-width + ShellStyle.export-width + (Pairing.available ? 6 : 5) * ShellStyle.bar-gap;
    property <bool> compact: root.width < root.full;
    // Under the keys, so only the room between them reaches it.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { Bar.room-pressed(); }
        }
    }
    HorizontalLayout {
        padding-left: ShellStyle.bar-padding + Bar.traffic-lights;
        padding-right: ShellStyle.bar-padding;
        padding-top: ShellStyle.bar-padding;
        padding-bottom: ShellStyle.bar-padding;
        spacing: ShellStyle.bar-gap;
        cross-axis-alignment: center;
        // While a roll is prepared the key leaves it, as Cancel does, except while it measures.
        mode := Word {
            keycap: true;
            action: Preparing.shown ? Act.leave-roll : Act.toggle-mode;
            text: Bar.editing || Preparing.shown ? @tr("GALLERY") : @tr("EDITOR");
            widest: @tr("GALLERY");
            help: Preparing.shown ? @tr("Gallery (Esc or {})", KeyWords.command + "G")
                : Bar.editing ? @tr("Gallery (Esc, Space or {})", KeyWords.command + "G") : @tr("Editor (Space or {})", KeyWords.command + "G");
            enabled: Preparing.shown ? !Preparing.measuring : Bar.can-toggle-mode;
        }
        history := History { }
        // The zone holds the widest set of keys with its words, and the widest compact one at least, alone
        // giving way; the set shown sits on the window's centre if it can, its faces narrowing first.
        Rectangle {
            horizontal-stretch: 1;
            min-width: max(compact-sizing.min-width, compact-gallery-sizing.min-width, steps-sizing.min-width);
            preferred-width: max(sizing.preferred-width, gallery-sizing.preferred-width, steps-sizing.preferred-width);
            sizing := EditorKeys { visible: false; }
            gallery-sizing := GalleryKeys { visible: false; }
            compact-sizing := EditorKeys { visible: false; compact: true; }
            compact-gallery-sizing := GalleryKeys { visible: false; compact: true; }
            steps-sizing := RollStepKeys { visible: false; }
            glyph-sizing := Item { visible: false; icon: Icons.settings; }
            if Preparing.shown: RollStepKeys {
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
            if Bar.editing && !Preparing.shown: EditorKeys {
                compact: root.compact;
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
            if !Bar.editing && !Preparing.shown: GalleryKeys {
                compact: root.compact;
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
        }
        // A glyph as Settings beside it, its width the same at every width of the window.
        Item { action: Act.report; icon: Icons.feedback; help: @tr("Report a Bug / Give Feedback"); }
        if Pairing.available: Item { action: Act.pair-phone; icon: Icons.phone; help: @tr("Phone Remote"); }
        Item { action: Act.settings; icon: Icons.settings; help: @tr("Settings"); }
        // `ExportButton`: one slot, three faces (import in the gallery, export in the editor, an update over both),
        // the primary except beside a roll awaiting Prepare Roll or off the archive; hidden while a roll is prepared.
        Word {
            property <bool> update: Bar.update-title != "";
            visible: !Preparing.shown;
            action: self.update ? Act.update : Bar.editing ? Act.export : Act.add-folder;
            text: self.update ? (Bar.updating ? @tr("UPDATING") : Bar.update-title) : Bar.editing ? @tr("EXPORT") : @tr("ADD FOLDER…");
            keycap: true;
            kind: !Bar.prepare-first && (self.update || Bar.editing || Bar.archive) ? ButtonKind.accent : ButtonKind.plain;
            fixed-width: ShellStyle.export-width;
            help: self.update ? Bar.update-help
                : !Bar.editing ? @tr("Star a folder of scans and open it · export stays on {}", KeyWords.command + "E")
                : Bar.targets > 1 ? @tr("Export {} photos ({})", Bar.targets, KeyWords.command + "E") : @tr("Export ({})", KeyWords.command + "E");
            enabled: self.update ? !Bar.updating : !Bar.editing || Bar.has-photo || Bar.targets > 0;
        }
    }
}
