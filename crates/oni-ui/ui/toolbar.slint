// The top bar, one layout in every mode: the mode key and the history, the mode's own groups centred and ended
// past a rule by Reset, Trash too in the gallery, then the app's keys and the screen's commit, each a glyph over its word.
import { Act } from "act.slint";
import { Icons, Button, ButtonGroup, ButtonKind, ButtonStyle, Divider, Surface, ShellStyle, ScannerStyle, Tabs, RollStyle, Keyboard, ToolStyle, ToolMarker } from "ds/ds.slint";
import { Preparing } from "prepare_state.slint";
import { PanelState } from "panel/state.slint";
import { Canvas } from "canvas_state.slint";
import { KeyWords } from "key_words.slint";
import { Pairing } from "pairing.slint";
import { Menus } from "menus.slint";
import { Library } from "library.slint";

// `rollStepKeys`, the faces' bar for the steps, numbered in their order: the current one held, a check on
// each done, a step the roll does not walk out of reach, and all of them while it measures.
export component RollStepKeys inherits Tabs {
    tabs: [@tr("Film Type"), @tr("Flat-Field"), @tr("Base"), @tr("Flags"), @tr("Window")];
    ordered: true;
    preferred-width: self.tabs.length * RollStyle.step-tab;
    selected: Preparing.step;
    marked: Preparing.done;
    disabled: Preparing.measuring || Keyboard.covered ? [true, true, true, true, true] : Preparing.skipped;
    picked(i) => { Preparing.step-picked(i); }
}

export global Bar {
    in property <bool> editing;
    in property <bool> has-photo;
    // A photo shown alone: the crop and De-dust, each frame's own, wait while frames show together,
    // and their keys say so under the hand.
    in property <bool> single;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-paste;
    in property <bool> can-reset;
    in property <int> targets: 1;
    // The menu's own rule and title for the keys, so the two surfaces cannot disagree.
    in property <bool> can-select-all;
    // Every photo ⌘A picks is picked: the select-all key lit.
    in property <bool> whole;
    in property <bool> can-prepare;
    in property <bool> can-toggle-mode;
    // The gallery on the archive's folders, where scans come in: neither the projects nor the ONI Trash.
    in property <bool> archive;
    // The roll the gallery stands on waits for its measurement: Prepare Roll is the screen's one primary.
    out property <bool> prepare-first: !Bar.editing && Library.roll-unmeasured;
    // EXPORT can act: in the editor on the photo or the frames picked, in the gallery as the menu's Export.
    out property <bool> exportable: Bar.editing ? Bar.has-photo || Bar.targets > 0 : Menus.live.export;
    // The archive with no roll to prepare, nothing to export and no update: ADD FOLDER… is the primary.
    out property <bool> add-first: !Bar.editing && Bar.archive && !Bar.prepare-first && !Bar.exportable && Bar.update-title == "";
    // `ExportButton`'s second face: an update outranks the export, and says to what.
    in property <string> update-title;
    in property <string> update-help;
    in property <bool> updating;
    in property <string> undo-title: @tr("Undo");
    in property <string> redo-title: @tr("Redo");
    // The face the open photo is edited on: 0 Pro, 1 Scanner.
    in-out property <int> face;
    // Room the window's traffic lights take on macOS, read from the window, zero elsewhere.
    in property <length> traffic-lights;
    // The bar's height, which the traffic lights are centred in.
    out property <length> height: ShellStyle.bar-height;
    // The window's width under which the flat keys' words give way to their glyphs.
    in-out property <length> needed;
    callback act(Act);
    // A press on the bar's empty room: on macOS it stands for the title bar.
    callback room-pressed();
}

// `AppBar.item`: a flat key of the bar, its glyph over its word, the glyph alone on a square short of room;
// its ground shows under the hand alone, its group's keys touching. A canvas tool's key, while its tool
// holds, shows a tab of the tool's colour under it on the bar's bottom edge, the key itself left bare.
component Key inherits Button {
    in property <Act> action;
    in property <bool> compact;
    in property <string> word;
    in property <color> tool: ToolStyle.none;
    stacked: true;
    in-bar: true;
    has-icon: true;
    on-apart: root.tool.alpha > 0;
    text: root.compact ? "" : root.word;
    clicked => { Bar.act(root.action); }
    // On the bar's bottom edge, the key centred in the bar's height whatever its own.
    if root.tool.alpha > 0: ToolMarker {
        x: 0;
        y: (ShellStyle.bar-height + root.height) / 2 - self.height;
        width: root.width;
        ink: root.tool;
        shown: root.on;
    }
}

// A keycap of the bar, the mode's key or a commit: its glyph over its legend at every width.
component Cap inherits Button {
    in property <Act> action;
    stacked: true;
    in-bar: true;
    has-icon: true;
    keycap: true;
    clicked => { Bar.act(root.action); }
}

// ⌘A from the bar, the Sheet as film shows a roll whole, the first key of the centre in both modes, its
// tool's tab under it while it holds: every photo the gallery shows picked, or beside a photo the whole
// roll together; pressed again, one.
component SelectAll inherits Key {
    action: Act.select-all;
    word: @tr("Sheet");
    icon: Icons.contact-sheet;
    on: Bar.whole;
    tool: ToolStyle.sheet;
    help: self.on ? @tr("Back to One Photo")
        : Bar.editing ? @tr("Show the Whole Roll Together ({})", KeyWords.command + "A") : @tr("Select All ({})", KeyWords.command + "A");
    enabled: Bar.can-select-all;
}

// Undo and Redo beside the mode key, in every mode: the history is the app's, never one screen's.
component History inherits ButtonGroup {
    in property <bool> compact;
    joined: true;
    Key { compact: root.compact; action: Act.undo; word: @tr("Undo"); icon: Icons.undo; help: Bar.undo-title + " (" + KeyWords.command + "Z)"; enabled: Bar.can-undo; }
    Key { compact: root.compact; action: Act.redo; word: @tr("Redo"); icon: Icons.redo; help: Bar.redo-title + " (" + KeyWords.command-shift + "Z)"; enabled: Bar.can-redo; }
}

// The app's own keys, one group, the same in every mode.
component Own inherits ButtonGroup {
    in property <bool> compact;
    joined: true;
    Key { compact: root.compact; action: Act.report; word: @tr("Feedback"); icon: Icons.feedback; help: @tr("Report a Bug / Give Feedback"); }
    if Pairing.available: Key { compact: root.compact; action: Act.pair-phone; word: @tr("Phone"); icon: Icons.phone; help: @tr("Phone Remote"); }
    Key { compact: root.compact; action: Act.settings; word: @tr("Settings"); icon: Icons.settings; help: @tr("Settings"); }
}

// A mode's groups a bar's gap apart, then past a rule the keys that reset and remove, one group, Trash last:
// Reset names the photos it reaches, Trash wears its can, so neither reads as the other.
component Centre inherits HorizontalLayout {
    in property <bool> compact;
    // The key of the ONI Trash; beside a photo its menus and its chord alone reach it.
    in property <bool> trash: true;
    spacing: ShellStyle.bar-gap;
    cross-axis-alignment: center;
    @children
    Divider { vertical: true; height: ButtonStyle.height; }
    ButtonGroup {
        joined: true;
        // It resets the face the photos are edited on, Pro's settings or the Scanner's, the other's kept;
        // its help says which.
        Key {
            compact: root.compact;
            action: Act.reset;
            word: @tr("Reset");
            icon: Icons.reset;
            help: Bar.face == 1 ? @tr("Reset the Scanner settings ({})", KeyWords.command-shift + "R") : @tr("Reset the Pro settings ({})", KeyWords.command-shift + "R");
            enabled: Bar.can-reset;
        }
        if root.trash: Key {
            compact: root.compact;
            action: Act.remove;
            word: @tr("Trash");
            icon: Icons.remove;
            kind: ButtonKind.destructive;
            help: Bar.targets > 1 ? @tr("Move {} Photos to ONI Trash ({})", Bar.targets, KeyWords.command + KeyWords.delete)
                : @tr("Move to ONI Trash ({})", KeyWords.command + KeyWords.delete);
            enabled: Bar.targets > 0;
        }
    }
}

component EditorKeys inherits Centre {
    trash: false;
    // `centreKeys` by job: the canvas's views and tools, each with its tool's tab under it while it holds,
    // the faces, then the settings carried from photo to photo.
    ButtonGroup {
        joined: true;
        SelectAll { compact: root.compact; }
        Key {
            compact: root.compact;
            action: Act.framing;
            word: @tr("Crop");
            icon: Icons.framing;
            on: PanelState.tab == 1;
            tool: ToolStyle.crop;
            help: !Bar.single ? @tr("Select one photo to crop it") : self.on ? @tr("Leave Crop") : @tr("Crop and Straighten ({})", KeyWords.command + "K");
            enabled: Bar.has-photo && Bar.single;
        }
        Key {
            compact: root.compact;
            action: Act.correction;
            word: @tr("De-dust");
            icon: Icons.correction;
            on: PanelState.tab == 4;
            tool: ToolStyle.dust;
            help: !Bar.single ? @tr("Select one photo to de-dust it") : self.on ? @tr("Leave De-dust") : @tr("De-dust");
            enabled: Bar.has-photo && Bar.single;
        }
        Key { compact: root.compact; action: Act.compare; word: @tr("Compare"); icon: Icons.compare; help: Menus.titles.compare; on: Canvas.split >= 0; tool: ToolStyle.compare; enabled: Bar.has-photo; }
    }
    // `faceBinding`: the faces, present only while a photograph is worked, are the first to give room.
    Tabs {
        preferred-width: ScannerStyle.face-bar;
        max-width: ScannerStyle.face-bar;
        tabs: [@tr("Pro"), @tr("Scanner")];
        helps: [@tr("Pro: every setting by hand, the place to start"), @tr("Scanner: a minilab's density and colour, in steps")];
        marked: [false, false];
        disabled: Keyboard.covered ? [true, true] : [false, false];
        selected: Bar.face;
        picked(i) => { Bar.face = i; Bar.act(i == 1 ? Act.face-scanner : Act.face-pro); }
    }
    ButtonGroup {
        joined: true;
        Key { compact: root.compact; action: Act.copy; word: @tr("Copy"); icon: Icons.copy; help: @tr("Copy Settings ({})", KeyWords.command-shift + "C"); enabled: Bar.has-photo; }
        Key {
            compact: root.compact;
            action: Act.paste;
            word: @tr("Paste");
            icon: Icons.paste;
            help: Bar.targets > 1 ? @tr("Paste settings to {} photos ({})", Bar.targets, KeyWords.command-shift + "V") : @tr("Paste settings ({})", KeyWords.command-shift + "V");
            enabled: Bar.can-paste;
        }
        // Every frame of the roll rewritten at once, as the menu's title counts them, its notice's Undo after.
        Key {
            compact: root.compact;
            action: Act.paste-to-roll;
            word: @tr("Paste All");
            icon: Icons.film-roll;
            help: Menus.titles.paste-to-roll + " (" + KeyWords.option-command + "V)";
            enabled: Bar.can-paste;
        }
    }
}

component GalleryKeys inherits Centre {
    // The photos picked, opening on the key the editor's first opens on; the rating filter is the library's.
    SelectAll { compact: root.compact; }
    Cap {
        action: Act.prepare-roll;
        text: @tr("PREPARE ROLL");
        icon: Icons.prepare;
        kind: Bar.prepare-first ? ButtonKind.accent : ButtonKind.plain;
        help: @tr("Prepare the Roll");
        enabled: Bar.can-prepare;
    }
    Cap {
        action: Act.add-folder;
        text: @tr("ADD FOLDER…");
        icon: Icons.add-folder;
        kind: Bar.add-first ? ButtonKind.accent : ButtonKind.plain;
        help: @tr("Star a folder of scans and open it");
    }
}

export component Toolbar inherits Surface {
    height: ShellStyle.bar-height;
    // The bar with every word, read off hidden copies, never off the keys shown, or the window's width
    // would loop through it; narrower, the flat keys' words give way to glyphs.
    property <length> start: Bar.traffic-lights > 0 ? Bar.traffic-lights : ShellStyle.bar-end;
    property <length> full: root.start + ShellStyle.bar-end + mode.preferred-width + history-sizing.preferred-width
        + max(sizing.preferred-width, gallery-sizing.preferred-width, steps-sizing.preferred-width)
        + own-sizing.preferred-width + ShellStyle.export-width + 4 * ShellStyle.bar-gap;
    // Settled once the bar is laid: the history's and the app's keys stand in the bar's own layout, so
    // a binding would feed their widths back into the width that decides them.
    property <bool> compact;
    init => {
        root.compact = root.width < root.full;
        Bar.needed = root.full;
    }
    changed width => { root.compact = root.width < root.full; }
    changed full => {
        root.compact = root.width < root.full;
        Bar.needed = root.full;
    }
    // A tool open on the canvas, the crop or De-dust: its DONE is the view's one primary.
    property <bool> tool: Bar.editing && (PanelState.tab == 1 || PanelState.tab == 4);
    // Out of the gallery, the mode key goes back to it.
    property <bool> back: Bar.editing || Preparing.shown;
    // Under the keys, so only the room between them reaches it.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { Bar.room-pressed(); }
        }
    }
    HorizontalLayout {
        padding-left: root.start;
        padding-right: ShellStyle.bar-end;
        padding-top: ShellStyle.bar-padding;
        padding-bottom: ShellStyle.bar-padding;
        spacing: ShellStyle.bar-gap;
        cross-axis-alignment: center;
        // The mode key names its action, EDIT or BACK, as wide as the wider so the bar holds still; while a
        // roll is prepared it leaves it, as Cancel does, except while it measures.
        mode := Cap {
            action: Preparing.shown ? Act.leave-roll : Act.toggle-mode;
            text: root.back ? @tr("BACK") : @tr("EDIT");
            icon: root.back ? Icons.back : Icons.edit;
            fixed-width: max(edit-sizing.preferred-width, back-sizing.preferred-width);
            help: Preparing.shown ? @tr("Gallery (Esc or {})", KeyWords.command + "G")
                : Bar.editing ? @tr("Gallery (Esc, Space or {})", KeyWords.command + "G") : @tr("Editor (Space or {})", KeyWords.command + "G");
            enabled: Preparing.shown ? !Preparing.measuring : Bar.can-toggle-mode;
        }
        history := History { compact: root.compact; }
        // The zone holds the widest set of keys with its words, and the widest compact one at least, alone
        // giving way; the set shown sits on the window's centre if it can, its faces narrowing first.
        Rectangle {
            horizontal-stretch: 1;
            min-width: max(compact-sizing.min-width, compact-gallery-sizing.min-width, steps-sizing.min-width);
            preferred-width: max(sizing.preferred-width, gallery-sizing.preferred-width, steps-sizing.preferred-width);
            sizing := EditorKeys { visible: false; }
            gallery-sizing := GalleryKeys { visible: false; }
            compact-sizing := EditorKeys { visible: false; compact: true; }
            compact-gallery-sizing := GalleryKeys { visible: false; compact: true; }
            steps-sizing := RollStepKeys { visible: false; }
            history-sizing := History { visible: false; }
            own-sizing := Own { visible: false; }
            edit-sizing := Cap { visible: false; text: @tr("EDIT"); icon: Icons.edit; }
            back-sizing := Cap { visible: false; text: @tr("BACK"); icon: Icons.back; }
            if Preparing.shown: RollStepKeys {
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
            if Bar.editing && !Preparing.shown: EditorKeys {
                compact: root.compact;
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
            if !Bar.editing && !Preparing.shown: GalleryKeys {
                compact: root.compact;
                width: min(self.preferred-width, parent.width);
                x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width));
            }
        }
        own := Own { compact: root.compact; }
        // `ExportButton`: one slot in both screens, EXPORT or an update over it, the primary except beside a
        // roll awaiting Prepare Roll or under a tool; hidden while a roll is prepared.
        Cap {
            property <bool> update: Bar.update-title != "";
            visible: !Preparing.shown;
            action: self.update ? Act.update : Act.export;
            text: self.update ? (Bar.updating ? @tr("UPDATING") : Bar.update-title) : @tr("EXPORT");
            icon: self.update ? Icons.update : Icons.export;
            kind: !Bar.prepare-first && !root.tool ? ButtonKind.accent : ButtonKind.plain;
            fixed-width: ShellStyle.export-width;
            help: self.update ? Bar.update-help
                : Bar.targets > 1 ? @tr("Export {} photos ({})", Bar.targets, KeyWords.command + "E") : @tr("Export ({})", KeyWords.command + "E");
            enabled: self.update ? !Bar.updating : Bar.exportable;
        }
    }
}
