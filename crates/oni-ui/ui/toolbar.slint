// The top bar in three zones; every key there is a gesture a menu already reaches.
import { Act } from "act.slint";
import { Icons, Button, IconButton, ButtonGroup, ButtonKind, Surface, ShellStyle, ScannerStyle, Tabs } from "ds/ds.slint";
import { Preparing } from "prepare.slint";

// `rollStepKeys`: one key per step, the current one lit, a lamp on each step behind it.
export component RollStepKeys inherits ButtonGroup {
    for name[i] in ["FILM", "FLAT-FIELD", "BASE", "FLAGS", "WINDOW"]: Button {
        text: name;
        help: ["Select the Film Type", "Set Up the Flat-Field", "Pick the Film Base", "Flag the Frames Left Out", "Place the Measuring Frame"][i];
        on: Preparing.step == i;
        enabled: !Preparing.measuring && !Preparing.skipped[i];
        lamp-shown: true;
        lamp-lit: i < Preparing.step && !Preparing.skipped[i];
        clicked => { Preparing.step-picked(i); }
    }
}

export global Bar {
    in property <bool> editing;
    in property <bool> has-photo;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-paste;
    in property <bool> can-reset;
    in property <bool> dedust;
    in property <int> targets: 1;
    // The menu's own rule and title for the keys, so the two surfaces cannot disagree.
    in property <bool> can-sheet;
    in property <string> sheet-title: "New Contact Sheet";
    in property <bool> can-prepare;
    in property <string> export-title: "EXPORT";
    // `ExportButton`'s third face: an update outranks export and import alike, and says to what.
    in property <string> update-title;
    in property <string> update-help;
    in property <bool> updating;
    in property <string> filter: "ALL";
    in property <string> undo-title: "Undo";
    in property <string> redo-title: "Redo";
    // The face the open photo is edited on: 0 Pro, 1 Scanner.
    in-out property <int> face;
    // Room the window's traffic lights take on macOS, read from the window, zero elsewhere.
    in property <length> traffic-lights;
    // The bar's height, which the traffic lights are centred in.
    out property <length> height: ShellStyle.bar-height;
    callback act(Act);
    // A press on the bar's empty room: on macOS it stands for the title bar.
    callback room-pressed();
}

// `AppBar.item`: a glyph key that names its gesture.
component Item inherits IconButton {
    in property <Act> action;
    clicked => { Bar.act(root.action); }
}

// `AppBar.word`: a word key.
component Word inherits Button {
    in property <Act> action;
    clicked => { Bar.act(root.action); }
}

// Short of room the word gives way to its glyph, a square key.
component ResetScan inherits Word {
    in property <bool> compact;
    action: Act.reset;
    text: root.compact ? "" : "RESET SCAN";
    has-icon: root.compact;
    icon: Icons.reset;
    help: "Reset to Imported State";
    kind: ButtonKind.caution;
    enabled: Bar.can-reset;
}

component EditorKeys inherits HorizontalLayout {
    in property <bool> compact;
    spacing: root.compact ? ShellStyle.compact-gap : ShellStyle.bar-gap;
    ButtonGroup {
        Item { action: Act.framing; icon: Icons.framing; help: "Crop and Straighten (⌘K)"; enabled: Bar.has-photo; }
        Item { action: Act.compare; icon: Icons.compare; help: "Compare"; enabled: Bar.has-photo; }
        Item { action: Act.contact-sheet; icon: Icons.contact-sheet; help: Bar.sheet-title; enabled: Bar.can-sheet; }
    }
    ButtonGroup {
        Item { action: Act.undo; icon: Icons.undo; help: Bar.undo-title + " (⌘Z)"; enabled: Bar.can-undo; }
        Item { action: Act.redo; icon: Icons.redo; help: Bar.redo-title + " (⌘⇧Z)"; enabled: Bar.can-redo; }
    }
    // `faceBinding`: the faces ride beside the history, present only while a photograph is worked.
    Tabs {
        width: ScannerStyle.face-bar;
        tabs: ["Pro", "Scanner"];
        marked: [false, false];
        selected <=> Bar.face;
        picked(i) => { Bar.act(i == 1 ? Act.face-scanner : Act.face-pro); }
    }
    ButtonGroup {
        Item { action: Act.copy; icon: Icons.copy; help: "Copy settings (⌘⇧C)"; enabled: Bar.has-photo; }
        Item {
            action: Act.paste;
            icon: Icons.paste;
            help: Bar.targets > 1 ? "Paste settings to " + Bar.targets + " photos (⌘⇧V)" : "Paste settings (⌘⇧V)";
            enabled: Bar.can-paste;
        }
        Word {
            action: Act.paste-to-roll;
            text: root.compact ? "" : "PASTE TO ROLL";
            has-icon: root.compact;
            icon: Icons.film-roll;
            help: "Paste to the Roll";
            enabled: Bar.can-paste;
        }
    }
    Item {
        action: Act.correction;
        icon: Bar.dedust ? Icons.done : Icons.correction;
        help: Bar.dedust ? "Leave De-dust" : "De-dust";
        on: Bar.dedust;
        enabled: Bar.has-photo;
    }
    ResetScan { compact: root.compact; }
}

component GalleryKeys inherits HorizontalLayout {
    in property <bool> compact;
    spacing: root.compact ? ShellStyle.compact-gap : ShellStyle.bar-gap;
    Item { action: Act.contact-sheet; icon: Icons.contact-sheet; help: Bar.sheet-title; enabled: Bar.can-sheet; }
    ButtonGroup {
        Item { action: Act.undo; icon: Icons.undo; help: Bar.undo-title + " (⌘Z)"; enabled: Bar.can-undo; }
        Item { action: Act.redo; icon: Icons.redo; help: Bar.redo-title + " (⌘⇧Z)"; enabled: Bar.can-redo; }
    }
    Word {
        action: Act.cycle-filter;
        text: Bar.filter;
        fixed-width: ShellStyle.filter-width;
        help: Bar.filter == "ALL" ? "Filter: All" : "Filter: " + Bar.filter;
    }
    Word { action: Act.prepare-roll; text: "PREPARE ROLL"; help: "Prepare the Roll"; enabled: Bar.can-prepare; }
    ButtonGroup {
        ResetScan { compact: root.compact; }
        Item { action: Act.remove; icon: Icons.remove; help: "Move to ONI Trash"; kind: ButtonKind.destructive; enabled: Bar.targets > 0; }
    }
}

export component Toolbar inherits Surface {
    height: ShellStyle.bar-height;
    // The bar's width with every word, read off hidden copies: the layout's widths never depend on
    // which face shows, or the window's width would loop through it.
    property <length> sides: 2 * ShellStyle.bar-padding + Bar.traffic-lights + mode.preferred-width + 2 * glyphs.preferred-width + 4 * ShellStyle.bar-gap
        + (Preparing.shown ? 0px : ShellStyle.export-width + ShellStyle.bar-gap);
    property <length> full: root.sides + max(sizing.preferred-width, gallery-sizing.preferred-width) + feedback-sizing.preferred-width;
    property <bool> compact: root.width < root.full;
    // Under the keys, so only the room between them reaches it.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { Bar.room-pressed(); }
        }
    }
    HorizontalLayout {
        padding-left: ShellStyle.bar-padding + Bar.traffic-lights;
        padding-right: ShellStyle.bar-padding;
        padding-top: ShellStyle.bar-padding;
        padding-bottom: ShellStyle.bar-padding;
        spacing: ShellStyle.bar-gap;
        // While a roll is prepared the key leaves it, as Cancel does, except while it measures.
        mode := Word {
            action: Preparing.shown ? Act.leave-roll : Act.toggle-mode;
            text: Bar.editing || Preparing.shown ? "GALLERY" : "EDITOR";
            widest: "GALLERY";
            help: Bar.editing || Preparing.shown ? "Gallery (⌘G)" : "Editor (⌘G)";
            enabled: Preparing.shown ? !Preparing.measuring : Bar.editing || Bar.has-photo;
        }
        // Hidden copies of both sets hold the zone at the wider one's width, short of room at the shown
        // set's compact width; the zone takes the room between the sides and its keys sit on the window's centre if they can.
        Rectangle {
            horizontal-stretch: 1;
            min-width: Bar.editing ? compact-sizing.preferred-width : compact-gallery-sizing.preferred-width;
            preferred-width: max(sizing.preferred-width, gallery-sizing.preferred-width);
            sizing := EditorKeys { visible: false; }
            gallery-sizing := GalleryKeys { visible: false; }
            compact-sizing := EditorKeys { visible: false; compact: true; }
            compact-gallery-sizing := GalleryKeys { visible: false; compact: true; }
            feedback-sizing := Word { visible: false; text: "FEEDBACKS"; }
            glyph-sizing := Word { visible: false; has-icon: true; icon: Icons.chat; }
            glyphs := Item { visible: false; icon: Icons.settings; }
            if Preparing.shown: RollStepKeys { x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width)); width: self.preferred-width; }
            if Bar.editing && !Preparing.shown: EditorKeys { compact: root.compact; x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width)); width: self.preferred-width; }
            if !Bar.editing && !Preparing.shown: GalleryKeys { compact: root.compact; x: max(0px, min((root.width - self.width) / 2 - parent.x, parent.width - self.width)); width: self.preferred-width; }
        }
        // The key keeps its own width; only the room around it gives way.
        Rectangle {
            min-width: glyph-sizing.preferred-width;
            preferred-width: feedback-sizing.preferred-width;
            max-width: feedback-sizing.preferred-width;
            horizontal-stretch: 0;
            Word {
                width: self.preferred-width;
                x: parent.width - self.width;
                action: Act.report;
                text: root.compact ? "" : "FEEDBACKS";
                has-icon: root.compact;
                icon: Icons.chat;
                help: "Report a Bug / Give Feedback";
            }
        }
        Item { action: Act.pair-phone; icon: Icons.phone; help: "Phone Remote"; }
        Item { action: Act.settings; icon: Icons.settings; help: "Settings"; }
        if !Preparing.shown && Bar.update-title == "": Word {
            action: Bar.editing ? Act.export : Act.open;
            text: Bar.editing ? Bar.export-title : "ADD FOLDER (⌘+O)";
            kind: ButtonKind.accent;
            fixed-width: ShellStyle.export-width;
            help: Bar.editing ? "" : "Add a folder of scans (⌘O) · export stays on ⌘E";
            enabled: !Bar.editing || Bar.has-photo || Bar.targets > 0;
        }
        if !Preparing.shown && Bar.update-title != "": Word {
            action: Act.update;
            text: Bar.updating ? "UPDATING" : Bar.update-title;
            kind: ButtonKind.update;
            fixed-width: ShellStyle.export-width;
            help: Bar.update-help;
            enabled: !Bar.updating;
        }
    }
}
