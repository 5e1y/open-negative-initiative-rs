// Where nothing is picked in the archive: the person's Kit, their bodies and lenses kept on The Lens DB.
// Signed out it offers the service; signed in it lists the Kit, searches the catalogue in a sheet over the
// window, and holds every change until Save sends them in one call.
import { Section, Label, TextRole, Tone, TextField, Button, ButtonKind, ButtonSize, Surface, Ground, Space, Icons, TldbMark, GearCardBody, Menu, Sheet, SheetHeader, Scroller, AskSheet, AskRole, KitStyle, Divider } from "ds/ds.slint";
import { GearKind, Kit, KitLink, KitPiece, KitMark } from "gear_state.slint";

// Two answers of the search side by side, `at` the left one's place among them.
export struct KitPair { left: KitPiece, right: KitPiece, has-right: bool, at: int }

export global KitSearch {
    in property <[KitPair]> pairs;
}

// One piece of the catalogue, alike in the Kit and in the search: its name, a Default badge when it is one,
// what tells it from its kin or where it stands, then in the Kit how many photos name it, in the search its
// Add; the rest in its menu, its page on The Lens DB first.
export component PieceCard inherits Surface {
    in property <KitPiece> piece;
    in property <GearKind> kind;
    in property <bool> found;
    callback taken();
    callback removed();
    callback preferred();
    property <bool> leaving: root.piece.mark == KitMark.leaving;
    rounded: true;
    outlined: true;
    VerticalLayout {
        HorizontalLayout {
            padding-top: Space.s;
            padding-bottom: Space.s;
            padding-left: Space.m;
            padding-right: Space.xs;
            spacing: Space.s;
            GearCardBody {
                horizontal-stretch: 1;
                faded: root.leaving;
                cautioned: (root.piece.mark == KitMark.added && !root.found) || root.leaving;
                card: {
                    name: root.piece.name,
                    detail: root.piece.mark == KitMark.added && !root.found ? @tr("New, not saved yet") : root.leaving ? @tr("Leaves your Kit when you save") : root.piece.detail,
                    preferred: root.piece.by-default,
                    photos: root.found ? -1 : root.piece.photos,
                };
            }
            if root.found: VerticalLayout {
                alignment: center;
                if root.piece.mark == KitMark.free: Button { text: @tr("Add"); icon: Icons.zoom-in; has-icon: true; clicked => { root.taken(); } }
                if root.piece.mark == KitMark.added: Button {
                    on: true;
                    text: @tr("Added");
                    icon: Icons.done;
                    has-icon: true;
                    help: @tr("Takes it out before saving");
                    clicked => { root.taken(); }
                }
                if root.piece.mark == KitMark.kept || root.leaving: Label {
                    text: root.leaving ? @tr("Leaving your Kit") : @tr("In your Kit");
                    role: TextRole.caption;
                    tone: Tone.tertiary;
                }
            }
            VerticalLayout {
                alignment: center;
                more := Button {
                    kind: ButtonKind.ghost;
                    size: ButtonSize.mini;
                    square: true;
                    icon: Icons.more;
                    has-icon: true;
                    help: @tr("More for {}", root.piece.name);
                    clicked => { menu.show(); }
                }
            }
        }
    }
    menu := Menu {
        x: more.absolute-position.x - root.absolute-position.x;
        y: more.absolute-position.y - root.absolute-position.y + more.height;
        lines: root.found ? [{ text: @tr("See on The Lens DB"), enabled: true }] : [
            { text: @tr("See on The Lens DB"), enabled: true },
            { text: root.piece.by-default ? @tr("Remove Default") : @tr("Set as Default"), enabled: root.piece.mark == KitMark.kept },
            { text: root.leaving ? @tr("Keep in My Kit") : @tr("Remove from My Kit"), enabled: true, rule: true },
        ];
        chosen(i) => {
            menu.close();
            if (i == 0) { Kit.open(root.piece.url); }
            if (i == 1) { root.preferred(); }
            if (i == 2) { root.removed(); }
        }
    }
}

component Pieces inherits Section {
    in property <[KitPiece]> items;
    in property <GearKind> kind;
    in property <string> empty;
    if root.items.length == 0: Label { text: root.empty; role: TextRole.note; }
    for piece[i] in root.items: PieceCard {
        piece: piece;
        kind: root.kind;
        removed => { Kit.remove(root.kind, i); }
        preferred => { Kit.prefer(root.kind, i); }
    }
}

component Offer inherits Section {
    separated: false;
    TldbMark { size: KitStyle.mark-large; large: true; clicked => { Kit.open-site(); } }
    Label { role: TextRole.title; text: @tr("Your Kit, on The Lens DB"); wrap: word-wrap; }
    Label { role: TextRole.note; wrap: word-wrap; text: @tr("Keep your bodies and lenses on The Lens DB: ONI offers them when an export's EXIF is filled, with their brand, focal lengths and apertures."); }
    Button { kind: ButtonKind.accent; text: @tr("Connect The Lens DB"); clicked => { Kit.connect(false); } }
    Button { text: @tr("Create an Account"); clicked => { Kit.connect(true); } }
    Label { role: TextRole.note; wrap: word-wrap; text: @tr("Your browser opens on The Lens DB: ONI never sees your password."); }
}

component Waiting inherits Section {
    separated: false;
    TldbMark { clicked => { Kit.open-site(); } }
    Label { role: TextRole.title; text: @tr("Finish in Your Browser"); }
    Label { role: TextRole.note; wrap: word-wrap; text: @tr("Sign in to The Lens DB, then authorize ONI. A new account confirms its e-mail first: ONI waits 15 minutes."); }
    HorizontalLayout { alignment: start; Button { text: @tr("Cancel"); clicked => { Kit.cancel(); } } }
}

// Under the column while changes wait: how many, and Save beside Discard, so none is forgotten.
component KitSaveBar inherits Surface {
    VerticalLayout {
        Divider { }
        HorizontalLayout {
            padding: Space.m;
            spacing: Space.s;
            Label {
                text: @tr("{n} change not saved" | "{n} changes not saved" % Kit.unsaved);
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button { text: @tr("Discard"); enabled: !Kit.sending; clicked => { Kit.discard(); } }
            Button { kind: ButtonKind.accent; text: Kit.sending ? @tr("Saving…") : @tr("Save"); widest: @tr("Saving…"); enabled: !Kit.sending; clicked => { Kit.save(); } }
        }
    }
}

// The whole column: signed in, its head stays while the Kit scrolls under it, each kind's title held at the
// top while its pieces pass, and the bar of the changes below.
export component KitView inherits VerticalLayout {
    if Kit.link == KitLink.out: Offer { }
    if Kit.link == KitLink.waiting: Waiting { }
    if Kit.link != KitLink.in: Rectangle { vertical-stretch: 1; }
    if Kit.link == KitLink.in: column := VerticalLayout {
        vertical-stretch: 1;
        // Which title is held over the list: none, the bodies' or the lenses'.
        property <int> held: -list.content-y > lenses.y ? 2 : -list.content-y > 0 ? 1 : 0;
        Section {
            separated: false;
            HorizontalLayout {
                spacing: Space.s;
                Label { role: TextRole.title; text: @tr("My Kit"); horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0; TldbMark { horizontal-stretch: 0; clicked => { Kit.open-site(); } } }
            }
            Button { keycap: true; text: @tr("Search Gear"); icon: Icons.search; has-icon: true; clicked => { Kit.pick(true); } }
        }
        if Kit.note != "": Section { separated: false; Label { role: TextRole.note; tone: Tone.caution; wrap: word-wrap; text: Kit.note; } }
        Rectangle {
            vertical-stretch: 1;
            list := Scroller {
                width: parent.width;
                height: parent.height;
                content-height: lists.preferred-height;
                lists := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    bodies := Pieces { title: @tr("Bodies"); items: Kit.bodies; kind: GearKind.body; empty: @tr("No body yet"); }
                    lenses := Pieces { title: @tr("Lenses"); items: Kit.lenses; kind: GearKind.lens; empty: @tr("No lens yet"); }
                }
            }
            if column.held == 1: Surface {
                y: 0;
                height: self.preferred-height;
                Section { title: @tr("Bodies"); folded <=> bodies.folded; }
            }
            if column.held == 2: Surface {
                y: 0;
                height: self.preferred-height;
                Section { title: @tr("Lenses"); folded <=> lenses.folded; }
            }
        }
        if Kit.unsaved > 0: KitSaveBar { }
    }
}

// The search's quick filters, each a row of keys lit while it holds: the kind, a brand, a focal length.
component KitFilters inherits VerticalLayout {
    padding-top: Space.s;
    spacing: Space.xs;
    HorizontalLayout {
        spacing: Space.xs;
        alignment: start;
        for word[i] in [@tr("All"), @tr("Bodies"), @tr("Lenses")]: Button {
            size: ButtonSize.mini;
            text: word;
            on: Kit.kind-filter == i;
            clicked => { Kit.filter-kind(i); }
        }
    }
    HorizontalLayout {
        spacing: Space.xs;
        alignment: start;
        for brand in Kit.brands: Button {
            size: ButtonSize.mini;
            text: brand;
            on: Kit.brand-filter == brand;
            clicked => { Kit.filter-brand(Kit.brand-filter == brand ? "" : brand); }
        }
    }
    HorizontalLayout {
        spacing: Space.xs;
        alignment: start;
        for focal[i] in Kit.focals: Button {
            size: ButtonSize.mini;
            text: Kit.focal-labels[i];
            on: Kit.focal-filter == focal;
            clicked => { Kit.filter-focal(Kit.focal-filter == focal ? 0 : focal); }
        }
    }
}

// The catalogue searched as the hand rests, its answers as cards two to a row, over the window.
export component KitSearchSheet inherits Sheet {
    title: @tr("Add to Your Kit");
    header: SheetHeader.bar;
    card-width: KitStyle.sheet-width;
    card-height: KitStyle.sheet-height;
    dismissed => { Kit.pick(false); }
    VerticalLayout {
        padding-left: Space.m;
        padding-right: Space.m;
        padding-top: Space.m;
        TextField {
            name: @tr("Search The Lens DB");
            placeholder: @tr("A brand, a body, a lens: Nikon FM2, Summicron 35…");
            edited(t) => { Kit.search(t); }
            accepted(t) => { Kit.search(t); }
            init => { self.take-focus(); }
        }
        KitFilters { }
    }
    Scroller {
        vertical-stretch: 1;
        content-height: answers.preferred-height;
        answers := VerticalLayout {
            padding: Space.m;
            spacing: Space.s;
            alignment: start;
            if Kit.searched == "" && !Kit.searching: Label {
                role: TextRole.note;
                wrap: word-wrap;
                text: @tr("Type two letters or more, or pick a brand or a focal length: each word is looked for in the brand and the name.");
            }
            if Kit.searching && Kit.found.length == 0: Label { role: TextRole.note; text: @tr("Searching…"); }
            if !Kit.searching && Kit.searched != "" && Kit.found.length == 0: VerticalLayout {
                spacing: Space.s;
                Label { role: TextRole.note; wrap: word-wrap; text: @tr("Nothing on The Lens DB matches “{}”.", Kit.searched); }
                HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Suggest Missing Gear"); help: @tr("Proposes a piece to The Lens DB, reviewed before it shows"); clicked => { Kit.suggest(); } }
                }
            }
            for pair in KitSearch.pairs: HorizontalLayout {
                spacing: Space.s;
                PieceCard {
                    width: (KitStyle.sheet-width - 2 * Space.m - Space.s) / KitStyle.columns;
                    found: true;
                    piece: pair.left;
                    taken => { Kit.take(pair.at); }
                }
                if pair.has-right: PieceCard {
                    width: (KitStyle.sheet-width - 2 * Space.m - Space.s) / KitStyle.columns;
                    found: true;
                    piece: pair.right;
                    taken => { Kit.take(pair.at + 1); }
                }
                if !pair.has-right: Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    VerticalLayout {
        Divider { }
        HorizontalLayout {
            padding: Space.m;
            spacing: Space.s;
            Label {
                role: TextRole.note;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
                text: Kit.unsaved == 0 ? @tr("What you add joins your Kit; Save sends it to The Lens DB.")
                    : @tr("{n} change waits for Save, in the Kit's column." | "{n} changes wait for Save, in the Kit's column." % Kit.unsaved);
            }
            Button {
                size: ButtonSize.mini;
                text: @tr("Suggest Missing Gear");
                help: @tr("Proposes a piece to The Lens DB, reviewed before it shows");
                clicked => { Kit.suggest(); }
            }
        }
    }
}

// The Kit left while changes wait: they stay for later unless Save or Discard settles them.
export component KitAskSheet inherits AskSheet {
    title: @tr("Save Your Kit?");
    message: @tr("{n} change to your Kit is not on The Lens DB yet." | "{n} changes to your Kit are not on The Lens DB yet." % Kit.unsaved);
    cancel: @tr("Later");
    keys: [{ text: @tr("Discard"), role: AskRole.destructive }, { text: @tr("Save"), role: AskRole.confirm }];
    answered(i) => { Kit.answered(i); }
}
