// "Show My Year on Film": a strip of film pulled down through the gate, one scene a frame, each 9 by 16 in
// the light of its own photo. ↓ or a click pulls the next, ↑ winds back, it runs by itself unless Space or a
// held press pauses it, and Esc leaves: each a keycap beside the strip. Past the last scene, every card is
// laid out to be saved and posted. Shown before its year is read, it says so on the film running unexposed.
import { Space, Motion, Icons, WrappedStyle, WrappedGround, WrappedAmbient, WrappedProgress, WrappedFrame, WrappedLoading, WrappedPick } from "ds/ds.slint";
import { WrappedHeading, WrappedKind, WrappedLine, WrappedSwatch, WrappedScene, Keyboard, Button, ButtonKind, Look, Label, TextRole, Tone } from "ds/ds.slint";

export { WrappedKind, WrappedLine, WrappedSwatch, WrappedScene }

export global Wrapped {
    in property <bool> shown;
    // Shown while its year is still being read: the view says so until the first scene is laid.
    in property <bool> loading;
    // The bar's key through December and January, the year it tells in two figures; empty out of them.
    in property <string> title;
    // The bar's key, clicked.
    callback open();
    // Bumped at each showing: a view kept across a quick close and reopen starts over.
    in property <int> showing;
    in property <string> year;
    in property <[WrappedScene]> scenes;
    in property <int> index;
    // The film advances by itself after each scene's hold.
    in property <bool> playing;
    // Past the last scene: every card laid out, to save and post.
    in property <bool> sharing;
    // One card alone, `still-width` wide with its corner at `still-x`, `still-y`, told whole: what a
    // card's picture is taken from, a window's worth at a time.
    in property <bool> still;
    in property <length> still-width;
    in property <length> still-x;
    in property <length> still-y;
    // Where the view lies in the window and how large, which it says itself: a card's picture is taken
    // from there, under a menu bar where the window holds one.
    in-out property <length> view-x;
    in-out property <length> view-y;
    in-out property <length> view-width;
    in-out property <length> view-height;
    // What a posted card is tagged with, and whom.
    in property <string> hashtag;
    in property <string> account;
    in property <string> name;
    // What the last save or copy did, said under the keys.
    in property <string> notice;
    // A click, → or Return: the next scene, then the share screen, then the summary left.
    callback forward();
    callback back();
    callback close();
    // Every card saved into the year's folder, which is then shown; one card saved there, or copied.
    callback save-all();
    callback save-card(int);
    callback copy-card(int);
    // A count with its thousands grouped as the language writes them.
    pure callback counted(int) -> string;
}

// A key of the year on film: a keycap, its glyph over its word, shown pressed while its own key is held
// on the keyboard.
component WrappedKey inherits Button {
    in property <bool> held;
    keycap: true;
    stacked: true;
    has-icon: true;
    tabbed: false;
    look: root.held ? Look.pressed : Look.live;
}

export component WrappedView inherits WrappedGround {
    property <bool> revealed;
    property <int> showing: Wrapped.showing;
    property <int> index: Wrapped.index;
    property <int> count: Wrapped.scenes.length;
    // Space pauses the film and starts it again; it starts paused where motion is reduced.
    property <bool> paused: Motion.reduced;
    // The film runs by itself while it plays, nothing holds it and a scene follows.
    property <bool> running: Wrapped.playing && !root.paused && !Wrapped.still && !Wrapped.sharing && root.revealed && !touch.pressed && root.index < root.count - 1;
    // How long the scene in the gate has been held: what was held before the last pause, and the run since `mark`.
    property <duration> banked;
    property <duration> mark;
    property <duration> held: root.banked + (root.running ? animation-tick() - root.mark : 0ms);
    // The frame in the gate takes the window's height but for a glimpse of its neighbours.
    property <length> u: min((root.height - 2 * WrappedStyle.peek) / WrappedStyle.frame-height, (root.width - 2 * Space.l) / WrappedStyle.frame-width);
    property <length> pitch: WrappedStyle.pitch * root.u;
    property <length> gate: WrappedStyle.frame-width * root.u;
    // The key held down on the keyboard, which its keycap shows pressed.
    property <string> held-key;
    property <Point> origin: self.absolute-position;
    init => {
        root.placed();
        keys.focus();
    }
    changed origin => { root.placed(); }
    changed width => { root.placed(); }
    changed height => { root.placed(); }
    function placed() {
        Wrapped.view-x = root.absolute-position.x;
        Wrapped.view-y = root.absolute-position.y;
        Wrapped.view-width = root.width;
        Wrapped.view-height = root.height;
    }
    changed showing => {
        root.revealed = false;
        root.rewind();
        keys.focus();
    }
    changed index => { root.rewind(); }
    changed running => {
        if (root.running) {
            root.mark = animation-tick();
        } else {
            root.banked += animation-tick() - root.mark;
        }
    }
    function rewind() {
        root.banked = 0ms;
        root.mark = animation-tick();
    }
    // The strip comes in from the frame after it is laid; the keyboard is taken once the view is in the
    // window, where a focus asked at creation is lost.
    Timer {
        interval: WrappedStyle.frame-time;
        running: !root.revealed;
        triggered => {
            root.revealed = true;
            keys.focus();
        }
    }
    Timer {
        interval: WrappedStyle.tick;
        running: root.running;
        triggered => {
            if (root.held >= WrappedStyle.hold) {
                Wrapped.forward();
            }
        }
    }
    // A click left of the gate winds back, anywhere else pulls the next; a press held keeps the scene.
    touch := TouchArea {
        enabled: !Wrapped.sharing && !Wrapped.loading;
        clicked => {
            if (self.mouse-x < (root.width - root.gate) / 2) {
                Wrapped.back();
            } else {
                Wrapped.forward();
            }
        }
    }
    // Covering the window as a sheet does, it takes back the keyboard Tab carried to the window's walls.
    property <int> entered: Keyboard.entered + Keyboard.entered-back;
    changed entered => { keys.focus(); }
    keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            root.held-key = event.text;
            if (event.text == Key.Escape) { Wrapped.close(); return accept; }
            if (Wrapped.loading) { return reject; }
            if (event.text == Key.DownArrow || event.text == Key.RightArrow || event.text == Key.Return) { Wrapped.forward(); return accept; }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow) { Wrapped.back(); return accept; }
            if (event.text == " ") { root.paused = !root.paused; return accept; }
            if (event.text == "s") { Wrapped.save-card(root.index); return accept; }
            if (event.text == "c") { Wrapped.copy-card(root.index); return accept; }
            reject
        }
        key-released(event) => {
            root.held-key = "";
            reject
        }
    }
    // The year still being read: the film runs through the gate, and the one key is the way out.
    if Wrapped.loading && !Wrapped.still: Rectangle {
        WrappedLoading {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            u: root.u;
            year: Wrapped.year;
            text: @tr("Developing your year");
        }
        VerticalLayout {
            x: (parent.width + root.gate) / 2 + Space.l;
            width: self.preferred-width;
            alignment: center;
            WrappedKey { icon: Icons.close; text: @tr("Close"); held: root.held-key == Key.Escape; clicked => { Wrapped.close(); } }
        }
    }
    if !Wrapped.loading && !Wrapped.still && !Wrapped.sharing: Rectangle {
        opacity: root.revealed ? 1 : 0;
        animate opacity { duration: WrappedStyle.enter; easing: ease-out; }
        // The window around the strip stands in the light of the scene in the gate.
        for scene[i] in Wrapped.scenes: WrappedAmbient {
            width: parent.width;
            height: parent.height;
            source: scene.backdrop;
            lit: i == root.index;
        }
        Rectangle {
            x: (parent.width - root.gate) / 2;
            y: parent.height / 2 - (root.index + 0.5) * root.pitch + WrappedStyle.frame-line * root.u / 2 + (root.revealed ? 0px : root.pitch);
            width: root.gate;
            height: root.count * root.pitch;
            animate y { duration: WrappedStyle.advance; easing: cubic-bezier(0.7, 0, 0.15, 1); }
            for scene[i] in Wrapped.scenes: WrappedFrame {
                // A frame the film has reached stays told while it is beside the gate; one ahead is unexposed.
                property <bool> gated: i <= root.index && root.revealed;
                property <float> run;
                y: i * root.pitch;
                u: root.u;
                scene: scene;
                number: i + 1;
                hashtag: Wrapped.hashtag;
                account: Wrapped.account;
            name: Wrapped.name;
                told: self.run;
                drift: i == root.index ? clamp(root.held / WrappedStyle.hold, 0, 1) : 0;
                visible: abs(i - root.index) <= 1;
                opacity: i == root.index ? 1 : WrappedStyle.beside;
                counted(n) => { Wrapped.counted(n) }
                animate opacity { duration: WrappedStyle.advance; }
                // Told once the film has stopped; wound back past, emptied only after it has left the gate.
                states [
                    told when self.gated: {
                        run: 1;
                        in { animate run { duration: WrappedStyle.tell; delay: WrappedStyle.advance * 0.7; } }
                        out { animate run { duration: 0ms; delay: WrappedStyle.advance; } }
                    }
                ]
            }
        }
        // The story's segments lie where a story shows its own, over the top of the frame in the gate.
        WrappedProgress {
            x: (parent.width - self.width) / 2;
            y: (parent.height - WrappedStyle.frame-height * root.u) / 2 + 18 * root.u;
            width: WrappedStyle.inner * root.u;
            count: root.count;
            at: root.index;
            held: root.held / WrappedStyle.hold;
        }
        // The keys stand beside the strip: what saves the cards, then the film's own, then the way out.
        VerticalLayout {
            x: (parent.width + root.gate) / 2 + Space.l;
            width: self.preferred-width;
            alignment: center;
            spacing: Space.s;
            WrappedKey { icon: Icons.update; text: @tr("Save All"); kind: ButtonKind.accent; clicked => { Wrapped.save-all(); keys.focus(); } }
            WrappedKey { icon: Icons.update; text: @tr("Save Card"); held: root.held-key == "s"; clicked => { Wrapped.save-card(root.index); keys.focus(); } }
            WrappedKey { icon: Icons.copy; text: @tr("Copy Card"); held: root.held-key == "c"; clicked => { Wrapped.copy-card(root.index); keys.focus(); } }
            Rectangle { height: Space.m; }
            WrappedKey { icon: Icons.parent; text: @tr("Previous"); held: root.held-key == Key.UpArrow; enabled: root.index > 0; clicked => { Wrapped.back(); keys.focus(); } }
            WrappedKey {
                icon: root.paused ? Icons.play : Icons.pause;
                text: root.paused ? @tr("Play") : @tr("Pause");
                held: root.held-key == " ";
                clicked => { root.paused = !root.paused; keys.focus(); }
            }
            WrappedKey { icon: Icons.next; text: @tr("Next"); held: root.held-key == Key.DownArrow; clicked => { Wrapped.forward(); keys.focus(); } }
            Rectangle { height: Space.m; }
            WrappedKey { icon: Icons.close; text: @tr("Close"); held: root.held-key == Key.Escape; clicked => { Wrapped.close(); } }
        }
        // What the last save or copy did.
        Label {
            x: Space.l;
            y: parent.height - self.preferred-height - Space.l;
            width: (parent.width - root.gate) / 2 - 2 * Space.l;
            role: TextRole.note;
            text: Wrapped.notice;
        }
    }
    // Every card at once, as large as the window holds them in at most three rows.
    if !Wrapped.still && Wrapped.sharing: share := Rectangle {
        property <int> rows: root.count > 12 ? 3 : root.count > 5 ? 2 : 1;
        property <int> columns: ceil(root.count / self.rows);
        property <length> across: (parent.width - 2 * Space.l) / (self.columns * (WrappedStyle.frame-width + WrappedStyle.share-gap));
        property <length> down: (parent.height - WrappedStyle.share-words - WrappedStyle.share-keys) / (self.rows * (WrappedStyle.frame-height + WrappedStyle.share-gap));
        property <length> u: min(self.across, self.down);
        property <length> step-x: (WrappedStyle.frame-width + WrappedStyle.share-gap) * self.u;
        property <length> step-y: (WrappedStyle.frame-height + WrappedStyle.share-gap) * self.u;
        VerticalLayout {
            y: Space.l;
            height: WrappedStyle.share-words - Space.l;
            spacing: Space.s;
            alignment: center;
            WrappedHeading { text: @tr("Your year, ready to share"); }
            Label {
                role: TextRole.note;
                centred: true;
                text: @tr("Post the cards in your story and tag {} with {}. A click on a card saves it alone.", Wrapped.account, Wrapped.hashtag);
            }
        }
        for scene[i] in Wrapped.scenes: WrappedPick {
            x: (parent.width - share.columns * share.step-x + WrappedStyle.share-gap * share.u) / 2 + mod(i, share.columns) * share.step-x;
            y: WrappedStyle.share-words + floor(i / share.columns) * share.step-y;
            u: share.u;
            scene: scene;
            number: i + 1;
            hashtag: Wrapped.hashtag;
            account: Wrapped.account;
            name: Wrapped.name;
            counted(n) => { Wrapped.counted(n) }
            picked => { Wrapped.save-card(i); keys.focus(); }
        }
        Label {
            y: parent.height - WrappedStyle.share-keys + Space.xs;
            width: parent.width;
            role: TextRole.caption;
            tone: Tone.secondary;
            centred: true;
            text: Wrapped.notice;
        }
        HorizontalLayout {
            y: parent.height - WrappedStyle.share-keys + Space.xs + Space.l;
            height: self.preferred-height;
            alignment: center;
            spacing: Space.s;
            WrappedKey { icon: Icons.update; text: @tr("Save All"); kind: ButtonKind.accent; clicked => { Wrapped.save-all(); keys.focus(); } }
            WrappedKey { icon: Icons.parent; text: @tr("Back"); held: root.held-key == Key.UpArrow; clicked => { Wrapped.back(); keys.focus(); } }
            WrappedKey { icon: Icons.close; text: @tr("Close"); held: root.held-key == Key.Escape; clicked => { Wrapped.close(); } }
        }
    }
    if Wrapped.still: WrappedFrame {
        x: Wrapped.still-x;
        y: Wrapped.still-y;
        u: Wrapped.still-width / WrappedStyle.frame-width;
        scene: Wrapped.scenes[root.index];
        number: root.index + 1;
        hashtag: Wrapped.hashtag;
        account: Wrapped.account;
            name: Wrapped.name;
        counted(n) => { Wrapped.counted(n) }
    }
}
