// `DSStatusBar`, the one bar under the card in every mode: what loads or exports, else the mode's own line.
import { StatusBar, MedalPicker, Space, StatusStyle } from "ds/ds.slint";
import { Library } from "library.slint";
import { Preparing } from "prepare.slint";
import { Canvas } from "canvas_state.slint";
import { Exporting } from "export_state.slint";
import { KeyWords } from "key_words.slint";
import { Upgraded } from "notice.slint";

export component CardStatus inherits HorizontalLayout {
    in property <bool> gallery;
    padding-top: Space.s;
    padding-bottom: Space.s;
    padding-right: StatusStyle.inset;
    // The editor's line, the open frame, its place on the roll and its size, then whether its sidecar
    // holds its settings.
    in property <string> editor-line;
    property <string> saved: Canvas.saved ? " · " + @tr("Settings saved") : "";
    property <bool> loading: Library.loading != "" && !Preparing.shown;
    // The sweep's line in the gallery, below a folder's reading when both run.
    property <bool> migrating: Upgraded.line != "" && root.gallery && !Preparing.shown;
    // The export under way once its surface closed: its count, its progress and its Stop.
    property <bool> exporting: Exporting.job-shown && !root.loading && !Preparing.shown;
    // `statusMedalTarget`: beside a photo with nothing selected, the open frame takes the medal. The group
    // leads the line, by the photo's name, so the line's words changing never move it under the hand.
    if !root.loading && !Preparing.shown && (root.gallery ? Library.medal-shown : Library.editor-medal-shown): MedalPicker {
        padding-left: StatusStyle.inset;
        horizontal-stretch: 0;
        current: root.gallery ? Library.medal-current : Library.editor-medal-current;
        // The line names what the medals rate: a medal changing under the same line was laid on it.
        holder: root.gallery ? Library.status : root.editor-line;
        picked(m) => { Library.medal-picked(m); }
    }
    StatusBar {
        horizontal-stretch: 1;
        busy: root.loading || root.exporting || root.migrating;
        text: root.loading ? Library.loading : root.exporting ? Exporting.job-title : root.migrating ? Upgraded.line
            : Preparing.shown ? Preparing.status : root.gallery ? Library.status : root.editor-line + root.saved;
        count: root.exporting ? Exporting.job-count : Library.loading-count;
        fraction: root.exporting ? Exporting.job-fraction : root.loading ? Library.loading-fraction : root.migrating ? Upgraded.fraction : -1;
        seal: Preparing.shown ? "" : root.gallery ? Library.status-seal : Library.editor-seal;
        // Once a roll prepared opens on its first frame alone, how to show every frame together.
        hint: root.loading && root.migrating ? Upgraded.line
            : !root.gallery && !Preparing.shown && Preparing.landed-alone ? @tr("Select All ({}) to edit the whole roll", KeyWords.command + "A") : "";
        key: root.exporting ? @tr("Stop") : "";
        key-enabled: !Exporting.job-stopping;
        key-clicked => { Exporting.job-stop(); }
    }
}
