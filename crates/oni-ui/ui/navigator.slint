// The navigator above the archive tree (`FolderNavigator`), with `RootWelcome` and `RootsCatchUp`:
// the favourites' section, then Computer's, each folding under its heading, then the ONI Trash in every view.
import { Space, ShellStyle, RowStyle, Scroller, KeyScope, RowsDivider, RowsHeading, MenuLine, Label, TextRole, Tone, Button, Icons, Sheet, Gap, Row, RowKind, Menu, Badge, BadgeTone, RowForm, FormStyle, Reach, SheetFooter, SheetStyle } from "ds/ds.slint";

// A line of the ONI Trash's rows: the trash itself at depth 0, its folders under it.
export struct TrashLine {
    title: string,
    trail: string,
    count: string,
    depth: int,
    foldable: bool,
    unfolded: bool,
    picked: bool,
    opened: bool,
    present: bool,
    restore-help: string,
    // A folder's whole path, said under the pointer; its title is its name alone.
    help: string,
}

// A folder's row: `kind` 0 a folder, 1 a roll, 2 the opened folder, 3 a section's heading.
export struct FolderLine {
    title: string,
    // The title cut for a narrow column: its head elides, its tail stays whole; no tail, no cut.
    head: string,
    tail: string,
    // Before the title, the folders above a favourite whose name another shares.
    trail: string,
    path: string,
    depth: int,
    chevron: bool,
    unfolded: bool,
    kind: int,
    picked: bool,
    opened: bool,
    favourite: bool,
    present: bool,
    // Out of reach: its state, the words saying it and the tooltip saying where.
    reach: Reach,
    caption: string,
    help: string,
    renaming: bool,
    // A roll's stock artwork, drawn in place of the film-roll glyph.
    stock: image,
    has-stock: bool,
    // Photos lie in it and none is measured: its roll asks for Prepare Roll.
    unprepared: bool,
}

// A former library's folder; one on a disk away is shown, not offered.
export struct WelcomeLine { title: string, path: string, enabled: bool }
export struct CatchUpLine { folder: string, count: string }

export global Navigator {
    in property <[FolderLine]> rows;
    // The rows' height beside a photograph, dragged by the line under them.
    in-out property <length> height;
    // Beside a photo, its folder's row, -1 in the gallery; each serial asks the rows to centre it.
    in property <int> reveal-row: -1;
    in property <int> reveal-serial;
    in property <[MenuLine]> menu-lines;
    in property <bool> welcome-shown;
    in property <[WelcomeLine]> welcome;
    in property <bool> catch-up-shown;
    in property <string> catch-up-choose;
    in property <string> catch-up-left;
    in property <[CatchUpLine]> catch-up-lines;
    in property <string> catch-up-more;
    in property <string> catch-up-all-in;
    callback row-clicked(int);
    // The rows took the keyboard, by a click on a row or by Tab; a key while they hold it, ⌘ held or
    // not, answering whether they read it.
    callback keys-taken();
    callback key(string, bool) -> bool;
    // The chevron alone: the row folds or unfolds, and nothing opens.
    callback row-folded(int);
    callback star-clicked(int);
    callback row-menu(int) -> bool;
    callback menu-chosen(int);
    callback rename-committed(int, string);
    callback rename-cancelled();
    callback height-stored(length);
    callback mode-changed();
    callback welcome-added(int);
    callback welcome-chose();
    callback catch-up-chose();
    callback catch-up-added(int);
    callback catch-up-done();
}

// The sections' folders, then the ONI Trash's rows; scrolled by the wheel and the knob alone.
component Rows inherits Scroller {
    in property <[TrashLine]> trash-rows;
    // A place in Tab's order, beside the grid, where the arrows walk the rows.
    in property <bool> keyed;
    callback trash-clicked(int);
    callback trash-folded(int);
    callback trash-restore(int);
    // A right click, at the pointer in window coordinates.
    callback trash-menu(int, length, length);
    callback folder-menu(int, length, length);
    property <int> serial: Navigator.reveal-serial;
    property <int> aim: Navigator.reveal-row;
    // The photo's folder centred once per reveal Rust asks and once as a list is made, which beside a
    // photo comes after the ask; owed until the list has laid that row, so no later change re-centres it.
    property <bool> owed: true;
    content-height: column.preferred-height;
    changed serial => { root.owed = true; root.reveal(); }
    changed aim => { root.reveal(); }
    changed height => { root.reveal(); }
    changed content-height => { root.reveal(); }
    init => { root.reveal(); }
    function reveal() {
        if (root.owed && root.aim >= 0 && root.height > 0 && root.content-height >= (root.aim + 1) * RowStyle.height) {
            root.owed = false;
            self.content-y = min(0px, max(self.height - self.content-height, self.height / 2 - (root.aim + 0.5) * RowStyle.height));
        }
    }
    column := VerticalLayout {
        width: parent.width;
        alignment: start;
        padding-left: ShellStyle.column-inset;
        padding-right: ShellStyle.column-inset;
        for row[i] in Navigator.rows: VerticalLayout {
            if row.kind == 3: RowsHeading {
                title: row.title;
                unfolded: row.unfolded;
                toggled => { Navigator.row-folded(i); }
            }
            if row.kind != 3 && !row.renaming: Row {
                form: RowForm.navigator;
                starrable: true;
                title: row.title;
                head: row.head;
                tail: row.tail;
                trail: row.trail;
                help: row.help != "" ? row.help : row.path;
                caption: row.caption;
                reach: row.reach;
                unprepared: row.unprepared;
                depth: row.depth;
                expandable: row.chevron;
                expanded: row.unfolded;
                kind: row.kind == 1 ? RowKind.roll : row.kind == 2 ? RowKind.opened : RowKind.folder;
                stock: row.stock;
                has-stock: row.has-stock;
                picked: row.picked;
                focused: keys.has-focus && !keys.pressed && row.picked;
                selected: row.opened;
                favourite: row.favourite;
                present: row.present;
                clicked => { keys.take(); Navigator.row-clicked(i); }
                folded => { keys.take(); Navigator.row-folded(i); }
                starred => { Navigator.star-clicked(i); }
                menu(x, y) => { root.folder-menu(i, self.absolute-position.x + x, self.absolute-position.y + y); }
            }
            if row.renaming: Row {
                renaming: true;
                title: row.title;
                depth: row.depth;
                committed(t) => { Navigator.rename-committed(i, t); }
                cancelled => { Navigator.rename-cancelled(); }
            }
        }
        // Apart from Computer's rows, so a folded section never seems to hold it.
        VerticalLayout {
            padding-top: Space.s;
            for line[i] in root.trash-rows: Row {
                kind: RowKind.trash;
                form: RowForm.navigator;
                title: line.title;
                trail: line.trail;
                help: line.help;
                caption: line.count;
                depth: line.depth;
                expandable: line.foldable;
                expanded: line.unfolded;
                picked: line.picked;
                selected: line.opened;
                present: line.present;
                action: line.restore-help != "" ? @tr("Restore") : "";
                action-help: line.restore-help;
                clicked => { root.trash-clicked(i); }
                folded => { root.trash-folded(i); }
                acted => { root.trash-restore(i); }
                menu(x, y) => { root.trash-menu(i, self.absolute-position.x + x, self.absolute-position.y + y); }
            }
        }
    }
    // A click on a row or Tab gives the rows the keyboard, named by the list round it, until a press
    // elsewhere; as on a slider, Tab or a key acting here rings the picked row, a click alone does not.
    Rectangle {
        accessible-role: list;
        accessible-label: @tr("Folders");
        keys := KeyScope {
            property <bool> pressed;
            enabled: root.keyed;
            ring: false;
            function take() {
                self.pressed = true;
                self.focus();
            }
            changed has-focus => {
                if (self.has-focus) { Navigator.keys-taken(); } else { self.pressed = false; }
            }
            key-pressed(event) => {
                if (Navigator.key(event.text, event.modifiers.control)) {
                    self.pressed = false;
                    return accept;
                }
                reject
            }
        }
    }
}

// `RootWelcome`: what the archive shows, then the folders a former library held, each a key.
component Welcome inherits VerticalLayout {
    padding: Space.m;
    spacing: Space.s;
    Label { text: @tr("The archive shows a folder of your disk and everything under it."); role: TextRole.note; }
    if Navigator.welcome.length > 0: Label { text: @tr("Your photos were in:"); }
    for line[i] in Navigator.welcome: Button {
        text: line.title;
        help: line.path;
        enabled: line.enabled;
        clicked => { Navigator.welcome-added(i); }
    }
    Button {
        text: @tr("Add Folder…");
        clicked => { Navigator.welcome-chose(); }
    }
}

// `navigatorSection`: beside the grid the rows take the column; beside a photograph they keep
// their own height, sized by the line under them.
export component NavigatorSection inherits Rectangle {
    in property <bool> beside-photo;
    in property <[TrashLine]> trash-rows;
    callback trash-clicked(int);
    callback trash-folded(int);
    callback trash-restore(int);
    callback trash-menu(int, length, length);
    property <length> menu-x;
    property <length> menu-y;
    changed beside-photo => { Navigator.mode-changed(); }
    VerticalLayout {
        if Navigator.welcome-shown && !root.beside-photo: Welcome { }
        if !root.beside-photo: Rectangle {
            vertical-stretch: 1;
            Rows {
                keyed: true;
                trash-rows: root.trash-rows;
                trash-clicked(i) => { root.trash-clicked(i); }
                trash-folded(i) => { root.trash-folded(i); }
                trash-restore(i) => { root.trash-restore(i); }
                trash-menu(i, x, y) => { root.trash-menu(i, x, y); }
                folder-menu(i, x, y) => { root.show-menu(i, x, y); }
            }
        }
        if root.beside-photo: Rectangle {
            height: Navigator.height;
            Rows {
                trash-rows: root.trash-rows;
                trash-clicked(i) => { root.trash-clicked(i); }
                trash-folded(i) => { root.trash-folded(i); }
                trash-restore(i) => { root.trash-restore(i); }
                trash-menu(i, x, y) => { root.trash-menu(i, x, y); }
                folder-menu(i, x, y) => { root.show-menu(i, x, y); }
            }
        }
        if root.beside-photo: RowsDivider {
            rows <=> Navigator.height;
            released(h) => { Navigator.height-stored(h); }
        }
    }
    function show-menu(i: int, x: length, y: length) {
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        if (Navigator.row-menu(i)) { menu.show(); }
    }
    menu := Menu {
        x: root.menu-x;
        y: root.menu-y;
        lines: Navigator.menu-lines;
        chosen(i) => { menu.close(); Navigator.menu-chosen(i); }
    }
}

// `RootsCatchUp`: shown once to a library made before the archive followed the disk.
export component RootsCatchUpSheet inherits Sheet {
    title: @tr("Your Library Now Follows Your Disk");
    card-width: SheetStyle.notice-width;
    // Its groups a wider step apart than a plain sheet's lines, the steps a medium one.
    gap: Gap.l;
    dismissed => { Navigator.catch-up-done(); }
    VerticalLayout {
        spacing: Space.m;
        for step[i] in [
            { title: @tr("Pick the folder that holds all your scans"), detail: @tr("ONI reads it straight from your disk.") },
            { title: @tr("Every folder inside it comes in"), detail: @tr("All the way down, nothing to import.") },
            { title: @tr("Not your whole disk"), detail: @tr("Too wide and ONI reads everything; too narrow and photos stay out.") },
        ]: HorizontalLayout {
            spacing: Space.s;
            VerticalLayout {
                alignment: start;
                Badge { tone: BadgeTone.step; text: i + 1; }
            }
            // The title's first line level with the number's disc.
            VerticalLayout {
                padding-top: Space.xs;
                spacing: Space.xxs;
                horizontal-stretch: 1;
                Label { text: step.title; wrap: word-wrap; }
                Label { text: step.detail; role: TextRole.note; }
            }
        }
    }
    Button {
        text: Navigator.catch-up-choose;
        clicked => { Navigator.catch-up-chose(); }
    }
    if Navigator.catch-up-left != "": VerticalLayout {
        spacing: Space.xs;
        Label { text: Navigator.catch-up-left; }
        for line[i] in Navigator.catch-up-lines: HorizontalLayout {
            spacing: Space.s;
            Label { text: line.folder; role: TextRole.caption; tone: Tone.secondary; overflow: elide; horizontal-stretch: 1; }
            Label { text: line.count; role: TextRole.caption; tone: Tone.secondary; }
            Button { text: @tr("Add"); clicked => { Navigator.catch-up-added(i); } }
        }
        if Navigator.catch-up-more != "": Label { text: Navigator.catch-up-more; role: TextRole.caption; tone: Tone.tertiary; }
    }
    if Navigator.catch-up-all-in != "": Label { text: Navigator.catch-up-all-in; tone: Tone.secondary; }
    SheetFooter {
        commit: @tr("DONE");
        committed => { Navigator.catch-up-done(); }
    }
}
