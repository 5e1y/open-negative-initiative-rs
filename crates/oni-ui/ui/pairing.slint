// The Pair Phone sheet: the one-time QR code the phone scans, over a scrim on the window.
import { Sheet, Picture, Ground, Label, Tone, Button, SheetStyle } from "ds/ds.slint";

export global Pairing {
    in property <bool> shown;
    in property <image> code;
    // The code's text, which a check pairs from as the phone's camera would.
    in property <string> uri;
    in property <string> status;
    callback close();
}

export component PairingSheet inherits Sheet {
    title: "Pair Phone";
    dismissed => { Pairing.close(); }
    HorizontalLayout {
        alignment: center;
        Picture {
            width: SheetStyle.code;
            height: SheetStyle.code;
            ground: Pairing.uri != "" ? Ground.paper : Ground.skeleton;
            rounded: true;
            pixelated: true;
            source: Pairing.code;
        }
    }
    Label {
        text: Pairing.status;
        tone: Tone.secondary;
        centred: true;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: "DONE";
            clicked => { Pairing.close(); }
        }
    }
}
