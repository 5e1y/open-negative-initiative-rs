// The Pair Phone sheet: the one-time QR code the phone scans, laid as every ONI sheet.
import { Sheet, Picture, Ground, Label, Tone, Button, ButtonKind, SheetStyle, ButtonGroup, GroupAlign } from "ds/ds.slint";

export global Pairing {
    // The phone link offered at all, Rust's `phone::READY`: off hides every entry to it.
    in property <bool> available;
    in property <bool> shown;
    in property <image> code;
    // The code's text, which a check pairs from as the phone's camera would.
    in property <string> uri;
    in property <string> status;
    // The phones connected now, or how many are paired; empty with none paired.
    in property <string> phones;
    in property <bool> can-forget;
    callback close();
    callback forget();
}

export component PairingSheet inherits Sheet {
    title: @tr("Pair Phone");
    dismissed => { Pairing.close(); }
    HorizontalLayout {
        alignment: center;
        Picture {
            width: SheetStyle.code;
            height: SheetStyle.code;
            ground: Pairing.uri != "" ? Ground.paper : Ground.skeleton;
            rounded: true;
            pixelated: true;
            source: Pairing.code;
        }
    }
    Label {
        text: Pairing.status;
        tone: Tone.secondary;
        wrap: word-wrap;
    }
    if Pairing.phones != "": Label {
        text: Pairing.phones;
        wrap: word-wrap;
    }
    ButtonGroup { plate: true; align: GroupAlign.end;
        if Pairing.can-forget: Button {
            text: @tr("FORGET PHONES");
            kind: ButtonKind.destructive;
            help: @tr("Every paired phone is cut and pairs again from a new code.");
            clicked => { Pairing.forget(); }
        }
        Button {
            text: @tr("DONE");
            clicked => { Pairing.close(); }
        }
    }
}
