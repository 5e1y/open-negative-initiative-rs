    in property <bool> color-modified;
    in property <bool> lighting-modified;
    in property <bool> effects-modified;
    in property <bool> density-ceiling-modified;
    in property <bool> dye-separation-modified;
    in property <bool> sharpening-modified;
    in property <bool> chroma-denoise-modified;
    in property <bool> texture-modified;
    in property <bool> source-balance-modified;
    in property <bool> flat-field-modified;
    in property <bool> paper-correction-modified;
    in property <bool> channel-points-modified;
    in property <bool> film-effects-modified;
    in property <bool> lens-corrections-modified;
    // More Color Settings' channels moved off their rest, red, green then blue, for their tabs' marks.
    in property <[bool]> channel-marked: [false, false, false];
    // Each field's rest as a fraction of its track, by its index: the double click's value, which a
    // slider ticks and holds a drag on; it moves only with the frame.
    in property <[float]> rests;
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    callback scroll(int, length, length, length, bool) -> bool;
    callback step(int, int);
    // A number typed over a field's readout, in units of its last shown digit.
    callback typed(int, int);
    // A block back to rest, then one field, by their indices.
    callback reset(int);
    callback rest(int);
}
