// `InfoSidebar` beside the gallery: the roll the gallery stands on, a folder of photos being one,
// the project, or the ONI Trash.
import { Section, Label, Tone, TextRole, Space, ShellStyle, Surface, Scroller, EditableTitle, StockIcon, StockStyle, Button, DateFields, Icons, TextField, CardStack, WarningBand } from "ds/ds.slint";
import { Library } from "library.slint";

export component Info inherits Surface {
    width: ShellStyle.panel-width;
    // `InfoSidebar`'s ScrollView: a tall roll scrolls under the column instead of clipping.
    Scroller {
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            if Library.info-kind == 0: VerticalLayout {
                padding: Space.m;
                Label { text: Library.info-empty; tone: Tone.secondary; }
            }
            if Library.info-kind == 1: VerticalLayout {
                if Library.roll-unmeasured: VerticalLayout {
                    padding: Space.m;
                    spacing: Space.s;
                    WarningBand { text: @tr("Not prepared yet"); }
                    // Words, no key: the bar's Prepare Roll stays the gallery's one commit.
                    Label { role: TextRole.note; text: @tr("Prepare Roll, in the bar above, measures the roll before its frames are edited."); }
                }
                Section {
                    title: @tr("Roll");
                    separated: false;
                    EditableTitle {
                        text: Library.info-title;
                        placeholder: @tr("Roll name");
                        edited(t) => { Library.title-edited(t); }
                        committed(t) => { Library.title-committed(t); }
                    }
                }
                Section {
                    title: @tr("Film Stock");
                    help: @tr("What this roll was shot on — never guessed, only ever what a hand picks.");
                    // `heroStock`: the artwork, the name, and where a default came from.
                    HorizontalLayout {
                        alignment: center;
                        StockIcon { artwork: Library.stock-artwork; has-artwork: Library.stock-has-artwork; side: StockStyle.hero; }
                    }
                    if Library.stock != "": Label { text: Library.stock; centred: true; }
                    if Library.stock-note != "": Label { text: Library.stock-note; role: TextRole.note; centred: true; }
                    if Library.stock-dyes != "" && Library.stock-dyes-fix == "": Label { text: Library.stock-dyes; role: TextRole.note; centred: true; }
                    // Dyes other than the stock's warn, the key laying the stock's right under the warning.
                    if Library.stock-dyes-fix != "": WarningBand { text: Library.stock-dyes; }
                    if Library.stock-dyes-fix != "": Button {
                        text: Library.stock-dyes-fix;
                        help: @tr("Sets every frame of this roll to the film stock's dyes, leaving each frame's Dye separation amount as it is.");
                        clicked => { Library.stock-dyes-laid(); }
                    }
                    Button { text: @tr("Select Film Stock"); clicked => { Library.select-roll-type(); } }
                }
                Section {
                    title: @tr("Shot Date");
                    help: @tr("When the roll was actually shot. Organisational only — never a photo's own capture date.");
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        DateFields {
                            month <=> Library.month;
                            day <=> Library.day;
                            year <=> Library.year;
                            committed(m, d, y) => { Library.shot-date-committed(m, d, y); }
                        }
                        if Library.shot-date-set: Button { has-icon: true; square: true;
                            icon: Icons.reset;
                            help: @tr("Clear Shot Date");
                            clicked => { Library.shot-date-cleared(); }
                        }
                    }
                    if Library.shot-date-default: Label { text: @tr("Default, from this roll's first photo"); role: TextRole.note; }
                }
                Section {
                    title: @tr("Camera Body");
                    help: @tr("The body this roll was shot on, hand-entered — never read off a scan's own EXIF.");
                    TextField {
                        name: @tr("Camera Body");
                        placeholder: @tr("e.g. Leica M6");
                        text <=> Library.camera-body;
                        accepted(t) => { Library.camera-body-committed(t); }
                        left(t) => { Library.camera-body-committed(t); }
                    }
                }
            }
            if Library.info-kind == 2: VerticalLayout {
                Section {
                    title: @tr("Project");
                    separated: false;
                    EditableTitle {
                        text: Library.info-title;
                        placeholder: @tr("Project name");
                        edited(t) => { Library.title-edited(t); }
                        committed(t) => { Library.title-committed(t); }
                    }
                }
                CardStack { pictures: Library.stack; }
                Section {
                    title: @tr("Film Stocks");
                    help: @tr("Every film stock among this project's own photos — counted by photo, since a project rarely holds a whole roll.");
                    if Library.stocks.length == 0: Label { text: @tr("No film stock set yet"); role: TextRole.note; }
                    for row in Library.stocks: HorizontalLayout {
                        spacing: Space.s;
                        StockIcon { artwork: row.artwork; has-artwork: row.has-artwork; side: StockStyle.row; }
                        Label { text: row.name; horizontal-stretch: 1; }
                        Label { text: row.count; tone: Tone.secondary; }
                    }
                }
                Section {
                    title: @tr("Description");
                    TextField { multiline: true;
                        name: @tr("Description");
                        lines-height: ShellStyle.info-description;
                        text <=> Library.description;
                        left(t) => { Library.description-committed(t); }
                    }
                }
            }
            // A plain key, as Restore keeps: no key here deletes a file, the trash only hides.
            if Library.info-kind == 3: Section {
                title: @tr("ONI Trash");
                separated: false;
                Label { text: Library.trash-count; }
                Label { role: TextRole.note; text: @tr("A photo deleted in ONI waits here, its file untouched, until it is restored."); }
                if Library.trash-key != "": Button { text: Library.trash-key; clicked => { Library.trash-restore(); } }
            }
        }
    }
}
