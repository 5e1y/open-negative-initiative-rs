// `InfoSidebar` beside the gallery: the roll a selection stands on, or its project.
import { Section, Label, Tone, TextRole, Space, ShellStyle, Surface, Scroller, EditableTitle, StockIcon, StockStyle, Button, ButtonKind, ButtonSize, DateFields, Icons, TextField, CardStack, Field, WarningBand } from "ds/ds.slint";
import { Library } from "library.slint";
import { RollGuide } from "roll_guide.slint";
import { KeyWords } from "key_words.slint";

export component Info inherits Surface {
    width: ShellStyle.info-width;
    // `InfoSidebar`'s ScrollView: a tall roll scrolls under the column instead of clipping.
    Scroller {
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            if Library.info-kind == 0 && !RollGuide.shown: VerticalLayout {
                padding: Space.m;
                Label { text: Library.info-empty; tone: Tone.secondary; }
            }
            // The photos outside any roll, guided into one; nothing is made before the key.
            if Library.info-kind == 0 && RollGuide.shown: VerticalLayout {
                Section {
                    title: @tr("Not in a roll yet");
                    separated: false;
                    Label { text: @tr("A roll groups the frames of one film: measured once, they share base, levels and dyes."); tone: Tone.secondary; wrap: word-wrap; }
                }
                Section {
                    title: @tr("1 · Frames");
                    Label { text: RollGuide.count; }
                    Label { text: @tr("Select the whole film ({})", KeyWords.command + "A"); tone: Tone.secondary; wrap: word-wrap; }
                }
                Section {
                    title: @tr("2 · Name and Stock");
                    Field {
                        label: @tr("Name");
                        TextField {
                            text <=> RollGuide.name;
                            placeholder: RollGuide.proposed;
                            edited(t) => { RollGuide.name-edited(t); }
                        }
                    }
                    Field {
                        label: @tr("Stock");
                        HorizontalLayout {
                            spacing: Space.s;
                            if RollGuide.stock-has-artwork: StockIcon { artwork: RollGuide.stock-artwork; has-artwork: true; side: StockStyle.row; }
                            Button {
                                horizontal-stretch: 1;
                                text: RollGuide.stock != "" ? RollGuide.stock : @tr("Pick the film…");
                                clicked => { RollGuide.pick-stock(); }
                            }
                        }
                    }
                }
                Section {
                    title: @tr("3 · Make the Roll");
                    Button {
                        kind: ButtonKind.accent;
                        text: RollGuide.key;
                        enabled: RollGuide.enabled;
                        clicked => { RollGuide.create(); }
                    }
                    if RollGuide.note != "": Label { text: RollGuide.note; tone: Tone.secondary; wrap: word-wrap; }
                    Label { text: @tr("Next: Prepare the Roll measures it."); tone: Tone.secondary; wrap: word-wrap; }
                }
            }
            if Library.info-kind == 1: VerticalLayout {
                if Library.roll-unmeasured: VerticalLayout {
                    padding: Space.m;
                    spacing: Space.s;
                    WarningBand { text: @tr("Not measured yet"); }
                    Button {
                        size: ButtonSize.plate;
                        text: @tr("PREPARE THE ROLL…");
                        clicked => { Library.prepare-shown-roll(); }
                    }
                }
                Section {
                    title: @tr("Roll");
                    separated: false;
                    EditableTitle {
                        text: Library.info-title;
                        placeholder: @tr("Roll name");
                        edited(t) => { Library.title-edited(t); }
                        committed(t) => { Library.title-committed(t); }
                    }
                }
                Section {
                    title: @tr("Film Stock");
                    help: @tr("What this roll was shot on — never guessed, only ever what a hand picks.");
                    // `heroStock`: the artwork, the name, and where a default came from.
                    HorizontalLayout {
                        alignment: center;
                        StockIcon { artwork: Library.stock-artwork; has-artwork: Library.stock-has-artwork; side: StockStyle.hero; }
                    }
                    if Library.stock != "": Label { text: Library.stock; role: TextRole.title; centred: true; }
                    if Library.stock-note != "": Label { text: Library.stock-note; tone: Tone.secondary; wrap: word-wrap; centred: true; }
                    if Library.stock-dyes != "": Label { text: Library.stock-dyes; role: TextRole.note; tone: Tone.secondary; centred: true; }
                    Button { text: @tr("Select Roll Type"); clicked => { Library.select-roll-type(); } }
                }
                Section {
                    title: @tr("Shot Date");
                    help: @tr("When the roll was actually shot. Organisational only — never a photo's own capture date.");
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        DateFields {
                            month <=> Library.month;
                            day <=> Library.day;
                            year <=> Library.year;
                            committed(m, d, y) => { Library.shot-date-committed(m, d, y); }
                        }
                        if Library.shot-date-set: Button { has-icon: true; square: true;
                            icon: Icons.reset;
                            help: @tr("Clear shot date");
                            clicked => { Library.shot-date-cleared(); }
                        }
                    }
                    if Library.shot-date-default: Label { text: @tr("Default, from this roll's first photo"); tone: Tone.secondary; }
                }
                Section {
                    title: @tr("Camera Body");
                    help: @tr("The body this roll was shot on, hand-entered — never read off a scan's own EXIF.");
                    TextField {
                        placeholder: @tr("e.g. Leica M6");
                        text <=> Library.camera-body;
                        accepted(t) => { Library.camera-body-committed(t); }
                        left(t) => { Library.camera-body-committed(t); }
                    }
                }
            }
            if Library.info-kind == 2: VerticalLayout {
                Section {
                    title: @tr("Project");
                    separated: false;
                    EditableTitle {
                        text: Library.info-title;
                        placeholder: @tr("Project name");
                        edited(t) => { Library.title-edited(t); }
                        committed(t) => { Library.title-committed(t); }
                    }
                }
                CardStack { pictures: Library.stack; }
                Section {
                    title: @tr("Film Stocks");
                    help: @tr("Every stock among this project's own photos — counted by photo, since a project rarely holds a whole roll.");
                    if Library.stocks.length == 0: Label { text: @tr("No stock set yet"); tone: Tone.secondary; }
                    for row in Library.stocks: HorizontalLayout {
                        spacing: Space.s;
                        StockIcon { artwork: row.artwork; has-artwork: row.has-artwork; side: StockStyle.row; }
                        Label { text: row.name; horizontal-stretch: 1; }
                        Label { text: row.count; tone: Tone.secondary; }
                    }
                }
                Section {
                    title: @tr("Description");
                    TextField { multiline: true;
                        lines-height: ShellStyle.info-description;
                        text <=> Library.description;
                        left(t) => { Library.description-committed(t); }
                    }
                }
            }
        }
    }
}
