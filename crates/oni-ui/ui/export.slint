// Export as a mode of the card: one line per photo with its preview, the settings column on the right,
// the space field shared with the Working Space chip, and the dialogs the export raises.
import { News } from "help.slint";
import { Icons, Space, RowStyle, ButtonStyle, Label, Tone, TextRole, Button, ButtonKind, Tabs, Toggle, Slider, TextField, Picker, Section, Sheet, Divider, Spacer, Surface, Scroller, ListView, HStack, VStack, Gap, ShellStyle, FormStyle, Field, SummaryBox, FormRow, PreviewSlot, Chip, Popover, BoardSheet, BoardCard, Icon, CardStyle, ButtonGroup, Row, Badge, BadgeTone } from "ds/ds.slint";
import { ExportLine, PaperRow, Exporting } from "export_state.slint";
export { ExportLine, PaperRow, Exporting }

// `FrameFields`: the file name with its extension, then the EXIF the file will carry.
component FrameFields inherits VerticalLayout {
    in property <ExportLine> line;
    in property <int> at;
    spacing: FormStyle.row-gap;
    width: FormStyle.fields-width;
    FormRow {
        label: @tr("Name");
        TextField {
            value: root.line.name;
            suffix: Exporting.extension;
            enabled: root.line.ready;
            edited(t) => { Exporting.edited(root.at, "name", t); }
        }
    }
    FormRow {
        label: @tr("Camera");
        TextField { value: root.line.camera; placeholder: @tr("Leica M6"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "camera", t); } }
    }
    FormRow {
        label: @tr("Lens");
        TextField { value: root.line.lens; placeholder: @tr("Summicron 50 mm"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "lens", t); } }
    }
    FormRow {
        label: @tr("Film");
        Picker {
            value: root.line.film == "" ? @tr("Pick a film…") : root.line.film;
            open => { if (root.line.ready) { Exporting.pick-film(root.at); } }
        }
    }
    FormRow {
        label: @tr("ISO");
        TextField { value: root.line.iso; placeholder: "400"; enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "iso", t); } }
    }
    FormRow {
        label: @tr("Date");
        TextField { value: root.line.date; placeholder: "2026:09:05 10:00:00"; enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "date", t); } }
    }
    FormRow {
        label: @tr("Artist");
        TextField { value: root.line.artist; placeholder: @tr("Your name"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "artist", t); } }
    }
    FormRow {
        label: @tr("Copyright");
        TextField { value: root.line.copyright; placeholder: @tr("© 2026 Your name"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "copyright", t); } }
    }
    Spacer { }
}

// `ExportColumn`: the photographs about to be written, fields left and preview right.
export component ExportColumn inherits Scroller {
    property <length> room-width: self.width - 2 * Space.l;
    property <length> room-height: self.height - 2 * Space.l;
    property <length> picture-width: self.room-width - FormStyle.fields-width - Space.l;
    content-height: max(column.preferred-height, self.height);
    init => { Exporting.preview-room(self.picture-width, self.room-height - FormStyle.caption, FormStyle.preview-floor); }
    changed picture-width => { Exporting.preview-room(self.picture-width, self.room-height - FormStyle.caption, FormStyle.preview-floor); }
    changed room-height => { Exporting.preview-room(self.picture-width, self.room-height - FormStyle.caption, FormStyle.preview-floor); }
    column := VerticalLayout {
        width: root.width;
        height: max(self.preferred-height, root.height);
        padding-top: Space.l;
        padding-bottom: Space.l;
        padding-left: Space.l;
        padding-right: Space.l;
        spacing: Space.l;
        // Centres a single frame under one screenful; above that the floor does nothing.
        alignment: center;
        for line[i] in Exporting.lines: HorizontalLayout {
            spacing: Space.l;
            FrameFields { line: line; at: i; }
            VerticalLayout {
                spacing: Space.xs;
                PreviewSlot {
                    // The height a frame of that shape takes, so the list never jumps; unmeasured takes 3:2's.
                    height: max(FormStyle.preview-floor, min(root.room-height - FormStyle.caption, root.picture-width / (line.aspect > 0 ? line.aspect : 1.5)));
                    source: line.preview;
                    state: line.state;
                }
                if line.caption != "": Label { text: line.caption; role: TextRole.value; tone: Tone.secondary; centred: true; }
            }
        }
    }
}

// The quality slider, its hand held by Rust like every other slider.
component QualitySlider inherits Slider {
    label: @tr("Quality");
    fraction: Exporting.quality-fraction;
    readout: Exporting.quality-readout;
    value-text: Exporting.quality-readout;
    press(f, fine) => { return Exporting.quality-press(fine); }
    drag(f, t, s, fine) => { Exporting.quality-drag(t, s, fine); }
    release(f) => { Exporting.quality-release(); }
    step(f, d) => { Exporting.quality-step(d); }
}

// `ExportSpaceField`: four matrix spaces or an installed ICC profile; the chip shows it compact.
export component SpaceField inherits VerticalLayout {
    in property <bool> compact;
    // Asked before a key opens a window of its own, so a popover holding the field closes first.
    callback dismiss();
    spacing: FormStyle.gap;
    if !root.compact: HorizontalLayout {
        alignment: start;
        if News.space != "": Badge { tone: BadgeTone.seal; text: News.space; note: News.space-note; read => { News.read("space.1.3.1"); } }
    }
    if !root.compact: Field {
        label: @tr("Space");
        help: @tr("The picture is edited in this space and exported in it. Each keeps the name a lab or a printer will ask for. Custom converts into an installed ICC profile, relative colorimetric with black point compensation.");
        Tabs {
            tabs: [@tr("sRGB"), @tr("DP3"), @tr("Adobe RGB"), @tr("ProPhoto"), @tr("Custom")];
            marked: [false, false, false, false, false];
            selected <=> Exporting.space-tab;
            picked(i) => { Exporting.space-picked(i); }
        }
        if Exporting.jpeg && Exporting.space-tab == 3: Label { role: TextRole.note; text: @tr("TIFF 16-bit only: in eight bits so wide a space bands. Choosing it switches the export to TIFF."); }
        Label { role: TextRole.note; text: Exporting.purpose; }
    }
    if root.compact: Tabs {
        tabs: [@tr("sRGB"), @tr("DP3"), @tr("Adobe RGB"), @tr("ProPhoto"), @tr("Custom")];
        marked: [false, false, false, false, false];
        selected <=> Exporting.space-tab;
        picked(i) => { Exporting.space-picked(i); }
    }
    if Exporting.on-profile: Field {
        label: @tr("Profile");
        Picker {
            value: Exporting.profiles[Exporting.profile];
            entries: Exporting.profiles;
            current: Exporting.profile;
            chosen(i) => { Exporting.profile-picked(i); }
        }
        if Exporting.profile-note != "": Label { role: TextRole.note; text: Exporting.profile-note; }
    }
    if Exporting.on-profile && root.compact: FormRow { spread: true;
        label: @tr("Show only color variation (not recommended)");
        Toggle {
            label: @tr("Show only color variation (not recommended)");
            on: Exporting.colour-only;
            toggled(on) => { Exporting.colour-only-set(on); }
        }
    }
    if Exporting.pending: Field {
        label: @tr("Profile");
        Picker {
            value: @tr("Choose a profile…");
            entries: [@tr("Choose a profile…"), @tr("Load a Profile…")];
            current: 0;
            chosen(i) => {
                if (i == 1) { root.dismiss(); }
                Exporting.pending-picked(i);
            }
        }
        Label { role: TextRole.note; text: Exporting.pending-note; }
    }
    if !root.compact || Exporting.on-profile || Exporting.pending: HorizontalLayout {
        spacing: Space.xs;
        Button { text: @tr("Load a Profile…"); horizontal-stretch: 1; clicked => { root.dismiss(); Exporting.load-profile(); } }
        Button { text: @tr("Get Paper Profiles…"); horizontal-stretch: 1; clicked => { root.dismiss(); Exporting.get-papers(); } }
    }
}

// `ExportPanel`: preset plate, rows, what the file will be, the two exits.
export component ExportPanel inherits Surface {
    width: FormStyle.panel-width;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        Scroller {
            vertical-stretch: 1;
            content-height: fields.preferred-height;
            fields := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: Space.m;
                VerticalLayout {
                    spacing: Space.xs;
                    Label { text: @tr("Export"); role: TextRole.heading; }
                    Label { text: Exporting.subtitle; role: TextRole.value; tone: Tone.secondary; wrap: word-wrap; }
                }
                // Three keys, one row: a click writes every row below at once and locks none.
                HorizontalLayout {
                    spacing: Space.xs;
                    Button { text: @tr("Instagram"); horizontal-stretch: 1; clicked => { Exporting.preset(0); } }
                    Button { text: @tr("Display"); horizontal-stretch: 1; clicked => { Exporting.preset(1); } }
                    Button { text: @tr("Print"); horizontal-stretch: 1; clicked => { Exporting.preset(2); } }
                }
                Field {
                    label: @tr("Format");
                    Tabs {
                        tabs: [@tr("TIFF 16-bit"), @tr("JPEG")];
                        marked: [false, false];
                        selected <=> Exporting.format;
                        picked(i) => { Exporting.format-picked(i); }
                    }
                }
                SpaceField { }
                if Exporting.edited-in != "": Label { role: TextRole.note; text: Exporting.edited-in; }
                if Exporting.format == 0: Field {
                    label: @tr("Compression");
                    FormRow { spread: true;
                        label: @tr("ZIP, lossless");
                        Toggle { label: @tr("ZIP, lossless"); on: Exporting.compress; toggled(on) => { Exporting.compress-set(on); } }
                    }
                }
                if Exporting.format == 1: QualitySlider { }
                Field {
                    label: @tr("Size");
                    help: @tr("Pixels of the first photo. The edge you type is the one the ceiling rides on every photo of the batch — the width of a landscape is its long edge. Never enlarged; empty means full resolution.");
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        width-box := TextField { width: FormStyle.size-field;
                            value: Exporting.width-text;
                            placeholder: @tr("W");
                            enabled: Exporting.size-enabled;
                            accepted(t) => { Exporting.size-typed(width-box.text, height-box.text); }
                            left(t) => { Exporting.size-typed(width-box.text, height-box.text); }
                        }
                        Label { text: "×"; role: TextRole.title; tone: Tone.secondary; }
                        height-box := TextField { width: FormStyle.size-field;
                            value: Exporting.height-text;
                            placeholder: @tr("H");
                            enabled: Exporting.size-enabled;
                            accepted(t) => { Exporting.size-typed(width-box.text, height-box.text); }
                            left(t) => { Exporting.size-typed(width-box.text, height-box.text); }
                        }
                        if Exporting.resized: Button { has-icon: true; square: true; icon: Icons.reset; help: @tr("Full resolution"); clicked => { Exporting.full-size(); } }
                    }
                }
                Field {
                    label: @tr("HDR hack");
                    help: @tr("Writes a gain map so HDR screens show the picture up to two stops above the page's white; everyone else sees exactly this picture. Post it uncropped, from a desktop browser at original ratio. JPEG only: no TIFF reader honours a gain map.");
                    FormRow { spread: true;
                        label: @tr("Brighter on HDR screens");
                        Toggle { label: @tr("Brighter on HDR screens"); on: Exporting.hdr; enabled: Exporting.format == 1; toggled(on) => { Exporting.hdr-set(on); } }
                    }
                }
                SummaryBox {
                    HorizontalLayout {
                        Label { text: Exporting.bits; role: TextRole.value; horizontal-stretch: 1; }
                        Label { text: Exporting.dims; role: TextRole.value; }
                    }
                    HorizontalLayout {
                        Label { text: Exporting.weight-label; role: TextRole.value; horizontal-stretch: 1; }
                        Label { text: Exporting.weight; role: TextRole.value; }
                    }
                    if Exporting.low-precision != "": Label { role: TextRole.note; tone: Tone.warning; text: Exporting.low-precision; }
                    Label { role: TextRole.note; text: @tr("EXIF as set beside each photo; nothing of the scanner unless left there"); }
                }
            }
        }
        // Cancel and Export, the confirm at the right; mid-batch Cancel stops after the current file.
        HorizontalLayout {
            spacing: Space.xs;
            Button { text: Exporting.exporting ? @tr("Stop") : @tr("Cancel"); horizontal-stretch: 1; clicked => { Exporting.cancel(); } }
            Button {
                text: Exporting.exporting ? @tr("Exporting…") : Exporting.key-title;
                kind: ButtonKind.accent;
                horizontal-stretch: 1;
                enabled: Exporting.can-export && !Exporting.exporting;
                clicked => { Exporting.export(); }
            }
        }
    }
}

// The Working Space chip at the canvas's top edge, opening the compact space field.
export component SpaceChip inherits Chip {
    title: Exporting.chip-title;
    hint: Exporting.chip-hint;
    help: @tr("The color space the picture is edited and exported in");
    clicked => { chooser.show(); }
    chooser := Popover {
        x: (root.width - FormStyle.panel-width) / 2;
        y: root.height;
        Label { text: @tr("Working Space"); role: TextRole.section; }
        SpaceField { compact: true; dismiss => { chooser.close(); } }
    }
}

// The batch's clash: Return reaches no key, since replacing files is never a stray key's doing.
export component ExportConfirmSheet inherits Sheet {
    title: Exporting.confirm-title;
    question: true;
    dismissed => { Exporting.confirmed(false); }
    if Exporting.confirm-message != "": Label { text: Exporting.confirm-message; tone: Tone.secondary; wrap: word-wrap; }
    ButtonGroup { plate: true; trailing: true;
        Button { text: @tr("Cancel"); clicked => { Exporting.confirmed(false); } }
        Button { text: @tr("Replace"); kind: ButtonKind.destructive; clicked => { Exporting.confirmed(true); } }
    }
}

// `DSDialogRequest.notice`: its one key the default, Return included.
export component ExportNoticeSheet inherits Sheet {
    title: Exporting.notice-title;
    question: true;
    dismissed => { Exporting.notice-closed(); }
    if Exporting.notice-message != "": Label { text: Exporting.notice-message; tone: Tone.secondary; wrap: word-wrap; }
    ButtonGroup { plate: true; trailing: true;
        Button { text: @tr("OK"); kind: ButtonKind.accent; clicked => { Exporting.notice-closed(); } }
    }
}

// `PaperProfilesSheet`: the makers in a sidebar, what the chosen one offers in a card.
export component PaperSheet inherits BoardSheet {
    title: @tr("Paper Profiles");
    dismissed => { Exporting.papers-done(); }
    Scroller {
        width: FormStyle.paper-list;
        content-height: makers.preferred-height;
        makers := VerticalLayout {
            padding-top: CardStyle.inset; padding-left: Space.s;
            padding-right: Space.s;
            padding-bottom: Space.m;
            spacing: Space.m;
            alignment: start;
            VerticalLayout {
                HorizontalLayout { padding-left: RowStyle.padding; Label { tone: Tone.tertiary; text: @tr("DOWNLOAD HERE"); } }
                for name[i] in Exporting.paper-direct: Row {
                    title: name;
                    selected: i == Exporting.paper-source;
                    clicked => { Exporting.paper-picked(i); }
                    glyph: Icons.archive;
                    has-glyph: true;
                }
            }
            VerticalLayout {
                HorizontalLayout { padding-left: RowStyle.padding; Label { tone: Tone.tertiary; text: @tr("ON THE MAKER’S SITE"); } }
                for name[i] in Exporting.paper-browsed: Row {
                    title: name;
                    selected: i + Exporting.paper-direct-count == Exporting.paper-source;
                    clicked => { Exporting.paper-picked(i + Exporting.paper-direct-count); }
                    glyph: Icons.arrow-right;
                    has-glyph: true;
                }
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        padding-top: CardStyle.inset; padding-right: CardStyle.inset;
        padding-bottom: CardStyle.inset;
        BoardCard {
            vertical-stretch: 1;
            Label { text: Exporting.paper-name; role: TextRole.heading; }
            Label { role: TextRole.note; text: Exporting.paper-note; }
            HorizontalLayout {
                alignment: start;
                Button { text: @tr("Open the Maker’s Page"); clicked => { Exporting.paper-open-page(); } }
            }
            if Exporting.paper-browser: Label { role: TextRole.note;
                text: @tr("Download the profile for your printer and paper on the page, then choose Load a Profile… and pick the file you downloaded, zipped or not.");
            }
            if !Exporting.paper-browser && Exporting.paper-reading: Label { role: TextRole.note; text: @tr("Reading the maker’s page…"); }
            if !Exporting.paper-browser && !Exporting.paper-reading && !Exporting.paper-any: Label { role: TextRole.note;
                text: @tr("The page lists no profile right now. Open it to look by hand.");
            }
            if !Exporting.paper-browser && !Exporting.paper-reading && Exporting.paper-any: TextField {
                value: Exporting.paper-filter;
                placeholder: @tr("Filter, e.g. P900 matte");
                edited(t) => { Exporting.paper-filter-typed(t); }
            }
            if !Exporting.paper-browser && !Exporting.paper-reading && Exporting.paper-any: ListView {
                vertical-stretch: 1;
                // As tall installing as with its key, so the list never jumps.
                for row[i] in Exporting.paper-rows: HorizontalLayout {
                    spacing: Space.s;
                    padding-top: Space.xs;
                    padding-bottom: Space.xs; min-height: ButtonStyle.height + 2 * Space.xs;
                    Label { text: row.title; tone: Tone.secondary; overflow: elide; horizontal-stretch: 1; }
                    if row.installing: Label { role: TextRole.note; text: @tr("Installing…"); }
                    if !row.installing && row.installed: Button {
                        text: @tr("Uninstall");
                        kind: ButtonKind.destructive;
                        enabled: !Exporting.paper-busy;
                        clicked => { Exporting.paper-uninstall(i); }
                    }
                    if !row.installing && !row.installed: Button {
                        text: @tr("Install");
                        enabled: !Exporting.paper-busy;
                        clicked => { Exporting.paper-install(i); }
                    }
                }
            }
            if Exporting.paper-message != "": Label { role: TextRole.note; text: Exporting.paper-message; }
        }
    }
}
