// Export as a mode of the card: one line per photo with its preview, the settings column on the right,
// the space field shared with the Working Space chip, and the dialogs the export raises.
import { News } from "help.slint";
import { Icons, Space, Depth, ButtonStyle, Label, Tone, TextRole, Button, ButtonKind, Tabs, Toggle, Slider, TextField, Picker, Section, Sheet, Divider, Spacer, Surface, Scroller, ListView, HStack, VStack, Gap, ShellStyle, FormStyle, Field, Inset, PreviewSlot, PickerFace, PopupPanel, SheetHeader, AskSheet, AskRole, Icon, CardStyle, ButtonGroup, GroupAlign, Row, Badge, BadgeTone, FieldLayout, RowKind, RowForm, SizeFields, ButtonSize, Picture, Ground, Fit, EdgePrint, FieldStyle } from "ds/ds.slint";
import { ExportLine, PaperRow, SheetTile, Exporting } from "export_state.slint";
import { Canvas } from "canvas_state.slint";
export { ExportLine, PaperRow, SheetTile, Exporting }

// `FrameFields`: the file name with its extension, then the EXIF the file will carry, in two columns
// of four under the picture.
component FrameFields inherits HorizontalLayout {
    in property <ExportLine> line;
    in property <int> at;
    in property <length> column;
    spacing: Space.l;
    VerticalLayout {
        width: root.column;
        spacing: FormStyle.row-gap;
        Field { layout: FieldLayout.column;
            label: @tr("Name");
            TextField {
                name: @tr("Name");
                value: root.line.name;
                suffix: Exporting.extension;
                enabled: root.line.ready;
                edited(t) => { Exporting.edited(root.at, "name", t); }
            }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Camera");
            TextField { name: @tr("Camera"); value: root.line.camera; placeholder: @tr("Leica M6"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "camera", t); } }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Lens");
            TextField { name: @tr("Lens"); value: root.line.lens; placeholder: @tr("Summicron 50 mm"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "lens", t); } }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Film stock");
            Picker {
                value: root.line.film == "" ? @tr("Choose…") : root.line.film;
                open => { if (root.line.ready) { Exporting.pick-film(root.at); } }
            }
        }
    }
    VerticalLayout {
        width: root.column;
        spacing: FormStyle.row-gap;
        Field { layout: FieldLayout.column;
            label: @tr("ISO");
            TextField { name: @tr("ISO"); value: root.line.iso; placeholder: "400"; enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "iso", t); } }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Date");
            TextField { name: @tr("Date"); value: root.line.date; placeholder: "2026:09:05 10:00:00"; enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "date", t); } }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Artist");
            TextField { name: @tr("Artist"); value: root.line.artist; placeholder: @tr("Your name"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "artist", t); } }
        }
        Field { layout: FieldLayout.column;
            label: @tr("Copyright");
            TextField { name: @tr("Copyright"); value: root.line.copyright; placeholder: @tr("© 2026 Your name"); enabled: root.line.ready; edited(t) => { Exporting.edited(root.at, "copyright", t); } }
        }
    }
}

// The contact sheet the export writes, as Rust fits it to this room: its ground, each frame's
// preview at its place with its number under it, and the logo's band.
component SheetPreview inherits Rectangle {
    init => { Exporting.sheet-room(self.width, self.height); }
    changed width => { Exporting.sheet-room(self.width, self.height); }
    changed height => { Exporting.sheet-room(self.width, self.height); }
    Picture {
        x: Exporting.sheet-ground.x;
        y: Exporting.sheet-ground.y;
        width: Exporting.sheet-ground.width;
        height: Exporting.sheet-ground.height;
        ground: Ground.sheet;
    }
    for t in Exporting.sheet-tiles: Picture { x: t.x; y: t.y; width: t.width; height: t.height; source: t.preview; fit: Fit.fill; ground: Ground.sheet; }
    for t in Exporting.sheet-tiles: EdgePrint {
        x: t.x;
        y: t.y + t.height;
        height: Exporting.sheet-number-band;
        text: t.number;
        size: Exporting.sheet-number-size;
        ink: Canvas.inks.number;
    }
    Picture {
        x: Exporting.sheet-logo-box.x;
        y: Exporting.sheet-logo-box.y;
        width: Exporting.sheet-logo-box.width;
        height: Exporting.sheet-logo-box.height;
        ground: Ground.sheet;
        fit: Fit.fill;
        source: Exporting.sheet-logo;
    }
}

// `ExportColumn`: the photographs about to be written, each preview over its caption and its fields.
export component ExportColumn inherits Scroller {
    property <length> room-width: self.width - 2 * Space.l;
    property <length> room-height: self.height - 2 * Space.l;
    // `FrameFields`' four rows, after a gap under the caption.
    property <length> fields-height: Space.s + 4 * FieldStyle.height + 3 * FormStyle.row-gap;
    // A lone photo fills the room: what its caption and its fields leave of the height.
    property <length> picture-height: self.room-height - FormStyle.caption - self.fields-height;
    // Several photos on one sheet: the sheet itself in place of their lines.
    property <bool> sheet: Exporting.sheet && Exporting.count > 1;
    content-height: column.preferred-height;
    init => { Exporting.preview-room(self.room-width, self.picture-height, FormStyle.preview-floor); }
    changed room-width => { Exporting.preview-room(self.room-width, self.picture-height, FormStyle.preview-floor); }
    changed picture-height => { Exporting.preview-room(self.room-width, self.picture-height, FormStyle.preview-floor); }
    // From the top, level with the panel's title, however few photos the column holds.
    column := VerticalLayout {
        width: root.width;
        alignment: start;
        padding-top: Space.l;
        padding-bottom: Space.l;
        padding-left: Space.l;
        padding-right: Space.l;
        spacing: Space.l;
        if root.sheet: SheetPreview { height: root.room-height; }
        if !root.sheet: VerticalLayout {
            spacing: Space.l;
            for line[i] in Exporting.lines: VerticalLayout {
                PreviewSlot {
                    // The height a frame of that shape takes, so the list never jumps; unmeasured takes 3:2's.
                    height: max(FormStyle.preview-floor, min(root.picture-height, root.room-width / (line.aspect > 0 ? line.aspect : 1.5)));
                    source: line.preview;
                    state: line.state;
                }
                // As tall before the size lands as after.
                Label { height: FormStyle.caption; text: line.caption; role: TextRole.value; tone: Tone.secondary; centred: true; }
                FrameFields { line: line; at: i; column: (root.room-width - Space.l) / 2; padding-top: Space.s; }
            }
        }
    }
}


// The quality slider, its hand held by Rust like every other slider.
component QualitySlider inherits Slider {
    label: @tr("Quality");
    fraction: Exporting.quality-fraction;
    readout: Exporting.quality-readout;
    value-text: Exporting.quality-readout;
    press(f, fine) => { return Exporting.quality-press(fine); }
    drag(f, t, s, fine) => { Exporting.quality-drag(t, s, fine); }
    release(f) => { Exporting.quality-release(); }
    scroll(f, dx, dy, s, fine) => { return Exporting.quality-scroll(dx, dy, s, fine); }
    step(f, d) => { Exporting.quality-step(d); }
}

// `ExportSpaceField`: four matrix spaces or an installed ICC profile; the chip shows it compact.
export component SpaceField inherits VerticalLayout {
    in property <bool> compact;
    // Asked before a key opens a window of its own, so a popover holding the field closes first.
    callback dismiss();
    spacing: FormStyle.gap;
    if !root.compact: HorizontalLayout {
        alignment: start;
        if News.space != "": Badge { tone: BadgeTone.seal; text: News.space; note: News.space-note; read => { News.read("space.1.3.1"); } }
    }
    if !root.compact: Field {
        label: @tr("Space");
        help: @tr("The picture is edited in this space and exported in it. Each keeps the name a lab or a printer will ask for. Custom converts into an installed ICC profile, relative colorimetric with black point compensation.");
        Tabs {
            tabs: [@tr("sRGB"), @tr("P3"), @tr("Adobe RGB"), @tr("ProPhoto"), @tr("Custom")];
            dimmed: [false, false, false, Exporting.jpeg, false];
            selected: Exporting.space-tab;
            picked(i) => { Exporting.space-tab = i; Exporting.space-picked(i); }
        }
        if Exporting.jpeg && Exporting.space-tab == 3: Label { role: TextRole.note; text: @tr("TIFF 16-bit only: in eight bits so wide a space bands. Choosing it switches the export to TIFF."); }
        Label { role: TextRole.note; text: Exporting.purpose; }
    }
    if root.compact: Tabs {
        tabs: [@tr("sRGB"), @tr("P3"), @tr("Adobe RGB"), @tr("ProPhoto"), @tr("Custom")];
        dimmed: [false, false, false, Exporting.jpeg, false];
        selected: Exporting.space-tab;
        picked(i) => { Exporting.space-tab = i; Exporting.space-picked(i); }
    }
    if Exporting.on-profile: Field {
        label: @tr("Profile");
        Picker {
            value: Exporting.profiles[Exporting.profile];
            entries: Exporting.profiles;
            current: Exporting.profile;
            chosen(i) => { Exporting.profile-picked(i); }
        }
        if Exporting.profile-note != "": Label { role: TextRole.note; text: Exporting.profile-note; }
    }
    if Exporting.on-profile && root.compact: Toggle {
        label: @tr("Show only colour variation (not recommended)");
        wrap: true;
        on: Exporting.colour-only;
        toggled(on) => { Exporting.colour-only-set(on); }
    }
    if Exporting.pending: Field {
        label: @tr("Profile");
        Picker {
            value: @tr("Choose a profile…");
            entries: [@tr("Choose a profile…"), @tr("Load a Profile…")];
            current: 0;
            chosen(i) => {
                if (i == 1) { root.dismiss(); }
                Exporting.pending-picked(i);
            }
        }
        Label { role: TextRole.note; text: Exporting.pending-note; }
    }
    if !root.compact || Exporting.on-profile || Exporting.pending: ButtonGroup {
        plate: true;
        align: GroupAlign.fill;
        Button { size: ButtonSize.plate; text: @tr("Load a Profile…"); fills: true; clicked => { root.dismiss(); Exporting.load-profile(); } }
        Button { size: ButtonSize.plate; text: @tr("Get Paper Profiles…"); fills: true; clicked => { root.dismiss(); Exporting.get-papers(); } }
    }
}

// `ExportPanel`: preset plate, rows, what the file will be, the two exits.
export component ExportPanel inherits Surface {
    width: FormStyle.panel-width;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        Scroller {
            vertical-stretch: 1;
            content-height: fields.preferred-height;
            fields := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: Space.m;
                // The summary's well ends the column: its lip keeps its room at the scroll's end.
                padding-bottom: Depth.lip-reach;
                VerticalLayout {
                    spacing: Space.xs;
                    Label { text: @tr("Export"); role: TextRole.heading; }
                    Label { text: Exporting.subtitle; role: TextRole.value; tone: Tone.secondary; wrap: word-wrap; }
                }
                // First, the one place the choice is made: every photo its own file, or all on one sheet.
                if Exporting.count > 1: Field {
                    label: @tr("Export as");
                    help: @tr("Writes one file, the sheet the editor shows the photos on together: five to a row on black, numbered in orange by their place on their roll, the logo under them from five photos.");
                    Tabs {
                        tabs: [@tr("Separate Photos"), @tr("Contact Sheet")];
                        marked: [false, false];
                        selected: Exporting.sheet ? 1 : 0;
                        picked(i) => { Exporting.sheet-set(i == 1); }
                    }
                }
                // Three keys, one row: a click writes every row below at once and locks none.
                ButtonGroup {
                    plate: true;
                    align: GroupAlign.fill;
                    Button { size: ButtonSize.plate; text: @tr("Instagram"); fills: true; clicked => { Exporting.preset(0); } }
                    Button { size: ButtonSize.plate; text: @tr("Display"); fills: true; clicked => { Exporting.preset(1); } }
                    Button { size: ButtonSize.plate; text: @tr("Print"); fills: true; clicked => { Exporting.preset(2); } }
                }
                Field {
                    label: @tr("Format");
                    Tabs {
                        tabs: [@tr("TIFF 16-bit"), @tr("JPEG")];
                        marked: [false, false];
                        selected: Exporting.format;
                        picked(i) => { Exporting.format = i; Exporting.format-picked(i); }
                    }
                }
                SpaceField { }
                if Exporting.edited-in != "": Label { role: TextRole.note; text: Exporting.edited-in; }
                if Exporting.format == 0: Field {
                    label: @tr("Compression");
                    Toggle { label: @tr("ZIP, lossless"); on: Exporting.compress; toggled(on) => { Exporting.compress-set(on); } }
                }
                if Exporting.format == 1: QualitySlider { }
                Field {
                    label: @tr("Size");
                    help: Exporting.sheet
                        ? @tr("Pixels of the whole sheet. Never enlarged; empty means full resolution.")
                        : @tr("Pixels of the first photo. The edge you type is the one the ceiling rides on every photo of the batch — the width of a landscape is its long edge. Never enlarged; empty means full resolution.");
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        SizeFields {
                            width-value: Exporting.width-text;
                            height-value: Exporting.height-text;
                            enabled: Exporting.size-enabled;
                            typed(w, h) => { Exporting.size-typed(w, h); }
                        }
                        if Exporting.resized: Button { has-icon: true; square: true; icon: Icons.reset; help: @tr("Full Resolution"); clicked => { Exporting.full-size(); } }
                    }
                }
                Field {
                    label: @tr("HDR");
                    help: @tr("Writes a gain map so HDR screens show the picture up to two stops above the page's white; everyone else sees exactly this picture. Post it uncropped, from a desktop browser at original ratio. JPEG only: no TIFF reader honours a gain map.");
                    Toggle { label: @tr("Brighter on HDR screens"); on: Exporting.hdr; enabled: Exporting.format == 1; toggled(on) => { Exporting.hdr-set(on); } }
                }
                Inset {
                    HorizontalLayout {
                        Label { text: Exporting.bits; role: TextRole.value; horizontal-stretch: 1; }
                        Label { text: Exporting.dims; role: TextRole.value; }
                    }
                    HorizontalLayout {
                        Label { text: Exporting.weight-label; role: TextRole.value; horizontal-stretch: 1; }
                        Label { text: Exporting.weight; role: TextRole.value; }
                    }
                    if Exporting.low-precision != "": Label { role: TextRole.note; tone: Tone.warning; text: Exporting.low-precision; }
                    Label { role: TextRole.note; text: @tr("EXIF as set beside each photo; nothing of the scanner unless left there"); }
                }
            }
        }
        // Cancel and Export on one plate, the confirm taking the rest; an export under way is stopped from its card.
        ButtonGroup {
            plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: @tr("Cancel"); clicked => { Exporting.cancel(); } }
            // `DSActionButton`: its title as given, the busy one in its own case.
            Button {
                size: ButtonSize.plate;
                text: Exporting.exporting ? @tr("Exporting…") : Exporting.key-title;
                keycap: true;
                capitals: false;
                kind: ButtonKind.accent;
                fills: true;
                enabled: Exporting.can-export && !Exporting.exporting;
                clicked => { Exporting.export(); }
            }
        }
    }
}

// The Working Space chip at the canvas's top edge, opening the compact space field.
export component SpaceChip inherits Picker {
    face: PickerFace.chip;
    prefix: Exporting.chip-title;
    value: Exporting.chip-hint;
    help: @tr("The colour space the picture is edited and exported in");
    own-popup: chooser.is-open;
    open => { chooser.show(); }
    chooser := PopupPanel {
        x: (root.width - FormStyle.panel-width) / 2;
        y: root.height;
        Label { text: @tr("Working Space"); role: TextRole.section; }
        SpaceField { compact: true; dismiss => { chooser.close(); } }
    }
}

// The clash: Replace for earlier exports alone, deaf to Return; Rename for an original.
export component ExportConfirmSheet inherits AskSheet {
    title: Exporting.confirm-title;
    message: Exporting.confirm-message;
    cancel: @tr("Cancel");
    keys: Exporting.confirm-replaces ? [{ text: @tr("Replace"), role: AskRole.destructive }] : [{ text: @tr("Rename"), role: AskRole.confirm }];
    answered(i) => { Exporting.confirmed(i == 0); }
}

// `DSDialogRequest.notice`: its one key the default, Return included.
export component ExportNoticeSheet inherits AskSheet {
    title: Exporting.notice-title;
    message: Exporting.notice-message;
    keys: [{ text: @tr("OK"), role: AskRole.confirm }];
    answered => { Exporting.notice-closed(); }
}
