// Export as a mode of the card: one line per photo with its preview, the settings column on the right,
// the colour space shared with the canvas's chip, and the dialogs the export raises.
import { News } from "help.slint";
import { Icons, Space, ButtonStyle, Label, Engraved, Tone, TextRole, Button, ButtonKind, ButtonSize, Tabs, Toggle, Slider, TextField, Picker, Section, Sheet, Divider, Spacer, Surface, Scroller, ListView, HStack, VStack, Gap, ShellStyle, FormStyle, Field, LcdReadout, PreviewSlot, PickerFace, PopupPanel, SheetHeader, AskSheet, AskRole, Icon, CardStyle, ButtonGroup, GroupAlign, Row, Badge, BadgeTone, FieldLayout, RowKind, RowForm, SizeFields, Picture, Ground, Fit, EdgePrint, SheetFooter, SteadyNote, KnownField } from "ds/ds.slint";
import { FrameFields, FrameName } from "export_fields.slint";
import { ExportLine, PaperRow, SheetTile, Exporting } from "export_state.slint";
import { PresetPicker, PresetNameSheet } from "export_presets.slint";
import { Canvas } from "canvas_state.slint";
export { ExportLine, PaperRow, SheetTile, Exporting, PresetNameSheet }

// The contact sheet the export writes, as Rust fits it to this room: its ground, each frame's
// preview at its place with its number under it, and the logo's band.
component SheetPreview inherits Rectangle {
    init => { Exporting.sheet-room(self.width, self.height); }
    changed width => { Exporting.sheet-room(self.width, self.height); }
    changed height => { Exporting.sheet-room(self.width, self.height); }
    Picture {
        x: Exporting.sheet-ground.x;
        y: Exporting.sheet-ground.y;
        width: Exporting.sheet-ground.width;
        height: Exporting.sheet-ground.height;
        ground: Ground.sheet;
    }
    for t in Exporting.sheet-tiles: Picture { x: t.x; y: t.y; width: t.width; height: t.height; source: t.preview; fit: Fit.fill; ground: Ground.sheet; }
    for t in Exporting.sheet-tiles: EdgePrint {
        x: t.x;
        y: t.y + t.height;
        height: Exporting.sheet-number-band;
        text: t.number;
        size: Exporting.sheet-number-size;
        ink: Canvas.inks.number;
    }
    Picture {
        x: Exporting.sheet-logo-box.x;
        y: Exporting.sheet-logo-box.y;
        width: Exporting.sheet-logo-box.width;
        height: Exporting.sheet-logo-box.height;
        ground: Ground.sheet;
        fit: Fit.fill;
        source: Exporting.sheet-logo;
    }
}

// `ExportColumn`: the photographs about to be written, each line the EXIF's key or, open, its card, then
// its preview over its name and its caption.
export component ExportColumn inherits Scroller {
    property <length> room-width: self.width - 2 * Space.l;
    property <length> room-height: self.height - 2 * Space.l;
    // What the EXIF's key or, open, its card leave of the width.
    property <length> picture-width: self.room-width - (Exporting.exif-shown ? FormStyle.fields-width : ButtonStyle.small-height) - Space.m;
    // A lone photo fills the room: what its name's row leaves of the height.
    property <length> picture-height: self.room-height - FormStyle.name-row - Space.s;
    // Several photos on one sheet: the sheet itself in place of their lines.
    property <bool> sheet: Exporting.sheet && Exporting.count > 1;
    property <bool> lone: !root.sheet && Exporting.count == 1;
    content-height: column.height;
    init => { Exporting.preview-room(self.picture-width, self.picture-height, FormStyle.preview-floor); }
    changed picture-width => { Exporting.preview-room(self.picture-width, self.picture-height, FormStyle.preview-floor); }
    changed picture-height => { Exporting.preview-room(self.picture-width, self.picture-height, FormStyle.preview-floor); }
    // A lone photo stands in the middle of the room; several start from the top, level with the panel's title.
    column := VerticalLayout {
        width: root.width;
        height: max(root.height, self.preferred-height);
        alignment: root.lone ? center : start;
        padding-top: Space.l;
        padding-bottom: Space.l;
        padding-left: Space.l;
        padding-right: Space.l;
        spacing: Space.l;
        if root.sheet: SheetPreview { height: root.room-height; }
        if !root.sheet: VerticalLayout {
            spacing: Space.l;
            for line[i] in Exporting.lines: HorizontalLayout {
                spacing: Space.m;
                // Left of the picture, the EXIF's key opens the card on every line at once, its cross folds it.
                if !Exporting.exif-shown: VerticalLayout {
                    alignment: start;
                    Button { has-icon: true; square: true;
                        size: ButtonSize.mini;
                        icon: Icons.exif;
                        help: @tr("Show the EXIF");
                        clicked => { Exporting.exif-shown = true; }
                    }
                }
                if Exporting.exif-shown: FrameFields { line: line; at: i; }
                picture := VerticalLayout {
                    // The frame's shape, unmeasured taken as 3:2's; the height it takes, so the list never
                    // jumps; the width it shows at, centred in the room.
                    property <float> aspect: line.aspect > 0 ? line.aspect : 1.5;
                    property <length> tall: max(FormStyle.preview-floor, min(root.picture-height, root.picture-width / self.aspect));
                    property <length> shown: min(root.picture-width, self.tall * self.aspect);
                    alignment: start;
                    spacing: Space.s;
                    PreviewSlot {
                        height: picture.tall;
                        source: line.preview;
                        state: line.state;
                    }
                    // Under the picture itself: a frame narrower than the room stands in its middle.
                    HorizontalLayout {
                        padding-left: (root.picture-width - picture.shown) / 2;
                        padding-right: (root.picture-width - picture.shown) / 2;
                        spacing: Space.m;
                        height: FormStyle.name-row;
                        cross-axis-alignment: center;
                        FrameName { line: line; at: i; width: min(FormStyle.fields-width, picture.shown); }
                        // As tall before the size lands as after.
                        Label { horizontal-stretch: 1; height: FormStyle.caption; text: line.caption; role: TextRole.value; tone: Tone.secondary; centred: true; }
                    }
                }
            }
        }
    }
}


// The quality slider, its hand held by Rust like every other slider.
component QualitySlider inherits Slider {
    label: @tr("Quality");
    fraction: Exporting.quality-fraction;
    readout: Exporting.quality-readout;
    value-text: Exporting.quality-readout;
    press(f, fine) => { return Exporting.quality-press(fine); }
    drag(f, t, s, fine) => { Exporting.quality-drag(t, s, fine); }
    release(f) => { Exporting.quality-release(); }
    scroll(f, dx, dy, s, fine) => { return Exporting.quality-scroll(dx, dy, s, fine); }
    step(f, d) => { Exporting.quality-step(d); }
}

// The four matrix spaces and Custom, an installed ICC profile, as the panel and the chip offer them.
component SpaceTabs inherits Tabs {
    tabs: [@tr("sRGB"), @tr("P3"), @tr("Adobe RGB"), @tr("ProPhoto"), @tr("Custom")];
    selected: Exporting.space-tab;
    picked(i) => { Exporting.space-tab = i; Exporting.space-picked(i); }
}

// The space's note in a room fitted to every note it may say, so a tab or a preset never moves what follows.
component SpaceNote inherits SteadyNote {
    text: Exporting.space-note;
    notes: Exporting.space-notes;
}

// `ExportSpaceField`'s profile, always laid so no preset moves a row: Custom's, the choice still to make,
// or the built-in space's out of reach; then the keys that load or fetch one, and the chip's switch.
component SpaceField inherits VerticalLayout {
    in property <bool> chip;
    // Asked before a key opens a window of its own, so a popover holding the field closes first.
    callback dismiss();
    spacing: FormStyle.gap;
    // Shown only where it can change: a space that names its own profile shows none.
    if Exporting.on-profile || Exporting.pending: Field {
        label: @tr("Profile");
        Picker {
            value: Exporting.on-profile ? Exporting.profiles[Exporting.profile] : Exporting.pending ? @tr("Choose a profile…") : Exporting.chip-title;
            entries: Exporting.on-profile ? Exporting.profiles : Exporting.pending ? [@tr("Choose a profile…"), @tr("Load a Profile…")] : [];
            current: Exporting.on-profile ? Exporting.profile : 0;
            chosen(i) => {
                if (Exporting.on-profile) {
                    Exporting.profile-picked(i);
                } else {
                    if (i == 1) { root.dismiss(); }
                    Exporting.pending-picked(i);
                }
            }
        }
    }
    if Exporting.on-profile && root.chip: Toggle {
        label: @tr("Show only colour variation (not recommended)");
        wrap: true;
        on: Exporting.colour-only;
        toggled(on) => { Exporting.colour-only-set(on); }
    }
    ButtonGroup {
        align: GroupAlign.fill;
        Button { text: @tr("Load a Profile…"); fills: true; clicked => { root.dismiss(); Exporting.load-profile(); } }
        Button { text: @tr("Get Paper Profiles…"); fills: true; clicked => { root.dismiss(); Exporting.get-papers(); } }
    }
}

// `ExportPanel`: presets, rows, what the file will be, the two exits.
export component ExportPanel inherits Surface {
    width: FormStyle.panel-width;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        Scroller {
            vertical-stretch: 1;
            content-height: fields.preferred-height;
            fields := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: Space.m;
                VerticalLayout {
                    spacing: Space.xs;
                    Engraved { text: @tr("Export"); role: TextRole.section; }
                    Label { text: Exporting.subtitle; role: TextRole.note; }
                }
                // First, the one place the choice is made: every photo its own file, or all on one sheet.
                if Exporting.count > 1: Field {
                    label: @tr("Export as");
                    help: @tr("Writes one file, the sheet the editor shows the photos on together: five to a row on black, numbered in orange by their place on their roll, the logo under them from five photos.");
                    Tabs {
                        tabs: [@tr("Separate Photos"), @tr("Contact Sheet")];
                        marked: [false, false];
                        selected: Exporting.sheet ? 1 : 0;
                        picked(i) => { Exporting.sheet-set(i == 1); }
                    }
                }
                // Shortcuts, not a choice to make: each writes every row below at once and locks none,
                // and the picker names the one the rows equal.
                Field {
                    label: @tr("Presets");
                    help: @tr("Each fills every setting below at once, all of them still yours to change; the picker names the one the settings equal. Save as Preset… keeps the settings as they stand under a name of your own, which the list then renames or removes.");
                    PresetPicker { }
                }
                Field {
                    label: @tr("Format");
                    Tabs {
                        tabs: [@tr("TIFF 16-bit"), @tr("JPEG")];
                        marked: [false, false];
                        selected: Exporting.format;
                        picked(i) => { Exporting.format = i; Exporting.format-picked(i); }
                    }
                }
                if News.space != "": HorizontalLayout {
                    alignment: start;
                    Badge { tone: BadgeTone.seal; text: News.space; note: News.space-note; read => { News.read("space.1.3.1"); } }
                }
                // No note stands in a block shown on a condition: Slint 1.18 sizes such a block with its
                // wrapped words on one line, and what it draws past that runs over the next group.
                Field {
                    label: @tr("Colour space");
                    help: @tr("Shared by the canvas and the export: the canvas shows the picture in this space and the export writes it. Each keeps the name a lab or a printer will ask for. Custom converts into an installed ICC profile, relative colorimetric with black point compensation.");
                    SpaceTabs { }
                    SpaceNote { }
                }
                SpaceField { }
                SteadyNote { text: Exporting.edited-in; notes: Exporting.edited-notes; }
                // The format's own row, Compression's field as tall as Quality's slider, so a format
                // changed by a preset moves no row under it.
                if Exporting.format == 0: Field {
                    label: @tr("Compression");
                    Toggle { label: @tr("ZIP, lossless"); on: Exporting.compress; toggled(on) => { Exporting.compress-set(on); } }
                }
                if Exporting.format == 1: QualitySlider { }
                Field {
                    label: @tr("Size");
                    help: Exporting.sheet
                        ? @tr("Pixels of the whole sheet. Never enlarged; empty means full resolution.")
                        : @tr("Pixels of the first photo. The edge you type is the one the ceiling rides on every photo of the batch — the width of a landscape is its long edge. Never enlarged; empty means full resolution.");
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        SizeFields {
                            width-value: Exporting.width-text;
                            height-value: Exporting.height-text;
                            enabled: Exporting.size-enabled;
                            typed(w, h) => { Exporting.size-typed(w, h); }
                        }
                        if Exporting.resized: Button { has-icon: true; square: true; icon: Icons.reset; help: @tr("Full Resolution"); clicked => { Exporting.full-size(); } }
                    }
                }
                Field {
                    label: @tr("HDR");
                    help: @tr("Writes a gain map so HDR screens show the picture up to two stops above the page's white; everyone else sees exactly this picture. Post it uncropped, from a desktop browser at original ratio. JPEG only: no TIFF reader honours a gain map.");
                    Toggle { label: @tr("Brighter on HDR screens"); on: Exporting.hdr; enabled: Exporting.format == 1; toggled(on) => { Exporting.hdr-set(on); } }
                }
                // What the file will be, one fact a row, its figures on the glass the crop's kept size reads on.
                VerticalLayout {
                    spacing: FormStyle.row-gap;
                    Field { layout: FieldLayout.spread; label: @tr("Pixels"); LcdReadout { text: Exporting.dims; } }
                    Field { layout: FieldLayout.spread; label: @tr("Bit depth"); LcdReadout { text: Exporting.bits; } }
                    Field { layout: FieldLayout.spread; label: Exporting.weight-label; LcdReadout { text: Exporting.weight; } }
                    if Exporting.low-precision != "": Label { role: TextRole.note; tone: Tone.warning; text: Exporting.low-precision; }
                    Label { role: TextRole.note; text: @tr("EXIF as set beside each photo; nothing of the scanner unless left there"); }
                }
            }
        }
        // An export under way is stopped from its card.
        SheetFooter {
            default-commit: false;
            cancel: @tr("Cancel");
            commit: Exporting.exporting ? @tr("Exporting…") : Exporting.key-title;
            commit-enabled: Exporting.can-export && !Exporting.exporting;
            cancelled => { Exporting.cancel(); }
            committed => { Exporting.export(); }
        }
    }
}

// The colour space's chip at the canvas's top edge: its popover, named as the panel's field and saying
// the export shares the choice, holds the space's tabs, its note and its profile.
export component SpaceChip inherits Picker {
    face: PickerFace.chip;
    value: Exporting.chip-title;
    note: Exporting.chip-hint;
    help: @tr("Colour space, shared by the canvas and the export");
    own-popup: chooser.is-open;
    open => { chooser.show(); }
    chooser := PopupPanel {
        x: (root.width - FormStyle.panel-width) / 2;
        y: root.height;
        VerticalLayout {
            spacing: Space.xs;
            Label { text: @tr("Colour space"); role: TextRole.section; }
            Label { text: @tr("Shared by the canvas and the export."); role: TextRole.note; }
        }
        VerticalLayout {
            spacing: FormStyle.row-gap;
            SpaceTabs { }
            SpaceNote { }
        }
        SpaceField { chip: true; dismiss => { chooser.close(); } }
    }
}

// The clash: Replace for earlier exports alone, deaf to Return; Rename for an original.
export component ExportConfirmSheet inherits AskSheet {
    title: Exporting.confirm-title;
    message: Exporting.confirm-message;
    cancel: @tr("Cancel");
    keys: Exporting.confirm-replaces ? [{ text: @tr("Replace"), role: AskRole.destructive }] : [{ text: @tr("Rename"), role: AskRole.confirm }];
    answered(i) => { Exporting.confirmed(i == 0); }
}

// `DSDialogRequest.notice`: its one key the default, Return included.
export component ExportNoticeSheet inherits AskSheet {
    title: Exporting.notice-title;
    message: Exporting.notice-message;
    keys: [{ text: @tr("OK"), role: AskRole.confirm }];
    answered => { Exporting.notice-closed(); }
}
