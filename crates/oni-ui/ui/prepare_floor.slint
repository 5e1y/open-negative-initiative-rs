// Prepare the Roll's floor: the flags' sheet, the base's scan, the frame card with its window, or the
// measure's screens; Rust holds every value and rule.
import { Space, Card, CardCorners, Scroller, TileView, TileMarks, RingPlacement, Pager, EmptyState, Picture, Ground, Fit, Pick, Loupe, FrameOverlay, FrameStyle, CardStyle, RollStyle, Motion, Clicks } from "ds/ds.slint";
import { Preparing } from "prepare_state.slint";
import { MeasureFloor } from "measure_floor.slint";
import { Converting } from "dng.slint";
import { CanvasKeys } from "canvas_keys.slint";
import { KeyWords } from "key_words.slint";

// `RollFrameSheet`: six to a row, a click flagging a frame, an unticked one dimmed.
component FlagSheet inherits Scroller {
    content-height: grid.preferred-height;
    function laid() {
        Preparing.sheet-origin-x = self.absolute-position.x;
        Preparing.sheet-origin-y = self.absolute-position.y;
        Preparing.sheet-width = self.width;
    }
    changed width => { self.laid(); }
    init => { self.laid(); }
    grid := VerticalLayout {
        width: root.width;
        alignment: start;
        padding: Space.l;
        spacing: Space.m;
        for row in Math.ceil(Preparing.cells.length / RollStyle.sheet-columns): HorizontalLayout {
            spacing: Space.m;
            alignment: start;
            for column in RollStyle.sheet-columns: Rectangle {
                property <int> at: row * RollStyle.sheet-columns + column;
                width: (grid.width - 2 * Space.l - (RollStyle.sheet-columns - 1) * Space.m) / RollStyle.sheet-columns;
                height: self.width * RollStyle.well-ratio;
                if self.at < Preparing.cells.length: TileView {
                    width: parent.width;
                    picture-height: parent.height;
                    marks: TileMarks.apart;
                    rounded: true;
                    ring: RingPlacement.outset;
                    picture: Preparing.cells[parent.at].picture;
                    flagged: Preparing.cells[parent.at].flagged;
                    apart: Preparing.cells[parent.at].apart;
                    rgb: Preparing.cells[parent.at].rgb;
                    left-out: !Preparing.cells[parent.at].ticked;
                    clicked => { Preparing.sheet-clicked(parent.at); }
                }
            }
        }
    }
}

// `RollBaseSurface`: the frame's name between its arrows, then its whole scan to click the bare film on.
component BaseSurface inherits VerticalLayout {
    padding: CardStyle.padding;
    spacing: Space.s;
    Pager {
        name: Preparing.base-name; name-width: RollStyle.name-width; can-previous: Preparing.base-can-previous; can-next: Preparing.base-can-next;
        previous => { Preparing.base-previous(); } next => { Preparing.base-next(); }
    }
    area := Rectangle {
        // Each pick lands its ring, on the scan and in the loupe, from wider with a key's click.
        property <int> picks: Preparing.base-picks;
        property <float> landing: 1;
        property <bool> springing;
        changed picks => {
            self.springing = false;
            self.landing = RollStyle.landing;
            self.springing = true;
            self.landing = 1;
            Clicks.press();
        }
        animate landing { duration: self.springing ? Motion.settle : 0ms; easing: ease-out-back; }
        vertical-stretch: 1;
        function laid() {
            Preparing.base-width = self.width;
            Preparing.base-height = self.height;
            Preparing.base-origin-x = self.absolute-position.x;
            Preparing.base-origin-y = self.absolute-position.y;
            Preparing.base-resized();
        }
        changed width => { self.laid(); }
        changed height => { self.laid(); }
        init => { self.laid(); }
        if !Preparing.scan-ready: EmptyState {
            width: parent.width;
            height: parent.height;
            title: Preparing.scan-failure == "" ? @tr("Reading the Scan") : @tr("This Scan Cannot Be Read");
            detail: Preparing.scan-failure == "" ? @tr("The whole scan, its rebate included, shows here.") : Preparing.scan-failure;
            action: Preparing.scan-convertible ? @tr("Convert to DNG") : "";
            acted => { Converting.offered(); }
        }
        if Preparing.scan-ready: Picture {
            x: Preparing.scan-x;
            y: Preparing.scan-y;
            width: Preparing.scan-width;
            height: Preparing.scan-height;
            ground: Ground.canvas;
            fit: Fit.fill;
            source: Preparing.scan;
        }
        if Preparing.scan-ready && Preparing.ring-shown: Pick {
            centre-x: Preparing.ring-x;
            centre-y: Preparing.ring-y;
            sampled: Preparing.ring-diameter;
            landing: area.landing;
            colour: Preparing.ring-colour;
        }
        if Preparing.scan-ready: TouchArea {
            changed has-hover => { Preparing.base-hover(self.mouse-x, self.mouse-y, self.has-hover); }
            moved => { Preparing.base-hover(self.mouse-x, self.mouse-y, true); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.move) { Preparing.base-hover(self.mouse-x, self.mouse-y, true); }
            }
            clicked => { Preparing.base-clicked(self.mouse-x, self.mouse-y); }
        }
        if Preparing.scan-ready: Loupe { visible: Preparing.loupe-shown; // kept while the pointer leaves: its source is the whole frame
            x: Preparing.loupe-x - self.width / 2;
            y: Preparing.loupe-y - self.height / 2;
            source: Preparing.loupe-source;
            cut-x: Preparing.loupe-cut[0];
            cut-y: Preparing.loupe-cut[1];
            cut-width: Preparing.loupe-cut[2];
            cut-height: Preparing.loupe-cut[3];
            cut-at-x: Preparing.loupe-shown-at[0];
            cut-at-y: Preparing.loupe-shown-at[1];
            cut-shown-width: Preparing.loupe-shown-at[2];
            cut-shown-height: Preparing.loupe-shown-at[3];
            disc-x: Preparing.loupe-rings[0];
            disc-y: Preparing.loupe-rings[1];
            disc: Preparing.loupe-rings[2];
            picked-shown: Preparing.loupe-picked;
            picked-x: Preparing.loupe-rings[3];
            picked-y: Preparing.loupe-rings[4];
            picked-disc: Preparing.loupe-rings[5] * area.landing;
        }
    }
}

// `RollFrameView`: the frame placed where its crop lies in its own turned scan, the measuring
// window over the whole scan on the window step.
component FrameCard inherits Rectangle {
    function laid() {
        Preparing.card-width = self.width - 2 * CardStyle.padding;
        Preparing.card-height = self.height - 2 * CardStyle.padding;
        Preparing.card-origin-x = self.absolute-position.x + CardStyle.padding;
        Preparing.card-origin-y = self.absolute-position.y + CardStyle.padding;
        Preparing.card-resized();
    }
    changed width => { self.laid(); }
    changed height => { self.laid(); }
    init => { self.laid(); }
    Rectangle {
        x: CardStyle.padding;
        y: CardStyle.padding;
        width: parent.width - 2 * CardStyle.padding;
        height: parent.height - 2 * CardStyle.padding;
        // The frame shown, and the next dissolving over it: a scrub through the roll never flashes.
        for layer in 2: Picture {
            x: Preparing.card-boxes[4 * layer];
            y: Preparing.card-boxes[4 * layer + 1];
            width: Preparing.card-boxes[4 * layer + 2];
            height: Preparing.card-boxes[4 * layer + 3];
            ground: Ground.canvas;
            fit: Fit.fill;
            source: layer == 0 ? Preparing.card-a : Preparing.card-b;
            opacity: layer == 0 || Preparing.card-second ? 1 : 0;
            animate opacity { duration: Preparing.card-fade; }
        }
        if Preparing.window-shown: FrameOverlay {
            width: parent.width;
            height: parent.height;
            look: FrameStyle.window;
            frame-x: Preparing.window-x;
            frame-y: Preparing.window-y;
            frame-width: Preparing.window-width;
            frame-height: Preparing.window-height;
            // Taken up and set down with a key's two clicks, so the window answers the hand.
            grabbed(h) => { Clicks.press(); Preparing.window-grabbed(h); }
            dragged(h, dx, dy) => { Preparing.window-dragged(h, dx, dy); }
            released => { Clicks.release(); Preparing.window-released(); }
        }
    }
}

// `rollFloor`: the flags' sheet, the base's scan, the frame card, or the measure's screens.
export component RollFloor inherits Card {
    if Preparing.step == 3: FlagSheet { width: parent.width; height: parent.height; }
    if Preparing.step == 2: BaseSurface { width: parent.width; height: parent.height; }
    if Preparing.step != 2 && Preparing.step != 3 && !Preparing.measuring: FrameCard { width: parent.width; height: parent.height; }
    if Preparing.step == 4 && Preparing.measuring: MeasureFloor { width: parent.width; height: parent.height; }
    CardCorners { width: parent.width; height: parent.height; }
    // The floor's place in Tab's order on the two steps that place something on it.
    CanvasKeys {
        property <bool> base: Preparing.step == 2 && Preparing.scan-ready;
        property <bool> window: Preparing.step == 4 && !Preparing.measuring;
        focus-on-tab-navigation: self.base || self.window;
        told-below: true;
        label: self.base ? Preparing.base-name : self.window ? Preparing.frame-name : "";
        told: self.base ? @tr("Arrows move the picker, {} ten times as far. Return picks the film base under it.", KeyWords.shift)
            : self.window ? @tr("Arrows move the measuring window, {}-arrows its right or bottom edge, {} ten times as far.", KeyWords.option, KeyWords.shift) : "";
    }
}

