// The editor's panel: the tab bar's three panes and the canvas tools' two, each in its own file under `panel/`.
import { Space, Tabs, TabsStyle, Divider, Plot, PlotStyle, Surface, ShellStyle, LabScreen, LoupeBand, Keyboard } from "ds/ds.slint";
import { Act } from "act.slint";
import { Editors } from "editors.slint";
import { Plots, PanelState, Lab, Framing, Dedust, DetailLoupe, CorrectionRow } from "panel/state.slint";
import { ModeHeader } from "panel/parts.slint";
import { RollPane } from "panel/roll_tab.slint";
import { CropPane } from "panel/crop_tab.slint";
import { DedustPane } from "panel/dedust_tab.slint";
import { ColorPane } from "panel/color_tab.slint";
import { DetailsPane } from "panel/details_tab.slint";
export { Plots, PanelState, Lab, Framing, Dedust, DetailLoupe, CorrectionRow }

export component Panel inherits Surface {
    width: ShellStyle.panel-width;
    // The header down to the tab bar's rule, which the window's checks aim under.
    property <length> header: rule.y + rule.height;
    changed header => { PanelState.header = self.header; }
    init => { PanelState.header = self.header; }
    // Tab from the photo enters here, at the tab bar.
    property <int> inward: Keyboard.inward;
    changed inward => { if tabs.visible { tabs.take-keyboard(); } }
    VerticalLayout {
        // The readout, one glass inset as the panel's rows, alike on both faces: Pro's histogram, Lighting's
        // curves over it on the Colour tab; the scanner's screen on the Scanner face; the loupe under Details.
        HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Space.m;
            Rectangle {
                height: PlotStyle.main;
                if !Lab.shown && PanelState.tab != 3: Plot {
                    width: parent.width;
                    height: parent.height;
                    border-radius: PlotStyle.radius;
                    plot: 5;
                    screen: false;
                    glass: true;
                    grid: false;
                    interactive: false;
                    histogram: Plots.output;
                    histogram-revision: Plots.output-revision;
                    lines: PanelState.tab == 2 ? Editors.print-lines : [];
                    // The trace's size, set by the plot itself so it is known before any histogram lands.
                    resized(p, w, h) => { Plots.output-width = w; Plots.output-height = h; Editors.resized(p, w, h); }
                    property <int> epoch: Editors.epoch;
                    changed epoch => { Editors.resized(self.plot, self.width, self.height); }
                }
                // Under Details the output histogram cannot move, so the readout holds the loupe.
                if PanelState.tab == 3: LoupeBand {
                    width: parent.width;
                    height: parent.height;
                    border-radius: PlotStyle.radius;
                    source: DetailLoupe.source;
                    revision: DetailLoupe.revision;
                    shown-width: DetailLoupe.shown-width;
                    shown-height: DetailLoupe.shown-height;
                    ratio: DetailLoupe.ratio;
                    ratio-shown: DetailLoupe.ratio-shown;
                    toggled => { DetailLoupe.toggled(); }
                }
                if Lab.shown && PanelState.tab != 3: LabScreen {
                    width: parent.width;
                    height: parent.height;
                    frame: Lab.frame;
                    machine: Lab.machine-line;
                    remeasure: Lab.remeasure;
                    remeasure-help: @tr("This roll was measured before the scanner kept its median: measure it again in Prepare the Roll, or the scanner centres on a guess.");
                    cells: Lab.cells;
                    balance: Lab.balance;
                    balance-help: @tr("Auto White Balance's correction at the roll's strength, which prints on both faces; Strength sits on the Roll tab.");
                }
            }
        }
        HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Space.s;
            padding-bottom: Space.s;
            // The bar lists the panes; the crop and De-dust, opened by their keys, name themselves in its
            // place beside their DONE. The bar stays, hidden, for Tab's way into the panel.
            Rectangle {
                height: TabsStyle.height;
                tabs := Tabs {
                    visible: PanelState.tab != 1 && PanelState.tab != 4;
                    tabs: [@tr("Roll"), @tr("Colour"), @tr("Details")];
                    marked: [false, false, false];
                    // Each pane's place in the bar, none for a tool.
                    selected: [0, -1, 1, 2, -1][PanelState.tab];
                    picked(i) => {
                        let tab = [0, 2, 3][i];
                        PanelState.tab = tab;
                        PanelState.tab-picked(tab);
                    }
                }
                if PanelState.tab == 1: ModeHeader { title: @tr("Crop"); help: @tr("Leave Crop"); done => { Framing.act(Act.framing); } }
                if PanelState.tab == 4: ModeHeader { title: @tr("De-dust"); help: @tr("Leave De-dust"); done => { Dedust.act(Act.correction); } }
            }
        }
        // `DSPanel`'s pinned header ends on its rule; every pane's first block draws none.
        rule := Divider { }
        Rectangle {
            vertical-stretch: 1;
            RollPane { shown: PanelState.tab == 0; }
            CropPane { shown: PanelState.tab == 1; }
            ColorPane { shown: PanelState.tab == 2; }
            DetailsPane { shown: PanelState.tab == 3; }
            DedustPane { shown: PanelState.tab == 4; }
        }
    }
}
