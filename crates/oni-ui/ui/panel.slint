// The editor's panel: the tab bar's three panes and the canvas tools' two, each in its own file under `panel/`.
import { Space, Tabs, TabsStyle, Divider, Plot, PlotStyle, Surface, ShellStyle, LabScreen, LoupeBand, ModeHeader } from "ds/ds.slint";
import { Act } from "act.slint";
import { KeyWords } from "key_words.slint";
import { Editors } from "editors.slint";
import { Plots, PanelState, PanelTab, RollState, Lab, Framing, Dedust, DetailLoupe, CorrectionRow } from "panel/state.slint";
import { RollPane } from "panel/roll_tab.slint";
import { CropPane } from "panel/crop_tab.slint";
import { DedustPane } from "panel/dedust_tab.slint";
import { ColorPane } from "panel/color_tab.slint";
import { DetailsPane } from "panel/details_tab.slint";
export { Plots, PanelState, PanelTab, RollState, Lab, Framing, Dedust, DetailLoupe, CorrectionRow }

export component Panel inherits Surface {
    width: ShellStyle.panel-width;
    property <string> crop-note: @tr("Drag the frame's corners or edges on the photo to crop it, or move it with the arrow keys and its right or bottom edge with {} and an arrow, ten times as far with Shift. Escape or Cancel puts the photo back as Crop found it; Return or DONE keeps the crop.", KeyWords.option);
    // The header down to the tab bar's rule, which the window's checks aim under.
    property <length> header: rule.y + rule.height;
    changed header => { PanelState.header = self.header; }
    init => { PanelState.header = self.header; }
    VerticalLayout {
        // The readout, one glass edge to edge from the canvas card's top, alike on both faces: Pro's histogram,
        // Lighting's curves over it on the Colour tab; the scanner's screen on the Scanner face; the loupe under Details.
        HorizontalLayout {
            Rectangle {
                height: PlotStyle.main;
                // The plot alone, one height on every tab, so the tab bar never moves.
                if !Lab.shown && PanelState.tab != PanelTab.details: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    Plot {
                        vertical-stretch: 1;
                        plot: 5;
                        screen: false;
                        glass: true;
                        grid: false;
                        interactive: false;
                        radius: PlotStyle.readout-radius;
                        histogram: Plots.output;
                        histogram-revision: Plots.output-revision;
                        lines: PanelState.tab == PanelTab.color ? Editors.print-lines : [];
                        // The trace's size, set by the plot itself so it is known before any histogram lands.
                        resized(p, w, h) => { Plots.output-width = w; Plots.output-height = h; Editors.resized(p, w, h); }
                        property <int> epoch: Editors.epoch;
                        changed epoch => { Editors.resized(self.plot, self.width, self.height); }
                    }
                }
                // Under Details the output histogram cannot move, so the readout holds the loupe.
                if PanelState.tab == PanelTab.details: LoupeBand {
                    width: parent.width;
                    height: parent.height;
                    radius: PlotStyle.readout-radius;
                    source: DetailLoupe.source;
                    revision: DetailLoupe.revision;
                    shown-width: DetailLoupe.shown-width;
                    shown-height: DetailLoupe.shown-height;
                    ratio: DetailLoupe.ratio;
                    ratio-shown: DetailLoupe.ratio-shown;
                    toggled => { DetailLoupe.toggled(); }
                }
                if Lab.shown && PanelState.tab != PanelTab.details: LabScreen {
                    width: parent.width;
                    height: parent.height;
                    radius: PlotStyle.readout-radius;
                    frame: Lab.frame;
                    machine: Lab.machine-line;
                    remeasure: Lab.remeasure;
                    remeasure-help: @tr("This roll was prepared before the scanner kept its median: prepare it again, or the scanner centres on a guess.");
                    cells: Lab.cells;
                    widest: Lab.widest;
                }
            }
        }
        HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Space.s;
            padding-bottom: Space.s;
            // The bar lists the panes; the crop and De-dust, opened by their keys, name themselves in its
            // place beside their DONE. The bar stays, hidden, for Tab's way into the panel.
            Rectangle {
                height: max(TabsStyle.height, tools.preferred-height);
                tabs := Tabs {
                    visible: PanelState.tab != PanelTab.crop && PanelState.tab != PanelTab.dedust;
                    tabs: [@tr("Roll"), @tr("Colour"), @tr("Details")];
                    marked: [false, false, false];
                    // Each pane's place in the bar, none for a tool.
                    selected: PanelState.tab == PanelTab.roll ? 0 : PanelState.tab == PanelTab.color ? 1 : PanelState.tab == PanelTab.details ? 2 : -1;
                    picked(i) => {
                        let tab = i == 0 ? PanelTab.roll : i == 1 ? PanelTab.color : PanelTab.details;
                        PanelState.tab = tab;
                        PanelState.tab-picked(tab);
                    }
                }
                tools := VerticalLayout {
                    if PanelState.tab == PanelTab.crop: ModeHeader {
                        title: @tr("Crop");
                        demo: "crop";
                        note: root.crop-note;
                        help: @tr("Leave Crop");
                        cancel-help: @tr("Puts back the crop this photo had when Crop opened, and leaves.");
                        done => { Framing.act(Act.framing); }
                        cancel => { Framing.act(Act.cancel-tool); }
                    }
                    if PanelState.tab == PanelTab.dedust: ModeHeader {
                        title: @tr("De-dust");
                        help: @tr("Leave De-dust");
                        cancel-help: @tr("Puts back the corrections this photo had when De-dust opened, and leaves.");
                        done => { Dedust.act(Act.correction); }
                        cancel => { Dedust.act(Act.cancel-tool); }
                    }
                }
            }
        }
        // `DSPanel`'s pinned header ends on its rule; every pane's first block draws none.
        rule := Divider { }
        Rectangle {
            vertical-stretch: 1;
            RollPane { shown: PanelState.tab == PanelTab.roll; }
            CropPane { shown: PanelState.tab == PanelTab.crop; }
            ColorPane { shown: PanelState.tab == PanelTab.color; }
            DetailsPane { shown: PanelState.tab == PanelTab.details; }
            DedustPane { shown: PanelState.tab == PanelTab.dedust; }
        }
    }
}
