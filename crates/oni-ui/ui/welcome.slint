// `WelcomeSheet`: the release told once, over the whole window, one screen a gift: the gift alone in the middle,
// opened by a click or Return, then its demo on the left and its words on the right; the message comes last.
import { Space, Motion, Label, TextRole, Tone, Button, Sheet, SheetFooter, Scroller } from "ds/ds.slint";
import { WelcomeStyle, Headline, InterfaceScene, KitScene, MysteryScene, WrappedFrame, WrappedStyle } from "ds/ds.slint";
import { StageStyle, Beat, StagePicture, StageLine, StageNote, StageText, DemoFrame, DemoReel, StageRail, FilmDemo } from "ds/ds.slint";
import { Help } from "help.slint";
import { Kit, KitLink } from "gear_state.slint";
import { Wrapped } from "wrapped.slint";

// A gift's words, right of it: which gift it is, its name in the display face, what it holds, a key if it has one.
component Words inherits VerticalLayout {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> lead;
    in property <string> text;
    in property <float> shown;
    spacing: Space.m;
    opacity: root.shown;
    Label { text: root.eyebrow; role: TextRole.label; tone: Tone.secondary; }
    Headline { text: root.title; }
    StageText { text: root.lead; lead: true; }
    if root.text != "": StageText { text: root.text; }
    @children
}

export component WelcomeSheet inherits Sheet {
    full: true;
    bleed: true;
    paging: true;
    // No way out before the end, Escape included: every gift is opened (owner's call).
    exit-enabled: false;
    property <int> page: Help.welcome-page;
    property <bool> last: root.page == 5;
    property <bool> opened: Help.opened-time >= 0;
    // The screens in the scroll, the Collection's taking no place without its gift.
    property <int> count: Help.kit-gift ? 5 : 4;
    function slot(page: int) -> int { !Help.kit-gift && page > 2 ? page - 2 : page - 1 }
    // How far the screen's words and demo have come, from the moment its gift's lid is off.
    property <float> words: root.opened ? Beat.at(Help.opened-time, Help.words-at, 0.8) : 0;
    property <float> demo-clock: Help.opened-time - Help.words-at - 0.4;
    property <[string]> tags: [@tr("A small gift"), @tr("Another small gift"), @tr("The huge gift"), @tr("The mystery gift")];
    // The columns: the gift's in the middle, the demo's left of it, the words' right of it.
    property <length> room: root.height - footer-room.height;
    property <length> middle: root.height * StageStyle.gift-share;
    property <length> side: (root.width - root.middle) / 2 - StageStyle.gap - 2 * Space.l;
    property <length> left: 2 * Space.l;
    // Once its gift has gone, a screen's demo takes the stage left of the words, as large as the room lets it.
    function demo-height(page: int, width: length) -> length {
        page == 3 ? width * StageStyle.picture-shape + StageStyle.demo-cells : width * (page <= 2 ? StageStyle.window-shape : StageStyle.picture-shape)
    }
    function demo-width(page: int) -> length {
        min(root.right - StageStyle.gap - root.left, page == 3 ? (root.room - 4 * Space.l - StageStyle.demo-cells) / StageStyle.picture-shape : (root.room - 4 * Space.l) / (page <= 2 ? StageStyle.window-shape : StageStyle.picture-shape))
    }
    property <length> right: root.width / 2 + root.middle / 2 + StageStyle.gap;
    // On: the gift opened if it is still wrapped, else the next screen; the last screen's key enters the app.
    function onward() {
        if (root.last) { Help.welcome-closed(); } else if (!root.opened) { Help.welcome-open(); } else { Help.welcome-go(1); }
    }
    function sized() { Help.welcome-sized(root.width, root.height, footer-room.height); }
    init => { root.sized(); }
    changed width => { root.sized(); }
    changed height => { root.sized(); }
    dismissed => { Help.welcome-closed(); }
    returned => { root.onward(); }
    paged(by) => { Help.welcome-go(by); }
    StagePicture {
        source: Help.stage;
        revision: Help.stage-revision;
        live: Help.stage-live;
        gift: Help.gift-shown;
        opened: root.opened;
        shown: Help.stage-shown;
        // The wheel and the trackpad go from screen to screen, on only past an opened gift.
        TouchArea {
            scroll-event(event) => {
                if (event.delta-y < -StageStyle.wheel) { Help.welcome-go(1); return accept; }
                if (event.delta-y > StageStyle.wheel) { Help.welcome-go(-1); return accept; }
                reject
            }
        }
        // The gift still wrapped takes the click that opens it; its tag and what to do lie under it.
        if !root.opened && !root.last: Rectangle {
            x: Help.gift-spot.x;
            y: Help.gift-spot.y;
            width: Help.gift-spot.width;
            height: Help.gift-spot.height;
            accessible-role: button;
            accessible-label: root.tags[root.page - 1];
            accessible-action-default => { Help.welcome-open(); }
            TouchArea { mouse-cursor: pointer; clicked => { Help.welcome-open(); } }
        }
        // Where its words will come: which gift it is, and what to do.
        // Clear of the gift, which the huge one is not of the words' column.
        if !root.opened && !root.last: VerticalLayout {
            x: max(root.right, Help.gift-spot.x + Help.gift-spot.width + StageStyle.gap);
            width: root.width - self.x - 2 * Space.l;
            y: (root.room - self.preferred-height) / 2;
            height: self.preferred-height;
            spacing: Space.s;
            opacity: Help.stage-shown;
            Headline { text: root.tags[root.page - 1]; }
            StageText { text: @tr("Click it or press Return to unwrap it."); }
        }
        // The screens, one above the other, the scroll bringing each in.
        for screen in 4: Rectangle {
            property <int> page: screen + 1;
            property <bool> here: page == root.page;
            visible: here && (page != 2 || Help.kit-gift);
            y: (root.slot(page) - Help.scroll) * root.height;
            height: root.room;
            // The demo, left of the gift.
            DemoFrame {
                x: root.left;
                width: root.demo-width(page);
                height: root.demo-height(page, self.width);
                y: (parent.height - self.height) / 2 + (1 - root.words) * StageStyle.rise;
                shown: here ? root.words : 0;
                // A small gift's film of the real app; its drawn scene where the film cannot be read.
                if page <= 2 && Help.reel-gift == page - 1: DemoReel { width: parent.width; height: parent.height; source: Help.reel; }
                if page == 1 && Help.reel-gift != 0: InterfaceScene { width: parent.width; height: parent.height; held: Motion.reduced ? 4 : Math.mod(max(0, root.demo-clock), 7.75); }
                if page == 2 && Help.reel-gift != 1: KitScene { width: parent.width; height: parent.height; held: Motion.reduced ? 4 : Math.mod(max(0, root.demo-clock), 7.45); }
                if page == 3: FilmDemo { width: parent.width; height: parent.height; cells: Help.film-cells; t: Motion.reduced ? 6 : root.demo-clock; }
                // The person's own year: its first cards, as the Wrapped makes them; a promise while it is read.
                if page == 4 && Wrapped.scenes.length == 0: MysteryScene { width: parent.width; height: parent.height; year: Help.year; held: Motion.reduced ? 4 : Math.mod(max(0, root.demo-clock), 6.0); }
                if page == 4: Rectangle {
                    for scene[i] in Wrapped.scenes: WrappedFrame {
                        property <int> cards: min(3, Wrapped.scenes.length);
                        property <float> come: Motion.reduced ? 1 : Beat.at(root.demo-clock, 0.25 * i, 0.7);
                        visible: i < self.cards;
                        u: parent.height * StageStyle.card-share / WrappedStyle.frame-height;
                        x: (parent.width - self.width) / 2 + (i - (self.cards - 1) / 2) * (self.width + Space.s);
                        y: (parent.height - self.height) / 2 + (1 - self.come) * StageStyle.rise;
                        opacity: self.come;
                        scene: scene;
                        number: i + 1;
                        hashtag: Wrapped.hashtag;
                        account: Wrapped.account;
                        name: Wrapped.name;
                        counted(n) => { Wrapped.counted(n) }
                    }
                }
            }
            // The words, right of the gift.
            VerticalLayout {
                x: root.right;
                width: root.side;
                y: (parent.height - self.preferred-height) / 2 + (1 - root.words) * StageStyle.rise;
                height: self.preferred-height;
                if page == 1: Words {
                    eyebrow: root.tags[0];
                    title: @tr("A livelier interface");
                    lead: @tr("ONI now moves the way you look at your photos: every change of place is shown, never jumped.");
                    text: @tr("Each move is short and weighted, so the app feels faster, not slower. Your tools stay where they were.");
                    shown: here ? root.words : 0;
                }
                if page == 2: Words {
                    eyebrow: root.tags[1];
                    title: @tr("The Collection, with The Lens DB");
                    lead: @tr("ONI partners with The Lens DB, a catalogue of camera bodies and lenses.");
                    text: @tr("Two independent projects, no ads. The Lens DB sees your list of gear, never your photos.");
                    shown: here ? root.words : 0;
                    if Kit.link == KitLink.out: HorizontalLayout { alignment: start; Button { keycap: true; text: @tr("Connect The Lens DB"); clicked => { Kit.connect(false); } } }
                    if Kit.link == KitLink.waiting: StageText { text: @tr("Finish in Your Browser"); }
                    if Kit.link == KitLink.in: StageText { text: @tr("Connected as {}", Kit.account); }
                }
                if page == 3: Words {
                    eyebrow: root.tags[2];
                    title: @tr("Your digital photos, on film");
                    lead: @tr("ONI shoots a digital photo again on a film rebuilt from its maker's data sheet, develops it, scans it and inverts it, as a lab would.");
                    text: @tr("{} films wait in the editor's Film panel. A new photo opens untouched, just as your camera saw it.", Help.film-count);
                    shown: here ? root.words : 0;
                }
                if page == 4: Words {
                    eyebrow: root.tags[3];
                    title: @tr("Your year on film");
                    lead: @tr("ONI Wrapped, rebuilt from scratch: your rolls, your films, your favourite frames and the time you spent with them, told in one go.");
                    text: "";
                    shown: here ? root.words : 0;
                    HorizontalLayout { alignment: start; Button { keycap: true; text: @tr("Open My Wrapped"); clicked => { Help.wrapped(); } } }
                }
            }
        }
        // The message: its two lines, then what a person can do, then the way into the app.
        if root.last: Scroller {
            y: (root.slot(5) - Help.scroll) * root.height;
            height: root.room;
            content-height: letter.preferred-height;
            letter := HorizontalLayout {
                width: parent.width;
                alignment: center;
                VerticalLayout {
                    width: min(WelcomeStyle.letter-width * 1.9, root.width - 4 * Space.l);
                    padding-top: root.height * 0.1;
                    padding-bottom: Space.l;
                    spacing: Space.m;
                    StageNote { text: @tr("I have a message for you"); role: TextRole.title; tone: Tone.secondary; }
                    StageLine { size: min(StageStyle.title, root.height * StageStyle.title-share); text: @tr("You already paid for your film."); }
                    StageLine { size: min(StageStyle.title, root.height * StageStyle.title-share); text: @tr("You shouldn't have to pay just to look at it."); }
                    HorizontalLayout {
                        alignment: center;
                        StageText {
                            width: min(WelcomeStyle.letter-width, root.width - 4 * Space.l);
                            centred: true;
                            lead: true;
                            text: @tr("Too many tools charge you every month to convert your negatives, and most of them do it worse than ONI. ONI is free and open source, with no ads and no marketing budget: it only grows when someone tells a friend.");
                        }
                    }
                    VerticalLayout {
                        spacing: Space.s;
                        Label { text: @tr("ONI needs you: spread the word"); role: TextRole.heading; centred: true; wrap: word-wrap; }
                        Label { text: @tr("Share what you make with ONI under {}.", Help.made-with); role: TextRole.note; centred: true; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: Space.s;
                            if Help.instagram-known: Button { keycap: true; text: @tr("Follow ONI on Instagram"); clicked => { Help.instagram(); } }
                            Button { keycap: true; text: @tr("Support ONI on Ko-fi"); clicked => { Help.donate(); } }
                            Button { keycap: true; text: @tr("Enter the Contest"); clicked => { Help.contest(); } }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Label {
                                width: min(WelcomeStyle.letter-width, root.width - 4 * Space.l);
                                role: TextRole.note;
                                centred: true;
                                text: @tr("Every month, the community's top five; the winning photo opens the next version of ONI for everyone, with its author's name. Anyone can enter, with a photo where no one is recognisable. One step, the form; {} to share.", Help.contest-tag);
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Label {
                                width: min(WelcomeStyle.letter-width, root.width - 4 * Space.l);
                                role: TextRole.note;
                                centred: true;
                                text: @tr("This welcome stays in the Help menu, under What's New.");
                            }
                        }
                    }
                }
            }
        }
        StageRail {
            x: parent.width - Space.l - self.preferred-width;
            y: (root.room - self.preferred-height) / 2;
            count: root.count;
            at: root.slot(root.page);
        }
        // The footer's keys: back up a screen, and on: unwrap, the next gift, the message, the app.
        footer-room := Rectangle {
            y: parent.height - self.height;
            height: footer.preferred-height + Space.m + Space.l;
            footer := SheetFooter {
                x: Space.l;
                y: Space.m;
                width: parent.width - 2 * Space.l;
                height: self.preferred-height;
                back: root.slot(root.page) > 0 ? @tr("Back") : "";
                commit: root.last ? @tr("Enter ONI") : !root.opened ? @tr("Unwrap") : root.page == 4 ? @tr("Read the Message") : @tr("Next Gift");
                commit-enabled: root.last || !root.opened || Help.may-go-on;
                backed => { Help.welcome-go(-1); }
                committed => { root.onward(); }
            }
        }
    }
}
