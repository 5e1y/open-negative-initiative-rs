// Prepare the Roll: the panel with its five steps, beside the floor that shows a frame, the flags'
// sheet or the base's scan. Rust holds every value and rule.
import { Colour, Space, Depth, ShellStyle, ButtonStyle, Surface, Label, TextRole, Tone, Button, Pager, Icons, Engraved, Tabs, Toggle, Slider, SliderFill, Field, Scroller, Picture, RollStyle, TileView, TileMarks, PassReorder, Picker, SheetFooter, WarningBand } from "ds/ds.slint";
import { RollCell, Preparing } from "prepare_state.slint";
export { RollCell, Preparing } from "prepare_state.slint";
export { RollFloor } from "prepare_floor.slint";

component RollSlider inherits Slider {
    fraction: Preparing.fractions[self.field];
    readout: Preparing.readouts[self.field];
    value-text: Preparing.readouts[self.field];
    press(f, fine) => { return Preparing.press(f, fine); }
    drag(f, t, s, fine) => { Preparing.drag(f, t, s, fine); }
    release(f) => { Preparing.release(f); }
    scroll(f, dx, dy, s, fine) => { return Preparing.scroll(f, dx, dy, s, fine); }
    step(f, by) => { Preparing.slider-step(f, by); }
}

// `RollPanel.frameGrid`: three to a row, the step's own mark on each.
component FrameGrid inherits VerticalLayout {
    spacing: Space.s;
    for row in Math.ceil(Preparing.cells.length / RollStyle.columns): HorizontalLayout {
        spacing: Space.s;
        alignment: start;
        for column in RollStyle.columns: Rectangle {
            property <int> at: row * RollStyle.columns + column;
            width: (root.width - (RollStyle.columns - 1) * Space.s) / RollStyle.columns;
            height: self.width * RollStyle.well-ratio;
            if self.at < Preparing.cells.length: TileView {
                width: parent.width;
                picture-height: parent.height;
                marks: TileMarks.apart;
                rounded: true;
                picture: Preparing.cells[parent.at].picture;
                selected: Preparing.cells[parent.at].marked;
                flagged: Preparing.cells[parent.at].flagged;
                apart: Preparing.cells[parent.at].apart;
                rgb: Preparing.cells[parent.at].rgb;
                clicked => { Preparing.cell-clicked(parent.at); }
            }
        }
    }
}

// What the step asks to check: the warning's triangle beside its title, the reason under it in the
// panel's own ink, so the orange stays in the glyph the marked cells wear.
component Caution inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: Space.xs;
    WarningBand { text: root.title; }
    Label { role: TextRole.note; text: root.text; }
}

component FlatFieldBlock inherits VerticalLayout {
    property <bool> settings;
    spacing: Space.s;
    // `FlatFieldControls`: the switch and its word at the left, the settings key at the far right.
    HorizontalLayout {
        spacing: Space.s;
        Toggle { label: @tr("Flat-field"); on: Preparing.flat-on; toggled(on) => { Preparing.flat-toggled(on); } }
        Rectangle { horizontal-stretch: 1; }
        Button { has-icon: true; square: true; icon: Icons.settings; help: root.settings ? @tr("Hide Amount and Colour") : @tr("Show Amount and Colour"); clicked => { root.settings = !root.settings; } }
    }
    if Preparing.flat-on: Picker { label: @tr("Mask"); value: Preparing.mask-title; lines: Preparing.mask-lines; chosen(i) => { Preparing.mask-chosen(i); } }
    if Preparing.flat-on && Preparing.masks-empty: Label { role: TextRole.note; text: @tr("No mask yet: take a frame of the empty light panel, shot on this rig."); }
    Button { text: Preparing.taking-flat ? @tr("Setting…") : @tr("Use This Frame as Flat-Field"); horizontal-stretch: 1; enabled: Preparing.can-take-flat && !Preparing.taking-flat; clicked => { Preparing.take-flat(); } }
    if root.settings: RollSlider { field: 0; label: @tr("Amount"); enabled: Preparing.flat-masked; }
    if root.settings && !Preparing.monochrome: RollSlider {
        field: 1; label: @tr("Temperature"); enabled: Preparing.flat-masked;
        fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
    }
    if root.settings && !Preparing.monochrome: RollSlider {
        field: 2; label: @tr("Tint"); enabled: Preparing.flat-masked;
        fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
    }
    if root.settings: Button { text: Preparing.loading-flat ? @tr("Loading…") : @tr("Load…"); horizontal-stretch: 1; enabled: !Preparing.loading-flat; clicked => { Preparing.load-flat(); } }
}

// `RollPanel`: the step's title and detail, its body scrolling, then Cancel, Back and the step's key.
export component RollPanel inherits Surface {
    width: ShellStyle.panel-width;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        VerticalLayout {
            spacing: Space.s;
            padding-bottom: Space.s;
            Engraved { role: TextRole.section; text: Preparing.heading; wrap: word-wrap; }
            if Preparing.detail != "": Label { role: TextRole.note; text: Preparing.detail; }
        }
        // In a box of its own, so the body's width never feeds the layout it sits in.
        Rectangle {
          vertical-stretch: 1;
          body := Scroller {
            width: parent.width;
            height: parent.height;
            content-height: column.preferred-height;
            column := VerticalLayout {
                width: body.width;
                alignment: start;
                spacing: Space.m;
                // A tab bar may end the step: its well's lip keeps its room at the scroll's end.
                padding-bottom: Depth.lip-reach;
                // Each step's block in the column itself: under a layout between, Slint 1.18 measured a
                // wrapped note at the wrong width, and the grid below ran over its last lines.
                if Preparing.step == 0: VerticalLayout {
                    spacing: Space.m;
                    if Preparing.left-out != "": Label { role: TextRole.note; text: Preparing.left-out; }
                    Field {
                        label: @tr("Film type");
                        Tabs {
                            tabs: [@tr("Negative"), @tr("Positive"), @tr("B&W")];
                            marked: [false, false, false];
                            selected: Preparing.film;
                            picked(i) => { Preparing.film = i; Preparing.film-picked(i); }
                        }
                    }
                    Field {
                        label: @tr("Digitised with");
                        Tabs {
                            tabs: [@tr("Scanner"), @tr("DSLR Scan"), @tr("RGB Passes")];
                            marked: [false, false, false];
                            selected: Preparing.capture;
                            picked(i) => { Preparing.capture = i; Preparing.capture-picked(i); }
                        }
                    }
                    if Preparing.grouped: Field {
                        label: @tr("Pass order");
                        help: @tr("The first frame's three files in the order they were taken, each under the band it is read as. The order is read off the files when RGB Passes is chosen; drag a band between two others to move it. The order holds for the whole roll.");
                        PassReorder {
                            letters: Preparing.pass-letters;
                            bands: Preparing.pass-bands;
                            pictures: Preparing.pass-pictures;
                            names: Preparing.pass-names;
                            moved(from, to) => { Preparing.pass-moved(from, to); }
                        }
                    }
                    if Preparing.grouped: HorizontalLayout {
                        spacing: Space.s;
                        Label { role: TextRole.value; tone: Tone.secondary; text: Preparing.grouping-note; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: @tr("Shift by One File"); enabled: !Preparing.measuring; clicked => { Preparing.shift-grouping(); } }
                    }
                    if Preparing.grouped && Preparing.grouping-remark != "": Caution { title: @tr("Check the grouping"); text: Preparing.grouping-remark; }
                    if Preparing.passes-note != "": Label { role: TextRole.note; text: Preparing.passes-note; }
                }
                if Preparing.step == 1: VerticalLayout {
                    spacing: Space.m;
                    FlatFieldBlock { }
                    // Told once, over the grid that marks the frames shot apart, on the step whose light they change.
                    if Preparing.differ != "": Caution { title: @tr("Settings differ across the roll"); text: Preparing.differ; }
                }
                if Preparing.step == 2: VerticalLayout {
                    spacing: Space.m;
                    // As tall with its Clear key as without, so the slider below never jumps.
                    HorizontalLayout {
                        spacing: Space.s; min-height: ButtonStyle.height;
                        Label { role: TextRole.value; tone: Tone.secondary; text: Preparing.base-note; horizontal-stretch: 1; overflow: elide; }
                        if Preparing.has-base: Button { text: @tr("Clear"); enabled: !Preparing.measuring; clicked => { Preparing.clear-base(); } }
                    }
                    RollSlider { field: 3; label: @tr("Picker size"); enabled: !Preparing.measuring; }
                }
                if Preparing.step == 3: HorizontalLayout {
                    spacing: Space.s;
                    Label { role: TextRole.value; tone: Tone.secondary; text: Preparing.flags-note; horizontal-stretch: 1; }
                    Button { text: @tr("Clear Flags"); enabled: Preparing.can-clear-flags && !Preparing.measuring; clicked => { Preparing.clear-flags(); } }
                }
                if Preparing.step == 4: VerticalLayout {
                    spacing: Space.m;
                    RollSlider { field: 4; label: @tr("Frame"); enabled: !Preparing.measuring; }
                    Pager {
                        name: Preparing.frame-name; can-previous: Preparing.can-previous && !Preparing.measuring; can-next: Preparing.can-next && !Preparing.measuring;
                        previous => { Preparing.previous(); } next => { Preparing.next(); }
                    }
                    // Told under the slider it concerns, a caption below the step's own text.
                    Label { role: TextRole.caption; tone: Tone.secondary; wrap: word-wrap; text: @tr("Epilepsy warning: scrubbing flashes the frames quickly."); }
                }
                // The step's demo under the controls its text names, only once asked: nothing moves beside the scan unasked.
                if Preparing.has-tutorial: HorizontalLayout {
                    alignment: start;
                    Button { text: Preparing.tutorial.width > 0 ? @tr("Hide") : @tr("Show How"); clicked => { Preparing.tutorial-toggled(); } }
                }
                if Preparing.tutorial.width > 0: HorizontalLayout {
                    alignment: center;
                    Picture {
                        width: RollStyle.demo;
                        height: RollStyle.demo;
                        source: Preparing.tutorial;
                        revision: Preparing.tutorial-revision;
                        rounded: true;
                    }
                }
                // The frames to pick from, last: the part that scrolls.
                if Preparing.step == 1 || Preparing.step == 2: FrameGrid { }
            }
          }
        }
        // Cancel at the left, Skip beside it while the step is empty; Back and the step's keycap at the
        // right, the same on every step, so a hand at the keycap's place never passes a pick unseen.
        footer := SheetFooter {
            function laid() {
                Preparing.footer-x = self.absolute-position.x;
                Preparing.footer-y = self.absolute-position.y;
                Preparing.footer-width = self.width;
                Preparing.footer-height = self.height;
            }
            changed width => { self.laid(); }
            changed y => { self.laid(); }
            init => { self.laid(); }
            cancel: Preparing.measuring ? @tr("Stop") : @tr("Cancel");
            back: Preparing.back-shown ? @tr("Back") : "";
            commit: Preparing.measuring ? @tr("Measuring…") : Preparing.action-title;
            commit-enabled: Preparing.action-enabled && !Preparing.measuring;
            cancelled => { Preparing.cancel(); }
            backed => { Preparing.back(); }
            committed => { Preparing.advance(); }
            if Preparing.skippable && !Preparing.measuring: Button { text: @tr("Skip"); clicked => { Preparing.advance(); } }
        }
    }
}
