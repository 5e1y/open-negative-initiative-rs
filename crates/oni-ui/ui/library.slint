// The library column, the gallery grid and the info sidebar; the lists draw only what is on screen.
import { TrashLine, NavigatorSection, Navigator } from "navigator.slint";
export { TrashLine } from "navigator.slint";
import { ColumnPill, ListView, Scroller, ScrollKnob, IconButton, Icons, Section, TextField, TreeItem, RenameRow, RowKind, TileView, TileHeading, PinnedHeading, Surface, Ground, Label, Tone, TextRole, Space, ShellStyle, Tabs, TrashRow, EmptyState, ContextMenu, MenuLine, DropLine, TileGhost, DateFields, Button, ButtonSize, TextArea, CardStack, EditableTitle, Stroke, StockIcon, StockStyle } from "ds/ds.slint";

export struct Tile {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    picture: image,
    caption: string,
    selected: bool,
    medal: int,
    missing: bool,
    rgb: bool,
}

export struct Heading {
    y: length,
    title: string,
    caption: string,
    renaming: bool,
}

export struct TreeRow {
    depth: int,
    title: string,
    caption: string,
    // 0 a folder, 1 a roll, 2 a photo.
    kind: int,
    expandable: bool,
    expanded: bool,
    selected: bool,
    // `TreeEngine.renaming`: the row's name typed over it.
    renaming: bool,
    // Its place in the column, a photo drawn as a thumbnail when `thumb`.
    x: length,
    y: length,
    width: length,
    height: length,
    thumb: bool,
    picture: image,
    medal: int,
    missing: bool,
}

export struct StockCount {
    name: string,
    count: string,
    artwork: image,
    has-artwork: bool,
}

export global Library {
    // `SidebarLayout`: 0 names only, 1 two thumbnails a line, 2 one; its key's name says the next.
    in property <int> tree-layout;
    in property <string> tree-layout-help;
    in property <length> tree-content-height;
    // The column's scroll, both ways: Rust centres the selection, the wheel moves it.
    in-out property <length> tree-viewport-y;
    // The column created at its size, then each later size; only its creation re-centres it.
    callback tree-shown(length, length);
    callback tree-resized(length, length);
    callback tree-layout-next();
    callback tree-centre();
    callback tree-reload();
    // `GallerySurface`: 0 the archive, 1 the projects.
    in-out property <int> surface;
    in property <[TreeRow]> rows;
    in property <[TreeRow]> project-rows;
    in property <[TrashLine]> trash-rows;
    // Only the tiles in view and one row either side, placed in the grid's own coordinates.
    in property <[Tile]> tiles;
    in property <[Heading]> headings;
    // The band under the grid's top edge, its heading held there until the band's end pushes it off.
    in property <bool> pinned-shown;
    in property <length> pinned-y;
    in property <string> pinned-title;
    in property <string> pinned-caption;
    in property <bool> pinned-renaming;
    // `GalleryEngine.draft`: what a heading's field opens on; its edits, Return and Escape.
    in property <string> heading-draft;
    callback heading-edited(string);
    callback heading-committed(string);
    callback heading-cancelled();
    in property <length> content-height;
    in property <length> scroll;
    in property <string> empty-title;
    in property <string> empty-detail;
    in property <string> empty-action;
    in property <string> projects-empty;
    // The reorder's ghost under the pointer and the line where it would land.
    in property <bool> ghost-shown;
    in property <image> ghost;
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-width;
    in property <length> ghost-height;
    in property <bool> drop-shown;
    in property <length> drop-x;
    in property <length> drop-y;
    in property <length> drop-width;
    in property <length> drop-height;
    in property <[MenuLine]> menu-lines;
    // The status bar's leading text, what a load or a failure says over it, and its medal picker.
    in property <string> status;
    // `statusSeal`: RGB for a lone frame made of passes, in the gallery and on the open frame.
    in property <string> status-seal;
    in property <string> editor-seal;
    in property <string> loading;
    // `loadBar`'s count on the glass, and its fraction done, below zero when nothing counts.
    in property <string> loading-count;
    in property <float> loading-fraction: -1;
    in property <bool> medal-shown;
    in property <int> medal-current: -1;
    // The picker beside the open frame: the frame itself while nothing is selected.
    in property <bool> editor-medal-shown;
    in property <int> editor-medal-current: -1;
    // The info sidebar: 0 nothing resolved, 1 a roll, 2 a project.
    in property <int> info-kind;
    in property <string> info-empty;
    in property <string> info-title;
    in property <string> roll-title;
    in property <string> stock;
    in property <string> stock-note;
    in property <image> stock-artwork;
    in property <bool> stock-has-artwork;
    in-out property <string> month;
    in-out property <string> day;
    in-out property <string> year;
    in property <bool> shot-date-set;
    in property <bool> shot-date-default;
    in-out property <string> camera-body;
    in-out property <string> description;
    in property <[StockCount]> stocks;
    in property <[image]> stack;
    callback surface-picked(int);
    callback row-clicked(int);
    callback row-double-clicked(int);
    // `toggleExpand`: a click in the chevron's zone, which only folds.
    callback row-folded(int);
    callback project-row-folded(int);
    callback row-rename-committed(int, string);
    callback row-rename-cancelled();
    callback project-row-clicked(int);
    callback project-row-double-clicked(int);
    callback project-row-menu(int) -> bool;
    // `SidebarKeys` on the projects: whether a row is open, and the key folding or opening them all.
    in property <bool> projects-any-open;
    callback project-fold-all();
    callback project-centre();
    // The projects' scroll, and the row it centres each time Rust moves the serial.
    in-out property <length> project-viewport-y;
    in property <int> project-reveal-row: -1;
    in property <int> project-reveal-serial;
    callback trash-row-clicked(int);
    callback trash-row-double-clicked(int);
    callback trash-row-restore(int);
    callback trash-row-menu(int) -> bool;
    // A click on a cell resolved by index, with ⌘ and ⇧; the pointer's own path is below.
    callback tile-clicked(int, bool, bool);
    callback tile-opened(int);
    // The grid's pointer in document coordinates: a press, its moves, its release, a right click.
    callback pointer-down(length, length, bool, bool);
    callback pointer-moved(length, length);
    callback pointer-up(length, length, bool, bool);
    callback context(length, length) -> bool;
    callback menu-chosen(int) -> bool;
    callback empty-acted();
    callback scrolled(length);
    callback resized(length, length);
    callback gallery-shown();
    // Where the grid sits in the window, which a pointer a check dispatches is placed from.
    in-out property <length> grid-x;
    in-out property <length> grid-y;
    callback medal-picked(int);
    callback title-committed(string);
    callback select-roll-type();
    callback shot-date-committed(string, string, string);
    callback shot-date-cleared();
    callback camera-body-committed(string);
    callback description-committed(string);
}

export component Grid inherits Surface {
    ground: Ground.canvas;
    clip: true;
    property <length> menu-x;
    property <length> menu-y;
    changed width => { Library.grid-x = self.absolute-position.x; Library.grid-y = self.absolute-position.y; Library.resized(self.width, self.height); }
    changed height => { Library.grid-x = self.absolute-position.x; Library.grid-y = self.absolute-position.y; Library.resized(self.width, self.height); }
    // One pointer for the whole document, as the cells keep no gesture of their own: Rust resolves
    // a cell or the ground from the point.
    pointer := TouchArea {
        scroll-event(event) => {
            Library.scrolled(-event.delta-y);
            knob.stir();
            EventResult.accept
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                Library.pointer-down(self.mouse-x, self.mouse-y + Library.scroll, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                Library.pointer-up(self.mouse-x, self.mouse-y + Library.scroll, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                if (Library.context(self.mouse-x, self.mouse-y + Library.scroll)) { menu.show(); }
            }
        }
        moved => { Library.pointer-moved(self.mouse-x, self.mouse-y + Library.scroll); }
        Rectangle {
            y: -Library.scroll;
            width: parent.width;
            height: Library.content-height;
            for h in Library.headings: TileHeading {
                x: Space.l;
                y: h.y;
                width: root.width - 2 * Space.l;
                title: h.title;
                caption: h.caption;
                renaming: h.renaming;
                draft: Library.heading-draft;
                edited(t) => { Library.heading-edited(t); }
                committed(t) => { Library.heading-committed(t); }
                cancelled => { Library.heading-cancelled(); }
            }
            for t in Library.tiles: TileView {
                x: t.x;
                y: t.y;
                width: t.width;
                picture-height: t.height;
                picture: t.picture;
                selected: t.selected;
                medal: t.medal;
                missing: t.missing;
                rgb: t.rgb;
            }
            if Library.drop-shown: DropLine {
                x: Library.drop-x;
                y: Library.drop-y;
                width: Library.drop-width;
                height: Library.drop-height;
            }
            if Library.ghost-shown: TileGhost {
                x: Library.ghost-x - self.width / 2;
                y: Library.ghost-y - self.height / 2;
                width: Library.ghost-width;
                height: Library.ghost-height;
                source: Library.ghost;
            }
        }
        if Library.pinned-shown: PinnedHeading {
            y: Library.pinned-y - Library.scroll;
            width: parent.width;
            title: Library.pinned-title;
            caption: Library.pinned-caption;
            renaming: Library.pinned-renaming;
            draft: Library.heading-draft;
            edited(t) => { Library.heading-edited(t); }
            committed(t) => { Library.heading-committed(t); }
            cancelled => { Library.heading-cancelled(); }
        }
    }
    // `GalleryEngine`'s ScrollView knob, over the document Rust scrolls: its drag takes the wheel's way.
    knob := ScrollKnob {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        page: root.height;
        whole: Library.content-height;
        offset: Library.scroll;
        hovered: pointer.has-hover;
        across: pointer.mouse-x;
        dragged(to) => { Library.scrolled(to - Library.scroll); }
    }
    if Library.empty-title != "": EmptyState {
        title: Library.empty-title;
        detail: Library.empty-detail;
        action: Library.empty-action;
        acted => { Library.empty-acted(); }
    }
    menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        lines: Library.menu-lines;
        chosen(i) => { if (!Library.menu-chosen(i)) { menu.close(); } }
    }
}

// `InfoSidebar`: the roll a selection stands on, or its project.
export component Info inherits Surface {
    width: ShellStyle.info-width;
    // `InfoSidebar`'s ScrollView: a tall roll scrolls under the column instead of clipping.
    Scroller {
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            if Library.info-kind == 0: VerticalLayout {
                padding: Space.m;
                Label { text: Library.info-empty; tone: Tone.secondary; }
            }
            if Library.info-kind == 1: VerticalLayout {
                Section {
                    title: "Roll";
                    separated: false;
                    EditableTitle { text: Library.info-title; placeholder: "Roll name"; committed(t) => { Library.title-committed(t); } }
                }
                Section {
                    title: "Film Stock";
                    help: "What this roll was shot on — never guessed, only ever what a hand picks.";
                    // `heroStock`: the artwork, the name, and where a default came from.
                    HorizontalLayout {
                        alignment: center;
                        StockIcon { artwork: Library.stock-artwork; has-artwork: Library.stock-has-artwork; side: StockStyle.hero; }
                    }
                    if Library.stock != "": Label { text: Library.stock; role: TextRole.title; centred: true; }
                    if Library.stock-note != "": Label { text: Library.stock-note; tone: Tone.secondary; wrap: word-wrap; centred: true; }
                    Button { text: "Select Roll Type"; clicked => { Library.select-roll-type(); } }
                }
                Section {
                    title: "Shot Date";
                    help: "When the roll was actually shot. Organisational only — never a photo's own capture date.";
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        DateFields {
                            month <=> Library.month;
                            day <=> Library.day;
                            year <=> Library.year;
                            committed(m, d, y) => { Library.shot-date-committed(m, d, y); }
                        }
                        if Library.shot-date-set: IconButton {
                            icon: Icons.reset;
                            help: "Clear shot date";
                            clicked => { Library.shot-date-cleared(); }
                        }
                    }
                    if Library.shot-date-default: Label { text: "Default, from this roll's first photo"; tone: Tone.secondary; }
                }
                Section {
                    title: "Camera Body";
                    help: "The body this roll was shot on, hand-entered — never read off a scan's own EXIF.";
                    TextField {
                        placeholder: "e.g. Leica M6";
                        text <=> Library.camera-body;
                        accepted(t) => { Library.camera-body-committed(t); }
                        left(t) => { Library.camera-body-committed(t); }
                    }
                }
            }
            if Library.info-kind == 2: VerticalLayout {
                Section {
                    title: "Project";
                    separated: false;
                    EditableTitle { text: Library.info-title; placeholder: "Project name"; committed(t) => { Library.title-committed(t); } }
                }
                CardStack { pictures: Library.stack; }
                Section {
                    title: "Film Stocks";
                    help: "Every stock among this project's own photos — counted by photo, since a project rarely holds a whole roll.";
                    if Library.stocks.length == 0: Label { text: "No stock set yet"; tone: Tone.secondary; }
                    for row in Library.stocks: HorizontalLayout {
                        spacing: Space.s;
                        StockIcon { artwork: row.artwork; has-artwork: row.has-artwork; side: StockStyle.row; }
                        Label { text: row.name; horizontal-stretch: 1; }
                        Label { text: row.count; tone: Tone.secondary; }
                    }
                }
                Section {
                    title: "Description";
                    TextArea {
                        lines-height: ShellStyle.info-description;
                        text <=> Library.description;
                        left(t) => { Library.description-committed(t); }
                    }
                }
            }
        }
    }
}
