// `DSDialogRequest.confirm`: a title, a message, Cancel and the key that goes ahead.
import { AskSheet, AskRole } from "ds/ds.slint";

export global Confirm {
    in property <bool> shown;
    in property <string> title;
    in property <string> message;
    in property <string> key;
    // Red and deaf to Return, so no stray key confirms what cannot be taken back.
    in property <bool> destructive;
    // `QuitGuard`'s alert: Cancel the default on the right, the key that goes ahead to its left.
    in property <bool> cancel-default;
    callback answered(bool);
}

// Quitting's alert lays the key that goes ahead first, Cancel last as its default.
export component ConfirmSheet inherits AskSheet {
    title: Confirm.title;
    message: Confirm.message;
    cancel: Confirm.cancel-default ? "" : @tr("CANCEL");
    keys: Confirm.cancel-default
        ? [{ text: Confirm.key, role: AskRole.option }, { text: @tr("CANCEL"), role: AskRole.confirm }]
        : [{ text: Confirm.key, role: Confirm.destructive ? AskRole.destructive : AskRole.confirm }];
    answered(i) => { Confirm.answered(i == 0); }
}
