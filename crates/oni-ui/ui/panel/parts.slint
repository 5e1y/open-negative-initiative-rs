// The pieces every tab is built from: a block wired to the store's reset, a slider wired to the
// store, the scrolled pane, the Scanner's sliders, and a tool's header.
import { Icons, Colour, Slider, SliderFill, Section, Scroller, Label, Button, ButtonKind, ButtonSize, TextRole, TabsStyle, Space, HelpMark } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { Editors } from "../editors.slint";
import { PanelState, Lab } from "state.slint";
import { KeyWords } from "../key_words.slint";

export component LabBlock inherits Section {
    modified: Lab.modified[self.block];
    reset(b) => { Lab.reset-group(b); }
}

// A Scanner slider by its index in `Lab.steps`: the letters D, C, M, Y and TEMP, then the effects,
// each resting at its zero step; its use site tells what its − and + keys move.
export component LabSlider inherits Slider {
    in property <int> index;
    stepped: true;
    help: @tr("Double-click to bring it back to rest; {} with − or + moves three steps.", KeyWords.shift);
    fill: SliderFill.bipolar;
    value: Lab.steps[root.index];
    lowest: Lab.lows[root.index];
    highest: Lab.highs[root.index];
    rest: (0 - self.lowest) / max(1, self.highest - self.lowest);
    readout: Lab.readouts[root.index];
    value-text: self.readout;
    step-reads: Lab.step-reads[root.index];
    held(on) => { Lab.hold(on); }
    step(f, by) => {
        if (root.index < 5) {
            Lab.press(root.index, by);
        } else {
            Lab.step-effect(root.index - 5, by);
        }
    }
    reset => {
        if (root.index < 5) {
            Lab.clear(root.index);
        } else {
            Lab.clear-effect(root.index - 5);
        }
    }
}

export component StoreSlider inherits Slider {
    rest: Store.rests[self.field];
    reset => { Store.rest(self.field); }
    press(f, fine) => { return Store.press(f, fine); }
    drag(f, t, s, fine) => { Store.drag(f, t, s, fine); }
    release(f) => { Store.release(f); }
    scroll(f, dx, dy, s, fine) => { return Store.scroll(f, dx, dy, s, fine); }
    step(f, d) => { Store.step(f, d); }
}

// A Store block: its fold read from `sectionFold.<title>` when it is laid, written at each toggle.
export component Block inherits Section {
    folded: PanelState.folds-read ? PanelState.fold-of(self.title, self.folded-by-default) : self.folded-by-default;
    reset(b) => { Store.reset(b); }
    fold-toggled(f) => { PanelState.fold-changed(self.title, f); }
}

// A block's row with its settings key at the far right, which shows or hides the advanced settings
// laid under it: closed until the hand opens them, out of a beginner's way and one click from reach.
export component SettingsRow inherits HorizontalLayout {
    in-out property <bool> open;
    in property <string> show-help;
    in property <string> hide-help;
    spacing: Space.s;
    @children
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        Button { has-icon: true; square: true; size: ButtonSize.mini; icon: Icons.options; help: root.open ? root.hide-help : root.show-help; clicked => { root.open = !root.open; } }
    }
}

// A block whose reset an editor owns, numbered as `Editors.reset` reads it.
export component EditorBlock inherits Section {
    reset(b) => { Editors.reset(b); }
    fold-toggled(f) => { PanelState.fold-changed(self.title, f); }
}

export component Pane inherits Scroller {
    in property <bool> shown;
    visible: self.shown;
    content-height: column.preferred-height;
    column := VerticalLayout {
        width: root.width;
        alignment: start;
        @children
    }
}

// `DetailsPane.offOnSheet`: greyed and out of reach on a sheet, the values kept.
export component DetailSlider inherits StoreSlider {
    enabled: !PanelState.sheet;
}

// A tool of the canvas, the crop or De-dust, named where the tab bar stands beside its two ways out:
// Cancel, Escape's, puts back what the tool changed on the photo; DONE, Return's, keeps it, as a sheet's.
export component ModeHeader inherits HorizontalLayout {
    in property <string> title;
    // The "?" beside the name, none when empty, and the help topic whose demo its card plays.
    in property <string> note;
    in property <string> demo;
    in property <string> help;
    in property <string> cancel-help;
    callback done();
    callback cancel();
    height: TabsStyle.height;
    spacing: Space.s;
    cross-axis-alignment: center;
    Label { text: root.title; role: TextRole.title; overflow: elide; min-width: 0; horizontal-stretch: 0; }
    if root.note != "": HelpMark { note: root.note; demo: root.demo; subject: root.title; }
    Rectangle { horizontal-stretch: 1; }
    Button { text: @tr("Cancel"); keycap: true; ground: Colour.ground; help: root.cancel-help; clicked => { root.cancel(); } }
    Button { text: @tr("DONE"); keycap: true; kind: ButtonKind.accent; help: root.help; clicked => { root.done(); } }
}
