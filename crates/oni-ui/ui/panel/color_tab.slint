// The Color tab: Pro's blocks, or the Scanner face's machine and keypad.
import { Colour, Space, SliderFill, Section, Tabs, Button, Label, TextRole, Tone, ScannerStyle, Progress, ButtonGroup, GroupAlign } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { News } from "../help.slint";
import { Editors, CurvesEditor, SpectrogramEditor, SaturationEditor } from "../editors.slint";
import { Exporting } from "../export.slint";
import { Plots, PanelState, Lab } from "state.slint";
import { LabBlock, LabSlider, StoreSlider, Block, EditorBlock, Pane } from "parts.slint";

export component ColorPane inherits Pane {
    // `labKeypad`: on the Scanner face the machine and the keypad stand where Color and Lighting stand.
    if Lab.shown: Section {
        title: @tr("Machine");
        separated: false;
        news: News.machine;
        news-note: News.machine-note;
        news-read => { News.read("machine.1.3.1"); }
        Tabs {
            tabs: [@tr("ONI"), @tr("Frontier")];
            marked: [false, false];
            selected: Lab.machine;
            picked(i) => { Lab.machine = i; Lab.machine-picked(i); }
        }
    }
    if Lab.shown: LabBlock {
        title: @tr("Density");
        block: 0;
        news: News.keypad;
        news-note: News.keypad-note;
        news-read => { News.read("keypad.1.3.1"); }
        LabSlider { index: 0; label: @tr("D"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; helps: [@tr("D −: toward dark"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("D +: toward light")]; }
    }
    if Lab.shown: LabBlock {
        title: @tr("Color");
        block: 1;
        LabSlider { index: 1; label: @tr("C"); low: ScannerStyle.band-red; high: ScannerStyle.band-cyan; helps: [@tr("C −: toward red"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("C +: toward cyan")]; }
        LabSlider { index: 2; label: @tr("M"); low: ScannerStyle.band-green; high: ScannerStyle.band-magenta; helps: [@tr("M −: toward green"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("M +: toward magenta")]; }
        LabSlider { index: 3; label: @tr("Y"); low: ScannerStyle.band-blue; high: ScannerStyle.band-yellow; helps: [@tr("Y −: toward blue"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("Y +: toward yellow")]; }
    }
    if Lab.shown: LabBlock {
        title: @tr("Look");
        block: 2;
        LabSlider { index: 4; label: @tr("TEMP"); low: ScannerStyle.band-cool; high: ScannerStyle.band-warm; helps: [@tr("TEMP −: toward cool"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("TEMP +: toward warm")]; }
    }
    // `ColorPane`: a black and white film has no colour for this block to move.
    if !Lab.shown && !PanelState.monochrome: Block {
        title: @tr("Color");
        separated: false;
        block: 0;
        modified: Store.color-modified;
        help: @tr("Auto White Balance reads the frame's light as it prints, its bright areas weighing more than a large warm subject, and corrects it with Temperature and Tint; the levels stay where the roll's measurement put them, and the Roll tab holds Balance strength, the share of that correction the two sliders take. Temperature and Tint move the colour alone and never how light the photograph is. Color density is the same control as saturation.");
        if PanelState.balancing: VerticalLayout {
            spacing: Space.xs;
            Progress { fraction: PanelState.balance-fraction; }
            Label { role: TextRole.note; text: PanelState.balance-progress; }
        }
        // `keyPlate(.balance)`: the crop's warning printed inside the plate, over the key.
        if !PanelState.balancing: ButtonGroup { plate: true;
            align: GroupAlign.fill;
            VerticalLayout {
                if PanelState.crop-first: VerticalLayout {
                    padding: Space.s;
                    Label {
                        text: @tr("Crop before using the automatic balance");
                        role: TextRole.section;
                        tone: Tone.on-fill;
                        centred: true;
                        wrap: word-wrap;
                    }
                }
                Button {
                    text: @tr("AUTO WHITE BALANCE");
                    help: @tr("The frame's light toward grey with Temperature and Tint, scaled by Balance strength");
                    clicked => { PanelState.auto-balance(); }
                }
            }
        }
        if !PanelState.balancing && PanelState.balance-note != "": Label { role: TextRole.note; text: PanelState.balance-note; }
        StoreSlider {
            field: 0; label: @tr("Temperature"); fraction: Store.temperature-fraction; readout: Store.temperature-readout; value-text: Store.temperature-value;
            fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        StoreSlider {
            field: 1; label: @tr("Tint"); fraction: Store.tint-fraction; readout: Store.tint-readout; value-text: Store.tint-value;
            fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        StoreSlider { field: 2; label: @tr("Color density (same as saturation)"); fraction: Store.color-density-fraction; readout: Store.color-density-readout; value-text: Store.color-density-value; }
    }
    // Only on a paper: in any other working space the gains do nothing.
    if Exporting.on-paper: Block {
        title: @tr("Paper Correction");
        block: 9;
        modified: Store.paper-correction-modified;
        help: @tr("Gains laid last, on a color or a black and white print alike, against the paper the picture is proofed on, and on that paper alone: in any other working space they do nothing. Auto Paper Correction reads the paper's own white off its profile, never the picture, and sets the gains that print a grey as grey; the strongest stays at 0 so nothing clips.");
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button {
                text: @tr("AUTO PAPER CORRECTION");
                help: @tr("Sets the three gains from the paper profile alone");
                clicked => { Exporting.auto-paper(); }
            }
        }
        StoreSlider {
            field: 21; label: @tr("Red"); fraction: Store.paper-red-fraction; readout: Store.paper-red-readout; value-text: Store.paper-red-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        StoreSlider {
            field: 22; label: @tr("Green"); fraction: Store.paper-green-fraction; readout: Store.paper-green-readout; value-text: Store.paper-green-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        StoreSlider {
            field: 23; label: @tr("Blue"); fraction: Store.paper-blue-fraction; readout: Store.paper-blue-readout; value-text: Store.paper-blue-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
    }
    if !Lab.shown: Block {
        title: @tr("Lighting");
        block: 1;
        news: News.lighting;
        news-note: News.lighting-note;
        news-read => { News.read("lighting.1.3.1"); }
        modified: Store.lighting-modified;
        help: @tr("The negative back to light along a straight line: the black point on pure black, the white on pure white. Every slider brightens to the right; Black point and White point move the ends of the scan itself.");
        StoreSlider { field: 3; label: @tr("Exposure"); fraction: Store.exposure-fraction; readout: Store.exposure-readout; value-text: Store.exposure-value; }
        StoreSlider { field: 4; label: @tr("Highlights"); fraction: Store.highlights-fraction; readout: Store.highlights-readout; value-text: Store.highlights-value; }
        StoreSlider { field: 5; label: @tr("Shadows"); fraction: Store.shadows-fraction; readout: Store.shadows-readout; value-text: Store.shadows-value; }
        StoreSlider {
            field: 6; label: @tr("White point"); fraction: Store.white-point-fraction; readout: Store.white-point-readout; value-text: Store.white-point-value;
            fill: SliderFill.ramp; tint: Colour.white; knob: Colour.white;
        }
        StoreSlider {
            field: 7; label: @tr("Black point"); fraction: Store.black-point-fraction; readout: Store.black-point-readout; value-text: Store.black-point-value;
            fill: SliderFill.ramp; tint: Colour.black; knob: Colour.black;
        }
    }
    if !Lab.shown: Block {
        title: @tr("Effects");
        block: 2;
        modified: Store.effects-modified;
        help: @tr("Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.");
        StoreSlider { field: 8; label: @tr("Contrast"); fraction: Store.contrast-fraction; readout: Store.contrast-readout; value-text: Store.contrast-value; }
        StoreSlider { field: 9; label: @tr("Vignette"); fraction: Store.vignette-fraction; readout: Store.vignette-readout; value-text: Store.vignette-value; }
        if !PanelState.monochrome: StoreSlider { field: 10; label: @tr("Chrome"); fraction: Store.chrome-fraction; readout: Store.chrome-readout; value-text: Store.chrome-value; fill: SliderFill.metal; }
    }
    // `LabStepKeys`: on the Scanner face its own finishing, a click a step, the title back to rest.
    if Lab.shown: LabBlock {
        title: @tr("Effects");
        news: News.effects-scanner;
        news-note: News.effects-scanner-note;
        news-read => { News.read("effects.scanner.1.3.1"); }
        block: 3;
        help: @tr("Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.");
        LabSlider { index: 5; label: @tr("Contrast"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; helps: [@tr("Contrast −: toward softer, +5 %"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("Contrast +: toward harder, +5 %")]; }
        LabSlider { index: 6; label: @tr("Vignette"); low: ScannerStyle.band-light; high: ScannerStyle.band-dark; helps: [@tr("Vignette −: toward lighter corners, +0.1 EV"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("Vignette +: toward darker corners, +0.1 EV")]; }
        if !Lab.monochrome: LabSlider { index: 7; label: @tr("Chrome"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; helps: [@tr("Chrome −: toward less, +5 %"), @tr("Double-click to bring it back to rest; ⇧ with − or + moves three steps."), @tr("Chrome +: toward more, +5 %")]; }
    }
    EditorBlock {
        title: @tr("Curves");
        block: 0;
        news: Lab.shown ? News.curves-scanner : "";
        news-note: News.curves-scanner-note;
        news-read => { News.read("curves.scanner.1.3.1"); }
        modified: Editors.curves-modified;
        folded <=> Editors.curves-folded;
        help: @tr("Curves drawn by hand, one point at a time: a channel's own tints its highlights or its shadows alone.");
        CurvesEditor { histogram: Plots.curves; revision: Plots.curves-revision; }
    }
    // The grade's blocks: a monochrome photo has no colour for them to move.
    if !Editors.monochrome: EditorBlock {
        title: @tr("Spectrogram Finishing");
        block: 2;
        modified: Editors.spectrogram-modified;
        folded <=> Editors.spectrogram-folded;
        help: @tr("Shifts one color range at a time without touching the others: turn a point around the wheel to move that color's hue, out or in to make it stronger or greyer. Click a point, then use the arrow keys.");
        SpectrogramEditor { }
    }
    if !Editors.monochrome: EditorBlock {
        title: @tr("Saturation Curve");
        block: 3;
        modified: Editors.saturation-modified;
        folded <=> Editors.saturation-folded;
        help: @tr("Saturation by light, from the black point to the white: raise a point to strengthen color in its tones, lower it toward grey. Drag a point along the light to choose its tones; double-click to return it to neutral. Brightness never moves.");
        SaturationEditor { histogram: Plots.saturation; revision: Plots.saturation-revision; }
    }
}
