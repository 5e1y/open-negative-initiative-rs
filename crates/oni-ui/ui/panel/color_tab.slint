// The Color tab: Pro's blocks, or the Scanner face's machine and keypad.
import { Colour, Space, SliderFill, Knob, Section, Tabs, Button, Label, TextRole, ScannerStyle, Keypad, Note, Progress } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { News } from "../help.slint";
import { Editors, CurvesEditor, SpectrogramEditor, SaturationEditor } from "../editors.slint";
import { Exporting } from "../export.slint";
import { Plots, PanelState, Lab } from "state.slint";
import { LabBlock, LetterRow, EffectRow, StoreSlider, Block, EditorBlock, Pane } from "parts.slint";

export component ColorPane inherits Pane {
    // `labKeypad`: on the Scanner face the machine and the keypad stand where Color and Lighting stand.
    if Lab.shown: Section {
        title: "Machine";
        separated: false;
        news: News.machine;
        news-note: News.machine-note;
        news-read => { News.read("machine.1.3.1"); }
        Tabs {
            tabs: ["ONI", "Frontier"];
            marked: [false, false];
            selected <=> Lab.machine;
            picked(i) => { Lab.machine-picked(i); }
        }
    }
    if Lab.shown: LabBlock {
        title: "Density";
        block: 0;
        news: News.keypad;
        news-note: News.keypad-note;
        news-read => { News.read("keypad.1.3.1"); }
        Keypad {
            LetterRow { letter: 0; title: "D"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["D −3: toward dark", "D −: toward dark", "", "D +: toward light", "D +3: toward light"]; }
        }
    }
    if Lab.shown: LabBlock {
        title: "Color";
        block: 1;
        Keypad {
            LetterRow { letter: 1; title: "C"; minus: ScannerStyle.band-red; plus: ScannerStyle.band-cyan; helps: ["C −3: toward red", "C −: toward red", "", "C +: toward cyan", "C +3: toward cyan"]; }
            LetterRow { letter: 2; title: "M"; minus: ScannerStyle.band-green; plus: ScannerStyle.band-magenta; helps: ["M −3: toward green", "M −: toward green", "", "M +: toward magenta", "M +3: toward magenta"]; }
            LetterRow { letter: 3; title: "Y"; minus: ScannerStyle.band-blue; plus: ScannerStyle.band-yellow; helps: ["Y −3: toward blue", "Y −: toward blue", "", "Y +: toward yellow", "Y +3: toward yellow"]; }
        }
    }
    if Lab.shown: LabBlock {
        title: "Look";
        block: 2;
        Keypad {
            LetterRow { letter: 4; title: "TEMP"; minus: ScannerStyle.band-cool; plus: ScannerStyle.band-warm; helps: ["TEMP −3: toward cool", "TEMP −: toward cool", "", "TEMP +: toward warm", "TEMP +3: toward warm"]; }
        }
    }
    if !Lab.shown: Block {
        title: "Color";
        separated: false;
        block: 0;
        modified: Store.color-modified;
        help: "Auto White Balance reads the frame's light as it prints, its bright areas weighing more than a large warm subject, and corrects it with Temperature and Tint; the levels stay where the roll's measurement put them, and the Roll tab holds Balance strength, the share of that correction the two sliders take. Temperature and Tint move the colour alone and never how light the photograph is. Color density is the same control as saturation.";
        if PanelState.crop-first: Label {
            text: "Crop before using the automatic balance";
            role: TextRole.section;
            centred: true;
            wrap: word-wrap;
        }
        if PanelState.balancing: VerticalLayout {
            spacing: Space.xs;
            Progress { fraction: PanelState.balance-fraction; }
            Note { text: PanelState.balance-progress; }
        }
        if !PanelState.balancing: Button {
            text: "AUTO WHITE BALANCE";
            help: "The frame's light toward grey with Temperature and Tint, scaled by Balance strength";
            horizontal-stretch: 1;
            clicked => { PanelState.auto-balance(); }
        }
        if !PanelState.balancing && PanelState.balance-note != "": Note { text: PanelState.balance-note; }
        StoreSlider {
            field: 0; label: "Temperature"; fraction: Store.temperature-fraction; readout: Store.temperature-readout; value-text: Store.temperature-value;
            fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        StoreSlider {
            field: 1; label: "Tint"; fraction: Store.tint-fraction; readout: Store.tint-readout; value-text: Store.tint-value;
            fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        StoreSlider { field: 2; label: "Color density (same as saturation)"; fraction: Store.color-density-fraction; readout: Store.color-density-readout; value-text: Store.color-density-value; }
    }
    // Only on a paper: in any other working space the gains do nothing.
    if Exporting.on-paper: Block {
        title: "Paper Correction";
        block: 9;
        modified: Store.paper-correction-modified;
        help: "Gains laid last, on a color or a black and white print alike, against the paper the picture is proofed on, and on that paper alone: in any other working space they do nothing. Auto Paper Correction reads the paper's own white off its profile, never the picture, and sets the gains that print a grey as grey; the strongest stays at 0 so nothing clips.";
        Button {
            text: "Auto Paper Correction";
            help: "Sets the three gains from the paper profile alone";
            horizontal-stretch: 1;
            clicked => { Exporting.auto-paper(); }
        }
        StoreSlider {
            field: 21; label: "Red"; fraction: Store.paper-red-fraction; readout: Store.paper-red-readout; value-text: Store.paper-red-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        StoreSlider {
            field: 22; label: "Green"; fraction: Store.paper-green-fraction; readout: Store.paper-green-readout; value-text: Store.paper-green-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        StoreSlider {
            field: 23; label: "Blue"; fraction: Store.paper-blue-fraction; readout: Store.paper-blue-readout; value-text: Store.paper-blue-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
    }
    if !Lab.shown: Block {
        title: "Lighting";
        block: 1;
        news: News.lighting;
        news-note: News.lighting-note;
        news-read => { News.read("lighting.1.3.1"); }
        modified: Store.lighting-modified;
        help: "The negative back to light along a straight line: the black point on pure black, the white on pure white. Every slider brightens to the right; Black point and White point move the ends of the scan itself.";
        StoreSlider { field: 3; label: "Exposure"; fraction: Store.exposure-fraction; readout: Store.exposure-readout; value-text: Store.exposure-value; }
        StoreSlider { field: 4; label: "Highlights"; fraction: Store.highlights-fraction; readout: Store.highlights-readout; value-text: Store.highlights-value; }
        StoreSlider { field: 5; label: "Shadows"; fraction: Store.shadows-fraction; readout: Store.shadows-readout; value-text: Store.shadows-value; }
        StoreSlider {
            field: 6; label: "White point"; fraction: Store.white-point-fraction; readout: Store.white-point-readout; value-text: Store.white-point-value;
            fill: SliderFill.ramp; tint: Colour.white; knob: Knob.white;
        }
        StoreSlider {
            field: 7; label: "Black point"; fraction: Store.black-point-fraction; readout: Store.black-point-readout; value-text: Store.black-point-value;
            fill: SliderFill.ramp; tint: Colour.black; knob: Knob.black;
        }
    }
    if !Lab.shown: Block {
        title: "Effects";
        block: 2;
        modified: Store.effects-modified;
        help: "Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.";
        StoreSlider { field: 8; label: "Contrast"; fraction: Store.contrast-fraction; readout: Store.contrast-readout; value-text: Store.contrast-value; }
        StoreSlider { field: 9; label: "Vignette"; fraction: Store.vignette-fraction; readout: Store.vignette-readout; value-text: Store.vignette-value; }
        StoreSlider { field: 10; label: "Chrome"; fraction: Store.chrome-fraction; readout: Store.chrome-readout; value-text: Store.chrome-value; fill: SliderFill.metal; }
    }
    // `LabStepKeys`: on the Scanner face its own finishing, a click a step, the title back to rest.
    if Lab.shown: LabBlock {
        title: "Effects";
        news: News.effects-scanner;
        news-note: News.effects-scanner-note;
        news-read => { News.read("effects.scanner.1.3.1"); }
        block: 3;
        help: "Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.";
        Keypad {
            EffectRow { effect: 0; title: "CONTRAST"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["Contrast −3: toward softer, +15 %", "Contrast −: toward softer, +5 %", "Contrast back to 0 %", "Contrast +: toward harder, +5 %", "Contrast +3: toward harder, +15 %"]; }
        }
        Keypad {
            EffectRow { effect: 1; title: "VIGNETTE"; minus: ScannerStyle.band-light; plus: ScannerStyle.band-dark; helps: ["Vignette −3: toward lighter corners, +0.3 EV", "Vignette −: toward lighter corners, +0.1 EV", "Vignette back to 0 EV", "Vignette +: toward darker corners, +0.1 EV", "Vignette +3: toward darker corners, +0.3 EV"]; }
        }
        if !Lab.monochrome: Keypad {
            EffectRow { effect: 2; title: "CHROME"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["Chrome −3: toward less, +15 %", "Chrome −: toward less, +5 %", "Chrome back to 0 %", "Chrome +: toward more, +5 %", "Chrome +3: toward more, +15 %"]; }
        }
    }
    EditorBlock {
        title: "Curves";
        block: 0;
        news: Lab.shown ? News.curves-scanner : "";
        news-note: News.curves-scanner-note;
        news-read => { News.read("curves.scanner.1.3.1"); }
        modified: Editors.curves-modified;
        folded <=> Editors.curves-folded;
        help: "Curves drawn by hand, one point at a time: a channel's own tints its highlights or its shadows alone.";
        CurvesEditor { histogram: Plots.curves; }
    }
    // The grade's blocks: a monochrome photo has no colour for them to move.
    if !Editors.monochrome: EditorBlock {
        title: "Spectrogram Finishing";
        block: 2;
        modified: Editors.spectrogram-modified;
        folded <=> Editors.spectrogram-folded;
        help: "Shifts one color range at a time without touching the others: turn a point around the wheel to move that color's hue, out or in to make it stronger or greyer. Click a point, then use the arrow keys.";
        SpectrogramEditor { }
    }
    if !Editors.monochrome: EditorBlock {
        title: "Saturation Curve";
        block: 3;
        modified: Editors.saturation-modified;
        folded <=> Editors.saturation-folded;
        help: "Saturation by light, from the black point to the white: raise a point to strengthen color in its tones, lower it toward grey. Drag a point along the light to choose its tones; double-click to return it to neutral. Brightness never moves.";
        SaturationEditor { histogram: Plots.saturation; }
    }
}
