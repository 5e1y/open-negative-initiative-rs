// The Color tab: Colour, Lighting with the print, Effects, then the editors.
import { Colour, Space, SliderFill, Section, SectionStyle, Tabs, Button, Label, TextRole, Tone, ButtonGroup, GroupAlign, Toggle, Field, Picker, HelpMark } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { News } from "../help.slint";
import { Editors, CurvesEditor, SpectrogramEditor, SaturationEditor } from "../editors.slint";
import { Exporting } from "../export.slint";
import { Plots, PanelState, RollState } from "state.slint";
import { StoreSlider, Block, EditorBlock, Pane, SettingsRow } from "parts.slint";
import { FilmBlock } from "film_block.slint";

// Lighting's colour compensation and the paper the negative prints on, laid at Lighting's end: the switches, then the
// paper by its name, the enlarger's filtration and True blacks while it prints, then a legacy print where one is kept.
// A paper lays no colour compensation, so its switch shows on ONI's print alone.
component PrintRows inherits VerticalLayout {
    spacing: Space.s;
    if !PanelState.monochrome && !(PanelState.paper-shown && PanelState.paper-on): HorizontalLayout {
        spacing: Space.xs;
        Toggle {
            label: @tr("Colour compensation");
            on: PanelState.colour-compensation;
            toggled(on) => { PanelState.colour-compensation-toggled(on); }
        }
        VerticalLayout {
            alignment: center;
            HelpMark {
                subject: @tr("Colour compensation");
                note: @tr("The colour the print lays in answer to Lighting's tones: Exposure and the zones lower the colour density as the print brightens, Contrast and the points lay saturation curves, drawn dashed on the Saturation Curve, and the points hold the colour they stretch. On ONI's print, whose curve rests a stop and a half up, the density acts at rest too.\n\nOff, the sliders bend each channel's tone alone: the luma moves as before, the colour as each channel's curve gives it, so Contrast and the points change its strength.");
            }
        }
    }
    if PanelState.paper-shown: Toggle { label: @tr("Print on paper"); on: PanelState.paper-on; toggled(on) => { PanelState.paper-toggled(on); } }
    if PanelState.paper-shown && PanelState.paper-on: Field {
        label: @tr("Paper");
        Picker {
            value: PanelState.paper-title;
            lines: PanelState.paper-lines;
            chosen(i) => { PanelState.paper-chosen(i); }
        }
    }
    if PanelState.paper-shown && PanelState.paper-on: Label { role: TextRole.note; text: PanelState.paper-filtration; }
    if PanelState.paper-shown && PanelState.paper-on: HorizontalLayout {
        spacing: Space.xs;
        Toggle {
            label: @tr("True blacks");
            on: PanelState.true-blacks;
            toggled(on) => { PanelState.true-blacks-toggled(on); }
        }
        VerticalLayout {
            alignment: center;
            HelpMark {
                subject: @tr("True blacks");
                note: @tr("The black picked in Prepare the Roll printed on pure black, the paper's white kept and the tones between stretched evenly, as a print is shown on a screen. Off, that black prints where the paper lays it at rest, a hair above its own black. Lighting never lifts it; only Black point moves it.");
            }
        }
    }
    // A photo edited on the former Scanner face keeps the print it was edited on, switchable and kept off.
    if PanelState.legacy-title != "": HorizontalLayout {
        spacing: Space.xs;
        Toggle {
            label: PanelState.legacy-title;
            on: PanelState.legacy-laid;
            toggled(on) => { PanelState.legacy-toggled(on); }
        }
        VerticalLayout {
            alignment: center;
            HelpMark {
                subject: PanelState.legacy-title;
                note: @tr("This photo was edited on the former Scanner face and keeps its print as that face laid it: the machine's look over ONI's print, or on a paper its keys alone, with the keypad's D, C, M, Y and TEMP read below. Off, the photo prints as the sliders above say, and the legacy print is kept to be laid again; a photo never edited there has none.");
            }
        }
    }
    if PanelState.legacy-title != "": Label { role: TextRole.note; text: PanelState.legacy-keys; }
}

export component ColorPane inherits Pane {
    property <bool> balance-settings;
    // The channel More Color Settings shows, red first.
    property <int> channel-tab;
    // A digital photo's film, as it decides what it prints.
    if PanelState.digital: FilmBlock {}
    // The colour first, then the light with its contrast, then the effects.
    // `ColorPane`: a black and white film has no colour for this block to move.
    if !PanelState.monochrome: colour-block := Block {
        title: @tr("Colour");
        separated: false;
        block: 0;
        modified: Store.color-modified;
        demo: "white-balance";
        help: PanelState.filtration-cmy ? @tr("Auto White Balance reads the frame's light as it prints, its bright areas weighing most, and turns it toward grey with the filters. Auto White Balance Strength is the share of that correction they take: each photo keeps its own correction, the share is the roll's.\n\nC, M and Y are an enlarger's cyan, magenta and yellow filters in CC, each taking its own band of light, thirty CC a stop: more C prints redder, more M greener, more Y bluer. The least stays at none, as on an enlarger, and none changes how light the photograph is. Settings shows them as Temperature and Tint instead, the same values.\n\nSaturation makes every colour stronger or greyer at once.") : @tr("Auto White Balance reads the frame's light as it prints, its bright areas weighing most, and turns it toward grey with Temperature and Tint. Auto White Balance Strength is the share of that correction they take: each photo keeps its own correction, the share is the roll's.\n\nTemperature moves the colour between blue and yellow, Tint between green and magenta; neither changes how light the photograph is.\n\nSaturation makes every colour stronger or greyer at once.");
        SettingsRow {
            open <=> root.balance-settings;
            show-help: @tr("Show Auto White Balance Strength");
            hide-help: @tr("Hide Auto White Balance Strength");
            // The crop's warning over the key's plate. A run keeps the key in place, idle, and counts in the
            // status bar, so the panel never jumps.
            VerticalLayout {
                spacing: Space.xs;
                // Over the plate, which holds its keycap alone: a wrapped line inside it would outgrow the socket.
                if PanelState.crop-first: Label {
                    text: @tr("Crop before using the automatic balance");
                    role: TextRole.note;
                    tone: Tone.caution;
                    wrap: word-wrap;
                }
                ButtonGroup { plate: true;
                    Button {
                        text: @tr("AUTO WHITE BALANCE");
                        keycap: true;
                        help: @tr("The frame's light toward grey with Temperature and Tint, scaled by Auto White Balance Strength");
                        enabled: !PanelState.balancing;
                        clicked => { PanelState.auto-balance(); }
                    }
                }
            }
        }
        if PanelState.balance-note != "": Label { role: TextRole.note; text: PanelState.balance-note; }
        // The key's dose, behind its settings key; the roll's, so it says which photos it reaches. Its
        // reset is its own double click: the block's would rewrite every photo of the roll.
        if root.balance-settings: StoreSlider { field: 11; label: @tr("Auto White Balance Strength"); fraction: Store.balance-strength-fraction; readout: Store.balance-strength-readout; value-text: Store.balance-strength-value; }
        if root.balance-settings && !PanelState.digital && PanelState.roll-state == RollState.prepared && PanelState.roll-measured > 1: Label {
            role: TextRole.note;
            text: @tr("Shared by the {} photos of this roll.", PanelState.roll-measured);
        }
        if !PanelState.filtration-cmy: StoreSlider {
            near: colour-block.hovered;
            field: 0; label: @tr("Temperature"); fraction: Store.temperature-fraction; readout: Store.temperature-readout; value-text: Store.temperature-value;
            fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        if !PanelState.filtration-cmy: StoreSlider {
            near: colour-block.hovered;
            field: 1; label: @tr("Tint"); fraction: Store.tint-fraction; readout: Store.tint-readout; value-text: Store.tint-value;
            fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        // The same filters as an enlarger's C, M and Y, each from none: its own colour's ramp.
        if PanelState.filtration-cmy: StoreSlider {
            near: colour-block.hovered;
            field: 57; label: @tr("C"); fraction: Store.cyan-fraction; readout: Store.cyan-readout; value-text: Store.cyan-value;
            fill: SliderFill.ramp; tint: Colour.channel-cyan;
        }
        if PanelState.filtration-cmy: StoreSlider {
            near: colour-block.hovered;
            field: 58; label: @tr("M"); fraction: Store.magenta-fraction; readout: Store.magenta-readout; value-text: Store.magenta-value;
            fill: SliderFill.ramp; tint: Colour.channel-magenta;
        }
        if PanelState.filtration-cmy: StoreSlider {
            near: colour-block.hovered;
            field: 59; label: @tr("Y"); fraction: Store.yellow-fraction; readout: Store.yellow-readout; value-text: Store.yellow-value;
            fill: SliderFill.ramp; tint: Colour.channel-yellow;
        }
        StoreSlider { field: 2; label: @tr("Saturation"); fraction: Store.color-density-fraction; readout: Store.color-density-readout; value-text: Store.color-density-value; }
    }
    // Each channel's own ends and tone, a block of their own folded until the hand opens it, one channel
    // a tab: its white and black points, then its mids and contrast, as Lighting lays them.
    if !PanelState.monochrome: points-block := Block {
        title: @tr("More Color Settings");
        folded-by-default: true;
        block: 11;
        modified: Store.channel-points-modified;
        help: @tr("Each channel's own white point, black point, mids and contrast, laid on top of Lighting's, one channel a tab: a channel's white point brightens it in the highlights, its black point darkens it in the shadows, its mids lift or lower its middle tones and its contrast steepens or softens it about a middle grey, so the channel takes a colour of its own. A dot marks a tab whose channel moved; Reset returns the three channels.");
        Tabs {
            tabs: [@tr("R"), @tr("G"), @tr("B")];
            marked: Store.channel-marked;
            selected: root.channel-tab;
            picked(i) => { root.channel-tab = i; }
        }
        if root.channel-tab == 0: StoreSlider {
            near: points-block.hovered;
            field: 32; label: @tr("Red white point"); fraction: Store.red-white-point-fraction; readout: Store.red-white-point-readout; value-text: Store.red-white-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-red;
        }
        if root.channel-tab == 0: StoreSlider {
            near: points-block.hovered;
            field: 35; label: @tr("Red black point"); fraction: Store.red-black-point-fraction; readout: Store.red-black-point-readout; value-text: Store.red-black-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-red;
        }
        if root.channel-tab == 0: StoreSlider {
            near: points-block.hovered;
            field: 47; label: @tr("Red mid"); fraction: Store.red-mid-fraction; readout: Store.red-mid-readout; value-text: Store.red-mid-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        if root.channel-tab == 0: StoreSlider { field: 50; label: @tr("Red contrast"); fraction: Store.red-contrast-fraction; readout: Store.red-contrast-readout; value-text: Store.red-contrast-value; }
        if root.channel-tab == 1: StoreSlider {
            near: points-block.hovered;
            field: 33; label: @tr("Green white point"); fraction: Store.green-white-point-fraction; readout: Store.green-white-point-readout; value-text: Store.green-white-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-green;
        }
        if root.channel-tab == 1: StoreSlider {
            near: points-block.hovered;
            field: 36; label: @tr("Green black point"); fraction: Store.green-black-point-fraction; readout: Store.green-black-point-readout; value-text: Store.green-black-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-green;
        }
        if root.channel-tab == 1: StoreSlider {
            near: points-block.hovered;
            field: 48; label: @tr("Green mid"); fraction: Store.green-mid-fraction; readout: Store.green-mid-readout; value-text: Store.green-mid-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        if root.channel-tab == 1: StoreSlider { field: 51; label: @tr("Green contrast"); fraction: Store.green-contrast-fraction; readout: Store.green-contrast-readout; value-text: Store.green-contrast-value; }
        if root.channel-tab == 2: StoreSlider {
            near: points-block.hovered;
            field: 34; label: @tr("Blue white point"); fraction: Store.blue-white-point-fraction; readout: Store.blue-white-point-readout; value-text: Store.blue-white-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-blue;
        }
        if root.channel-tab == 2: StoreSlider {
            near: points-block.hovered;
            field: 37; label: @tr("Blue black point"); fraction: Store.blue-black-point-fraction; readout: Store.blue-black-point-readout; value-text: Store.blue-black-point-value;
            fill: SliderFill.ramp; tint: Colour.channel-blue;
        }
        if root.channel-tab == 2: StoreSlider {
            near: points-block.hovered;
            field: 49; label: @tr("Blue mid"); fraction: Store.blue-mid-fraction; readout: Store.blue-mid-readout; value-text: Store.blue-mid-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
        if root.channel-tab == 2: StoreSlider { field: 52; label: @tr("Blue contrast"); fraction: Store.blue-contrast-fraction; readout: Store.blue-contrast-readout; value-text: Store.blue-contrast-value; }
    }
    Block {
        title: @tr("Lighting");
        // Without the colour block above, the light leads the tab.
        separated: !PanelState.monochrome;
        demo: "lighting";
        block: 1;
        news: News.lighting;
        news-note: News.lighting-note;
        news-read => { News.read("lighting.1.3.1"); }
        modified: Store.lighting-modified;
        help: @tr("The negative back to light along a straight line: the black point on pure black, the white on pure white.\n\nEvery slider but Contrast brightens to the right; Contrast bends the print into an S about a middle grey, its ends held. Black point and White point move the ends of the scan itself.\n\nOn paper the sliders act as in a darkroom, the black picked in Prepare the Roll held: Exposure is the enlarger's light, Temperature and Tint its filters, Contrast the paper's grade. Brightness lightens the print between that black and the white.");
        StoreSlider { field: 3; label: @tr("Exposure"); fraction: Store.exposure-fraction; readout: Store.exposure-readout; value-text: Store.exposure-value; }
        // A paper's print brightened between its own black and white; on ONI's print Exposure is that curve.
        if PanelState.paper-shown && PanelState.paper-on: StoreSlider { field: 56; label: @tr("Brightness"); fraction: Store.brightness-fraction; readout: Store.brightness-readout; value-text: Store.brightness-value; }
        StoreSlider { field: 8; label: @tr("Contrast"); fraction: Store.contrast-fraction; readout: Store.contrast-readout; value-text: Store.contrast-value; }
        StoreSlider { field: 4; label: @tr("Highlights"); fraction: Store.highlights-fraction; readout: Store.highlights-readout; value-text: Store.highlights-value; }
        StoreSlider { field: 5; label: @tr("Shadows"); fraction: Store.shadows-fraction; readout: Store.shadows-readout; value-text: Store.shadows-value; }
        StoreSlider {
            field: 6; label: @tr("White point"); fraction: Store.white-point-fraction; readout: Store.white-point-readout; value-text: Store.white-point-value;
            fill: SliderFill.ramp; tint: Colour.white; knob: Colour.white;
        }
        StoreSlider {
            field: 7; label: @tr("Black point"); fraction: Store.black-point-fraction; readout: Store.black-point-readout; value-text: Store.black-point-value;
            fill: SliderFill.ramp; tint: Colour.black; knob: Colour.black;
        }
        PrintRows {}
    }
    // Only on a paper: in any other working space the gains do nothing.
    if Exporting.on-paper: paper-block := Block {
        title: @tr("Paper Correction");
        demo: "paper-correction";
        block: 8;
        modified: Store.paper-correction-modified;
        help: @tr("Red, Green and Blue are gains laid last, on a colour or a black and white print alike, for the paper the picture is proofed on; in any other working space they do nothing.\n\nAuto Paper Correction reads the paper's own white off its profile, never the picture, and sets the gains that print a grey as grey. The strongest stays at 0, so nothing clips.");
        ButtonGroup { plate: true;
            Button {
                text: @tr("AUTO PAPER CORRECTION");
                keycap: true;
                help: @tr("Sets the three gains from the paper profile alone");
                clicked => { Exporting.auto-paper(); }
            }
        }
        StoreSlider {
            near: paper-block.hovered;
            field: 21; label: @tr("Red"); fraction: Store.paper-red-fraction; readout: Store.paper-red-readout; value-text: Store.paper-red-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        StoreSlider {
            near: paper-block.hovered;
            field: 22; label: @tr("Green"); fraction: Store.paper-green-fraction; readout: Store.paper-green-readout; value-text: Store.paper-green-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        StoreSlider {
            near: paper-block.hovered;
            field: 23; label: @tr("Blue"); fraction: Store.paper-blue-fraction; readout: Store.paper-blue-readout; value-text: Store.paper-blue-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
    }
    Block {
        title: @tr("Effects");
        demo: "effects";
        block: 2;
        modified: Store.effects-modified;
        help: @tr("Vignette darkens the corners in stops, without shifting their colour; below zero it lightens them.\n\nChrome lays a saturation curve over everything, greying the ends and keeping colour in the middle.");
        StoreSlider { field: 9; label: @tr("Vignette"); fraction: Store.vignette-fraction; readout: Store.vignette-readout; value-text: Store.vignette-value; }
        if !PanelState.monochrome: StoreSlider { field: 10; label: @tr("Chrome"); fraction: Store.chrome-fraction; readout: Store.chrome-readout; value-text: Store.chrome-value; fill: SliderFill.metal; }
    }
    // A digital photo's alone (owner's call), as the render lays them on no film mode.
    if PanelState.digital: Block {
        title: @tr("Film Effects");
        block: 12;
        modified: Store.film-effects-modified;
        help: @tr("Grain lays a film-like texture over the scene, its grains of every strength drawn whole, more contrasted with Grain, coarser with Grain size, arranged anew on each photo; it stays on the photo as it is cropped, turned or zoomed. A coarse grain takes in the detail finer than a grain inside its clumps, and leaves it sharp between them.\n\nHalation lays the film's red glow around the brightest highlights, the light that crossed the base and came back to the red layer; Halation size widens it, Halation sensitivity lets dimmer light glow too, or only the brightest.\n\nBoth act on the scene before Lighting and Colour, as on the film.");
        StoreSlider { field: 38; label: @tr("Grain"); fraction: Store.grain-amount-fraction; readout: Store.grain-amount-readout; value-text: Store.grain-amount-value; }
        StoreSlider { field: 39; label: @tr("Grain size"); fraction: Store.grain-size-fraction; readout: Store.grain-size-readout; value-text: Store.grain-size-value; }
        StoreSlider { field: 40; label: @tr("Halation"); fraction: Store.halation-amount-fraction; readout: Store.halation-amount-readout; value-text: Store.halation-amount-value; }
        StoreSlider { field: 41; label: @tr("Halation size"); fraction: Store.halation-size-fraction; readout: Store.halation-size-readout; value-text: Store.halation-size-value; }
        StoreSlider { field: 46; label: @tr("Halation sensitivity"); fraction: Store.halation-sensitivity-fraction; readout: Store.halation-sensitivity-readout; value-text: Store.halation-sensitivity-value; }
    }
    EditorBlock {
        title: @tr("Curves");
        demo: "curves";
        block: 0;
        modified: Editors.curves-modified;
        folded <=> Editors.curves-folded;
        help: @tr("Curves drawn by hand, one point at a time: a channel's own tints its highlights or its shadows alone.");
        CurvesEditor { histogram: Plots.curves; revision: Plots.curves-revision; }
    }
    // The grade's blocks: a monochrome photo has no colour for them to move.
    if !Editors.monochrome: bands-block := EditorBlock {
        title: @tr("Colour Mixer");
        demo: "spectrogram";
        block: 2;
        modified: Editors.spectrogram-modified;
        folded <=> Editors.spectrogram-folded;
        help: @tr("Spectrogram finishing: shifts one colour range at a time without touching the others.\n\nTurn a point around the wheel to move that colour's hue, out or in to make it stronger or greyer. Click a point, then use the arrow keys.");
        SpectrogramEditor { near: bands-block.hovered; }
    }
    if !Editors.monochrome: EditorBlock {
        title: @tr("Saturation Curve");
        demo: "saturation-curve";
        block: 3;
        modified: Editors.saturation-modified;
        folded <=> Editors.saturation-folded;
        help: @tr("Saturation by light, from the black point to the white: raise a point to strengthen colour in its tones, lower it toward grey. Brightness never moves.\n\nDrag a point along the light to choose its tones; double-click to return it to neutral.\n\nThe dashed line is the saturation the print lays by itself: Contrast's, which keeps each tone's colour as Contrast steepens or softens it, and the black and white points'; none while Lighting's Colour compensation is off.");
        SaturationEditor { histogram: Plots.saturation; revision: Plots.saturation-revision; }
    }
}
