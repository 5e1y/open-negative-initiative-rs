// The Color tab: Pro's blocks, or the Scanner face's machine and keypad.
import { Colour, Space, SliderFill, Section, SectionStyle, Tabs, Button, Label, TextRole, Tone, ScannerStyle, ButtonGroup, GroupAlign } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { News } from "../help.slint";
import { Editors, CurvesEditor, SpectrogramEditor, SaturationEditor } from "../editors.slint";
import { Exporting } from "../export.slint";
import { Plots, PanelState, Lab } from "state.slint";
import { LabBlock, LabSlider, StoreSlider, Block, EditorBlock, Pane } from "parts.slint";

export component ColorPane inherits Pane {
    // What the face holds, in the words of the switch's tooltip, so its name needs no hover to read.
    VerticalLayout {
        padding-left: SectionStyle.inset;
        padding-right: SectionStyle.inset;
        padding-top: SectionStyle.before;
        Label {
            role: TextRole.note;
            text: Lab.shown ? @tr("Scanner: a minilab's density and colour, in steps") : @tr("Pro: every setting by hand, the place to start");
        }
    }
    // `labKeypad`: on the Scanner face the machine and the keypad stand where Color and Lighting stand.
    if Lab.shown: Section {
        title: @tr("Machine");
        help: @tr("The machine the Scanner face prints with: ONI, the roll's conversion under ONI's own look, or the Frontier, the same conversion under the minilab's look. The keypad and the effects act on either.\n\nThe Roll tab and Auto White Balance's correction act on both faces; Pro's Lighting, Colour and Effects sliders stay Pro's own.");
        separated: false;
        news: News.machine;
        news-note: News.machine-note;
        news-read => { News.read("machine.1.3.1"); }
        Tabs {
            tabs: [@tr("ONI"), @tr("Frontier")];
            marked: [false, false];
            selected: Lab.machine;
            picked(i) => { Lab.machine = i; Lab.machine-picked(i); }
        }
    }
    if Lab.shown: LabBlock {
        title: @tr("Density");
        help: @tr("D, a minilab's density key: + prints the photo lighter and − darker, half a point a step, the screen above counting the points.");
        block: 0;
        news: News.keypad;
        news-note: News.keypad-note;
        news-read => { News.read("keypad.1.3.1"); }
        LabSlider { index: 0; label: @tr("D"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; minus-help: @tr("D −: toward dark"); plus-help: @tr("D +: toward light"); }
    }
    if Lab.shown: LabBlock {
        title: @tr("Colour");
        help: @tr("C, M and Y, a minilab's colour keys: + moves the print toward cyan, magenta or yellow and − toward red, green or blue, half a point a step, the screen above counting the points.");
        block: 1;
        LabSlider { index: 1; label: @tr("C"); low: ScannerStyle.band-red; high: ScannerStyle.band-cyan; minus-help: @tr("C −: toward red"); plus-help: @tr("C +: toward cyan"); }
        LabSlider { index: 2; label: @tr("M"); low: ScannerStyle.band-green; high: ScannerStyle.band-magenta; minus-help: @tr("M −: toward green"); plus-help: @tr("M +: toward magenta"); }
        LabSlider { index: 3; label: @tr("Y"); low: ScannerStyle.band-blue; high: ScannerStyle.band-yellow; minus-help: @tr("Y −: toward blue"); plus-help: @tr("Y +: toward yellow"); }
    }
    if Lab.shown: LabBlock {
        title: @tr("Look");
        help: @tr("TEMP lays the machine's warm or cool look over the print, a little more at each step; at zero the print stays as the keys above set it.");
        block: 2;
        LabSlider { index: 4; label: @tr("Temperature"); low: ScannerStyle.band-cool; high: ScannerStyle.band-warm; minus-help: @tr("Temperature −: toward cool"); plus-help: @tr("Temperature +: toward warm"); }
    }
    // A photographer's order: the light and its contrast first, then the colour, then the effects.
    if !Lab.shown: Block {
        title: @tr("Lighting");
        separated: false;
        demo: "lighting";
        block: 1;
        news: News.lighting;
        news-note: News.lighting-note;
        news-read => { News.read("lighting.1.3.1"); }
        modified: Store.lighting-modified;
        help: @tr("The negative back to light along a straight line: the black point on pure black, the white on pure white.\n\nEvery slider but Contrast brightens to the right; Contrast bends the print into an S about a middle grey, its ends held. Black point and White point move the ends of the scan itself.");
        StoreSlider { field: 3; label: @tr("Exposure"); fraction: Store.exposure-fraction; readout: Store.exposure-readout; value-text: Store.exposure-value; }
        StoreSlider { field: 8; label: @tr("Contrast"); fraction: Store.contrast-fraction; readout: Store.contrast-readout; value-text: Store.contrast-value; }
        StoreSlider { field: 4; label: @tr("Highlights"); fraction: Store.highlights-fraction; readout: Store.highlights-readout; value-text: Store.highlights-value; }
        StoreSlider { field: 5; label: @tr("Shadows"); fraction: Store.shadows-fraction; readout: Store.shadows-readout; value-text: Store.shadows-value; }
        StoreSlider {
            field: 6; label: @tr("White point"); fraction: Store.white-point-fraction; readout: Store.white-point-readout; value-text: Store.white-point-value;
            fill: SliderFill.ramp; tint: Colour.white; knob: Colour.white;
        }
        StoreSlider {
            field: 7; label: @tr("Black point"); fraction: Store.black-point-fraction; readout: Store.black-point-readout; value-text: Store.black-point-value;
            fill: SliderFill.ramp; tint: Colour.black; knob: Colour.black;
        }
    }
    // `ColorPane`: a black and white film has no colour for this block to move.
    if !Lab.shown && !PanelState.monochrome: Block {
        title: @tr("Colour");
        block: 0;
        modified: Store.color-modified;
        demo: "white-balance";
        help: @tr("Auto White Balance reads the frame's light as it prints, its bright areas weighing most, and turns it toward grey with Temperature and Tint. Balance strength is the share of that correction they take: each photo keeps its own correction, the share is the roll's.\n\nTemperature moves the colour between blue and yellow, Tint between green and magenta; neither changes how light the photograph is.\n\nSaturation makes every colour stronger or greyer at once.");
        // `keyPlate(.balance)`: the crop's warning printed inside the plate, over the key. A run keeps the
        // key in place, idle, and counts in the status bar, so the panel never jumps.
        ButtonGroup { plate: true;
            VerticalLayout {
                if PanelState.crop-first: VerticalLayout {
                    padding: Space.s;
                    Label {
                        text: @tr("Crop before using the automatic balance");
                        role: TextRole.section;
                        tone: Tone.on-fill;
                        centred: true;
                        wrap: word-wrap;
                    }
                }
                Button {
                    text: @tr("AUTO WHITE BALANCE");
                    keycap: true;
                    help: @tr("The frame's light toward grey with Temperature and Tint, scaled by Balance strength");
                    enabled: !PanelState.balancing;
                    clicked => { PanelState.auto-balance(); }
                }
            }
        }
        if PanelState.balance-note != "": Label { role: TextRole.note; text: PanelState.balance-note; }
        // The key's dose beside it; the roll's, so it says which photos it reaches. Its reset is its own
        // double click: the block's would rewrite every photo of the roll.
        StoreSlider { field: 11; label: @tr("Balance strength"); fraction: Store.balance-strength-fraction; readout: Store.balance-strength-readout; value-text: Store.balance-strength-value; }
        if PanelState.roll-state == 1 && PanelState.roll-measured > 1: Label {
            role: TextRole.note;
            text: @tr("Shared by the {} photos of this roll.", PanelState.roll-measured);
        }
        StoreSlider {
            field: 0; label: @tr("Temperature"); fraction: Store.temperature-fraction; readout: Store.temperature-readout; value-text: Store.temperature-value;
            fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        StoreSlider {
            field: 1; label: @tr("Tint"); fraction: Store.tint-fraction; readout: Store.tint-readout; value-text: Store.tint-value;
            fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        StoreSlider { field: 2; label: @tr("Saturation"); fraction: Store.color-density-fraction; readout: Store.color-density-readout; value-text: Store.color-density-value; }
    }
    // Only on a paper: in any other working space the gains do nothing.
    if Exporting.on-paper: Block {
        title: @tr("Paper Correction");
        demo: "paper-correction";
        block: 8;
        modified: Store.paper-correction-modified;
        help: @tr("Red, Green and Blue are gains laid last, on a colour or a black and white print alike, for the paper the picture is proofed on; in any other working space they do nothing.\n\nAuto Paper Correction reads the paper's own white off its profile, never the picture, and sets the gains that print a grey as grey. The strongest stays at 0, so nothing clips.");
        ButtonGroup { plate: true;
            Button {
                text: @tr("AUTO PAPER CORRECTION");
                keycap: true;
                help: @tr("Sets the three gains from the paper profile alone");
                clicked => { Exporting.auto-paper(); }
            }
        }
        StoreSlider {
            field: 21; label: @tr("Red"); fraction: Store.paper-red-fraction; readout: Store.paper-red-readout; value-text: Store.paper-red-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        StoreSlider {
            field: 22; label: @tr("Green"); fraction: Store.paper-green-fraction; readout: Store.paper-green-readout; value-text: Store.paper-green-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        StoreSlider {
            field: 23; label: @tr("Blue"); fraction: Store.paper-blue-fraction; readout: Store.paper-blue-readout; value-text: Store.paper-blue-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
    }
    if !Lab.shown: Block {
        title: @tr("Effects");
        demo: "effects";
        block: 2;
        modified: Store.effects-modified;
        help: @tr("Vignette darkens the corners in stops, without shifting their colour; below zero it lightens them.\n\nChrome lays a saturation curve over everything, greying the ends and keeping colour in the middle.");
        StoreSlider { field: 9; label: @tr("Vignette"); fraction: Store.vignette-fraction; readout: Store.vignette-readout; value-text: Store.vignette-value; }
        if !PanelState.monochrome: StoreSlider { field: 10; label: @tr("Chrome"); fraction: Store.chrome-fraction; readout: Store.chrome-readout; value-text: Store.chrome-value; fill: SliderFill.metal; }
    }
    // On the Scanner face its own finishing, a press a step.
    if Lab.shown: LabBlock {
        title: @tr("Effects");
        news: News.effects-scanner;
        news-note: News.effects-scanner-note;
        news-read => { News.read("effects.scanner.1.3.1"); }
        block: 3;
        help: @tr("Contrast bends the print into an S about a middle grey, its ends held.\n\nVignette darkens the corners in stops, without shifting their colour; below zero it lightens them.\n\nChrome lays a saturation curve over everything, greying the ends and keeping colour in the middle.");
        LabSlider { index: 5; label: @tr("Contrast"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; minus-help: @tr("Contrast −: toward softer, 5% a step"); plus-help: @tr("Contrast +: toward harder, 5% a step"); }
        LabSlider { index: 6; label: @tr("Vignette"); low: ScannerStyle.band-light; high: ScannerStyle.band-dark; minus-help: @tr("Vignette −: toward lighter corners, 0.1 EV a step"); plus-help: @tr("Vignette +: toward darker corners, 0.1 EV a step"); }
        if !Lab.monochrome: LabSlider { index: 7; label: @tr("Chrome"); low: ScannerStyle.band-dark; high: ScannerStyle.band-light; minus-help: @tr("Chrome −: toward less, 5% a step"); plus-help: @tr("Chrome +: toward more, 5% a step"); }
    }
    EditorBlock {
        title: @tr("Curves");
        demo: "curves";
        block: 0;
        news: Lab.shown ? News.curves-scanner : "";
        news-note: News.curves-scanner-note;
        news-read => { News.read("curves.scanner.1.3.1"); }
        modified: Editors.curves-modified;
        folded <=> Editors.curves-folded;
        help: @tr("Curves drawn by hand, one point at a time: a channel's own tints its highlights or its shadows alone.");
        CurvesEditor { histogram: Plots.curves; revision: Plots.curves-revision; }
    }
    // The grade's blocks: a monochrome photo has no colour for them to move.
    if !Editors.monochrome: EditorBlock {
        title: @tr("Colour Mixer");
        demo: "spectrogram";
        block: 2;
        modified: Editors.spectrogram-modified;
        folded <=> Editors.spectrogram-folded;
        help: @tr("Spectrogram finishing: shifts one colour range at a time without touching the others.\n\nTurn a point around the wheel to move that colour's hue, out or in to make it stronger or greyer. Click a point, then use the arrow keys.");
        SpectrogramEditor { }
    }
    if !Editors.monochrome: EditorBlock {
        title: @tr("Saturation Curve");
        demo: "saturation-curve";
        block: 3;
        modified: Editors.saturation-modified;
        folded <=> Editors.saturation-folded;
        help: @tr("Saturation by light, from the black point to the white: raise a point to strengthen colour in its tones, lower it toward grey. Brightness never moves.\n\nDrag a point along the light to choose its tones; double-click to return it to neutral.");
        SaturationEditor { histogram: Plots.saturation; revision: Plots.saturation-revision; }
    }
}
