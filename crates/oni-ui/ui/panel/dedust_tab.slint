// The De-dust tab: the brush and the corrections list, the panel naming the mode above them.
import { Icons, Space, State, CropStyle, Slider, Section, Label, Badge, BadgeTone, DustOriginal, Button, ButtonGroup, ButtonSize, GroupAlign, TextRole } from "../ds/ds.slint";
import { Dedust, CorrectionRow } from "state.slint";
import { Pane } from "parts.slint";

// The brush's size, its hand held by Rust as every slider's.
component BrushSlider inherits Slider {
    field: -1;
    label: @tr("Brush size");
    fraction: Dedust.fraction;
    readout: Dedust.readout;
    value-text: Dedust.value-text;
    press(f, fine) => { return Dedust.press(fine); }
    drag(f, t, s, fine) => { Dedust.drag(t, s, fine); }
    release(f) => { Dedust.release(); }
    scroll(f, dx, dy, s, fine) => { return Dedust.scroll(dx, dy, s, fine); }
    step(f, by) => { Dedust.step(by); }
}

// How far inside the roll's window a reading goes, its hand held by Rust as the brush's.
component SensitivitySlider inherits Slider {
    field: -1;
    label: @tr("Sensitivity");
    fraction: Dedust.sensitivity;
    readout: Dedust.sensitivity-text;
    value-text: Dedust.sensitivity-text;
    press(f, fine) => { return Dedust.sensitivity-press(fine); }
    drag(f, t, s, fine) => { Dedust.sensitivity-drag(t, s, fine); }
    release(f) => { Dedust.sensitivity-release(); }
    scroll(f, dx, dy, s, fine) => { return Dedust.sensitivity-scroll(dx, dy, s, fine); }
    step(f, by) => { Dedust.sensitivity-step(by); }
}


// A correction as the dust its patch covers and its number, faded while the patch is coming. The hand
// on it shows that correction alone on the canvas and brings the key that removes it.
component CorrectionTile inherits Rectangle {
    in property <int> place;
    in property <CorrectionRow> data;
    // The key's own touch takes the hand from the tile's: either holds the correction shown.
    property <bool> under-hand: touch.has-hover || remove.under-hand;
    changed under-hand => {
        if (self.under-hand) {
            Dedust.hovered-row = root.place;
        } else if (Dedust.hovered-row == root.place) {
            Dedust.hovered-row = -1;
        }
        Dedust.shown(Dedust.hovered-row);
    }
    touch := TouchArea { }
    DustOriginal {
        source: root.data.original;
        opacity: root.data.pending ? State.disabled : 1;
    }
    Badge {
        x: Space.xxs;
        y: Space.xxs;
        text: root.data.number;
        role: TextRole.label;
        tone: root.data.fallback ? BadgeTone.warning : BadgeTone.dark;
        note: root.data.fallback ? @tr("No good match was found nearby — this patch is a plain shifted tile, not a real structural match.") : "";
    }
    remove := Button {
        x: parent.width - self.width - Space.xxs;
        y: Space.xxs;
        // Shown with the hand on the tile, which it lies within.
        opacity: root.under-hand ? 1 : 0;
        size: ButtonSize.mini;
        square: true;
        has-icon: true;
        icon: Icons.remove;
        help: @tr("Remove This Correction");
        clicked => {
            Dedust.hovered-row = -1;
            Dedust.remove(root.place);
        }
    }
}

export component DedustPane inherits Pane {
    Section {
        title: @tr("Automatic");
        help: @tr("Detect veils the photo but for its pixels past the roll's whites on a negative, its blacks on a positive; the dust among them stands ringed. Sensitivity reads further inside the window and asks less of a speck. Remove lays one patch on each speck ringed.");
        separated: false;
        SensitivitySlider { }
        // Two keycaps a gap apart, as keys stand, never one plate.
        ButtonGroup {
            align: GroupAlign.fill;
            // Out of reach while its reading shows: the reading answers every sensitivity, its count below.
            Button {
                text: @tr("DETECT"); keycap: true; fills: true; enabled: !Dedust.detecting && !Dedust.found-shown;
                help: @tr("Reads this photo for dust past the roll's whites on a negative, its blacks on a positive; nothing changes until you remove it.");
                clicked => { Dedust.detect(); }
            }
            Button { text: @tr("REMOVE"); keycap: true; fills: true; enabled: Dedust.found > 0; help: @tr("Lays one patch on each speck of dust ringed."); clicked => { Dedust.remove-found(); } }
        }
        if Dedust.found-note != "": Label { text: Dedust.found-note; role: TextRole.note; }
    }
    Section {
        title: @tr("Dust & Scratches");
        demo: "dust";
        help: @tr("Paint over a defect; the tool duplicates a matching patch of the same photo over it.");
        separated: false;
        BrushSlider { }
        // The corrections as a grid of their dust and numbers, as many to a row as the pane holds.
        if Dedust.rows.length > 0: Rectangle {
            property <length> step: CropStyle.dust-original + Space.xs;
            property <int> columns: max(1, floor((self.width + Space.xs) / self.step));
            height: ceil(Dedust.rows.length / self.columns) * self.step - Space.xs;
            for row[i] in Dedust.rows: CorrectionTile {
                x: mod(i, parent.columns) * parent.step;
                y: floor(i / parent.columns) * parent.step;
                width: CropStyle.dust-original;
                height: CropStyle.dust-original;
                place: i;
                data: row;
            }
        }
    }
}
