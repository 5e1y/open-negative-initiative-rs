// The De-dust tab: the brush and the corrections list.
import { Icons, Space, Radius, Gap, Slider, Section, Label, Tone, Inset, HelpMark, DustOriginal, Button } from "../ds/ds.slint";
import { Dedust } from "state.slint";
import { Pane } from "parts.slint";

// The brush's size, its hand held by Rust as every slider's.
component BrushSlider inherits Slider {
    field: -1;
    label: @tr("Brush Size");
    fraction: Dedust.fraction;
    readout: Dedust.readout;
    value-text: Dedust.value-text;
    press(f, fine) => { return Dedust.press(fine); }
    drag(f, t, s, fine) => { Dedust.drag(t, s, fine); }
    release(f) => { Dedust.release(); }
    scroll(f, dx, dy, s, fine) => { return Dedust.scroll(dx, dy, s, fine); }
}

export component DedustPane inherits Pane {
    Section {
        title: @tr("Dust & Scratches");
        demo: "dust";
        help: @tr("Paint over a defect; the tool duplicates a matching patch of the same photo over it.");
        separated: false;
        BrushSlider { }
        // `CorrectionsPanel`'s list box, setting per-photo detail apart from the sliders.
        if Dedust.rows.length > 0: Inset {
            pad: Gap.s;
            gap: Gap.xs;
            radius: Radius.control;
            for row[i] in Dedust.rows: HorizontalLayout {
                spacing: Space.s;
                alignment: start;
                // The dust under the patch, to remember what the corrected picture no longer shows.
                DustOriginal { source: row.original; }
                Label { text: row.label; horizontal-stretch: 1; }
                if row.fallback: VerticalLayout {
                    alignment: center;
                    HelpMark { note: @tr("No good match was found nearby — this patch is a plain shifted tile, not a real structural match."); }
                }
                if row.pending: Label { text: @tr("Generating…"); tone: Tone.secondary; }
                VerticalLayout {
                    alignment: center;
                    Button { has-icon: true; square: true; icon: Icons.remove; help: @tr("Remove this correction"); clicked => { Dedust.remove(i); } }
                }
            }
        }
    }
}
