// The De-dust tab: the brush and the corrections list.
import { Icons, Space, Radius, Gap, Slider, Section, Label, Tone, Inset, HelpMark, DustOriginal, Button, ButtonGroup, ButtonSize, GroupAlign, TextRole } from "../ds/ds.slint";
import { Dedust } from "state.slint";
import { Pane } from "parts.slint";

// The brush's size, its hand held by Rust as every slider's.
component BrushSlider inherits Slider {
    field: -1;
    label: @tr("Brush size");
    fraction: Dedust.fraction;
    readout: Dedust.readout;
    value-text: Dedust.value-text;
    press(f, fine) => { return Dedust.press(fine); }
    drag(f, t, s, fine) => { Dedust.drag(t, s, fine); }
    release(f) => { Dedust.release(); }
    scroll(f, dx, dy, s, fine) => { return Dedust.scroll(dx, dy, s, fine); }
    step(f, by) => { Dedust.step(by); }
}

// How far inside the roll's window a reading goes, its hand held by Rust as the brush's.
component SensitivitySlider inherits Slider {
    field: -1;
    label: @tr("Sensitivity");
    fraction: Dedust.sensitivity;
    readout: Dedust.sensitivity-text;
    value-text: Dedust.sensitivity-text;
    press(f, fine) => { return Dedust.sensitivity-press(fine); }
    drag(f, t, s, fine) => { Dedust.sensitivity-drag(t, s, fine); }
    release(f) => { Dedust.sensitivity-release(); }
    scroll(f, dx, dy, s, fine) => { return Dedust.sensitivity-scroll(dx, dy, s, fine); }
    step(f, by) => { Dedust.sensitivity-step(by); }
}

export component DedustPane inherits Pane {
    Section {
        title: @tr("Automatic");
        help: @tr("Detect shows, under a veil, every pixel past the roll's whites on a negative, its blacks on a positive; the dust among them stands ringed. Sensitivity reads further inside the window and asks less of a speck. Remove lays one patch on each speck ringed.");
        separated: false;
        SensitivitySlider { }
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: Dedust.found-shown ? @tr("HIDE") : @tr("DETECT"); keycap: true; fills: true; enabled: !Dedust.detecting; help: @tr("Reads this photo for dust past the roll's whites on a negative, its blacks on a positive; nothing changes until you remove it."); clicked => { Dedust.detect(); } }
            Button { size: ButtonSize.plate; text: @tr("REMOVE"); keycap: true; fills: true; enabled: Dedust.found > 0; help: @tr("Lays one patch on each speck of dust ringed."); clicked => { Dedust.remove-found(); } }
        }
        if Dedust.found-note != "": Label { text: Dedust.found-note; role: TextRole.note; }
    }
    Section {
        title: @tr("Dust & Scratches");
        demo: "dust";
        help: @tr("Paint over a defect; the tool duplicates a matching patch of the same photo over it.");
        separated: false;
        BrushSlider { }
        // `CorrectionsPanel`'s list box, setting per-photo detail apart from the sliders.
        if Dedust.rows.length > 0: Inset {
            pad: Gap.s;
            gap: Gap.xs;
            radius: Radius.control;
            for row[i] in Dedust.rows: HorizontalLayout {
                spacing: Space.s;
                alignment: start;
                // The dust under the patch, to remember what the corrected picture no longer shows.
                DustOriginal { source: row.original; }
                Label { text: row.label; horizontal-stretch: 1; }
                if row.fallback: VerticalLayout {
                    alignment: center;
                    HelpMark { note: @tr("No good match was found nearby — this patch is a plain shifted tile, not a real structural match."); }
                }
                if row.pending: Label { text: @tr("Generating…"); tone: Tone.secondary; }
                VerticalLayout {
                    alignment: center;
                    Button { has-icon: true; square: true; icon: Icons.remove; help: @tr("Remove This Correction"); clicked => { Dedust.remove(i); } }
                }
            }
        }
    }
}
