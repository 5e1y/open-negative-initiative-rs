// The Frontier Look Lab: the measured table's named values, each slider opening on the machine's own
// effect over a zero that is no effect, so the hand sees what each value does to the render.
import { Section, Tabs, Slider, SliderFill, PlotInkStyle, ScannerStyle, Space, Plot, PlotLine, PlotDot, AxisCaptions } from "../ds/ds.slint";
import { PanelState } from "state.slint";

export global LookLab {
    // Each slider's place and words, by its number as `press` names it.
    in property <[float]> fractions;
    in property <[string]> readouts;
    in-out property <int> sector;
    in-out property <int> tone;
    in property <[bool]> sector-marked;
    in property <[bool]> tone-marked;
    in property <[color]> swatches;
    // Colours, dyes, paper, greys, character.
    in property <[bool]> modified;
    callback pick-sector(int);
    callback pick-tone(int);
    callback reset(int);
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    callback scroll(int, length, length, length, bool) -> bool;
    callback step(int, int);
    // The paper curve: the machine's, the neutral one and the frame's, its nodes dragged up and down.
    in property <[PlotLine]> paper-lines;
    in property <[PlotDot]> paper-dots;
    callback paper-resized(length, length);
    callback paper-pointer(int, length, length);
}

component LabSlider inherits Slider {
    readout: LookLab.readouts[self.field];
    value-text: LookLab.readouts[self.field];
    fraction: LookLab.fractions[self.field];
    fill: SliderFill.bipolar;
    low: PlotInkStyle.grey-half;
    high: PlotInkStyle.grey-half;
    press(f, fine) => { return LookLab.press(f, fine); }
    drag(f, t, s, fine) => { LookLab.drag(f, t, s, fine); }
    release(f) => { LookLab.release(f); }
    scroll(f, dx, dy, s, fine) => { return LookLab.scroll(f, dx, dy, s, fine); }
    step(f, d) => { LookLab.step(f, d); }
}

component LabSection inherits Section {
    folded: PanelState.folds-read ? PanelState.fold-of(self.title, self.folded-by-default) : self.folded-by-default;
    modified: LookLab.modified[self.block];
    reset(b) => { LookLab.reset(b); }
    fold-toggled(f) => { PanelState.fold-changed(self.title, f); }
}

export component LookLabBlocks inherits VerticalLayout {
    property <int> s: LookLab.sector;
    LabSection {
        title: "Lab Colours";
        block: 0;
        help: "Each colour of the Frontier's render by its hue: Hue turns it, Twist turns it more as it grows more vivid, Chroma makes it more or less vivid. Each slider opens on what the Frontier does; zero takes that effect away, a double click puts it back.";
        Tabs {
            tabs: ["Pink", "Red", "Orange", "Yellow", "Lime", "Green", "Teal", "Cyan", "Blue", "Indigo", "Violet", "Magenta"];
            marked: LookLab.sector-marked;
            swatches: LookLab.swatches;
            selected <=> LookLab.sector;
            picked(i) => { LookLab.pick-sector(i); }
        }
        LabSlider { field: 0; label: "Hue"; low: LookLab.swatches[mod(root.s + 11, 12)]; high: LookLab.swatches[mod(root.s + 1, 12)]; }
        LabSlider { field: 1; label: "Twist"; low: LookLab.swatches[mod(root.s + 11, 12)]; high: LookLab.swatches[mod(root.s + 1, 12)]; }
        LabSlider { field: 2; label: "Chroma"; high: LookLab.swatches[root.s]; }
        LabSlider { field: 3; label: "Saturation by lightness"; }
    }
    LabSection {
        title: "Lab Dyes";
        block: 1;
        folded-by-default: true;
        help: "How much each channel's density borrows from the other two before the paper prints it, as the dyes of the negative overlap.";
        LabSlider { field: 4; label: "Red borrows green"; }
        LabSlider { field: 5; label: "Red borrows blue"; }
        LabSlider { field: 6; label: "Green borrows red"; }
        LabSlider { field: 7; label: "Green borrows blue"; }
        LabSlider { field: 8; label: "Blue borrows red"; }
        LabSlider { field: 9; label: "Blue borrows green"; }
    }
    LabSection {
        title: "Lab Paper";
        block: 2;
        folded-by-default: true;
        help: "The paper curve prints each density of the negative, its blacks on the left and its whites on the right: the Frontier's in colour, a print without its look in grey. Drag a point up or down; a double click puts it back on the Frontier's. Below, the paper's red and blue against its green.";
        Plot {
            plot: 7;
            height: self.width * 3 / 4;
            lines: LookLab.paper-lines;
            dots: LookLab.paper-dots;
            resized(p, w, h) => { LookLab.paper-resized(w, h); }
            pointer(p, kind, x, y, alt) => { LookLab.paper-pointer(kind, x, y); }
        }
        AxisCaptions { start: "Blacks"; end: "Whites"; }
        LabSlider { field: 10; label: "Red contrast"; }
        LabSlider { field: 11; label: "Blue contrast"; }
        LabSlider { field: 12; label: "Red density"; }
        LabSlider { field: 13; label: "Blue density"; }
    }
    LabSection {
        title: "Lab Greys";
        block: 3;
        folded-by-default: true;
        help: "A cast laid on every colour by its lightness, so the greys of each tone can be put back on neutral.";
        Tabs {
            tabs: ["Shadows", "Darks", "Mids", "Lights", "Highlights"];
            marked: LookLab.tone-marked;
            selected <=> LookLab.tone;
            picked(i) => { LookLab.pick-tone(i); }
        }
        LabSlider { field: 14; label: "Green – Magenta"; low: ScannerStyle.band-green; high: ScannerStyle.band-magenta; }
        LabSlider { field: 15; label: "Blue – Yellow"; low: ScannerStyle.band-blue; high: ScannerStyle.band-yellow; }
    }
    LabSection {
        title: "Lab Character";
        block: 4;
        folded-by-default: true;
        help: "The share of what the measured table holds beyond the named values: 100 % is the machine whole, 0 % the named values alone.";
        LabSlider { field: 16; label: "Character"; fill: SliderFill.level; }
    }
}
