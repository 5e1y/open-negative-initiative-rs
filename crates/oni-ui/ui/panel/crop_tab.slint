// The Crop tab: the frame, its ratio, rotation, mirror and straightening.
import { Icons, Space, Section, Tabs, Button, ButtonKind, IconButton, ButtonGroup, Toggle, LabelledRow, Label, TextRole } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { PanelState, Framing } from "state.slint";
import { StoreSlider, Block, Pane } from "parts.slint";

export component CropPane inherits Pane {
    Section {
        title: "Crop";
        help: "Drag the corners on the photo to crop it. Copy and Paste carry the whole framing to other photographs, Paste to Roll to every frame of the roll; the settings paste never does.";
        separated: false;
        // All of the geometry but the measuring window, which has its own reset.
        block: 0;
        modified: Framing.modified;
        reset(b) => { Framing.act("reset-crop"); }
        HorizontalLayout {
            spacing: Space.s;
            Button { text: "Copy"; help: "Copies this photo's crop."; clicked => { Framing.act("copy-framing"); } }
            Button { text: "Paste"; enabled: Framing.can-paste && PanelState.targets > 0; help: PanelState.targets > 1 ? "Pastes the copied crop on the " + PanelState.targets + " selected photos." : "Pastes the copied crop on this photo."; clicked => { Framing.act("paste-framing"); } }
            Button { text: "Paste to Roll"; enabled: Framing.can-paste; horizontal-stretch: 1; help: "Pastes the copied crop on every photo measured with this roll."; clicked => { Framing.act("paste-framing-to-roll"); } }
        }
    }
    Section {
        title: "Aspect Ratio";
        Tabs {
            tabs: ["Free", "3:2", "4:3", "1:1", "6:7", "5:4"];
            marked: [false, false, false, false, false, false];
            selected <=> Framing.ratio;
            picked(i) => { Framing.ratio-picked(i); }
        }
        LabelledRow {
            label: "Vertical";
            Toggle { label: "Vertical"; on: Framing.portrait; enabled: Framing.portrait-enabled; toggled(on) => { Framing.portrait-toggled(on); } }
        }
    }
    Block {
        title: "Straighten";
        StoreSlider { field: 14; label: "Angle"; fraction: Store.angle-fraction; readout: Store.angle-readout; value-text: Store.angle-value; }
    }
    Section {
        title: "Rotate & Mirror";
        HorizontalLayout {
            spacing: Space.s;
            alignment: start;
            IconButton { icon: Icons.rotate; help: "Rotate 90° clockwise"; clicked => { Framing.act("rotate"); } }
            ButtonGroup {
                IconButton { icon: Icons.mirror; help: Framing.mirrored ? "Unmirror left for right" : "Mirror left for right"; on: Framing.mirrored; clicked => { Framing.act("mirror"); } }
                IconButton { icon: Icons.mirror; help: Framing.mirrored-vertically ? "Unmirror top for bottom" : "Mirror top for bottom"; on: Framing.mirrored-vertically; clicked => { Framing.act("mirror-vertically"); } }
            }
        }
    }
    Section {
        title: "Measuring Window";
        help: "Shows a frame on the photo; the balance keys and the histogram read only what it holds. Untouched, it follows the crop; the crop never moves it.";
        ButtonGroup {
            Button { text: "Reset"; enabled: Framing.has-window; help: "Reset measure window"; clicked => { Framing.act("window-reset"); } }
            Button { text: Framing.armed ? "Apply Window" : "Measuring Window"; kind: Framing.armed ? ButtonKind.accent : ButtonKind.plain; clicked => { Framing.act("window-arm"); } }
            IconButton { icon: Icons.copy; help: "Copy measure window"; enabled: Framing.has-window; clicked => { Framing.act("window-copy"); } }
            IconButton { icon: Icons.paste; help: "Paste measure window"; enabled: Framing.can-paste-window; clicked => { Framing.act("window-paste"); } }
        }
    }
    Section {
        LabelledRow {
            label: "Kept";
            Label { text: Framing.kept; role: TextRole.value; }
        }
    }
}
