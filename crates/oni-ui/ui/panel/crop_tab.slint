// The crop's pane: what it keeps, its reset and the keys that carry it, then its ratio, straightening,
// turns and mirrors, and the photo's measuring window.
import { Act } from "../act.slint";
import { Space, Section, Tabs, Button, ButtonSize, ButtonGroup, GroupAlign, Toggle, LcdReadout, Field, FieldLayout, Label, TextRole } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { PanelState, Framing } from "state.slint";
import { StoreSlider, Block, Pane } from "parts.slint";

export component CropPane inherits Pane {
    // Under the mode's name, untitled: the crop's size in the file's pixels with its reset beside it,
    // then its keys, named for the crop apart from the bar's keys that carry the settings.
    Section {
        separated: false;
        Field {
            layout: FieldLayout.spread;
            label: @tr("Kept");
            HorizontalLayout {
                spacing: Space.s;
                // Laid out at rest too, only hidden, so the glass never moves; the window outlives it.
                Button {
                    size: ButtonSize.mini;
                    text: @tr("Reset");
                    visible: Framing.modified;
                    enabled: Framing.modified;
                    help: @tr("Puts the crop at rest: the whole photo, upright, unmirrored and level; the measuring window stays.");
                    clicked => { Framing.act(Act.reset-crop); }
                }
                LcdReadout { text: Framing.kept; }
            }
        }
        ButtonGroup {
            align: GroupAlign.fill;
            Button { text: @tr("Copy Crop"); help: @tr("Copies this photo's crop: its frame, ratio, angle, turns, mirrors and measuring window."); clicked => { Framing.act(Act.copy-framing); } }
            Button { text: @tr("Paste Crop"); enabled: Framing.can-paste && PanelState.targets > 0; help: PanelState.targets > 1 ? @tr("Pastes the copied crop on the {} selected photos.", PanelState.targets) : @tr("Pastes the copied crop on this photo."); clicked => { Framing.act(Act.paste-framing); } }
        }
        Button { text: @tr("Paste Crop to Roll"); enabled: Framing.can-paste; help: @tr("Pastes the copied crop on every photo measured with this roll."); clicked => { Framing.act(Act.paste-framing-to-roll); } }
    }
    Section {
        title: @tr("Aspect Ratio");
        help: @tr("Holds the crop to a ratio while its corners are dragged; Free leaves it loose, and Vertical stands it upright, 2:3 for 3:2. The ratio last chosen follows to the next photo opened on this tab.");
        Tabs {
            tabs: [@tr("Free"), "3:2", "4:3", "1:1", "6:7", "5:4"];
            marked: [false, false, false, false, false, false];
            selected: Framing.ratio;
            picked(i) => { Framing.ratio = i; Framing.ratio-picked(i); }
        }
        // No switch where it could turn nothing.
        if Framing.orientable: Toggle { label: @tr("Vertical"); on: Framing.portrait; toggled(on) => { Framing.portrait-toggled(on); } }
    }
    Block {
        title: @tr("Straighten");
        help: @tr("Turns the photo a few degrees either way to level a horizon or a frame's edge; the crop shrinks to stay inside the turned picture.");
        StoreSlider {
            field: 14; label: @tr("Angle"); fraction: Store.angle-fraction; readout: Store.angle-readout; value-text: Store.angle-value;
            dial: true; lowest: Framing.angle-lowest; highest: Framing.angle-highest;
        }
    }
    Section {
        title: @tr("Rotate & Mirror");
        help: @tr("Turns the photo a quarter clockwise at each press, or flips it left for right or top for bottom, as a negative scanned from its back needs.");
        // Worded keys sharing the row alike, the sign after each word showing how the photo moves;
        // none of them ever lights.
        ButtonGroup {
            align: GroupAlign.fill;
            Button { text: @tr("Rotate ↻"); help: @tr("Rotate 90° Clockwise"); clicked => { Framing.act(Act.rotate); } }
            Button { text: @tr("Mirror ↔"); help: Framing.mirrored ? @tr("Unmirror left for right") : @tr("Mirror left for right"); clicked => { Framing.act(Act.mirror); } }
            Button { text: @tr("Mirror ↕"); help: Framing.mirrored-vertically ? @tr("Unmirror top for bottom") : @tr("Mirror top for bottom"); clicked => { Framing.act(Act.mirror-vertically); } }
        }
    }
    Section {
        title: @tr("Measuring Window");
        help: @tr("The part of the photo the balance keys and the histogram read, drawn on the photo while its key is lit; untouched, it follows the crop. Reset takes it away, Copy and Paste carry it from one photo to another.");
        // Its own reset on its title's row, apart from the keys that keep it; the crop's never touches it.
        block: 0;
        modified: Framing.has-window;
        reset(b) => { Framing.act(Act.window-reset); }
        // Each photo holds its own window, which the roll's settings never carry: said where it is set.
        Label { role: TextRole.note; text: @tr("Acts on this photo alone: the balance keys and the histogram read only what it frames."); }
        // `MeasureWindowKeys`: the long sentence is the key's own, lit while armed.
        Button {
            text: Framing.armed ? @tr("Apply Window") : @tr("Set Window");
            on: Framing.armed;
            latch: true;
            help: @tr("Shows a frame on the photo; the balance keys and the histogram read only what it holds. Untouched, it follows the crop; the crop never moves it.");
            clicked => { Framing.act(Act.window-arm); }
        }
        // Named for the window they carry, apart from the crop's keys and the bar's.
        ButtonGroup {
            align: GroupAlign.fill;
            Button { text: @tr("Copy Window"); help: @tr("Copy Measuring Window"); enabled: Framing.has-window; clicked => { Framing.act(Act.window-copy); } }
            Button { text: @tr("Paste Window"); help: @tr("Paste Measuring Window"); enabled: Framing.can-paste-window; clicked => { Framing.act(Act.window-paste); } }
        }
    }
}
