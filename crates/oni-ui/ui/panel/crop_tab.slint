// The Crop tab: the frame, its ratio, rotation, mirror and straightening.
import { Act } from "../act.slint";
import { Icons, Space, Section, Tabs, Button, ButtonSize, ButtonKind, LcdReadout, ButtonGroup, GroupAlign, Toggle, Field, FieldLayout } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { PanelState, Framing } from "state.slint";
import { StoreSlider, Block, Pane } from "parts.slint";

export component CropPane inherits Pane {
    Section {
        title: @tr("Crop");
        demo: "crop";
        help: @tr("Drag the corners on the photo to crop it. Copy and Paste carry the whole framing to other photographs, Paste to Roll to every frame of the roll; the settings paste never does.");
        separated: false;
        // All of the geometry but the measuring window, which has its own reset.
        block: 0;
        modified: Framing.modified;
        reset(b) => { Framing.act(Act.reset-crop); }
        // `FramePane`: COPY and PASTE hug their words, PASTE TO ROLL takes the rest of the plate.
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: @tr("COPY"); help: @tr("Copies this photo's crop."); clicked => { Framing.act(Act.copy-framing); } }
            Button { size: ButtonSize.plate; text: @tr("PASTE"); enabled: Framing.can-paste && PanelState.targets > 0; help: PanelState.targets > 1 ? @tr("Pastes the copied crop on the {} selected photos.", PanelState.targets) : @tr("Pastes the copied crop on this photo."); clicked => { Framing.act(Act.paste-framing); } }
            Button { size: ButtonSize.plate; text: @tr("PASTE TO ROLL"); fills: true; enabled: Framing.can-paste; help: @tr("Pastes the copied crop on every photo measured with this roll."); clicked => { Framing.act(Act.paste-framing-to-roll); } }
        }
    }
    Section {
        title: @tr("Aspect Ratio");
        Tabs {
            tabs: [@tr("Free"), "3:2", "4:3", "1:1", "6:7", "5:4"];
            marked: [false, false, false, false, false, false];
            selected: Framing.ratio;
            picked(i) => { Framing.ratio = i; Framing.ratio-picked(i); }
        }
        Toggle { label: @tr("Vertical"); on: Framing.portrait; enabled: Framing.portrait-enabled; toggled(on) => { Framing.portrait-toggled(on); } }
    }
    Block {
        title: @tr("Straighten");
        StoreSlider { field: 14; label: @tr("Angle"); fraction: Store.angle-fraction; readout: Store.angle-readout; value-text: Store.angle-value; }
    }
    Section {
        title: @tr("Rotate & Mirror");
        // The rotate key alone, then the two mirrors on one plate; none of them ever lights.
        HorizontalLayout {
            spacing: Space.s;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Button { has-icon: true; square: true; icon: Icons.rotate; help: @tr("Rotate 90° clockwise"); clicked => { Framing.act(Act.rotate); } }
            }
            ButtonGroup { plate: true;
                Button { has-icon: true; square: true; icon: Icons.mirror; help: Framing.mirrored ? @tr("Unmirror left for right") : @tr("Mirror left for right"); clicked => { Framing.act(Act.mirror); } }
                // The same glyph turned a quarter, the icon bank holding no vertical twin.
                Button { has-icon: true; square: true; icon: Icons.mirror; turned: true; help: Framing.mirrored-vertically ? @tr("Unmirror top for bottom") : @tr("Mirror top for bottom"); clicked => { Framing.act(Act.mirror-vertically); } }
            }
        }
    }
    Section {
        title: @tr("Measuring Window");
        // `MeasureWindowKeys`: the long sentence is the middle key's, armed it wears the confirm green.
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; has-icon: true; square: true; icon: Icons.reset; enabled: Framing.has-window; help: @tr("Reset measure window"); clicked => { Framing.act(Act.window-reset); } }
            Button {
                size: ButtonSize.plate;
                fills: true;
                text: Framing.armed ? @tr("APPLY WINDOW") : @tr("MEASURING WINDOW");
                kind: Framing.armed ? ButtonKind.confirm : ButtonKind.plain;
                help: @tr("Shows a frame on the photo; the balance keys and the histogram read only what it holds. Untouched, it follows the crop; the crop never moves it.");
                clicked => { Framing.act(Act.window-arm); }
            }
            Button { size: ButtonSize.plate; has-icon: true; square: true; icon: Icons.copy; help: @tr("Copy measure window"); enabled: Framing.has-window; clicked => { Framing.act(Act.window-copy); } }
            Button { size: ButtonSize.plate; has-icon: true; square: true; icon: Icons.paste; help: @tr("Paste measure window"); enabled: Framing.can-paste-window; clicked => { Framing.act(Act.window-paste); } }
        }
    }
    Section {
        Field { layout: FieldLayout.spread;
            label: @tr("Kept");
            LcdReadout { text: Framing.kept; }
        }
    }
}
