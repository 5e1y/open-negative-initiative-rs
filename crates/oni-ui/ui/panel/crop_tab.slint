// The Crop tab: the frame, its ratio, rotation, mirror and straightening.
import { Act } from "../act.slint";
import { Section, Tabs, Button, ButtonSize, LcdReadout, ButtonGroup, GroupAlign, Toggle, Field, FieldLayout } from "../ds/ds.slint";
import { Store } from "../store.slint";
import { PanelState, Framing } from "state.slint";
import { StoreSlider, Block, Pane } from "parts.slint";

export component CropPane inherits Pane {
    Section {
        title: @tr("Crop");
        demo: "crop";
        help: @tr("Drag the corners on the photo to crop it. Copy and Paste carry the whole framing to other photographs, Paste to Roll to every frame of the roll; the settings paste never does.");
        separated: false;
        // All of the geometry but the measuring window, which has its own reset.
        block: 0;
        modified: Framing.modified;
        reset(b) => { Framing.act(Act.reset-crop); }
        // The three keys share the plate's room alike, so their words stand evenly apart.
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: @tr("COPY"); help: @tr("Copies this photo's crop."); clicked => { Framing.act(Act.copy-framing); } }
            Button { size: ButtonSize.plate; text: @tr("PASTE"); enabled: Framing.can-paste && PanelState.targets > 0; help: PanelState.targets > 1 ? @tr("Pastes the copied crop on the {} selected photos.", PanelState.targets) : @tr("Pastes the copied crop on this photo."); clicked => { Framing.act(Act.paste-framing); } }
            Button { size: ButtonSize.plate; text: @tr("PASTE TO ROLL"); enabled: Framing.can-paste; help: @tr("Pastes the copied crop on every photo measured with this roll."); clicked => { Framing.act(Act.paste-framing-to-roll); } }
        }
    }
    Section {
        title: @tr("Aspect Ratio");
        help: @tr("Holds the crop to a ratio while its corners are dragged; Free leaves it loose, and Vertical stands it upright, 2:3 for 3:2. The ratio last chosen follows to the next photo opened on this tab.");
        Tabs {
            tabs: [@tr("Free"), "3:2", "4:3", "1:1", "6:7", "5:4"];
            marked: [false, false, false, false, false, false];
            selected: Framing.ratio;
            picked(i) => { Framing.ratio = i; Framing.ratio-picked(i); }
        }
        // No switch where it could turn nothing.
        if Framing.orientable: Toggle { label: @tr("Vertical"); on: Framing.portrait; toggled(on) => { Framing.portrait-toggled(on); } }
    }
    Block {
        title: @tr("Straighten");
        help: @tr("Turns the photo a few degrees either way to level a horizon or a frame's edge; the crop shrinks to stay inside the turned picture.");
        StoreSlider { field: 14; label: @tr("Angle"); fraction: Store.angle-fraction; readout: Store.angle-readout; value-text: Store.angle-value; }
    }
    Section {
        title: @tr("Rotate & Mirror");
        help: @tr("Turns the photo a quarter clockwise at each press, or flips it left for right or top for bottom, as a negative scanned from its back needs.");
        // Worded keys sharing the plate alike, as Crop's, the sign after each word showing how the
        // photo moves; none of them ever lights.
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: @tr("Rotate ↻"); help: @tr("Rotate 90° Clockwise"); clicked => { Framing.act(Act.rotate); } }
            Button { size: ButtonSize.plate; text: @tr("Mirror ↔"); help: Framing.mirrored ? @tr("Unmirror left for right") : @tr("Mirror left for right"); clicked => { Framing.act(Act.mirror); } }
            Button { size: ButtonSize.plate; text: @tr("Mirror ↕"); help: Framing.mirrored-vertically ? @tr("Unmirror top for bottom") : @tr("Mirror top for bottom"); clicked => { Framing.act(Act.mirror-vertically); } }
        }
    }
    Section {
        title: @tr("Measuring Window");
        help: @tr("The part of the photo the balance keys and the histogram read, drawn on the photo while its key is lit; untouched, it follows the crop. Reset takes it away, Copy and Paste carry it from one photo to another.");
        // Its own reset on its title's row, apart from the keys that keep it; Crop's never touches it.
        block: 0;
        modified: Framing.has-window;
        reset(b) => { Framing.act(Act.window-reset); }
        // `MeasureWindowKeys`: the long sentence is the key's own, lit while armed.
        Button {
            size: ButtonSize.plate;
            text: Framing.armed ? @tr("Apply window") : @tr("Set window");
            on: Framing.armed;
            help: @tr("Shows a frame on the photo; the balance keys and the histogram read only what it holds. Untouched, it follows the crop; the crop never moves it.");
            clicked => { Framing.act(Act.window-arm); }
        }
        // Worded as Crop's and the toolbar's copy and paste, the same gesture.
        ButtonGroup { plate: true;
            align: GroupAlign.fill;
            Button { size: ButtonSize.plate; text: @tr("Copy"); help: @tr("Copy Measuring Window"); enabled: Framing.has-window; clicked => { Framing.act(Act.window-copy); } }
            Button { size: ButtonSize.plate; text: @tr("Paste"); help: @tr("Paste Measuring Window"); enabled: Framing.can-paste-window; clicked => { Framing.act(Act.window-paste); } }
        }
    }
    Section {
        Field { layout: FieldLayout.spread;
            label: @tr("Kept");
            LcdReadout { text: Framing.kept; }
        }
    }
}
