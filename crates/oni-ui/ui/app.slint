// The editor window: the bar, the library column, the canvas card or the gallery, the panel.
import { DS, SplashWindow, Tip, Tips, TipBox, Icons, AppWindow, TipLayer, Card, Picture, SplitGuide, FrameOverlay, FrameStyle, BrushDisc, LiveStroke, CorrectionMark, Badge, SourceTrace, Button, IconButton, ButtonGroup, ButtonSize, ButtonKind, Label, WarningBadge, Warning, Progress, FloatingColumn, Motion, TextRole, Tone, Sheet, Space, Ground, StatusLine, SealedStatusLine, CardStyle, StatusStyle, ShellStyle, LabCell, MenuLine } from "ds/ds.slint";
import { Catalogue } from "ds/catalogue.slint";
import { Store } from "store.slint";
import { Panel, Plots, PanelState, DetailLoupe, Lab, Framing, Dedust, CorrectionRow } from "panel.slint";
import { Toolbar, Bar } from "toolbar.slint";
import { Grid, Info, Library, Tile, Heading, TreeRow, TrashLine, StockCount } from "library.slint";
import { CardStatus } from "card_status.slint";
import { Canvas, Mark, CanvasCard } from "canvas.slint";
import { Tree } from "library_tree.slint";
import { Navigator, FolderLine, WelcomeLine, CatchUpLine, RootsCatchUpSheet } from "navigator.slint";
import { Pairing, PairingSheet } from "pairing.slint";
import { Notice, NoticeSheet } from "notice.slint";
import { Stocks, StockBrand, StockRow, StockCell, StockPickerSheet } from "stocks.slint";
import { Help, News, WelcomeSheet, ReportSheet, ConsoleWindow } from "help.slint";
import { Wrapped, WrappedFace, WrappedView } from "wrapped.slint";
import { MaskDialog, MaskDialogSheet } from "masks.slint";
import { Presets, PresetCard, CarriesLine, Advice, AdviceSheet, Choice, ChoiceSheet, PresetSaveSheet, PresetEditorSheet } from "presets.slint";
import { PresetDeck } from "preset_deck.slint";
import { Exporting, ExportLine, ExportColumn, ExportPanel, SpaceChip, ExportConfirmSheet, ExportNoticeSheet, PaperSheet, PaperRow } from "export.slint";
import { Preparing, RollCell, RollPanel, RollFloor } from "prepare.slint";
import { Confirm, ConfirmSheet } from "confirm.slint";

export { DS, Tip, Tips, TipBox, Icons, LabCell, Store, Plots, PanelState, DetailLoupe, Lab, Framing, Dedust, CorrectionRow, Bar, Library, Tile, Heading, TreeRow, TrashLine, StockCount, MenuLine, Navigator, FolderLine, WelcomeLine, CatchUpLine, Pairing, Notice, Catalogue, SplashWindow, Exporting, ExportLine, PaperRow }
export { Editors } from "editors.slint";
export { Presets, PresetCard, CarriesLine, Advice, Choice, Help, News, ConsoleWindow, Wrapped, WrappedFace }
export { MaskDialog, Confirm }
export { Stocks, StockBrand, StockRow, StockCell }
export { Preparing, RollCell }
export { Canvas, Mark }
export { Ink, PlotLine, PlotDot, PlotKnob, PlotReadout, FolderChoice } from "ds/ds.slint";

export global App {
    in-out property <bool> gallery;
    in property <bool> panel-hidden;
    in property <bool> library-hidden;
    // A key with control, meta, shift and alt, then whether it repeats; Rust reads ⌘ as meta on
    // macOS, control elsewhere, and answers whether the key was claimed.
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    callback menu(string);
    // A sheet shown or closed, so the menus go dark behind it or come back.
    callback sheet-changed();
}

// `EditorMenus`'s titles, which change with the scene.
export struct MenuTitles {
    mode: string,
    export: string,
    remove: string,
    restore: string,
    paste: string,
    paste-to-roll: string,
    undo: string,
    redo: string,
    smaller: string,
    larger: string,
    sound: string,
    compare: string,
    library: string,
    panel: string,
    correcting: string,
    mirror: string,
    filter: string,
    roll: string,
    ungroup: string,
    sheet: string,
    screen-gamut: string,
    half-size: string,
}

// `EditorMenus.live`: the items a gesture can reach now; a gesture this build lacks stays dark.
export struct MenuLive {
    open: bool,
    toggle-mode: bool,
    export: bool,
    recheck: bool,
    read-folders: bool,
    show-selected: bool,
    remove: bool,
    restore: bool,
    undo: bool,
    redo: bool,
    reset: bool,
    smaller: bool,
    larger: bool,
    compare: bool,
    hide-library: bool,
    hide-panel: bool,
    framing: bool,
    correction: bool,
    bigger-brush: bool,
    smaller-brush: bool,
    mirror: bool,
    screen-gamut: bool,
    emulator: bool,
    medal: bool,
    cycle-filter: bool,
    new-roll: bool,
    ungroup: bool,
    contact-sheet: bool,
    measure-roll: bool,
    reset-to-default: bool,
    copy-settings: bool,
    paste-settings: bool,
    paste-to-roll: bool,
    save-preset: bool,
    edit-presets: bool,
    import-presets: bool,
    show-presets: bool,
    paste-preset-code: bool,
    apply-preset: bool,
}

export global Menus {
    in property <MenuTitles> titles: {
        mode: "Gallery", export: "Export…", remove: "Move to ONI Trash", restore: "Restore",
        paste: "Paste Settings", paste-to-roll: "Paste to Roll", undo: "Undo", redo: "Redo",
        smaller: "Zoom Out", larger: "Zoom In", sound: "Mute Key Clicks", compare: "Compare Before/After",
        library: "Hide the Library", panel: "Hide the Panel", correcting: "Remove Dust & Scratches",
        mirror: "Mirror Horizontally", filter: "Filter: All", roll: "New Roll from Selection",
        ungroup: "Ungroup", sheet: "New Contact Sheet", screen-gamut: "Show What This Screen Cannot Show",
        half-size: "Read RAW Previews at Half Size",
    };
    in property <MenuLive> live: { open: true, cycle-filter: true };
    // `menus.presets`: each one's name and what it carries, under the targets' title.
    in property <string> apply-title: "Apply";
    in property <[string]> presets;
    in property <[string]> preset-names;
    callback apply-preset(int);
    callback delete-preset(int);
}

export component MainWindow inherits AppWindow {
    title: "Open Negative Initiative";
    out property <bool> keys-focused: keys.has-focus;
    // `revealedLibrary` and `revealedPanel`: a hidden column slid over the card by the pointer.
    property <bool> revealed-library;
    property <bool> revealed-panel;
    property <bool> beside-photo: !App.gallery && !Exporting.shown && !Preparing.shown;
    // `mode == .gallery`: the grid mounts afresh each time it shows, and lands on the open photo.
    out property <bool> grid-shown: App.gallery && !Exporting.shown && !Preparing.shown;
    changed grid-shown => { if (self.grid-shown) { Library.gallery-shown(); } }
    // Any sheet over the window, every flag that lays one below.
    out property <bool> sheet-shown: Presets.saving || Presets.editing || Confirm.shown || Pairing.shown || Notice.shown
        || Navigator.catch-up-shown || Exporting.confirm-shown || Exporting.notice-shown || Stocks.shown
        || Exporting.papers-shown || Help.welcome-shown || Help.report-shown || Choice.shown || MaskDialog.shown
        || Advice.shown || Wrapped.shown;
    changed sheet-shown => { App.sheet-changed(); }
    // Gives the key monitor the keyboard back after a click elsewhere than a field.
    public function refocus() { keys.focus(); }

    // `EditorCommands`: Swift's titles, shortcuts and live rules, read from `Menus`, which Rust fills.
    // Bare keys are live only while no field holds the keyboard, or the menu would take the digit first.
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open Folder…"; shortcut: @keys(Control + "o"); enabled: Menus.live.open; activated => { App.menu("open"); } }
            MenuItem { title: "Pair Phone…"; activated => { App.menu("pair-phone"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.mode; shortcut: @keys(Control + "g"); enabled: Menus.live.toggle-mode; activated => { App.menu("toggle-mode"); } }
            MenuItem { title: Menus.titles.export; shortcut: @keys(Control + "e"); enabled: Menus.live.export; activated => { App.menu("export"); } }
            MenuSeparator { }
            MenuItem { title: "Recheck Originals"; shortcut: @keys(Control + "r"); enabled: Menus.live.recheck; activated => { App.menu("recheck"); } }
            MenuItem { title: "Read the Folders Again"; enabled: Menus.live.read-folders; activated => { App.menu("read-folders"); } }
            MenuItem { title: "Show the Selected Photo"; enabled: Menus.live.show-selected; activated => { App.menu("show-selected"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.remove; shortcut: @keys(Control + Backspace); enabled: Menus.live.remove && keys.has-focus; activated => { App.menu("remove"); } }
            MenuItem { title: Menus.titles.restore; shortcut: @keys(Control + Shift + Backspace); enabled: Menus.live.restore && keys.has-focus; activated => { App.menu("restore"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: Menus.titles.undo; shortcut: @keys(Control + "z"); enabled: Menus.live.undo; activated => { App.menu("undo"); } }
            MenuItem { title: Menus.titles.redo; shortcut: @keys(Control + Shift + "z"); enabled: Menus.live.redo; activated => { App.menu("redo"); } }
            MenuSeparator { }
            MenuItem { title: "Reset to Imported State"; shortcut: @keys(Control + Shift + "r"); enabled: Menus.live.reset; activated => { App.menu("reset"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: Menus.titles.smaller; shortcut: @keys(Control + "-"); enabled: Menus.live.smaller; activated => { App.menu("smaller"); } }
            MenuItem { title: Menus.titles.larger; shortcut: @keys(Control + Shift? + "+"); enabled: Menus.live.larger; activated => { App.menu("larger"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.compare; enabled: Menus.live.compare; activated => { App.menu("compare"); } }
            MenuItem { title: Menus.titles.library; shortcut: @keys(Control + Alt + "["); enabled: Menus.live.hide-library; activated => { App.menu("hide-library"); } }
            MenuItem { title: Menus.titles.panel; shortcut: @keys(Control + Alt + "]"); enabled: Menus.live.hide-panel; activated => { App.menu("hide-panel"); } }
            MenuItem { title: "Crop and Straighten"; shortcut: @keys(Control + "k"); enabled: Menus.live.framing; activated => { App.menu("framing"); } }
            MenuItem { title: Menus.titles.correcting; enabled: Menus.live.correction; activated => { App.menu("correction"); } }
            MenuItem { title: "Bigger Brush"; shortcut: @keys("]"); enabled: Menus.live.bigger-brush && keys.has-focus; activated => { App.menu("bigger-brush"); } }
            MenuItem { title: "Smaller Brush"; shortcut: @keys("["); enabled: Menus.live.smaller-brush && keys.has-focus; activated => { App.menu("smaller-brush"); } }
            MenuItem { title: Menus.titles.mirror; shortcut: @keys(Control + Shift + "m"); enabled: Menus.live.mirror; activated => { App.menu("mirror"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.sound; activated => { App.menu("toggle-sound"); } }
            MenuItem { title: Menus.titles.half-size; activated => { App.menu("half-size"); } }
            MenuItem { title: Menus.titles.screen-gamut; shortcut: @keys(Control + Shift + "y"); enabled: Menus.live.screen-gamut; activated => { App.menu("screen-gamut"); } }
            MenuSeparator { }
            MenuItem { title: "Scanner Emulator"; enabled: Menus.live.emulator; activated => { App.menu("emulator"); } }
        }
        Menu {
            title: "Labels";
            MenuItem { title: "None"; shortcut: @keys("0"); enabled: Menus.live.medal && keys.has-focus; activated => { App.menu("medal-0"); } }
            MenuItem { title: "Bronze"; shortcut: @keys("1"); enabled: Menus.live.medal && keys.has-focus; activated => { App.menu("medal-1"); } }
            MenuItem { title: "Silver"; shortcut: @keys("2"); enabled: Menus.live.medal && keys.has-focus; activated => { App.menu("medal-2"); } }
            MenuItem { title: "Gold"; shortcut: @keys("3"); enabled: Menus.live.medal && keys.has-focus; activated => { App.menu("medal-3"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.filter; shortcut: @keys(Control + "l"); enabled: Menus.live.cycle-filter; activated => { App.menu("cycle-filter"); } }
        }
        Menu {
            title: "Rolls";
            MenuItem { title: Menus.titles.roll; shortcut: @keys(Control + Shift + "g"); enabled: Menus.live.new-roll; activated => { App.menu("new-roll"); } }
            MenuItem { title: Menus.titles.ungroup; shortcut: @keys(Control + Shift + Alt + "g"); enabled: Menus.live.ungroup; activated => { App.menu("ungroup"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.sheet; enabled: Menus.live.contact-sheet; activated => { App.menu("contact-sheet"); } }
            MenuItem { title: "Prepare the Roll…"; enabled: Menus.live.measure-roll; activated => { App.menu("prepare-roll"); } }
            MenuItem { title: "Reset to Default…"; enabled: Menus.live.reset-to-default; activated => { App.menu("reset-to-default"); } }
        }
        Menu {
            title: "Settings";
            MenuItem { title: "Copy Settings"; shortcut: @keys(Control + Shift + "c"); enabled: Menus.live.copy-settings; activated => { App.menu("copy"); } }
            MenuItem { title: Menus.titles.paste; shortcut: @keys(Control + Shift + "v"); enabled: Menus.live.paste-settings; activated => { App.menu("paste"); } }
            MenuItem { title: Menus.titles.paste-to-roll; enabled: Menus.live.paste-to-roll; activated => { App.menu("paste-to-roll"); } }
            MenuSeparator { }
            MenuItem { title: "Save as Preset…"; enabled: Menus.live.save-preset; activated => { App.menu("save-preset"); } }
            MenuItem { title: "Edit Presets…"; enabled: Menus.live.edit-presets; activated => { App.menu("edit-presets"); } }
            MenuItem { title: "Import Presets…"; enabled: Menus.live.import-presets; activated => { App.menu("import-presets"); } }
            MenuItem { title: "Paste Preset Code"; enabled: Menus.live.paste-preset-code; activated => { App.menu("paste-preset-code"); } }
            MenuItem { title: "Show Presets Folder"; enabled: Menus.live.show-presets; activated => { App.menu("show-presets"); } }
            MenuSeparator { }
            if Menus.presets.length == 0: MenuItem { title: "No presets"; enabled: false; }
            if Menus.presets.length > 0: MenuItem { title: Menus.apply-title; enabled: false; }
            for line[i] in Menus.presets: MenuItem { title: line; enabled: Menus.live.apply-preset; activated => { Menus.apply-preset(i); } }
            if Menus.presets.length > 0: MenuSeparator { }
            if Menus.presets.length > 0: Menu {
                title: "Delete a Preset";
                for name[i] in Menus.preset-names: MenuItem { title: name; activated => { Menus.delete-preset(i); } }
            }
        }
        Menu {
            title: "Help";
            // Slint builds the macOS application menu itself, so the item Swift lays after About is here.
            MenuItem { title: "Check for Updates…"; activated => { App.menu("check-updates"); } }
            MenuSeparator { }
            MenuItem { title: "Show Console"; activated => { App.menu("console"); } }
            MenuItem { title: "What's New in ONI " + Help.release; activated => { App.menu("welcome"); } }
            MenuItem { title: "Show What's New Again"; activated => { App.menu("whats-new"); } }
            MenuItem { title: "Report a Bug / Give Feedback…"; activated => { App.menu("report"); } }
            MenuItem { title: "Show My Year on Film"; enabled: !Wrapped.shown; activated => { App.menu("wrapped"); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " " && Canvas.painting) {
                Canvas.space-held = true;
                return EventResult.accept;
            }
            if (App.key(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.shift, event.modifiers.alt, event.repeat)) {
                return EventResult.accept;
            }
            EventResult.reject
        }
        key-released(event) => {
            if (event.text == " ") {
                Canvas.space-held = false;
                return EventResult.accept;
            }
            EventResult.reject
        }
        VerticalLayout {
            // The export surface hides the bar whole: every gesture there is the panel's.
            if !Exporting.shown: Toolbar { }
            HorizontalLayout {
                vertical-stretch: 1;
                // The gallery always lists the library; beside a photo the column can be hidden.
                if (App.gallery || !App.library-hidden) && !Exporting.shown: Tree { width: ShellStyle.library-width; beside-photo: !App.gallery; }
                Rectangle {
                    horizontal-stretch: 1;
                    // `card`: flush with the columns and the status bar, inset on all four sides only on export.
                    property <length> status: StatusStyle.height + 2 * Space.s;
                    card := CanvasCard {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                        visible: root.beside-photo;
                        library-hidden: App.library-hidden;
                        panel-hidden: App.panel-hidden;
                        menu(m) => { App.menu(m); }
                        refocused => { root.refocus(); }
                        column-toggled(leading) => {
                            if (leading) { root.revealed-library = false; } else { root.revealed-panel = false; }
                        }
                    }
                    Card {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                        visible: root.grid-shown;
                        Grid { }
                    }
                    // On export the card floats in the ground, all four corners showing, with no status bar.
                    if Exporting.shown: Card {
                        x: CardStyle.inset;
                        y: CardStyle.inset;
                        width: parent.width - 2 * CardStyle.inset;
                        height: parent.height - 2 * CardStyle.inset;
                        ExportColumn { width: parent.width; height: parent.height; }
                    }
                    if Preparing.shown: RollFloor {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                    }
                    if !Exporting.shown: CardStatus {
                        x: 0;
                        y: parent.height - parent.status;
                        width: parent.width;
                        height: parent.status;
                        gallery: App.gallery;
                        editor-line: Canvas.status;
                    }
                    // `floating(_:)`: a hidden column's edge strip slides it over the card while hovered.
                    if root.beside-photo && App.library-hidden: TouchArea {
                        y: 0;
                        x: 0;
                        width: Space.m;
                        height: card.height;
                        changed has-hover => { if (self.has-hover) { root.revealed-library = true; } }
                    }
                    if root.beside-photo && App.panel-hidden: TouchArea {
                        y: 0;
                        x: parent.width - self.width;
                        width: Space.m;
                        height: card.height;
                        changed has-hover => { if (self.has-hover) { root.revealed-panel = true; } }
                    }
                    if root.beside-photo && App.library-hidden: TouchArea {
                        y: 0;
                        width: ShellStyle.library-width + 2 * Space.s;
                        height: card.height;
                        x: root.revealed-library ? 0 : -self.width;
                        visible: root.revealed-library || self.x > -self.width;
                        animate x { duration: root.revealed-library ? Motion.slide : 0ms; }
                        changed has-hover => { if (!self.has-hover) { root.revealed-library = false; } }
                        FloatingColumn {
                            x: Space.s;
                            y: Space.s;
                            width: parent.width - 2 * Space.s;
                            height: parent.height - 2 * Space.s;
                            Tree { width: parent.width; height: parent.height; beside-photo: true; }
                        }
                    }
                    if root.beside-photo && App.panel-hidden: TouchArea {
                        y: 0;
                        width: ShellStyle.panel-width + 2 * Space.s;
                        height: card.height;
                        x: root.revealed-panel ? parent.width - self.width : parent.width;
                        visible: root.revealed-panel || self.x < parent.width;
                        animate x { duration: root.revealed-panel ? Motion.slide : 0ms; }
                        changed has-hover => { if (!self.has-hover) { root.revealed-panel = false; } }
                        FloatingColumn {
                            x: Space.s;
                            y: Space.s;
                            width: parent.width - 2 * Space.s;
                            height: parent.height - 2 * Space.s;
                            Panel { height: parent.height; }
                        }
                    }
                }
                if !App.panel-hidden && !App.gallery && !Exporting.shown && !Preparing.shown: Panel { }
                if App.gallery && !Exporting.shown && !Preparing.shown: Info { }
                if Preparing.shown: RollPanel { }
                if Exporting.shown: ExportPanel { }
            }
        }
    }

    if Presets.saving: PresetSaveSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Presets.editing: PresetEditorSheet { x: 0; y: 0; width: root.width; height: root.height; }

    if Pairing.shown: PairingSheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    if Notice.shown: NoticeSheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
    if Navigator.catch-up-shown: RootsCatchUpSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.confirm-shown: ExportConfirmSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.notice-shown: ExportNoticeSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Stocks.shown: StockPickerSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.papers-shown: PaperSheet { x: 0; y: 0; width: root.width; height: root.height; }

    if Help.welcome-shown: WelcomeSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Help.report-shown: ReportSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Choice.shown: ChoiceSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if MaskDialog.shown: MaskDialogSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Advice.shown: AdviceSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Wrapped.shown: WrappedView { x: 0; y: 0; width: root.width; height: root.height; }
    // Last, so a question asked over another sheet, as quitting's, is drawn over it.
    if Confirm.shown: ConfirmSheet { x: 0; y: 0; width: root.width; height: root.height; }

    TipLayer { room: root.width; room-height: root.height; }

    init => { keys.focus(); }
}
