// The editor window: the bar, the library column, the canvas card or the gallery, the panel.
import { Act } from "act.slint";
import { DS, StarterView, Starter, Clicks, Outside, KeyMonitor, Keyboard, Tip, Tips, TipBox, Icons, AppWindow, TipLayer, Card, CardCorners, Picture, SplitGuide, FrameOverlay, FrameStyle, CorrectionMark, Badge, Button, ButtonGroup, ButtonSize, ButtonKind, Label, Progress, Raised, Lift, Motion, TextRole, Tone, Sheet, Space, Ground, CardStyle, SheetStyle, StatusStyle, ShellStyle, FormStyle, HelpLayer, LabCell, MenuLine } from "ds/ds.slint";
import { Store } from "store.slint";
import { Panel, Plots, PanelState, PanelTab, RollState, DetailLoupe, Lab, Framing, Dedust, CorrectionRow } from "panel.slint";
import { Toolbar, Bar } from "toolbar.slint";
import { ModeRings } from "mode_rings.slint";
import { Gallery, Library, InfoKind, Tile, Heading, TreeRow, TreePin, TreeDrag, TrashLine, StockCount } from "library.slint";
import { Info } from "info_sidebar.slint";
import { CardStatus } from "card_status.slint";
import { Canvas, Mark, CanvasCard } from "canvas.slint";
import { Tree } from "library_tree.slint";
import { FloatingColumn } from "floating.slint";
import { Navigator, FolderLine, WelcomeLine, CatchUpLine, RootsCatchUpSheet } from "navigator.slint";
import { Pairing, PairingSheet } from "pairing.slint";
import { AppSettings, SettingsSheet } from "settings.slint";
import { Notice, NoticeSheet, Upgraded, UpgradedSheet } from "notice.slint";
import { Stocks, StockBrand, StockRow, StockCell, StockPickerSheet } from "stocks.slint";
import { Help, News, WelcomeSheet, ReportSheet, ConsoleWindow, SceneClock } from "help.slint";
import { Wrapped, WrappedFace, WrappedView } from "wrapped.slint";
import { MaskDialog, MaskDialogSheet } from "masks.slint";
import { Presets, PresetCard, CarriesLine, Advice, AdviceSheet, Choice, ChoiceSheet, PresetSaveSheet, PresetEditorSheet } from "presets.slint";
import { PresetDeck } from "preset_deck.slint";
import { Exporting, ExportLine, ExportColumn, ExportPanel, SpaceChip, ExportConfirmSheet, ExportNoticeSheet, PresetNameSheet, PaperRow, SheetTile } from "export.slint";
import { PaperSheet } from "export_papers.slint";
import { Preparing, RollCell, RollPanel, RollFloor } from "prepare.slint";
import { Confirm, ConfirmSheet } from "confirm.slint";
import { Absent, Unsaved, UnsavedSheet } from "missing.slint";
import { Told, ToldNotice } from "told.slint";
import { KeyWords } from "key_words.slint";
import { Converting, DngSheet, DngStage } from "dng.slint";
import { Menus, MenuTitles, MenuLive } from "menus.slint";

export { DS, Motion, Clicks, Outside, Tip, Tips, TipBox, Icons, LabCell, Store, Plots, PanelState, PanelTab, RollState, InfoKind, DetailLoupe, Lab, Framing, Dedust, CorrectionRow, Bar, Library, Tile, Heading, TreeRow, TreePin, TreeDrag, TrashLine, StockCount, MenuLine, Navigator, FolderLine, WelcomeLine, CatchUpLine, Pairing, AppSettings, Notice, Upgraded, Starter, Exporting, ExportLine, PaperRow, SheetTile }
export { Editors } from "editors.slint";
export { Presets, PresetCard, CarriesLine, Advice, Choice, Help, News, SceneClock, ConsoleWindow, Wrapped, WrappedFace }
export { MaskDialog, Confirm, Absent, Unsaved, Told, Stocks, StockBrand, StockRow, StockCell }
export { Gear, GearKind } from "gear_state.slint";
export { Preparing, RollCell, Canvas, Mark, Act, KeyWords, Converting, DngStage, Menus, MenuTitles, MenuLive }
export { FieldProbe, ScrollProbe, KeyProbe, DepthProbe, GroupProbe, OutsideProbe, SubmenuProbe, KeyboardProbe } from "ds/probes.slint";
export { StateProbe, HueProbe, ScreenProbe } from "ds/probe_states.slint";
export { Raster, KeycapLook, Depth, Readouts } from "ds/ds.slint";
export { Ink, PlotLine, PlotDot, PlotKnob, PlotReadout, AskKey, AskRole, PreviewState, Reach, EdgeNumber, SheetBox, SheetInks } from "ds/ds.slint";

export global App {
    in-out property <bool> gallery;
    // A build without a release's stamp: the developer's menu items show.
    in property <bool> dev;
    in property <bool> panel-hidden;
    in property <bool> library-hidden;
    // A key with control, meta, shift and alt, then whether it repeats; Slint hands ⌘ as control on
    // macOS, its Control key as meta; Rust answers whether the key was claimed.
    callback key(string, bool, bool, bool, bool, bool) -> bool;
    callback menu(Act);
    // A sheet shown or closed, so the menus go dark behind it or come back.
    callback sheet-changed();
}

export component MainWindow inherits AppWindow {
    title: @tr("Open Negative Initiative");
    icon: @image-url("icons/app-icon.png");
    out property <bool> keys-focused: keys.has-focus;
    out property <bool> keys-held: keys.held;
    // Where the shown note lands.
    out property <TipBox> tip-box: tips.box;
    // The editor panel's left edge and its tab bar's foot, where the window's checks aim and a help card tops.
    out property <length> panel-x: root.width - ShellStyle.panel-width - (App.panel-hidden ? Space.s : 0px);
    out property <length> tabs-foot: ShellStyle.bar-height + PanelState.header + (App.panel-hidden ? Space.s : 0px);
    // The column holding the help marks, at the window's right, and where a mark's card tops beside it.
    property <length> column-x: root.width - (Exporting.shown ? FormStyle.panel-width : ShellStyle.panel-width) - (root.beside-photo && App.panel-hidden ? Space.s : 0px);
    property <length> card-top: root.beside-photo ? root.tabs-foot : (Exporting.shown ? 0px : ShellStyle.bar-height) + Space.s;
    // `revealedLibrary` and `revealedPanel`: a hidden column slid over the card by the pointer, only while it floats.
    out property <bool> revealed-library;
    out property <bool> revealed-panel;
    property <bool> beside-photo: !App.gallery && !Exporting.shown && !Preparing.shown;
    property <bool> library-floats: root.beside-photo && App.library-hidden;
    property <bool> panel-floats: root.beside-photo && App.panel-hidden;
    changed library-floats => { root.revealed-library = false; }
    changed panel-floats => { root.revealed-panel = false; }
    // `mode == .gallery`: the grid mounts afresh each time it shows, and lands on the open photo.
    out property <bool> grid-shown: App.gallery && !Exporting.shown && !Preparing.shown;
    // A new screen gives the keyboard to its photos and takes the tooltip down, a key of the last one gone
    // with them: Slint tells a key removed or covered under a resting hand nothing.
    changed grid-shown => { keys.focus(); Tip.shown = false; Tips.close(); if (self.grid-shown) { Library.gallery-shown(); } }
    changed beside-photo => { keys.focus(); Tip.shown = false; Tips.close(); }
    // A help card goes with its mark: the pane, the face, what Info stands on, the hidden panel sliding off.
    property <PanelTab> pane: PanelState.tab;
    property <bool> face: Lab.shown;
    property <InfoKind> info: Library.info-kind;
    property <bool> panel-seen: !App.panel-hidden || root.revealed-panel;
    changed pane => { Tips.close(); }
    changed face => { Tips.close(); }
    changed info => { Tips.close(); }
    changed panel-seen => { Tips.close(); }
    // Any sheet over the window, every flag that lays one below.
    out property <bool> sheet-shown: Presets.saving || Presets.editing || Confirm.shown || Pairing.shown || AppSettings.shown || Notice.shown
        || Navigator.catch-up-shown || Exporting.confirm-shown || Exporting.notice-shown || Exporting.naming-shown || Stocks.shown
        || Exporting.papers-shown || Help.welcome-shown || Help.report-shown || Choice.shown || MaskDialog.shown
        || Advice.shown || Wrapped.shown || Unsaved.shown || Converting.shown;
    // A sheet shown takes the keyboard from what is behind it (`Sheet`), and the tooltip, as a new screen
    // does; closed, it hands the keyboard back, its own field going with it.
    changed sheet-shown => {
        App.sheet-changed();
        Keyboard.covered = self.sheet-shown;
        Tip.shown = false;
        Tips.close();
        if (!self.sheet-shown) { keys.focus(); }
    }
    // Gives the key monitor the keyboard back after a click elsewhere than a field, and from a field
    // behind a sheet; the sheet then takes it, as Tab entering it does.
    public function refocus() { keys.focus(); if (root.sheet-shown) { Keyboard.entered += 1; } }

    // `EditorCommands`: Swift's titles, shortcuts and live rules, read from `Menus`, which Rust fills.
    // A key a field answers itself (a digit, ⌘⌫, ⌘Z) is live only while no field holds the keyboard:
    // the menu hears a key before the field does.
    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("Open Folder…"); shortcut: @keys(Control + "o"); enabled: Menus.live.open; activated => { App.menu(Act.open); } }
            MenuItem { title: Menus.titles.project; enabled: Menus.live.new-project; activated => { App.menu(Act.new-project); } }
            if Pairing.available: MenuItem { title: @tr("Pair Phone…"); activated => { App.menu(Act.pair-phone); } }
            MenuItem { title: @tr("Settings…"); shortcut: @keys(Control + ","); activated => { App.menu(Act.settings); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.mode; shortcut: @keys(Control + "g"); enabled: Menus.live.toggle-mode; activated => { App.menu(Act.toggle-mode); } }
            MenuItem { title: Menus.titles.export; shortcut: @keys(Control + "e"); enabled: Menus.live.export; activated => { App.menu(Act.export); } }
            MenuSeparator { }
            MenuItem { title: @tr("Refresh"); shortcut: @keys(Control + "r"); enabled: Menus.live.refresh; activated => { App.menu(Act.refresh); } }
            MenuItem { title: @tr("Show the Selected Photo"); enabled: Menus.live.show-selected; activated => { App.menu(Act.show-selected); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.remove; shortcut: @keys(Control + Backspace); enabled: Menus.live.remove && keys.held; activated => { App.menu(Act.remove); } }
            MenuItem { title: Menus.titles.restore; shortcut: @keys(Control + Shift + Backspace); enabled: Menus.live.restore && keys.held; activated => { App.menu(Act.restore); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: Menus.titles.undo; shortcut: @keys(Control + "z"); enabled: Menus.live.undo && keys.held; activated => { App.menu(Act.undo); } }
            MenuItem { title: Menus.titles.redo; shortcut: @keys(Control + Shift + "z"); enabled: Menus.live.redo && keys.held; activated => { App.menu(Act.redo); } }
            MenuSeparator { }
            MenuItem { title: @tr("Reset Settings"); shortcut: @keys(Control + Shift + "r"); enabled: Menus.live.reset; activated => { App.menu(Act.reset); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: Menus.titles.smaller; shortcut: @keys(Control + "-"); enabled: Menus.live.smaller; activated => { App.menu(Act.smaller); } }
            MenuItem { title: Menus.titles.larger; shortcut: @keys(Control + Shift? + "+"); enabled: Menus.live.larger; activated => { App.menu(Act.larger); } }
            MenuItem { title: @tr("Zoom to Fit"); shortcut: @keys(Control + "0"); enabled: Menus.live.fit; activated => { App.menu(Act.fit); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.compare; enabled: Menus.live.compare; activated => { App.menu(Act.compare); } }
            MenuItem { title: Menus.titles.library; shortcut: @keys(Control + Alt + "["); enabled: Menus.live.hide-library; activated => { App.menu(Act.hide-library); } }
            MenuItem { title: Menus.titles.panel; shortcut: @keys(Control + Alt + "]"); enabled: Menus.live.hide-panel; activated => { App.menu(Act.hide-panel); } }
            MenuItem { title: @tr("Crop and Straighten"); shortcut: @keys(Control + "k"); enabled: Menus.live.framing; activated => { App.menu(Act.framing); } }
            MenuItem { title: Menus.titles.correcting; enabled: Menus.live.correction; activated => { App.menu(Act.correction); } }
            MenuItem { title: @tr("Bigger Brush"); shortcut: @keys("]"); enabled: Menus.live.bigger-brush && keys.held; activated => { App.menu(Act.bigger-brush); } }
            MenuItem { title: @tr("Smaller Brush"); shortcut: @keys("["); enabled: Menus.live.smaller-brush && keys.held; activated => { App.menu(Act.smaller-brush); } }
            MenuItem { title: Menus.titles.mirror; shortcut: @keys(Control + Shift + "m"); enabled: Menus.live.mirror; activated => { App.menu(Act.mirror); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.sound; activated => { App.menu(Act.toggle-sound); } }
            MenuItem { title: Menus.titles.screen-gamut; shortcut: @keys(Control + Shift + "y"); enabled: Menus.live.screen-gamut; activated => { App.menu(Act.screen-gamut); } }
            MenuSeparator { }
            MenuItem { title: @tr("Scanner Emulator"); enabled: Menus.live.emulator; activated => { App.menu(Act.emulator); } }
        }
        Menu {
            title: @tr("Labels");
            MenuItem { title: @tr("None"); shortcut: @keys("0"); enabled: Menus.live.medal && keys.held; activated => { App.menu(Act.medal-none); } }
            MenuItem { title: @tr("Gold"); shortcut: @keys("1"); enabled: Menus.live.medal && keys.held; activated => { App.menu(Act.medal-gold); } }
            MenuItem { title: @tr("Silver"); shortcut: @keys("2"); enabled: Menus.live.medal && keys.held; activated => { App.menu(Act.medal-silver); } }
            MenuItem { title: @tr("Bronze"); shortcut: @keys("3"); enabled: Menus.live.medal && keys.held; activated => { App.menu(Act.medal-bronze); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles.filter; shortcut: @keys(Control + "l"); enabled: Menus.live.cycle-filter; activated => { App.menu(Act.cycle-filter); } }
        }
        Menu {
            title: @tr("Rolls");
            MenuItem { title: Menus.titles.roll; shortcut: @keys(Control + Shift + "g"); enabled: Menus.live.new-roll; activated => { App.menu(Act.new-roll); } }
            MenuItem { title: Menus.titles.ungroup; shortcut: @keys(Control + Shift + Alt + "g"); enabled: Menus.live.ungroup; activated => { App.menu(Act.ungroup); } }
            MenuSeparator { }
            MenuItem { title: @tr("Prepare the Roll…"); enabled: Menus.live.measure-roll; activated => { App.menu(Act.prepare-roll); } }
            MenuItem { title: @tr("Reset the Roll…"); enabled: Menus.live.reset-to-default; activated => { App.menu(Act.reset-to-default); } }
        }
        Menu {
            title: @tr("Settings");
            MenuItem { title: @tr("Copy Settings…"); shortcut: @keys(Control + Shift + "c"); enabled: Menus.live.copy-settings; activated => { App.menu(Act.copy); } }
            MenuItem { title: Menus.titles.paste; shortcut: @keys(Control + Shift + "v"); enabled: Menus.live.paste-settings; activated => { App.menu(Act.paste); } }
            MenuItem { title: Menus.titles.paste-to-roll; shortcut: @keys(Control + Alt + "v"); enabled: Menus.live.paste-to-roll; activated => { App.menu(Act.paste-to-roll); } }
            MenuSeparator { }
            MenuItem { title: @tr("Save as Preset…"); enabled: Menus.live.save-preset; activated => { App.menu(Act.save-preset); } }
            MenuItem { title: @tr("Edit Presets…"); enabled: Menus.live.edit-presets; activated => { App.menu(Act.edit-presets); } }
            MenuItem { title: @tr("Import Presets…"); enabled: Menus.live.import-presets; activated => { App.menu(Act.import-presets); } }
            MenuItem { title: @tr("Paste Preset Code"); enabled: Menus.live.paste-preset-code; activated => { App.menu(Act.paste-preset-code); } }
            MenuItem { title: @tr("Show Presets Folder"); enabled: Menus.live.show-presets; activated => { App.menu(Act.show-presets); } }
            MenuSeparator { }
            if Menus.presets.length == 0: MenuItem { title: @tr("No Presets"); enabled: false; }
            if Menus.presets.length > 0: MenuItem { title: Menus.apply-title; enabled: false; }
            for line[i] in Menus.presets: MenuItem { title: line; enabled: Menus.live.apply-preset; activated => { Menus.apply-preset(i); } }
            if Menus.presets.length > 0: MenuSeparator { }
            if Menus.presets.length > 0: Menu {
                title: @tr("Delete a Preset");
                for name[i] in Menus.preset-names: MenuItem { title: name; activated => { Menus.delete-preset(i); } }
            }
        }
        Menu {
            title: @tr("Help");
            // Slint builds the macOS application menu itself, so the item Swift lays after About is here.
            MenuItem { title: @tr("Check for Updates…"); activated => { App.menu(Act.check-updates); } }
            MenuSeparator { }
            MenuItem { title: @tr("Show Diagnostic Log"); activated => { App.menu(Act.console); } }
            MenuItem { title: @tr("What's New in ONI {}", Help.release); activated => { App.menu(Act.welcome); } }
            MenuItem { title: @tr("Show What's New Again"); activated => { App.menu(Act.whats-new); } }
            MenuItem { title: @tr("Report a Bug / Give Feedback…"); activated => { App.menu(Act.report); } }
            MenuItem { title: @tr("Show My Year on Film"); enabled: !Wrapped.shown; activated => { App.menu(Act.wrapped); } }
        }
    }

    // The photos' keyboard: a press beside a field or a control gives it back here.
    keys := KeyMonitor {
        // A key released while another window held the focus never comes: Space is let go with it.
        changed has-focus => {
            if (!self.has-focus) {
                Canvas.space-held = false;
            }
        }
        key-pressed(event) => {
            if (event.text == " " && Canvas.painting) {
                Canvas.space-held = true;
                return EventResult.accept;
            }
            if (App.key(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.shift, event.modifiers.alt, event.repeat)) {
                return EventResult.accept;
            }
            EventResult.reject
        }
        key-released(event) => {
            if (event.text == " ") {
                Canvas.space-held = false;
                return EventResult.accept;
            }
            EventResult.reject
        }
        VerticalLayout {
            // The export surface hides the bar whole: every gesture there is the panel's.
            // The columns and the bar drawn once into a texture each, kept while nothing in them changes:
            // femtovg redraws the whole window at every frame a pan moves, every row of the tree included.
            if !Exporting.shown: Toolbar { cache-rendering-hint: true; }
            // Without the bar, the export keeps its room under the traffic lights, which drags the window.
            if Exporting.shown && Bar.traffic-lights > 0: TouchArea {
                height: ShellStyle.bar-height;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { Bar.room-pressed(); }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                // The gallery always lists the library; beside a photo the column can be hidden.
                if (App.gallery || !App.library-hidden) && !Exporting.shown: Tree { width: ShellStyle.library-width; beside-photo: !App.gallery; cache-rendering-hint: true; }
                // Hovered while the pointer is on the card and no popup holds it, which a held column reads.
                card-area := TouchArea {
                    horizontal-stretch: 1;
                    enabled: root.revealed-library || root.revealed-panel;
                    // `card`: flush with the columns and the status bar, inset on all four sides only on export.
                    property <length> status: StatusStyle.height + 2 * Space.s;
                    card := CanvasCard {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                        visible: root.beside-photo;
                        library-hidden: App.library-hidden;
                        panel-hidden: App.panel-hidden;
                        menu(m) => { App.menu(m); }
                        refocused => { root.refocus(); }
                    }
                    Card {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                        visible: root.grid-shown;
                        Gallery { refocused => { root.refocus(); } }
                        CardCorners { width: parent.width; height: parent.height; }
                    }
                    // On export the card floats in the ground, all four corners showing, with no status bar.
                    if Exporting.shown: Card {
                        x: CardStyle.inset;
                        y: CardStyle.inset;
                        width: parent.width - 2 * CardStyle.inset;
                        height: parent.height - 2 * CardStyle.inset;
                        ExportColumn { width: parent.width; height: parent.height; }
                        CardCorners { width: parent.width; height: parent.height; }
                    }
                    if Preparing.shown: RollFloor {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - parent.status;
                    }
                    if !Exporting.shown: CardStatus {
                        x: 0;
                        y: parent.height - parent.status;
                        width: parent.width;
                        height: parent.status;
                        gallery: App.gallery;
                        editor-line: Canvas.status;
                    }
                    // `floating(_:)`: a hidden column's edge strip slides it over the card while hovered.
                    if root.library-floats: TouchArea {
                        x: 0; y: 0;
                        width: Space.m;
                        height: card.height;
                        changed has-hover => { if (self.has-hover) { root.revealed-library = true; } }
                    }
                    if root.panel-floats: TouchArea {
                        y: 0;
                        x: parent.width - self.width;
                        width: Space.m;
                        height: card.height;
                        changed has-hover => { if (self.has-hover) { root.revealed-panel = true; } }
                    }
                    if root.library-floats: FloatingColumn {
                        revealed <=> root.revealed-library;
                        room: parent.width; card-hovered: card-area.has-hover;
                        width: ShellStyle.library-width + 2 * Space.s; height: card.height;
                        // Laid by the card's column, inside its inset: sized on the strip, it ran past the card.
                        Tree { beside-photo: true; floating: true; cache-rendering-hint: true; }
                    }
                    if root.panel-floats: FloatingColumn {
                        revealed <=> root.revealed-panel; trailing: true;
                        room: parent.width; card-hovered: card-area.has-hover;
                        width: ShellStyle.panel-width + 2 * Space.s; height: card.height;
                        Panel { }
                    }
                }
                if !App.panel-hidden && !App.gallery && !Exporting.shown && !Preparing.shown: Panel { cache-rendering-hint: true; }
                if App.gallery && !Exporting.shown && !Preparing.shown: Info { }
                if Preparing.shown: RollPanel { }
                if Exporting.shown: ExportPanel { }
            }
        }
    }

    if Tip.open != "": HelpLayer { width: root.width; height: root.height; column-x: root.column-x; top: root.card-top; }

    if Presets.saving: PresetSaveSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Presets.editing: PresetEditorSheet { x: 0; y: 0; width: root.width; height: root.height; }

    if Pairing.shown: PairingSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if AppSettings.shown: SettingsSheet { x: 0; y: 0; width: root.width; height: root.height; }

    if Notice.shown: NoticeSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Navigator.catch-up-shown: RootsCatchUpSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.confirm-shown: ExportConfirmSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.notice-shown: ExportNoticeSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.naming-shown: PresetNameSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Stocks.shown: StockPickerSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.papers-shown: PaperSheet { x: 0; y: 0; width: root.width; height: root.height; }

    if Help.welcome-shown: WelcomeSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Upgraded.shown: UpgradedSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Help.report-shown: ReportSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Choice.shown: ChoiceSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if MaskDialog.shown: MaskDialogSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Advice.shown: AdviceSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Wrapped.shown: WrappedView { x: 0; y: 0; width: root.width; height: root.height; }
    if Unsaved.shown: UnsavedSheet { x: 0; y: 0; width: root.width; height: root.height; }
    if Converting.shown: DngSheet { x: 0; y: 0; width: root.width; height: root.height; }
    // Last, so a question asked over another sheet, as quitting's, is drawn over it.
    if Confirm.shown: ConfirmSheet { x: 0; y: 0; width: root.width; height: root.height; }

    // Where the content starts in the window: under Slint's own menu bar where the system has none.
    origin := Rectangle { x: 0; y: 0; width: 0; height: 0; }
    // The notice and the tooltips, laid from the absolute positions of what they speak of, lie in the
    // window's own space, so they land where those point whatever stands above the content.
    Rectangle {
        x: -origin.absolute-position.x;
        y: -origin.absolute-position.y;
        width: root.width;
        height: root.height;
        // The canvas's tools held, a ring of each around the card and its tab from its key, over the card.
        if !Exporting.shown: ModeRings {
            x: 0; y: 0; width: parent.width; height: parent.height;
            card-x: card-area.absolute-position.x;
            card-y: card-area.absolute-position.y;
            card-width: card-area.width;
            card-height: card-area.height - card-area.status;
            square-top-right: root.beside-photo;
            square-left: root.beside-photo && App.library-hidden;
            square-right: root.beside-photo && App.panel-hidden;
        }
        // The notice at the bottom right of the view the hand works in, above its status bar.
        if Told.shown: ToldNotice {
            room: root.width;
            right: card-area.absolute-position.x + card-area.width;
            bottom: card-area.absolute-position.y + card-area.height - (Exporting.shown ? CardStyle.inset : card-area.status);
        }
        tips := TipLayer { room: root.width; room-height: root.height; }
    }
    // A press hides a tooltip, as AppKit's: the key may change its help or vanish under the hand.
    property <int> presses: Outside.presses;
    changed presses => { Tip.shown = false; }
    // Last, over everything: the app beneath stands up while the starter says each step.
    if Starter.shown: StarterView { x: 0; y: 0; width: root.width; height: root.height; }

    init => { keys.focus(); Keyboard.covered = self.sheet-shown; }
}
