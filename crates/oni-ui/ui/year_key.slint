// The year on film's key in the bar: a keycap as the bar's others, its glyph over its word, its face the
// welcome gifts' holographic foil. Its word is the first the bar lets go of.
import { Icons, Button } from "ds/ds.slint";
import { Wrapped } from "wrapped.slint";

export component YearKey inherits Button {
    in property <bool> worded: true;
    stacked: true;
    in-bar: true;
    has-icon: true;
    keycap: true;
    foil: true;
    icon: Icons.film;
    text: root.worded ? Wrapped.title : "";
    help: Wrapped.title;
    enabled: !Wrapped.shown;
    clicked => { Wrapped.open(); }
}
