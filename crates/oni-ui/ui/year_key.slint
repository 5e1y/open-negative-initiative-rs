// The year on film's key beside the mode's key: a keycap of the interface's grey as the bar's others, its glyph over
// its word in their ink, folded with theirs.
import { Icons, Button } from "ds/ds.slint";
import { Wrapped } from "wrapped.slint";

export component YearKey inherits Button {
    in property <bool> worded: true;
    stacked: true;
    in-bar: true;
    has-icon: true;
    keycap: true;
    icon: Icons.film;
    text: root.worded ? Wrapped.title : "";
    help: Wrapped.title;
    enabled: !Wrapped.shown;
    clicked => { Wrapped.open(); }
}
