// The library column: the navigator over the opened folder's tree, or the projects' tree.
import { NavigatorSection } from "navigator.slint";
import { Picker, PickerFace, MenuLine, Surface, Space, ShellStyle, Tabs, RowsEmpty, Menu, SelectionRing, Radius, DropLine, Badge, Button, ButtonSize } from "ds/ds.slint";
import { Library } from "library.slint";
import { RowTree } from "row_tree.slint";

// `librarySidebar`: in the gallery the navigator takes the archive's column; beside a photo the
// navigator keeps its height over the opened folder's tree with its photos.
export component Tree inherits Surface {
    in property <bool> beside-photo;
    property <length> menu-x;
    property <length> menu-y;
    // `sidebarLayout` follows the mode: the projects' tree is laid again by the other one.
    changed beside-photo => { Library.tree-moded(); }
    // `SidebarLayout`'s names, in its order, then the view's lines on each tree.
    property <[string]> layouts: [@tr("Names only"), @tr("Two per row"), @tr("One per row")];
    property <[MenuLine]> archive-view: [
        { text: root.layouts[0], enabled: true, rule: false, opens: false },
        { text: root.layouts[1], enabled: true, rule: false, opens: false },
        { text: root.layouts[2], enabled: true, rule: false, opens: false },
        { text: @tr("Show the Selected Photo"), enabled: true, rule: true, opens: false },
    ];
    property <[MenuLine]> project-view: [
        { text: root.layouts[0], enabled: true, rule: false, opens: false },
        { text: root.layouts[1], enabled: true, rule: false, opens: false },
        { text: root.layouts[2], enabled: true, rule: false, opens: false },
        { text: @tr("Show the Selected Photo"), enabled: true, rule: true, opens: false },
        { text: Library.projects-any-open ? @tr("Fold every folder") : @tr("Open every folder"), enabled: true, rule: false, opens: false },
    ];
    // Each part pads itself by the column's one inset: the tab bar, the headers, the rows.
    VerticalLayout {
        HorizontalLayout {
            padding-left: ShellStyle.column-inset;
            padding-right: ShellStyle.column-inset;
            padding-top: Space.s;
            padding-bottom: Space.s;
            Tabs {
                tabs: [@tr("Archive"), @tr("Projects")];
                selected: Library.surface;
                picked(i) => { Library.surface = i; Library.surface-picked(i); }
            }
        }
        if Library.surface == 0: NavigatorSection {
            vertical-stretch: root.beside-photo ? 0 : 1;
            beside-photo: root.beside-photo;
            trash-rows: Library.trash-rows;
            trash-clicked(i) => { Library.trash-row-clicked(i); }
            trash-folded(i) => { Library.trash-row-folded(i); }
            trash-restore(i) => { Library.trash-row-restore(i); }
            trash-menu(i, x, y) => {
                root.menu-x = x - root.absolute-position.x;
                root.menu-y = y - root.absolute-position.y;
                if (Library.trash-row-menu(i)) { menu.show(); }
            }
        }
        // The tree's view in words, a select of its layouts, the photo selected and, on the projects, every
        // folder opened or folded, New Project beside it; under the tab bar its padding stands above.
        if Library.surface == 1 || root.beside-photo: HorizontalLayout {
            padding-left: ShellStyle.column-inset;
            padding-right: ShellStyle.column-inset;
            padding-top: Library.surface == 1 ? 0 : Space.s;
            padding-bottom: Space.s;
            spacing: Space.s;
            Picker {
                face: PickerFace.pill;
                horizontal-stretch: 1;
                value: root.layouts[Library.tree-layout];
                lines: Library.surface == 1 ? root.project-view : root.archive-view;
                chosen(i) => {
                    if (i < root.layouts.length) {
                        Library.tree-layout-picked(i);
                    } else if (i > root.layouts.length) {
                        Library.project-fold-all();
                    } else if (Library.surface == 0) {
                        Library.tree-centre();
                    } else {
                        Library.project-centre();
                    }
                }
            }
            if Library.surface == 1: Button {
                size: ButtonSize.mini;
                text: @tr("New Project");
                clicked => { Library.new-project(); }
            }
        }
        if Library.surface == 0 && root.beside-photo: RowTree {
            vertical-stretch: 1;
            rows: Library.near-rows;
            pin: Library.tree-pin;
            content-height: Library.tree-content-height;
            viewport-y: Library.tree-viewport-y;
            asks: Library.tree-scroll-asks;
            shown(w, h) => { Library.tree-shown(w, h); }
            resized(w, h) => { Library.tree-resized(w, h); }
            scrolled(y) => { Library.tree-scrolled(y); }
            empty-clicked => { Library.tree-empty-clicked(); }
            row-clicked(i, command, shift) => { Library.row-clicked(i, command, shift); }
            row-double-clicked(i) => { Library.row-double-clicked(i); }
            row-folded(i) => { Library.row-folded(i); }
            row-menu(i) => { Library.row-menu(i) }
            open-menu(x, y) => { root.open-menu(x, y); }
            rename-committed(i, t) => { Library.row-rename-committed(i, t); }
            rename-cancelled => { Library.row-rename-cancelled(); }
            rename-edited(t) => { Library.row-rename-edited(t); }
            pin-clicked(command, shift) => { Library.tree-pin-clicked(command, shift); }
        }
        // No project yet: said where the first would stand, on the rows' inset.
        if Library.surface == 1 && Library.projects-empty != "": HorizontalLayout {
            padding-left: ShellStyle.column-inset;
            padding-right: ShellStyle.column-inset;
            RowsEmpty {
                title: Library.projects-empty;
                detail: @tr("Select photos in the Archive, then choose New Project.");
            }
        }
        // `TreeDrop` on the projects: Rust resolves where a drag of rows would land.
        if Library.surface == 1: RowTree {
            vertical-stretch: 1;
            projects: true;
            draggable: true;
            rows: Library.project-near-rows;
            pin: Library.project-pin;
            content-height: Library.project-content-height;
            viewport-y: Library.project-viewport-y;
            asks: Library.project-scroll-asks;
            shown(w, h) => { Library.project-shown(w, h); }
            resized(w, h) => { Library.project-resized(w, h); }
            scrolled(y) => { Library.project-scrolled(y); }
            empty-clicked => { Library.project-empty-clicked(); }
            row-clicked(i, command, shift) => { Library.project-row-clicked(i, command, shift); }
            row-double-clicked(i) => { Library.project-row-double-clicked(i); }
            row-folded(i) => { Library.project-row-folded(i); }
            row-menu(i) => { Library.project-row-menu(i) }
            open-menu(x, y) => { root.open-menu(x, y); }
            row-dragged(i, px, py, x, y) => { Library.project-row-dragged(i, px, py, x, y); }
            drag-ended(dropped) => { Library.project-drag-ended(dropped); }
            rename-committed(i, t) => { Library.project-row-rename-committed(i, t); }
            rename-cancelled => { Library.project-row-rename-cancelled(); }
            rename-edited(t) => { Library.row-rename-edited(t); }
            pin-clicked(command, shift) => { Library.project-pin-clicked(command, shift); }
            // `TreeRowChrome.dropRing` round the row joined, or the line before the row landed before.
            if Library.project-drag.ring: SelectionRing {
                radius: Radius.badge;
                x: Library.project-drag.mark-x;
                y: Library.project-drag.mark-y;
                width: Library.project-drag.mark-width;
                height: Library.project-drag.mark-height;
            }
            if Library.project-drag.line: DropLine {
                x: Library.project-drag.mark-x;
                y: Library.project-drag.mark-y;
                width: Library.project-drag.mark-width;
                height: Library.project-drag.mark-height;
            }
            // `TreeRowChrome.dragChip`: how many rows the drag carries, under the pointer.
            if Library.project-drag.shown: Badge {
                x: Library.project-drag.x - self.width / 2;
                y: Library.project-drag.y - self.height / 2;
                text: Library.project-drag.chip;
            }
        }
    }
    // The menu at a point in window coordinates.
    function open-menu(x: length, y: length) {
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        menu.show();
    }
    menu := Menu {
        anchor-x: root.menu-x;
        y: root.menu-y;
        window-x: root.absolute-position.x + root.menu-x;
        window-y: root.absolute-position.y + root.menu-y;
        lines: Library.menu-lines;
        sub-lines: Library.menu-sub-lines;
        chosen(i) => { if (!Library.menu-chosen(i)) { menu.close(); } }
        opened(i) => { Library.menu-opened(i); }
        sub-chosen(i) => { if (!Library.menu-sub-chosen(i)) { menu.close(); } }
    }
}
