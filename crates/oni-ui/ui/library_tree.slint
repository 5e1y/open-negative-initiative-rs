// The library column: the navigator over the opened folder's tree, or the projects' tree.
import { NavigatorSection, Navigator } from "navigator.slint";
import { ColumnPill, ListView, Scroller, IconButton, Icons, TreeItem, RenameRow, RowKind, TileView, Surface, Space, Tabs, EmptyState, ContextMenu } from "ds/ds.slint";
import { Library } from "library.slint";

// `librarySidebar`: in the gallery the navigator takes the archive's column; beside a photo the
// navigator keeps its height over the opened folder's tree with its photos.
export component Tree inherits Surface {
    in property <bool> beside-photo;
    property <length> menu-x;
    property <length> menu-y;
    VerticalLayout {
        padding: Space.s;
        spacing: Space.s;
        Tabs {
            tabs: ["Archive", "Projects"];
            selected <=> Library.surface;
            picked(i) => { Library.surface-picked(i); }
        }
        if Library.surface == 0: NavigatorSection {
            vertical-stretch: root.beside-photo ? 0 : 1;
            beside-photo: root.beside-photo;
            trash-rows: Library.trash-rows;
            trash-clicked(i) => { Library.trash-row-clicked(i); }
            trash-double-clicked(i) => { Library.trash-row-double-clicked(i); }
            trash-restore(i) => { Library.trash-row-restore(i); }
            trash-menu(i, x, y) => {
                root.menu-x = x - root.absolute-position.x;
                root.menu-y = y - root.absolute-position.y;
                if (Library.trash-row-menu(i)) { menu.show(); }
            }
        }
        if Library.surface == 0 && root.beside-photo: ColumnPill {
            text: Navigator.opened-title;
            help: Navigator.opened-help;
        }
        // `SidebarKeys`: read the folders again, show the selected photo, the next layout.
        if Library.surface == 0 && root.beside-photo: HorizontalLayout {
            alignment: end;
            spacing: Space.xs;
            IconButton { icon: Icons.reset; help: "Read the folders again"; clicked => { Library.tree-reload(); } }
            IconButton { icon: Icons.target; help: "Show the selected photo"; clicked => { Library.tree-centre(); } }
            IconButton {
                icon: Library.tree-layout == 0 ? Icons.list : Library.tree-layout == 1 ? Icons.gallery : Icons.single;
                help: Library.tree-layout-help;
                clicked => { Library.tree-layout-next(); }
            }
        }
        // `TreeEngine`: Rust lays every row, a photo as a name or a thumbnail, and scrolls to the selection.
        if Library.surface == 0 && root.beside-photo: Scroller {
            vertical-stretch: 1;
            content-height: Library.tree-content-height;
            content-y <=> Library.tree-viewport-y;
            init => { Library.tree-resized(self.width, self.height); }
            changed width => { Library.tree-resized(self.width, self.height); }
            changed height => { Library.tree-resized(self.width, self.height); }
            for row[i] in Library.rows: Rectangle {
                x: row.x;
                y: row.y;
                width: row.width;
                height: row.height;
                if !row.thumb && !row.renaming: TreeItem {
                    width: parent.width;
                    depth: row.depth;
                    title: row.title;
                    caption: row.caption;
                    kind: row.kind == 0 ? RowKind.folder : row.kind == 1 ? RowKind.roll : RowKind.photo;
                    expandable: row.expandable;
                    expanded: row.expanded;
                    selected: row.selected;
                    clicked => { Library.row-clicked(i); }
                    double-clicked => { Library.row-double-clicked(i); }
                }
                if row.thumb: TileView {
                    width: parent.width;
                    picture-height: parent.width * 2 / 3;
                    picture: row.picture;
                    caption: row.title;
                    selected: row.selected;
                    medal: row.medal;
                    missing: row.missing;
                }
                if row.thumb: TouchArea {
                    clicked => { Library.row-clicked(i); }
                    double-clicked => { Library.row-double-clicked(i); }
                }
                if row.renaming: RenameRow {
                    width: parent.width;
                    text: row.title;
                    depth: row.depth;
                    committed(t) => { Library.row-rename-committed(i, t); }
                    cancelled => { Library.row-rename-cancelled(); }
                }
            }
        }
        if Library.surface == 1: ListView {
            vertical-stretch: 1;
            for row[i] in Library.project-rows: TreeItem {
                depth: row.depth;
                title: row.title;
                caption: row.caption;
                kind: row.kind == 1 ? RowKind.roll : RowKind.photo;
                expandable: row.expandable;
                expanded: row.expanded;
                selected: row.selected;
                clicked => { Library.project-row-clicked(i); }
                double-clicked => { Library.project-row-double-clicked(i); }
                menu(x, y) => {
                    root.menu-x = self.absolute-position.x - root.absolute-position.x + x;
                    root.menu-y = self.absolute-position.y - root.absolute-position.y + y;
                    if (Library.project-row-menu(i)) { menu.show(); }
                }
            }
        }
    }
    if Library.surface == 1 && Library.projects-empty != "": EmptyState {
        title: Library.projects-empty;
        detail: "Right-click photos in the library and choose New Project from them.";
    }
    menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        lines: Library.menu-lines;
        chosen(i) => { if (!Library.menu-chosen(i)) { menu.close(); } }
    }
}
