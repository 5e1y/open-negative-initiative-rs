// The library column: the navigator over the opened folder's tree, or the projects' tree.
import { NavigatorSection, Navigator } from "navigator.slint";
import { ColumnPill, Scroller, Icons, TreeItem, RenameRow, RowKind, TileView, Surface, Space, CardStyle, Tabs, EmptyState, ContextMenu, PinnedTreeRow, Button, ButtonSize, ButtonGroup } from "ds/ds.slint";
import { Library } from "library.slint";
import { ProjectTree } from "project_tree.slint";

// `librarySidebar`: in the gallery the navigator takes the archive's column; beside a photo the
// navigator keeps its height over the opened folder's tree with its photos.
export component Tree inherits Surface {
    in property <bool> beside-photo;
    property <length> menu-x;
    property <length> menu-y;
    // `sidebarLayout` follows the mode: the projects' tree is laid again by the other one.
    changed beside-photo => { Library.tree-moded(); }
    // Each part pads itself, as Swift's column does: the tab bar, the navigator's header, the tree.
    VerticalLayout {
        HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Space.s;
            padding-bottom: Space.s;
            Tabs {
                tabs: [@tr("Archive"), @tr("Projects")];
                selected <=> Library.surface;
                picked(i) => { Library.surface-picked(i); }
            }
        }
        if Library.surface == 0: NavigatorSection {
            vertical-stretch: root.beside-photo ? 0 : 1;
            beside-photo: root.beside-photo;
            trash-rows: Library.trash-rows;
            trash-clicked(i) => { Library.trash-row-clicked(i); }
            trash-double-clicked(i) => { Library.trash-row-double-clicked(i); }
            trash-restore(i) => { Library.trash-row-restore(i); }
            trash-menu(i, x, y) => {
                root.menu-x = x - root.absolute-position.x;
                root.menu-y = y - root.absolute-position.y;
                if (Library.trash-row-menu(i)) { menu.show(); }
            }
        }
        // `SidebarKeys` on a mini plate, then the pill naming what the column lists; on the projects
        // in both modes, beside a photo alone on the archive. Under the tab bar its padding stands above.
        if Library.surface == 1 || root.beside-photo: HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Library.surface == 1 ? 0 : Space.s;
            padding-bottom: Space.s;
            spacing: Space.s;
            ButtonGroup { plate: true;
                mini: true;
                Button { size: ButtonSize.mini; has-icon: true; square: true; icon: Icons.target; help: @tr("Show the selected photo"); clicked => { if (Library.surface == 0) { Library.tree-centre(); } else { Library.project-centre(); } } }
                if Library.surface == 1: Button { size: ButtonSize.mini; has-icon: true; square: true;
                    icon: Library.projects-any-open ? Icons.collapse-all : Icons.expand-all;
                    help: Library.projects-any-open ? @tr("Fold every folder") : @tr("Open every folder");
                    clicked => { Library.project-fold-all(); }
                }
                Button { size: ButtonSize.mini; has-icon: true; square: true;
                    icon: Library.tree-layout == 0 ? Icons.list : Library.tree-layout == 1 ? Icons.gallery : Icons.single;
                    help: Library.tree-layout-help;
                    clicked => { Library.tree-layout-next(); }
                }
            }
            ColumnPill {
                horizontal-stretch: 1;
                text: Library.surface == 1 ? @tr("ONI Projects") : Navigator.opened-title;
                help: Library.surface == 1 ? "" : Navigator.opened-help;
            }
        }
        // `TreeEngine`: Rust lays every row, a photo as a name or a thumbnail, and scrolls to the selection.
        if Library.surface == 0 && root.beside-photo: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: CardStyle.inset;
            padding-right: CardStyle.inset;
            Rectangle {
                clip: true;
                Scroller {
                    content-height: Library.tree-content-height;
                    content-y <=> Library.tree-viewport-y;
                    init => { Library.tree-shown(self.width, self.height); }
                    changed width => { Library.tree-resized(self.width, self.height); }
                    changed height => { Library.tree-resized(self.width, self.height); }
                    changed content-y => { Library.tree-scrolled(); }
                    // `clickEmpty`: the content under no row, its gaps included, drops the picks and the ring.
                    TouchArea {
                        width: parent.width;
                        height: Library.tree-content-height;
                        clicked => { Library.tree-empty-clicked(); }
                    }
                    for row[i] in Library.rows: Rectangle {
                        x: row.x;
                        y: row.y;
                        width: row.width;
                        height: row.height;
                        if !row.thumb && !row.renaming: TreeItem {
                            width: parent.width;
                            depth: row.depth;
                            title: row.title;
                            caption: row.caption;
                            kind: row.kind == 0 ? RowKind.folder : row.kind == 1 ? RowKind.roll : RowKind.photo;
                            stock: row.stock;
                            has-stock: row.has-stock;
                            expandable: row.expandable;
                            expanded: row.expanded;
                            selected: row.selected;
                            clicked => { Library.row-clicked(i, self.command, self.shift); }
                            double-clicked => { Library.row-double-clicked(i); }
                            folded => { Library.row-folded(i); }
                            menu(x, y) => {
                                if (Library.row-menu(i)) { root.open-menu(self.absolute-position.x + x, self.absolute-position.y + y); }
                            }
                        }
                        if row.thumb: TileView {
                            width: parent.width;
                            picture-height: parent.width * 2 / 3;
                            picture: row.picture;
                            caption: row.title;
                            selected: row.selected;
                            medal: row.medal;
                            missing: row.missing;
                            rgb: row.rgb;
                        }
                        if row.thumb: TouchArea {
                            property <bool> command;
                            property <bool> shift;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    self.command = event.modifiers.control || event.modifiers.meta;
                                    self.shift = event.modifiers.shift;
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && Library.row-menu(i)) {
                                    root.open-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                            clicked => { Library.row-clicked(i, self.command, self.shift); }
                            double-clicked => { Library.row-double-clicked(i); }
                        }
                        if row.renaming: RenameRow {
                            width: parent.width;
                            text: row.title;
                            depth: row.depth;
                            committed(t) => { Library.row-rename-committed(i, t); }
                            cancelled => { Library.row-rename-cancelled(); }
                            edited(t) => { Library.row-rename-edited(t); }
                        }
                    }
                }
                if Library.tree-pin.shown: PinnedTreeRow {
                    y: Library.tree-pin.push;
                    width: parent.width;
                    depth: Library.tree-pin.row.depth;
                    title: Library.tree-pin.row.title;
                    caption: Library.tree-pin.row.caption;
                    kind: Library.tree-pin.row.kind == 1 ? RowKind.roll : RowKind.folder;
                    selected: Library.tree-pin.row.selected;
                    clicked(command, shift) => { Library.tree-pin-clicked(command, shift); }
                    double-clicked => { Library.row-double-clicked(Library.tree-pin.index); }
                    folded => { Library.row-folded(Library.tree-pin.index); }
                }
            }
        }
        if Library.surface == 1: ProjectTree {
            vertical-stretch: 1;
            open-menu(x, y) => { root.open-menu(x, y); }
        }
    }
    if Library.surface == 1 && Library.projects-empty != "": EmptyState {
        title: Library.projects-empty;
        detail: @tr("Right-click photos in the library and choose New Project from them.");
    }
    // The menu at a point in window coordinates.
    function open-menu(x: length, y: length) {
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        menu.show();
    }
    menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        lines: Library.menu-lines;
        chosen(i) => { if (!Library.menu-chosen(i)) { menu.close(); } }
    }
}
