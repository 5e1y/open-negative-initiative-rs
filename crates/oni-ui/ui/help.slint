// The Help menu's surfaces: the welcome sheet, Report a Bug, and the console window.
import { Space, HelpStyle, SheetStyle, Label, TextRole, Tone, Button, ButtonKind, Toggle, Sheet, Divider, Scroller, LogText, AppWindow, Badge, Surface, WelcomePhoto, ButtonGroup, TextField } from "ds/ds.slint";
import { KeyWords } from "key_words.slint";

// `WhatsNew.notes`: each heading's word while its note is news, then the note; Rust marks a read one.
export global News {
    in property <string> machine;
    in property <string> machine-note;
    in property <string> keypad;
    in property <string> keypad-note;
    in property <string> effects-scanner;
    in property <string> effects-scanner-note;
    in property <string> curves-scanner;
    in property <string> curves-scanner-note;
    in property <string> lighting;
    in property <string> lighting-note;
    in property <string> space;
    in property <string> space-note;
    callback read(string);
}

export global Help {
    // `WelcomeSheet`; the release its edition belongs to, which the menu and the heading both name.
    in property <bool> welcome-shown;
    in property <string> release;
    in property <int> welcome-picture;
    in property <string> welcome-line;
    in property <string> welcome-credit;
    callback welcome-closed();
    callback website();
    callback feedback();
    // `ReportSheet`
    in property <bool> report-shown;
    in-out property <string> report-message;
    in-out property <bool> report-log: true;
    in property <bool> report-sending;
    in property <bool> report-sent;
    in property <string> report-failure;
    callback report-edited(string);
    callback report-send();
    callback report-closed();
    callback community();
}

component Point inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: Space.xs;
    Label { text: root.title; role: TextRole.section; }
    Label { text: root.text; tone: Tone.secondary; wrap: word-wrap; }
}

// `WelcomeSheet`: the version's photo edge to edge, then what changed, and GET STARTED; one column
// that scrolls once the window is shorter than it. Modal: only its keys close it.
export component WelcomeSheet inherits Sheet {
    wide: true;
    bleed: true;
    dismissed => { Help.welcome-closed(); }
    WelcomePhoto {
        picture: Help.welcome-picture;
        line: Help.welcome-line;
        credit: Help.welcome-credit;
    }
    VerticalLayout {
        padding: Space.l;
        spacing: Space.l;
        VerticalLayout {
            spacing: Space.s;
            Label { text: @tr("ONI {}, the slide film and contact sheet update", Help.release); role: TextRole.heading; wrap: word-wrap; }
            Label { text: @tr("Contact sheets, slides, and the whole roll at a glance."); tone: Tone.secondary; wrap: word-wrap; }
        }
        Point { title: @tr("The whole roll, once measured"); text: @tr("After Prepare the Roll, every frame shows together, numbered by its place on the film."); }
        Point { title: @tr("Contact sheets"); text: @tr("Select a few frames, or press the orange key for the whole roll: they lie together on one sheet."); }
        Point { title: @tr("Export a contact sheet"); text: @tr("The export panel exports the selection as one sheet, with a preview; the orange EXP. CONTACT SHEET key opens it."); }
        Point { title: @tr("Slide films"); text: @tr("Prepare the Roll balances a slide roll with one set of gains for every slide, its blacks and whites left as they are."); }
        Point { title: @tr("Slides on white"); text: @tr("A contact sheet of slides lies on white, numbered in red under a black logo."); }
        Point { title: @tr("The whole scan in Prepare"); text: @tr("Prepare the Roll shows and measures every scan uncropped."); }
        Point { title: @tr("RESET SCAN keeps your crop"); text: @tr("Everything goes back to rest but the framing and the conversion."); }
        Point { title: @tr("Trash from the editor"); text: @tr("The next frame of the roll opens in its place."); }
        Point { title: @tr("{} beside a photo", KeyWords.command + "A"); text: @tr("The folder's photos show together; a click on one shows it alone again."); }
        Point { title: @tr("No more flicker on Windows"); text: @tr("Clicking outside the window and back no longer blanks it for an instant."); }
        HorizontalLayout {
            spacing: Space.s;
            Button { text: @tr("Website"); clicked => { Help.website(); } }
            Button { text: @tr("Feedback"); help: @tr("Report a Bug / Give Feedback"); clicked => { Help.feedback(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("GET STARTED"); kind: ButtonKind.accent; clicked => { Help.welcome-closed(); } }
        }
    }
}

// `ReportSheet`: the message, the sealed log's switch, and Send; then a thank-you.
export component ReportSheet inherits Sheet {
    title: Help.report-sent ? @tr("Thank You") : @tr("Report a Bug or Give Feedback");
    card-width: SheetStyle.notice-width;
    dismissed => { Help.report-closed(); }
    if Help.report-sent: Label { role: TextRole.note; text: @tr("Your message is on its way to the people who make ONI. It shows with the others on GitHub, where you can follow it."); }
    if !Help.report-sent: Label { role: TextRole.note; text: @tr("Your message and the app's version become a public issue on GitHub, so leave out anything personal. The log is encrypted on this Mac before it leaves."); }
    // Both ways: typing reaches Send's gate, and Rust's cut at the site's limit reaches the field.
    if !Help.report-sent: message := TextField { multiline: true;
        text <=> Help.report-message;
        edited(t) => { Help.report-edited(t); }
        init => { self.take-focus(); }
    }
    if !Help.report-sent: Toggle {
        label: @tr("Encrypted console log, readable by ONI's maintainers only");
        wrap: true;
        on: Help.report-log;
        toggled(on) => { Help.report-log = on; }
    }
    if !Help.report-sent && Help.report-failure != "": Label { role: TextRole.note; tone: Tone.warning; text: Help.report-failure; }
    HorizontalLayout {
        spacing: Space.s;
        Button { text: @tr("See Community Feedbacks"); clicked => { Help.community(); } }
        Rectangle { horizontal-stretch: 1; }
        if Help.report-sent: Button { text: @tr("Done"); clicked => { Help.report-closed(); } }
        if !Help.report-sent: ButtonGroup { plate: true;
            Button { text: @tr("Cancel"); clicked => { Help.report-closed(); } }
            Button {
                text: Help.report-sending ? @tr("Sending…") : @tr("Send");
                kind: ButtonKind.confirm;
                enabled: !Help.report-sending && Help.report-message != "";
                clicked => { Help.report-send(); }
            }
        }
    }
}

// `ConsoleView`: the diagnostics log, polled; Copy and Reveal Log in Finder.
export component ConsoleWindow inherits AppWindow {
    title: @tr("Console");
    in property <string> log;
    in property <int> blocks;
    // Reveal Log in Finder, or in Explorer on Windows, as Rust words it.
    in property <string> reveal-word;
    callback copy();
    callback reveal();
    preferred-width: HelpStyle.console-width;
    preferred-height: HelpStyle.console-height;
    Surface {
        VerticalLayout {
            padding: Space.m;
            spacing: Space.s;
            HorizontalLayout {
                spacing: Space.s;
                Badge { text: root.blocks == 0 ? @tr("No block recorded") : root.blocks == 1 ? @tr("1 block recorded") : @tr("{} blocks recorded", root.blocks); }
                Rectangle { horizontal-stretch: 1; }
                // AppKit's own keys in Swift's console, their words as written.
                Button { text: @tr("Copy"); capitals: false; clicked => { root.copy(); } }
                Button { text: root.reveal-word; capitals: false; clicked => { root.reveal(); } }
            }
            Scroller {
                vertical-stretch: 1;
                content-height: view.preferred-height;
                view := LogText { width: parent.width; text: root.log == "" ? @tr("Nothing recorded yet.") : root.log; }
            }
            Label { role: TextRole.note; text: @tr("Keep this open, reproduce the fault, then Copy. If the app has to be forced to quit, the file above still holds everything."); }
        }
    }
}
