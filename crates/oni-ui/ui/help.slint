// The Help menu's surfaces: the welcome sheet, Report a Bug, and the console window.
import { Space, HelpStyle, SheetStyle, Label, TextRole, Tone, Button, ButtonKind, Toggle, Sheet, Divider, Scroller, LogText, AppWindow, Badge, Surface, WelcomePhoto, ButtonGroup, TextField, SheetFooter } from "ds/ds.slint";
import { BulletLine, WelcomeStyle, PageDots, StageDots, SceneFrame, Picture, Fit, Ground, ClarityScene, FavouritesScene, FocusScene, EditScene, DustScene, FixesScene } from "ds/ds.slint";
import { KeyWords } from "key_words.slint";

// `WhatsNew.notes`: each heading's word while its note is news, then the note; Rust marks a read one.
export global News {
    in property <string> machine;
    in property <string> machine-note;
    in property <string> keypad;
    in property <string> keypad-note;
    in property <string> effects-scanner;
    in property <string> effects-scanner-note;
    in property <string> curves-scanner;
    in property <string> curves-scanner-note;
    in property <string> lighting;
    in property <string> lighting-note;
    in property <string> space;
    in property <string> space-note;
    callback read(string);
}

export global Help {
    // `WelcomeSheet`; the release its edition belongs to, which the menu and the heading both name.
    in property <bool> welcome-shown;
    in property <string> release;
    in property <int> welcome-picture;
    in property <string> welcome-line;
    in property <string> welcome-credit;
    // The page shown, the first as the sheet opens.
    in-out property <int> welcome-page;
    callback welcome-closed();
    callback website();
    callback feedback();
    // `ReportSheet`
    in property <bool> report-shown;
    in-out property <string> report-message;
    in-out property <bool> report-log: true;
    in property <bool> report-sending;
    in property <bool> report-sent;
    in property <string> report-failure;
    callback report-edited(string);
    callback report-send();
    callback report-closed();
    callback community();
}

component Point inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: Space.xs;
    Label { text: root.title; role: TextRole.section; wrap: word-wrap; }
    Label { text: root.text; role: TextRole.note; wrap: word-wrap; }
}

// A column's title on the last page, over what it gathers.
component Eyebrow inherits Label {
    role: TextRole.caption;
    tone: Tone.secondary;
}

// `WelcomeSheet`: the release told in pages, the photo or a film on the stage beside the words; BACK and
// NEXT or the arrows turn them, the dots jump, GET STARTED on the last. Modal: only its keys close it.
export component WelcomeSheet inherits Sheet {
    card-width: WelcomeStyle.card-width;
    card-height: WelcomeStyle.card-height;
    bleed: true;
    paging: true;
    property <int> count: 7;
    property <int> page: Help.welcome-page;
    property <bool> last: root.page == root.count - 1;
    // Every page's words take the whole card on a card too narrow for a stage.
    property <bool> staged: root.shown-width - WelcomeStyle.words-width >= WelcomeStyle.stage-least;
    function turn(by: int) { Help.welcome-page = max(0, min(root.count - 1, root.page + by)); }
    dismissed => { Help.welcome-closed(); }
    returned => {
        if (root.last) { Help.welcome-closed(); } else { root.turn(1); }
    }
    paged(by) => { root.turn(by); }
    HorizontalLayout {
        vertical-stretch: 1;
        if root.staged: SceneFrame {
            horizontal-stretch: 1;
            if root.page == 0: WelcomePhoto {
                width: parent.width;
                height: parent.height;
                picture: Help.welcome-picture;
                line: Help.welcome-line;
                credit: Help.welcome-credit;
            }
            if root.page == 1: ClarityScene {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 2: FavouritesScene {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 3: FocusScene {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 4: EditScene {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 5: DustScene {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 6: FixesScene {
                width: parent.width;
                height: parent.height;
            }
            StageDots {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Space.m;
                count: root.count;
                at: root.page;
                picked(page) => { Help.welcome-page = page; }
            }
        }
        VerticalLayout {
            width: root.staged ? WelcomeStyle.words-width : root.shown-width;
            padding: Space.l;
            spacing: Space.m;
            // Each page's words in a scroller of its own: a layout made by `if` inside the scroller's layout
            // measures wrapped lines unwrapped, so the scroller would never reach the foot of a long page.
            if root.page == 0: Scroller {
                vertical-stretch: 1;
                content-height: page0.preferred-height;
                page0 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("ONI {}, the calm and clean update", Help.release); role: TextRole.heading; wrap: word-wrap; }
                    Label { text: @tr("A quieter interface around your scans, dust found on its own, and about 70 fixes."); role: TextRole.note; wrap: word-wrap; }
                    BulletLine { text: @tr("A calmer interface"); }
                    BulletLine { text: @tr("Automatic De-dust"); }
                    BulletLine { text: @tr("About 70 fixes, and what changes"); }
                }
            }
            if root.page == 1: Scroller {
                vertical-stretch: 1;
                content-height: page1.preferred-height;
                page1 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("A clearer interface"); role: TextRole.heading; wrap: word-wrap; }
                    Point {
                        title: @tr("Every key says what it does");
                        text: @tr("The bar's keys show their name under their glyph, in the same place in every mode.");
                    }
                    Point {
                        title: @tr("You see which tool is at work");
                        text: @tr("A tool's key wears a coloured tab, and the canvas a frame of the same colour, for as long as the tool is on.");
                    }
                    Point {
                        title: @tr("Nothing to guess");
                        text: @tr("A glyph alone no longer stands for a tool: its word is always beside it.");
                    }
                }
            }
            if root.page == 2: Scroller {
                vertical-stretch: 1;
                content-height: page2.preferred-height;
                page2 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("Your favourites at hand"); role: TextRole.heading; wrap: word-wrap; }
                    Point {
                        title: @tr("Favourites first, then your computer");
                        text: @tr("The column opens on two sections: the folders you starred, then every folder of your computer.");
                    }
                    Point {
                        title: @tr("A star on every folder");
                        text: @tr("Hover a folder or a roll and click its star: it joins the favourites at once. Click again to take it out.");
                    }
                    Point {
                        title: @tr("Nothing to switch");
                        text: @tr("No more filter key to show the favourites: they are always there, above the rest.");
                    }
                }
            }
            if root.page == 3: Scroller {
                vertical-stretch: 1;
                content-height: page3.preferred-height;
                page3 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("Less distraction, your scans first"); role: TextRole.heading; wrap: word-wrap; }
                    Point {
                        title: @tr("Quiet until you reach for it");
                        text: @tr("The rails of hues stay faint while you look at the photo, and show their colours as soon as your hand comes onto their block.");
                    }
                    Point {
                        title: @tr("Lighter controls");
                        text: @tr("Thinner rails and smaller knobs leave the colour to your photograph.");
                    }
                    Point {
                        title: @tr("Clearer blocks");
                        text: @tr("Each block opens on its name; its reset shows only once something moved.");
                    }
                }
            }
            if root.page == 4: Scroller {
                vertical-stretch: 1;
                content-height: page4.preferred-height;
                page4 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("Type the exact value"); role: TextRole.heading; wrap: word-wrap; }
                    Point {
                        title: @tr("The value opens under your hand");
                        text: @tr("Hover a slider's value: it becomes a small field, its figure between − and +.");
                    }
                    Point {
                        title: @tr("Click, type, Return");
                        text: @tr("Click the figure to type the value you want; Return sets it and the knob lands on it. Escape leaves it as it was.");
                    }
                    Point {
                        title: @tr("Or step by step");
                        text: @tr("− and + move it by one shown unit, as the arrow keys do.");
                    }
                }
            }
            if root.page == 5: Scroller {
                vertical-stretch: 1;
                content-height: page5.preferred-height;
                page5 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("Automatic De-dust"); role: TextRole.heading; wrap: word-wrap; }
                    Point {
                        title: @tr("Found in one press");
                        text: @tr("In De-dust, DETECT rings every speck it finds, from a single pixel to a large flake.");
                    }
                    Point {
                        title: @tr("Healed when you say so");
                        text: @tr("REMOVE lays a patch on each ring. Each patch is a numbered tile you can check and remove.");
                    }
                    Point {
                        title: @tr("Look before you remove");
                        text: @tr("A speck across a sharp edge can be missed, and a high Sensitivity can ring fine detail.");
                    }
                }
            }
            if root.page == 6: Scroller {
                vertical-stretch: 1;
                content-height: page6.preferred-height;
                page6 := VerticalLayout {
                    width: parent.width;
                    spacing: Space.m;
                    Label { text: @tr("About 70 fixes, and what changes"); role: TextRole.heading; wrap: word-wrap; }
                    VerticalLayout {
                        spacing: Space.s;
                        BulletLine { text: @tr("Your edits hold, across a roll and through Undo"); }
                        BulletLine { text: @tr("Dust patches stay put, in every export"); }
                        BulletLine { text: @tr("Exports come out as you set them"); }
                        BulletLine { text: @tr("Steadier with slow and network disks"); }
                    }
                    Eyebrow { text: @tr("Good to know"); }
                    Point {
                        title: @tr("Medals on 1, 2 and 3");
                        text: @tr("Keys 1, 2 and 3 now give gold, silver and bronze.");
                    }
                    Point {
                        title: @tr("The Scanner face shows its keypad");
                        text: @tr("No more Auto White Balance under it: it shows what its keypad reads.");
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Space.s;
                        Button { text: @tr("Website"); clicked => { Help.website(); } }
                        Button { text: @tr("Feedback"); help: @tr("Report a Bug / Give Feedback"); clicked => { Help.feedback(); } }
                    }
                }
            }
            SheetFooter {
                back: root.page > 0 ? @tr("Back") : "";
                commit: root.last ? @tr("GET STARTED") : @tr("Next");
                backed => { root.turn(-1); }
                committed => {
                    if (root.last) { Help.welcome-closed(); } else { root.turn(1); }
                }
                if !root.staged: PageDots { count: root.count; at: root.page; picked(page) => { Help.welcome-page = page; } }
            }
        }
    }
}


// `ReportSheet`: the message, the sealed log's switch, and Send; then a thank-you.
export component ReportSheet inherits Sheet {
    title: Help.report-sent ? @tr("Thank You") : @tr("Report a Bug or Give Feedback");
    card-width: SheetStyle.notice-width;
    dismissed => { Help.report-closed(); }
    if Help.report-sent: Label { role: TextRole.note; text: @tr("Your message is on its way to the people who make ONI. It shows with the others on GitHub, where you can follow it."); }
    if !Help.report-sent: Label { role: TextRole.note; text: @tr("Your message and the app's version become a public issue on GitHub, so leave out anything personal. The log is encrypted on this computer before it leaves."); }
    // Both ways: typing reaches Send's gate, and Rust's cut at the site's limit reaches the field.
    if !Help.report-sent: message := TextField { multiline: true;
        name: @tr("Report a Bug or Give Feedback");
        text <=> Help.report-message;
        edited(t) => { Help.report-edited(t); }
        init => { self.take-focus(); }
    }
    if !Help.report-sent: Toggle {
        label: @tr("Encrypted diagnostic log, readable by ONI's maintainers only");
        wrap: true;
        on: Help.report-log;
        toggled(on) => { Help.report-log = on; }
    }
    if !Help.report-sent && Help.report-failure != "": Label { role: TextRole.note; tone: Tone.warning; text: Help.report-failure; }
    SheetFooter {
        cancel: Help.report-sent ? "" : @tr("Cancel");
        commit: Help.report-sent ? @tr("Done") : Help.report-sending ? @tr("Sending…") : @tr("Send");
        commit-enabled: Help.report-sent || (!Help.report-sending && Help.report-message != "");
        cancelled => { Help.report-closed(); }
        committed => {
            if (Help.report-sent) { Help.report-closed(); } else { Help.report-send(); }
        }
        Button { text: @tr("See Community Feedbacks"); clicked => { Help.community(); } }
    }
}

// `ConsoleView`: the diagnostics log, polled; Copy and Reveal Log in Finder.
export component ConsoleWindow inherits AppWindow {
    title: @tr("Diagnostic Log");
    in property <string> log;
    in property <int> blocks;
    // Reveal Log in Finder, or in Explorer on Windows, as Rust words it.
    in property <string> reveal-word;
    callback copy();
    callback reveal();
    preferred-width: HelpStyle.console-width;
    preferred-height: HelpStyle.console-height;
    Surface {
        VerticalLayout {
            padding: Space.m;
            spacing: Space.s;
            HorizontalLayout {
                spacing: Space.s;
                Badge { text: root.blocks == 0 ? @tr("No block recorded") : root.blocks == 1 ? @tr("1 block recorded") : @tr("{} blocks recorded", root.blocks); }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Copy"); clicked => { root.copy(); } }
                Button { text: root.reveal-word; clicked => { root.reveal(); } }
            }
            Scroller {
                vertical-stretch: 1;
                content-height: view.preferred-height;
                view := LogText { width: parent.width; text: root.log == "" ? @tr("Nothing recorded yet.") : root.log; }
            }
            Label { role: TextRole.note; text: @tr("Keep this open, reproduce the fault, then Copy. If the app has to be forced to quit, the file above still holds everything."); }
        }
    }
}
