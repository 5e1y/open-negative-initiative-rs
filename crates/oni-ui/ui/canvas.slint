// The editor's canvas card: the photo the display kernel wrote, its overlays and the keys in its band.
import { Act } from "act.slint";
import { DS, Card, CardCorners, Picture, Ground, SplitGuide, EdgePrint, FrameOverlay, FrameStyle, CorrectionMark, DustVeil, DustStyle, RingTone, Badge, Button, ButtonGroup, ButtonStyle, GroupAlign, ButtonSize, Label, TextRole, Space, Stroke, CardStyle, Icons, Progress, Tone, BadgeTone, Fit, Ring, Trace, TraceTone, Menu, Tips, StatusStyle } from "ds/ds.slint";
import { PanelState, PanelTab, Lab } from "panel.slint";
import { Library } from "library.slint";
import { PresetDeck } from "preset_deck.slint";
import { SpaceChip } from "export.slint";
import { Absent, AbsentNote } from "missing.slint";
import { KeyWords } from "key_words.slint";
import { Converting } from "dng.slint";
import { CanvasKeys } from "canvas_keys.slint";

import { Canvas, Mark } from "canvas_state.slint";
export { Canvas, Mark }

export component CanvasCard inherits Card {
    in property <bool> library-hidden;
    in property <bool> panel-hidden;
    callback menu(Act);
    callback refocused();
    // A column key pressed: true for the Library's, so the shell drops that column's reveal.
    dimmed: Canvas.cropping;
    // Square against the panel's readout, which runs edge to edge beside it; a column folded squares
    // both corners of its side.
    square-top-right: true;
    square-left: root.library-hidden;
    square-right: root.panel-hidden;
    changed width => { Canvas.width = self.width - 2 * CardStyle.padding; Canvas.resized(); }
    changed height => { Canvas.height = self.height - 2 * CardStyle.padding; Canvas.resized(); }
    // Moved to a screen of another density, the same size in points holds other pixels.
    changed density => { Canvas.resized(); }
    property <length> menu-x;
    property <length> menu-y;
    // A right click on the picture opens the photo's own menu, as its tile and its filmstrip row do.
    function open-menu(x: length, y: length) {
        if (Canvas.menu()) {
            root.menu-x = x;
            root.menu-y = y;
            menu.show();
        }
    }
    Rectangle {
        x: CardStyle.padding;
        y: CardStyle.padding;
        width: parent.width - 2 * CardStyle.padding;
        height: parent.height - 2 * CardStyle.padding;
        clip: true;
        Picture {
            width: parent.width;
            height: parent.height;
            ground: Canvas.cropping ? Ground.canvas-cropping : Ground.canvas;
        }
        if Canvas.together: Picture { x: Canvas.sheet.x; y: Canvas.sheet.y; width: Canvas.sheet.width; height: Canvas.sheet.height; ground: Ground.sheet; }
        if Canvas.together: Picture {
            x: Canvas.logo-box.x;
            y: Canvas.logo-box.y;
            width: Canvas.logo-box.width;
            height: Canvas.logo-box.height;
            ground: Ground.sheet;
            fit: Fit.fill;
            source: Canvas.logo;
        }
        Picture {
            x: Canvas.frame-x;
            y: Canvas.frame-y;
            width: Canvas.frame-width;
            height: Canvas.frame-height;
            ground: Canvas.cropping ? Ground.canvas-cropping : Canvas.together ? Ground.sheet : Ground.canvas;
            fit: Fit.fill;
            source: Canvas.frame;
            revision: Canvas.frame-revision;
            clip-width: Canvas.frame-clip-width;
            clip-height: Canvas.frame-clip-height;
        }
        // Held at the left edge: an element with no place is centred in its parent.
        if Canvas.split >= 0: Rectangle {
            x: 0;
            y: 0;
            width: parent.width * Canvas.split;
            height: parent.height;
            clip: true;
            Picture {
                x: Canvas.before-x;
                y: Canvas.before-y;
                width: Canvas.before-width;
                height: Canvas.before-height;
                ground: Canvas.together ? Ground.sheet : Ground.canvas;
                fit: Fit.fill;
                source: Canvas.before;
                revision: Canvas.before-revision;
            }
        }
        // Over Compare's before too: a frame's number is the same on both sides.
        for n in Canvas.numbers: EdgePrint {
            x: n.x;
            y: n.y;
            height: Canvas.number-band;
            text: n.text;
            size: Canvas.number-size;
            ink: Canvas.inks.number;
        }
        // A pinch zooms about its centre; a drag pans, a double click toggles 100 %.
        ScaleRotateGestureHandler {
            width: parent.width;
            height: parent.height;
            started => { Canvas.pinch-started(); }
            updated => { Canvas.pinched(self.scale, self.center.x, self.center.y); }
            navigation := TouchArea {
                width: parent.width;
                height: parent.height;
                // `NavigationCatcher.updateCursor`: Space held over the canvas shows the hand.
                mouse-cursor: Canvas.space-held ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                clicked => { root.refocused(); }
                double-clicked => { Canvas.double-clicked(); }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        Canvas.grabbed(self.mouse-x, self.mouse-y);
                    }
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        root.open-menu(self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                    }
                }
                moved => { Canvas.dragged(self.mouse-x, self.mouse-y); }
                scroll-event(event) => {
                    Canvas.scrolled(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y, event.modifiers.control) ? EventResult.accept : EventResult.reject
                }
            }
        }
        if Canvas.cropping: FrameOverlay {
            width: parent.width;
            height: parent.height;
            frame-x: Canvas.crop-x;
            frame-y: Canvas.crop-y;
            frame-width: Canvas.crop-width;
            frame-height: Canvas.crop-height;
            grabbed(h) => { Canvas.frame-grabbed(false, h); }
            dragged(h, dx, dy) => { Canvas.frame-dragged(false, h, dx, dy); }
            released => { Canvas.frame-released(false); }
        }
        if Canvas.cropping && Canvas.crop-badge != "": Badge {
            text: Canvas.crop-badge;
            x: Canvas.crop-badge-x - self.width / 2;
            y: Canvas.crop-badge-y - self.height / 2;
        }
        if Canvas.window-shown: FrameOverlay {
            width: parent.width;
            height: parent.height;
            look: FrameStyle.window;
            body-moves: !Canvas.cropping;
            frame-x: Canvas.window-x;
            frame-y: Canvas.window-y;
            frame-width: Canvas.window-width;
            frame-height: Canvas.window-height;
            grabbed(h) => { Canvas.frame-grabbed(true, h); }
            dragged(h, dx, dy) => { Canvas.frame-dragged(true, h, dx, dy); }
            released => { Canvas.frame-released(true); }
        }
        if Canvas.painting: Rectangle {
            width: parent.width;
            height: parent.height;
            if Canvas.dust-shown: DustVeil {
                x: Canvas.picture-x;
                y: Canvas.picture-y;
                width: Canvas.picture-width;
                height: Canvas.picture-height;
                source: Canvas.dust-mask;
                revision: Canvas.dust-revision;
            }
            // The brush's white on a dark halo, seen on any photo; a correction laid keeps its own colour.
            if Canvas.dust-shown: Rectangle {
                width: parent.width;
                height: parent.height;
                for m in Canvas.dust-marks: Ring {
                    centre-x: m.x + m.width / 2;
                    centre-y: m.y + m.height / 2;
                    // A ring the eye finds whatever the speck's size on the canvas.
                    diameter: max(m.width, m.height, DustStyle.ring);
                }
            }
            // A ring where the patch was copied from, the picture left whole under it.
            for m in Canvas.source-marks: Ring {
                tone: RingTone.sharpen;
                centre-x: m.x + m.width / 2;
                centre-y: m.y + m.height / 2;
                diameter: min(m.width, m.height);
            }
            // `DSGuide.width(false)` dashed four on four, the dashes laid by Rust.
            if Canvas.source-lines != "": Trace {
                tone: TraceTone.source;
                dashed: true;
                width: parent.width;
                height: parent.height;
                commands: Canvas.source-lines;
                thickness: Stroke.line;
            }
            for m in Canvas.marks: CorrectionMark {
                x: m.x;
                y: m.y;
                width: m.width;
                height: m.height;
                number: m.number;
            }
            for t in Canvas.pending-strokes: Trace {
                width: parent.width;
                height: parent.height;
                commands: t.commands;
                thickness: t.width;
            }
            if Canvas.stroke != "": Trace {
                width: parent.width;
                height: parent.height;
                commands: Canvas.stroke;
                thickness: Canvas.stroke-width;
            }
            // The disc follows the pointer here, with no trip through Rust, over the picture only.
            if paint.shows-brush: Ring {
                centre-x: paint.mouse-x;
                centre-y: paint.mouse-y;
                diameter: Canvas.brush-diameter;
            }
            paint := TouchArea {
                // `wantsHiddenCursor`: the disc stands for the pointer while it shows, Space aside.
                out property <bool> shows-brush: self.has-hover && !Canvas.space-held
                    && self.mouse-x >= Canvas.picture-x && self.mouse-x <= Canvas.picture-x + Canvas.picture-width
                    && self.mouse-y >= Canvas.picture-y && self.mouse-y <= Canvas.picture-y + Canvas.picture-height;
                // A press with ⌘ pans until its release, as `NavigationCatcher` takes it from the brush.
                property <bool> panning;
                // Space pressed mid-stroke leaves that stroke to its end.
                enabled: !Canvas.space-held || self.pressed;
                mouse-cursor: self.shows-brush ? MouseCursor.none : MouseCursor.default;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        root.open-menu(self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                    }
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.refocused();
                        self.panning = event.modifiers.control;
                        if (self.panning) {
                            Canvas.grabbed(self.mouse-x, self.mouse-y);
                        } else {
                            Canvas.paint-start(self.mouse-x, self.mouse-y);
                        }
                    }
                    if ((event.button == PointerEventButton.left && event.kind == PointerEventKind.up) || event.kind == PointerEventKind.cancel) {
                        if (!self.panning) {
                            Canvas.paint-end();
                        }
                        self.panning = false;
                    }
                }
                moved => {
                    if (self.panning) {
                        Canvas.dragged(self.mouse-x, self.mouse-y);
                    } else {
                        Canvas.paint-move(self.mouse-x, self.mouse-y);
                    }
                }
                scroll-event(event) => {
                    Canvas.scrolled(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y, event.modifiers.control) ? EventResult.accept : EventResult.reject
                }
            }
        }
        if Canvas.split >= 0: SplitGuide {
            x: parent.width * Canvas.split - self.width / 2;
            height: parent.height;
            dragged(at) => { Canvas.split-dragged(self.x + at); }
        }
        // `readOnlyBanner`: the frame's settings will not be kept, at the top centre, below Compare's labels.
        if Canvas.read-only: Badge { tone: BadgeTone.warning;
            x: (parent.width - self.width) / 2;
            y: Canvas.split >= 0 ? Space.l + Space.xs : Space.s;
            text: @tr("Read-only: settings will not be saved");
        }
    }
    // A frame decoding with no thumbnail standing in, then one that never decoded.
    if Canvas.busy && Canvas.frame.width == 0 && Canvas.failure == "": Progress {
        fraction: -1;
        width: DS.control-decode-progress-width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if Canvas.failure != "": VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        spacing: Space.s;
        Label { role: TextRole.note; tone: Tone.warning; text: Canvas.failure; wrap: no-wrap; }
        if Canvas.convertible: HorizontalLayout {
            alignment: center;
            Button { text: @tr("Convert to DNG"); clicked => { Converting.offered(); } }
        }
    }
    // Below the read-only badge, so the cached thumbnail stays in view.
    if Absent.title != "": AbsentNote {
        x: (parent.width - self.width) / 2;
        y: Space.l * 4;
        height: self.preferred-height;
    }
    // The deck rises over the picture's bottom edge; Crop's handles use that edge.
    // On the canvas's own bottom edge, full width, as Swift's overlay on `NegativeView`.
    if PanelState.tab != PanelTab.crop && !Lab.shown: PresetDeck { x: 0; width: parent.width; y: parent.height - self.height; }
    // The Working Space in the room between the column keys, on the card's centre while that room allows.
    SpaceChip {
        property <length> start: library-key.x + library-key.width + Space.s;
        property <length> end: zoom.x - Space.s;
        y: (CardStyle.padding - self.height) / 2;
        width: min(self.preferred-width, self.end - self.start);
        x: max(self.start, min((parent.width - self.width) / 2, self.end - self.width));
    }
    // `columnKey(.leading)`: the Library's key in the canvas's top-left band, on the card's content inset
    // where the deck's tab and the status line start, as the zoom's keys end on it at the right.
    // The column keys as far from the card's side as from its top, beside the column each folds.
    property <length> key-margin: (CardStyle.padding - ButtonStyle.small-height) / 2;
    library-key := HorizontalLayout {
        // Centred in the band over the image: a row stretched to it lays its keys at its top.
        x: root.key-margin;
        y: (CardStyle.padding - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        alignment: center;
        Button { has-icon: true; square: true;
            size: ButtonSize.mini;
            icon: Icons.menu-left;
            help: root.library-hidden ? @tr("Show the Library ({})", KeyWords.option-command + "[") : @tr("Hide the Library ({})", KeyWords.option-command + "[");
            clicked => {
                root.menu(Act.hide-library);
            }
        }
    }
    zoom := HorizontalLayout {
        // Its own width: a layout left unsized spans the card and centres its keys off it.
        x: parent.width - self.preferred-width - root.key-margin;
        y: (CardStyle.padding - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: ButtonStyle.apart;
        alignment: center;
        // The zoom's readouts and its two keys, then the Panel's key apart, last in the bubble.
        HorizontalLayout {
            spacing: Space.s;
            if Canvas.hz != "": Label { text: Canvas.hz; role: TextRole.value; }
            // The tag tells a picture enlarged from its preview, whose softness is not the scan's own.
            Rectangle {
                min-width: readout.preferred-width;
                preferred-width: readout.preferred-width;
                readout := Label {
                    width: parent.width;
                    height: parent.height;
                    text: Canvas.enlarged ? @tr("{} · preview", Canvas.zoom-label) : Canvas.zoom-label;
                    role: TextRole.value;
                }
                TouchArea {
                    changed has-hover => { Tips.hover(self.has-hover && Canvas.enlarged, @tr("Enlarged from its preview: the grain and sharpness are not the file’s own"), self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
            ButtonGroup {
                align: GroupAlign.center;
                Button { has-icon: true; square: true; size: ButtonSize.mini; icon: Icons.zoom-out; enabled: Canvas.can-zoom-out; help: @tr("Zoom Out ({})", KeyWords.command + "−"); clicked => { root.menu(Act.smaller); } }
                Button { has-icon: true; square: true; size: ButtonSize.mini; icon: Icons.zoom-in; enabled: Canvas.can-zoom-in; help: @tr("Zoom In ({})", KeyWords.command + "+"); clicked => { root.menu(Act.larger); } }
            }
        }
        Button { has-icon: true; square: true;
            size: ButtonSize.mini;
            icon: Icons.menu-right;
            help: root.panel-hidden ? @tr("Show the Panel ({})", KeyWords.option-command + "]") : @tr("Hide the Panel ({})", KeyWords.option-command + "]");
            clicked => {
                root.menu(Act.hide-panel);
            }
        }
    }
    CardCorners { width: parent.width; height: parent.height; square-top-right: root.square-top-right; square-left: root.square-left; square-right: root.square-right; }
    // The open photo's place in Tab's order, read as the photo: its arrows place the frame drawn on it.
    CanvasKeys {
        label: Canvas.status;
        told: Canvas.window-shown ? @tr("Arrows move the measuring window, {}-arrows its right or bottom edge, {} ten times as far. Return applies it.", KeyWords.option, KeyWords.shift)
            : Canvas.cropping ? @tr("Arrows move the crop, {}-arrows its right or bottom edge, {} ten times as far. Return keeps it.", KeyWords.option, KeyWords.shift) : "";
    }
    menu := Menu {
        anchor-x: root.menu-x;
        y: root.menu-y;
        window-x: root.absolute-position.x + root.menu-x;
        window-y: root.absolute-position.y + root.menu-y;
        lines: Library.menu-lines;
        sub-lines: Library.menu-sub-lines;
        chosen(i) => { if (!Library.menu-chosen(i)) { menu.close(); } }
        opened(i) => { Library.menu-opened(i); }
        sub-chosen(i) => { if (!Library.menu-sub-chosen(i)) { menu.close(); } }
    }
}
