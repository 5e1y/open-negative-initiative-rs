// Every sheet over the window, in the order they stack: a question asked over another sheet, as quitting's,
// is drawn over it, last.
import { PairingSheet, Pairing } from "pairing.slint";
import { AppSettings, SettingsSheet } from "settings.slint";
import { Notice, NoticeSheet, Upgraded, UpgradedSheet } from "notice.slint";
import { Navigator, RootsCatchUpSheet } from "navigator.slint";
import { Stocks, StockPickerSheet } from "stocks.slint";
import { Help, WelcomeSheet, ReportSheet } from "help.slint";
import { Wrapped, WrappedView } from "wrapped.slint";
import { MaskDialog, MaskDialogSheet } from "masks.slint";
import { Presets, Advice, AdviceSheet, Choice, ChoiceSheet, PresetSaveSheet, PresetEditorSheet } from "presets.slint";
import { Exporting, ExportConfirmSheet, ExportNoticeSheet, PresetNameSheet } from "export.slint";
import { PaperSheet } from "export_papers.slint";
import { Confirm, ConfirmSheet } from "confirm.slint";
import { Unsaved, UnsavedSheet } from "missing.slint";
import { Converting, DngSheet } from "dng.slint";
import { Kit } from "gear_state.slint";
import { KitSearchSheet } from "kit.slint";

export component Sheets inherits Rectangle {
    if Presets.saving: PresetSaveSheet { shown: Presets.saving; x: 0; y: 0; width: root.width; height: root.height; }
    if Presets.editing: PresetEditorSheet { shown: Presets.editing; x: 0; y: 0; width: root.width; height: root.height; }
    if Pairing.shown: PairingSheet { shown: Pairing.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if AppSettings.shown: SettingsSheet { shown: AppSettings.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Notice.shown: NoticeSheet { shown: Notice.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Navigator.catch-up-shown: RootsCatchUpSheet { shown: Navigator.catch-up-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.confirm-shown: ExportConfirmSheet { shown: Exporting.confirm-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.notice-shown: ExportNoticeSheet { shown: Exporting.notice-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.naming-shown: PresetNameSheet { shown: Exporting.naming-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Stocks.shown: StockPickerSheet { shown: Stocks.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Exporting.papers-shown: PaperSheet { shown: Exporting.papers-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Help.welcome-shown: WelcomeSheet { shown: Help.welcome-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Upgraded.shown: UpgradedSheet { shown: Upgraded.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Help.report-shown: ReportSheet { shown: Help.report-shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Choice.shown: ChoiceSheet { shown: Choice.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if MaskDialog.shown: MaskDialogSheet { shown: MaskDialog.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Advice.shown: AdviceSheet { shown: Advice.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Wrapped.shown: WrappedView { x: 0; y: 0; width: root.width; height: root.height; }
    if Unsaved.shown: UnsavedSheet { shown: Unsaved.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Converting.shown: DngSheet { shown: Converting.shown; x: 0; y: 0; width: root.width; height: root.height; }
    if Kit.picking: KitSearchSheet { shown: Kit.picking; x: 0; y: 0; width: root.width; height: root.height; }
    if Confirm.shown: ConfirmSheet { shown: Confirm.shown; x: 0; y: 0; width: root.width; height: root.height; }
}
