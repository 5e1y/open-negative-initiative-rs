// One tunable, as lab.slint's `Tune`.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 30px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 96px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 36px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

component Caption inherits Text {
    color: #ffffff59;
    font-size: 10px;
    wrap: word-wrap;
    horizontal-alignment: center;
}

// A specimen: the element, then its state's name under it.
component Specimen inherits VerticalLayout {
    in property <string> name;
    spacing: 6px;
    alignment: start;
    @children
    Caption { text: root.name; }
}

// One element's row: its name, its Swift source, then the live instance and its forced states.
component Row inherits VerticalLayout {
    in property <string> title;
    in property <string> source;
    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Heading { text: root.title; }
        Text { text: root.source; color: #ffffff40; font-size: 10px; }
    }
    HorizontalLayout {
        spacing: 28px;
        alignment: start;
        @children
    }
}

// `KeycapChrome` at `Keycap.Variant.small`, drawn by `Keycap` at a free `scale`; `level` gives equal
// walls, `shadow` the cast shadow, `edged` the knob's `strokeBorder(trackLine, 1)`.
component ScaledCap inherits Keycap {
    in property <float> scale: SliderLook.knob-scale;
    in property <bool> edged;
    factor: root.scale;
    shadow: false;
    rim: !root.level;
    edge-width: root.edged ? 1px : 0;
    edge-color: rgba(0, 0, 0, SliderLook.edge);
}

// `DSBarHandle`: a small key set across the track, equal walls, no shadow, a black edge and two white
// grip lines; it grows by `knobGrow` on the `rise` spring when hovered or grabbed. Centred on `cx`, `cy`.
component BarHandle inherits Rectangle {
    in property <bool> vertical;
    in property <color> tint: DS.palette-keycap;
    in property <bool> grown;
    in property <bool> grip: true;
    in property <length> cx;
    in property <length> cy;
    property <float> grow: root.grown ? SliderLook.knob-grow : 1;
    animate grow { duration: SliderLook.rise-ms * 1ms; easing: ease-out-back; }
    property <length> along: SliderLook.knob-thickness * 1px * root.grow;
    property <length> across: SliderLook.knob-length * 1px * root.grow;
    property <length> line: SliderLook.grip-line * 1px * root.grow;
    property <length> gap: SliderLook.grip-gap * 1px * root.grow;
    width: root.vertical ? root.across : root.along;
    height: root.vertical ? root.along : root.across;
    x: root.cx - self.width / 2;
    y: root.cy - self.height / 2;
    ScaledCap {
        albedo: root.tint;
        level: true;
        edged: true;
        // `HStack(spacing: knobLineGap) { line; line }`, turned 90° on a vertical track.
        for i in root.grip ? 2 : 0: Rectangle {
            x: root.vertical ? (parent.width - root.line) / 2 : parent.width / 2 + (i == 0 ? -root.gap / 2 - 1px : root.gap / 2);
            y: root.vertical ? parent.height / 2 + (i == 0 ? -root.gap / 2 - 1px : root.gap / 2) : (parent.height - root.line) / 2;
            width: root.vertical ? root.line : 1px;
            height: root.vertical ? 1px : root.line;
            background: DS.palette-text-on-fill;
        }
    }
}

// `DSRail` in `dsRecessed`: the ground (the track grey, or a bipolar gradient), the fill up to `at`, the
// hollow's shade (`Inward`), the black edge, the lit rim below. Runs past the travel by `overhang` at both ends.
component Rail inherits Rectangle {
    in property <bool> vertical;
    in property <float> at;
    in property <length> overhang: SliderLook.knob-thickness * 1px / 2;
    in property <bool> spectrum;
    in property <color> low;
    in property <color> high;
    in property <color> tint: DS.palette-track-fill;
    in property <bool> metal;
    // No fill, as under the levels' handles.
    in property <bool> bare;
    // A stepped slider's rest, ticked across the rail (the Rust app's `Rail.rest`); none below 0.
    in property <float> rest: -1;
    // The surface the rail is milled into: the rim's shadow needs an opaque body under a translucent ground.
    in property <color> under: DS.palette-panel;
    property <length> radius: SliderLook.track-radius * 1px;
    property <length> along: root.vertical ? root.height : root.width;
    property <length> reached: root.overhang + clamp(root.at, 0, 1) * (root.along - 2 * root.overhang);
    Rectangle {
        border-radius: root.radius;
        background: root.under;
        drop-shadow-color: rgba(255, 255, 255, SliderLook.rim);
        drop-shadow-blur: SliderLook.rim-blur * 1px;
        drop-shadow-offset-y: SliderLook.rim-drop * 1px;
    }
    Rectangle {
        border-radius: root.radius;
        clip: true;
        background: !root.spectrum ? DS.palette-track
            : root.vertical ? @linear-gradient(0deg, root.low 0%, root.high 100%)
            : @linear-gradient(90deg, root.low 0%, root.high 100%);
        // A neutral fill is flat; a tinted one ramps 0.45 → 0.9; `metal` is brushed silver top to bottom.
        if !root.spectrum && !root.bare: Rectangle {
            x: 0;
            y: root.vertical ? parent.height - root.reached : 0;
            width: root.vertical ? parent.width : root.reached;
            height: root.vertical ? root.reached : parent.height;
            background: root.metal
                ? @linear-gradient(180deg, DS.scanner-metal-dark 0%, DS.scanner-metal-light 33.33%, DS.scanner-metal-light 66.67%, DS.scanner-metal-dark 100%)
                : root.tint == DS.palette-track-fill ? root.tint
                : root.vertical ? @linear-gradient(0deg, root.tint.with-alpha(0.45) 0%, root.tint.with-alpha(0.9) 100%)
                : @linear-gradient(90deg, root.tint.with-alpha(0.45) 0%, root.tint.with-alpha(0.9) 100%);
        }
    }
    Inward {
        ground: transparent;
        radius: root.radius;
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: rgba(0, 0, 0, SliderLook.edge);
    }
    if root.rest >= 0: Rectangle {
        x: root.overhang + root.rest * (root.along - 2 * root.overhang) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: SliderLook.knob-length * 1px / 2;
        background: DS.system-secondary;
    }
}

// `DSReadout`: the name at the left, the value at the right in the secondary ink.
component Readout inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text { text: root.label; color: DS.system-primary; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
    Text { text: root.value; color: DS.system-secondary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
}

// `DSSlider`, horizontal: the readout, then a row as tall as the knob whose whole travel grabs. A drag moves
// by the hand's travel (⌥ a fifth), a double click springs back to `base`, a horizontal swipe nudges.
component TrackSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> base;
    in property <bool> enabled: true;
    in property <bool> spectrum;
    in property <color> low: #40c8e0;
    in property <color> high: #ff453a;
    in property <color> tint: DS.palette-track-fill;
    in property <bool> metal;
    in property <color> knob: DS.palette-keycap;
    in property <bool> percent;
    in property <string> unit;
    // Forced states for the specimens: the knob as under the pointer, or as held.
    in property <bool> force-hover;
    in property <bool> force-grab;
    property <float> fraction: (root.value - root.minimum) / max(0.000001, root.maximum - root.minimum);
    // The value drawn: sprung on `settle` when it arrives from elsewhere, never under the hand.
    property <float> shown: root.fraction;
    animate shown { duration: area.pressed || area.scrolling ? 0ms : SliderLook.settle-ms * 1ms; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    pure function readout(v: float) -> string {
        root.percent ? round(v * 100) + "%" : (v >= 0 ? "+" : "") + v.to-fixed(2) + root.unit
    }
    function move-to(f: float) {
        root.value = root.minimum + clamp(f, 0, 1) * (root.maximum - root.minimum);
    }
    spacing: 4px;
    // Off limits, the words fade to `State.missing` and the rail stays opaque, as a key keeps its chrome.
    Readout { label: root.label; value: root.readout(root.value); opacity: root.enabled ? 1 : 0.4; }
    Rectangle {
        height: SliderLook.knob-length * 1px;
        travel := Rectangle {
            x: SliderLook.knob-thickness * 1px / 2;
            width: parent.width - SliderLook.knob-thickness * 1px;
            Rail {
                x: -self.overhang;
                y: (parent.height - self.height) / 2;
                width: parent.width + 2 * self.overhang;
                height: SliderLook.track * 1px;
                at: root.shown;
                spectrum: root.spectrum;
                low: root.low;
                high: root.high;
                tint: root.tint;
                metal: root.metal;
            }
            BarHandle {
                cx: root.shown * travel.width;
                cy: travel.height / 2;
                tint: root.knob;
                grown: root.enabled && (area.over-knob || area.pressed || root.force-hover || root.force-grab);
            }
            area := TouchArea {
                enabled: root.enabled;
                property <float> start;
                property <bool> fine;
                in-out property <bool> scrolling;
                out property <bool> over-knob: self.has-hover && abs(self.mouse-x - root.shown * self.width) <= SliderLook.knob-thickness * 1px / 2;
                mouse-cursor: self.pressed ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.start = root.fraction;
                    }
                    self.fine = event.modifiers.alt;
                }
                moved => {
                    if (self.pressed) {
                        root.move-to(self.start + (self.mouse-x - self.pressed-x) / max(1px, self.width) * (self.fine ? 0.2 : 1));
                    }
                }
                double-clicked => { root.value = root.base; }
                // `DSScrollAdjust`: travel along the track only, 0.25 pt a trackpad point; across it is left to the panel.
                scroll-event(event) => {
                    if (event.delta-x != 0 && abs(event.delta-x) > abs(event.delta-y)) {
                        self.scrolling = true;
                        idle.restart();
                        root.move-to(root.fraction + event.delta-x * 0.25 / max(1px, self.width) * (event.modifiers.alt ? 0.2 : 1));
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }
            // `DSScroll.idleWindow`: a scroll ends 0.16 s after its last event.
            idle := Timer {
                interval: 160ms;
                running: area.scrolling;
                triggered => { area.scrolling = false; }
            }
        }
    }
}

// `DSSlider(axis: .vertical)`: the same control turned, low at the bottom; the grip lines turn with it.
component UprightSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> base;
    in property <bool> spectrum;
    in property <color> low: #40c8e0;
    in property <color> high: #ff453a;
    in property <bool> percent;
    in property <string> unit;
    property <float> fraction: (root.value - root.minimum) / max(0.000001, root.maximum - root.minimum);
    property <float> shown: root.fraction;
    animate shown { duration: area.pressed || area.scrolling ? 0ms : SliderLook.settle-ms * 1ms; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    function move-to(f: float) {
        root.value = root.minimum + clamp(f, 0, 1) * (root.maximum - root.minimum);
    }
    spacing: 4px;
    Readout { label: root.label; value: root.percent ? round(root.value * 100) + "%" : (root.value >= 0 ? "+" : "") + root.value.to-fixed(2) + root.unit; }
    HorizontalLayout {
        alignment: start;
        vertical-stretch: 1;
        Rectangle {
            width: SliderLook.knob-length * 1px;
            travel := Rectangle {
                y: SliderLook.knob-thickness * 1px / 2;
                height: parent.height - SliderLook.knob-thickness * 1px;
                Rail {
                    vertical: true;
                    x: (parent.width - self.width) / 2;
                    y: -self.overhang;
                    width: SliderLook.track * 1px;
                    height: parent.height + 2 * self.overhang;
                    at: root.shown;
                    spectrum: root.spectrum;
                    low: root.low;
                    high: root.high;
                }
                BarHandle {
                    vertical: true;
                    cx: travel.width / 2;
                    cy: travel.height - root.shown * travel.height;
                    grown: area.over-knob || area.pressed;
                }
                area := TouchArea {
                    property <float> start;
                    property <bool> fine;
                    in-out property <bool> scrolling;
                    out property <bool> over-knob: self.has-hover && abs(self.mouse-y - (1 - root.shown) * self.height) <= SliderLook.knob-thickness * 1px / 2;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            self.start = root.fraction;
                        }
                        self.fine = event.modifiers.alt;
                    }
                    // Travel counts upwards: a value of 1 belongs at the top.
                    moved => {
                        if (self.pressed) {
                            root.move-to(self.start - (self.mouse-y - self.pressed-y) / max(1px, self.height) * (self.fine ? 0.2 : 1));
                        }
                    }
                    double-clicked => { root.value = root.base; }
                    scroll-event(event) => {
                        if (event.delta-y != 0 && abs(event.delta-y) > abs(event.delta-x)) {
                            self.scrolling = true;
                            idle.restart();
                            root.move-to(root.fraction - event.delta-y * 0.25 / max(1px, self.height));
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                idle := Timer {
                    interval: 160ms;
                    running: area.scrolling;
                    triggered => { area.scrolling = false; }
                }
            }
        }
    }
}

// A key of the scanner's keypad (`LabKeyboard.styled`): a small cap, its legend inked dark on a light
// albedo (luminance over 0.55), white otherwise; it sinks under the press as `Keycap` does.
component StepKey inherits Rectangle {
    in property <string> legend;
    in property <color> fill: DS.palette-keycap;
    in property <length> legend-size: 13px;
    in property <bool> enabled: true;
    in property <bool> force-press;
    callback clicked(bool);
    property <bool> light: (0.2126 * root.fill.red + 0.7152 * root.fill.green + 0.0722 * root.fill.blue) / 255 > 0.55;
    ScaledCap {
        albedo: root.fill;
        shadow: true;
        depth: root.force-press || touch.pressed ? 1 : touch.has-hover ? Depth.hover-press : 0;
        animate depth { duration: Depth.press-time; easing: ease-out; }
        Text {
            text: root.legend;
            color: root.light ? #1f1f1f : DS.palette-text-on-fill;
            font-size: root.legend-size;
            font-weight: 700;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        property <bool> shift;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { self.shift = event.modifiers.shift; }
        }
        clicked => { root.clicked(self.shift); }
    }
}

// The Rust app's stepped `Slider` (the Scanner face's letters): whole steps on a bipolar rail ticked at
// rest, a key either side in its end's colour, one step a click and three with ⇧; the name's double click rests it.
component SteppedSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> lowest: -10;
    in property <int> highest: 10;
    in property <color> low: #d6403a;
    in property <color> high: #1fa8c7;
    in property <bool> force-hover;
    property <int> span: max(1, root.highest - root.lowest);
    property <float> shown: (root.value - root.lowest) / root.span;
    animate shown { duration: area.pressed ? 0ms : SliderLook.settle-ms * 1ms; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    function step-by(by: int) { root.value = clamp(root.value + by, root.lowest, root.highest); }
    pure function step-at(x: length) -> int {
        root.lowest + round(clamp(x / max(1px, travel.width), 0, 1) * root.span)
    }
    spacing: 4px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: DS.system-primary;
            font-size: 13px;
            horizontal-stretch: 1;
            TouchArea { double-clicked => { root.value = 0; } }
        }
        Text { text: (root.value > 0 ? "+" : "") + root.value; color: DS.system-secondary; font-size: 11px; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 8px;
        StepKey {
            width: 24px;
            height: 24px;
            y: (SliderLook.knob-length * 1px - self.height) / 2;
            legend: "−";
            fill: root.low;
            clicked(shift) => { root.step-by(shift ? -3 : -1); }
        }
        Rectangle {
            height: SliderLook.knob-length * 1px;
            horizontal-stretch: 1;
            travel := Rectangle {
                x: SliderLook.knob-thickness * 1px / 2;
                width: parent.width - SliderLook.knob-thickness * 1px;
                Rail {
                    x: -self.overhang;
                    y: (parent.height - self.height) / 2;
                    width: parent.width + 2 * self.overhang;
                    height: SliderLook.track * 1px;
                    spectrum: true;
                    low: root.low;
                    high: root.high;
                    rest: (0 - root.lowest) / root.span;
                }
                BarHandle {
                    cx: root.shown * travel.width;
                    cy: travel.height / 2;
                    grip: false;
                    grown: area.over-knob || area.pressed || root.force-hover;
                }
                area := TouchArea {
                    out property <bool> over-knob: self.has-hover && abs(self.mouse-x - root.shown * self.width) <= SliderLook.knob-thickness * 1px / 2;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.value = root.step-at(self.mouse-x);
                        }
                    }
                    moved => {
                        if (self.pressed) { root.value = root.step-at(self.mouse-x); }
                    }
                }
            }
        }
        StepKey {
            width: 24px;
            height: 24px;
            y: (SliderLook.knob-length * 1px - self.height) / 2;
            legend: "+";
            fill: root.high;
            clicked(shift) => { root.step-by(shift ? 3 : 1); }
        }
    }
}

// `LabStepKeys`: a finishing slider as the scanner's keys on their socket (`LabStack`): −3 −1 TITLE +1 +3,
// the side keys in their end's band colour, the middle key back to rest. 46 pt tall, the title key 96 wide.
component StepKeyRow inherits Rectangle {
    in property <string> title;
    in-out property <float> value;
    in property <float> step: 0.05;
    in property <float> minimum: -1;
    in property <float> maximum: 1;
    in property <color> minus-fill: rgb(71, 71, 77);
    in property <color> plus-fill: rgb(219, 219, 214);
    in property <bool> force-press;
    function moved(by: int) {
        root.value = clamp((round(root.value / root.step) + by) * root.step, root.minimum, root.maximum);
    }
    height: 46px;
    // The socket: `socketColor` black at the small cap's corner.
    border-radius: Depth.corner * SliderLook.knob-scale;
    background: #000000;
    HorizontalLayout {
        StepKey { legend: "−3"; fill: root.minus-fill; clicked => { root.moved(-3); } }
        StepKey { legend: "−"; fill: root.minus-fill; clicked => { root.moved(-1); } }
        StepKey { width: 96px; legend: root.title; fill: DS.palette-keycap; force-press: root.force-press; clicked => { root.value = 0; } }
        StepKey { legend: "+"; fill: root.plus-fill; clicked => { root.moved(1); } }
        StepKey { legend: "+3"; fill: root.plus-fill; clicked => { root.moved(3); } }
    }
}

// `dsPlotScreen`: a plot behind glass, the canvas floor sunk at the card's corner (`hollowBlur` 4, `hollowDrop` 3),
// quarter lines engraved in `separator` hairlines; the content lies under the hollow's shade.
component PlotScreen inherits Rectangle {
    in property <bool> grid: true;
    in property <color> under: DS.palette-panel;
    property <length> radius: SliderLook.plot-radius * 1px;
    Rectangle {
        border-radius: root.radius;
        background: root.under;
        drop-shadow-color: rgba(255, 255, 255, SliderLook.rim);
        drop-shadow-blur: SliderLook.rim-blur * 1px;
        drop-shadow-offset-y: SliderLook.rim-drop * 1px;
    }
    Rectangle {
        border-radius: root.radius;
        background: DS.palette-canvas;
        clip: true;
        for i in root.grid ? 3 : 0: Rectangle {
            x: parent.width * (i + 1) / 4;
            width: 0.5px;
            background: rgba(255, 255, 255, SliderLook.grid);
        }
        for i in root.grid ? 3 : 0: Rectangle {
            y: parent.height * (i + 1) / 4;
            height: 0.5px;
            background: rgba(255, 255, 255, SliderLook.grid);
        }
        @children
    }
    Inward {
        ground: transparent;
        radius: root.radius;
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: rgba(0, 0, 0, SliderLook.edge);
    }
}

// A marker: `DS.Palette.marker` dashed 3 on 3 down the plot, at `x`.
component Marker inherits Rectangle {
    width: 1px;
    for i in 16: Rectangle {
        y: i * 6px;
        height: 3px;
        background: DS.palette-marker;
    }
}

// A suggested placement: a solid `guideFaint` hairline and a 5 pt wedge at its foot.
component Suggestion inherits Rectangle {
    width: 10px;
    Rectangle { x: 4.5px; width: 1px; background: DS.palette-guide-faint; }
    Path {
        y: parent.height - 5px;
        width: 10px;
        height: 5px;
        viewbox-width: 10;
        viewbox-height: 5;
        fill: DS.palette-guide-faint;
        commands: "M 0 5 L 10 5 L 5 0 Z";
    }
}

// `HistogramTraces`, 480×96: the luminance as a colourless backdrop, then red, green and blue (`plusLighter`
// in Swift, plain alpha here); `lit` 0-2 (Swift's `focus`) dims the two other channels to a fifth.
component Histogram inherits Rectangle {
    in property <int> lit: -1;
    width: 480px;
    height: 96px;
    property <float> r: root.lit >= 0 && root.lit != 0 ? 0.2 : 1;
    property <float> g: root.lit >= 0 && root.lit != 1 ? 0.2 : 1;
    property <float> b: root.lit >= 0 && root.lit != 2 ? 0.2 : 1;
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.luma; fill: #ffffff1f; stroke: #ffffff73; stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.red; fill: rgba(255, 69, 58, 0.28 * root.r); stroke: rgba(255, 69, 58, 0.85 * root.r); stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.green; fill: rgba(50, 215, 75, 0.28 * root.g); stroke: rgba(50, 215, 75, 0.85 * root.g); stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.blue; fill: rgba(10, 132, 255, 0.28 * root.b); stroke: rgba(10, 132, 255, 0.85 * root.b); stroke-width: 1px; }
}

// `DSTrackHandle`: a knob on a track several share, caught in a 24 pt box centred on it (`grabSize`), never the
// track; dragged from where it was caught, sprung on `settle` for a value from elsewhere, double click to rest.
component TrackHandle inherits Rectangle {
    in-out property <float> value;
    in property <float> rest;
    in property <float> lowest: 0;
    in property <float> highest: 1;
    in property <color> tint;
    in property <length> span;
    in property <bool> force-grown;
    // The pointer's own place: the box moves under the hand, so its local coordinates cannot measure the drag.
    property <length> pointer: self.absolute-position.x + area.mouse-x;
    property <length> caught;
    property <float> start;
    property <float> shown: root.value;
    animate shown { duration: area.pressed ? 0ms : SliderLook.settle-ms * 1ms; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    x: clamp(root.shown, 0, 1) * root.span - self.width / 2;
    width: 24px;
    height: SliderLook.knob-length * 1px;
    BarHandle {
        cx: parent.width / 2;
        cy: parent.height / 2;
        tint: root.tint;
        grown: area.has-hover || area.pressed || root.force-grown;
    }
    area := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.start = root.value;
                root.caught = root.pointer;
            }
        }
        moved => {
            if (self.pressed) {
                root.value = clamp(root.start + (root.pointer - root.caught) / max(1px, root.span), root.lowest, root.highest);
            }
        }
        double-clicked => { root.value = root.rest; }
    }
}

// `LevelsView`: the histogram behind its plot screen over a bare rail and five handles, both inset half a knob
// a side so a handle's centre lines up with the plot; the markers follow the handles. Ends drawn last, on top.
component LevelsTrack inherits VerticalLayout {
    in-out property <float> black: 0;
    in-out property <float> shadows: 0.25;
    in-out property <float> mid: 0.5;
    in-out property <float> highlights: 0.75;
    in-out property <float> white: 1;
    in property <bool> suggest;
    in property <int> lit: -1;
    property <length> span: 480px;
    // `LevelsView.grip(at:)`: the handle under the pointer, else the nearest, read front to back.
    pure function nearest(x: length) -> int {
        abs(root.white * root.span - x) <= 12px ? 4
            : abs(root.black * root.span - x) <= 12px ? 0
            : abs(root.highlights * root.span - x) <= 12px ? 3
            : abs(root.mid * root.span - x) <= 12px ? 2
            : abs(root.shadows * root.span - x) <= 12px ? 1
            : x < (root.black + root.shadows) * root.span / 2 ? 0
            : x < (root.shadows + root.mid) * root.span / 2 ? 1
            : x < (root.mid + root.highlights) * root.span / 2 ? 2
            : x < (root.highlights + root.white) * root.span / 2 ? 3 : 4
    }
    function nudge(x: length, by: float) {
        if (root.nearest(x) == 0) { root.black = clamp(root.black + by, 0, root.shadows); }
        else if (root.nearest(x) == 1) { root.shadows = clamp(root.shadows + by, root.black, root.mid); }
        else if (root.nearest(x) == 2) { root.mid = clamp(root.mid + by, root.shadows, root.highlights); }
        else if (root.nearest(x) == 3) { root.highlights = clamp(root.highlights + by, root.mid, root.white); }
        else { root.white = clamp(root.white + by, root.highlights, 1); }
    }
    padding-left: 12px;
    padding-right: 12px;
    spacing: 2px;
    PlotScreen {
        width: root.span;
        height: 96px;
        Histogram { lit: root.lit; }
        for m in [root.black, root.shadows, root.mid, root.highlights, root.white]: Marker {
            x: m * root.span - 0.5px;
        }
        for m in root.suggest ? [0.06, 0.3, 0.52, 0.7, 0.93] : []: Suggestion {
            x: m * root.span - 5px;
        }
    }
    Rectangle {
        width: root.span;
        height: SliderLook.knob-length * 1px;
        Rail {
            x: -self.overhang;
            y: (parent.height - self.height) / 2;
            width: parent.width + 2 * self.overhang;
            height: SliderLook.track * 1px;
            bare: true;
        }
        // `DSScrollAdjust` over the track: a swipe moves the handle under the pointer, else the nearest.
        TouchArea {
            scroll-event(event) => {
                if (event.delta-x != 0 && abs(event.delta-x) > abs(event.delta-y)) {
                    root.nudge(self.mouse-x, event.delta-x * 0.25 / root.span);
                    return EventResult.accept;
                }
                EventResult.reject
            }
            TrackHandle { span: root.span; value <=> root.shadows; rest: 0.25; lowest: root.black; highest: root.mid; tint: #404040; }
            TrackHandle { span: root.span; value <=> root.mid; rest: 0.5; lowest: root.shadows; highest: root.highlights; tint: #808080; }
            TrackHandle { span: root.span; value <=> root.highlights; rest: 0.75; lowest: root.mid; highest: root.white; tint: #bfbfbf; }
            TrackHandle { span: root.span; value <=> root.black; rest: 0; lowest: 0; highest: root.shadows; tint: #000000; }
            TrackHandle { span: root.span; value <=> root.white; rest: 1; lowest: root.highlights; highest: 1; tint: #ffffff; }
        }
    }
    HorizontalLayout {
        width: root.span;
        Text { text: "Black " + root.black.to-fixed(2); color: DS.system-tertiary; font-size: 11px; }
        Text { text: "Shadows " + root.shadows.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "Mid " + root.mid.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "Highs " + root.highlights.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "White " + root.white.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: right; }
    }
}

// `DSHandle`: a curve point's disc, 9 pt, `handleIdle` hairline at rest, grown ×1.45 with a white line when active.
component CurvePoint inherits Rectangle {
    in property <color> tint: DS.system-primary;
    in property <bool> active;
    property <length> size: 9px * (root.active ? 1.45 : 1);
    width: 24px;
    height: 24px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: root.tint;
        border-width: root.active ? 1px : 0.5px;
        border-color: root.active ? DS.palette-handle-active : DS.palette-handle-idle;
        drop-shadow-color: rgba(0, 0, 0, 0.3);
        drop-shadow-blur: root.active ? 2px : 1px;
        drop-shadow-offset-y: 0.5px;
    }
}

// The playground's knob specimen: a 52 pt cyan → red rail with a handle on it.
component KnobSpecimen inherits Rectangle {
    in property <color> tint: DS.palette-keycap;
    in property <bool> grown;
    in property <bool> vertical;
    width: 64px;
    height: SliderLook.knob-length * 1px + 6px;
    Rail {
        vertical: root.vertical;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.vertical ? SliderLook.track * 1px : 52px;
        height: root.vertical ? parent.height : SliderLook.track * 1px;
        overhang: 0;
        spectrum: true;
        low: #40c8e0;
        high: #ff453a;
    }
    BarHandle {
        vertical: root.vertical;
        cx: parent.width / 2;
        cy: parent.height / 2;
        tint: root.tint;
        grown: root.grown;
    }
}

export component SlidersPage inherits Rectangle {
    background: DS.palette-panel;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 34px;
            alignment: start;

            // The page's tunables, in three columns.
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                VerticalLayout {
                    width: 300px;
                    Heading { text: "TRACK"; }
                    Tune { label: "track height"; minimum: 4; maximum: 24; value <=> SliderLook.track; }
                    Tune { label: "track radius"; maximum: 12; value <=> SliderLook.track-radius; }
                    Tune { label: "edge"; value <=> SliderLook.edge; }
                    Tune { label: "rim"; value <=> SliderLook.rim; }
                    Tune { label: "rim blur"; maximum: 4; value <=> SliderLook.rim-blur; }
                    Tune { label: "rim drop"; maximum: 4; value <=> SliderLook.rim-drop; }
                }
                VerticalLayout {
                    width: 300px;
                    Heading { text: "KNOB"; }
                    Tune { label: "thickness"; minimum: 8; maximum: 48; value <=> SliderLook.knob-thickness; }
                    Tune { label: "length"; minimum: 14; maximum: 60; value <=> SliderLook.knob-length; }
                    Tune { label: "key scale"; minimum: 0.2; maximum: 1; value <=> SliderLook.knob-scale; }
                    Tune { label: "grow"; minimum: 1; maximum: 1.4; value <=> SliderLook.knob-grow; }
                    Tune { label: "grip line"; maximum: 24; value <=> SliderLook.grip-line; }
                    Tune { label: "grip gap"; maximum: 12; value <=> SliderLook.grip-gap; }
                }
                VerticalLayout {
                    width: 300px;
                    Heading { text: "MOTION, PLOT"; }
                    Tune { label: "rise ms"; maximum: 400; value <=> SliderLook.rise-ms; }
                    Tune { label: "settle ms"; maximum: 1000; value <=> SliderLook.settle-ms; }
                    Tune { label: "plot radius"; maximum: 24; value <=> SliderLook.plot-radius; }
                    Tune { label: "grid"; maximum: 0.5; value <=> SliderLook.grid; }
                }
            }

            Row {
                title: "DSSLIDER";
                source: "DSSlider.swift:18 (DSRail :188, dsRecessed :252) · DSPlayground.swift:328";
                VerticalLayout {
                    width: 308px;
                    spacing: 16px;
                    alignment: start;
                    TrackSlider { label: "Amount"; value: 0.4; base: 0.4; percent: true; }
                    TrackSlider { label: "Cyan ↔ Red"; value: 0; minimum: -1; maximum: 1; spectrum: true; unit: " st"; }
                    TrackSlider { label: "Denoise"; value: 0.25; tint: DS.tint-chroma; percent: true; }
                    TrackSlider { label: "Chrome"; value: 0.6; metal: true; percent: true; }
                    Caption { text: "live: drag, ⌥ for a fifth, double-click to reset, swipe sideways"; horizontal-alignment: left; }
                }
                VerticalLayout {
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "rest"; TrackSlider { width: 200px; label: "Amount"; value: 0.4; percent: true; } }
                        Specimen { name: "hover (knob ×1.07)"; TrackSlider { width: 200px; label: "Amount"; value: 0.4; percent: true; force-hover: true; } }
                        Specimen { name: "dragging"; TrackSlider { width: 200px; label: "Amount"; value: 0.62; percent: true; force-grab: true; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "disabled (words at 0.4)"; TrackSlider { width: 200px; label: "Amount"; value: 0.4; percent: true; enabled: false; } }
                        Specimen { name: "fill at 0"; TrackSlider { width: 200px; label: "Amount"; value: 0; percent: true; } }
                        Specimen { name: "fill at 1"; TrackSlider { width: 200px; label: "Amount"; value: 1; percent: true; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "bipolar at zero"; TrackSlider { width: 200px; label: "Cyan ↔ Red"; value: 0; minimum: -1; maximum: 1; spectrum: true; unit: " st"; } }
                        Specimen { name: "bipolar, low side"; TrackSlider { width: 200px; label: "Cyan ↔ Red"; value: -0.6; minimum: -1; maximum: 1; spectrum: true; unit: " st"; } }
                        Specimen { name: "bipolar, high side"; TrackSlider { width: 200px; label: "Cyan ↔ Red"; value: 0.6; minimum: -1; maximum: 1; spectrum: true; unit: " st"; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "tinted ramp 0.45 → 0.9"; TrackSlider { width: 200px; label: "Denoise"; value: 0.7; tint: DS.tint-chroma; percent: true; } }
                        Specimen { name: "metal"; TrackSlider { width: 200px; label: "Chrome"; value: 0.7; metal: true; percent: true; } }
                        Specimen { name: "knob carrying its value"; TrackSlider { width: 200px; label: "Tint"; value: 0.3; spectrum: true; low: #32d74b; high: #d63380; knob: #d63380; percent: true; } }
                    }
                    Caption { text: "Swift's bipolar rail has no progressive fill: the gradient is the whole bar and the knob reads the balance."; horizontal-alignment: left; }
                }
            }

            Row {
                title: "DSSLIDER, VERTICAL";
                source: "DSSlider.swift:144 (centre, flipped) · DSPlayground.swift:340";
                HorizontalLayout {
                    spacing: 24px;
                    height: 180px;
                    UprightSlider { width: 130px; label: "Amount"; value: 0.4; base: 0.4; percent: true; }
                    UprightSlider { width: 130px; label: "Cyan ↔ Red"; value: 0; minimum: -1; maximum: 1; spectrum: true; unit: " st"; }
                }
            }

            Row {
                title: "DSBARHANDLE";
                source: "DSHandle.swift:27 (KeycapStyle.hardened × Variant.small 0.525) · DSPlayground.swift:493";
                Specimen { name: "rest"; KnobSpecimen { } }
                Specimen { name: "hover"; KnobSpecimen { grown: true; } }
                Specimen { name: "grab"; KnobSpecimen { grown: true; } }
                Specimen { name: "black"; KnobSpecimen { tint: #000000; } }
                Specimen { name: "white, grabbed"; KnobSpecimen { tint: #ffffff; grown: true; } }
                Specimen { name: "vertical"; KnobSpecimen { vertical: true; height: 52px; } }
                Specimen {
                    name: "×4, to read the chrome";
                    Rectangle {
                        width: 120px;
                        height: 150px;
                        ScaledCap {
                            x: (parent.width - self.width) / 2;
                            width: 96px;
                            height: 136px;
                            scale: SliderLook.knob-scale * 4;
                            level: true;
                            edged: true;
                        }
                    }
                }
            }

            Row {
                title: "DSHANDLE";
                source: "DSHandle.swift:5 (the curve point) · DSPlayground.swift:363";
                Specimen { name: "rest"; CurvePoint { } }
                Specimen { name: "active"; CurvePoint { active: true; } }
                Specimen { name: "active, tinted"; CurvePoint { active: true; tint: DS.tint-chroma; } }
            }

            Row {
                title: "STEPPED SLIDER";
                source: "the Rust app's ds/slider.slint:120 (Scanner letters) · keys from LabKeyboard.swift:107";
                VerticalLayout {
                    width: 308px;
                    spacing: 16px;
                    alignment: start;
                    SteppedSlider { label: "C"; value: 0; }
                    SteppedSlider { label: "D"; value: 3; low: rgb(71, 71, 77); high: rgb(219, 219, 214); }
                    Caption { text: "live: press or drag the rail, click a key (⇧ for three), double-click the name"; horizontal-alignment: left; }
                }
                Specimen { name: "at rest (ticked)"; SteppedSlider { width: 220px; label: "M"; value: 0; low: rgb(46, 163, 122); high: rgb(214, 51, 128); } }
                Specimen { name: "hover, low side"; SteppedSlider { width: 220px; label: "Y"; value: -4; low: rgb(56, 92, 214); high: rgb(237, 199, 46); force-hover: true; } }
            }

            Row {
                title: "LABSTEPKEYS";
                source: "LabKeyboard.swift:132 (LabStack :117, band :100) · ColorPane.swift:121";
                VerticalLayout {
                    spacing: 6px;
                    contrast := StepKeyRow { width: 308px; title: "CONTRAST"; value: 0; }
                    Caption { text: "live: CONTRAST " + round(contrast.value * 100) + " %"; horizontal-alignment: left; }
                }
                Specimen { name: "title key pressed"; StepKeyRow { width: 308px; title: "VIGNETTE"; force-press: true; minus-fill: rgb(219, 219, 214); plus-fill: rgb(71, 71, 77); } }
            }

            Row {
                title: "LEVELS TRACK";
                source: "LevelsView.swift:96 (DSTrackHandle, DSHandle.swift:114) · grips :124";
                VerticalLayout {
                    spacing: 6px;
                    LevelsTrack { }
                    Caption { text: "live: drag a handle, double-click to rest, swipe sideways over the track"; horizontal-alignment: left; }
                }
                Specimen { name: "suggestions shown, green focused"; LevelsTrack { black: 0.08; shadows: 0.3; mid: 0.47; highlights: 0.72; white: 0.9; suggest: true; lit: 1; } }
            }

            Row {
                title: "DSPLOTSCREEN";
                source: "DSPlotScreen.swift:13 (dsRecessed at the card radius) · DSPlayground.swift:386";
                Specimen {
                    name: "plot screen, quarters engraved";
                    PlotScreen {
                        width: 480px;
                        height: 96px;
                        Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.curve; stroke: DS.palette-selected; stroke-width: 1.5px; }
                    }
                }
                Specimen {
                    name: "no grid (Spectrogram)";
                    PlotScreen { width: 160px; height: 96px; grid: false; }
                }
            }

            Row {
                title: "DSHISTOGRAM, ALONE";
                source: "DSHistogram.swift:207 (on the panel, no screen) · DSPlayground.swift:468";
                Specimen {
                    name: "DSHistogram alone, markers 0.15 · 0.5 · 0.9";
                    Rectangle {
                        width: 480px;
                        height: 96px;
                        background: DS.palette-panel;
                        Histogram { }
                        Marker { x: 0.15 * 480px; }
                        Marker { x: 0.5 * 480px; }
                        Marker { x: 0.9 * 480px; }
                    }
                }
            }

            Row {
                title: "DSSCROLLADJUST";
                source: "DSScrollAdjust.swift:30";
                Text {
                    text: "No look of its own: an invisible catcher for the wheel. Every live track above takes it: a sideways\ntwo-finger swipe moves 0.25 pt a point, a swipe across the track is left to the page, 0.16 s of quiet ends it.";
                    color: DS.system-secondary;
                    font-size: 11px;
                }
            }
        }
    }
}
