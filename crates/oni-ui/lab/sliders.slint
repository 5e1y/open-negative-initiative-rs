// One tunable, as lab.slint's `Tune`; a length or a duration in points or milliseconds.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 30px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 96px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Tuner { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 36px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component LengthTune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <length> value;
    height: 30px;
    Tune {
        label: root.label;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.value / 1px;
        changed value => { root.value = self.value * 1px; }
    }
}

component TimeTune inherits Rectangle {
    in property <string> label;
    in property <float> maximum: 1;
    in-out property <duration> value;
    height: 30px;
    Tune {
        label: root.label;
        maximum: root.maximum;
        value: root.value / 1ms;
        changed value => { root.value = self.value * 1ms; }
    }
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

component Caption inherits Text {
    color: #ffffff59;
    font-size: 10px;
    wrap: word-wrap;
    horizontal-alignment: center;
}

// A specimen: the element, then its state's name under it.
component Specimen inherits VerticalLayout {
    in property <string> name;
    spacing: 6px;
    alignment: start;
    @children
    Caption { text: root.name; }
}

// One element's row: its name, its Swift source, then the live instance and its forced states.
component Row inherits VerticalLayout {
    in property <string> title;
    in property <string> source;
    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Heading { text: root.title; }
        Text { text: root.source; color: #ffffff40; font-size: 10px; }
    }
    HorizontalLayout {
        spacing: 28px;
        alignment: start;
        @children
    }
}

// The DS `Slider` driven as Rust drives it in the app: a drag by the hand's travel (⌥ a fifth), the
// second press of a double click back to `base`, a sideways swipe a quarter point a point.
component LiveSlider inherits Slider {
    in-out property <float> amount;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> base;
    in property <bool> percent;
    in property <string> unit;
    property <float> start;
    property <duration> last: -1s;
    function move-to(f: float) {
        root.amount = root.minimum + clamp(f, 0, 1) * (root.maximum - root.minimum);
    }
    fraction: (root.amount - root.minimum) / max(0.000001, root.maximum - root.minimum);
    readout: root.percent ? round(root.amount * 100) + "%" : (root.amount >= 0 ? "+" : "") + root.amount.to-fixed(2) + root.unit;
    value-text: self.readout;
    press(f, fine) => {
        if (animation-tick() - root.last < 400ms) {
            root.amount = root.base;
            root.last = -1s;
            return true;
        }
        root.last = animation-tick();
        root.start = root.fraction;
        return false;
    }
    drag(f, travel, span, fine) => { root.move-to(root.start + travel / max(1px, span) * (fine ? 0.2 : 1)); }
    scroll(f, dx, dy, span, fine) => {
        if (dx != 0 && abs(dx) > abs(dy)) {
            root.move-to(root.fraction + dx * 0.25 / max(1px, span) * (fine ? 0.2 : 1));
            return true;
        }
        return false;
    }
    step(f, by) => { root.move-to(root.fraction + by / 100); }
}

// The DS stepped `Slider` (the Scanner face's letters): whole steps, a key either side, ⇧ for three.
component LiveStepped inherits Slider {
    in-out property <int> amount;
    stepped: true;
    lowest: -10;
    highest: 10;
    value: root.amount;
    readout: (root.amount > 0 ? "+" : "") + root.amount;
    value-text: self.readout;
    step(f, by) => { root.amount = clamp(root.amount + by, root.lowest, root.highest); }
    reset => { root.amount = 0; }
}

// `DSSlider(axis: .vertical)`: the DS rail and knob turned, low at the bottom; no screen of the app
// holds one, so it is driven here alone.
component UprightSlider inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> base;
    in property <bool> spectrum;
    in property <color> low: #40c8e0;
    in property <color> high: #ff453a;
    in property <bool> percent;
    in property <string> unit;
    property <float> fraction: (root.value - root.minimum) / max(0.000001, root.maximum - root.minimum);
    property <float> shown: root.fraction;
    animate shown { duration: area.pressed || area.scrolling ? 0ms : SliderStyle.settle; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
    function move-to(f: float) {
        root.value = root.minimum + clamp(f, 0, 1) * (root.maximum - root.minimum);
    }
    spacing: 4px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; color: DS.system-primary; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.percent ? round(root.value * 100) + "%" : (root.value >= 0 ? "+" : "") + root.value.to-fixed(2) + root.unit; color: DS.system-secondary; font-size: 11px; }
    }
    HorizontalLayout {
        alignment: start;
        vertical-stretch: 1;
        Rectangle {
            width: SliderStyle.knob-height;
            travel := Rectangle {
                y: SliderStyle.knob-width / 2;
                height: parent.height - SliderStyle.knob-width;
                Rail {
                    vertical: true;
                    x: (parent.width - self.width) / 2;
                    y: -self.overhang;
                    width: SliderStyle.track;
                    height: parent.height + 2 * self.overhang;
                    overhang: SliderStyle.knob-width / 2;
                    fill: root.spectrum ? SliderFill.bipolar : SliderFill.level;
                    at: root.shown;
                    low: root.low;
                    high: root.high;
                }
                Knob {
                    vertical: true;
                    across: travel.width;
                    centre: travel.height - root.shown * travel.height;
                    grown: area.over-knob || area.pressed;
                }
                area := TouchArea {
                    property <float> start;
                    property <bool> fine;
                    in-out property <bool> scrolling;
                    out property <bool> over-knob: self.has-hover && abs(self.mouse-y - (1 - root.shown) * self.height) <= SliderStyle.knob-width / 2;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            self.start = root.fraction;
                        }
                        self.fine = event.modifiers.alt;
                    }
                    // Travel counts upwards: a value of 1 belongs at the top.
                    moved => {
                        if (self.pressed) {
                            root.move-to(self.start - (self.mouse-y - self.pressed-y) / max(1px, self.height) * (self.fine ? 0.2 : 1));
                        }
                    }
                    double-clicked => { root.value = root.base; }
                    scroll-event(event) => {
                        if (event.delta-y != 0 && abs(event.delta-y) > abs(event.delta-x)) {
                            self.scrolling = true;
                            idle.restart();
                            root.move-to(root.fraction - event.delta-y * 0.25 / max(1px, self.height));
                            return EventResult.accept;
                        }
                        EventResult.reject
                    }
                }
                idle := Timer {
                    interval: 160ms;
                    running: area.scrolling;
                    triggered => { area.scrolling = false; }
                }
            }
        }
    }
}

// A key of the scanner's keypad (`LabKeyboard.styled`): a small cap, its legend inked dark on a light
// albedo (luminance over 0.55), white otherwise; it sinks under the press as `Keycap` does.
component StepKey inherits Rectangle {
    in property <string> legend;
    in property <color> fill: DS.palette-keycap;
    in property <length> legend-size: 13px;
    in property <bool> enabled: true;
    in property <bool> force-press;
    callback clicked(bool);
    property <bool> light: (0.2126 * root.fill.red + 0.7152 * root.fill.green + 0.0722 * root.fill.blue) / 255 > 0.55;
    Keycap {
        albedo: root.fill;
        factor: SliderStyle.knob-factor;
        depth: root.force-press || touch.pressed ? 1 : touch.has-hover ? Depth.hover-press : 0;
        animate depth { duration: Depth.press-time; easing: ease-out; }
        Text {
            text: root.legend;
            color: root.light ? #1f1f1f : DS.palette-text-on-fill;
            font-size: root.legend-size;
            font-weight: 700;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        property <bool> shift;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { self.shift = event.modifiers.shift; }
        }
        clicked => { root.clicked(self.shift); }
    }
}

// `LabStepKeys`: a finishing slider as the scanner's keys on their socket (`LabStack`): −3 −1 TITLE +1 +3,
// the side keys in their end's band colour, the middle key back to rest. 46 pt tall, the title key 96 wide.
component StepKeyRow inherits Rectangle {
    in property <string> title;
    in-out property <float> value;
    in property <float> step: 0.05;
    in property <float> minimum: -1;
    in property <float> maximum: 1;
    in property <color> minus-fill: rgb(71, 71, 77);
    in property <color> plus-fill: rgb(219, 219, 214);
    in property <bool> force-press;
    function moved(by: int) {
        root.value = clamp((round(root.value / root.step) + by) * root.step, root.minimum, root.maximum);
    }
    height: 46px;
    // The socket: `socketColor` black at the small cap's corner.
    border-radius: Depth.corner * SliderStyle.knob-factor;
    background: #000000;
    HorizontalLayout {
        StepKey { legend: "−3"; fill: root.minus-fill; clicked => { root.moved(-3); } }
        StepKey { legend: "−"; fill: root.minus-fill; clicked => { root.moved(-1); } }
        StepKey { width: 96px; legend: root.title; fill: DS.palette-keycap; force-press: root.force-press; clicked => { root.value = 0; } }
        StepKey { legend: "+"; fill: root.plus-fill; clicked => { root.moved(1); } }
        StepKey { legend: "+3"; fill: root.plus-fill; clicked => { root.moved(3); } }
    }
}

// A marker: `DS.Palette.marker` dashed 3 on 3 down the plot, at `x`.
component Marker inherits Rectangle {
    width: 1px;
    for i in 16: Rectangle {
        y: i * 6px;
        height: 3px;
        background: DS.palette-marker;
    }
}

// A suggested placement: a solid `guideFaint` hairline and a 5 pt wedge at its foot.
component Suggestion inherits Rectangle {
    width: 10px;
    Rectangle { x: 4.5px; width: 1px; background: DS.palette-guide-faint; }
    Path {
        y: parent.height - 5px;
        width: 10px;
        height: 5px;
        viewbox-width: 10;
        viewbox-height: 5;
        fill: DS.palette-guide-faint;
        commands: "M 0 5 L 10 5 L 5 0 Z";
    }
}

// `HistogramTraces`, 480×96: the luminance as a colourless backdrop, then red, green and blue (`plusLighter`
// in Swift, plain alpha here); `lit` 0-2 (Swift's `focus`) dims the two other channels to a fifth.
component Histogram inherits Rectangle {
    in property <int> lit: -1;
    width: 480px;
    height: 96px;
    property <float> r: root.lit >= 0 && root.lit != 0 ? 0.2 : 1;
    property <float> g: root.lit >= 0 && root.lit != 1 ? 0.2 : 1;
    property <float> b: root.lit >= 0 && root.lit != 2 ? 0.2 : 1;
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.luma; fill: #ffffff1f; stroke: #ffffff73; stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.red; fill: rgba(255, 69, 58, 0.28 * root.r); stroke: rgba(255, 69, 58, 0.85 * root.r); stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.green; fill: rgba(50, 215, 75, 0.28 * root.g); stroke: rgba(50, 215, 75, 0.85 * root.g); stroke-width: 1px; }
    Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.blue; fill: rgba(10, 132, 255, 0.28 * root.b); stroke: rgba(10, 132, 255, 0.85 * root.b); stroke-width: 1px; }
}

// `LevelsView` on the DS `Plot` and `LevelsTrack`, its grips held here as Rust holds them in the app: a
// press within a grab catches a handle, dragged from where it was caught; a second press rests it.
component LiveLevels inherits VerticalLayout {
    in-out property <float> black: 0;
    in-out property <float> shadows: 0.25;
    in-out property <float> mid: 0.5;
    in-out property <float> highlights: 0.75;
    in-out property <float> white: 1;
    in property <bool> suggest;
    in property <int> lit: -1;
    property <length> span: 480px;
    property <int> held: -1;
    property <length> caught;
    property <float> start;
    property <int> last-grip: -1;
    property <duration> last: -1s;
    pure function at(i: int) -> float {
        i == 0 ? root.black : i == 1 ? root.shadows : i == 2 ? root.mid : i == 3 ? root.highlights : root.white
    }
    // `LevelsView.grip(at:)`: the handle under the pointer, read front to back; -1 for none.
    pure function grip(x: length) -> int {
        abs(root.white * root.span - x) <= SliderStyle.grab / 2 ? 4
            : abs(root.black * root.span - x) <= SliderStyle.grab / 2 ? 0
            : abs(root.highlights * root.span - x) <= SliderStyle.grab / 2 ? 3
            : abs(root.mid * root.span - x) <= SliderStyle.grab / 2 ? 2
            : abs(root.shadows * root.span - x) <= SliderStyle.grab / 2 ? 1 : -1
    }
    pure function nearest(x: length) -> int {
        root.grip(x) >= 0 ? root.grip(x)
            : x < (root.black + root.shadows) * root.span / 2 ? 0
            : x < (root.shadows + root.mid) * root.span / 2 ? 1
            : x < (root.mid + root.highlights) * root.span / 2 ? 2
            : x < (root.highlights + root.white) * root.span / 2 ? 3 : 4
    }
    function set(i: int, v: float) {
        if (i == 0) { root.black = clamp(v, 0, root.shadows); }
        else if (i == 1) { root.shadows = clamp(v, root.black, root.mid); }
        else if (i == 2) { root.mid = clamp(v, root.shadows, root.highlights); }
        else if (i == 3) { root.highlights = clamp(v, root.mid, root.white); }
        else { root.white = clamp(v, root.highlights, 1); }
    }
    padding-left: SliderStyle.knob-width / 2;
    padding-right: SliderStyle.knob-width / 2;
    spacing: 2px;
    Plot {
        width: root.span;
        height: 96px;
        interactive: false;
        Histogram { lit: root.lit; }
        for m in [root.black, root.shadows, root.mid, root.highlights, root.white]: Marker {
            x: m * root.span - 0.5px;
        }
        for m in root.suggest ? [0.06, 0.3, 0.52, 0.7, 0.93] : []: Suggestion {
            x: m * root.span - 5px;
        }
    }
    LevelsTrack {
        width: root.span;
        // Drawn in `LevelsView`'s order, the ends last, on top.
        knobs: [
            { x: root.shadows * root.span, ink: Ink.grey-quarter, held: root.held == 1, label: "Shadows" },
            { x: root.mid * root.span, ink: Ink.grey-half, held: root.held == 2, label: "Mid" },
            { x: root.highlights * root.span, ink: Ink.grey-three-quarters, held: root.held == 3, label: "Highs" },
            { x: root.black * root.span, ink: Ink.black, held: root.held == 0, label: "Black" },
            { x: root.white * root.span, ink: Ink.white, held: root.held == 4, label: "White" },
        ];
        pointer(p, kind, x, y, alt) => {
            if (kind == 0) {
                let g = root.grip(x);
                if (g >= 0 && g == root.last-grip && animation-tick() - root.last < 400ms) {
                    root.set(g, [0, 0.25, 0.5, 0.75, 1][g]);
                    root.last = -1s;
                } else if (g >= 0) {
                    root.held = g;
                    root.caught = x;
                    root.start = root.at(g);
                    root.last = animation-tick();
                    root.last-grip = g;
                }
            } else if (kind == 1 && root.held >= 0) {
                root.set(root.held, root.start + (x - root.caught) / root.span);
            } else if (kind == 2 || kind == 3) {
                root.held = -1;
            }
        }
        // `DSScrollAdjust` over the track: a swipe moves the handle under the pointer, else the nearest.
        scrolled(p, x, dx, dy, alt) => {
            if (dx != 0 && abs(dx) > abs(dy)) {
                let g = root.nearest(x);
                root.set(g, root.at(g) + dx * 0.25 / root.span);
                return true;
            }
            return false;
        }
    }
    HorizontalLayout {
        width: root.span;
        Text { text: "Black " + root.black.to-fixed(2); color: DS.system-tertiary; font-size: 11px; }
        Text { text: "Shadows " + root.shadows.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "Mid " + root.mid.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "Highs " + root.highlights.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: center; }
        Text { text: "White " + root.white.to-fixed(2); color: DS.system-tertiary; font-size: 11px; horizontal-alignment: right; }
    }
}

// The playground's knob specimen: the DS knob on a 52 pt cyan → red rail.
component KnobSpecimen inherits Rectangle {
    in property <color> tint: DS.palette-keycap;
    in property <bool> grown;
    in property <bool> vertical;
    width: 64px;
    height: SliderStyle.knob-height + 6px;
    Rail {
        vertical: root.vertical;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.vertical ? SliderStyle.track : 52px;
        height: root.vertical ? parent.height : SliderStyle.track;
        fill: SliderFill.bipolar;
        low: #40c8e0;
        high: #ff453a;
    }
    Knob {
        vertical: root.vertical;
        centre: root.vertical ? parent.height / 2 : parent.width / 2;
        across: root.vertical ? parent.width : parent.height;
        fill: root.tint;
        grown: root.grown;
    }
}

export component SlidersPage inherits Rectangle {
    background: DS.palette-panel;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 34px;
            alignment: start;

            // The page's tunables, in three columns.
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                VerticalLayout {
                    width: 300px;
                    Heading { text: "TRACK"; }
                    LengthTune { label: "track height"; minimum: 4; maximum: 24; value <=> SliderStyle.track; }
                    LengthTune { label: "track radius"; maximum: 12; value <=> SliderStyle.track-radius; }
                    Tune { label: "edge"; value <=> SliderStyle.edge; }
                    Tune { label: "rim"; value <=> SliderStyle.rim; }
                    LengthTune { label: "rim blur"; maximum: 4; value <=> SliderStyle.rim-blur; }
                    LengthTune { label: "rim drop"; maximum: 4; value <=> SliderStyle.rim-drop; }
                }
                VerticalLayout {
                    width: 300px;
                    Heading { text: "KNOB"; }
                    LengthTune { label: "thickness"; minimum: 8; maximum: 48; value <=> SliderStyle.knob-width; }
                    LengthTune { label: "length"; minimum: 14; maximum: 60; value <=> SliderStyle.knob-height; }
                    Tune { label: "key scale"; minimum: 0.2; maximum: 1; value <=> SliderStyle.knob-factor; }
                    Tune { label: "grow"; minimum: 1; maximum: 1.4; value <=> SliderStyle.knob-grow; }
                    LengthTune { label: "grip line"; maximum: 24; value <=> SliderStyle.grip; }
                    LengthTune { label: "grip gap"; maximum: 12; value <=> SliderStyle.grip-gap; }
                    LengthTune { label: "step key"; minimum: 20; maximum: 56; value <=> SliderStyle.step-key; }
                    LengthTune { label: "step legend"; minimum: 9; maximum: 28; value <=> SliderStyle.step-legend; }
                }
                VerticalLayout {
                    width: 300px;
                    Heading { text: "MOTION, PLOT"; }
                    TimeTune { label: "rise ms"; maximum: 400; value <=> SliderStyle.rise; }
                    TimeTune { label: "settle ms"; maximum: 1000; value <=> SliderStyle.settle; }
                    LengthTune { label: "plot radius"; maximum: 24; value <=> PlotStyle.radius; }
                    Tune { label: "grid"; maximum: 0.5; value <=> PlotStyle.grid; }
                }
            }

            Row {
                title: "DSSLIDER";
                source: "DSSlider.swift:18 (DSRail :188, dsRecessed :252) · DSPlayground.swift:328";
                VerticalLayout {
                    width: 308px;
                    spacing: 16px;
                    alignment: start;
                    LiveSlider { label: "Amount"; amount: 0.4; base: 0.4; percent: true; }
                    LiveSlider { label: "Cyan ↔ Red"; amount: 0; minimum: -1; maximum: 1; fill: SliderFill.bipolar; low: #40c8e0; high: #ff453a; unit: " st"; }
                    LiveSlider { label: "Denoise"; amount: 0.25; fill: SliderFill.ramp; tint: DS.tint-chroma; percent: true; }
                    LiveSlider { label: "Chrome"; amount: 0.6; fill: SliderFill.metal; percent: true; }
                    Caption { text: "live: drag, ⌥ for a fifth, double-click to reset, swipe sideways"; horizontal-alignment: left; }
                }
                VerticalLayout {
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "rest"; LiveSlider { width: 200px; label: "Amount"; amount: 0.4; percent: true; } }
                        Specimen { name: "hover (knob ×1.07)"; LiveSlider { width: 200px; label: "Amount"; amount: 0.4; percent: true; look: Look.hover; } }
                        Specimen { name: "dragging"; LiveSlider { width: 200px; label: "Amount"; amount: 0.62; percent: true; look: Look.pressed; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "disabled (words at 0.4)"; LiveSlider { width: 200px; label: "Amount"; amount: 0.4; percent: true; enabled: false; } }
                        Specimen { name: "fill at 0"; LiveSlider { width: 200px; label: "Amount"; amount: 0; percent: true; } }
                        Specimen { name: "fill at 1"; LiveSlider { width: 200px; label: "Amount"; amount: 1; percent: true; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "bipolar at zero"; LiveSlider { width: 200px; label: "Cyan ↔ Red"; amount: 0; minimum: -1; maximum: 1; fill: SliderFill.bipolar; low: #40c8e0; high: #ff453a; unit: " st"; } }
                        Specimen { name: "bipolar, low side"; LiveSlider { width: 200px; label: "Cyan ↔ Red"; amount: -0.6; minimum: -1; maximum: 1; fill: SliderFill.bipolar; low: #40c8e0; high: #ff453a; unit: " st"; } }
                        Specimen { name: "bipolar, high side"; LiveSlider { width: 200px; label: "Cyan ↔ Red"; amount: 0.6; minimum: -1; maximum: 1; fill: SliderFill.bipolar; low: #40c8e0; high: #ff453a; unit: " st"; } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        Specimen { name: "tinted ramp 0.45 → 0.9"; LiveSlider { width: 200px; label: "Denoise"; amount: 0.7; fill: SliderFill.ramp; tint: DS.tint-chroma; percent: true; } }
                        Specimen { name: "metal"; LiveSlider { width: 200px; label: "Chrome"; amount: 0.7; fill: SliderFill.metal; percent: true; } }
                        Specimen { name: "knob carrying its value"; LiveSlider { width: 200px; label: "Tint"; amount: 0.3; fill: SliderFill.bipolar; low: #32d74b; high: #d63380; knob: #d63380; percent: true; } }
                    }
                    Caption { text: "Swift's bipolar rail has no progressive fill: the gradient is the whole bar and the knob reads the balance."; horizontal-alignment: left; }
                }
            }

            Row {
                title: "DSSLIDER, VERTICAL";
                source: "DSSlider.swift:144 (centre, flipped) · DSPlayground.swift:340";
                HorizontalLayout {
                    spacing: 24px;
                    height: 180px;
                    UprightSlider { width: 130px; label: "Amount"; value: 0.4; base: 0.4; percent: true; }
                    UprightSlider { width: 130px; label: "Cyan ↔ Red"; value: 0; minimum: -1; maximum: 1; spectrum: true; unit: " st"; }
                }
            }

            Row {
                title: "DSBARHANDLE";
                source: "DSHandle.swift:27 (KeycapStyle.hardened × Variant.small 0.525) · DSPlayground.swift:493";
                Specimen { name: "rest"; KnobSpecimen { } }
                Specimen { name: "hover"; KnobSpecimen { grown: true; } }
                Specimen { name: "grab"; KnobSpecimen { grown: true; } }
                Specimen { name: "black"; KnobSpecimen { tint: #000000; } }
                Specimen { name: "white, grabbed"; KnobSpecimen { tint: #ffffff; grown: true; } }
                Specimen { name: "vertical"; KnobSpecimen { vertical: true; height: 52px; } }
                Specimen {
                    name: "×4, to read the chrome";
                    Rectangle {
                        width: 120px;
                        height: 150px;
                        Keycap {
                            x: (parent.width - self.width) / 2;
                            width: 96px;
                            height: 136px;
                            factor: SliderStyle.knob-factor * 4;
                            level: true;
                            shadow: false;
                            rim: false;
                            edge-width: 1px;
                            edge-color: SliderStyle.knob-edge.with-alpha(SliderStyle.edge);
                        }
                    }
                }
            }

            Row {
                title: "DSHANDLE";
                source: "DSHandle.swift:5 (the curve point) · DSPlayground.swift:363";
                Specimen { name: "rest"; CurvePoint { } }
                Specimen { name: "active"; CurvePoint { active: true; } }
                Specimen { name: "active, tinted"; CurvePoint { active: true; tint: DS.tint-chroma; } }
            }

            Row {
                title: "STEPPED SLIDER";
                source: "the Rust app's ds/slider.slint:120 (Scanner letters) · keys from LabKeyboard.swift:107";
                VerticalLayout {
                    width: 308px;
                    spacing: 16px;
                    alignment: start;
                    LiveStepped { label: "C"; low: #d6403a; high: #1fa8c7; amount: 0; }
                    LiveStepped { label: "D"; amount: 3; low: rgb(71, 71, 77); high: rgb(219, 219, 214); }
                    Caption { text: "live: press or drag the rail, click a key (⇧ for three), double-click the name"; horizontal-alignment: left; }
                }
                Specimen { name: "at rest (ticked)"; LiveStepped { width: 220px; label: "M"; amount: 0; low: rgb(46, 163, 122); high: rgb(214, 51, 128); } }
                Specimen { name: "hover, low side"; LiveStepped { width: 220px; label: "Y"; amount: -4; low: rgb(56, 92, 214); high: rgb(237, 199, 46); look: Look.hover; } }
            }

            Row {
                title: "LABSTEPKEYS";
                source: "LabKeyboard.swift:132 (LabStack :117, band :100) · ColorPane.swift:121";
                VerticalLayout {
                    spacing: 6px;
                    contrast := StepKeyRow { width: 308px; title: "CONTRAST"; value: 0; }
                    Caption { text: "live: CONTRAST " + round(contrast.value * 100) + " %"; horizontal-alignment: left; }
                }
                Specimen { name: "title key pressed"; StepKeyRow { width: 308px; title: "VIGNETTE"; force-press: true; minus-fill: rgb(219, 219, 214); plus-fill: rgb(71, 71, 77); } }
            }

            Row {
                title: "LEVELS TRACK";
                source: "LevelsView.swift:96 (DSTrackHandle, DSHandle.swift:114) · grips :124";
                VerticalLayout {
                    spacing: 6px;
                    LiveLevels { }
                    Caption { text: "live: drag a handle, double-click to rest, swipe sideways over the track"; horizontal-alignment: left; }
                }
                Specimen { name: "suggestions shown, green focused"; LiveLevels { black: 0.08; shadows: 0.3; mid: 0.47; highlights: 0.72; white: 0.9; suggest: true; lit: 1; } }
            }

            Row {
                title: "DSPLOTSCREEN";
                source: "DSPlotScreen.swift:13 (dsRecessed at the card radius) · DSPlayground.swift:386";
                Specimen {
                    name: "plot screen, quarters engraved";
                    Plot {
                        width: 480px;
                        height: 96px;
                        interactive: false;
                        Path { viewbox-width: 480; viewbox-height: 96; commands: Plots.curve; stroke: DS.palette-selected; stroke-width: 1.5px; }
                    }
                }
                Specimen {
                    name: "no grid (Spectrogram)";
                    Plot { width: 160px; height: 96px; grid: false; interactive: false; }
                }
            }

            Row {
                title: "DSHISTOGRAM, ALONE";
                source: "DSHistogram.swift:207 (on the panel, no screen) · DSPlayground.swift:468";
                Specimen {
                    name: "DSHistogram alone, markers 0.15 · 0.5 · 0.9";
                    Plot {
                        width: 480px;
                        height: 96px;
                        screen: false;
                        grid: false;
                        interactive: false;
                        Histogram { }
                        Marker { x: 0.15 * 480px; }
                        Marker { x: 0.5 * 480px; }
                        Marker { x: 0.9 * 480px; }
                    }
                }
            }

            Row {
                title: "DSSCROLLADJUST";
                source: "DSScrollAdjust.swift:30";
                Text {
                    text: "No look of its own: an invisible catcher for the wheel. Every live track above takes it: a sideways\ntwo-finger swipe moves 0.25 pt a point, a swipe across the track is left to the page, 0.16 s of quiet ends it.";
                    color: DS.system-secondary;
                    font-size: 11px;
                }
            }
        }
    }
}
