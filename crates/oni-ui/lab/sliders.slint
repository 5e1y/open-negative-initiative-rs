// The lab's Sliders page: Slint copies of the Swift app's 2.5D sliders, built on depth.slint.
// The rail and the plot screen sink with `Inward`; the knob and the step keys are `Keycap`'s frustum, scaled small.
import { Slider, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { Keycap, Outward, Inward, Depth } from "depth.slint";

// This page's own tunables, the Swift numbers as defaults.
export global SliderLook {
    // `DS.Control.trackHeight` 14, `DS.Radius.track` 6.
    in-out property <float> track: 14;
    in-out property <float> track-radius: 6;
    // `DS.Control.handleThickness` 24 along the travel, `handleLength` 34 across it.
    in-out property <float> knob-thickness: 24;
    in-out property <float> knob-length: 34;
    // `Keycap.Variant.small.factor` 0.525: the knob is a small key.
    in-out property <float> knob-scale: 0.525;
    // `DS.Control.knobGrow` 1.07 under the hand; `knobLine` 12, `knobLineGap` 4.
    in-out property <float> knob-grow: 1.07;
    in-out property <float> grip-line: 12;
    in-out property <float> grip-gap: 4;
    // The 1 pt `trackLine` edge (black) round the rail and the knob, as an opacity.
    in-out property <float> edge: 1;
    // `dsRecessed`'s lit lower rim outside the hollow: `rim` white 0.4, blur 0.7, drop 1.
    in-out property <float> rim: 0.4;
    in-out property <float> rim-blur: 0.7;
    in-out property <float> rim-drop: 1;
    // `DS.Motion.rise` (response 0.11, damping 0.62) and `settle` (0.38, 0.72), as durations in ms.
    in-out property <float> rise-ms: 120;
    in-out property <float> settle-ms: 380;
    // `DS.Radius.card` 12 for a plot screen; its quarter lines' opacity (`separator`, primary 0.12).
    in-out property <float> plot-radius: 12;
    in-out property <float> grid: 0.12;
}

