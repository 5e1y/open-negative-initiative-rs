// The lab's Sliders page: the design system's sliders and plots (ui/ds/slider.slint, ui/ds/plots.slint)
// in their states, driven here as Rust drives them in the app; the tunables move the DS's own styles live.
import { Slider as Tuner, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { SliderStyle, PlotStyle } from "../ui/ds/theme.slint";
import { Look } from "../ui/ds/button.slint";
import { Slider, SliderFill, Knob, Rail } from "../ui/ds/slider.slint";
import { Plot, LevelsTrack, CurvePoint, Ink } from "../ui/ds/plots.slint";
import { Keycap, Depth } from "depth.slint";

