// The lab's Tabs page: the design system's selection controls, live beside their forced states.
// Tab bar, toggle, picker and medal picker are the app's own (ui/ds); the tunables move the DS live.
import { Slider, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { Tabs, Toggle, Picker, Look, MedalPicker, Medal } from "../ui/ds/ds.slint";
import { TabsStyle, MedalStyle } from "../ui/ds/theme_tabs.slint";

// One tunable, as lab.slint's `Tune`.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 110px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 40px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

// A tab bar that writes its own choice, as its owner would.
component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> selected;
    in property <[bool]> marked;
    in property <[bool]> dimmed;
    in property <[color]> swatches;
    in property <int> force-hover: -1;
    height: TabsStyle.height;
    Tabs {
        tabs: root.tabs;
        selected: root.selected;
        marked: root.marked;
        dimmed: root.dimmed;
        swatches: root.swatches;
        hover-tab: root.force-hover;
        picked(i) => { root.selected = i; }
    }
}

component LiveToggle inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> on;
    in property <bool> enabled: true;
    Toggle { label: root.label; on: root.on; enabled: root.enabled; toggled(v) => { root.on = v; } }
}

component LivePicker inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> selected;
    in property <Look> look: Look.live;
    Picker {
        value: root.options[root.selected];
        entries: root.options;
        current: root.selected;
        look: root.look;
        chosen(i) => { root.selected = i; }
    }
}

component LiveMedals inherits HorizontalLayout {
    in-out property <int> current: -1;
    in property <int> force-pressed: -1;
    alignment: start;
    MedalPicker {
        current: root.current;
        pressed-rank: root.force-pressed;
        picked(m) => { root.current = root.current == m ? -1 : m; }
    }
}

component Caption inherits Text {
    color: #ffffff73;
    font-size: 10px;
}

// One forced state over its caption.
component Specimen inherits VerticalLayout {
    in property <string> caption;
    spacing: 6px;
    alignment: start;
    @children
    Caption { text: root.caption; }
}

// One element: its name and Swift source, then its live instance over its forced states.
component Row inherits HorizontalLayout {
    in property <string> name;
    in property <string> source;
    spacing: 32px;
    alignment: start;
    VerticalLayout {
        width: 200px;
        spacing: 4px;
        alignment: start;
        Text { text: root.name; color: #ffffffcc; font-size: 12px; font-weight: 600; }
        Caption { text: root.source; wrap: word-wrap; }
    }
    VerticalLayout {
        spacing: 20px;
        alignment: start;
        @children
    }
}

component States inherits HorizontalLayout {
    spacing: 24px;
    alignment: start;
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

export component TabsPage inherits Rectangle {
    background: DS.palette-panel;
    property <[string]> panel: ["Roll", "Crop", "Color", "Details"];
    property <[string]> three: ["Roll", "Crop", "Color"];
    property <[string]> spaces: ["sRGB", "DP3", "Adobe RGB", "ProPhoto", "Custom"];
    property <[string]> channels: ["Luma", "RGB", "R", "G", "B"];
    property <[color]> bands: [hsv(0, 0.85, 1), hsv(30, 0.85, 1), hsv(60, 0.85, 1), hsv(120, 0.85, 1),
        hsv(180, 0.85, 1), hsv(240, 0.85, 1), hsv(270, 0.85, 1), hsv(300, 0.85, 1)];
    property <[string]> band-names: ["Red", "Orange", "Yellow", "Green", "Aqua", "Blue", "Purple", "Magenta"];
    property <[string]> profiles: ["Display P3", "sRGB", "Adobe RGB (1998)", "Epson SureColor P900 · Premium Luster"];
    ScrollView {
        VerticalLayout {
            padding: 32px;
            spacing: 36px;
            alignment: start;
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                VerticalLayout {
                    width: 300px;
                    spacing: 2px;
                    Heading { text: "MOTION"; }
                    Tune { label: "slide ms (grab)"; minimum: 60; maximum: 600; value <=> TabsStyle.slide-ms; }
                    Tune { label: "medal press"; minimum: 0.6; value <=> MedalStyle.press; }
                }
                VerticalLayout {
                    width: 300px;
                    spacing: 2px;
                    Heading { text: "PILL & LABELS"; }
                    Tune { label: "pill tone"; maximum: 0.5; value <=> TabsStyle.pill-tone; }
                    Tune { label: "track shade"; value <=> TabsStyle.track-shade; }
                    Tune { label: "idle label"; value <=> TabsStyle.idle; }
                }
                VerticalLayout {
                    width: 300px;
                    spacing: 2px;
                    Heading { text: "FOIL"; }
                    Tune { label: "foil spin"; maximum: 1.5; value <=> MedalStyle.foil-spin; }
                }
            }

            Row {
                name: "DSTabBar · panel tabs";
                source: "DSTabBar.swift:5 · EditorScene+Panel.swift:51";
                TabBar { width: DS.control-panel-width - 2 * DS.space-md; tabs: root.panel; selected: 2; }
                States {
                    Specimen { caption: "rest"; TabBar { width: 200px; tabs: root.three; selected: 0; } }
                    Specimen { caption: "hover (Crop)"; TabBar { width: 200px; tabs: root.three; selected: 0; force-hover: 1; } }
                    Specimen { caption: "selected (Color)"; TabBar { width: 200px; tabs: root.three; selected: 2; } }
                }
            }

            Row {
                name: "DSTabBar · marks";
                source: "DSTabBar.swift:71 · LevelsView.swift:63, CurveEditorView.swift:111";
                TabBar {
                    width: DS.control-panel-width - 2 * DS.space-md;
                    tabs: root.channels;
                    selected: 1;
                    marked: [false, true, false, false, true];
                }
                States {
                    Specimen { caption: "marked, unselected"; TabBar { width: 200px; tabs: ["RGB", "R", "G"]; selected: 0; marked: [false, true, false]; } }
                    Specimen { caption: "marked, selected"; TabBar { width: 200px; tabs: ["RGB", "R", "G"]; selected: 1; marked: [false, true, false]; } }
                }
            }

            Row {
                name: "DSTabBar · dimmed";
                source: "DSTabBar.swift:88 · ExportSpaceField.swift:152 (ProPhoto in JPEG, in the 400 pt popover)";
                TabBar {
                    width: DS.control-export-panel-width - 2 * DS.space-md;
                    tabs: root.spaces;
                    selected: 0;
                    dimmed: [false, false, false, true, false];
                }
                States {
                    Specimen { caption: "dimmed"; TabBar { width: 200px; tabs: ["sRGB", "DP3", "ProPhoto"]; selected: 0; dimmed: [false, false, true]; } }
                    Specimen { caption: "dimmed, hover"; TabBar { width: 200px; tabs: ["sRGB", "DP3", "ProPhoto"]; selected: 0; dimmed: [false, false, true]; force-hover: 2; } }
                    Specimen { caption: "dimmed, selected"; TabBar { width: 200px; tabs: ["sRGB", "DP3", "ProPhoto"]; selected: 2; dimmed: [false, false, true]; } }
                }
            }

            Row {
                name: "DSTabBar · swatches";
                source: "DSTabBar.swift:60 · SpectrogramBands.swift:13";
                TabBar {
                    width: DS.control-panel-width - 2 * DS.space-md;
                    tabs: root.band-names;
                    swatches: root.bands;
                    selected: 0;
                    marked: [false, false, true, false, false, true, false, false];
                }
                States {
                    Specimen { caption: "rest"; TabBar { width: 200px; tabs: ["Red", "Orange", "Yellow", "Green"]; swatches: [root.bands[0], root.bands[1], root.bands[2], root.bands[3]]; selected: 0; } }
                    Specimen { caption: "hover (Yellow), marked (Green)"; TabBar { width: 200px; tabs: ["Red", "Orange", "Yellow", "Green"]; swatches: [root.bands[0], root.bands[1], root.bands[2], root.bands[3]]; selected: 0; force-hover: 2; marked: [false, false, false, true]; } }
                }
            }

            Row {
                name: "DSTabBar · faces";
                source: "DSTabBar.swift:5 · EditorScene+Bar.swift:87 (modeBarWidth 232)";
                TabBar { width: DS.control-mode-bar-width; tabs: ["Pro", "Scanner"]; selected: 0; }
                States {
                    Specimen { caption: "Pro"; TabBar { width: DS.control-mode-bar-width; tabs: ["Pro", "Scanner"]; selected: 0; } }
                    Specimen { caption: "Scanner, hover Pro"; TabBar { width: DS.control-mode-bar-width; tabs: ["Pro", "Scanner"]; selected: 1; force-hover: 0; } }
                }
            }

            Row {
                name: "DSToggle";
                source: "DSToggle.swift:5 · ExportSurface.swift:278, GeometryPanel.swift:22";
                VerticalLayout {
                    spacing: DS.space-sm;
                    alignment: start;
                    LiveToggle { label: "ZIP, lossless"; on: false; }
                    LiveToggle { label: "Brighter on HDR screens"; on: true; }
                    LiveToggle { label: "Unavailable for TIFF"; enabled: false; }
                }
                States {
                    Specimen { caption: "off"; LiveToggle { on: false; } }
                    Specimen { caption: "on"; LiveToggle { on: true; } }
                    Specimen { caption: "disabled, off"; LiveToggle { on: false; enabled: false; } }
                    Specimen { caption: "disabled, on"; LiveToggle { on: true; enabled: false; } }
                }
            }

            Row {
                name: "DSPicker · the menu face";
                source: "DSPicker.swift:6, 36 (DSPickerStyle) · ExportSpaceField.swift:179, FlatFieldControls.swift:36";
                LivePicker { width: DS.control-panel-width - 2 * DS.space-md; options: root.profiles; selected: 0; }
                States {
                    Specimen { caption: "rest"; LivePicker { width: 200px; options: root.profiles; selected: 1; } }
                    Specimen { caption: "hover"; LivePicker { width: 200px; options: root.profiles; selected: 1; look: Look.hover; } }
                    Specimen { caption: "pressed"; LivePicker { width: 200px; options: root.profiles; selected: 1; look: Look.pressed; } }
                }
            }

            Row {
                name: "DSMedalPicker";
                source: "DSMedalPicker.swift:31 · DSMedal :3, DSFoil.medal · EditorScene+Card.swift:210";
                LiveMedals { current: 3; }
                States {
                    Specimen { caption: "none (mixed)"; LiveMedals { current: -1; } }
                    Specimen { caption: "bronze"; LiveMedals { current: 1; } }
                    Specimen { caption: "silver"; LiveMedals { current: 2; } }
                    Specimen { caption: "gold"; LiveMedals { current: 3; } }
                    Specimen { caption: "pressed silver"; LiveMedals { current: 3; force-pressed: 2; } }
                    Specimen {
                        caption: "×8, to judge the foil";
                        HorizontalLayout {
                            spacing: 32px;
                            Medal { rank: 1; size: 96px; }
                            Medal { rank: 2; size: 96px; }
                            Medal { rank: 3; size: 96px; }
                        }
                    }
                }
            }
        }
    }
}
