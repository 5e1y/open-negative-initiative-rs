// The lab's Fields page: the design system's own text fields (`dsTextField`, `DSField`), each a hollow
// floored in the canvas on depth.slint's `Inward`, live beside its states forced through the DS's props.
import { Slider, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { TextField, Field, FieldLayout, SizeFields, DateFields, TextRole } from "../ui/ds/ds.slint";
import { Depth } from "depth.slint";

// One tunable, as lab.slint's `Tune`.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 90px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 34px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

component Caption inherits Text {
    color: #ffffff59;
    font-size: 10px;
    wrap: word-wrap;
}

// A specimen: the element on top, its caption under it.
component Specimen inherits VerticalLayout {
    in property <string> caption;
    in property <length> cell: 140px;
    width: root.cell;
    spacing: 6px;
    alignment: start;
    @children
    Caption { text: root.caption; }
}

// One row of the sheet: its name and Swift source, then the live instance and its forced states.
component Row inherits VerticalLayout {
    in property <string> name;
    in property <string> source;
    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Heading { text: root.name; vertical-alignment: center; }
        Caption { text: root.source; vertical-alignment: center; wrap: no-wrap; }
    }
    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        @children
    }
}

export component FieldsPage inherits Rectangle {
    background: DS.palette-panel;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 28px;
            alignment: start;

            // The hollow's depth tunables; its gauges are the DS's `FieldStyle`.
            Rectangle {
                background: DS.palette-canvas;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 20px;
                    VerticalLayout {
                        alignment: start;
                        Heading { text: "EDGES"; }
                        Tune { label: "edge"; value <=> Depth.well-edge; }
                        Tune { label: "lip soft"; value <=> Depth.well-lip-soft; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Heading { text: "WELL (DEPTH)"; }
                        Tune { label: "shade"; value <=> Depth.well-shade; }
                        Tune { label: "lip"; maximum: 0.3; value <=> Depth.well-lip; }
                    }
                }
            }

            Row {
                name: "SINGLE LINE";
                source: "DSTextField.swift:6 · PresetEditor.swift:81 · DSDialog.swift:64 · InfoSidebar.swift:210";
                Specimen { cell: 240px; caption: "live: click and type"; TextField { placeholder: "Preset name"; } }
                Specimen { caption: "rest, empty"; TextField { placeholder: "Preset name"; } }
                Specimen { caption: "hover = rest (Swift draws none, the I-beam only)"; TextField { placeholder: "Preset name"; } }
                Specimen { caption: "focused: the rim ring"; TextField { placeholder: "Preset name"; focused-look: true; } }
                Specimen { caption: "filled"; TextField { value: "Portra warm"; } }
                Specimen { caption: "disabled: the text fades, the chrome stays"; TextField { value: "Portra warm"; enabled: false; } }
            }

            Row {
                name: "WARNING";
                source: "ReportSheet.swift:49 · no error chrome on the field: the failure is said beneath it";
                Specimen {
                    cell: 320px;
                    caption: "live field, then the failure in DS.Palette.warning (VStack DS.Space.md)";
                    VerticalLayout {
                        spacing: DS.space-md;
                        TextField { placeholder: "e.g. Leica M6"; }
                        Text { text: "The report could not be sent: no connection."; font-size: DS.typo-label-size; color: DS.palette-warning; wrap: word-wrap; }
                    }
                }
            }

            Row {
                name: "SEARCH / FILTER";
                source: "PaperProfilesSheet.swift:130 · the same field, no glass icon";
                Specimen { cell: 240px; caption: "live"; TextField { placeholder: "Filter, e.g. P900 matte"; } }
                Specimen { caption: "filled, focused"; TextField { value: "P900"; focused-look: true; } }
            }

            Row {
                name: "MULTILINE";
                source: "DSTextField.swift:24 · PresetEditor.swift:87 (3 lines reserved) · InfoSidebar.swift:101 (TextEditor 60) · ReportSheet.swift:40";
                Specimen {
                    cell: 240px;
                    caption: "live, TextField axis vertical, lineLimit 3 reserved";
                    TextField { multiline: true; lines-height: 3 * DS.typo-label-size * 1.25; placeholder: "What this look is for"; }
                }
                Specimen {
                    cell: 240px;
                    caption: "live, TextEditor framed 60 tall";
                    TextField { multiline: true; lines-height: DS.control-project-description-height; }
                }
                Specimen {
                    caption: "filled, focused";
                    TextField { multiline: true; lines-height: 3 * DS.typo-label-size * 1.25; focused-look: true; value: "Warm skin, soft greens, for overcast days."; }
                }
                Specimen {
                    caption: "disabled";
                    TextField { multiline: true; lines-height: 3 * DS.typo-label-size * 1.25; enabled: false; value: "Warm skin, soft greens, for overcast days."; }
                }
            }

            Row {
                name: "RENAME";
                source: "GalleryView.swift:265 RenameField · TreeEngine.swift:384 (row) · GalleryView.swift:300, InfoSidebar.swift:228 (title)";
                Specimen {
                    cell: 240px;
                    caption: "live, a row's name, DS.Typo.label in a 32 row";
                    TextField { value: "Roll #8"; }
                }
                Specimen {
                    cell: 240px;
                    caption: "live, a roll title, DS.Typo.title, led by -DS.Space.md so the text stays put (RenameField's outdent)";
                    TextField { role: TextRole.title; value: "Roll #8"; }
                }
                Specimen { caption: "focused, as entered"; TextField { role: TextRole.title; value: "Roll #8"; focused-look: true; } }
            }

            Row {
                name: "NUMERIC: SIZE";
                source: "ExportSurface.swift:384 SizeFields · boxes DS.Control.exportSizeFieldWidth, DS.Typo.title, centred";
                Specimen { cell: 240px; caption: "live, one focus for the pair"; SizeFields { width-value: "6048"; height-value: "4032"; } }
                Specimen { cell: 200px; caption: "rest, empty"; SizeFields { } }
                Specimen { cell: 200px; caption: "focused"; SizeFields { width-value: "6048"; height-value: "4032"; focused-look: true; } }
                Specimen { cell: 200px; caption: "disabled"; SizeFields { width-value: "6048"; height-value: "4032"; enabled: false; } }
            }

            Row {
                name: "DATE BOXES";
                source: "InfoSidebar.swift:282 DateFields · DS.Control.dateFieldWidth, yearFieldWidth, DS.Typo.title";
                Specimen { cell: 200px; caption: "live, one focus for the three"; DateFields { month: "9"; day: "5"; year: "2026"; } }
                Specimen { cell: 180px; caption: "rest, empty"; DateFields { } }
                Specimen { cell: 180px; caption: "focused"; DateFields { month: "9"; day: "5"; year: "2026"; focused-look: true; } }
            }

            Row {
                name: "DSFIELD: LABEL ABOVE";
                source: "DSField.swift:4 · DSHelp.swift:9 · PresetEditor.swift:80";
                Specimen {
                    cell: 280px;
                    caption: "live, the label row above, DS.Space.xs";
                    Field { label: "Name"; TextField { placeholder: "Preset name"; } }
                }
                Specimen {
                    cell: 280px;
                    caption: "with its help mark";
                    Field { label: "Pass Order"; help: "The order the passes run in."; TextField { value: "Red, Green, Blue"; } }
                }
            }

            Row {
                name: "LABEL BESIDE";
                source: "ExportSurface.swift:102 FrameFields, :134 field · label DS.Control.exifLabelWidth, suffix in secondary";
                Specimen {
                    cell: 380px;
                    caption: "live, the EXIF block, DS.Space.xs between lines";
                    VerticalLayout {
                        spacing: DS.space-xs;
                        Field { layout: FieldLayout.column; label: "Name"; TextField { value: "Roll8_012"; suffix: ".jpg"; } }
                        Field { layout: FieldLayout.column; label: "Camera"; TextField { placeholder: "Leica M6"; } }
                        Field { layout: FieldLayout.column; label: "Lens"; TextField { placeholder: "Summicron 50 mm"; } }
                        Field { layout: FieldLayout.column; label: "ISO"; TextField { placeholder: "400"; } }
                        Field { layout: FieldLayout.column; label: "Date"; TextField { placeholder: "2026:09:05 10:00:00"; } }
                        Field { layout: FieldLayout.column; label: "Artist"; TextField { placeholder: "Your name"; } }
                        Field { layout: FieldLayout.column; label: "Copyright"; TextField { placeholder: "© 2026 Your name"; } }
                    }
                }
                Specimen {
                    cell: 380px;
                    caption: "disabled, as the block is while no frame is exportable";
                    VerticalLayout {
                        spacing: DS.space-xs;
                        Field { layout: FieldLayout.column; label: "Name"; TextField { value: "Roll8_012"; suffix: ".jpg"; enabled: false; } }
                        Field { layout: FieldLayout.column; label: "Camera"; TextField { value: "Nikon Z f"; enabled: false; } }
                        Field { layout: FieldLayout.column; label: "ISO"; TextField { placeholder: "400"; enabled: false; } }
                    }
                }
            }
        }
    }
}
