// The lab's Fields page: Slint copies of the Swift app's text fields (`dsTextField`, `DSField`), each a
// hollow floored in the canvas, built on depth.slint's `Inward`.
import { Slider, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { Icons } from "../ui/ds/icons.slint";
import { Keycap, Outward, Inward, Depth } from "depth.slint";

// The field chrome's own tunables, Swift's values as defaults (DSTextField.swift, DSSlider.swift:276).
export global FieldLook {
    // DS.Radius.card, DS.Control.fieldHeight, DS.Space.md across, DS.Space.sm down when multiline.
    in-out property <float> radius: 12;
    in-out property <float> height: 32;
    in-out property <float> pad-x: 16;
    in-out property <float> pad-y: 8;
    // AppKit's dark label, placeholder and disabled-control text alphas on white.
    in-out property <float> text-alpha: 0.85;
    in-out property <float> placeholder-alpha: 0.25;
    in-out property <float> disabled-alpha: 0.25;
}

// One tunable, as lab.slint's `Tune`.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 90px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 34px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

component Caption inherits Text {
    color: #ffffff59;
    font-size: 10px;
    wrap: word-wrap;
}

// `dsTextField`'s chrome (DSTextField.swift:18): the canvas floor, the recess, the edge, the lit rim
// below, and the ring while focused; children lie in the padded hollow.
component Well inherits Rectangle {
    in property <bool> multiline;
    in property <bool> ring;
    property <length> radius: FieldLook.radius * 1px;
    height: FieldLook.height * 1px;
    Inward {
        width: parent.width;
        height: parent.height;
        ground: DS.palette-canvas;
        radius: root.radius;
        hollow: true;
        lit: root.ring;
        HorizontalLayout {
            padding-left: FieldLook.pad-x * 1px;
            padding-right: FieldLook.pad-x * 1px;
            padding-top: root.multiline ? FieldLook.pad-y * 1px : 0;
            padding-bottom: root.multiline ? FieldLook.pad-y * 1px : 0;
            @children
        }
    }
}

// The words of a field and its placeholder, shown while the text is empty, focused or not, as SwiftUI does.
component Entry inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> font-size: DS.typo-label-size;
    in property <bool> multiline;
    in property <bool> centred;
    in property <bool> enabled: true;
    // False for a forced specimen: it shows its state and takes no focus.
    in property <bool> live: true;
    out property <bool> has-focus: input.has-focus;
    horizontal-stretch: 1;
    Text {
        width: parent.width;
        height: parent.height;
        visible: input.text == "";
        text: root.placeholder;
        font-size: root.font-size;
        color: rgba(255, 255, 255, root.enabled ? FieldLook.placeholder-alpha : FieldLook.disabled-alpha);
        vertical-alignment: root.multiline ? top : center;
        horizontal-alignment: root.centred ? center : left;
        overflow: elide;
    }
    input := TextInput {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled && root.live;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        font-size: root.font-size;
        color: rgba(255, 255, 255, root.enabled ? FieldLook.text-alpha : FieldLook.disabled-alpha);
        selection-background-color: #3f638bff;
        vertical-alignment: root.multiline ? top : center;
        horizontal-alignment: root.centred ? center : left;
    }
}

// `TextField(...).dsTextField(focused:)`: one entry in its hollow, a suffix such as ".jpg" at its end.
component Field inherits Well {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> font-size: DS.typo-label-size;
    in property <bool> enabled: true;
    in property <bool> live: true;
    in property <bool> force-focus;
    in property <string> suffix;
    ring: entry.has-focus || root.force-focus;
    entry := Entry {
        text <=> root.text;
        placeholder: root.placeholder;
        font-size: root.font-size;
        multiline: root.multiline;
        enabled: root.enabled;
        live: root.live;
    }
    if root.suffix != "": Text {
        text: root.suffix;
        font-size: DS.typo-label-size;
        color: DS.palette-text-secondary;
        vertical-alignment: center;
    }
}

// `DSField`'s label row (DSField.swift:22): the label in secondary, the help mark beside it.
component LabelRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> help;
    spacing: DS.space-xs;
    alignment: start;
    Text {
        text: root.label;
        font-size: DS.typo-label-size;
        color: DS.palette-text-secondary;
        vertical-alignment: center;
    }
    // DSHelp.swift:9: the question mark, tertiary, secondary under the hand, DS.Space.xxs around it.
    if root.help: Rectangle {
        width: DS.control-help-mark-size + 2 * DS.space-xxs;
        Image {
            width: DS.control-help-mark-size;
            height: DS.control-help-mark-size;
            source: Icons.question;
            colorize: mark.has-hover ? DS.palette-text-secondary : DS.palette-text-tertiary;
        }
        mark := TouchArea { }
    }
}

// `DSField`: the label row above its control, DS.Space.xs between, the control full width.
component LabelAbove inherits VerticalLayout {
    in property <string> label;
    in property <bool> help;
    spacing: DS.space-xs;
    LabelRow { label: root.label; help: root.help; }
    @children
}

// ExportSurface.swift:134 `field`: the label beside, DS.Control.exifLabelWidth wide, DS.Space.sm to the field.
component LabelBeside inherits HorizontalLayout {
    in property <string> label;
    spacing: DS.space-sm;
    Text {
        width: DS.control-exif-label-width;
        text: root.label;
        font-size: DS.typo-label-size;
        color: DS.palette-text-secondary;
        vertical-alignment: center;
    }
    @children
}

// SizeFields (ExportSurface.swift:384): W × H in one hollow with one focus, DS.Control.keycapHeight tall.
component SizeBoxes inherits Well {
    in property <string> w;
    in property <string> h;
    in property <bool> enabled: true;
    in property <bool> live: true;
    in property <bool> force-focus;
    height: DS.control-keycap-height;
    ring: wide.has-focus || high.has-focus || root.force-focus;
    HorizontalLayout {
        alignment: center;
        spacing: DS.space-xs;
        wide := Entry {
            width: DS.control-export-size-field-width; horizontal-stretch: 0;
            text: root.w; placeholder: "W"; font-size: DS.typo-title-size; centred: true;
            enabled: root.enabled; live: root.live;
        }
        Text { text: "×"; font-size: DS.typo-title-size; color: DS.palette-text-secondary; vertical-alignment: center; }
        high := Entry {
            width: DS.control-export-size-field-width; horizontal-stretch: 0;
            text: root.h; placeholder: "H"; font-size: DS.typo-title-size; centred: true;
            enabled: root.enabled; live: root.live;
        }
    }
}

// DateFields (InfoSidebar.swift:282): MM / DD / YYYY in one hollow with one focus, hugging its boxes.
component DateBoxes inherits Well {
    in property <string> month;
    in property <string> day;
    in property <string> year;
    in property <bool> enabled: true;
    in property <bool> live: true;
    in property <bool> force-focus;
    height: DS.control-keycap-height;
    width: 2 * DS.control-date-field-width + DS.control-year-field-width + 4 * DS.space-xs + 12px + 2 * FieldLook.pad-x * 1px;
    ring: mm.has-focus || dd.has-focus || yy.has-focus || root.force-focus;
    HorizontalLayout {
        alignment: center;
        spacing: DS.space-xs;
        mm := Entry {
            width: DS.control-date-field-width; horizontal-stretch: 0;
            text: root.month; placeholder: "MM"; font-size: DS.typo-title-size; centred: true;
            enabled: root.enabled; live: root.live;
        }
        Text { text: "/"; font-size: DS.typo-title-size; color: DS.palette-text-secondary; vertical-alignment: center; }
        dd := Entry {
            width: DS.control-date-field-width; horizontal-stretch: 0;
            text: root.day; placeholder: "DD"; font-size: DS.typo-title-size; centred: true;
            enabled: root.enabled; live: root.live;
        }
        Text { text: "/"; font-size: DS.typo-title-size; color: DS.palette-text-secondary; vertical-alignment: center; }
        yy := Entry {
            width: DS.control-year-field-width; horizontal-stretch: 0;
            text: root.year; placeholder: "YYYY"; font-size: DS.typo-title-size; centred: true;
            enabled: root.enabled; live: root.live;
        }
    }
}

// A specimen: the element on top, its caption under it.
component Specimen inherits VerticalLayout {
    in property <string> caption;
    in property <length> cell: 140px;
    width: root.cell;
    spacing: 6px;
    alignment: start;
    @children
    Caption { text: root.caption; }
}

// One row of the sheet: its name and Swift source, then the live instance and its forced states.
component Row inherits VerticalLayout {
    in property <string> name;
    in property <string> source;
    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Heading { text: root.name; vertical-alignment: center; }
        Caption { text: root.source; vertical-alignment: center; wrap: no-wrap; }
    }
    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        @children
    }
}

export component FieldsPage inherits Rectangle {
    background: DS.palette-panel;
    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 28px;
            alignment: start;

            // The field tunables, three columns.
            Rectangle {
                background: DS.palette-canvas;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 20px;
                    VerticalLayout {
                        alignment: start;
                        Heading { text: "HOLLOW"; }
                        Tune { label: "radius"; maximum: 20; value <=> FieldLook.radius; }
                        Tune { label: "height"; minimum: 20; maximum: 48; value <=> FieldLook.height; }
                        Tune { label: "pad across"; maximum: 32; value <=> FieldLook.pad-x; }
                        Tune { label: "pad down"; maximum: 20; value <=> FieldLook.pad-y; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Heading { text: "EDGES"; }
                        Tune { label: "edge"; value <=> Depth.well-edge; }
                        Tune { label: "lip soft"; value <=> Depth.well-lip-soft; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Heading { text: "TEXT"; }
                        Tune { label: "text"; value <=> FieldLook.text-alpha; }
                        Tune { label: "placeholder"; value <=> FieldLook.placeholder-alpha; }
                        Tune { label: "disabled"; value <=> FieldLook.disabled-alpha; }
                        Heading { text: "WELL (DEPTH)"; }
                        Tune { label: "shade"; value <=> Depth.well-shade; }
                        Tune { label: "lip"; maximum: 0.3; value <=> Depth.well-lip; }
                    }
                }
            }

            Row {
                name: "SINGLE LINE";
                source: "DSTextField.swift:6 · PresetEditor.swift:81 · DSDialog.swift:64 · InfoSidebar.swift:210";
                Specimen { cell: 240px; caption: "live: click and type"; Field { placeholder: "Preset name"; } }
                Specimen { caption: "rest, empty"; Field { placeholder: "Preset name"; live: false; } }
                Specimen { caption: "hover = rest (Swift draws none, the I-beam only)"; Field { placeholder: "Preset name"; live: false; } }
                Specimen { caption: "focused: the rim ring"; Field { placeholder: "Preset name"; live: false; force-focus: true; } }
                Specimen { caption: "filled"; Field { text: "Portra warm"; live: false; } }
                Specimen { caption: "disabled: the text fades, the chrome stays"; Field { text: "Portra warm"; enabled: false; } }
            }

            Row {
                name: "WARNING";
                source: "ReportSheet.swift:49 · no error chrome on the field: the failure is said beneath it";
                Specimen {
                    cell: 320px;
                    caption: "live field, then the failure in DS.Palette.warning (VStack DS.Space.md)";
                    VerticalLayout {
                        spacing: DS.space-md;
                        Field { placeholder: "e.g. Leica M6"; }
                        Text { text: "The report could not be sent: no connection."; font-size: DS.typo-label-size; color: DS.palette-warning; wrap: word-wrap; }
                    }
                }
            }

            Row {
                name: "SEARCH / FILTER";
                source: "PaperProfilesSheet.swift:130 · the same field, no glass icon";
                Specimen { cell: 240px; caption: "live"; Field { placeholder: "Filter, e.g. P900 matte"; } }
                Specimen { caption: "filled, focused"; Field { text: "P900"; live: false; force-focus: true; } }
            }

            Row {
                name: "MULTILINE";
                source: "DSTextField.swift:24 · PresetEditor.swift:87 (3 lines reserved) · InfoSidebar.swift:101 (TextEditor 60) · ReportSheet.swift:40";
                Specimen {
                    cell: 240px;
                    caption: "live, TextField axis vertical, lineLimit 3 reserved";
                    Field { multiline: true; height: 3 * 16px + 2 * FieldLook.pad-y * 1px; placeholder: "What this look is for"; }
                }
                Specimen {
                    cell: 240px;
                    caption: "live, TextEditor framed 60 tall";
                    Field { multiline: true; height: DS.control-project-description-height + 2 * FieldLook.pad-y * 1px; }
                }
                Specimen {
                    caption: "filled, focused";
                    Field { multiline: true; height: 3 * 16px + 2 * FieldLook.pad-y * 1px; live: false; force-focus: true; text: "Warm skin, soft greens, for overcast days."; }
                }
                Specimen {
                    caption: "disabled";
                    Field { multiline: true; height: 3 * 16px + 2 * FieldLook.pad-y * 1px; enabled: false; text: "Warm skin, soft greens, for overcast days."; }
                }
            }

            Row {
                name: "RENAME";
                source: "GalleryView.swift:265 RenameField · TreeEngine.swift:384 (row) · GalleryView.swift:300, InfoSidebar.swift:228 (title)";
                Specimen {
                    cell: 240px;
                    caption: "live, a row's name, DS.Typo.label in a 32 row";
                    Field { height: DS.control-film-sidebar-row-height; text: "Roll #8"; }
                }
                Specimen {
                    cell: 240px;
                    caption: "live, a roll title, DS.Typo.title, led by -DS.Space.md so the text stays put";
                    Field { font-size: DS.typo-title-size; text: "Roll #8"; }
                }
                Specimen { caption: "focused, as entered"; Field { font-size: DS.typo-title-size; text: "Roll #8"; live: false; force-focus: true; } }
            }

            Row {
                name: "NUMERIC: SIZE";
                source: "ExportSurface.swift:384 SizeFields · boxes DS.Control.exportSizeFieldWidth, DS.Typo.title, centred";
                Specimen { cell: 240px; caption: "live, one focus for the pair"; SizeBoxes { w: "6048"; h: "4032"; } }
                Specimen { cell: 200px; caption: "rest, empty"; SizeBoxes { live: false; } }
                Specimen { cell: 200px; caption: "focused"; SizeBoxes { w: "6048"; h: "4032"; live: false; force-focus: true; } }
                Specimen { cell: 200px; caption: "disabled"; SizeBoxes { w: "6048"; h: "4032"; enabled: false; } }
            }

            Row {
                name: "DATE BOXES";
                source: "InfoSidebar.swift:282 DateFields · DS.Control.dateFieldWidth, yearFieldWidth, DS.Typo.title";
                Specimen { cell: 200px; caption: "live, one focus for the three"; DateBoxes { month: "9"; day: "5"; year: "2026"; } }
                Specimen { cell: 180px; caption: "rest, empty"; DateBoxes { live: false; } }
                Specimen { cell: 180px; caption: "focused"; DateBoxes { month: "9"; day: "5"; year: "2026"; live: false; force-focus: true; } }
                Specimen { cell: 180px; caption: "disabled (Swift never disables it)"; DateBoxes { month: "9"; day: "5"; year: "2026"; enabled: false; } }
            }

            Row {
                name: "DSFIELD: LABEL ABOVE";
                source: "DSField.swift:4 · DSHelp.swift:9 · PresetEditor.swift:80";
                Specimen {
                    cell: 280px;
                    caption: "live, the label row above, DS.Space.xs";
                    LabelAbove { label: "Name"; Field { placeholder: "Preset name"; } }
                }
                Specimen {
                    cell: 280px;
                    caption: "with its help mark (hover it)";
                    LabelAbove { label: "Pass Order"; help: true; Field { text: "Red, Green, Blue"; live: false; } }
                }
            }

            Row {
                name: "LABEL BESIDE";
                source: "ExportSurface.swift:102 FrameFields, :134 field · label DS.Control.exifLabelWidth, suffix in secondary";
                Specimen {
                    cell: 380px;
                    caption: "live, the EXIF block, DS.Space.xs between lines";
                    VerticalLayout {
                        spacing: DS.space-xs;
                        LabelBeside { label: "Name"; Field { text: "Roll8_012"; suffix: ".jpg"; } }
                        LabelBeside { label: "Camera"; Field { placeholder: "Leica M6"; } }
                        LabelBeside { label: "Lens"; Field { placeholder: "Summicron 50 mm"; } }
                        LabelBeside { label: "ISO"; Field { placeholder: "400"; } }
                        LabelBeside { label: "Date"; Field { placeholder: "2026:09:05 10:00:00"; } }
                        LabelBeside { label: "Artist"; Field { placeholder: "Your name"; } }
                        LabelBeside { label: "Copyright"; Field { placeholder: "© 2026 Your name"; } }
                    }
                }
                Specimen {
                    cell: 380px;
                    caption: "disabled, as the block is while no frame is exportable";
                    VerticalLayout {
                        spacing: DS.space-xs;
                        LabelBeside { label: "Name"; Field { text: "Roll8_012"; suffix: ".jpg"; enabled: false; } }
                        LabelBeside { label: "Camera"; Field { text: "Nikon Z f"; enabled: false; } }
                        LabelBeside { label: "ISO"; Field { placeholder: "400"; enabled: false; } }
                    }
                }
            }
        }
    }
}
