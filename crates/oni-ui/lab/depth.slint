// The three depths every 2.5D element is built from: `Keycap`, Swift's lit frustum for the keys;
// `Outward`, a plain raised surface; `Inward`, a well sunk into the ground. Tuned live, then copied into ds/.
import { DS } from "../ui/ds/tokens.slint";

// What `Raster.keycap` draws: a key's size, depth and look, every length in points at the large size.
export struct KeycapLook {
    width: float, height: float, depth: float, albedo: color, radius: float, face-radius: float,
    factor: float, margin: float, level: bool, shadow: bool, rim: bool,
    azimuth: float, elevation: float, ambient: float, diffuse: float, midtone: float,
    wall-top: float, wall-bottom: float, wall-side: float, rise: float, dish: float, seam-blur: float,
    socket-rest: float, socket-pressed: float, socket-softness: float, scale-pressed: float, travel: float,
    shadow-opacity: float, shadow-blur: float, shadow-y: float,
}

// The keycap rasterised by oni-keycap, Swift's algorithm to the pixel; `oni-lab` answers it, and
// slint-viewer, which cannot, gets an empty image and `Keycap` its flat stand-in.
export global Raster {
    pure callback keycap(look: KeycapLook) -> image;
}

// `Keycap.Variant`: every length at 1, 0.525 or 0.38, as `KeycapStyle.scaled(by:)`.
export enum KeycapVariant { large, small, mini }

// Swift's `KeycapStyle`, the physical subset: a lit frustum (four flat walls, a dished face) over a socket.
export global Depth {
    // The light: azimuth from +x counter-clockwise, elevation above the plane, in degrees.
    in-out property <float> azimuth: 100;
    in-out property <float> elevation: 33;
    in-out property <float> ambient: 0.25;
    in-out property <float> diffuse: 1;
    // 1 divides every shade by the flat face's, so the face keeps the albedo and the walls move around it.
    in-out property <float> midtone: 1;
    // The walls' horizontal runs and their common rise: a taller rise, steeper walls.
    in-out property <float> wall-top: 8;
    in-out property <float> wall-bottom: 12;
    in-out property <float> wall-side: 8;
    in-out property <float> rise: 6;
    in-out property <float> dish: 4;
    in-out property <length> corner: 16px;
    in-out property <length> face-corner: 14px;
    // The cap's cast shadow at rest; a press flattens it.
    in-out property <float> shadow-opacity: 0.2;
    in-out property <length> shadow-blur: 8px;
    in-out property <length> shadow-y: 10px;
    // How far a press sinks the cap, how much of a press a hover shows; the reference's two curves,
    // 0.1 s down and 0.02 s up, and the 0.14 s a tap is held down for.
    in-out property <length> travel: 1px;
    in-out property <float> hover-press: 0.25;
    in-out property <duration> press-time: 100ms;
    in-out property <duration> release-time: 20ms;
    in-out property <duration> min-hold: 140ms;
    in-out property <float> scale-pressed: 0.95;
    // The walls' seam blur, and the socket's rim at rest and pressed with its softness.
    in-out property <float> seam-blur: 3;
    in-out property <float> socket-rest: 2;
    in-out property <float> socket-pressed: 6;
    in-out property <float> socket-softness: 0.5;
    // The plain raised surface: a lit top edge, a shade towards its foot, a short cast shadow.
    in-out property <float> raise-light: 0.10;
    in-out property <float> raise-shade: 0.18;
    in-out property <length> raise-shadow-y: 2px;
    in-out property <length> raise-shadow-blur: 4px;
    in-out property <float> raise-shadow-opacity: 0.35;
    // The well: its darkening at the top edge, how far down it reaches, and the lit lip at the bottom.
    in-out property <float> well-shade: 0.55;
    in-out property <length> well-reach: 6px;
    in-out property <float> well-lip: 0.08;
    // A scale on every wall run and on the rise, so the whole lab's relief turns up or down at once.
    in-out property <float> relief: 1;

    // The light's direction, a unit vector; y grows downwards as the screen does.
    public pure function lx() -> float { cos(elevation * 1deg) * cos(azimuth * 1deg) }
    public pure function ly() -> float { -cos(elevation * 1deg) * sin(azimuth * 1deg) }
    public pure function lz() -> float { sin(elevation * 1deg) }

    // `Frustum.Light.shade`: Lambert over the ambient, divided by the flat face's shade as `midtone` asks.
    public pure function shade(nx: float, ny: float, nz: float) -> float {
        (ambient + diffuse * max(0, nx * lx() + ny * ly() + nz * lz())) / max(0.000001, 1 + (ambient + diffuse * max(0, lz()) - 1) * clamp(midtone, 0, 1))
    }

    public pure function lit(albedo: color, s: float) -> color {
        rgba(min(255, albedo.red * s), min(255, albedo.green * s), min(255, albedo.blue * s), albedo.alpha / 255)
    }

    // A wall's colour from its run: the four walls lean out by `run` over `rise`.
    public pure function wall(albedo: color, side: int, run: float) -> color {
        lit(albedo, shade(
            side == 2 ? -rise * relief / hyp(run, rise) : side == 3 ? rise * relief / hyp(run, rise) : 0,
            side == 0 ? -rise * relief / hyp(run, rise) : side == 1 ? rise * relief / hyp(run, rise) : 0,
            run / hyp(run, rise)))
    }

    pure function hyp(run: float, r: float) -> float { max(0.000000001, sqrt(run * run + r * relief * r * relief)) }

    // `Frustum.dishNormal` at `t`, 0 at the face's top to 1 at its bottom, as a shade.
    public pure function dish-shade(t: float, h: float) -> float {
        h <= 0 ? shade(0, 0, 1) : shade(0, -(4 * dish * (2 * t - 1) / h) / sqrt(1 + pow(4 * dish * (2 * t - 1) / h, 2)), 1 / sqrt(1 + pow(4 * dish * (2 * t - 1) / h, 2)))
    }

    public pure function face(albedo: color, t: float, h: float) -> color { lit(albedo, dish-shade(t, h)) }
}

// Swift's `KeycapChrome`, drawn by `Raster`: children lie on the face, sink and shrink with it. `depth`
// 0 rests, 1 is fully pressed; the variant or a free `factor` sizes every length.
export component Keycap inherits Rectangle {
    in property <color> albedo: DS.palette-keycap;
    in property <KeycapVariant> variant: large;
    in property <float> factor: root.variant == KeycapVariant.small ? 0.525 : root.variant == KeycapVariant.mini ? 0.38 : 1;
    in property <length> radius: Depth.corner * root.factor;
    in property <length> face-radius: Depth.face-corner * root.factor;
    in property <float> depth;
    // `DSBarHandle`: equal walls, no cast shadow, no rim; and its edge stroked over the chrome.
    in property <bool> level;
    in property <bool> shadow: true;
    in property <bool> rim: true;
    in property <length> edge-width: 0;
    in property <color> edge-color: #000000;
    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;
    property <float> top: Depth.wall-top * Depth.relief * root.factor;
    property <float> bottom: (root.level ? Depth.wall-top : Depth.wall-bottom) * Depth.relief * root.factor;
    property <float> side: Depth.wall-side * Depth.relief * root.factor;
    // `faceRect`: the walls squeezed alike where they would leave the face under 40 % of the cap.
    property <float> squeeze: min(root.top + root.bottom > root.h * 0.6 ? root.h * 0.6 / (root.top + root.bottom) : 1,
        2 * root.side > root.w * 0.6 ? root.w * 0.6 / (2 * root.side) : 1);
    // The cast shadow's reach at 0.9 σ per radius, so the image holds it whole.
    property <float> margin: ceil((2.7 * Depth.shadow-blur / 1px + Depth.shadow-y / 1px) * root.factor) + 2;
    image := Image {
        x: -root.margin * 1px;
        y: -root.margin * 1px;
        width: root.width + 2 * root.margin * 1px;
        height: root.height + 2 * root.margin * 1px;
        image-fit: fill;
        source: Raster.keycap({
            width: root.w, height: root.h, depth: root.depth, albedo: root.albedo,
            radius: root.radius / 1px, face-radius: root.face-radius / 1px, factor: root.factor,
            margin: root.margin, level: root.level, shadow: root.shadow, rim: root.rim,
            azimuth: Depth.azimuth, elevation: Depth.elevation, ambient: Depth.ambient,
            diffuse: Depth.diffuse, midtone: Depth.midtone,
            wall-top: Depth.wall-top * Depth.relief, wall-bottom: Depth.wall-bottom * Depth.relief,
            wall-side: Depth.wall-side * Depth.relief, rise: Depth.rise * Depth.relief, dish: Depth.dish,
            seam-blur: Depth.seam-blur, socket-rest: Depth.socket-rest, socket-pressed: Depth.socket-pressed,
            socket-softness: Depth.socket-softness, scale-pressed: Depth.scale-pressed, travel: Depth.travel / 1px,
            shadow-opacity: Depth.shadow-opacity, shadow-blur: Depth.shadow-blur / 1px, shadow-y: Depth.shadow-y / 1px,
        });
    }
    // slint-viewer has no `Raster`: a flat cap in its place keeps the layout readable.
    if image.source.width == 0: Rectangle {
        border-radius: root.radius;
        background: root.albedo;
    }
    if root.edge-width > 0: Rectangle {
        border-radius: root.radius;
        border-width: root.edge-width;
        border-color: root.edge-color;
    }
    // The label's place: on the face, moved by the travel, scaled about the key's centre as the cap.
    Rectangle {
        x: root.side * root.squeeze * 1px;
        y: (root.top * root.squeeze + Depth.travel / 1px * root.factor * root.depth) * 1px;
        width: root.width - 2 * root.side * root.squeeze * 1px;
        height: root.height - (root.top + root.bottom) * root.squeeze * 1px;
        transform-scale-x: 1 + (Depth.scale-pressed - 1) * root.depth;
        transform-scale-y: self.transform-scale-x;
        transform-origin: { x: root.width / 2 - self.x, y: root.height / 2 - self.y };
        @children
    }
}

// A plain surface standing out: a light rim along its top, a shade towards its foot, a short shadow.
export component Outward inherits Rectangle {
    in property <color> fill: DS.palette-keycap;
    in property <length> radius: 8px;
    border-radius: root.radius;
    background: @linear-gradient(180deg, Depth.lit(root.fill, 1 + Depth.raise-light) 0%, root.fill 40%, Depth.lit(root.fill, 1 - Depth.raise-shade) 100%);
    drop-shadow-color: rgba(0, 0, 0, Depth.raise-shadow-opacity);
    drop-shadow-blur: Depth.raise-shadow-blur;
    drop-shadow-offset-y: Depth.raise-shadow-y;
    Rectangle {
        height: 1px;
        y: 0;
        x: root.radius / 2;
        width: parent.width - root.radius;
        background: rgba(255, 255, 255, Depth.raise-light);
    }
    @children
}

// A well sunk into the ground: darker at its top edge where the rim shades it, a faint lit lip at its
// bottom edge; children lie inside.
export component Inward inherits Rectangle {
    in property <color> ground: DS.palette-tile;
    in property <length> radius: 8px;
    border-radius: root.radius;
    background: root.ground;
    clip: true;
    Rectangle {
        height: Depth.well-reach;
        y: 0;
        background: @linear-gradient(180deg, rgba(0, 0, 0, Depth.well-shade) 0%, rgba(0, 0, 0, 0) 100%);
    }
    Rectangle {
        height: 1px;
        y: parent.height - self.height;
        background: rgba(255, 255, 255, Depth.well-lip);
    }
    @children
}
