// The lab's Misc page: the design system's other raised and sunken surfaces (`Raised`, `Inset`, the glass,
// the lamps, the seals, the cards, the popover, the sheet, the status bar), live beside their forced states.
import { Slider, ScrollView } from "std-widgets.slint";
import { DS } from "../ui/ds/tokens.slint";
import { SurfaceStyle } from "../ui/ds/theme_surfaces.slint";
import { Label, TextRole, Tone, Gap, Raised, Lift, Inset, Divider, TipCard, Badge, BadgeTone, Metal, LcdReadout,
    Progress, StatusBar, Lamp, Popover, PopupPanel, PresetFace, PresetStyle, WrappedCard, Section, AskSheet, AskRole,
    SheetStyle, Button } from "../ui/ds/ds.slint";
import { Keycap, Outward, Inward, Depth } from "depth.slint";

// One tunable, as lab.slint's `Tune`.
component Tune inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    height: 30px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 110px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
        Text { text: round(root.value * 100) / 100; width: 40px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

// The same for a length, in px.
component TuneLength inherits Rectangle {
    in property <string> label;
    in property <float> maximum: 12;
    in-out property <length> value;
    height: 30px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; width: 110px; color: #ffffffcc; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Slider { minimum: 0; maximum: root.maximum; value: root.value / 1px; changed(v) => { root.value = v * 1px; } }
        Text { text: round(root.value / 1px * 100) / 100; width: 40px; color: #ffffff8c; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component Heading inherits Text {
    color: #ffffff59;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

// One element: its name, its Swift source, then its live instance and forced states.
component Row inherits VerticalLayout {
    in property <string> title;
    in property <string> source;
    spacing: 12px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Text { text: root.title; color: #ffffffd9; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
        Text { text: root.source; color: DS.palette-text-tertiary; font-size: 10px; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 28px;
        alignment: start;
        @children
    }
}

// A specimen and its caption.
component Cell inherits VerticalLayout {
    in property <string> caption;
    spacing: 8px;
    alignment: start;
    @children
    Text { text: root.caption; color: DS.palette-text-secondary; font-size: 10px; }
}

// A key's legend, centred on its face.
component Legend inherits Text {
    color: DS.palette-text-on-fill;
    font-size: 13px;
    font-weight: 600;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// A key of a dialog's plate: the keycap in its role's tint, the legend light.
component DialogKey inherits Keycap {
    in property <string> text;
    callback clicked();
    width: legend.preferred-width + 48px;
    height: 40px;
    depth: touch.pressed ? 1 : touch.has-hover ? 0.25 : 0;
    animate depth { duration: 90ms; easing: ease-out; }
    legend := Legend { width: parent.width; height: parent.height; text: root.text; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// `DSWarning` (DSWarning.swift:5): a triangle and a sentence on a pale orange band; flat in Swift.
export component Warning inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> dismissable;
    width: 300px;
    background: DS.palette-warning-soft;
    border-radius: DS.radius-badge;
    VerticalLayout {
        padding: DS.space-sm;
        spacing: DS.space-xs;
        HorizontalLayout {
            spacing: DS.space-xs;
            alignment: start;
            Image { source: @image-url("../ui/icons/warning.svg"); width: DS.control-icon-size; height: DS.control-icon-size; colorize: DS.palette-text-on-warning; }
            if root.title != "": Text { text: root.title; font-size: DS.typo-label-size; font-weight: 700; color: DS.palette-text-on-warning; vertical-alignment: center; }
        }
        if root.text != "": Text { text: root.text; font-size: DS.typo-label-size; color: DS.palette-text-on-warning; wrap: word-wrap; }
        if root.dismissable: HorizontalLayout {
            alignment: end;
            DialogKey { text: "Dismiss"; }
        }
    }
}

// `dsPlotScreen` (DSPlotScreen.swift:11): a plot behind glass, the canvas's floor in a card-cornered
// hollow, quarter lines engraved across it.
export component PlotScreen inherits Inward {
    in property <bool> grid: true;
    ground: DS.palette-canvas;
    radius: DS.radius-card;
    hollow: true;
    width: 280px;
    height: DS.control-histogram-height;
    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    // The viewbox is the plot's own size: Slint keeps a path's aspect ratio.
    if root.grid: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        stroke: DS.palette-separator;
        stroke-width: DS.stroke-hairline;
        commands: "M \{root.w / 4} 0 L \{root.w / 4} \{root.h} M \{root.w / 2} 0 L \{root.w / 2} \{root.h} M \{root.w * 3 / 4} 0 L \{root.w * 3 / 4} \{root.h} M 0 \{root.h / 4} L \{root.w} \{root.h / 4} M 0 \{root.h / 2} L \{root.w} \{root.h / 2} M 0 \{root.h * 3 / 4} L \{root.w} \{root.h * 3 / 4}";
    }
    // `specimenCurve`: y = 0.5 - 0.35 sin(2 pi x), two cubic arcs.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        stroke: DS.palette-selected;
        stroke-width: DS.stroke-trace;
        commands: "M 0 \{root.h / 2} C \{root.w / 6} \{root.h * 0.05} \{root.w / 3} \{root.h * 0.05} \{root.w / 2} \{root.h / 2} C \{root.w * 2 / 3} \{root.h * 0.95} \{root.w * 5 / 6} \{root.h * 0.95} \{root.w} \{root.h / 2}";
    }
}

// A ground to lay a specimen on: the canvas's dark, or the photo's black-to-white for what floats on it.
component Ground inherits Rectangle {
    in property <bool> photo;
    background: root.photo ? @linear-gradient(90deg, #000000 0%, #ffffff 100%) : DS.palette-canvas;
    border-radius: DS.radius-control;
    HorizontalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: center;
        @children
    }
}

export component MiscPage inherits Rectangle {
    background: DS.palette-panel;
    property <int> lcd-count: 12;
    property <bool> lamp-on: true;
    property <int> status-mode;
    property <int> status-done: 12;
    property <bool> popover-open;
    property <string> answer: "nothing asked yet";
    property <bool> field-lit;
    property <float> live-fraction: 0.4;
    Timer {
        interval: 80ms;
        running: root.status-mode == 1;
        triggered => { root.status-done = Math.mod(root.status-done + 1, 41); }
    }
    ScrollView {
        VerticalLayout {
            padding: 32px;
            spacing: 36px;
            alignment: start;

            // The tuning strip: the two depths' own tunables, then the surfaces' (`SurfaceStyle`).
            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                VerticalLayout {
                    width: 290px;
                    alignment: start;
                    Heading { text: "OUTWARD"; }
                    Tune { label: "top rim"; maximum: 0.5; value <=> Depth.raise-light; }
                    Tune { label: "face sheen"; maximum: 0.3; value <=> Depth.raise-sheen; }
                    Tune { label: "foot shade"; maximum: 0.5; value <=> Depth.raise-shade; }
                    Tune { label: "edge"; maximum: 0.5; value <=> Depth.raise-edge; }
                    Tune { label: "shadow opacity"; value <=> Depth.raise-shadow-opacity; }
                    TuneLength { label: "shadow blur"; maximum: 24; value <=> Depth.raise-shadow-blur; }
                    TuneLength { label: "shadow y"; maximum: 12; value <=> Depth.raise-shadow-y; }
                }
                VerticalLayout {
                    width: 290px;
                    alignment: start;
                    Heading { text: "INWARD"; }
                    Tune { label: "shade"; value <=> Depth.well-shade; }
                    TuneLength { label: "reach"; maximum: 12; value <=> Depth.well-reach; }
                    TuneLength { label: "drop"; maximum: 6; value <=> Depth.well-drop; }
                    TuneLength { label: "hollow reach"; maximum: 16; value <=> Depth.well-hollow-reach; }
                    TuneLength { label: "hollow drop"; maximum: 8; value <=> Depth.well-hollow-drop; }
                    Tune { label: "edge"; value <=> Depth.well-edge; }
                    Tune { label: "lip"; value <=> Depth.well-lip; }
                    TuneLength { label: "lip y"; maximum: 4; value <=> Depth.well-lip-y; }
                    Tune { label: "lip soft"; value <=> Depth.well-lip-soft; }
                }
                VerticalLayout {
                    width: 290px;
                    alignment: start;
                    Heading { text: "SURFACES"; }
                    Tune { label: "lcd glow"; value <=> SurfaceStyle.lcd-glow; }
                    TuneLength { label: "lcd glow width"; maximum: 4; value <=> SurfaceStyle.lcd-glow-width; }
                    TuneLength { label: "lamp glow"; maximum: 12; value <=> SurfaceStyle.lamp-glow; }
                    Tune { label: "foil contrast"; maximum: 2; value <=> SurfaceStyle.seal-contrast; }
                    Tune { label: "foil sheen"; value <=> SurfaceStyle.seal-sheen; }
                    Tune { label: "foil rule"; value <=> SurfaceStyle.seal-rule; }
                    Tune { label: "ink emboss"; value <=> SurfaceStyle.seal-emboss; }
                    Tune { label: "foil shadow"; maximum: 2; value <=> SurfaceStyle.seal-shadow; }
                    TuneLength { label: "progress glow"; maximum: 24; value <=> SurfaceStyle.progress-glow; }
                }
            }

            Row {
                title: "OUTWARD · RAISED";
                source: "depth.slint, base.slint · Swift dsFloating, DSPopover.swift:89";
                Cell {
                    caption: "live: hover lifts";
                    Rectangle {
                        width: 160px;
                        height: 90px;
                        Outward {
                            y: hover-out.has-hover ? -PresetStyle.lift : 0;
                            animate y { duration: 160ms; easing: ease-out-back; }
                            width: parent.width;
                            height: parent.height;
                            fill: DS.palette-panel;
                            radius: DS.radius-card;
                            lift: hover-out.has-hover ? 1 : 0;
                            hover-out := TouchArea { }
                        }
                    }
                }
                Cell { caption: "Raised, none (popover)"; Raised { width: 120px; pad: Gap.m; Label { text: "none"; } } }
                Cell { caption: "Raised, float (slid column)"; Raised { width: 120px; lift: Lift.float; pad: Gap.m; Label { text: "float"; } } }
                Cell { caption: "Raised, sheet"; Raised { width: 120px; lift: Lift.sheet; pad: Gap.m; Label { text: "sheet"; } } }
                Cell { caption: "Raised, menu"; Raised { width: 120px; menu: true; pad: Gap.m; Label { text: "menu"; } } }
                Cell { caption: "on the canvas"; Ground { Raised { width: 100px; lift: Lift.float; pad: Gap.m; Label { text: "float"; } } } }
            }

            Row {
                title: "INWARD · INSET";
                source: "depth.slint, base.slint · Swift dsRecessed, DSSlider.swift:276";
                Cell {
                    caption: "live: click lights the rim";
                    Inward {
                        width: 160px;
                        height: 32px;
                        ground: DS.palette-canvas;
                        radius: DS.radius-card;
                        hollow: true;
                        lit: root.field-lit;
                        TouchArea { clicked => { root.field-lit = !root.field-lit; } }
                    }
                }
                Cell { caption: "track recess"; Inward { width: 120px; height: DS.control-track-height; ground: DS.palette-track; radius: DS.radius-track; } }
                Cell { caption: "hollow"; Inward { width: 120px; height: 32px; ground: DS.palette-canvas; radius: DS.radius-card; hollow: true; } }
                Cell { caption: "pill hollow (toggle)"; Inward { width: 80px; height: 20px; ground: DS.palette-canvas; radius: 10px; hollow: true; } }
                Cell {
                    caption: "Inset (the export's summary)";
                    Inset {
                        width: 200px;
                        Label { text: "16-bit TIFF · Display P3"; role: TextRole.value; }
                        Label { text: "6048 × 4032 · 139 MB"; role: TextRole.value; tone: Tone.secondary; }
                    }
                }
                Cell { caption: "photo well (tile)"; Inward { width: 120px; height: 80px; ground: DS.palette-tile; radius: DS.radius-card; hollow: true; } }
            }

            Row {
                title: "DSLCD · LcdReadout";
                source: "forms.slint · DSLCD.swift:3";
                Cell {
                    caption: "live: click counts";
                    LcdReadout {
                        text: root.lcd-count + "/40";
                        TouchArea { clicked => { root.lcd-count = Math.mod(root.lcd-count + 1, 41); } }
                    }
                }
                Cell { caption: "kept"; LcdReadout { text: "KEPT 87 %"; } }
                Cell { caption: "angle"; LcdReadout { text: "ANGLE +1.25°"; } }
                Cell { caption: "count"; LcdReadout { text: "12/40"; } }
            }

            Row {
                title: "DSLAMP · Lamp, Button's lamp";
                source: "surfaces.slint, button.slint · DSLamp.swift:5 · on a key, AppBar.swift:25";
                Cell {
                    caption: "live: click the key";
                    Button { text: "Scan"; lamp-shown: true; lamp-lit: root.lamp-on; clicked => { root.lamp-on = !root.lamp-on; } }
                }
                Cell { caption: "key, dark"; Button { text: "Base"; lamp-shown: true; } }
                Cell { caption: "dark"; Ground { Lamp { lit: false; } } }
                Cell { caption: "lit, confirm"; Ground { Lamp { lit: true; } } }
                Cell { caption: "lit, destructive"; Ground { Lamp { lit: true; colour: DS.tint-destructive; } } }
                Cell { caption: "lit, update"; Ground { Lamp { lit: true; colour: DS.tint-update; } } }
            }

            Row {
                title: "DSFOIL · Badge seals";
                source: "badge.slint · DSFoil.swift:35 · DSNews.swift:78";
                Cell {
                    caption: "live: hover glints";
                    Rectangle {
                        width: s-live.width;
                        height: s-live.height;
                        s-live := Badge { tone: BadgeTone.seal; text: "NEW"; glinting: s-touch.has-hover; }
                        s-touch := TouchArea { }
                    }
                }
                Cell { caption: "gold"; Badge { tone: BadgeTone.seal; text: "NEW"; } }
                Cell { caption: "holographic"; Badge { tone: BadgeTone.seal; metal: Metal.holographic; text: "RGB"; } }
                Cell { caption: "red"; Badge { tone: BadgeTone.seal; metal: Metal.red; text: "FLAGGED"; } }
                Cell { caption: "gold, mid-glint"; Badge { tone: BadgeTone.seal; text: "2026"; glint-at: 0; } }
                Cell { caption: "holo, mid-glint"; Badge { tone: BadgeTone.seal; metal: Metal.holographic; text: "RGB"; glint-at: -0.1; } }
                Cell { caption: "on the canvas"; Ground { Badge { tone: BadgeTone.seal; metal: Metal.red; text: "FLAGGED"; } } }
            }

            Row {
                title: "PANEL AND CARDS";
                source: "EditorScene+Card.swift:323 · PresetCarousel.swift:153 · WrappedView.swift:115 · DSPanel.swift:5";
                Cell {
                    caption: "editor card (Raised float) on the canvas";
                    Ground {
                        Raised {
                            width: 220px;
                            lift: Lift.float;
                            Section { title: "Balance"; separated: false; foldable: false; Label { text: "Temperature   5000 K"; role: TextRole.value; tone: Tone.secondary; } }
                            Section { title: "Tone"; foldable: false; }
                        }
                    }
                }
                Cell {
                    caption: "preset card, live: hover";
                    Rectangle {
                        width: PresetStyle.card-width;
                        height: PresetStyle.card-height + PresetStyle.lift;
                        PresetFace {
                            y: pc-touch.has-hover ? 0 : PresetStyle.lift;
                            animate y { duration: 160ms; easing: ease-out-back; }
                            lifted: pc-touch.has-hover;
                            abbreviation: "P4";
                            name: "Portra 400";
                            fill: DS.tint-correction;
                            ink: DS.palette-text-on-fill;
                        }
                        pc-touch := TouchArea { }
                    }
                }
                Cell { caption: "rest"; PresetFace { abbreviation: "B2"; name: "Balance"; fill: DS.tint-unaligned-balance; ink: DS.palette-text-on-fill; } }
                Cell { caption: "lifted"; PresetFace { abbreviation: "B2"; name: "Balance"; fill: DS.tint-unaligned-balance; ink: DS.palette-text-on-fill; lifted: true; } }
                Cell { caption: "the new card"; PresetFace { new: true; } }
                Cell {
                    caption: "separator (Divider), both ways";
                    VerticalLayout {
                        spacing: 16px;
                        Divider { width: 200px; }
                        HorizontalLayout {
                            spacing: DS.space-sm;
                            alignment: start;
                            height: 24px;
                            Label { text: "group"; role: TextRole.value; tone: Tone.secondary; }
                            Divider { vertical: true; }
                            Label { text: "group"; role: TextRole.value; tone: Tone.secondary; }
                        }
                        Divider { width: 200px; engraved: false; }
                    }
                }
            }

            Row {
                title: "WRAPPED CARD";
                source: "wrapped.slint · WrappedView.swift:115";
                Cell {
                    caption: "on the year's black";
                    Rectangle {
                        background: #000000;
                        width: card.width + 48px;
                        height: card.height + 48px;
                        card := WrappedCard { eyebrow: "FRAMES"; figure: "1 284"; caption: "developed this year"; }
                    }
                }
            }

            Row {
                title: "WELLS";
                source: "DSPlotScreen.swift:11 · DSTextField.swift:26 · DSToggle.swift:60";
                Cell { caption: "plot screen"; PlotScreen { } }
                Cell { caption: "plot screen, no grid"; PlotScreen { grid: false; } }
            }

            Row {
                title: "DSPOPOVER · PopupPanel, Popover";
                source: "menu.slint, surfaces.slint · DSPopover.swift:68 · dsFloating :89";
                Cell {
                    caption: "live: click the key";
                    Rectangle {
                        width: 240px;
                        height: 200px;
                        key := Button {
                            x: (parent.width - self.width) / 2;
                            y: 0;
                            text: "Display P3";
                            clicked => { pop.show(); }
                        }
                        pop := PopupPanel {
                            x: (parent.width - 240px) / 2;
                            y: key.height;
                            span: 240px;
                            Label { text: "Display P3"; }
                            Label { text: "sRGB"; tone: Tone.secondary; }
                            Label { text: "Adobe RGB (1998)"; tone: Tone.secondary; }
                        }
                    }
                }
                Cell {
                    caption: "tail centred";
                    Popover {
                        width: 200px;
                        pad: Gap.m;
                        Label { text: "A panel hung under its key."; tone: Tone.secondary; wrap: word-wrap; }
                    }
                }
                Cell {
                    caption: "tail leading (wider panel)";
                    Popover {
                        width: 260px;
                        tail-x: 30px;
                        pad: Gap.m;
                        Label { text: "Laid from the anchor's left edge."; tone: Tone.secondary; wrap: word-wrap; }
                    }
                }
                Cell { caption: "menu (no tail)"; Popover { width: 180px; menu: true; tail: false; pad: Gap.xs; Label { text: "Reveal in Finder"; } } }
                Cell { caption: "TipCard, help bubble"; TipCard { card: true; text: "A block's own note, shown only on hover instead of printed underneath."; } }
                Cell { caption: "TipCard, tooltip"; TipCard { text: "Reset the balance"; } }
            }

            Row {
                title: "DSDIALOG · AskSheet";
                source: "containers.slint · DSDialog.swift:48";
                Cell {
                    caption: "live: answered " + root.answer;
                    Rectangle {
                        width: SheetStyle.width;
                        height: ask.hung-height;
                        ask := AskSheet {
                            title: "Apply the Balance to 12 Photos?";
                            message: "Each photo keeps its own crop. The balance can be undone.";
                            cancel: "Cancel";
                            keys: [{ text: "Apply", role: AskRole.confirm }];
                            answered(i) => { root.answer = i < 0 ? "Cancel" : "Apply"; }
                        }
                    }
                }
                Cell {
                    caption: "destructive";
                    Rectangle {
                        width: SheetStyle.width;
                        height: trash.hung-height;
                        trash := AskSheet {
                            title: "Move 3 Photos to the Trash?";
                            message: "Their settings are lost. The originals go to the Trash, where they can be put back.";
                            cancel: "Cancel";
                            keys: [{ text: "Move to Trash", role: AskRole.destructive }];
                        }
                    }
                }
            }

            Row {
                title: "DSSTATUSBAR · StatusBar";
                source: "forms.slint · DSStatusBar.swift:5";
                Cell {
                    caption: "live: click cycles idle, counted, no total";
                    Rectangle {
                        width: 520px;
                        height: live-bar.height;
                        live-bar := StatusBar {
                            busy: root.status-mode != 0;
                            text: root.status-mode == 0 ? "Roll #8 · 36 frames · Nikon Z f" : "Importing";
                            seal: "RGB";
                            count: root.status-mode == 1 ? root.status-done + "/40" : "";
                            fraction: root.status-mode == 1 ? root.status-done / 40 : -1;
                        }
                        TouchArea { clicked => { root.status-mode = Math.mod(root.status-mode + 1, 3); } }
                    }
                }
                Cell {
                    caption: "idle with seal; loading 12/40; loading, no total";
                    VerticalLayout {
                        spacing: 8px;
                        width: 420px;
                        StatusBar { text: "Roll #8 · 36 frames · Nikon Z f"; seal: "RGB"; }
                        StatusBar { busy: true; text: "Importing"; count: "12/40"; fraction: 0.3; }
                        StatusBar { busy: true; text: "Reading the roll"; }
                    }
                }
            }

            Row {
                title: "DSPROGRESS · Progress";
                source: "forms.slint · DSProgress.swift:5";
                Cell {
                    caption: "live: click to set";
                    live-progress := Progress {
                        width: 220px;
                        fraction: root.live-fraction;
                        TouchArea { clicked => { root.live-fraction = clamp(self.mouse-x / self.width, 0, 1); } }
                    }
                }
                Cell { caption: "0 %"; Progress { width: 160px; fraction: 0; } }
                Cell { caption: "40 %"; Progress { width: 160px; fraction: 0.4; } }
                Cell { caption: "100 %"; Progress { width: 160px; fraction: 1; } }
                Cell { caption: "no total (sweeps)"; Progress { width: 160px; fraction: -1; } }
            }

            Row {
                title: "DSWARNING";
                source: "DSWarning.swift:5 · flat in Swift";
                Cell { caption: "with a title"; Warning { title: "Read-only"; text: "Settings will not be saved for this roll."; } }
                Cell { caption: "sentence only"; Warning { text: "This camera's colour matrix is estimated."; } }
                Cell { caption: "dismissable"; Warning { title: "Low disk space"; text: "Exports may fail below 2 GB."; dismissable: true; } }
            }

            Row {
                title: "DSBADGE";
                source: "badge.slint · DSBadge.swift:4 · flat in Swift, no relief";
                Cell {
                    caption: "dark, warning, step and tint on the photo";
                    Ground {
                        photo: true;
                        Badge { text: "R 0.2133   G 0.1782   B 0.1394"; }
                        Badge { tone: BadgeTone.warning; text: "Read-only: settings will not be saved"; }
                        Badge { tone: BadgeTone.step; text: "3"; }
                        Badge { tone: BadgeTone.tint; text: "P4"; fill: DS.tint-correction; ink: DS.palette-text-on-fill; }
                    }
                }
            }

            Row {
                title: "DSSLICE";
                source: "DSSlice.swift:5";
                Text { text: "No surface: a block re-evaluated only when its key changes, a SwiftUI performance wrapper with nothing to draw."; font-size: 11px; color: DS.palette-text-secondary; }
            }
        }
    }
}
