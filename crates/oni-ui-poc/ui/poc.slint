// One editor surface: the canvas card and a 340-point panel holding one block, Lighting's Exposure.
import "../fonts/Inter.ttf";

// `DSTokens` values the proof of concept reads; `Color.primary` resolves to the dark appearance's label white.
export global DS {
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 16px;
    out property <length> space-lg: 24px;
    out property <length> radius-card: 12px;
    out property <length> radius-track: 6px;
    out property <length> track-height: 14px;
    out property <length> handle-thickness: 24px;
    out property <length> handle-length: 34px;
    out property <length> panel-width: 340px;
    out property <length> canvas-padding: 40px;
    out property <float> knob-grow: 1.07;
    out property <color> panel: #282828;
    out property <color> canvas: #1b1b1b;
    out property <color> primary: #ffffffd8;
    out property <color> secondary: #ffffff8c;
    out property <color> track: #ffffff27;
    out property <color> track-fill: #ffffff57;
    out property <color> recess: #000000a6;
    out property <color> rim: #ffffff66;
    out property <color> groove: #00000073;
    out property <color> groove-light: #ffffff0f;
}

component Separator inherits VerticalLayout {
    Rectangle { height: 1px; background: DS.groove; }
    Rectangle { height: 1px; background: DS.groove-light; }
}

// `DSReadout`: the label at the left, the value at the right in the value face.
component Readout inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: DS.space-sm;
    Text { text: root.label; font-family: "Inter"; font-size: 13px; color: DS.primary; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    Text { text: root.value; font-family: "Inter"; font-size: 11px; color: DS.secondary; vertical-alignment: center; }
}

// `DSRail`: drawn past the travel by the knob's half-width at both ends, filled flat up to the value.
component Rail inherits Rectangle {
    in property <float> fraction;
    in property <length> span;
    in property <length> overhang;
    x: -self.overhang;
    width: self.span + 2 * self.overhang;
    height: DS.track-height;
    border-radius: DS.radius-track;
    background: DS.track;
    Rectangle {
        x: 0;
        width: root.overhang + clamp(root.fraction, 0, 1) * root.span;
        border-top-left-radius: DS.radius-track;
        border-bottom-left-radius: DS.radius-track;
        // Square inside the rail, rounded as it reaches the rail's own end corners.
        border-top-right-radius: max(0px, DS.radius-track - (root.width - self.width));
        border-bottom-right-radius: max(0px, DS.radius-track - (root.width - self.width));
        background: DS.track-fill;
    }
    // The hollow: the shadow outside the outline dropped inside, darkest at the upper rim.
    Rectangle {
        y: 0;
        height: 4px;
        border-top-left-radius: DS.radius-track;
        border-top-right-radius: DS.radius-track;
        background: @linear-gradient(180deg, DS.recess 0%, transparent 100%);
    }
    Rectangle { border-radius: DS.radius-track; border-width: 1px; border-color: black; }
    // The lit lower rim, outside the hollow.
    Rectangle { y: parent.height; x: DS.radius-track; width: parent.width - 2 * DS.radius-track; height: 1px; background: DS.rim; }
}

// `DSSlider`: the readout, then a track whose whole row grabs; the knob is the keycap raster.
component Slider inherits VerticalLayout {
    in property <string> label;
    in property <string> readout;
    // The value the settings hold, which accessibility reads where the readout shows the hand's.
    in property <string> value-text;
    in property <float> fraction;
    in property <image> knob;
    in property <bool> enabled: true;
    out property <length> knob-centre-x: track.absolute-position.x + track.width * clamp(root.fraction, 0, 1);
    out property <length> knob-centre-y: track.absolute-position.y + track.height / 2;
    out property <length> track-width: track.width;
    // Rust answers whether this press is the second of a double click.
    callback press(bool) -> bool;
    callback drag(length, length, bool);
    callback release();
    // Rust answers whether the scroll runs along the track; one across it is left to the panel.
    callback scroll(length, length, length, bool) -> bool;
    callback step(int);
    spacing: DS.space-xs;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.step(1); }
    accessible-action-decrement => { root.step(-1); }

    Readout { label: root.label; value: root.readout; opacity: root.enabled ? 1 : 0.4; }
    HorizontalLayout {
        padding-left: DS.handle-thickness / 2;
        padding-right: DS.handle-thickness / 2;
        track := Rectangle {
            height: DS.handle-length;
            Rail { y: (parent.height - self.height) / 2; fraction: root.fraction; span: parent.width; overhang: DS.handle-thickness / 2; }
            knob := Image {
                property <float> grow: (area.over-knob || area.held) ? DS.knob-grow : 1;
                source: root.knob;
                width: DS.handle-thickness * self.grow;
                height: DS.handle-length * self.grow;
                x: parent.width * clamp(root.fraction, 0, 1) - self.width / 2;
                y: (parent.height - self.height) / 2;
                image-fit: fill;
                animate grow { duration: 150ms; easing: ease-out-back; }
            }
            area := TouchArea {
                enabled: root.enabled;
                in-out property <bool> held;
                property <bool> fine;
                out property <bool> over-knob: self.has-hover
                    && abs(self.mouse-x - parent.width * clamp(root.fraction, 0, 1)) <= DS.handle-thickness / 2;
                mouse-cursor: self.held ? MouseCursor.grabbing : self.over-knob ? MouseCursor.grab : MouseCursor.default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.fine = event.modifiers.alt;
                        self.held = !root.press(self.fine);
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        if (event.button == PointerEventButton.left || event.kind == PointerEventKind.cancel) {
                            self.held = false;
                            root.release();
                        }
                    } else if (event.kind == PointerEventKind.move) {
                        self.fine = event.modifiers.alt;
                    }
                }
                moved => {
                    if (self.held) {
                        root.drag(self.mouse-x - self.pressed-x, track.width, self.fine);
                    }
                }
                scroll-event(event) => {
                    if (root.scroll(event.delta-x, event.delta-y, track.width, event.modifiers.alt)) {
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }
        }
    }
}

// The `DSSection` frame: groove, then the title row and the block's controls.
component Section inherits VerticalLayout {
    in property <string> title;
    Separator { }
    VerticalLayout {
        padding-left: DS.space-md;
        padding-right: DS.space-md;
        padding-top: DS.space-lg;
        padding-bottom: DS.space-lg;
        spacing: DS.space-sm;
        Text { text: root.title; font-family: "Inter"; font-size: 13px; color: DS.primary; }
        @children
    }
}

export component MainWindow inherits Window {
    in property <image> frame;
    in property <string> exposure-readout;
    in property <string> exposure-value;
    in property <float> exposure-fraction;
    in property <image> knob;
    out property <length> knob-centre-x: exposure.knob-centre-x;
    out property <length> knob-centre-y: exposure.knob-centre-y;
    out property <length> track-width: exposure.track-width;
    out property <length> canvas-x: card.absolute-position.x;
    out property <length> canvas-y: card.absolute-position.y;
    out property <length> canvas-width: card.width;
    out property <length> canvas-height: card.height;
    callback press <=> exposure.press;
    callback drag <=> exposure.drag;
    callback release <=> exposure.release;
    callback scroll <=> exposure.scroll;
    callback step <=> exposure.step;
    title: "Open Negative Initiative";
    min-width: 1100px;
    min-height: 680px;
    preferred-width: 1100px;
    preferred-height: 680px;
    background: DS.panel;

    HorizontalLayout {
        card := Rectangle {
            horizontal-stretch: 1;
            background: DS.canvas;
            border-radius: DS.radius-card;
            clip: true;
            Image {
                x: DS.canvas-padding;
                y: DS.canvas-padding;
                width: parent.width - 2 * DS.canvas-padding;
                height: parent.height - 2 * DS.canvas-padding;
                source: root.frame;
                image-fit: contain;
            }
        }
        VerticalLayout {
            width: DS.panel-width;
            alignment: start;
            Rectangle { height: 150px; }
            Section {
                title: "Lighting";
                exposure := Slider {
                    label: "Exposure";
                    readout: root.exposure-readout;
                    value-text: root.exposure-value;
                    fraction: root.exposure-fraction;
                    knob: root.knob;
                }
            }
        }
    }
}
