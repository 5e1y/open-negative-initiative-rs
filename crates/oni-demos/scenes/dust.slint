// Dust & Scratches: a detail of the photograph under the brush's disc. The hand paints over a hair;
// its patch lands, with the stroke's mark and the place it was copied from.
import { Colour, Space, Type, Stroke, Picture, Ring, Trace, TraceTone, CorrectionMark } from "../../oni-ui/ui/ds/ds.slint";
export { Raster, Depth } from "../../oni-ui/ui/ds/ds.slint";

export component Dust inherits Window {
    in property <image> photo;
    in property <length> brush-diameter;
    // Paths in the photograph's points: the stroke being painted, the copied stroke and the dashed
    // line to it, as the canvas draws them.
    in property <string> stroke;
    in property <string> source;
    in property <string> source-line;
    in property <length> stroke-width;
    in property <bool> marked;
    in property <length> mark-x;
    in property <length> mark-y;
    in property <length> mark-width;
    in property <length> mark-height;
    background: Colour.ground;
    default-font-family: Type.family;
    out property <length> photo-x: picture.absolute-position.x;
    out property <length> photo-y: picture.absolute-position.y;
    out property <length> photo-width: picture.width;
    out property <length> photo-height: picture.height;
    VerticalLayout {
        padding: Space.m;
        picture := Picture {
            source: root.photo;
            rounded: true;
            vertical-stretch: 1;
            if root.source != "": Trace {
                tone: TraceTone.source;
                width: parent.width;
                height: parent.height;
                commands: root.source;
                thickness: root.stroke-width;
            }
            if root.source-line != "": Trace {
                tone: TraceTone.source;
                dashed: true;
                width: parent.width;
                height: parent.height;
                commands: root.source-line;
                thickness: Stroke.line;
            }
            if root.marked: CorrectionMark {
                x: root.mark-x;
                y: root.mark-y;
                width: root.mark-width;
                height: root.mark-height;
                number: 1;
            }
            if root.stroke != "": Trace {
                width: parent.width;
                height: parent.height;
                commands: root.stroke;
                thickness: root.stroke-width;
            }
            // The disc follows the pointer over the photograph, as on the canvas.
            if paint.has-hover: Ring {
                centre-x: paint.mouse-x;
                centre-y: paint.mouse-y;
                diameter: root.brush-diameter;
            }
            paint := TouchArea { }
        }
    }
}
