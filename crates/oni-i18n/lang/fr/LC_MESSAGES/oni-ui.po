msgid "One item could not be put back: its folder moved or a file took its name."
msgid_plural "{n} of the items could not be put back: their folder moved or a file took their name."
msgstr[0] "Un élément n’a pas pu être remis en place : son dossier a été déplacé ou un fichier a pris son nom."
msgstr[1] "{n} éléments n’ont pas pu être remis en place : leur dossier a été déplacé ou un fichier a pris leur nom."

#: crates/oni-library/src/roll_folder.rs
msgid "One item could not be moved into the roll again: its folder moved or a file took its name."
msgid_plural "{n} of the items could not be moved into the roll again: their folder moved or a file took their name."
msgstr[0] "Un élément n’a pas pu être remis dans la pellicule : son dossier a été déplacé ou un fichier a pris son nom."
msgstr[1] "{n} éléments n’ont pas pu être remis dans la pellicule : leur dossier a été déplacé ou un fichier a pris leur nom."

#: crates/oni-library/src/trash.rs
msgid "{head}: a newer version of ONI wrote their settings, and this one never rewrites them."
msgstr "{head} : une version plus récente d’ONI a écrit les réglages concernés, et celle-ci ne les réécrit jamais."

#: crates/oni-library/src/trash.rs
msgid "{file} could not be written ({cause})"
msgstr "{file} n’a pas pu être écrit ({cause})"

#: crates/oni-library/src/trash.rs
msgid "{head}: {files}."
msgstr "{head} : {files}."

#: crates/oni-library/src/trash.rs
msgid "One photo was not restored"
msgid_plural "{n} photos were not restored"
msgstr[0] "Une photo n’a pas été restaurée"
msgstr[1] "{n} photos n’ont pas été restaurées"

#: crates/oni-library/src/trash.rs
msgid "One photo was not moved to the ONI Trash"
msgid_plural "{n} photos were not moved to the ONI Trash"
msgstr[0] "Une photo n’a pas été placée dans la Corbeille ONI"
msgstr[1] "{n} photos n’ont pas été placées dans la Corbeille ONI"

#: crates/oni-library/src/trash.rs
msgid "and {n} other"
msgid_plural "and {n} others"
msgstr[0] "et {n} autre"
msgstr[1] "et {n} autres"

#: crates/oni-library/src/trash.rs
msgid "The other photo is back in its folder."
msgid_plural "The other {n} photos are back in their folders."
msgstr[0] "L’autre photo est revenue dans son dossier."
msgstr[1] "Les {n} autres photos sont revenues dans leurs dossiers."

#: crates/oni-library/src/trash.rs
msgid "The other photo went to the ONI Trash."
msgid_plural "The other {n} photos went to the ONI Trash."
msgstr[0] "L’autre photo est partie dans la Corbeille ONI."
msgstr[1] "Les {n} autres photos sont parties dans la Corbeille ONI."

#: crates/oni-export/src/lib.rs
msgid "The RAW file could not be decoded."
msgstr "Le fichier RAW n’a pas pu être décodé."

#: crates/oni-export/src/lib.rs
msgid "Full-resolution rendering failed."
msgstr "Le rendu en pleine résolution a échoué."

#: crates/oni-export/src/lib.rs
msgid "The ICC profile chosen for the export can no longer be read."
msgstr "Le profil ICC choisi pour l’export n’est plus lisible."

#: crates/oni-export/src/lib.rs
msgid "The disk is full: the file could not be written. A file already there is kept."
msgstr "Le disque est plein : le fichier n’a pas pu être écrit. Un fichier déjà présent est conservé."

#: crates/oni-export/src/lib.rs
msgid "The disk is read-only: the file could not be written."
msgstr "Le disque est en lecture seule : le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "ONI is not allowed to write in that folder. A file already there is kept."
msgstr "ONI n’a pas le droit d’écrire dans ce dossier. Un fichier déjà présent est conservé."

#: crates/oni-export/src/lib.rs
msgid "The folder is no longer there: the file could not be written."
msgstr "Le dossier n’est plus là : le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "The file could not be written."
msgstr "Le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "Too large for a JPEG, which holds at most 65,535 pixels a side and a 16.7 MB profile: choose TIFF or a smaller size."
msgstr "Trop grand pour un JPEG, qui tient au plus 65 535 pixels de côté et un profil de 16,7 Mo : choisissez TIFF ou une taille plus petite."

#: crates/oni-export/src/lib.rs
msgid "A file ONI did not export already has that name, an original perhaps: it is left as it was. Pick another folder or another name."
msgstr "Un fichier qu’ONI n’a pas exporté porte déjà ce nom, un original peut-être : il est laissé tel quel. Choisissez un autre dossier ou un autre nom."
