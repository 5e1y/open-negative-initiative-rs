msgstr "M"

#: crates/oni-ui/ui/panel/color_tab.slint
msgid "M −: toward green"
msgstr "M − : vers le vert"

#: crates/oni-ui/ui/panel/color_tab.slint
msgid "M +: toward magenta"
msgstr "M + : vers le magenta"

#: crates/oni-ui/ui/panel/color_tab.slint
