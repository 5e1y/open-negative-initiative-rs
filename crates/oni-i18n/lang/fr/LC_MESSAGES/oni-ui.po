#: crates/oni-library/src/project.rs
msgid "It holds no photos. Nothing else is affected."
msgstr "Il ne contient aucune photo. Rien d’autre n’est touché."

#: crates/oni-library/src/project.rs
msgid "Delete “{name}”?"
msgstr "Supprimer « {name} » ?"

#: crates/oni-library/src/project.rs
msgid "It stops grouping its {n} photo. The photos, their settings and every other project or roll they belong to are untouched."
msgid_plural "It stops grouping its {n} photos. The photos, their settings and every other project or roll they belong to are untouched."
msgstr[0] "Il ne regroupera plus son unique photo. Cette photo, ses réglages et tous les autres projets ou pellicules dont elle fait partie restent intacts."
msgstr[1] "Il ne regroupera plus ses {n} photos. Les photos, leurs réglages et tous les autres projets ou pellicules dont elles font partie restent intacts."

#: crates/oni-library/src/refusal.rs
msgid "The original cannot be found, its disk disconnected or the file moved. Nothing was changed."
msgstr "L’original est introuvable : son disque est débranché ou le fichier a été déplacé. Rien n’a été modifié."

#: crates/oni-library/src/refusal.rs
msgid "A newer version of ONI wrote these settings, and this one never rewrites them."
msgstr "Une version plus récente d’ONI a écrit ces réglages, et celle-ci ne les réécrit jamais."

#: crates/oni-library/src/refusal.rs
msgid "The photo's name is too long for a settings file beside it. Shorten the name to keep its edits."
msgstr "Le nom de la photo est trop long pour un fichier de réglages à côté d’elle. Raccourcissez-le pour garder ses modifications."

#: crates/oni-library/src/refusal.rs crates/oni-library/src/roll_folder/carry.rs
msgid "another app is using it"
msgstr "une autre app l’utilise"

#: crates/oni-library/src/refusal.rs
msgid "it is no longer there"
msgstr "il n’est plus là"

#: crates/oni-library/src/refusal.rs
msgid "it cannot be written to"
msgstr "on ne peut pas y écrire"

#: crates/oni-library/src/refusal.rs
msgid "an item of that name is already there"
msgstr "un élément de ce nom s’y trouve déjà"

#: crates/oni-library/src/refusal.rs
msgid "its disk is read-only"
msgstr "son disque est en lecture seule"

#: crates/oni-library/src/refusal.rs
msgid "the disk is full"
msgstr "le disque est plein"

#: crates/oni-library/src/refusal.rs
msgid "the disk refuses that name"
msgstr "le disque refuse ce nom"

#: crates/oni-library/src/refusal.rs crates/oni-library/src/trash.rs
msgid "{head}: {why}"
msgstr "{head} : {why}"

#: crates/oni-library/src/refusal.rs
msgid "its original cannot be found, its disk disconnected or the file moved. Nothing was changed."
msgid_plural "their originals cannot be found, their disk disconnected or the files moved. Nothing was changed."
msgstr[0] "son original est introuvable (disque débranché ou fichier déplacé). Rien n’a été modifié."
msgstr[1] "leurs originaux sont introuvables (disque débranché ou fichiers déplacés). Rien n’a été modifié."

#: crates/oni-library/src/refusal.rs
msgid "its original cannot be found, its disk disconnected or the file moved."
msgid_plural "their originals cannot be found, their disk disconnected or the files moved."
msgstr[0] "son original est introuvable (disque débranché ou fichier déplacé)."
msgstr[1] "leurs originaux sont introuvables (disque débranché ou fichiers déplacés)."

#: crates/oni-library/src/refusal.rs
msgid "One photo was left out"
msgid_plural "{n} photos were left out"
msgstr[0] "Une photo a été laissée de côté"
msgstr[1] "{n} photos ont été laissées de côté"

#: crates/oni-library/src/roll_folder/carry.rs
msgid "it lies on another disk"
msgstr "il se trouve sur un autre disque"

#: crates/oni-library/src/roll_folder/carry.rs
msgid "“{name}” is already there"
msgstr "« {name} » s’y trouve déjà"

#: crates/oni-library/src/roll_folder/carry.rs
msgid "{file}: {cause}"
msgstr "{file} : {cause}"

#: crates/oni-library/src/roll_folder/carry.rs
msgid "; {file} could not go back to “{folder}” ({cause})"
msgstr " ; {file} n’a pas pu revenir dans « {folder} » ({cause})"

#: crates/oni-library/src/roll_folder/carry.rs
msgid "“{frame}” stayed where it was: {why}."
msgstr "« {frame} » est resté à sa place : {why}."

#: crates/oni-library/src/roll_folder/carry.rs
msgid "And one other frame."
msgid_plural "And {n} other frames."
msgstr[0] "Et une autre vue."
msgstr[1] "Et {n} autres vues."

#: crates/oni-library/src/roll_folder.rs
msgid "New Roll moves the photos of one folder into a folder made inside it, and these lie in {count} folders. Pick the photos of one folder, then make the roll."
msgstr "Nouvelle pellicule déplace les photos d’un seul dossier dans un dossier créé à l’intérieur, et celles-ci sont dans {count} dossiers. Choisissez les photos d’un seul dossier, puis créez la pellicule."

#: crates/oni-library/src/roll_folder.rs
msgid "Nothing moved: a folder “{name}” was made in “{parent}” since, and ONI moves no photo into a folder it did not make."
msgstr "Rien n’a été déplacé : un dossier « {name} » a été créé depuis dans « {parent} », et ONI ne déplace aucune photo dans un dossier qu’il n’a pas créé."

#: crates/oni-library/src/roll_folder.rs
msgid "One item could not be put back: its folder moved or a file took its name."
msgid_plural "{n} of the items could not be put back: their folder moved or a file took their name."
msgstr[0] "Un élément n’a pas pu être remis en place : son dossier a été déplacé ou un fichier a pris son nom."
msgstr[1] "{n} éléments n’ont pas pu être remis en place : leur dossier a été déplacé ou un fichier a pris leur nom."

#: crates/oni-library/src/roll_folder.rs
msgid "One item could not be moved into the roll again: its folder moved or a file took its name."
msgid_plural "{n} of the items could not be moved into the roll again: their folder moved or a file took their name."
msgstr[0] "Un élément n’a pas pu être remis dans la pellicule : son dossier a été déplacé ou un fichier a pris son nom."
msgstr[1] "{n} éléments n’ont pas pu être remis dans la pellicule : leur dossier a été déplacé ou un fichier a pris leur nom."

#: crates/oni-library/src/trash.rs
msgid "{head}: a newer version of ONI wrote their settings, and this one never rewrites them."
msgstr "{head} : une version plus récente d’ONI a écrit les réglages concernés, et celle-ci ne les réécrit jamais."

#: crates/oni-library/src/trash.rs
msgid "{file} could not be written ({cause})"
msgstr "{file} n’a pas pu être écrit ({cause})"

#: crates/oni-library/src/trash.rs
msgid "{head}: {files}."
msgstr "{head} : {files}."

#: crates/oni-library/src/trash.rs
msgid "One photo was not restored"
msgid_plural "{n} photos were not restored"
msgstr[0] "Une photo n’a pas été restaurée"
msgstr[1] "{n} photos n’ont pas été restaurées"

#: crates/oni-library/src/trash.rs
msgid "One photo was not moved to the ONI Trash"
msgid_plural "{n} photos were not moved to the ONI Trash"
msgstr[0] "Une photo n’a pas été placée dans la Corbeille ONI"
msgstr[1] "{n} photos n’ont pas été placées dans la Corbeille ONI"

#: crates/oni-library/src/trash.rs
msgid "and {n} other"
msgid_plural "and {n} others"
msgstr[0] "et {n} autre"
msgstr[1] "et {n} autres"

#: crates/oni-library/src/trash.rs
msgid "The other photo is back in its folder."
msgid_plural "The other {n} photos are back in their folders."
msgstr[0] "L’autre photo est revenue dans son dossier."
msgstr[1] "Les {n} autres photos sont revenues dans leurs dossiers."

#: crates/oni-library/src/trash.rs
msgid "The other photo went to the ONI Trash."
msgid_plural "The other {n} photos went to the ONI Trash."
msgstr[0] "L’autre photo est partie dans la Corbeille ONI."
msgstr[1] "Les {n} autres photos sont parties dans la Corbeille ONI."

#: crates/oni-export/src/lib.rs
msgid "The RAW file could not be decoded."
msgstr "Le fichier RAW n’a pas pu être décodé."

#: crates/oni-export/src/lib.rs
msgid "Full-resolution rendering failed."
msgstr "Le rendu en pleine résolution a échoué."

#: crates/oni-export/src/lib.rs
msgid "The ICC profile chosen for the export can no longer be read."
msgstr "Le profil ICC choisi pour l’export n’est plus lisible."

#: crates/oni-export/src/lib.rs
msgid "The disk is full: the file could not be written. A file already there is kept."
msgstr "Le disque est plein : le fichier n’a pas pu être écrit. Un fichier déjà présent est conservé."

#: crates/oni-export/src/lib.rs
msgid "The disk is read-only: the file could not be written."
msgstr "Le disque est en lecture seule : le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "ONI is not allowed to write in that folder. A file already there is kept."
msgstr "ONI n’a pas le droit d’écrire dans ce dossier. Un fichier déjà présent est conservé."

#: crates/oni-export/src/lib.rs
msgid "The folder is no longer there: the file could not be written."
msgstr "Le dossier n’est plus là : le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "The file could not be written."
msgstr "Le fichier n’a pas pu être écrit."

#: crates/oni-export/src/lib.rs
msgid "A file ONI did not export already has that name, an original perhaps: it is left as it was. Pick another folder or another name."
msgstr "Un fichier qu’ONI n’a pas exporté porte déjà ce nom, un original peut-être : il est laissé tel quel. Choisissez un autre dossier ou un autre nom."
