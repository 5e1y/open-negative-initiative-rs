// The archive tree and the gallery grid; both draw only what is on screen.
import { ListView, Section, TextField, TreeItem, RowKind, TileView, TileHeading, Surface, Ground, Label, Tone, TextRole, Space, ShellStyle } from "ds/ds.slint";

export struct Tile {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    picture: image,
    caption: string,
    selected: bool,
    medal: int,
}

export struct Heading {
    y: length,
    title: string,
    caption: string,
}

export struct TreeRow {
    depth: int,
    title: string,
    caption: string,
    // 0 a folder, 1 a roll, 2 a photo.
    kind: int,
    expandable: bool,
    expanded: bool,
    selected: bool,
}

export global Library {
    in property <[TreeRow]> rows;
    // Only the tiles in view and one row either side, placed in the grid's own coordinates.
    in property <[Tile]> tiles;
    in property <[Heading]> headings;
    in property <length> content-height;
    in property <length> scroll;
    in property <string> roll-title;
    in property <string> stock;
    in-out property <string> description;
    callback row-clicked(int);
    callback tile-clicked(int, bool, bool);
    callback tile-opened(int);
    callback scrolled(length);
    callback resized(length, length);
}

export component Tree inherits Surface {
    ListView {
        for row[i] in Library.rows: TreeItem {
            depth: row.depth;
            title: row.title;
            caption: row.caption;
            kind: row.kind == 0 ? RowKind.folder : row.kind == 1 ? RowKind.roll : RowKind.photo;
            expandable: row.expandable;
            expanded: row.expanded;
            selected: row.selected;
            clicked => { Library.row-clicked(i); }
        }
    }
}

export component Grid inherits Surface {
    ground: Ground.canvas;
    clip: true;
    changed width => { Library.resized(self.width, self.height); }
    changed height => { Library.resized(self.width, self.height); }
    // The content is the scroll area's child, so a scroll a tile leaves unhandled reaches it.
    TouchArea {
        scroll-event(event) => {
            Library.scrolled(-event.delta-y);
            EventResult.accept
        }
        Rectangle {
            y: -Library.scroll;
            width: parent.width;
            height: Library.content-height;
            for h in Library.headings: TileHeading {
                x: Space.l;
                y: h.y;
                width: root.width - 2 * Space.l;
                title: h.title;
                caption: h.caption;
            }
            for t in Library.tiles: TileView {
                x: t.x;
                y: t.y;
                width: t.width;
                picture-height: t.height;
                picture: t.picture;
                caption: t.caption;
                selected: t.selected;
                medal: t.medal;
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            Library.tile-clicked(t.index, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                        }
                    }
                    double-clicked => { Library.tile-opened(t.index); }
                }
            }
        }
    }
}

// `InfoSidebar`: the selected photo's roll, its stock and a description.
export component Info inherits Surface {
    width: ShellStyle.info-width;
    VerticalLayout {
        alignment: start;
        Section {
            title: "Roll";
            separated: false;
            Label { text: Library.roll-title; }
            Label { text: Library.stock; role: TextRole.value; tone: Tone.secondary; }
        }
        Section {
            title: "Description";
            description := TextField {
                placeholder: "Add a description";
                text <=> Library.description;
            }
        }
    }
}
