// The settings panel: the output plot edge to edge, the tab bar, then one pane per tab.
import { Icons, Colour, Space, Slider, SliderFill, Knob, Section, Tabs, Picker, Button, ButtonKind, IconButton, ButtonGroup, Toggle, LabelledRow, Label, WarningBadge, TextRole, Tone, HistogramFrame, PlotSize, PlotStyle, Surface, ShellStyle, Scroller, ScannerStyle, KeyRow, Keypad, LabCell, LabScreen, Well, HelpMark, Note, Warning, Progress, Field, ContextMenu, MenuLine } from "ds/ds.slint";
import { Store } from "store.slint";
import { News } from "help.slint";
import { Editors, CurvesEditor, LevelsEditor, SpectrogramEditor, SaturationEditor, PrintOverlay } from "editors.slint";
import { Exporting } from "export.slint";

// What changes on its own rhythm, published apart so a tick touches no panel binding.
export global Plots {
    in property <image> output;
    in property <image> levels;
    // The manual curves' input distribution, the channel in focus drawn whole.
    in property <image> curves;
}

export global PanelState {
    in-out property <int> tab: 2;
    // `ConversionMode.allCases`' index of the targets' mode.
    in property <int> film-type;
    // How many photos a paste reaches.
    in property <int> targets: 1;
    callback film-type-picked(int);
    in property <bool> flat-field-on;
    // `SettingsPane.separationFamily`: the family the kernel runs, an index of `Separation.Family`.
    in property <int> dye-family: 2;
    callback dye-family-picked(int);
    // `GainPanel`: the inversion swaps each row's ends, the hue then low.
    in property <bool> gains-inverted: true;
    // A file naming no profile, read as the hand says; a grey one offers two encodings.
    in property <bool> undeclared;
    in property <bool> grey-source;
    in property <int> encoding;
    in property <bool> encoding-modified;
    callback encoding-picked(int);
    // `FlatFieldBlock`: its mask picker, the sliders acting once a mask is chosen.
    in property <bool> monochrome;
    // The open photo is a contact sheet, whose render skips sharpening and chroma denoise.
    in property <bool> sheet;
    in property <string> mask-title;
    in property <[MenuLine]> mask-lines;
    in property <bool> masks-empty;
    in property <bool> masked;
    in property <int> flat-picked;
    in property <bool> can-take-mask;
    in property <bool> can-load-mask;
    in property <bool> can-rename-mask;
    // A mask being set from the photo, or loaded: the key says so and waits.
    in property <bool> taking-mask;
    in property <bool> loading-mask;
    callback flat-field-toggled(bool);
    callback mask-chosen(int);
    callback take-mask();
    callback load-mask();
    callback rename-mask();
    callback mask-folder();
    callback flat-apply-selection();
    // `ColorPane.showsCropWarning`: the frame uncropped and no measuring window drawn.
    in property <bool> crop-first;
    // `SettingsPane`: no Dye Separation in black and white, on RGB passes or on the Scanner face.
    in property <bool> separation-shown: true;
    callback auto-balance();
    callback pick(string);
    callback tab-picked(int);
    // `RollScope`: 0 never measured, 1 measured, 2 its frames still being found.
    in property <int> roll-state: 1;
    in property <int> roll-measured;
    in property <int> roll-unmeasured;
    in property <bool> can-prepare;
    callback prepare-roll();
    callback join-roll();
    callback make-roll();
    // `AutoLevels.Batch`: a run under way, and what the key says it acts on before the click.
    in property <bool> balancing;
    in property <float> balance-fraction;
    in property <string> balance-progress;
    in property <string> balance-note;
}

// The Scanner face: its screen, its keypad's state, and the keys' presses for Rust.
export global Lab {
    in property <bool> shown;
    in-out property <int> machine;
    in property <bool> monochrome;
    in property <string> frame: "FRAME --/--";
    in property <string> machine-line;
    in property <bool> remeasure;
    in property <[LabCell]> cells;
    in property <[string]> finish;
    in property <[string]> legends: ["−3", "−", "+", "+3"];
    // The groups' reset keys, in `LabGroup`'s order: Density, Color, Look, Effects.
    in property <[bool]> modified: [false, false, false, false];
    // A letter by its index in `Letter::ALL` (D, C, M, Y, TEMP), an effect in `Effect`'s order.
    callback press(int, int);
    callback clear(int);
    callback step-effect(int, int);
    callback clear-effect(int);
    callback machine-picked(int);
    callback reset-group(int);
}

component LabBlock inherits Section {
    modified: Lab.modified[self.block];
    reset(b) => { Lab.reset-group(b); }
}

component LetterRow inherits KeyRow {
    in property <int> letter;
    legends: Lab.legends;
    stepped(by) => { Lab.press(root.letter, by); }
    reset => { Lab.clear(root.letter); }
}

component EffectRow inherits KeyRow {
    in property <int> effect;
    legends: Lab.legends;
    stepped(by) => { Lab.step-effect(root.effect, by); }
    reset => { Lab.clear-effect(root.effect); }
}

component StoreSlider inherits Slider {
    press(f, fine) => { return Store.press(f, fine); }
    drag(f, t, s, fine) => { Store.drag(f, t, s, fine); }
    release(f) => { Store.release(f); }
    scroll(f, dx, dy, s, fine) => { return Store.scroll(f, dx, dy, s, fine); }
    step(f, d) => { Store.step(f, d); }
}

component Block inherits Section {
    reset(b) => { Store.reset(b); }
}

// A block whose reset an editor owns, numbered as `Editors.reset` reads it.
component EditorBlock inherits Section {
    reset(b) => { Editors.reset(b); }
}

component Pane inherits Scroller {
    in property <bool> shown;
    visible: self.shown;
    content-height: column.preferred-height;
    column := VerticalLayout {
        width: root.width;
        alignment: start;
        @children
    }
}

component RollPane inherits Pane {
    property <bool> flat-settings;
    Block {
        title: "Measured Roll";
        help: "Every setting here is the roll's: moved on this photo, it reaches every photo measured with it.";
        if PanelState.roll-state == 0: Warning { text: "This photo was never measured with its roll, so these settings act on it alone."; }
        if PanelState.roll-state == 0: Button {
            text: "Prepare the Roll…";
            horizontal-stretch: 1;
            enabled: PanelState.can-prepare;
            clicked => { PanelState.prepare-roll(); }
        }
        if PanelState.roll-state == 1: Note {
            text: PanelState.roll-measured == 1 ? "Acts on this photo, the only one measured with its roll." : "Acts on the \{PanelState.roll-measured} photos measured with this roll.";
        }
        if PanelState.roll-state == 1 && PanelState.roll-unmeasured > 0: Warning {
            text: PanelState.roll-unmeasured == 1 ? "1 photo of this folder was not measured with the roll." : "\{PanelState.roll-unmeasured} photos of this folder were not measured with the roll.";
        }
        if PanelState.roll-state == 1 && PanelState.roll-unmeasured > 0: HorizontalLayout {
            spacing: Space.s;
            Button {
                text: PanelState.roll-unmeasured == 1 ? "Join the Roll" : "Join the \{PanelState.roll-unmeasured}";
                horizontal-stretch: 1;
                help: "Gives them this roll's measurement and settings, their own look kept.";
                clicked => { PanelState.join-roll(); }
            }
            Button {
                text: "Roll of the \{PanelState.roll-measured}";
                horizontal-stretch: 1;
                help: "Makes the photos measured together a roll of their own.";
                clicked => { PanelState.make-roll(); }
            }
        }
        if PanelState.roll-state == 2: Note { text: "Finding the photos measured with this roll…"; }
    }
    Block {
        title: "Film Type";
        help: "What the film is: a colour negative, a slide or black and white.";
        Tabs {
            tabs: ["Negative", "Positive", "B&W"];
            marked: [false, false, false];
            selected: PanelState.film-type;
            picked(i) => { PanelState.film-type-picked(i); }
        }
    }
    Block {
        title: "Flat-Field";
        help: "Evens out uneven lighting from the scanner, whatever you crop to.";
        block: 11;
        modified: Store.flat-field-modified;
        folded: true;
        HorizontalLayout {
            spacing: Space.s;
            Label { text: "Flat-field"; horizontal-stretch: 1; }
            Toggle { label: "Flat-field"; on: PanelState.flat-field-on; toggled(on) => { PanelState.flat-field-toggled(on); } }
            IconButton { icon: Icons.settings; help: root.flat-settings ? "Hide Amount and Color" : "Show Amount and Color"; clicked => { root.flat-settings = !root.flat-settings; } }
        }
        if PanelState.flat-field-on: Picker {
            label: "Mask";
            value: PanelState.mask-title;
            open => { masks.show(); }
        }
        if PanelState.flat-field-on && PanelState.masks-empty: Note { text: "No mask yet: take a frame of the empty light panel, shot on this rig."; }
        Button {
            text: PanelState.taking-mask ? "Setting…" : "Use This Photo as Flat-Field";
            horizontal-stretch: 1;
            enabled: PanelState.can-take-mask;
            clicked => { PanelState.take-mask(); }
        }
        if root.flat-settings: StoreSlider {
            field: 27; label: "Amount"; fraction: Store.flat-amount-fraction; readout: Store.flat-amount-readout; value-text: Store.flat-amount-value;
            enabled: PanelState.masked;
        }
        if root.flat-settings && !PanelState.monochrome: StoreSlider {
            field: 28; label: "Temperature"; fraction: Store.flat-temperature-fraction; readout: Store.flat-temperature-readout; value-text: Store.flat-temperature-value;
            enabled: PanelState.masked; fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        if root.flat-settings && !PanelState.monochrome: StoreSlider {
            field: 29; label: "Tint"; fraction: Store.flat-tint-fraction; readout: Store.flat-tint-readout; value-text: Store.flat-tint-value;
            enabled: PanelState.masked; fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        if root.flat-settings: HorizontalLayout {
            spacing: Space.s;
            Button { text: PanelState.loading-mask ? "Loading…" : "Load…"; horizontal-stretch: 1; enabled: PanelState.can-load-mask; clicked => { PanelState.load-mask(); } }
            Button { text: "Rename"; horizontal-stretch: 1; enabled: PanelState.can-rename-mask; clicked => { PanelState.rename-mask(); } }
            Button { text: "Folder"; horizontal-stretch: 1; clicked => { PanelState.mask-folder(); } }
        }
        if root.flat-settings: Button {
            text: "Apply to Selection";
            horizontal-stretch: 1;
            enabled: PanelState.flat-picked > 0;
            clicked => { PanelState.flat-apply-selection(); }
        }
        masks := ContextMenu {
            lines: PanelState.mask-lines;
            chosen(i) => { PanelState.mask-chosen(i); masks.close(); }
        }
    }
    if PanelState.undeclared: Block {
        title: "Source Encoding";
        help: "This file names no color profile, so it is read as sRGB. A scanner's raw output is often linear: pick what the scanning software wrote, and the photograph is read again.";
        block: 12;
        modified: PanelState.encoding-modified;
        folded: true;
        Field {
            label: "Read as";
            Tabs {
                tabs: PanelState.grey-source ? ["sRGB", "Linear"] : ["sRGB", "Linear", "Display P3"];
                selected: PanelState.encoding;
                picked(i) => { PanelState.encoding-picked(i); }
            }
        }
    }
    Block {
        title: "Source Balance";
        block: 10;
        modified: Store.source-balance-modified;
        folded: true;
        StoreSlider {
            field: 24; label: PanelState.gains-inverted ? "Red ↔ Cyan" : "Cyan ↔ Red"; fraction: Store.gain-red-fraction; readout: Store.gain-red-readout; value-text: Store.gain-red-value;
            fill: SliderFill.bipolar; low: PanelState.gains-inverted ? Colour.channel-red : Colour.channel-cyan; high: PanelState.gains-inverted ? Colour.channel-cyan : Colour.channel-red;
        }
        StoreSlider {
            field: 25; label: PanelState.gains-inverted ? "Green ↔ Magenta" : "Magenta ↔ Green"; fraction: Store.gain-green-fraction; readout: Store.gain-green-readout; value-text: Store.gain-green-value;
            fill: SliderFill.bipolar; low: PanelState.gains-inverted ? Colour.channel-green : Colour.channel-magenta; high: PanelState.gains-inverted ? Colour.channel-magenta : Colour.channel-green;
        }
        StoreSlider {
            field: 26; label: PanelState.gains-inverted ? "Blue ↔ Yellow" : "Yellow ↔ Blue"; fraction: Store.gain-blue-fraction; readout: Store.gain-blue-readout; value-text: Store.gain-blue-value;
            fill: SliderFill.bipolar; low: PanelState.gains-inverted ? Colour.channel-blue : Colour.channel-yellow; high: PanelState.gains-inverted ? Colour.channel-yellow : Colour.channel-blue;
        }
    }
    // Between the balance that feeds it and the windows placed on it, where it acts.
    Block {
        title: "Density Ceiling";
        help: "Reveals more detail in the densest parts of the negative, at the cost of more visible noise there.";
        block: 4;
        modified: Store.density-ceiling-modified;
        folded: true;
        StoreSlider { field: 12; label: "Ceiling"; fraction: Store.density-ceiling-fraction; readout: Store.density-ceiling-readout; value-text: Store.density-ceiling-value; }
    }
    if !Editors.scanner-face: EditorBlock {
        title: "Per-Channel Levels";
        block: 1;
        modified: Editors.levels-modified;
        folded <=> Editors.levels-folded;
        LevelsEditor { histogram: Plots.levels; }
        if Editors.low-precision: HorizontalLayout {
            alignment: start;
            WarningBadge { text: "8-bit source — 256 levels per channel"; }
        }
    }
    // After the per-channel windows: a balanced grey is its fixed point. Monochrome, RGB passes and
    // the Scanner face run none.
    if PanelState.separation-shown: Block {
        title: "Dye Separation";
        help: "Subtracts each dye's spill into the other two channels, so colors separate while greys stay put. The family names the film's dye set; the dose depends on the light and sensor it was captured with.";
        block: 5;
        modified: Store.dye-separation-modified;
        folded: true;
        Field {
            label: "Dyes";
            Tabs {
                tabs: ["Kodak", "Fuji", "Generic", "ECN-2", "E-6"];
                selected: PanelState.dye-family;
                picked(i) => { PanelState.dye-family-picked(i); }
            }
        }
        StoreSlider { field: 13; label: "Dye separation"; fraction: Store.dye-separation-fraction; readout: Store.dye-separation-readout; value-text: Store.dye-separation-value; }
    }
    if PanelState.separation-shown: Block {
        title: "Balance Strength";
        help: "The share of Auto White Balance's correction Temperature and Tint take. Each photo keeps its own correction; the share is the roll's.";
        block: 3;
        modified: Store.balance-strength-modified;
        folded: true;
        StoreSlider { field: 11; label: "Strength"; fraction: Store.balance-strength-fraction; readout: Store.balance-strength-readout; value-text: Store.balance-strength-value; }
    }
}

// The Crop tab's model, `FramePane` and `GeometryPanel`: Rust holds the geometry and answers each key.
export global Framing {
    in property <int> ratio;
    in property <bool> portrait;
    in property <bool> portrait-enabled;
    in property <string> kept;
    in property <bool> modified;
    in property <bool> mirrored;
    in property <bool> mirrored-vertically;
    in property <bool> can-paste;
    in property <bool> armed;
    in property <bool> has-window;
    in property <bool> can-paste-window;
    callback ratio-picked(int);
    callback portrait-toggled(bool);
    callback act(string);
}

component CropPane inherits Pane {
    Section {
        title: "Crop";
        help: "Drag the corners on the photo to crop it. Copy and Paste carry the whole framing to other photographs, Paste to Roll to every frame of the roll; the settings paste never does.";
        separated: false;
        HorizontalLayout {
            spacing: Space.s;
            Button { text: "Copy"; help: "Copies this photo's crop."; clicked => { Framing.act("copy-framing"); } }
            Button { text: "Paste"; enabled: Framing.can-paste && PanelState.targets > 0; help: PanelState.targets > 1 ? "Pastes the copied crop on the " + PanelState.targets + " selected photos." : "Pastes the copied crop on this photo."; clicked => { Framing.act("paste-framing"); } }
            Button { text: "Paste to Roll"; enabled: Framing.can-paste; horizontal-stretch: 1; help: "Pastes the copied crop on every photo measured with this roll."; clicked => { Framing.act("paste-framing-to-roll"); } }
        }
    }
    Section {
        title: "Aspect Ratio";
        Tabs {
            tabs: ["Free", "3:2", "4:3", "1:1", "6:7", "5:4"];
            marked: [false, false, false, false, false, false];
            selected: Framing.ratio;
            picked(i) => { Framing.ratio-picked(i); }
        }
        LabelledRow {
            label: "Vertical";
            Toggle { label: "Vertical"; on: Framing.portrait; enabled: Framing.portrait-enabled; toggled(on) => { Framing.portrait-toggled(on); } }
        }
    }
    Block {
        title: "Straighten";
        StoreSlider { field: 14; label: "Angle"; fraction: Store.angle-fraction; readout: Store.angle-readout; value-text: Store.angle-value; }
    }
    Section {
        title: "Rotate & Mirror";
        HorizontalLayout {
            spacing: Space.s;
            alignment: start;
            IconButton { icon: Icons.rotate; help: "Rotate 90° clockwise"; clicked => { Framing.act("rotate"); } }
            ButtonGroup {
                IconButton { icon: Icons.mirror; help: Framing.mirrored ? "Unmirror left for right" : "Mirror left for right"; on: Framing.mirrored; clicked => { Framing.act("mirror"); } }
                IconButton { icon: Icons.mirror; help: Framing.mirrored-vertically ? "Unmirror top for bottom" : "Mirror top for bottom"; on: Framing.mirrored-vertically; clicked => { Framing.act("mirror-vertically"); } }
            }
        }
    }
    Section {
        title: "Measuring Window";
        help: "Shows a frame on the photo; the balance keys and the histogram read only what it holds. Untouched, it follows the crop; the crop never moves it.";
        ButtonGroup {
            Button { text: "Reset"; enabled: Framing.has-window; help: "Reset measure window"; clicked => { Framing.act("window-reset"); } }
            Button { text: Framing.armed ? "Apply Window" : "Measuring Window"; kind: Framing.armed ? ButtonKind.accent : ButtonKind.plain; clicked => { Framing.act("window-arm"); } }
            IconButton { icon: Icons.copy; help: "Copy measure window"; enabled: Framing.has-window; clicked => { Framing.act("window-copy"); } }
            IconButton { icon: Icons.paste; help: "Paste measure window"; enabled: Framing.can-paste-window; clicked => { Framing.act("window-paste"); } }
        }
    }
    Section {
        LabelledRow {
            label: "Kept";
            Label { text: Framing.kept; role: TextRole.value; }
        }
    }
}

// One correction of the open frame, as `CorrectionsPanel` lists it.
export struct CorrectionRow {
    label: string,
    pending: bool,
    fallback: bool,
}

// The De-dust pane's model: the brush, held by Rust as a slider is, and the corrections.
export global Dedust {
    in property <float> fraction;
    in property <string> readout;
    in property <string> value-text;
    in property <[CorrectionRow]> rows;
    callback press(bool) -> bool;
    callback drag(length, length, bool);
    callback release();
    callback remove(int);
}

component DedustPane inherits Pane {
    Section {
        title: "Dust & Scratches";
        help: "Paint over a defect; the tool duplicates a matching patch of the same photo over it.";
        separated: false;
        Slider {
            field: -1;
            label: "Brush Size";
            fraction: Dedust.fraction;
            readout: Dedust.readout;
            value-text: Dedust.value-text;
            press(f, fine) => { return Dedust.press(fine); }
            drag(f, t, s, fine) => { Dedust.drag(t, s, fine); }
            release(f) => { Dedust.release(); }
        }
        if Dedust.rows.length > 0: Well {
            VerticalLayout {
                padding: Space.s;
                spacing: Space.xs;
                for row[i] in Dedust.rows: HorizontalLayout {
                    spacing: Space.s;
                    Label { text: row.label; horizontal-stretch: 1; }
                    if row.fallback: HelpMark { note: "No good match was found nearby — this patch is a plain shifted tile, not a real structural match."; }
                    if row.pending: Label { text: "Generating…"; tone: Tone.secondary; }
                    IconButton { icon: Icons.remove; help: "Remove this correction"; clicked => { Dedust.remove(i); } }
                }
            }
        }
    }
}

component ColorPane inherits Pane {
    // `labKeypad`: on the Scanner face the machine and the keypad stand where Color and Lighting stand.
    if Lab.shown: Section {
        title: "Machine";
        separated: false;
        news: News.machine;
        news-note: News.machine-note;
        news-read => { News.read("machine.1.3.1"); }
        Tabs {
            tabs: ["ONI", "Frontier"];
            marked: [false, false];
            selected <=> Lab.machine;
            picked(i) => { Lab.machine-picked(i); }
        }
    }
    if Lab.shown: LabBlock {
        title: "Density";
        block: 0;
        news: News.keypad;
        news-note: News.keypad-note;
        news-read => { News.read("keypad.1.3.1"); }
        Keypad {
            LetterRow { letter: 0; title: "D"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["D −3: toward dark", "D −: toward dark", "", "D +: toward light", "D +3: toward light"]; }
        }
    }
    if Lab.shown: LabBlock {
        title: "Color";
        block: 1;
        Keypad {
            LetterRow { letter: 1; title: "C"; minus: ScannerStyle.band-red; plus: ScannerStyle.band-cyan; helps: ["C −3: toward red", "C −: toward red", "", "C +: toward cyan", "C +3: toward cyan"]; }
            LetterRow { letter: 2; title: "M"; minus: ScannerStyle.band-green; plus: ScannerStyle.band-magenta; helps: ["M −3: toward green", "M −: toward green", "", "M +: toward magenta", "M +3: toward magenta"]; }
            LetterRow { letter: 3; title: "Y"; minus: ScannerStyle.band-blue; plus: ScannerStyle.band-yellow; helps: ["Y −3: toward blue", "Y −: toward blue", "", "Y +: toward yellow", "Y +3: toward yellow"]; }
        }
    }
    if Lab.shown: LabBlock {
        title: "Look";
        block: 2;
        Keypad {
            LetterRow { letter: 4; title: "TEMP"; minus: ScannerStyle.band-cool; plus: ScannerStyle.band-warm; helps: ["TEMP −3: toward cool", "TEMP −: toward cool", "", "TEMP +: toward warm", "TEMP +3: toward warm"]; }
        }
    }
    if !Lab.shown: Block {
        title: "Color";
        separated: false;
        block: 0;
        modified: Store.color-modified;
        help: "Auto White Balance reads the frame's light as it prints, its bright areas weighing more than a large warm subject, and corrects it with Temperature and Tint; the levels stay where the roll's measurement put them, and the Roll tab holds Balance strength, the share of that correction the two sliders take. Temperature and Tint move the colour alone and never how light the photograph is. Color density is the same control as saturation.";
        if PanelState.crop-first: Label {
            text: "Crop before using the automatic balance";
            role: TextRole.section;
            centred: true;
            wrap: word-wrap;
        }
        if PanelState.balancing: VerticalLayout {
            spacing: Space.xs;
            Progress { fraction: PanelState.balance-fraction; }
            Note { text: PanelState.balance-progress; }
        }
        if !PanelState.balancing: Button {
            text: "AUTO WHITE BALANCE";
            help: "The frame's light toward grey with Temperature and Tint, scaled by Balance strength";
            horizontal-stretch: 1;
            clicked => { PanelState.auto-balance(); }
        }
        if !PanelState.balancing && PanelState.balance-note != "": Note { text: PanelState.balance-note; }
        StoreSlider {
            field: 0; label: "Temperature"; fraction: Store.temperature-fraction; readout: Store.temperature-readout; value-text: Store.temperature-value;
            fill: SliderFill.bipolar; low: Colour.channel-blue; high: Colour.channel-yellow;
        }
        StoreSlider {
            field: 1; label: "Tint"; fraction: Store.tint-fraction; readout: Store.tint-readout; value-text: Store.tint-value;
            fill: SliderFill.bipolar; low: Colour.channel-green; high: Colour.channel-magenta;
        }
        StoreSlider { field: 2; label: "Color density (same as saturation)"; fraction: Store.color-density-fraction; readout: Store.color-density-readout; value-text: Store.color-density-value; }
    }
    // Only on a paper: in any other working space the gains do nothing.
    if Exporting.on-paper: Block {
        title: "Paper Correction";
        block: 9;
        modified: Store.paper-correction-modified;
        help: "Gains laid last, on a color or a black and white print alike, against the paper the picture is proofed on, and on that paper alone: in any other working space they do nothing. Auto Paper Correction reads the paper's own white off its profile, never the picture, and sets the gains that print a grey as grey; the strongest stays at 0 so nothing clips.";
        Button {
            text: "Auto Paper Correction";
            help: "Sets the three gains from the paper profile alone";
            horizontal-stretch: 1;
            clicked => { Exporting.auto-paper(); }
        }
        StoreSlider {
            field: 21; label: "Red"; fraction: Store.paper-red-fraction; readout: Store.paper-red-readout; value-text: Store.paper-red-value;
            fill: SliderFill.bipolar; low: Colour.channel-cyan; high: Colour.channel-red;
        }
        StoreSlider {
            field: 22; label: "Green"; fraction: Store.paper-green-fraction; readout: Store.paper-green-readout; value-text: Store.paper-green-value;
            fill: SliderFill.bipolar; low: Colour.channel-magenta; high: Colour.channel-green;
        }
        StoreSlider {
            field: 23; label: "Blue"; fraction: Store.paper-blue-fraction; readout: Store.paper-blue-readout; value-text: Store.paper-blue-value;
            fill: SliderFill.bipolar; low: Colour.channel-yellow; high: Colour.channel-blue;
        }
    }
    if !Lab.shown: Block {
        title: "Lighting";
        block: 1;
        news: News.lighting;
        news-note: News.lighting-note;
        news-read => { News.read("lighting.1.3.1"); }
        modified: Store.lighting-modified;
        help: "The negative back to light along a straight line: the black point on pure black, the white on pure white. Every slider brightens to the right; Black point and White point move the ends of the scan itself.";
        StoreSlider { field: 3; label: "Exposure"; fraction: Store.exposure-fraction; readout: Store.exposure-readout; value-text: Store.exposure-value; }
        StoreSlider { field: 4; label: "Highlights"; fraction: Store.highlights-fraction; readout: Store.highlights-readout; value-text: Store.highlights-value; }
        StoreSlider { field: 5; label: "Shadows"; fraction: Store.shadows-fraction; readout: Store.shadows-readout; value-text: Store.shadows-value; }
        StoreSlider {
            field: 6; label: "White point"; fraction: Store.white-point-fraction; readout: Store.white-point-readout; value-text: Store.white-point-value;
            fill: SliderFill.ramp; tint: Colour.white; knob: Knob.white;
        }
        StoreSlider {
            field: 7; label: "Black point"; fraction: Store.black-point-fraction; readout: Store.black-point-readout; value-text: Store.black-point-value;
            fill: SliderFill.ramp; tint: Colour.black; knob: Knob.black;
        }
    }
    if !Lab.shown: Block {
        title: "Effects";
        block: 2;
        modified: Store.effects-modified;
        help: "Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.";
        StoreSlider { field: 8; label: "Contrast"; fraction: Store.contrast-fraction; readout: Store.contrast-readout; value-text: Store.contrast-value; }
        StoreSlider { field: 9; label: "Vignette"; fraction: Store.vignette-fraction; readout: Store.vignette-readout; value-text: Store.vignette-value; }
        StoreSlider { field: 10; label: "Chrome"; fraction: Store.chrome-fraction; readout: Store.chrome-readout; value-text: Store.chrome-value; fill: SliderFill.metal; }
    }
    // `LabStepKeys`: on the Scanner face its own finishing, a click a step, the title back to rest.
    if Lab.shown: LabBlock {
        title: "Effects";
        news: News.effects-scanner;
        news-note: News.effects-scanner-note;
        news-read => { News.read("effects.scanner.1.3.1"); }
        block: 3;
        help: "Contrast bends the print into an S about a middle grey, its ends held. Vignette darkens the corners in stops, without shifting their color; below zero it lightens them. Chrome lays a saturation curve over everything, greying the ends and keeping color in the middle.";
        Keypad {
            EffectRow { effect: 0; title: "CONTRAST"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["Contrast −3: toward softer, +15 %", "Contrast −: toward softer, +5 %", "Contrast back to 0 %", "Contrast +: toward harder, +5 %", "Contrast +3: toward harder, +15 %"]; }
        }
        Keypad {
            EffectRow { effect: 1; title: "VIGNETTE"; minus: ScannerStyle.band-light; plus: ScannerStyle.band-dark; helps: ["Vignette −3: toward lighter corners, +0.3 EV", "Vignette −: toward lighter corners, +0.1 EV", "Vignette back to 0 EV", "Vignette +: toward darker corners, +0.1 EV", "Vignette +3: toward darker corners, +0.3 EV"]; }
        }
        if !Lab.monochrome: Keypad {
            EffectRow { effect: 2; title: "CHROME"; minus: ScannerStyle.band-dark; plus: ScannerStyle.band-light; helps: ["Chrome −3: toward less, +15 %", "Chrome −: toward less, +5 %", "Chrome back to 0 %", "Chrome +: toward more, +5 %", "Chrome +3: toward more, +15 %"]; }
        }
    }
    EditorBlock {
        title: "Curves";
        block: 0;
        news: Lab.shown ? News.curves-scanner : "";
        news-note: News.curves-scanner-note;
        news-read => { News.read("curves.scanner.1.3.1"); }
        modified: Editors.curves-modified;
        folded <=> Editors.curves-folded;
        help: "Curves drawn by hand, one point at a time: a channel's own tints its highlights or its shadows alone.";
        CurvesEditor { histogram: Plots.curves; }
    }
    // The grade's blocks: a monochrome photo has no colour for them to move.
    if !Editors.monochrome: EditorBlock {
        title: "Spectrogram Finishing";
        block: 2;
        modified: Editors.spectrogram-modified;
        folded <=> Editors.spectrogram-folded;
        help: "Shifts one color range at a time without touching the others: turn a point around the wheel to move that color's hue, out or in to make it stronger or greyer. Click a point, then use the arrow keys.";
        SpectrogramEditor { }
    }
    if !Editors.monochrome: EditorBlock {
        title: "Saturation Curve";
        block: 3;
        modified: Editors.saturation-modified;
        folded <=> Editors.saturation-folded;
        help: "Saturation by light, from the black point to the white: raise a point to strengthen color in its tones, lower it toward grey. Drag a point along the light to choose its tones; double-click to return it to neutral. Brightness never moves.";
        SaturationEditor { histogram: Plots.output; }
    }
}

// `DetailsPane.offOnSheet`: greyed and out of reach on a sheet, the values kept.
component DetailSlider inherits StoreSlider {
    enabled: !PanelState.sheet;
}

component DetailsPane inherits Pane {
    property <string> off-on-sheet: "Off on a contact sheet: its frames are reduced copies. The settings are kept for when a photograph takes them.";
    Block {
        title: "Sharpening";
        block: 6;
        modified: Store.sharpening-modified;
        help: PanelState.sheet ? root.off-on-sheet : "Sharpens edges without adding color fringing.";
        DetailSlider { field: 15; label: "Amount"; fraction: Store.sharpen-amount-fraction; readout: Store.sharpen-amount-readout; value-text: Store.sharpen-amount-value; }
        DetailSlider { field: 16; label: "Radius"; fraction: Store.sharpen-radius-fraction; readout: Store.sharpen-radius-readout; value-text: Store.sharpen-radius-value; }
        DetailSlider { field: 17; label: "Halo limit"; fraction: Store.sharpen-halo-fraction; readout: Store.sharpen-halo-readout; value-text: Store.sharpen-halo-value; }
    }
    // `DetailsPane`: a monochrome frame has no colour noise to smooth.
    if !PanelState.monochrome: Block {
        title: "Chroma Denoise";
        block: 7;
        modified: Store.chroma-denoise-modified;
        help: PanelState.sheet ? root.off-on-sheet : "Smooths color noise from the scan without touching the film grain.";
        DetailSlider { field: 18; label: "Amount"; fraction: Store.chroma-amount-fraction; readout: Store.chroma-amount-readout; value-text: Store.chroma-amount-value; }
        DetailSlider { field: 19; label: "Radius"; fraction: Store.chroma-radius-fraction; readout: Store.chroma-radius-readout; value-text: Store.chroma-radius-value; }
    }
    Block {
        title: "Texture";
        block: 8;
        modified: Store.texture-modified;
        StoreSlider { field: 20; label: "Texture"; fraction: Store.texture-fraction; readout: Store.texture-readout; value-text: Store.texture-value; }
    }
}

export component Panel inherits Surface {
    width: ShellStyle.panel-width;
    VerticalLayout {
        // `labScreen`: on the Scanner face the scanner's screen holds the plot band, but under Details.
        if !Lab.shown || PanelState.tab == 3: HistogramFrame {
            source: Plots.output;
            size: PlotSize.main;
            // Lighting's curves over the plot, on the Color tab alone.
            if PanelState.tab == 2: PrintOverlay { }
        }
        if Lab.shown && PanelState.tab != 3: LabScreen {
            height: PlotStyle.main;
            frame: Lab.frame;
            machine: Lab.machine-line;
            remeasure: Lab.remeasure;
            remeasure-help: "This roll was measured before the scanner kept its median: measure it again in Prepare the Roll, or the scanner centres on a guess.";
            cells: Lab.cells;
            finish: Lab.finish;
        }
        HorizontalLayout {
            padding-left: Space.m;
            padding-right: Space.m;
            padding-top: Space.s;
            padding-bottom: Space.s;
            Tabs {
                tabs: ["Roll", "Crop", "Color", "Details"];
                marked: [false, false, false, false];
                selected <=> PanelState.tab;
                picked(i) => { PanelState.tab-picked(i); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            RollPane { shown: PanelState.tab == 0; }
            CropPane { shown: PanelState.tab == 1; }
            ColorPane { shown: PanelState.tab == 2; }
            DetailsPane { shown: PanelState.tab == 3; }
            DedustPane { shown: PanelState.tab == 4; }
        }
    }
}
