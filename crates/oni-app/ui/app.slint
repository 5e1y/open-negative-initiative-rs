// The editor window: the bar, the library column, the canvas card or the gallery, the panel.
import { DS, Tip, Icons, AppWindow, TipLayer, Card, Picture, SplitGuide, FrameOverlay, FrameStyle, BrushDisc, LiveStroke, CorrectionMark, Badge, SourceTrace, Button, ButtonGroup, ButtonSize, Label, TextRole, Space, Ground, StatusLine, CardStyle, StatusStyle, ShellStyle } from "ds/ds.slint";
import { Catalogue } from "ds/catalogue.slint";
import { Store } from "store.slint";
import { Panel, Plots, PanelState, Framing, Dedust, CorrectionRow } from "panel.slint";
import { Toolbar, Bar } from "toolbar.slint";
import { Tree, Grid, Info, Library, Tile, Heading, TreeRow } from "library.slint";
import { Pairing, PairingSheet } from "pairing.slint";

export { DS, Tip, Icons, Store, Plots, PanelState, Framing, Dedust, CorrectionRow, Bar, Library, Tile, Heading, TreeRow, Pairing, Catalogue }
export { Editors } from "editors.slint";
export { Ink, PlotLine, PlotDot, PlotKnob, PlotReadout } from "ds/ds.slint";

// The canvas: the photo the display kernel wrote, and the facts the status bar carries.
// A correction's marker on the canvas: its ring's rectangle in points and its number.
export struct Mark {
    x: length,
    y: length,
    width: length,
    height: length,
    number: int,
}

export global Canvas {
    in property <image> frame;
    in property <string> status;
    in property <bool> busy;
    in-out property <length> width;
    in-out property <length> height;
    // Where the render sits on the canvas, which shows only the viewport's part of the image.
    in property <length> frame-x;
    in property <length> frame-y;
    in property <length> frame-width;
    in property <length> frame-height;
    // Compare Before/After: the split as a fraction of the canvas's width, negative while off.
    in property <float> split: -1;
    in property <image> before;
    in property <length> before-x;
    in property <length> before-y;
    in property <length> before-width;
    in property <length> before-height;
    callback split-dragged(length);
    // The crop frame while the Crop tab is open, and the measuring window, on the canvas.
    in property <bool> cropping;
    in property <length> crop-x;
    in property <length> crop-y;
    in property <length> crop-width;
    in property <length> crop-height;
    in property <bool> window-shown;
    in property <length> window-x;
    in property <length> window-y;
    in property <length> window-width;
    in property <length> window-height;
    callback frame-grabbed(bool, int);
    callback frame-dragged(bool, int, length, length);
    callback frame-released(bool);
    // De-dust: painting armed, the brush under the pointer, the stroke being painted, the marks.
    in property <bool> painting;
    in property <bool> brush-shown;
    in property <length> brush-x;
    in property <length> brush-y;
    in property <length> brush-diameter;
    in property <string> stroke;
    in property <length> stroke-width;
    in property <[Mark]> marks;
    // Each patch's source: the lines to them, and the copied strokes with their widths.
    in property <string> source-lines;
    in property <length> source-line-width;
    in property <[{commands: string, width: length}]> source-shapes;
    // Space held in De-dust: the drag pans instead of painting.
    in-out property <bool> space-held;
    // The crop's size while a handle is held, above the frame.
    in property <string> crop-badge;
    in property <length> crop-badge-x;
    in property <length> crop-badge-y;
    // `zoomBubble`: the zoom's readout and the ladder's keys, above the canvas's top right corner.
    in property <string> zoom-label;
    in property <bool> can-zoom-out;
    in property <bool> can-zoom-in;
    callback paint-hover(length, length, bool);
    callback paint-start(length, length);
    callback paint-move(length, length);
    callback paint-end();
    callback resized();
    callback double-clicked();
    callback grabbed(length, length);
    callback dragged(length, length);
    // The wheel's delta, the pointer, and whether ⌘ is held; answers whether the canvas took it.
    callback scrolled(length, length, length, length, bool) -> bool;
    callback pinch-started();
    callback pinched(float, length, length);
}

export global App {
    in-out property <bool> gallery;
    in property <bool> panel-hidden;
    in property <bool> library-hidden;
    // A key with control, meta, shift and alt; Rust reads ⌘ as meta on macOS, control elsewhere,
    // and answers whether the key was claimed.
    callback key(string, bool, bool, bool, bool) -> bool;
    callback menu(string);
}

export component MainWindow inherits AppWindow {
    title: "Open Negative Initiative";
    out property <bool> keys-focused: keys.has-focus;
    // Gives the key monitor the keyboard back after a click elsewhere than a field.
    public function refocus() { keys.focus(); }

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open Folder…"; activated => { App.menu("open"); } }
            MenuItem { title: "Pair Phone…"; activated => { App.menu("pair-phone"); } }
            MenuSeparator { }
            MenuItem { title: App.gallery ? "Editor" : "Gallery"; activated => { App.menu("toggle-mode"); } }
            MenuItem { title: "Export"; activated => { App.menu("export"); } }
            MenuSeparator { }
            MenuItem { title: "Recheck Originals"; activated => { App.menu("recheck"); } }
            MenuItem { title: "Read the Folders Again"; activated => { App.menu("read-folders"); } }
            MenuItem { title: "Show the Selected Photo"; activated => { App.menu("show-selected"); } }
            MenuSeparator { }
            MenuItem { title: "Move to ONI Trash"; activated => { App.menu("remove"); } }
            MenuItem { title: "Restore"; activated => { App.menu("restore"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: Bar.undo-title; enabled: Bar.can-undo; activated => { App.menu("undo"); } }
            MenuItem { title: Bar.redo-title; enabled: Bar.can-redo; activated => { App.menu("redo"); } }
            MenuSeparator { }
            MenuItem { title: "Reset to Imported State"; activated => { App.menu("reset"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Zoom Out"; activated => { App.menu("smaller"); } }
            MenuItem { title: "Zoom In"; activated => { App.menu("larger"); } }
            MenuSeparator { }
            MenuItem { title: "Compare"; activated => { App.menu("compare"); } }
            MenuItem { title: App.library-hidden ? "Show Library" : "Hide Library"; activated => { App.menu("hide-library"); } }
            MenuItem { title: App.panel-hidden ? "Show Panel" : "Hide Panel"; activated => { App.menu("hide-panel"); } }
            MenuItem { title: "Crop and Straighten"; activated => { App.menu("framing"); } }
            MenuItem { title: "De-dust"; activated => { App.menu("correction"); } }
            // Bare keys stay out of `shortcut`: the key monitor routes them, so a field being edited keeps them.
            MenuItem { title: "Bigger Brush    ]"; activated => { App.menu("bigger-brush"); } }
            MenuItem { title: "Smaller Brush    ["; activated => { App.menu("smaller-brush"); } }
            MenuItem { title: "Mirror"; activated => { App.menu("mirror"); } }
            MenuSeparator { }
            MenuItem { title: "Screen Gamut"; activated => { App.menu("screen-gamut"); } }
            MenuSeparator { }
            MenuItem { title: "Scanner Emulator"; activated => { App.menu("emulator"); } }
        }
        Menu {
            title: "Labels";
            MenuItem { title: "None    0"; activated => { App.menu("medal-0"); } }
            MenuItem { title: "Bronze    1"; activated => { App.menu("medal-1"); } }
            MenuItem { title: "Silver    2"; activated => { App.menu("medal-2"); } }
            MenuItem { title: "Gold    3"; activated => { App.menu("medal-3"); } }
            MenuSeparator { }
            MenuItem { title: "Cycle Filter"; activated => { App.menu("cycle-filter"); } }
        }
        Menu {
            title: "Rolls";
            MenuItem { title: "New Roll"; activated => { App.menu("new-roll"); } }
            MenuItem { title: "Ungroup"; activated => { App.menu("ungroup"); } }
            MenuSeparator { }
            MenuItem { title: "Make a Contact Sheet"; activated => { App.menu("contact-sheet"); } }
            MenuItem { title: "Prepare the Roll…"; activated => { App.menu("prepare-roll"); } }
            MenuItem { title: "Reset to Default…"; activated => { App.menu("reset-to-default"); } }
        }
        Menu {
            title: "Settings";
            MenuItem { title: "Copy Settings"; activated => { App.menu("copy"); } }
            MenuItem { title: "Paste Settings"; activated => { App.menu("paste"); } }
            MenuItem { title: "Paste to the Roll"; activated => { App.menu("paste-to-roll"); } }
            MenuSeparator { }
            MenuItem { title: "Save as Preset…"; activated => { App.menu("save-preset"); } }
            MenuItem { title: "Edit Presets…"; activated => { App.menu("edit-presets"); } }
            MenuItem { title: "Import Presets…"; activated => { App.menu("import-presets"); } }
            MenuItem { title: "Paste Preset Code"; activated => { App.menu("paste-preset-code"); } }
            MenuItem { title: "Show Presets Folder"; activated => { App.menu("show-presets"); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Show Console"; activated => { App.menu("console"); } }
            MenuItem { title: "What's New in ONI 1.1"; activated => { App.menu("welcome"); } }
            MenuItem { title: "Show What's New Again"; activated => { App.menu("whats-new"); } }
            MenuItem { title: "Report a Bug / Give Feedback…"; activated => { App.menu("report"); } }
            MenuItem { title: "Show My Year on Film"; activated => { App.menu("wrapped"); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " " && Canvas.painting) {
                Canvas.space-held = true;
                return EventResult.accept;
            }
            if (App.key(event.text, event.modifiers.control, event.modifiers.meta, event.modifiers.shift, event.modifiers.alt)) {
                return EventResult.accept;
            }
            EventResult.reject
        }
        key-released(event) => {
            if (event.text == " ") {
                Canvas.space-held = false;
                return EventResult.accept;
            }
            EventResult.reject
        }
        VerticalLayout {
            Toolbar { }
            HorizontalLayout {
                vertical-stretch: 1;
                if !App.library-hidden: Tree { width: ShellStyle.library-width; }
                Rectangle {
                    horizontal-stretch: 1;
                    // The card, inset by `cardInset` from the panel's ground.
                    card := Card {
                        x: CardStyle.inset;
                        y: 0;
                        width: parent.width - 2 * CardStyle.inset;
                        height: parent.height - CardStyle.inset - StatusStyle.height;
                        visible: !App.gallery;
                        changed width => { Canvas.width = self.width - 2 * CardStyle.padding; Canvas.resized(); }
                        changed height => { Canvas.height = self.height - 2 * CardStyle.padding; Canvas.resized(); }
                        Rectangle {
                            x: CardStyle.padding;
                            y: CardStyle.padding;
                            width: parent.width - 2 * CardStyle.padding;
                            height: parent.height - 2 * CardStyle.padding;
                            clip: true;
                            Picture {
                                width: parent.width;
                                height: parent.height;
                                ground: Ground.canvas;
                            }
                            Picture {
                                x: Canvas.frame-x;
                                y: Canvas.frame-y;
                                width: Canvas.frame-width;
                                height: Canvas.frame-height;
                                ground: Ground.canvas;
                                stretched: true;
                                source: Canvas.frame;
                            }
                            if Canvas.split >= 0: Rectangle {
                                width: parent.width * Canvas.split;
                                height: parent.height;
                                clip: true;
                                Picture {
                                    x: Canvas.before-x;
                                    y: Canvas.before-y;
                                    width: Canvas.before-width;
                                    height: Canvas.before-height;
                                    ground: Ground.canvas;
                                    stretched: true;
                                    source: Canvas.before;
                                }
                            }
                            // A pinch zooms about its centre; a drag pans, a double click toggles 100 %.
                            ScaleRotateGestureHandler {
                                width: parent.width;
                                height: parent.height;
                                started => { Canvas.pinch-started(); }
                                updated => { Canvas.pinched(self.scale, self.center.x, self.center.y); }
                                navigation := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.refocus(); }
                                    double-clicked => { Canvas.double-clicked(); }
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            Canvas.grabbed(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    moved => { Canvas.dragged(self.mouse-x, self.mouse-y); }
                                    scroll-event(event) => {
                                        Canvas.scrolled(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y, event.modifiers.meta) ? EventResult.accept : EventResult.reject
                                    }
                                }
                            }
                            if Canvas.cropping: FrameOverlay {
                                width: parent.width;
                                height: parent.height;
                                frame-x: Canvas.crop-x;
                                frame-y: Canvas.crop-y;
                                frame-width: Canvas.crop-width;
                                frame-height: Canvas.crop-height;
                                grabbed(h) => { Canvas.frame-grabbed(false, h); }
                                dragged(h, dx, dy) => { Canvas.frame-dragged(false, h, dx, dy); }
                                released => { Canvas.frame-released(false); }
                            }
                            if Canvas.cropping && Canvas.crop-badge != "": Badge {
                                text: Canvas.crop-badge;
                                x: Canvas.crop-badge-x - self.width / 2;
                                y: Canvas.crop-badge-y - self.height / 2;
                            }
                            if Canvas.window-shown: FrameOverlay {
                                width: parent.width;
                                height: parent.height;
                                look: FrameStyle.window;
                                body-moves: !Canvas.cropping;
                                frame-x: Canvas.window-x;
                                frame-y: Canvas.window-y;
                                frame-width: Canvas.window-width;
                                frame-height: Canvas.window-height;
                                grabbed(h) => { Canvas.frame-grabbed(true, h); }
                                dragged(h, dx, dy) => { Canvas.frame-dragged(true, h, dx, dy); }
                                released => { Canvas.frame-released(true); }
                            }
                            if Canvas.painting: Rectangle {
                                width: parent.width;
                                height: parent.height;
                                for t in Canvas.source-shapes: SourceTrace {
                                    width: parent.width;
                                    height: parent.height;
                                    commands: t.commands;
                                    thickness: t.width;
                                }
                                if Canvas.source-lines != "": SourceTrace {
                                    width: parent.width;
                                    height: parent.height;
                                    commands: Canvas.source-lines;
                                    thickness: Canvas.source-line-width;
                                }
                                for m in Canvas.marks: CorrectionMark {
                                    x: m.x;
                                    y: m.y;
                                    width: m.width;
                                    height: m.height;
                                    number: m.number;
                                }
                                if Canvas.stroke != "": LiveStroke {
                                    width: parent.width;
                                    height: parent.height;
                                    commands: Canvas.stroke;
                                    thickness: Canvas.stroke-width;
                                }
                                if Canvas.brush-shown && !Canvas.space-held: BrushDisc {
                                    x: Canvas.brush-x - Canvas.brush-diameter / 2;
                                    y: Canvas.brush-y - Canvas.brush-diameter / 2;
                                    width: Canvas.brush-diameter;
                                    height: Canvas.brush-diameter;
                                }
                                paint := TouchArea {
                                    enabled: !Canvas.space-held;
                                    mouse-cursor: none;
                                    changed has-hover => { Canvas.paint-hover(self.mouse-x, self.mouse-y, self.has-hover); }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { Canvas.paint-start(self.mouse-x, self.mouse-y); }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) { Canvas.paint-end(); }
                                    }
                                    moved => {
                                        Canvas.paint-hover(self.mouse-x, self.mouse-y, true);
                                        if (self.pressed) { Canvas.paint-move(self.mouse-x, self.mouse-y); }
                                    }
                                }
                            }
                            if Canvas.split >= 0: SplitGuide {
                                x: parent.width * Canvas.split - self.width / 2;
                                height: parent.height;
                                dragged(at) => { Canvas.split-dragged(self.x + at); }
                            }
                        }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width - CardStyle.padding;
                            y: 0;
                            height: CardStyle.padding;
                            spacing: Space.s;
                            alignment: center;
                            Label { text: Canvas.zoom-label; role: TextRole.value; }
                            ButtonGroup {
                                alignment: center;
                                Button { text: "−"; size: ButtonSize.small; enabled: Canvas.can-zoom-out; help: "Zoom out (⌘−)"; clicked => { App.menu("smaller"); } }
                                Button { text: "+"; size: ButtonSize.small; enabled: Canvas.can-zoom-in; help: "Zoom in (⌘+)"; clicked => { App.menu("larger"); } }
                            }
                        }
                    }
                    Card {
                        x: CardStyle.inset;
                        y: 0;
                        width: parent.width - 2 * CardStyle.inset;
                        height: parent.height - CardStyle.inset - StatusStyle.height;
                        visible: App.gallery;
                        Grid { }
                    }
                    StatusLine {
                        x: CardStyle.inset;
                        y: parent.height - StatusStyle.height;
                        width: parent.width - 2 * CardStyle.inset;
                        text: Canvas.status;
                    }
                }
                if !App.panel-hidden && !App.gallery: Panel { }
                if App.gallery: Info { }
            }
        }
    }

    if Pairing.shown: PairingSheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    TipLayer { room: root.width; }

    init => { keys.focus(); }
}
