// The open photo's displayed values, one property per value a control draws, written only by Rust.
// Never one struct of settings: a struct property dirties every binding that reads any part of it.
export global Store {
    in property <float> temperature-fraction;
    in property <string> temperature-readout;
    in property <string> temperature-value;
    in property <float> tint-fraction;
    in property <string> tint-readout;
    in property <string> tint-value;
    in property <float> color-density-fraction;
    in property <string> color-density-readout;
    in property <string> color-density-value;
    in property <float> exposure-fraction;
    in property <string> exposure-readout;
    in property <string> exposure-value;
    in property <float> highlights-fraction;
    in property <string> highlights-readout;
    in property <string> highlights-value;
    in property <float> shadows-fraction;
    in property <string> shadows-readout;
    in property <string> shadows-value;
    in property <float> white-point-fraction;
    in property <string> white-point-readout;
    in property <string> white-point-value;
    in property <float> black-point-fraction;
    in property <string> black-point-readout;
    in property <string> black-point-value;
    in property <float> contrast-fraction;
    in property <string> contrast-readout;
    in property <string> contrast-value;
    in property <float> vignette-fraction;
    in property <string> vignette-readout;
    in property <string> vignette-value;
    in property <float> chrome-fraction;
    in property <string> chrome-readout;
    in property <string> chrome-value;
    in property <float> balance-strength-fraction;
    in property <string> balance-strength-readout;
    in property <string> balance-strength-value;
    in property <float> density-ceiling-fraction;
    in property <string> density-ceiling-readout;
    in property <string> density-ceiling-value;
    in property <float> dye-separation-fraction;
    in property <string> dye-separation-readout;
    in property <string> dye-separation-value;
    in property <float> angle-fraction;
    in property <string> angle-readout;
    in property <string> angle-value;
    in property <float> sharpen-amount-fraction;
    in property <string> sharpen-amount-readout;
    in property <string> sharpen-amount-value;
    in property <float> sharpen-radius-fraction;
    in property <string> sharpen-radius-readout;
    in property <string> sharpen-radius-value;
    in property <float> sharpen-halo-fraction;
    in property <string> sharpen-halo-readout;
    in property <string> sharpen-halo-value;
    in property <float> chroma-amount-fraction;
    in property <string> chroma-amount-readout;
    in property <string> chroma-amount-value;
    in property <float> chroma-radius-fraction;
    in property <string> chroma-radius-readout;
    in property <string> chroma-radius-value;
    in property <float> texture-fraction;
    in property <string> texture-readout;
    in property <string> texture-value;
    in property <float> gain-red-fraction;
    in property <string> gain-red-readout;
    in property <string> gain-red-value;
    in property <float> gain-green-fraction;
    in property <string> gain-green-readout;
    in property <string> gain-green-value;
    in property <float> gain-blue-fraction;
    in property <string> gain-blue-readout;
    in property <string> gain-blue-value;
    in property <float> flat-amount-fraction;
    in property <string> flat-amount-readout;
    in property <string> flat-amount-value;
    in property <float> flat-temperature-fraction;
    in property <string> flat-temperature-readout;
    in property <string> flat-temperature-value;
    in property <float> flat-tint-fraction;
    in property <string> flat-tint-readout;
    in property <string> flat-tint-value;
    in property <float> paper-red-fraction;
    in property <string> paper-red-readout;
    in property <string> paper-red-value;
    in property <float> paper-green-fraction;
    in property <string> paper-green-readout;
    in property <string> paper-green-value;
    in property <float> paper-blue-fraction;
    in property <string> paper-blue-readout;
    in property <string> paper-blue-value;
    in property <bool> color-modified;
    in property <bool> lighting-modified;
    in property <bool> effects-modified;
    in property <bool> balance-strength-modified;
    in property <bool> density-ceiling-modified;
    in property <bool> dye-separation-modified;
    in property <bool> sharpening-modified;
    in property <bool> chroma-denoise-modified;
    in property <bool> texture-modified;
    in property <bool> source-balance-modified;
    in property <bool> flat-field-modified;
    in property <bool> paper-correction-modified;
    callback press(int, bool) -> bool;
    callback drag(int, length, length, bool);
    callback release(int);
    callback scroll(int, length, length, length, bool) -> bool;
    callback step(int, int);
    callback reset(int);
}
