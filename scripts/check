#!/usr/bin/env bash
# Every check in one build, then every test binary at once; prints the failures whole, then each check
# skipped and why, and exits non-zero on any failure. Usage: scripts/check [cargo test args].
set -uo pipefail
cd "$(dirname "$0")/.."
started=$(date +%s)
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

cargo test --workspace --tests --no-run --message-format=json "$@" 2>"$out/build.log" \
    | jq -r 'select(.reason == "compiler-artifact" and .profile.test == true and .executable != null)
             | "\(.executable)\t\(.manifest_path)"' >"$out/bins"
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    grep -E '^(error|warning: unused)' -A12 "$out/build.log"
    exit 1
fi

# One binary: its output into its own log, its verdict into a marker the summary reads, its seconds into the
# timings. A binary still running after ONI_CHECK_LIMIT seconds (1800: the window checks take 10 minutes on a busy
# Mac) is stopped and fails, so a hang never holds the loop.
run() {
    local exe=$1 manifest=$2 log pid watchdog began
    log="$out/$(basename "$exe").log"
    began=$(date +%s)
    (cd "$(dirname "$manifest")" && CARGO_MANIFEST_DIR=$(dirname "$manifest") exec "$exe" -q --show-output) >"$log" 2>&1 &
    pid=$!
    (sleep "${ONI_CHECK_LIMIT:-1800}" && kill "$pid" 2>/dev/null && echo "stopped after ${ONI_CHECK_LIMIT:-1800} s" >>"$log") &
    watchdog=$!
    if wait "$pid"; then
        touch "$log.ok"
    fi
    kill "$watchdog" 2>/dev/null
    printf '%s\t%s\n' "$(($(date +%s) - began))" "$(basename "$exe")" >>"$out/times"
}
export -f run
export out
# The longest binary on the last run starts first, one never timed before it, so none holds the end alone.
times="${CARGO_TARGET_DIR:-target}/tmp/check-times.tsv"
mkdir -p "$(dirname "$times")"
touch "$times"
while IFS=$'\t' read -r exe manifest; do
    printf '%s\t%s\t%s\n' "$(awk -F '\t' -v b="$(basename "$exe")" '$2 == b { print $1 }' "$times" | grep . || echo 99999)" "$exe" "$manifest"
done <"$out/bins" | sort -rn | cut -f 2- | tr '\t' '\n' | xargs -n 2 -P "${ONI_BINARIES:-12}" bash -c 'run "$0" "$1"'
cp "$out/times" "$times"

failed=0
while IFS=$'\t' read -r exe _; do
    log="$out/$(basename "$exe").log"
    if [ ! -e "$log.ok" ]; then
        failed=$((failed + 1))
        echo "=== FAILED $(basename "$exe")"
        grep -vE '^(test .* \.\.\. ok|running [0-9]+ tests?|\.+)$' "$log" | tail -40
    fi
done <"$out/bins"
# A check that returns early on a missing fixture or GPU passes: its own line says so, read off the
# output each check printed (`--show-output`), so a green run never hides what did not run.
while IFS=$'\t' read -r exe manifest; do
    log="$out/$(basename "$exe").log"
    binary="$(basename "$(dirname "$manifest")")/$(basename "$exe" | sed -E 's/-[0-9a-f]{16}$//')"
    awk -v binary="$binary" '
        /^---- .* stdout ----$/ { check = $2; next }
        /^SKIPPED|^skipped |not exercised/ { print binary "\t" check "\t" $0 }
    ' "$log"
done <"$out/bins" | sort -u >"$out/skipped"
if [ -s "$out/skipped" ]; then
    echo "=== SKIPPED"
    awk -F '\t' '{ print "  " $1 " " $2 ": " $3 }' "$out/skipped"
    awk -F '\t' '
        {
            why = $3
            if (match(why, /\(set [A-Z_]+\)/)) why = "no " substr(why, RSTART + 5, RLENGTH - 6)
            else if (why ~ /ONI_SKIP_HEAVY/) why = "ONI_SKIP_HEAVY set"
            else if (match(why, /ONI_[A-Z_]+/)) why = "no " substr(why, RSTART, RLENGTH)
            else if (why ~ /[Rr]oll #8/) why = "no ONI_RAW_DIR"
            else if (why ~ /GPU|[Aa]dapter|device/) why = "no GPU"
            else if (why ~ /running as root|under root/) why = "root"
            else { sub(/^(SKIPPED|skipped)[^:]*: */, "", why); sub(/:.*/, "", why) }
            count[why]++; total++
        }
        END {
            line = ""
            for (w in count) line = line (line == "" ? "" : ", ") count[w] " " w
            print "SKIPPED " total " checks: " line
        }
    ' "$out/skipped"
else
    echo "SKIPPED 0 checks"
fi
echo "SLOWEST $(sort -rn "$out/times" | head -10 | sed -E 's/-[0-9a-f]{16}$//' | awk -F '\t' '{ printf "%s%s %d s", (NR > 1 ? ", " : ""), $2, $1 }')"
echo "$(wc -l <"$out/bins" | tr -d ' ') binaries, $failed failed, $(($(date +%s) - started)) s"
[ "$failed" -eq 0 ]
