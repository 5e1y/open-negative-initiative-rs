#!/usr/bin/env bash
# Every check in one build, then every test binary at once; prints the failures whole, then each check
# skipped and why, and exits non-zero on any failure. Usage: scripts/check [cargo test args].
set -uo pipefail
cd "$(dirname "$0")/.."
started=$(date +%s)
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

cargo test --workspace --tests --no-run --message-format=json "$@" 2>"$out/build.log" \
    | jq -r 'select(.reason == "compiler-artifact" and .profile.test == true and .executable != null)
             | "\(.executable)\t\(.manifest_path)"' >"$out/bins"
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    grep -E '^(error|warning: unused)' -A12 "$out/build.log"
    exit 1
fi

# One binary: its output into its own log, its verdict into a marker the summary reads. A binary
# still running after ONI_CHECK_LIMIT seconds (240: the window checks alone take two minutes) is stopped and fails, so a hang never holds the loop.
run() {
    local exe=$1 manifest=$2 log pid watchdog
    log="$out/$(basename "$exe").log"
    (cd "$(dirname "$manifest")" && CARGO_MANIFEST_DIR=$(dirname "$manifest") exec "$exe" -q --show-output) >"$log" 2>&1 &
    pid=$!
    (sleep "${ONI_CHECK_LIMIT:-240}" && kill "$pid" 2>/dev/null && echo "stopped after ${ONI_CHECK_LIMIT:-240} s" >>"$log") &
    watchdog=$!
    if wait "$pid"; then
        touch "$log.ok"
    fi
    kill "$watchdog" 2>/dev/null
}
export -f run
export out
tr '\t' '\n' <"$out/bins" | xargs -n 2 -P "${ONI_BINARIES:-12}" bash -c 'run "$0" "$1"'

failed=0
while IFS=$'\t' read -r exe _; do
    log="$out/$(basename "$exe").log"
    if [ ! -e "$log.ok" ]; then
        failed=$((failed + 1))
        echo "=== FAILED $(basename "$exe")"
        grep -vE '^(test .* \.\.\. ok|running [0-9]+ tests?|\.+)$' "$log" | tail -40
    fi
done <"$out/bins"
# A check that returns early on a missing fixture or GPU passes: its own line says so, read off the
# output each check printed (`--show-output`), so a green run never hides what did not run.
while IFS=$'\t' read -r exe manifest; do
    log="$out/$(basename "$exe").log"
    binary="$(basename "$(dirname "$manifest")")/$(basename "$exe" | sed -E 's/-[0-9a-f]{16}$//')"
    awk -v binary="$binary" '
        /^---- .* stdout ----$/ { check = $2; next }
        /^SKIPPED|^skipped |not exercised/ { print binary "\t" check "\t" $0 }
    ' "$log"
done <"$out/bins" | sort -u >"$out/skipped"
if [ -s "$out/skipped" ]; then
    echo "=== SKIPPED"
    awk -F '\t' '{ print "  " $1 " " $2 ": " $3 }' "$out/skipped"
    awk -F '\t' '
        {
            why = $3
            if (match(why, /\(set [A-Z_]+\)/)) why = "no " substr(why, RSTART + 5, RLENGTH - 6)
            else if (why ~ /roll #8 is absent/) why = "no ONI_RAW_DIR"
            else if (why ~ /ONI_SKIP_HEAVY/) why = "ONI_SKIP_HEAVY set"
            else if (why ~ /GPU|[Aa]dapter|device/) why = "no GPU"
            else if (why ~ /running as root|under root/) why = "root"
            else { sub(/^(SKIPPED|skipped)[^:]*: */, "", why); why = substr(why, 1, 48) }
            count[why]++; total++
        }
        END {
            line = ""
            for (w in count) line = line (line == "" ? "" : ", ") count[w] " " w
            print "SKIPPED " total " checks: " line
        }
    ' "$out/skipped"
else
    echo "SKIPPED 0 checks"
fi
echo "$(wc -l <"$out/bins" | tr -d ' ') binaries, $failed failed, $(($(date +%s) - started)) s"
[ "$failed" -eq 0 ]
