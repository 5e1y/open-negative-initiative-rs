#!/usr/bin/env bash
# The welcome's pictures made again from the app's own renders, after the render or the stage changes: the huge
# gift's demo (one photo on the neutral film and each demo stock) and each gift's still. Usage: scripts/welcome-assets RAW
set -euo pipefail
cd "$(dirname "$0")/.."
raw="${1:?the demo photo's RAW}"
out="crates/oni-ui/ui/welcome"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
cargo build -p oni-app --example welcome_stills --example welcome_stage
# The stocks in the order of `STOCKS` in crates/oni-app/src/app/help/welcome.rs.
target/debug/examples/welcome_stills "$raw" "$scratch" 0.68 0.22 kodak-ektar-100 fujifilm-velvia-50 kodak-tri-x-400
for name in film-photo film-print-1 film-print-2 film-print-3; do
    cp "$scratch/$name.jpg" "$out/$name.jpg"
done
target/debug/examples/welcome_stage --stills "$out"
