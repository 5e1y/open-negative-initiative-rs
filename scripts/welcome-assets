#!/usr/bin/env bash
# The welcome's pictures and films made again from the app itself, after the render, the stage or the interface
# changes: the photo on each film (`welcome_stills`), each gift's still, the takes of the real app on a held clock
# (`welcome_films`), then each film composed over them and filmed frame by frame in headless Chrome
# (`crates/oni-app/welcome-motion`) at two pixels a point, a WebP a frame. Needs Node 22, Python 3 with Pillow
# (WebP) and fontTools, and Chrome.
# Usage: scripts/welcome-assets RAW, the demo RAW with its .json sidecar beside it.
set -euo pipefail
cd "$(dirname "$0")/.."
raw="${1:?the demo RAW}"
out="crates/oni-ui/ui/welcome"
motion="crates/oni-app/welcome-motion"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
python3 scripts/welcome-wordmark.py
cargo build -p oni-app --example welcome_stills --example welcome_stage
# The huge gift's films, in the order of `FILMS` in welcome-motion/huge.html: the hero three, then the montage.
mkdir -p "$scratch/renders"
target/debug/examples/welcome_stills "$raw" "$scratch/renders" 0.68 0.22 kodak-ektar-100 fujifilm-velvia-50 kodak-tri-x-400 \
    kodak-portra-400 kodak-vision3-500t kodak-gold-200 fujifilm-provia-100f ilford-hp5-plus kodak-ektachrome-e100 \
    fujifilm-superia-1600 kodak-portra-160 kodak-ultramax-400 fujifilm-pro-400h
target/debug/examples/welcome_stage --stills "$out"
ONI_BACKGROUND=1 ONI_ONE=welcome_films::the_welcome_films_are_shot_in_the_real_app ONI_WELCOME_TAKES="$scratch/takes" \
    ONI_WELCOME_RENDERS="$scratch/renders" cargo test -p oni-app --test window -- --nocapture
python3 "$motion/fonts.py" crates/oni-ui/fonts "$scratch/fonts"
(cd "$motion" && npm ci --silent)
for film in huge interface collection wrapped; do
    SCALE=2 node "$motion/film.mjs" "$film" "$scratch/frames-$film" renders="$scratch/renders" takes="$scratch/takes" \
        fonts="$scratch/fonts" stocks="$PWD/crates/oni-settings/stocks"
    python3 "$motion/fold.py" "$scratch/frames-$film" "$out/film-$film"
done
