#!/usr/bin/env bash
# The 2.5D lab in slint-viewer: no build, the window redraws on each save of crates/oni-ui/lab/*.slint.
# `--check` compiles it without a window; `--shot FILE [COMPONENT] [WxH]` renders it to a PNG and exits.
set -euo pipefail
cd "$(dirname "$0")/.."
bin="$HOME/.oni-toolchain/slint/bin"
if [ ! -x "$bin/slint-viewer" ]; then
    cargo install slint-viewer --version 1.18.1 --locked --root "$HOME/.oni-toolchain/slint"
fi
case "${1:-}" in
    --check) exec "$bin/slint-viewer" --check crates/oni-ui/lab/lab.slint ;;
    --shot)
        args=(--screenshot "$2")
        [ -n "${3:-}" ] && args+=(--component "$3")
        [ -n "${4:-}" ] && args+=(--size "$4")
        exec "$bin/slint-viewer" "${args[@]}" crates/oni-ui/lab/lab.slint ;;
esac
exec "$bin/slint-viewer" --auto-reload crates/oni-ui/lab/lab.slint
