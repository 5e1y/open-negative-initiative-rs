#!/usr/bin/env python3
# windows-appcast VERSION BUILD ZIP NOTES RELEASES: the Windows archive signed with the releases' EdDSA
# key (Sparkle's sign_update reads it from the keychain) and laid first in RELEASES/appcast-windows.xml.
import os
import re
import subprocess
import sys
from email.utils import formatdate
from pathlib import Path

# Sparkle's tools, the `bin` of its release unpacked: nothing in this repository ships them.
SPARKLE = os.environ.get("SPARKLE_BIN", "")
REPO = "5e1y/open-negative-initiative-releases"
HEAD = """<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Open Negative Initiative for Windows</title>
    </channel>
</rss>
"""


def main() -> int:
    if len(sys.argv) != 6:
        print(__doc__ or "usage: windows-appcast VERSION BUILD ZIP NOTES RELEASES", file=sys.stderr)
        return 2
    version, build, archive, notes, releases = sys.argv[1], sys.argv[2], Path(sys.argv[3]), Path(sys.argv[4]), Path(sys.argv[5])
    feed = releases / "appcast-windows.xml"
    text = feed.read_text(encoding="utf-8") if feed.exists() else HEAD
    # A version is published once: a second run would offer two items of one build.
    if f"<sparkle:version>{build}</sparkle:version>" in text:
        print(f"FAIL: build {build} is already in {feed}", file=sys.stderr)
        return 1
    sign = Path(SPARKLE) / "sign_update"
    if not SPARKLE or not sign.is_file():
        print("FAIL: set SPARKLE_BIN to the bin folder of Sparkle's release, which holds sign_update", file=sys.stderr)
        return 2
    signed = subprocess.run([str(sign), str(archive)], capture_output=True, text=True, check=True).stdout
    signature = re.search(r'sparkle:edSignature="([^"]+)"', signed).group(1)
    length = archive.stat().st_size
    item = f"""        <item>
            <title>{version}</title>
            <pubDate>{formatdate(localtime=True)}</pubDate>
            <link>https://github.com/{REPO}</link>
            <sparkle:version>{build}</sparkle:version>
            <sparkle:shortVersionString>{version}</sparkle:shortVersionString>
            <description><![CDATA[{notes.read_text(encoding="utf-8")}]]></description>
            <enclosure url="https://github.com/{REPO}/releases/download/v{version}/ONI-windows.zip" length="{length}" type="application/octet-stream" sparkle:os="windows" sparkle:edSignature="{signature}"/>
        </item>
"""
    at = text.index("</title>", text.index("<channel>")) + len("</title>\n")
    feed.write_text(text[:at] + item + text[at:], encoding="utf-8")
    print(f"{version} (build {build}) laid first in {feed}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
